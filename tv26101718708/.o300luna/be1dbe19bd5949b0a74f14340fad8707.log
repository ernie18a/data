panel_header_valign = text.align_center
panel_marker_halign = text.align_center
panel_marker_valign = text.align_center

f_marker(bool show_live, bool is_confirmed) =>
    show_live and not is_confirmed ? M_FORM : M_CONF

f_with_marker(string txt, string marker) =>
    txt + " " + marker

f_panel_marker_text(string marker) =>
    marker

f_panel_marker_from_live(bool _show_live, int _row_live_i) =>
    f_panel_marker_text(_show_live and _row_live_i == 1 ? M_FORM : M_CONF)

f_format_z_cell(float _z) =>
    na(_z) ? "–" : (_z > 0 ? "+" : "") + str.tostring(_z, "0.0")

f_format_bias_maturity(int _maturity) =>
    _maturity == 1 ? "1" :
     _maturity == 2 ? "2" :
     _maturity == 3 ? "3" :
     "–"

f_panel_row(int r) =>
    math.max(r - 1, 0)

f_emit_rt_fractal_alert(bool _enabled, string _any_alert_filter, bool _rt_up_frac, bool _rt_dn_frac) =>
    bool allow_rt = _any_alert_filter == "All" or _any_alert_filter == "Fractal Realtime"
    if _enabled and allow_rt and barstate.isrealtime and (_rt_up_frac or _rt_dn_frac)
        alert("[MCCS][Fractal Realtime] Potential 5th fractal bar forming", alert.freq_once_per_bar)

f_emit_additional_alert_events(bool _enabled, string _any_alert_filter, bool _fractal_confirmed, bool _range_start, bool _neutral_start) =>
    if _enabled and barstate.isconfirmed
        if (_any_alert_filter == "All" or _any_alert_filter == "Fractal Confirmed") and _fractal_confirmed
            alert("[MCCS][Fractal Confirmed] Fractal up/down confirmed", alert.freq_once_per_bar_close)
        if (_any_alert_filter == "All" or _any_alert_filter == "Regime Range") and _range_start
            alert("[MCCS][Regime Range] Regime switched to RANGE", alert.freq_once_per_bar_close)
        if (_any_alert_filter == "All" or _any_alert_filter == "Bias Neutral") and _neutral_start
            alert("[MCCS][Bias Neutral] Bias switched to NEUTRAL", alert.freq_once_per_bar_close)

f_tt_atr14() =>
    "• Current movement size for stop/target sizing.\n• Higher ATR14 = wider swings, wider stops.\n• Lower ATR14 = tighter swings, tighter stops."

f_tt_adr() =>
    "• Progress within the Average Daily Range.\n• Helps spot stretch/exhaustion after much of\n⠀the day’s range is used.\n• High ADR% = be selective.\n• Low ADR% = more room to extend."

f_tt_volatility_pct() =>
    "• Shows how unusual current volatility is.\n• Useful for breakout filters, mean reversion,\n⠀and adaptive stop/target sizing.\n• Based on ATR(14) percentile vs. its own\n⠀history.\n• 10% = very quiet, 90% = very wild."

f_tt_vix() =>
    "• Current CBOE Volatility Index (VIX) value.\n• Uses CBOE:VIX daily data with gaps filled so\n⠀the latest available value remains visible.\n• Helpful as broad equity-market fear/risk\n⠀context."

f_tt_atr_pct() =>
    "• ATR14 relative to price: ATR14 / Close × 100.\n• Makes volatility comparable across assets and\n⠀price levels.\n• Higher ATR% = wider relative swings.\n• Lower ATR% = tighter relative swings."

f_tt_panel_bias() =>
    "• BIAS cells show maturity, not live markers.\n• Color = direction; 1 = fresh, 2 = working,\n⠀3 = late/extended, – = neutral/NA.\n• Panel row shows score + quality (L/M/H/E),\n⠀optionally A/X alignment."

f_tt_panel_reg() =>
    "• REG cells show regime color plus selected\n⠀normalized distance as text.\n• VWAP-Z = mapped VWAP anchor distance.\n• SMA-Z = close distance to SMA normalized\n⠀by deviation.\n• SMA-Z increases when price moves away from\n⠀the SMA, but also when tight consolidation\n⠀forms while absolute distance stays similar.\n• TREND favors continuation; RANGE rotation;\n⠀SQUEEZE compression before expansion."
f_tt_panel_rvol() =>
    "• Relative volume = current volume / average\n⠀volume.\n• L/M/H/E shows activity quality from low to\n⠀extreme.\n• Rising RVOL supports breakouts, reclaims, and\n⠀post-squeeze expansion."

f_tt_panel_vwp() =>
    "• VWAP stretch as Z-score (σ).\n• N = near, S = stretch, T = take-profit zone,\n⠀E = extreme.\n• More stretch = more mean-reversion risk unless\n⠀momentum stays strong."

// _col_start prevents main-panel utility rows from touching the optional legend sidecar.
f_clear_range_vol_rows(table _panel, int _col_start, int _col_last) =>
    table.clear(_panel, _col_start, f_panel_row(9), _col_last, f_panel_row(13))

f_render_range_vol_rows(table _panel, bool _show, string _atr_txt, string _atr_pct_txt, string _adr_txt, string _vol_txt, string _vix_txt, int _col_start, int _col_last) =>
    if _show
        table.merge_cells(_panel, _col_start, f_panel_row(9), _col_last, f_panel_row(9))
        table.cell(table_id=_panel, column=_col_start, row=f_panel_row(9), text=_atr_txt, text_size=size.small, text_color=color.silver, tooltip=f_tt_atr14())
        table.merge_cells(_panel, _col_start, f_panel_row(10), _col_last, f_panel_row(10))
        table.cell(table_id=_panel, column=_col_start, row=f_panel_row(10), text=_atr_pct_txt, text_size=size.small, text_color=color.silver, tooltip=f_tt_atr_pct())
        table.merge_cells(_panel, _col_start, f_panel_row(11), _col_last, f_panel_row(11))
        table.cell(table_id=_panel, column=_col_start, row=f_panel_row(11), text=_adr_txt, text_size=size.small, text_color=color.silver, tooltip=f_tt_adr())
        table.merge_cells(_panel, _col_start, f_panel_row(12), _col_last, f_panel_row(12))
        table.cell(table_id=_panel, column=_col_start, row=f_panel_row(12), text=_vol_txt, text_size=size.small, text_color=color.silver, tooltip=f_tt_volatility_pct())
        table.merge_cells(_panel, _col_start, f_panel_row(13), _col_last, f_panel_row(13))
        table.cell(table_id=_panel, column=_col_start, row=f_panel_row(13), text=_vix_txt, text_size=size.small, text_color=color.silver, tooltip=f_tt_vix())
    else
        f_clear_range_vol_rows(_panel, _col_start, _col_last)

f_render_mtf_row(table _panel, int _row, string _tf_label, bool _highlight_tf, int _col_tf, int _col_fvg, int _col_fr, int _col_bias, int _col_reg, string _fvg_marker, color _fvg_bg, string _fr_marker, color _fr_bg, bool _show_bias, string _bias_text, color _bias_bg, bool _show_reg, string _reg_text, color _reg_bg, float _col_width) =>
    table.cell(table_id=_panel, column=_col_tf, row=f_panel_row(_row), text=_tf_label, text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, bgcolor=_highlight_tf ? color.new(color.yellow, 75) : na, width=_col_width)
    table.cell(table_id=_panel, column=_col_fvg, row=f_panel_row(_row), text=f_panel_marker_text(_fvg_marker), text_size=marker_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=_fvg_bg, width=_col_width)
    table.cell(table_id=_panel, column=_col_fr, row=f_panel_row(_row), text=f_panel_marker_text(_fr_marker), text_size=marker_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=_fr_bg, width=_col_width)
    if _show_bias and not na(_col_bias)
        table.cell(table_id=_panel, column=_col_bias, row=f_panel_row(_row), text=_bias_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=_bias_bg, width=_col_width)
    if _show_reg and not na(_col_reg)
        table.cell(table_id=_panel, column=_col_reg, row=f_panel_row(_row), text=_reg_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=_reg_bg, width=_col_width)


// --- STAGE 2: CONFIGURATION & AUTO-SCALING ---

// 1. Timeframe Classification
int tf_sec = timeframe.in_seconds(timeframe.period)

// 2. Define Effective Variables (Init)
// CONF - Variables defined via f_resolve_auto_params

// REG
int eff_adx_len      = 14
// eff_adx_th defined via f_resolve_auto_params
int eff_bb_len       = 20
float eff_bb_mult    = 2.0
int eff_kc_len       = 20
float eff_kc_mult    = 1.7
bool eff_squeeze_strict = true
bool eff_use_kc_squeeze = true

// ADR/ATR
// eff_use_adr_gate defined via f_resolve_auto_params
int eff_adr_len      = 20
// eff_adr_warn defined via f_resolve_auto_params
// eff_adr_hard defined via f_resolve_auto_params
int eff_atr_len      = 14
int eff_atr_norm     = 50
float eff_atr_low    = 0.90
float eff_atr_high   = 1.10

f_resolve_auto_params(_tf_sec, _auto_tuning) =>
    bool is_fast = _tf_sec <= 900
    bool is_med = _tf_sec > 900 and _tf_sec <= 14400
    bool is_slow = _tf_sec > 14400 and _tf_sec < 86400
    bool is_daily = _tf_sec >= 86400 and _tf_sec < 604800
    bool is_weekly_plus = _tf_sec >= 604800
    int a_core_len = 13
    int a_persist = 3
    int a_vol_len = 80
    float a_enter_k = 1.0
    float a_exit_k = 0.5
    float a_decay = 0.70
    float a_clamp = 0.15
    int a_adx_th = 20
    bool use_adr_gate = true
    float adr_warn = 85.0
    float adr_hard = 110.0
    if is_fast
        a_core_len := 8
        a_persist  := 3
        a_vol_len  := 50
    else if is_med
        a_core_len := 13
        a_persist  := 3
        a_vol_len  := 80
    else if is_slow
        a_core_len := 21
        a_persist  := 2
        a_vol_len  := 120
    else if is_daily
        a_core_len := 21
        a_persist  := 2
        a_vol_len  := 150
    else
        a_core_len := 34
        a_persist  := 2
        a_vol_len  := 200
    if _auto_tuning == "Conservative"
        a_enter_k := 1.25
        a_exit_k  := 0.65
        a_decay   := 0.60
        a_clamp   := 0.12
        a_adx_th  := 22
        a_core_len := math.round(a_core_len * 1.4)
        a_vol_len  := math.round(a_vol_len * 1.4)
        a_persist  := math.min(a_persist + 2, 6)
        use_adr_gate := true
        adr_warn := 85.0
        adr_hard := 110.0
    else if _auto_tuning == "Aggressive"
        a_enter_k := 0.80
        a_exit_k  := 0.45
        a_decay   := 0.75
        a_clamp   := 0.18
        a_adx_th  := 18
        a_core_len := math.max(math.round(a_core_len * 0.75), 5)
        a_vol_len  := math.max(math.round(a_vol_len * 0.75), 30)
        a_persist  := math.max(a_persist - 3, 1)
        use_adr_gate := (is_daily or is_weekly_plus) ? false : true
        adr_warn := 85.0
        adr_hard := 110.0
    else
        a_enter_k := 1.00
        a_exit_k  := 0.50
        a_decay   := 0.70
        a_clamp   := 0.15
        a_adx_th  := 20
        use_adr_gate := true
        adr_warn := 85.0
        adr_hard := 110.0
        // Balanced: persist -1 (more responsive than default)
        a_persist := math.max(a_persist - 1, 1)
    [int(a_core_len), int(a_vol_len), a_enter_k, a_exit_k, int(a_persist), a_decay, a_clamp, a_adx_th, use_adr_gate, adr_warn, adr_hard]

[eff_core_ema_len, eff_vol_len, eff_enter_k, eff_exit_k, eff_persist_bars, eff_ov_decay, eff_ov_clamp, eff_adx_th, eff_use_adr_gate, eff_adr_warn, eff_adr_hard] = f_resolve_auto_params(tf_sec, auto_tuning)

f_resolve_vwap_gate_params(_auto_tuning, _tf_sec) =>
    float deadband_z = 0.12
    float align_min_z = 0.15
    float misalign_min_z = 0.12
    int align_persist_bars = 1
    int vwap_slope_len = 3
    bool use_slope_filter_for_bonus = true
    float strong_align_z = 0.30

    if _auto_tuning == "Conservative"
        deadband_z := 0.15
        align_min_z := 0.18
        misalign_min_z := 0.15
        align_persist_bars := 2
        vwap_slope_len := 3
        use_slope_filter_for_bonus := true
        strong_align_z := 0.35
    else if _auto_tuning == "Aggressive"
        deadband_z := 0.10
        align_min_z := 0.12
        misalign_min_z := 0.10
        align_persist_bars := 1
        vwap_slope_len := 2
        use_slope_filter_for_bonus := false
        strong_align_z := 0.25

    if _tf_sec >= 86400
        vwap_slope_len := math.max(vwap_slope_len + 1, 3)

    [deadband_z, align_min_z, misalign_min_z, align_persist_bars, vwap_slope_len, use_slope_filter_for_bonus, strong_align_z]

[conf_deadband_z, conf_align_min_z, conf_misalign_min_z, conf_align_persist_bars, conf_vwap_slope_len, conf_use_slope_filter_for_bonus, conf_strong_align_z] = f_resolve_vwap_gate_params(auto_tuning, tf_sec)


f_resolve_regime_candidate(_bbw, _avg_bbw, _squeeze_kc, _use_kc_squeeze, _squeeze_strict, _adx_r, _trend_enter_th, _trend_exit_th, _squeeze_enter_mult, _squeeze_exit_mult, _trend_active_prev, _squeeze_active_prev) =>
    bool is_squeeze_bbw_enter = _bbw < (_avg_bbw * _squeeze_enter_mult)
    bool is_squeeze_bbw_exit = _bbw > (_avg_bbw * _squeeze_exit_mult)

    bool is_squeeze_enter = is_squeeze_bbw_enter
    bool is_squeeze_exit = is_squeeze_bbw_exit
    if _use_kc_squeeze
        if _squeeze_strict
            is_squeeze_enter := is_squeeze_bbw_enter and _squeeze_kc
            is_squeeze_exit := is_squeeze_bbw_exit or not _squeeze_kc
        else
            is_squeeze_enter := is_squeeze_bbw_enter or _squeeze_kc
            is_squeeze_exit := is_squeeze_bbw_exit and not _squeeze_kc

    bool trend_active_new = _trend_active_prev ? (_adx_r >= _trend_exit_th) : (_adx_r >= _trend_enter_th)
    bool squeeze_active_new = _squeeze_active_prev ? (not is_squeeze_exit) : is_squeeze_enter

    bool cand_squeeze = squeeze_active_new
    bool cand_trend = trend_active_new and not cand_squeeze
    string regime_raw_candidate = cand_squeeze ? "SQUEEZE" : cand_trend ? "TREND" : "RANGE"
    [regime_raw_candidate, trend_active_new, squeeze_active_new]

f_update_regime_state(_state, _candidate, _run, _new_candidate, _persist_bars, _is_confirmed) =>
    string state_out = _state
    string candidate_out = _candidate
    int run_out = _run

    if _is_confirmed
        if _new_candidate == candidate_out
            run_out += 1
        else
            candidate_out := _new_candidate
            run_out := 1

        if run_out >= _persist_bars
            state_out := candidate_out

    [state_out, candidate_out, run_out]


f_update_regime_runtime(_trend_active, _squeeze_active, _bbw, _avg_bbw, _squeeze_kc, _use_kc_squeeze, _squeeze_strict, _adx_r, _trend_enter_th, _trend_exit_th, _squeeze_enter_mult, _squeeze_exit_mult, _is_confirmed) =>
    bool trend_active_out = _trend_active
    bool squeeze_active_out = _squeeze_active
    [regime_raw_candidate, trend_active_next, squeeze_active_next] = f_resolve_regime_candidate(_bbw, _avg_bbw, _squeeze_kc, _use_kc_squeeze, _squeeze_strict, _adx_r, _trend_enter_th, _trend_exit_th, _squeeze_enter_mult, _squeeze_exit_mult, _trend_active, _squeeze_active)

    if _is_confirmed
        trend_active_out := trend_active_next
        squeeze_active_out := squeeze_active_next

    string regime_candidate_eval = _is_confirmed ? (squeeze_active_out ? "SQUEEZE" : trend_active_out ? "TREND" : "RANGE") : regime_raw_candidate
    [trend_active_out, squeeze_active_out, regime_candidate_eval]

f_resolve_raw_align_state(_state_sign, _conf_z_val, _deadband_z, _align_min_z, _misalign_min_z, _use_slope_filter_for_bonus, _vwap_slope, _strong_align_z) =>
    int raw_align_state = 0
    float abs_z = na(_conf_z_val) ? na : math.abs(_conf_z_val)
    float signed_z = _state_sign * _conf_z_val

    bool is_neutral = _state_sign == 0 or na(_conf_z_val) or na(abs_z) or abs_z < _deadband_z
    if is_neutral
        raw_align_state := 0
    else
        bool align_candidate = signed_z >= _align_min_z
        bool misalign_candidate = signed_z <= -_misalign_min_z

        if align_candidate
            bool slope_ok = not _use_slope_filter_for_bonus or (_state_sign == 1 ? _vwap_slope >= 0 : _vwap_slope <= 0)
            bool strong_align = abs_z >= _strong_align_z
            bool allow_align = abs_z >= _align_min_z and (slope_ok or strong_align)
            raw_align_state := allow_align ? 1 : 0
        else if misalign_candidate
            raw_align_state := -1
        else
            raw_align_state := 0

    raw_align_state

f_update_align_confirmation(_raw_align_state, _align_candidate, _align_run, _align_confirmed, _align_persist_bars, _is_confirmed) =>
    int align_candidate_out = _align_candidate
    int align_run_out = _align_run
    int align_confirmed_out = _align_confirmed

    if _is_confirmed
        if _raw_align_state == 0
            align_candidate_out := 0
            align_run_out := 0
            align_confirmed_out := 0
        else if _raw_align_state == align_candidate_out
            align_run_out += 1
            if align_run_out >= _align_persist_bars
                align_confirmed_out := _raw_align_state
        else
            align_candidate_out := _raw_align_state
            align_run_out := 1
            align_confirmed_out := 0

    [align_candidate_out, align_run_out, align_confirmed_out]

f_apply_stretch_penalty(_q_num, _abs_z, _penalty_mode, _z_th_entry, _z_th_tp, _z_th_ext) =>
    int penalty = 0
    if _penalty_mode == "Aggressive"
        if _abs_z >= _z_th_ext
            penalty := -1
        else if _abs_z >= _z_th_tp
            penalty := -1
    else if _penalty_mode == "Conservative"
        if _abs_z >= _z_th_ext
            penalty := -3
        else if _abs_z >= _z_th_tp
            penalty := -2
        else if _abs_z >= _z_th_entry
            penalty := -1
    else
        if _abs_z >= _z_th_ext
            penalty := -2
        else if _abs_z >= _z_th_tp
            penalty := -1

    math.max(_q_num + penalty, 0)


f_apply_vwap_quality_gate(_quality, _use_vwap_quality, _conf_vwap_val, _conf_vwap_slope_len, _state_sign, _conf_z_val, _conf_deadband_z, _conf_align_min_z, _conf_misalign_min_z, _conf_use_slope_filter_for_bonus, _conf_strong_align_z, _align_candidate, _align_run, _align_confirmed, _conf_align_persist_bars, _is_confirmed, _penalty_mode, _z_th_entry, _z_th_tp, _z_th_ext) =>
    int q_num = _quality == "E" ? 3 : _quality == "H" ? 2 : _quality == "M" ? 1 : 0
    string align_flag = ""
    int align_candidate_out = _align_candidate
    int align_run_out = _align_run
    int align_confirmed_out = _align_confirmed

    float vwap_slope = ta.change(_conf_vwap_val, _conf_vwap_slope_len)
    if _use_vwap_quality and not na(_conf_vwap_val)
        int raw_align_state = f_resolve_raw_align_state(_state_sign, _conf_z_val, _conf_deadband_z, _conf_align_min_z, _conf_misalign_min_z, _conf_use_slope_filter_for_bonus, vwap_slope, _conf_strong_align_z)

        [align_candidate_new, align_run_new, align_confirmed_new] = f_update_align_confirmation(raw_align_state, _align_candidate, _align_run, _align_confirmed, _conf_align_persist_bars, _is_confirmed)
        align_candidate_out := align_candidate_new
        align_run_out := align_run_new
        align_confirmed_out := align_confirmed_new

        int align_delta = align_confirmed_out == 1 ? 1 : align_confirmed_out == -1 ? -1 : 0
        q_num := math.max(0, math.min(3, q_num + align_delta))
        align_flag := align_confirmed_out == 1 ? "A" : align_confirmed_out == -1 ? "X" : ""

        if not na(_conf_z_val)
            float abs_z = math.abs(_conf_z_val)
            q_num := f_apply_stretch_penalty(q_num, abs_z, _penalty_mode, _z_th_entry, _z_th_tp, _z_th_ext)

    string quality_out = q_num == 3 ? "E" : q_num == 2 ? "H" : q_num == 1 ? "M" : "L"
    [quality_out, align_flag, align_candidate_out, align_run_out, align_confirmed_out]

// --- Confirmed Bias: Profile Resolver (Stable / Standard / Fast + Scalp Optimize) ---
f_resolve_bias_confirm_params(string _profile, bool _scalp_opt) =>
    // Base defaults: Standard
    float enter_bull = 55.0
    float exit_bull  = 52.0
    float enter_bear = 45.0
    float exit_bear  = 48.0
    int enter_bars   = 2
    int exit_bars    = 1

    if _profile == "Stable"
        enter_bull := 58.0
        exit_bull  := 53.0
        enter_bear := 42.0
        exit_bear  := 47.0
        enter_bars := 3
        exit_bars  := 2
    else if _profile == "Fast"
        enter_bull := 54.0
        exit_bull  := 52.0
        enter_bear := 46.0
        exit_bear  := 48.0
        enter_bars := 1
        exit_bars  := 1

    if _scalp_opt
        // A) Persistenz (Bars)
        enter_bars := math.max(1, enter_bars - 1)
        exit_bars  := math.max(1, exit_bars - 1)

        // B) Hysterese / Schwellen (symmetrische Beschleunigung)
        enter_bull := enter_bull - 2.0
        exit_bull  := exit_bull  - 1.0
        enter_bear := enter_bear + 2.0
        exit_bear  := exit_bear  + 1.0

        // C) Invarianten / Clamps
        exit_bull := math.max(exit_bull, 51.0)
        exit_bear := math.min(exit_bear, 49.0)
        enter_bull := math.max(enter_bull, exit_bull + 1.0)
        enter_bear := math.min(enter_bear, exit_bear - 1.0)

    // Clamp all thresholds to [0..100]
    enter_bull := math.max(0.0, math.min(100.0, enter_bull))
    exit_bull  := math.max(0.0, math.min(100.0, exit_bull))
    enter_bear := math.max(0.0, math.min(100.0, enter_bear))
    exit_bear  := math.max(0.0, math.min(100.0, exit_bear))

    [enter_bull, enter_bear, exit_bull, exit_bear, enter_bars, exit_bars]

[eff_cb_enter_bull, eff_cb_enter_bear, eff_cb_exit_bull, eff_cb_exit_bear, eff_cb_enter_bars, eff_cb_exit_bars] = f_resolve_bias_confirm_params(cb_profile, cb_scalp_opt)

