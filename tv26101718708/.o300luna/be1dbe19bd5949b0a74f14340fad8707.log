//----------------------------------------------------------------- KAMA Calculation -------------------------------------------------------------------

// Function for KAMA
f_kama(_src, _len, _fast, _slow) =>
    _change = math.abs(_src - _src[_len])
    _volatility = math.sum(math.abs(_src - _src[1]), _len)
    _er = _volatility != 0 ? _change / _volatility : 0
    _sc = math.pow(_er * (2 / (_fast + 1) - 2 / (_slow + 1)) + 2 / (_slow + 1), 2)
    var float _kama = 0.0
    _kama := na(_kama[1]) ? _src : _kama[1] + _sc * (_src - _kama[1])
    _kama

float kama_val = na

if kama_enabled
    kama_val := f_kama(close, kama_len, kama_fast, kama_slow)

// KAMA Signals (Slope Mode)
bool kama_bull = false
bool kama_bear = false
if kama_enabled and not na(kama_val)
    if kama_slope_color
        kama_bull := kama_val > kama_val[1]
        kama_bear := kama_val < kama_val[1]

if kama_enabled
    sig.kama_bull := kama_bull
    sig.kama_bear := kama_bear

// KAMA remains calculation-only to keep internal context scoring without consuming plot slots.

//------------------------------------------------------------ trend lines (Visuals for Chart) ----------------------------------------------------------------

// Determine logic based on input
use_special_trend = fractalBarsPerSide == 0
// Force 2 (5-bar fractal) for special mode to ensure stability
n_tl = use_special_trend ? 2 : fractalBarsPerSide

// --- Detection using Pivot Functions ---
// Closed-candle only (no intrabar repaint/flicker on realtime bar)
bool tl_closed = (not barstate.isrealtime) or barstate.isconfirmed
ph_val = tl_closed ? ta.pivothigh(high, n_tl, n_tl) : na
pl_val = tl_closed ? ta.pivotlow(low, n_tl, n_tl) : na

// --- State Variables (Pivot 0 = Newest, Pivot 1 = Old) ---
var float y0_up = na
var int x0_up = na
var float y1_up = na
var int x1_up = na

if not na(ph_val)
    y1_up := y0_up
    x1_up := x0_up
    y0_up := ph_val
    x0_up := bar_index - n_tl

var float y0_dn = na
var int x0_dn = na
var float y1_dn = na
var int x1_dn = na

if not na(pl_val)
    y1_dn := y0_dn
    x1_dn := x0_dn
    y0_dn := pl_val
    x0_dn := bar_index - n_tl

// --- Optimized Anchored Regression (O(1) Running Sums) ---

// Globale Running Sums for Up-Trend
var float sum_xy_up_run = 0.0
var float sum_x2_up_run = 0.0

// Globale Running Sums for Down-Trend
var float sum_xy_dn_run = 0.0
var float sum_x2_dn_run = 0.0

// Variables to track changes in pivots for reset logic
var int last_x0_up = na
var int last_x0_dn = na

// Drawing Objects
var line upper_line = na
var line lower_line = na

// STAGE 1: HYBRID HARD GATING
// We only run the heavy regression and drawing logic if enabled.
if eff_plot_trendline and tl_closed
    // LOGIC for Up-Trend Regression
    if use_special_trend
        // Check if new pivot detected (x0_up changed)
        if x0_up != last_x0_up
            // Reset sums
            sum_xy_up_run := 0.0
            sum_x2_up_run := 0.0

            // Backfill loop (Only runs once per new pivot, for n_tl bars)
            if not na(x0_up) and not na(y0_up)
                int start_idx = x0_up + 1
                int end_idx = bar_index - 1
                if end_idx >= start_idx
                    // Just loop forward conceptually using offset j from current bar
                    int j_max = bar_index - start_idx
                    for j = 1 to j_max
                        // Calculate terms
                        // Real Index: bar_index - j
                        int dx = (bar_index - j) - x0_up
                        float dy = high[j] - y0_up

                        sum_xy_up_run += (dx * dy)
                        sum_x2_up_run += (float(dx) * float(dx))

            last_x0_up := x0_up

        else
            // Incremental Update (Every bar)
            if not na(x0_up) and not na(y0_up)
                int dx = (bar_index - 1) - x0_up
                if dx > 0
                    float dy = high[1] - y0_up
                    sum_xy_up_run += (dx * dy)
                    sum_x2_up_run += (float(dx) * float(dx))

    // Calculate Slope Up
    slope_up = (use_special_trend and sum_x2_up_run != 0) ? sum_xy_up_run / sum_x2_up_run : na


    // LOGIC for Down-Trend Regression
    if use_special_trend
        if x0_dn != last_x0_dn
            // Reset
            sum_xy_dn_run := 0.0
            sum_x2_dn_run := 0.0
            last_x0_dn := x0_dn

            // Backfill
            if not na(x0_dn) and not na(y0_dn)
                int start_idx = x0_dn + 1
                int end_idx = bar_index - 1
                if end_idx >= start_idx
                    int j_max = bar_index - start_idx
                    for j = 1 to j_max
                        int dx = (bar_index - j) - x0_dn
                        float dy = low[j] - y0_dn
                        sum_xy_dn_run += (dx * dy)
                        sum_x2_dn_run += (float(dx) * float(dx))
        else
            // Incremental
            if not na(x0_dn) and not na(y0_dn)
                int dx = (bar_index - 1) - x0_dn
                if dx > 0
                    float dy = low[1] - y0_dn
                    sum_xy_dn_run += (dx * dy)
                    sum_x2_dn_run += (float(dx) * float(dx))

    // Calculate Slope Down
    slope_dn = (use_special_trend and sum_x2_dn_run != 0) ? sum_xy_dn_run / sum_x2_dn_run : na

    // --- Draw Trendlines ---
    // --- UPPER LINE ---
    // Mode 0: Start=Newest(x0), Slope based calculation
    // Mode >0: Start=Old(x1), End=Newest(x0)

    x1_u = use_special_trend ? x0_up : x1_up
    y1_u = use_special_trend ? y0_up : y1_up

    // End anchor:
    //  • Classic mode (Bars Per Side > 0): project between confirmed fractals (old -> newest) and stop two bars ahead.
    //  • Special mode (Bars Per Side = 0): anchored regression from a confirmed 5-bar fractal (n_tl=2), updated using closed bars only.
    x2_u = bar_index + 2
    // Calculate Y2:
    float y2_u = na
    if use_special_trend
        if not na(slope_up) and not na(x0_up)
            // y = m*dx + y0 (anchored at confirmed fractal)
            y2_u := y0_up + slope_up * (x2_u - x0_up)
    else
        // Project to the most recent closed bar.
        if not na(x1_u) and not na(x0_up) and x1_u != x0_up
            m_u = (y0_up - y1_u) / (x0_up - x1_u)
            y2_u := y1_u + m_u * (x2_u - x1_u)

    // Draw
    if not na(x1_u) and not na(x2_u) and x1_u != x2_u and not na(y2_u)
        if na(upper_line)
            upper_line := line.new(x1 = x1_u, y1 = y1_u, x2 = x2_u, y2 = y2_u, extend = extend.none, color = color.new(color_tr, transp_tr), style = line.style_solid, width = width_tr)
        else
            line.set_xy1(upper_line, x1_u, y1_u)
            line.set_xy2(upper_line, x2_u, y2_u)
            line.set_color(upper_line, color.new(color_tr, transp_tr))
            line.set_width(upper_line, width_tr)
        line.set_extend(upper_line, extend.none)

    // --- LOWER LINE ---
    x1_d = use_special_trend ? x0_dn : x1_dn
    y1_d = use_special_trend ? y0_dn : y1_dn

    x2_d = bar_index + 2
    float y2_d = na
    if use_special_trend
        if not na(slope_dn) and not na(x0_dn)
            y2_d := y0_dn + slope_dn * (x2_d - x0_dn)
    else
        // Project to the most recent closed bar.
        if not na(x1_d) and not na(x0_dn) and x1_d != x0_dn
            m_d = (y0_dn - y1_d) / (x0_dn - x1_d)
            y2_d := y1_d + m_d * (x2_d - x1_d)

    if not na(x1_d) and not na(x2_d) and x1_d != x2_d and not na(y2_d)
        if na(lower_line)
            lower_line := line.new(x1 = x1_d, y1 = y1_d, x2 = x2_d, y2 = y2_d, extend = extend.none, color = color.new(color_tr, transp_tr), style = line.style_solid, width = width_tr)
        else
            line.set_xy1(lower_line, x1_d, y1_d)
            line.set_xy2(lower_line, x2_d, y2_d)
            line.set_color(lower_line, color.new(color_tr, transp_tr))
            line.set_width(lower_line, width_tr)
        line.set_extend(lower_line, extend.none)

    // --- Signal Logic for Registry (Trendlines) ---
    // Calculate current projected level
    float cur_y_up = na
    float cur_y_dn = na

    if use_special_trend
        if not na(slope_up) and not na(x0_up)
            cur_y_up := y0_up + slope_up * (bar_index - x0_up)
        if not na(slope_dn) and not na(x0_dn)
            cur_y_dn := y0_dn + slope_dn * (bar_index - x0_dn)
    else
        // Classic
        if not na(x1_u) and not na(x0_up) and x1_u != x0_up
            m_u = (y0_up - y1_u) / (x0_up - x1_u)
            cur_y_up := y1_u + m_u * (bar_index - x1_u)
        if not na(x1_d) and not na(x0_dn) and x1_d != x0_dn
            m_d = (y0_dn - y1_d) / (x0_dn - x1_d)
            cur_y_dn := y1_d + m_d * (bar_index - x1_d)

    // Update Registry
    if not na(cur_y_up) and close > cur_y_up
        sig.tl_bull := true
    if not na(cur_y_dn) and close < cur_y_dn
        sig.tl_bear := true

else if not eff_plot_trendline
    // Cleanup & State Reset (Crucial for Resuming)
    if not na(last_x0_up)
        last_x0_up := na
        last_x0_dn := na

    if not na(upper_line)
        line.delete(upper_line)
        upper_line := na
    if not na(lower_line)
        line.delete(lower_line)
        lower_line := na


//----------------------------------------------------------- last 12 bar (Visuals for Chart) ----------------------------------------------------------

l12_long = ta.highest(low, L12_input)
l12_short = ta.lowest(high, L12_input)

var bool long_plotted = true
var bool short_plotted = true

// Determine the actual signal trigger point
plot_l12_long = low == l12_long and short_plotted
plot_l12_short = high == l12_short and long_plotted
bool is_confirmed_bar = barstate.isconfirmed

if plot_l12_long
    long_plotted := true
    short_plotted := false

if plot_l12_short
    short_plotted := true
    long_plotted := false

plotchar(eff_plot_l12_bar and is_confirmed_bar and plot_l12_long ? l12_long : na, char='L', location=location.belowbar, color=color.new(color.blue, 0), title='L12 long bar')
plotchar(eff_plot_l12_bar and is_confirmed_bar and plot_l12_short ? l12_short : na, char='L', location=location.abovebar, color=color.new(color.red, 0), title='L12 short bar')


//----------------------------------------------------------- narrow range bar / anticipated fractal (Visuals for Chart)----------------------------------------------------------

// --- Narrow Range Bar (NR7) ---
p_nr_bar = high - low
bar_1 = high[1] - low[1]
bar_2 = high[2] - low[2]
bar_3 = high[3] - low[3]
bar_4 = high[4] - low[4]
bar_5 = high[5] - low[5]
bar_6 = high[6] - low[6]
bar_7 = high[7] - low[7]

nr_bar = p_nr_bar < bar_1 and p_nr_bar < bar_2 and p_nr_bar < bar_3 and p_nr_bar < bar_4 and p_nr_bar < bar_5 and p_nr_bar < bar_6

plotchar(eff_plot_nr_bar and is_confirmed_bar and nr_bar, char='n', location=location.belowbar, color=color.new(color.gray, 0), title='NR bar')


// --- Anticipated Fractal Logic ---
af_up = high > high[1] and high > high[2]
af_dn = low < low[1] and low < low[2]

var int last_af_state = 0

bool plot_blue_a_now = false
bool plot_red_a_now = false


if af_up and (last_af_state == 0 or last_af_state == -1)
    plot_blue_a_now := true
    last_af_state := 1

else if af_dn and (last_af_state == 0 or last_af_state == 1)
    plot_red_a_now := true
    last_af_state := -1


//----------------------------------------------- inside bar / outside bar / sandwich bar / pin bar / fakey ---------------------------------------------

i_bar       = high < high[1] and low > low[1]

o_bar       = high > high[1] and low < low[1]

o_bar_color = close > high[1] ? color.new(color.red, 0) : close < low[1] ? color.new(color.green, 0) :color.new(color.gray, 0)

s_bar       = high[1] < high[2] and low[1] > low[2] and high > high[1] and low < low[1]

sweep_bear  = high[1] > high[2] and high[1] > high[3] and close[1] < high[2]
sweep_bull  = low[1] < low[2] and low[1] < low[3] and close[1] > low[2]
sweep_bear_curr = high > high[1] and high > high[2] and close < high[1]
sweep_bull_curr = low < low[1] and low < low[2] and close > low[1]

f_up_e_raw  = (i_bar[1] and low < low[1] and close > open[1] and close > open) or
              (i_bar[2] and close[1] < low[2] and close > close[1] and high > high[1]) or
              (i_bar[1] and low < low[2] and close > close[1] and close > open) or
              (i_bar[2] and close[1] < low[3] and close > open and close > open[1])
f_dn_e_raw  = (i_bar[1] and high > high[1] and close < open[1] and close < open) or
              (i_bar[2] and close[1] > high[2] and close < close[1] and low < low[1]) or
              (i_bar[1] and high > high[2] and close < open and close < close[1]) or
              (i_bar[2] and close[1] > high[3] and close < open and close < close[1])


i_bar_1 = high[1] < high[2] and low[1] > low[2]
i_bar_2 = high[2] < high[3] and low[2] > low[3]
i_bar_3 = high[3] < high[4] and low[3] > low[4]
i_bar_4 = high[4] < high[5] and low[4] > low[5]

f_up_b = ((i_bar_1 and low < low[1] and close > high[1]) or (i_bar_2 and low < low[2] and close > high[2]) or (i_bar_3 and low < low[3] and close > high[3]) or (i_bar_4 and low < low[4] and close > high[4]))
f_up = f_up_b and not f_up_b[1]

f_dn_b = ((i_bar_1 and high > high[1] and close < low[1]) or (i_bar_2 and high > high[2] and close < low[2]) or (i_bar_3 and high > high[3] and close < low[3]) or (i_bar_4 and high > high[4] and close < low[4]))
f_dn = f_dn_b and not f_dn_b[1]

f_up_e = f_up_e_raw and not f_up_e_raw[1]
f_dn_e = f_dn_e_raw and not f_dn_e_raw[1]
f_up_sig = f_up or (f_up_e and not f_up)
f_dn_sig = f_dn or (f_dn_e and not f_dn)


plotchar(eff_plot_i_bar and is_confirmed_bar and i_bar, char='i', location=location.abovebar, color=color.new(color.gray, 0), title='I bar')
plotchar(eff_plot_o_bar and is_confirmed_bar and o_bar, char='o', location=location.abovebar, color=o_bar_color, title='O bar')
plotchar(eff_plot_s_bar and is_confirmed_bar and s_bar, char='s', location=location.abovebar, color=color.new(color.silver, 0), offset=-1, title='S bar')
plotchar(plot_sw_bar and sweep_bear, char='S', location=location.abovebar, color=color.new(color.red, 0), offset=-1, title='Sweep bar bear')
plotchar(plot_sw_bar and sweep_bull, char='S', location=location.belowbar, color=color.new(color.green, 0), offset=-1, title='Sweep bar bull')

plotchar(eff_plot_f_bar and is_confirmed_bar and f_up_sig, char='F', location=location.belowbar, color=color.new(color.blue, 0), title='F bar up')
plotchar(eff_plot_f_bar and is_confirmed_bar and f_dn_sig, char='F', location=location.abovebar, color=color.new(color.red, 0), title='F bar down')

// Registry Updates
if eff_plot_l12_bar and is_confirmed_bar
    sig.l12_bull := plot_l12_long
    sig.l12_bear := plot_l12_short

if eff_plot_f_bar and is_confirmed_bar
    sig.pat_bull := f_up_sig
    sig.pat_bear := f_dn_sig

if eff_plot_o_bar and is_confirmed_bar
    // Green O (Long) -> Bullish
    if o_bar and close < low[1]
        sig.o_bull := true
    // Red O (Short) -> Bearish
    if o_bar and close > high[1]
        sig.o_bear := true


//----------------------------------------------------------------- segments (Visuals for Chart) --------------------------------------------------------------

count1_l                    = 0
count2_l                    = 0
segment_1_stat_l            = false
segment_2_stat_l            = false
segment_3_stat_l            = false

var line segment_low_1_l    = na
var line segment_low_2_l    = na
var line segment_low_3_l    = na

count1_s                    = 0
count2_s                    = 0
segment_1_stat_s            = false
segment_2_stat_s            = false
segment_3_stat_s            = false

var line segment_high_1     = na
var line segment_high_2     = na
var line segment_high_3     = na

// Stage 5: Segments Optimization (Bar Close Only)
// Only run the heavy loops when the bar is confirmed (historical bars or realtime bar close)
if eff_plot_segments
    if barstate.isconfirmed
        if not na(segment_low_1_l)
            line.delete(segment_low_1_l)
            segment_low_1_l := na
        if not na(segment_low_2_l)
            line.delete(segment_low_2_l)
            segment_low_2_l := na
        if not na(segment_low_3_l)
            line.delete(segment_low_3_l)
            segment_low_3_l := na
        if not na(segment_high_1)
            line.delete(segment_high_1)
            segment_high_1 := na
        if not na(segment_high_2)
            line.delete(segment_high_2)
            segment_high_2 := na
        if not na(segment_high_3)
            line.delete(segment_high_3)
            segment_high_3 := na

        // long segments
        for i = 0 to sb by 1
            count1_l := count1_l + 1
            if low > low[i + 1]
                segment_low_1_l := line.new(x1=bar_index[1 + i], y1=low[1 + i], x2=bar_index, y2=low, color=color.new(color_seg, transp_seg), width=3)
                segment_1_stat_l := true
                break

        if segment_1_stat_l
            for i = count1_l to sb + count1_l by 1
                count2_l := count2_l + 1
                if low[count1_l] > low[i + 1]
                    segment_low_2_l := line.new(x1=bar_index[1 + i], y1=low[1 + i], x2=bar_index[count1_l], y2=low[count1_l], color=color.new(color_seg, transp_seg), width=2)
                    segment_2_stat_l := true
                    break

        if segment_2_stat_l
            for i = count2_l to sb + count2_l by 1
                if low[count1_l + count2_l] > low[i + 1 + count1_l]
                    segment_low_3_l := line.new(x1=bar_index[i + 1 + count1_l], y1=low[i + 1 + count1_l], x2=bar_index[count1_l + count2_l], y2=low[count1_l + count2_l], color=color.new(color_seg, transp_seg), width=1)
                    segment_3_stat_l := true
                    break

        // short segments
        for i = 0 to sb by 1
            count1_s := count1_s + 1
            if high < high[i + 1]
                segment_high_1 := line.new(x1=bar_index[1 + i], y1=high[1 + i], x2=bar_index, y2=high, color=color.new(color_seg, transp_seg), width=3)
                segment_1_stat_s := true
                break

        if segment_1_stat_s
            for i = count1_s to sb + count1_s by 1
                count2_s := count2_s + 1
                if high[count1_s] < high[i + 1]
                    segment_high_2 := line.new(x1=bar_index[1 + i], y1=high[1 + i], x2=bar_index[count1_s], y2=high[count1_s], color=color.new(color_seg, transp_seg), width=2)
                    segment_2_stat_s := true
                    break

        if segment_2_stat_s
            for i = count2_s to sb + count2_s by 1
                if high[count1_s + count2_s] < high[i + 1 + count1_s]
                    segment_high_3 := line.new(x1=bar_index[i + 1 + count1_s], y1=high[i + 1 + count1_s], x2=bar_index[count1_s + count2_s], y2=high[count1_s + count2_s], color=color.new(color_seg, transp_seg), width=1)
                    segment_3_stat_s := true
                    break

        // --- Signal Logic for Registry (Segments) ---
        // Segments Signal:
        // Buy: High > High[1] AND 3 Long Segments Active
        // Sell: Low < Low[1] AND 3 Short Segments Active
        // Note: segment_*_stat_* variables are local to this block.
        // We reuse the logic:

        // We need to re-verify state if not already captured.
        // Actually, segment_3_stat_l is only true if we found 3 segments.
        // Buy Signal: high > high[1] and segment_1_stat_l and segment_2_stat_l and segment_3_stat_l

        if high > high[1] and segment_3_stat_l
            sig.seg_bull := true

        if low < low[1] and segment_3_stat_s
            sig.seg_bear := true
else
    if not na(segment_low_1_l)
        line.delete(segment_low_1_l)
        segment_low_1_l := na
    if not na(segment_low_2_l)
        line.delete(segment_low_2_l)
        segment_low_2_l := na
    if not na(segment_low_3_l)
        line.delete(segment_low_3_l)
        segment_low_3_l := na
    if not na(segment_high_1)
        line.delete(segment_high_1)
        segment_high_1 := na
    if not na(segment_high_2)
        line.delete(segment_high_2)
        segment_high_2 := na
    if not na(segment_high_3)
        line.delete(segment_high_3)
        segment_high_3 := na


//-------------------------------------------------------------------- info panel -------------------------------------------------------------------------

//indicator funktions for 4h, d, w, m

f_htf_reg_state_exact() =>
    float kc_mid_l = ta.ema(close, eff_kc_len)
    float kc_range_l = ta.atr(eff_kc_len)
    float kc_up_l = kc_mid_l + (kc_range_l * eff_kc_mult)
    float kc_dn_l = kc_mid_l - (kc_range_l * eff_kc_mult)
    [s_bb_mid_l, s_bb_up_l, s_bb_dn_l] = ta.bb(close, eff_bb_len, eff_bb_mult)
    float bbw_l = (not na(s_bb_mid_l) and s_bb_mid_l != 0.0) ? (s_bb_up_l - s_bb_dn_l) / s_bb_mid_l : na
    float avg_bbw_l = ta.sma(bbw_l, eff_vol_len)
    bool squeeze_kc_l = (s_bb_up_l < kc_up_l) and (s_bb_dn_l > kc_dn_l)

    float trend_enter_th_l = eff_adx_th * eff_enter_k
    float trend_exit_th_l = eff_adx_th * eff_exit_k
    float squeeze_enter_mult_l = 0.70 / eff_enter_k
    float squeeze_exit_mult_l = 0.70 / eff_exit_k
    [_, _, adx_r_l] = ta.dmi(eff_adx_len, eff_adx_len)

    var bool trend_active_l = false
    var bool squeeze_active_l = false
    var string regime_state_l = "RANGE"
    var string regime_candidate_l = "RANGE"
    var int regime_run_l = 0

    [trend_active_runtime_l, squeeze_active_runtime_l, regime_candidate_eval_l] = f_update_regime_runtime(trend_active_l, squeeze_active_l, bbw_l, avg_bbw_l, squeeze_kc_l, eff_use_kc_squeeze, squeeze_strict, adx_r_l, trend_enter_th_l, trend_exit_th_l, squeeze_enter_mult_l, squeeze_exit_mult_l, barstate.isconfirmed)
    trend_active_l := trend_active_runtime_l
    squeeze_active_l := squeeze_active_runtime_l
    [regime_state_next_l, regime_candidate_next_l, regime_run_next_l] = f_update_regime_state(regime_state_l, regime_candidate_l, regime_run_l, regime_candidate_eval_l, eff_persist_bars, barstate.isconfirmed)
    regime_state_l := regime_state_next_l
    regime_candidate_l := regime_candidate_next_l
    regime_run_l := regime_run_next_l

    string regime_live_l = barstate.isconfirmed ? regime_state_l : regime_candidate_eval_l
    regime_live_l == "TREND" ? 1 : regime_live_l == "SQUEEZE" ? -1 : 0

f_htf_bias_state_exact() =>
    var int fvg_state_l = 1
    bool bull_fvg_cond_l = low > high[2]
    bool bear_fvg_cond_l = high < low[2]
    fvg_state_l := bull_fvg_cond_l ? 1 : bear_fvg_cond_l ? -1 : fvg_state_l

    float up_fr_state_l = ta.pivothigh(2, 2)
    float dn_fr_state_l = ta.pivotlow(2, 2)
    float last_up_lvl_l = ta.valuewhen(not na(up_fr_state_l), high[2], 0)
    float last_dn_lvl_l = ta.valuewhen(not na(dn_fr_state_l), low[2], 0)
    var int fr_state_l = 1
    bool fr_evt_up_l = ta.crossover(high, last_up_lvl_l)
    bool fr_evt_dn_l = ta.crossunder(low, last_dn_lvl_l)
    fr_state_l := fr_evt_up_l ? 1 : fr_evt_dn_l ? -1 : fr_state_l

    float W_FR_CORE_L = 4.0
    float W_FVG_CORE_L = 4.0
    float W_KAMA_CORE_L = 2.0
    int reg_state_l = f_htf_reg_state_exact()
    float w_fvg_effective_l = reg_state_l == -1 ? W_FVG_CORE_L * 0.35 : W_FVG_CORE_L
    float kama_val_l = kama_enabled ? f_kama(close, kama_len, kama_fast, kama_slow) : na
    bool kama_bull_l = kama_enabled and not na(kama_val_l) and kama_slope_color and kama_val_l > kama_val_l[1]
    bool kama_bear_l = kama_enabled and not na(kama_val_l) and kama_slope_color and kama_val_l < kama_val_l[1]
    float kama_val_score_l = kama_bull_l ? 1.0 : kama_bear_l ? -1.0 : 0.0
    float core_w_sum_l = 0.0
    float core_raw_sum_l = 0.0
    if eff_fractals_plot
        core_w_sum_l += W_FR_CORE_L
        core_raw_sum_l += (fr_state_l * W_FR_CORE_L)
    core_w_sum_l += w_fvg_effective_l
    core_raw_sum_l += (fvg_state_l * w_fvg_effective_l)
    core_w_sum_l += W_KAMA_CORE_L
    core_raw_sum_l += (kama_val_score_l * W_KAMA_CORE_L)
    float core_raw_l = (core_w_sum_l > 0) ? (core_raw_sum_l / core_w_sum_l) : 0.0
    float core_smooth_l = ta.ema(core_raw_l, eff_core_ema_len)

    var float ov_tl_l = 0.0
    var float ov_seg_l = 0.0
    if sig.tl_bull
        ov_tl_l := 1.0
    else if sig.tl_bear
        ov_tl_l := -1.0
    else
        ov_tl_l := ov_tl_l * eff_ov_decay
    if sig.seg_bull
        ov_seg_l := 1.0
    else if sig.seg_bear
        ov_seg_l := -1.0
    else
        ov_seg_l := ov_seg_l * eff_ov_decay

    float ov_w_sum_l = 0.0
    float ov_raw_sum_l = 0.0
    if eff_plot_trendline
        ov_w_sum_l += 1.0
        ov_raw_sum_l += ov_tl_l
    if eff_plot_segments
        ov_w_sum_l += 1.0
        ov_raw_sum_l += ov_seg_l
    float overlay_raw_l = (ov_w_sum_l > 0) ? (ov_raw_sum_l / ov_w_sum_l) : 0.0

    float calc_atr_l = ta.atr(eff_atr_len)
    float atr_ref_l = ta.sma(calc_atr_l, eff_atr_norm)
    float atr_norm_l = (not na(atr_ref_l) and atr_ref_l > 0) ? (calc_atr_l / atr_ref_l) : 1.0
    float ov_scale_l = atr_norm_l < eff_atr_low ? 0.60 : 1.00
    float overlay_clamped_l = math.max(-eff_ov_clamp, math.min(eff_ov_clamp, overlay_raw_l)) * ov_scale_l

    float adr_range_l = high - low
    float adr_l = ta.sma(adr_range_l, eff_adr_len)
    float adr_pct_l = not na(adr_l) and adr_l > 0 ? (adr_range_l / adr_l) * 100.0 : na
    bool adr_warn_l = eff_use_adr_gate and not na(adr_pct_l) and adr_pct_l >= eff_adr_warn
    bool adr_hard_l = eff_use_adr_gate and not na(adr_pct_l) and adr_pct_l >= eff_adr_hard

    float final_raw_l = math.max(-1.0, math.min(1.0, core_smooth_l + overlay_clamped_l))
    float conf_gate_l = reg_state_l == -1 ? 0.40 : reg_state_l == 0 ? 0.70 : 1.0
    if adr_warn_l
        conf_gate_l := conf_gate_l * 0.85
    if adr_hard_l
        conf_gate_l := conf_gate_l * 0.70
    float conf_score_l = 50 + (50 * final_raw_l * conf_gate_l)

    float cb_enter_bull_l = math.max(eff_cb_enter_bull, eff_cb_exit_bull + 0.1)
    float cb_exit_bull_l = math.min(eff_cb_exit_bull, cb_enter_bull_l - 0.1)
    float cb_enter_bear_l = math.min(eff_cb_enter_bear, eff_cb_exit_bear - 0.1)
    float cb_exit_bear_l = math.max(eff_cb_exit_bear, cb_enter_bear_l + 0.1)
    int cb_enter_bars_l = math.max(1, eff_cb_enter_bars)
    int cb_exit_bars_l = math.max(1, eff_cb_exit_bars)
    bool enter_bull_l = conf_score_l >= cb_enter_bull_l
    bool enter_bear_l = conf_score_l <= cb_enter_bear_l
    bool exit_bull_l = conf_score_l <= cb_exit_bull_l
    bool exit_bear_l = conf_score_l >= cb_exit_bear_l
    int run_enter_bull_l = nz(ta.barssince(not enter_bull_l), 0)
    int run_enter_bear_l = nz(ta.barssince(not enter_bear_l), 0)
    int run_exit_bull_l = nz(ta.barssince(not exit_bull_l), 0)
    int run_exit_bear_l = nz(ta.barssince(not exit_bear_l), 0)
    bool enter_bull_ok_l = enter_bull_l and run_enter_bull_l >= cb_enter_bars_l
    bool enter_bear_ok_l = enter_bear_l and run_enter_bear_l >= cb_enter_bars_l
    bool exit_bull_ok_l = exit_bull_l and run_exit_bull_l >= cb_exit_bars_l
    bool exit_bear_ok_l = exit_bear_l and run_exit_bear_l >= cb_exit_bars_l

    var int conf_state_l = 0
    if conf_state_l == 0
        if enter_bull_ok_l
            conf_state_l := 1
        else if enter_bear_ok_l
            conf_state_l := -1
    else if conf_state_l == 1
        if exit_bull_ok_l
            conf_state_l := 0
    else if conf_state_l == -1
        if exit_bear_ok_l
            conf_state_l := 0

    conf_state_l

f_vwapInternalSessionActive(string _tz) =>
    bool _isWeekend = dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday
    bool _inLondon = not na(time(timeframe.period, "0900-1730", _tz))
    bool _inNewYork = not na(time(timeframe.period, "1530-2200", _tz))
    not _isWeekend and (_inLondon or _inNewYork)

f_vwap_src() =>
    vwap_src_opt == "HL2" ? hl2 :
     vwap_src_opt == "Close" ? close :
     vwap_src_opt == "OHLC4" ? ohlc4 :
     hlc3

f_panel_vwap_anchor_tf() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec < timeframe.in_seconds("240") ? "D" :
     sec == timeframe.in_seconds("240") ? "W" :
     sec == timeframe.in_seconds("D") ? "M" :
     sec == timeframe.in_seconds("W") ? "3M" :
     sec == timeframe.in_seconds("M") ? "12M" :
     "D"

f_panel_vwap_z() =>
    string anchor_tf = f_panel_vwap_anchor_tf()
    float src = f_vwap_src()

    var float cumVol = 0.0
    var float cumPV = 0.0

    bool reset = timeframe.change(anchor_tf)
    if reset
        cumVol := 0.0
        cumPV := 0.0

    bool in_window = vwap_only_sess ? f_vwapInternalSessionActive("Europe/Berlin") : true
    bool has_volume = not na(volume) and volume > 0
    if in_window and has_volume
        cumVol += volume
        cumPV += volume * src

    float anchor_vwap = cumVol > 0.0 ? cumPV / cumVol : na
    float dev = not na(anchor_vwap) ? close - anchor_vwap : na
    float sigma = ta.stdev(dev, vwap_stdev_len)
    not na(dev) and not na(sigma) and sigma > 0.0 ? dev / sigma : na

f_panel_sma_z() =>
    float src = f_vwap_src()
    float basis = ta.sma(src, reg_sma_len)
    float dev = not na(basis) ? close - basis : na
    float sigma = ta.stdev(dev, reg_sma_norm_len)
    not na(dev) and not na(sigma) and sigma > 0.0 ? dev / sigma : na

f_panel_reg_distance_z(float _vwap_z) =>
    float sma_z = f_panel_sma_z()
    reg_distance_metric == "SMA-Z" ? sma_z : _vwap_z

f_bias_fresh_limit() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec <= timeframe.in_seconds("60") ? 3 :
     sec <= timeframe.in_seconds("D") ? 2 :
     1

f_bias_late_limit() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec <= timeframe.in_seconds("60") ? 12 :
     sec <= timeframe.in_seconds("D") ? 6 :
     4

f_bias_reset_mean() =>
    kama_enabled ? f_kama(close, kama_len, kama_fast, kama_slow) : ta.ema(close, eff_core_ema_len)

f_bias_reset_near_z() =>
    math.min(1.2, math.max(0.6, z_th_entry * 0.50))

f_bias_is_stretched(float _vwap_z) =>
    not na(_vwap_z) and math.abs(_vwap_z) >= z_th_tp

f_bias_structure_reset_signals(int _bias_state, float _vwap_z, float _reset_ma) =>
    float near_z = f_bias_reset_near_z()
    bool has_z = not na(_vwap_z)
    bool has_ma = not na(_reset_ma)

    bool bull_rebalance = _bias_state == 1 and ((has_z and _vwap_z <= near_z) or (has_ma and low <= _reset_ma))
    bool bear_rebalance = _bias_state == -1 and ((has_z and _vwap_z >= -near_z) or (has_ma and high >= _reset_ma))
    bool bull_resume = _bias_state == 1 and ((has_ma and close > _reset_ma and close > open) or (has_z and _vwap_z > nz(_vwap_z[1], _vwap_z) and close > close[1]))
    bool bear_resume = _bias_state == -1 and ((has_ma and close < _reset_ma and close < open) or (has_z and _vwap_z < nz(_vwap_z[1], _vwap_z) and close < close[1]))

    bool reset_arm = bull_rebalance or bear_rebalance
    bool reset_confirm = bull_resume or bear_resume
    [reset_arm, reset_confirm]

f_bias_maturity(int _bias_state, int _bars_since_flip, int _bars_since_reset, float _vwap_z) =>
    int fresh_limit = f_bias_fresh_limit()
    int late_limit = f_bias_late_limit()
    float abs_z = math.abs(_vwap_z)

    int maturity = 0
    if _bias_state == 0
        maturity := 0
    else if not na(abs_z) and abs_z >= z_th_tp
        maturity := 3
    else if _bars_since_flip <= fresh_limit
        maturity := 1
    else if _bars_since_reset >= late_limit
        maturity := 3
    else
        maturity := 2

    maturity

// Helper function for Panel State
f_panel_state() =>
    // NOTE:
    // Return a primitive tuple instead of a UDT so the MTF panel can be
    // transported through request.security() without carrying object state.
    // This keeps the visible panel behavior the same while reducing replay
    // memory pressure.
    // FVG Close State
    var int fvg_state = 1
    bool bull_fvg_cond = low > high[2]
    bool bear_fvg_cond = high < low[2]
    fvg_state := bull_fvg_cond ? 1 : bear_fvg_cond ? -1 : fvg_state

    // Bill Williams Fractals State
    // Standard 2,2 fractals
    float up_fr_state = ta.pivothigh(2, 2)
    float dn_fr_state = ta.pivotlow(2, 2)

    float last_up_lvl = ta.valuewhen(not na(up_fr_state), high[2], 0)
    float last_dn_lvl = ta.valuewhen(not na(dn_fr_state), low[2], 0)

    var int fr_state = 1
    // Check breaks
    bool fr_evt_up = ta.crossover(high, last_up_lvl)
    bool fr_evt_dn = ta.crossunder(low, last_dn_lvl)
    fr_state := fr_evt_up ? 1 : fr_evt_dn ? -1 : fr_state

    int fvg_last_conf = barstate.isconfirmed ? fvg_state : fvg_state[1]
    int fr_last_conf = barstate.isconfirmed ? fr_state : fr_state[1]
    int fvg_candidate_i = not barstate.isconfirmed and (bull_fvg_cond or bear_fvg_cond) ? 1 : 0
    int fr_pending_i = not barstate.isconfirmed and (fr_evt_up or fr_evt_dn) ? 1 : 0

    int reg_state = 0
    int reg_last_conf = 0
    if panel_show_htf_reg
        reg_state := f_htf_reg_state_exact()
        reg_last_conf := barstate.isconfirmed ? reg_state : reg_state[1]

    int bias_state = 0
    int bias_last_conf = 0
    if panel_show_htf_bias
        bias_state := f_htf_bias_state_exact()
        bias_last_conf := barstate.isconfirmed ? bias_state : bias_state[1]

    bool use_strict_confirm = panel_update_mode == "Strict Confirm"

    // Bias maturity preparation for the later panel tuple extension.
    // Age is advanced only by confirmed bars in the requested panel TF context.
    var int bias_age_l = 0
    var int bias_reset_age_l = 0
    var int bias_prev_conf_l = 0
    var bool bias_reset_armed_l = false
    float panel_vwap_z = f_panel_vwap_z()
    float panel_reg_dist_z = f_panel_reg_distance_z(panel_vwap_z)
    float bias_reset_ma_l = f_bias_reset_mean()
    [reset_arm_l, reset_confirm_l] = f_bias_structure_reset_signals(bias_state, panel_vwap_z, bias_reset_ma_l)
    bool bias_stretched_l = f_bias_is_stretched(panel_vwap_z)
    if barstate.isconfirmed
        if bias_state == 0
            bias_age_l := 0
            bias_reset_age_l := 0
            bias_reset_armed_l := false
        else if bias_state != bias_prev_conf_l
            bias_age_l := 1
            bias_reset_age_l := 1
            bias_reset_armed_l := false
        else
            bias_age_l += 1
            bias_reset_age_l += 1

            bool can_structure_reset_l = bias_age_l > f_bias_fresh_limit()
            if can_structure_reset_l and reset_arm_l and not bias_stretched_l
                bias_reset_armed_l := true

            if can_structure_reset_l and bias_reset_armed_l and reset_confirm_l and not bias_stretched_l
                bias_reset_age_l := 1
                bias_reset_armed_l := false

        bias_prev_conf_l := bias_state

    int bias_age_conf_l = barstate.isconfirmed ? bias_age_l : nz(bias_age_l[1], bias_age_l)
    int bias_age_live_l = not barstate.isconfirmed and bias_state != 0 and bias_state != bias_prev_conf_l ? 1 : bias_age_l
    int bias_reset_age_live_l = bias_reset_age_l
    float panel_reg_dist_z_conf = barstate.isconfirmed ? panel_reg_dist_z : panel_reg_dist_z[1]
    float reg_dist_z_disp = use_strict_confirm ? panel_reg_dist_z_conf : panel_reg_dist_z
    int bias_maturity_live = f_bias_maturity(bias_state, bias_age_live_l, bias_reset_age_live_l, panel_vwap_z)
    int bias_maturity_conf = barstate.isconfirmed ? bias_maturity_live : nz(bias_maturity_live[1], bias_maturity_live)
    int bias_maturity_disp = use_strict_confirm ? bias_maturity_conf : bias_maturity_live

    int fvg_disp = use_strict_confirm ? fvg_last_conf : fvg_state
    int fr_disp = use_strict_confirm ? fr_last_conf : fr_state
    int bias_disp = use_strict_confirm ? bias_last_conf : bias_state
    int reg_disp = use_strict_confirm ? reg_last_conf : reg_state
    int row_live_i = barstate.isconfirmed ? 0 : 1
    int fvg_live_i = fvg_candidate_i
    int fr_live_i = fr_pending_i

    [fvg_disp, fr_disp, bias_disp, reg_disp, row_live_i, fvg_live_i, fr_live_i, bias_maturity_disp, reg_dist_z_disp]

//colors
color panel_long_color        = color.new(color.green, 30)
color panel_short_color       = color.new(color.red, 30)
color panel_neutral_color     = color.new(color.gray, 100)

color panel_reg_trend_color   = color.new(color.blue, 30)
color panel_reg_squeeze_color = color.new(color.orange, 30)
color panel_reg_range_color   = color.new(color.gray, 100)

//current tf condition for adx, hama and ema
// RECALC for info panel table to ensure it matches current chart regardless of bg signal

//mtf time frames
Intra           = timeframe.isintraday
Intra_D         = timeframe.isintraday or timeframe.isdaily
Intra_D_W       = timeframe.isintraday or timeframe.isdaily or timeframe.isweekly
Intra_D_W_M     = timeframe.isintraday or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly

// Stage 6: Info Panel Refactoring (Global Current TF + Gated HTF)

// 1. Always Run Current TF (To prevent warm-up issues)
atr14_val             = ta.atr(14)
float atr_pct_of_price = (not na(close) and close != 0) ? (atr14_val / close) * 100.0 : na
// Volatility Percentile (V%) - minimal & panel-only:
// - No extra UI besides the single "V%" toggle near panel settings.
// - Auto lookback: intraday uses a larger window than HTF.
int   vpct_len        = timeframe.isintraday ? 1000 : 252
float vpct_raw        = ta.percentrank(atr14_val, vpct_len)      // 0..100
float vpct_val        = ta.ema(vpct_raw, 5)                      // light smoothing
string vpct_token     = panel_show_range_vol_metrics and not na(vpct_val) ? "Volatility% " + str.tostring(math.round(vpct_val)) : ""
// Volatility% is displayed through the panel only; no hidden plot slot is used.

// Current CBOE Volatility Index value for the panel. The daily stream updates
// intraday while gaps_off keeps the latest value visible outside VIX market hours.
float vix_val = request.security("CBOE:VIX", "D", close, gaps=barmerge.gaps_off, ignore_invalid_symbol=true, calc_bars_count=2)

// Current-TF VWAP-Z remains the BIAS/VWP reference.
// REG text can optionally display a separate normalized distance metric.
float c_panel_vwap_z_live = f_panel_vwap_z()
float c_panel_reg_dist_z_live = f_panel_reg_distance_z(c_panel_vwap_z_live)
float c_panel_vwap_z_conf = barstate.isconfirmed ? c_panel_vwap_z_live : c_panel_vwap_z_live[1]
float c_panel_reg_dist_z_conf = barstate.isconfirmed ? c_panel_reg_dist_z_live : c_panel_reg_dist_z_live[1]
float c_panel_vwap_z_disp = panel_show_live ? c_panel_vwap_z_live : c_panel_vwap_z_conf
float c_panel_reg_dist_z_disp = panel_show_live ? c_panel_reg_dist_z_live : c_panel_reg_dist_z_conf

// Global Current TF Logic (Additions)
// FVG
var int fvg_state_inf = 1
bool bull_fvg_inf = low > high[2]
bool bear_fvg_inf = high < low[2]
if bull_fvg_inf
    fvg_state_inf := 1
else if bear_fvg_inf
    fvg_state_inf := -1

// Fractals
up_fr_inf = ta.pivothigh(2, 2)
dn_fr_inf = ta.pivotlow(2, 2)
last_up_lvl_inf = ta.valuewhen(not na(up_fr_inf), high[2], 0)
last_dn_lvl_inf = ta.valuewhen(not na(dn_fr_inf), low[2], 0)
var int fr_state_inf = 1
bool fr_evt_up_inf = ta.crossover(high, last_up_lvl_inf)
bool fr_evt_dn_inf = ta.crossunder(low, last_dn_lvl_inf)
if fr_evt_up_inf
    fr_state_inf := 1
else if fr_evt_dn_inf
    fr_state_inf := -1

// Info Panel Table (Declared global to allow deletion)
var table info_panel = na
var int panel_cols_prev = na
var string panel_pos_prev = ""
var int panel_col_tf = PANEL_LEGEND_COLS
var int panel_col_fvg = PANEL_LEGEND_COLS + 1
var int panel_col_fr = PANEL_LEGEND_COLS + 2
var int panel_col_bias = na
var int panel_col_reg = na
var int panel_col_last = PANEL_LEGEND_COLS + PANEL_COLS - 1
var int panel_current_tf_row = na
var float panel_runtime_col_width = PANEL_TOP_COL_W
var int bias_c_engine_conf = 0
var int reg_c_engine_conf = 0
var int bias_c_maturity_conf = 0
var int bias_c_age_conf = 0
var int bias_c_reset_age_conf = 0
var int bias_c_prev_conf = 0
var bool bias_c_reset_armed_conf = false

// Define Variables for HTF colors (Init to default)
// FVG Colors
color fvg_color_5m  = na
color fvg_color_15m = na
color fvg_color_1h  = na
color fvg_color_4h  = na
color fvg_color_d   = na
color fvg_color_w   = na
color fvg_color_m   = na

// FR Colors
color fr_color_5m  = na
color fr_color_15m = na
color fr_color_1h  = na
color fr_color_4h  = na
color fr_color_d   = na
color fr_color_w   = na
color fr_color_m   = na
color fvg_color_c  = na
color fr_color_c   = na

// 2. HTF state transport is evaluated on every calculation to keep Pine history-dependent functions consistent.
bool is_chart_tf_gt_1h = timeframe.in_seconds(timeframe.period) > 3600
int panel_calc_bars_count = panel_low_memory_mode ? 150 : is_chart_tf_gt_1h ? 220 : timeframe.in_seconds(timeframe.period) <= 900 ? 20000 : 6000
// Keep the MTF panel on the existing seven request.security() chains.
// f_panel_state() transports the base state plus bias maturity and selected REG distance-Z in one primitive tuple.
[ps_5m_fvg_disp, ps_5m_fr_disp, ps_5m_bias_disp, ps_5m_reg_disp, ps_5m_row_live_i, ps_5m_fvg_live_i, ps_5m_fr_live_i, ps_5m_bias_maturity_disp, ps_5m_reg_dist_z_disp] = request.security(syminfo.tickerid, '5', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_15m_fvg_disp, ps_15m_fr_disp, ps_15m_bias_disp, ps_15m_reg_disp, ps_15m_row_live_i, ps_15m_fvg_live_i, ps_15m_fr_live_i, ps_15m_bias_maturity_disp, ps_15m_reg_dist_z_disp] = request.security(syminfo.tickerid, '15', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_1h_fvg_disp, ps_1h_fr_disp, ps_1h_bias_disp, ps_1h_reg_disp, ps_1h_row_live_i, ps_1h_fvg_live_i, ps_1h_fr_live_i, ps_1h_bias_maturity_disp, ps_1h_reg_dist_z_disp] = request.security(syminfo.tickerid, '60', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_4h_fvg_disp, ps_4h_fr_disp, ps_4h_bias_disp, ps_4h_reg_disp, ps_4h_row_live_i, ps_4h_fvg_live_i, ps_4h_fr_live_i, ps_4h_bias_maturity_disp, ps_4h_reg_dist_z_disp] = request.security(syminfo.tickerid, '240', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_d_fvg_disp, ps_d_fr_disp, ps_d_bias_disp, ps_d_reg_disp, ps_d_row_live_i, ps_d_fvg_live_i, ps_d_fr_live_i, ps_d_bias_maturity_disp, ps_d_reg_dist_z_disp] = request.security(syminfo.tickerid, 'D', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_w_fvg_disp, ps_w_fr_disp, ps_w_bias_disp, ps_w_reg_disp, ps_w_row_live_i, ps_w_fvg_live_i, ps_w_fr_live_i, ps_w_bias_maturity_disp, ps_w_reg_dist_z_disp] = request.security(syminfo.tickerid, 'W', f_panel_state(), calc_bars_count=panel_calc_bars_count)
[ps_m_fvg_disp, ps_m_fr_disp, ps_m_bias_disp, ps_m_reg_disp, ps_m_row_live_i, ps_m_fvg_live_i, ps_m_fr_live_i, ps_m_bias_maturity_disp, ps_m_reg_dist_z_disp] = request.security(syminfo.tickerid, 'M', f_panel_state(), calc_bars_count=panel_calc_bars_count)

// 3. Gated HTF table update
if panel_pos != "None" and barstate.islast

    PanelDisplayState ps_5m = PanelDisplayState.new(ps_5m_fvg_disp, ps_5m_fr_disp, ps_5m_bias_disp, ps_5m_reg_disp, ps_5m_row_live_i, ps_5m_fvg_live_i, ps_5m_fr_live_i, ps_5m_bias_maturity_disp, ps_5m_reg_dist_z_disp)
    PanelDisplayState ps_15m = PanelDisplayState.new(ps_15m_fvg_disp, ps_15m_fr_disp, ps_15m_bias_disp, ps_15m_reg_disp, ps_15m_row_live_i, ps_15m_fvg_live_i, ps_15m_fr_live_i, ps_15m_bias_maturity_disp, ps_15m_reg_dist_z_disp)
    PanelDisplayState ps_1h = PanelDisplayState.new(ps_1h_fvg_disp, ps_1h_fr_disp, ps_1h_bias_disp, ps_1h_reg_disp, ps_1h_row_live_i, ps_1h_fvg_live_i, ps_1h_fr_live_i, ps_1h_bias_maturity_disp, ps_1h_reg_dist_z_disp)
    PanelDisplayState ps_4h = PanelDisplayState.new(ps_4h_fvg_disp, ps_4h_fr_disp, ps_4h_bias_disp, ps_4h_reg_disp, ps_4h_row_live_i, ps_4h_fvg_live_i, ps_4h_fr_live_i, ps_4h_bias_maturity_disp, ps_4h_reg_dist_z_disp)
    PanelDisplayState ps_d = PanelDisplayState.new(ps_d_fvg_disp, ps_d_fr_disp, ps_d_bias_disp, ps_d_reg_disp, ps_d_row_live_i, ps_d_fvg_live_i, ps_d_fr_live_i, ps_d_bias_maturity_disp, ps_d_reg_dist_z_disp)
    PanelDisplayState ps_w = PanelDisplayState.new(ps_w_fvg_disp, ps_w_fr_disp, ps_w_bias_disp, ps_w_reg_disp, ps_w_row_live_i, ps_w_fvg_live_i, ps_w_fr_live_i, ps_w_bias_maturity_disp, ps_w_reg_dist_z_disp)
    PanelDisplayState ps_m = PanelDisplayState.new(ps_m_fvg_disp, ps_m_fr_disp, ps_m_bias_disp, ps_m_reg_disp, ps_m_row_live_i, ps_m_fvg_live_i, ps_m_fr_live_i, ps_m_bias_maturity_disp, ps_m_reg_dist_z_disp)

    int ctf_conf_i = (barstate.isconfirmed or not barstate.isrealtime) ? 1 : 0
    bool ctf_conf = ctf_conf_i == 1
    int fvg_c_conf = ctf_conf ? fvg_state_inf : fvg_state_inf[1]
    int fr_c_conf = ctf_conf ? fr_state_inf : fr_state_inf[1]
    int bias_score_c = fvg_state_inf + fr_state_inf
    int bias_state_c = bias_score_c > 0 ? 1 : bias_score_c < 0 ? -1 : 0
    int bias_c_conf = ctf_conf ? bias_state_c : bias_state_c[1]
    [_, _, htf_adx_c] = ta.dmi(14, 14)
    [bb_mid_c, bb_up_c, bb_dn_c] = ta.bb(close, 20, 2.0)
    float bb_width_c = (not na(bb_mid_c) and bb_mid_c != 0.0) ? (bb_up_c - bb_dn_c) / bb_mid_c : na
    float bb_width_avg_c = ta.sma(bb_width_c, 80)
    bool reg_is_squeeze_c = not na(bb_width_c) and not na(bb_width_avg_c) and bb_width_c < bb_width_avg_c * 0.7
    bool reg_is_trend_c = not na(htf_adx_c) and htf_adx_c > 20
    int reg_state_c = reg_is_squeeze_c ? -1 : reg_is_trend_c ? 1 : 0
    int reg_c_conf = ctf_conf ? reg_state_c : reg_state_c[1]
    bool use_strict_confirm = panel_update_mode == "Strict Confirm"
    int fvg_disp_c_local = use_strict_confirm ? fvg_c_conf : fvg_state_inf
    int fr_disp_c_local = use_strict_confirm ? fr_c_conf : fr_state_inf
    int bias_disp_c_local = use_strict_confirm ? bias_c_conf : bias_state_c
    int reg_disp_c_local = use_strict_confirm ? reg_c_conf : reg_state_c
    int row_live_c = barstate.isconfirmed ? 0 : 1
    int fvg_candidate_c = not barstate.isconfirmed and (bull_fvg_inf or bear_fvg_inf) ? 1 : 0
    int fr_pending_c = not barstate.isconfirmed and (fr_evt_up_inf or fr_evt_dn_inf) ? 1 : 0
    PanelDisplayState ps_c = PanelDisplayState.new(fvg_disp_c_local, fr_disp_c_local, bias_disp_c_local, reg_disp_c_local, row_live_c, fvg_candidate_c, fr_pending_c, 0, na)

    // Stage 6: Debug Instrument

    bool panel_live_mode = panel_show_live and barstate.isrealtime
    string m_fvg_5m = f_panel_marker_from_live(panel_live_mode, ps_5m.fvg_live_i)
    string m_fvg_15m = f_panel_marker_from_live(panel_live_mode, ps_15m.fvg_live_i)
    string m_fvg_1h = f_panel_marker_from_live(panel_live_mode, ps_1h.fvg_live_i)
    string m_fvg_4h = f_panel_marker_from_live(panel_live_mode, ps_4h.fvg_live_i)
    string m_fvg_d = f_panel_marker_from_live(panel_live_mode, ps_d.fvg_live_i)
    string m_fvg_w = f_panel_marker_from_live(panel_live_mode, ps_w.fvg_live_i)
    string m_fvg_m = f_panel_marker_from_live(panel_live_mode, ps_m.fvg_live_i)
    string m_fvg_c = f_panel_marker_from_live(panel_live_mode, ps_c.fvg_live_i)

    string m_fr_5m = f_panel_marker_from_live(panel_live_mode, ps_5m.fr_live_i)
    string m_fr_15m = f_panel_marker_from_live(panel_live_mode, ps_15m.fr_live_i)
    string m_fr_1h = f_panel_marker_from_live(panel_live_mode, ps_1h.fr_live_i)
    string m_fr_4h = f_panel_marker_from_live(panel_live_mode, ps_4h.fr_live_i)
    string m_fr_d = f_panel_marker_from_live(panel_live_mode, ps_d.fr_live_i)
    string m_fr_w = f_panel_marker_from_live(panel_live_mode, ps_w.fr_live_i)
    string m_fr_m = f_panel_marker_from_live(panel_live_mode, ps_m.fr_live_i)
    string m_fr_c = f_panel_marker_from_live(panel_live_mode, ps_c.fr_live_i)


    int fvg_disp_5m = ps_5m.fvg_disp
    int fr_disp_5m = ps_5m.fr_disp
    int fvg_disp_15m = ps_15m.fvg_disp
    int fr_disp_15m = ps_15m.fr_disp
    int fvg_disp_1h = ps_1h.fvg_disp
    int fr_disp_1h = ps_1h.fr_disp
    int fvg_disp_4h = ps_4h.fvg_disp
    int fr_disp_4h = ps_4h.fr_disp
    int fvg_disp_d = ps_d.fvg_disp
    int fr_disp_d = ps_d.fr_disp
    int fvg_disp_w = ps_w.fvg_disp
    int fr_disp_w = ps_w.fr_disp
    int fvg_disp_m = ps_m.fvg_disp
    int fr_disp_m = ps_m.fr_disp
    int fvg_disp_c = ps_c.fvg_disp
    int fr_disp_c = ps_c.fr_disp

    int bias_disp_5m = ps_5m.bias_disp
    int bias_disp_15m = ps_15m.bias_disp
    int bias_disp_1h = ps_1h.bias_disp
    int bias_disp_4h = ps_4h.bias_disp
    int bias_disp_d = ps_d.bias_disp
    int bias_disp_w = ps_w.bias_disp
    int bias_disp_m = ps_m.bias_disp

    int reg_disp_5m = ps_5m.reg_disp
    int reg_disp_15m = ps_15m.reg_disp
    int reg_disp_1h = ps_1h.reg_disp
    int reg_disp_4h = ps_4h.reg_disp
    int reg_disp_d = ps_d.reg_disp
    int reg_disp_w = ps_w.reg_disp
    int reg_disp_m = ps_m.reg_disp

    // --- Color Logic ---
    // FVG
    fvg_color_5m  := fvg_disp_5m == 1 ? panel_long_color : fvg_disp_5m == -1 ? panel_short_color : panel_neutral_color
    fvg_color_15m := fvg_disp_15m == 1 ? panel_long_color : fvg_disp_15m == -1 ? panel_short_color : panel_neutral_color
    fvg_color_1h  := fvg_disp_1h == 1 ? panel_long_color : fvg_disp_1h == -1 ? panel_short_color : panel_neutral_color
    fvg_color_4h  := fvg_disp_4h == 1 ? panel_long_color : fvg_disp_4h == -1 ? panel_short_color : panel_neutral_color
    fvg_color_d   := fvg_disp_d == 1 ? panel_long_color : fvg_disp_d == -1 ? panel_short_color : panel_neutral_color
    fvg_color_w   := fvg_disp_w == 1 ? panel_long_color : fvg_disp_w == -1 ? panel_short_color : panel_neutral_color
    fvg_color_m   := fvg_disp_m == 1 ? panel_long_color : fvg_disp_m == -1 ? panel_short_color : panel_neutral_color

    // FR (Fractals)
    fr_color_5m   := fr_disp_5m == 1 ? panel_long_color : fr_disp_5m == -1 ? panel_short_color : panel_neutral_color
    fr_color_15m  := fr_disp_15m == 1 ? panel_long_color : fr_disp_15m == -1 ? panel_short_color : panel_neutral_color
    fr_color_1h   := fr_disp_1h == 1 ? panel_long_color : fr_disp_1h == -1 ? panel_short_color : panel_neutral_color
    fr_color_4h   := fr_disp_4h == 1 ? panel_long_color : fr_disp_4h == -1 ? panel_short_color : panel_neutral_color
    fr_color_d    := fr_disp_d == 1 ? panel_long_color : fr_disp_d == -1 ? panel_short_color : panel_neutral_color
    fr_color_w    := fr_disp_w == 1 ? panel_long_color : fr_disp_w == -1 ? panel_short_color : panel_neutral_color
    fr_color_m    := fr_disp_m == 1 ? panel_long_color : fr_disp_m == -1 ? panel_short_color : panel_neutral_color
    fvg_color_c   := fvg_disp_c == 1 ? panel_long_color : fvg_disp_c == -1 ? panel_short_color : panel_neutral_color
    fr_color_c    := fr_disp_c == 1 ? panel_long_color : fr_disp_c == -1 ? panel_short_color : panel_neutral_color

    // Stage 7: TF Highlight Logic (Optimized with var)
    var color col_tf_highlight = color.new(color.yellow, 75)
    var int cur_sec = timeframe.in_seconds(timeframe.period)

    // Exact matches (Cached)
    var bool is_5m  = cur_sec == timeframe.in_seconds("5")
    var bool is_15m = cur_sec == timeframe.in_seconds("15")
    var bool is_1h  = cur_sec == timeframe.in_seconds("60")
    var bool is_4h  = cur_sec == timeframe.in_seconds("240")
    var bool is_1d  = cur_sec == timeframe.in_seconds("D")
    var bool is_1w  = cur_sec == timeframe.in_seconds("W")
    var bool is_1m  = cur_sec == timeframe.in_seconds("M")

    // If none match, highlight "Current"
    var bool is_custom_tf = not (is_5m or is_15m or is_1h or is_4h or is_1d or is_1w or is_1m)

    int panel_extra_cols = (panel_show_htf_bias ? 1 : 0) + (panel_show_htf_reg ? 1 : 0)
    int panel_main_cols_eff = 3 + panel_extra_cols
    int col_legend = 0
    int col_offset = PANEL_LEGEND_COLS
    int col_tf = col_offset
    int col_fvg = col_offset + 1
    int col_fr = col_offset + 2
    int col_bias = panel_show_htf_bias ? col_offset + 3 : na
    int col_reg = panel_show_htf_reg ? (panel_show_htf_bias ? col_offset + 4 : col_offset + 3) : na
    int panel_cols_eff = panel_main_cols_eff + PANEL_LEGEND_COLS
    int col_last = panel_cols_eff - 1
    float panel_total_width = PANEL_TOP_COL_W * PANEL_COLS
    float panel_col_width = panel_total_width / panel_main_cols_eff

    string pos_input = panel_pos == 'Top Right' ? position.top_right : panel_pos == 'Bottom Left' ? position.bottom_left : panel_pos == 'Middle Right' ? position.middle_right : panel_pos == 'Middle Left' ? position.middle_left : position.bottom_right
    bool panel_layout_changed = na(info_panel) or panel_cols_prev != panel_cols_eff or panel_pos_prev != pos_input
    if panel_layout_changed
        if not na(info_panel)
            table.delete(info_panel)
        info_panel := table.new(position = pos_input, columns = panel_cols_eff, rows = PANEL_ROWS, bgcolor=color.new(color.blue, 95), frame_width=1, border_width=1, frame_color=color.new(color.black, 50), border_color=color.new(color.black, 50))
        panel_cols_prev := panel_cols_eff
        panel_pos_prev := pos_input

    panel_col_tf := col_tf
    panel_col_fvg := col_fvg
    panel_col_fr := col_fr
    panel_col_bias := col_bias
    panel_col_reg := col_reg
    panel_col_last := col_last
    panel_current_tf_row := is_1m ? 2 : is_1w ? 3 : is_1d ? 4 : is_4h ? 5 : is_1h ? 6 : is_15m ? 7 : is_5m ? 8 : na
    panel_runtime_col_width := panel_col_width

    // Legend Sidecar: column 0 is reserved for an optional left-expanding legend.
    // Main panel columns start at panel_col_tf / col_tf and must not merge through column 0.
    // Legend sidecar is bottom-aligned so the text stays anchored to the panel floor
    // and expands upward when the legend contains more lines.
    string legend_txt = 'FVG/FR: \nLong=Green, Short=Red, \nNeutral=Transparent\n⠀\nBIAS (engine): \nBULL/BEAR/NEUT\n• L/M/H/E = quality\n• A = aligned\n• X = misaligned\n⠀\nREG (engine): \nRANGE/TREND/SQUEEZE\n⠀\nHTF BIAS:\nColor=Bull/Bear/Neutral\n1 Fresh shift\n2 Working/Reloaded\n3 Late/Extended\n– Neutral/na\n2 = pullback/rebalance resumed\n3 = stretched/no reset\n⠀\nHTF REG:\nColor=Trend/Squeeze/Range\nText=selected Z distance\nVWAP-Z=mapped VWAP anchor\nSMA-Z=distance to SMA\n– na\n⠀\nVWAP map:\n<4H D, 4H W, 1D M\n1W Q, 1M Y\n⠀\nRVOL: L/M/H/E = quality \nVWP: N/S/T/E = zone/state' +
                       '\n⠀\n• C  = current tf\n• L  = low\n• M  = medium\n• H  = high\n• E  = extreme\n• N  = normal\n• S  = stretch\n• T  = tp'
    table.merge_cells(info_panel, col_legend, 0, col_legend, PANEL_ROWS - 1)
    table.cell(table_id=info_panel, column=col_legend, row=0, text=panel_show_legend ? legend_txt : "", text_size=size.small, text_color=color.silver, text_halign=text.align_left, text_valign=text.align_bottom)

    // HEADER NAMES (Row 1)
    table.cell(table_id=info_panel, column=col_tf, row=f_panel_row(1), text="TF", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, width=panel_col_width)
    table.cell(table_id=info_panel, column=col_fvg, row=f_panel_row(1), text="FVG", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, width=panel_col_width)
    table.cell(table_id=info_panel, column=col_fr, row=f_panel_row(1), text="FR", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, width=panel_col_width)
    if panel_show_htf_bias and not na(col_bias)
        table.cell(table_id=info_panel, column=col_bias, row=f_panel_row(1), text="BIAS", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, width=panel_col_width)
    if panel_show_htf_reg and not na(col_reg)
        table.cell(table_id=info_panel, column=col_reg, row=f_panel_row(1), text="REG", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, width=panel_col_width)

    // 1M (Row 2)
    f_render_mtf_row(info_panel, 2, "1M", is_1m, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_m, fvg_color_m, m_fr_m, fr_color_m, panel_show_htf_bias, f_format_bias_maturity(ps_m.bias_maturity_disp), bias_disp_m == 1 ? panel_long_color : bias_disp_m == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg, f_format_z_cell(ps_m.reg_dist_z_disp), reg_disp_m == 1 ? panel_reg_trend_color : reg_disp_m == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 1W (Row 3)
    f_render_mtf_row(info_panel, 3, "1W", is_1w, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_w, fvg_color_w, m_fr_w, fr_color_w, panel_show_htf_bias, f_format_bias_maturity(ps_w.bias_maturity_disp), bias_disp_w == 1 ? panel_long_color : bias_disp_w == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg, f_format_z_cell(ps_w.reg_dist_z_disp), reg_disp_w == 1 ? panel_reg_trend_color : reg_disp_w == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 1D (Row 4)
    f_render_mtf_row(info_panel, 4, "1D", is_1d, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_d, fvg_color_d, m_fr_d, fr_color_d, panel_show_htf_bias, f_format_bias_maturity(ps_d.bias_maturity_disp), bias_disp_d == 1 ? panel_long_color : bias_disp_d == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg, f_format_z_cell(ps_d.reg_dist_z_disp), reg_disp_d == 1 ? panel_reg_trend_color : reg_disp_d == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 4H (Row 5)
    f_render_mtf_row(info_panel, 5, "4H", is_4h, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_4h, Intra_D_W_M ? fvg_color_4h : na, m_fr_4h, Intra_D_W_M ? fr_color_4h : na, panel_show_htf_bias and Intra_D_W_M, f_format_bias_maturity(ps_4h.bias_maturity_disp), bias_disp_4h == 1 ? panel_long_color : bias_disp_4h == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg and Intra_D_W_M, f_format_z_cell(ps_4h.reg_dist_z_disp), reg_disp_4h == 1 ? panel_reg_trend_color : reg_disp_4h == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 1H (Row 6)
    f_render_mtf_row(info_panel, 6, "1H", is_1h, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_1h, Intra_D_W_M ? fvg_color_1h : na, m_fr_1h, Intra_D_W_M ? fr_color_1h : na, panel_show_htf_bias and Intra_D_W_M, f_format_bias_maturity(ps_1h.bias_maturity_disp), bias_disp_1h == 1 ? panel_long_color : bias_disp_1h == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg and Intra_D_W_M, f_format_z_cell(ps_1h.reg_dist_z_disp), reg_disp_1h == 1 ? panel_reg_trend_color : reg_disp_1h == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 15m (Row 7)
    f_render_mtf_row(info_panel, 7, "15m", is_15m, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_15m, Intra_D_W_M ? fvg_color_15m : na, m_fr_15m, Intra_D_W_M ? fr_color_15m : na, panel_show_htf_bias and Intra_D_W_M, f_format_bias_maturity(ps_15m.bias_maturity_disp), bias_disp_15m == 1 ? panel_long_color : bias_disp_15m == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg and Intra_D_W_M, f_format_z_cell(ps_15m.reg_dist_z_disp), reg_disp_15m == 1 ? panel_reg_trend_color : reg_disp_15m == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // 5m (Row 8)
    f_render_mtf_row(info_panel, 8, "5m", is_5m, col_tf, col_fvg, col_fr, col_bias, col_reg, m_fvg_5m, Intra_D_W_M ? fvg_color_5m : na, m_fr_5m, Intra_D_W_M ? fr_color_5m : na, panel_show_htf_bias and Intra_D_W_M, f_format_bias_maturity(ps_5m.bias_maturity_disp), bias_disp_5m == 1 ? panel_long_color : bias_disp_5m == -1 ? panel_short_color : panel_neutral_color, panel_show_htf_reg and Intra_D_W_M, f_format_z_cell(ps_5m.reg_dist_z_disp), reg_disp_5m == 1 ? panel_reg_trend_color : reg_disp_5m == -1 ? panel_reg_squeeze_color : panel_reg_range_color, panel_col_width)

    // Range & Volatility Metrics (Rows 9-13)
    f_render_range_vol_rows(info_panel, panel_show_range_vol_metrics, "ATR14 " + str.tostring(atr14_val, "#.#####"), "ATR%", "ADR%", "Volatility%", "VIX", col_tf, col_last)

    // HEADER (Row 14: Current)
    table.cell(table_id=info_panel, column=col_tf, row=f_panel_row(14), text="C", text_size=panel_header_size, text_color=color.silver, text_halign=panel_header_halign, text_valign=panel_header_valign, bgcolor=is_custom_tf ? col_tf_highlight : na, width=panel_col_width)
    table.cell(table_id=info_panel, column=col_fvg, row=f_panel_row(14), text=f_panel_marker_text(m_fvg_c), text_size=marker_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=fvg_color_c, width=panel_col_width)
    table.cell(table_id=info_panel, column=col_fr, row=f_panel_row(14), text=f_panel_marker_text(m_fr_c), text_size=marker_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=fr_color_c, width=panel_col_width)
else
    if not na(info_panel)
        table.delete(info_panel)
        info_panel := na
        panel_cols_prev := na
        panel_pos_prev := ""


// ----------------------------------------------------------- pivot points -----------------------------------------------------------------

// Optimized data fetch (tuples) to avoid hitting the 40-call security limit.
// Fetch High/Low/Close in ONE request per timeframe instead of three.

// Stage 1: Pivot Points Optimization
// Strict Gating: request.security only if input is active AND timeframe is valid

// Conditions (Visibility)
cond_h1 = timeframe.isintraday and timeframe.multiplier < 60
cond_h4 = timeframe.isintraday and timeframe.multiplier < 240


// Need Flags
need_h1 = eff_plot_pivots_h1 and cond_h1
need_h4 = eff_plot_pivots_h4 and cond_h4
need_d  = eff_plot_pivots_d  and Intra
need_w  = eff_plot_pivots_w  and Intra_D
need_m  = eff_plot_pivots_m  and Intra_D_W
need_3m = eff_plot_pivots_3m and Intra_D_W_M
need_12m= eff_plot_pivots_12m and Intra_D_W_M

// Data Variables (Initial NA)
float h1_high = na
float h1_low = na
float h1_close = na

float h4_high = na
float h4_low = na
float h4_close = na

float d_high = na
float d_low = na
float d_close = na

float w_high = na
float w_low = na
float w_close = na

float m_high = na
float m_low = na
float m_close = na

float m3_high = na
float m3_low = na
float m3_close = na

float m12_high = na
float m12_low = na
float m12_close = na

// Gated Security Calls - Stage 5: Last Bar Optimization
if barstate.islast
    if need_h1
        [t_h1, t_l1, t_c1] = request.security(syminfo.tickerid, "60", [high[1], low[1], close[1]])
        h1_high := t_h1
        h1_low := t_l1
        h1_close := t_c1

    if need_h4
        [t_h4, t_l4, t_c4] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1]])
        h4_high := t_h4
        h4_low := t_l4
        h4_close := t_c4

    if need_d
        [t_hd, t_ld, t_cd] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]])
        d_high := t_hd
        d_low := t_ld
        d_close := t_cd

    if need_w
        [t_hw, t_lw, t_cw] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]])
        w_high := t_hw
        w_low := t_lw
        w_close := t_cw

    if need_m
        [t_hm, t_lm, t_cm] = request.security(syminfo.tickerid, "M", [high[1], low[1], close[1]])
        m_high := t_hm
        m_low := t_lm
        m_close := t_cm

    if need_3m
        [t_h3m, t_l3m, t_c3m] = request.security(syminfo.tickerid, "3M", [high[1], low[1], close[1]])
        m3_high := t_h3m
        m3_low := t_l3m
        m3_close := t_c3m

    if need_12m
        [t_h12m, t_l12m, t_c12m] = request.security(syminfo.tickerid, "12M", [high[1], low[1], close[1]])
        m12_high := t_h12m
        m12_low := t_l12m
        m12_close := t_c12m

// --- Calculations ---

f_calc_classic_pivots(_h, _l, _c) =>
    if na(_h) or na(_l) or na(_c)
        [na, na, na, na, na, na, na, na, na]
    else
        float pp = (_h + _l + _c) / 3.0
        float r1 = 2.0 * pp - _l
        float r2 = pp + (_h - _l)
        float r3 = _h + 2.0 * (pp - _l)
        float r4 = pp + 3.0 * (_h - _l)
        float s1 = 2.0 * pp - _h
        float s2 = pp - (_h - _l)
        float s3 = _l - 2.0 * (_h - pp)
        float s4 = pp - 3.0 * (_h - _l)
        [pp, r1, r2, r3, r4, s1, s2, s3, s4]

// Classic pivots per timeframe (PP, R1-R4, S1-S4)
[h1_PP, h1_R1, h1_R2, h1_R3, h1_R4, h1_S1, h1_S2, h1_S3, h1_S4] = f_calc_classic_pivots(h1_high, h1_low, h1_close)
[h4_PP, h4_R1, h4_R2, h4_R3, h4_R4, h4_S1, h4_S2, h4_S3, h4_S4] = f_calc_classic_pivots(h4_high, h4_low, h4_close)
[d_PP, d_R1, d_R2, d_R3, d_R4, d_S1, d_S2, d_S3, d_S4] = f_calc_classic_pivots(d_high, d_low, d_close)
[w_PP, w_R1, w_R2, w_R3, w_R4, w_S1, w_S2, w_S3, w_S4] = f_calc_classic_pivots(w_high, w_low, w_close)
[m_PP, m_R1, m_R2, m_R3, m_R4, m_S1, m_S2, m_S3, m_S4] = f_calc_classic_pivots(m_high, m_low, m_close)
[m3_PP, m3_R1, m3_R2, m3_R3, m3_R4, m3_S1, m3_S2, m3_S3, m3_S4] = f_calc_classic_pivots(m3_high, m3_low, m3_close)
[m12_PP, m12_R1, m12_R2, m12_R3, m12_R4, m12_S1, m12_S2, m12_S3, m12_S4] = f_calc_classic_pivots(m12_high, m12_low, m12_close)

// --- ALL PIVOTS AS LINES (Visual Update) ---

// 1. Definition of line variables
var line l_h1_pp = na, var line l_h1_r1 = na, var line l_h1_r2 = na, var line l_h1_r3 = na, var line l_h1_r4 = na, var line l_h1_s1 = na, var line l_h1_s2 = na, var line l_h1_s3 = na, var line l_h1_s4 = na
var label lb_h1_pp = na, var label lb_h1_r1 = na, var label lb_h1_r2 = na, var label lb_h1_r3 = na, var label lb_h1_r4 = na, var label lb_h1_s1 = na, var label lb_h1_s2 = na, var label lb_h1_s3 = na, var label lb_h1_s4 = na

var line l_h4_pp = na, var line l_h4_r1 = na, var line l_h4_r2 = na, var line l_h4_r3 = na, var line l_h4_r4 = na, var line l_h4_s1 = na, var line l_h4_s2 = na, var line l_h4_s3 = na, var line l_h4_s4 = na
var label lb_h4_pp = na, var label lb_h4_r1 = na, var label lb_h4_r2 = na, var label lb_h4_r3 = na, var label lb_h4_r4 = na, var label lb_h4_s1 = na, var label lb_h4_s2 = na, var label lb_h4_s3 = na, var label lb_h4_s4 = na

