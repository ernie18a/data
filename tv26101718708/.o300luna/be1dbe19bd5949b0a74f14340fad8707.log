// Stage 4: Bollinger Bands Hard-Gating
float basis = na
float dev_1 = na
float upper_1 = na
float lower_1 = na
float dev_3 = na
float upper_3 = na
float lower_3 = na
bool approach_up = false
bool approach_dn = false

if eff_BB_plot

    //bb1
    basis := f_bb_basis(eff_bb_len)
    dev_1 := eff_bb_mult * f_bb_dev(eff_bb_len)
    upper_1 := basis + dev_1
    lower_1 := basis - dev_1

    //bb3
    dev_3 := BB_sdev_3 * f_bb_dev(eff_bb_len)
    upper_3 := basis + dev_3
    lower_3 := basis - dev_3

    approach_up := near_bb ? high > upper_1 : true
    approach_dn := near_bb ? low < lower_1 : true

bup_1 = plot(eff_BB_plot and approach_up ? upper_1 : na, title='Upper BB1', color=color.new(color.gray, 100), linewidth=1)
bdn_1 = plot(eff_BB_plot and approach_dn ? lower_1 : na, title='Lower BB1', color=color.new(color.gray, 100), linewidth=1)

bup_3 = plot(eff_BB_plot and approach_up ? upper_3 : na, title='Upper BB3', color=color.new(color.gray, 100), linewidth=1)
bdn_3 = plot(eff_BB_plot and approach_dn ? lower_3 : na, title='Lower BB3', color=color.new(color.gray, 100), linewidth=1)

fill(bup_1, bup_3, color=color.new(color.red, 80))
fill(bdn_1, bdn_3, color=color.new(color.green, 80))


//------------------------------------------------------- VWAP Core & Bands -------------------------------------------------------
// Stage 3 & 4: VWAP Core + Bands + Z-Score

f_update_vwap_line_state(VwapState _state, bool _reset, bool _in_calc_window, float _src) =>
    if _reset
        _state.cumVol := 0.0
        _state.cumPV := 0.0
        _state.vwap := na
    if _in_calc_window
        _state.cumVol += volume
        _state.cumPV += (volume * _src)
    _state.cumVol > 0 ? _state.cumPV / _state.cumVol : na

f_resolve_vwap_line_visibility(bool _enabled, string _mode, int _tf_sec) =>
    bool _show_monthly_and_up = _mode == "All but < Monthly"
    bool _show_all_lte_month = _mode == "All <= 1M"
    bool _daily_tf_allowed = not na(_tf_sec) and _tf_sec < 14400
    bool _weekly_tf_allowed = not na(_tf_sec) and _tf_sec <= 86400
    bool _show_daily = _enabled and _daily_tf_allowed and (_mode == "Daily" or _mode == "All" or _show_all_lte_month)
    bool _show_weekly = _enabled and _weekly_tf_allowed and (_mode == "Weekly" or _mode == "All" or _show_all_lte_month)
    bool _show_monthly = _enabled and (_mode == "Monthly" or _mode == "All" or _show_monthly_and_up or _show_all_lte_month)
    bool _show_quarterly = _enabled and (_mode == "Quarterly" or _mode == "All" or _show_monthly_and_up)
    bool _show_yearly = _enabled and (_mode == "Yearly" or _mode == "All" or _show_monthly_and_up)
    bool _show_active = _enabled and _mode == "Active Only"
    [_show_daily, _show_weekly, _show_monthly, _show_quarterly, _show_yearly, _show_active]

var VwapState vs = VwapState.new(0.0, 0.0, na)
var WelfordState ws = WelfordState.new(0, 0.0, 0.0)
var VwapState vs_line_day = VwapState.new(0.0, 0.0, na)
var VwapState vs_line_week = VwapState.new(0.0, 0.0, na)
var VwapState vs_line_month = VwapState.new(0.0, 0.0, na)
var VwapState vs_line_quarter = VwapState.new(0.0, 0.0, na)
var VwapState vs_line_year = VwapState.new(0.0, 0.0, na)

// Anchor Logic
bool new_anchor = false
int active_anchor_bars_back = eff_vwap_anchor == "Anchored (Bars Back)" ? vwap_anchor_bars_back : 0
int anchor_bar_index = math.max(0, last_bar_index - active_anchor_bars_back)
bool anchor_started = eff_vwap_anchor != "Anchored (Bars Back)" or bar_index >= anchor_bar_index
if eff_vwap_anchor == "Session (Daily Reset)"
    new_anchor := timeframe.change("D")
else if eff_vwap_anchor == "Weekly"
    new_anchor := timeframe.change("W")
else if eff_vwap_anchor == "Monthly"
    new_anchor := timeframe.change("M")
else if eff_vwap_anchor == "Anchored (Bars Back)"
    new_anchor := bar_index == anchor_bar_index

// Optional VWAP session filter uses internal London/New York windows; session visuals/inputs stay removed.
bool vwap_internal_session_active = f_vwapInternalSessionActive("Europe/Berlin")
bool in_calc_window = vwap_only_sess ? vwap_internal_session_active : true

// Update Logic
float vwap_val = na
float vwap_line_day = na
float vwap_line_week = na
float vwap_line_month = na
float vwap_line_quarter = na
float vwap_line_year = na
float sigma_val = na
float z_val = na
string stretch_state = "NORMAL"

if eff_vwap_enabled
    float src = f_vwap_src()

    // Anchor Reset
    if new_anchor
        vs.cumVol := 0.0
        vs.cumPV := 0.0
        vs.vwap := na
        ws.n := 0
        ws.mean := 0.0
        ws.m2 := 0.0

    // Core Calc

    if in_calc_window and anchor_started
        vs.cumVol += volume
        vs.cumPV += (volume * src)

    if anchor_started and vs.cumVol > 0
        vwap_val := vs.cumPV / vs.cumVol
        vs.vwap := vwap_val

    // Daily/Weekly/Monthly/Quarterly/Yearly line states for Visible Lines selector
    vwap_line_day := f_update_vwap_line_state(vs_line_day, timeframe.change("D"), in_calc_window, src)
    vwap_line_week := f_update_vwap_line_state(vs_line_week, timeframe.change("W"), in_calc_window, src)
    vwap_line_month := f_update_vwap_line_state(vs_line_month, timeframe.change("M"), in_calc_window, src)
    vwap_line_quarter := f_update_vwap_line_state(vs_line_quarter, timeframe.change("3M"), in_calc_window, src)
    vwap_line_year := f_update_vwap_line_state(vs_line_year, timeframe.change("12M"), in_calc_window, src)

// Bands / Sigma Calc
float dev = not na(vwap_val) ? close - vwap_val : na
float sigma_rolling = ta.stdev(dev, vwap_stdev_len)
if not na(vwap_val) and (eff_vwap_zone or eff_vwap_fullbands or eff_vwap_touched or eff_vwap_z)
    if vwap_sigma_mode == "Rolling (ta.stdev)"
        sigma_val := sigma_rolling
    else // Session (Welford)
        if in_calc_window
            ws.n += 1
            float delta = dev - ws.mean
            ws.mean += delta / ws.n
            ws.m2 += delta * (dev - ws.mean)

        float variance = ws.n > 1 ? ws.m2 / (ws.n - 1) : 0.0
        sigma_val := math.sqrt(variance)

    // Z-Score
    if eff_vwap_z and not na(sigma_val) and sigma_val > 0
        z_val := dev / sigma_val

        // State
        if z_val >= z_th_ext
            stretch_state := "EXTREME UP"
        else if z_val >= z_th_tp
            stretch_state := "TP UP"
        else if z_val >= z_th_entry
            stretch_state := "ENTRY UP"
        else if z_val <= -z_th_ext
            stretch_state := "EXTREME DN"
        else if z_val <= -z_th_tp
            stretch_state := "TP DN"
        else if z_val <= -z_th_entry
            stretch_state := "ENTRY DN"

// Plotting
string visible_lines_mode = vwap_show_line_mode == "Selected Anchor" ? "Active Only" : vwap_show_line_mode
[show_line_daily, show_line_weekly, show_line_monthly, show_line_quarterly, show_line_yearly, show_line_active] = f_resolve_vwap_line_visibility(eff_vwap_enabled, visible_lines_mode, tf_sec)

plot(show_line_active ? vwap_val : na, color=color.new(color.orange, 0), title="VWAP Active")
plot(show_line_daily ? vwap_line_day : na, color=color.new(color.orange, 0), title="VWAP Daily")
plot(show_line_weekly ? vwap_line_week : na, color=color.new(color.orange, 25), title="VWAP Weekly")
plot(show_line_monthly ? vwap_line_month : na, color=color.new(color.orange, 50), title="VWAP Monthly")
plot(show_line_quarterly ? vwap_line_quarter : na, color=color.new(color.orange, 58), title="VWAP Quarterly")
plot(show_line_yearly ? vwap_line_year : na, color=color.new(color.orange, 65), title="VWAP Yearly")

// Bands
plot((eff_vwap_zone or eff_vwap_fullbands) and not na(sigma_val) ? vwap_val + band_k1 * sigma_val : na, "B1 Up", color.new(color.gray, 70))
plot((eff_vwap_zone or eff_vwap_fullbands) and not na(sigma_val) ? vwap_val - band_k1 * sigma_val : na, "B1 Dn", color.new(color.gray, 70))
plot(eff_vwap_fullbands and not na(sigma_val) ? vwap_val + band_k2 * sigma_val : na, "B2 Up", color.new(color.gray, 50))
plot(eff_vwap_fullbands and not na(sigma_val) ? vwap_val - band_k2 * sigma_val : na, "B2 Dn", color.new(color.gray, 50))
plot(eff_vwap_fullbands and not na(sigma_val) ? vwap_val + band_k3 * sigma_val : na, "B3 Up", color.new(color.gray, 30))
plot(eff_vwap_fullbands and not na(sigma_val) ? vwap_val - band_k3 * sigma_val : na, "B3 Dn", color.new(color.gray, 30))

// VWAP Touched BG (fills only; Border Band is invisible)
float band_k4 = math.max(band_k3, math.max(band_k2, band_k1)) + 1.0
float vwap_touch_k = eff_vwap_touched_b1 ? band_k1 : eff_vwap_touched_b2 ? band_k2 : band_k3
float vwap_touch_border_k = switch vwap_touch_border_band
    "B4" => band_k4
    "B5" => band_k4 + 1.0
    "B6" => band_k4 + 2.0
    => band_k4 + 3.0

bool vwap_touch_up = eff_vwap_touched and not na(vwap_val) and not na(sigma_val) and (high > (vwap_val + vwap_touch_k * sigma_val))
bool vwap_touch_dn = eff_vwap_touched and not na(vwap_val) and not na(sigma_val) and (low < (vwap_val - vwap_touch_k * sigma_val))

vwap_touch_up_bx = plot(vwap_touch_up ? (vwap_val + vwap_touch_k * sigma_val) : na, "VWAP Touch Bx Up", color.new(color.gray, 100), linewidth=1)
vwap_touch_up_border = plot(vwap_touch_up ? (vwap_val + vwap_touch_border_k * sigma_val) : na, "VWAP Touch Border Up", color.new(color.gray, 100), linewidth=1)
fill(vwap_touch_up_bx, vwap_touch_up_border, color=color.new(color.red, 80))

vwap_touch_dn_bx = plot(vwap_touch_dn ? (vwap_val - vwap_touch_k * sigma_val) : na, "VWAP Touch Bx Dn", color.new(color.gray, 100), linewidth=1)
vwap_touch_dn_border = plot(vwap_touch_dn ? (vwap_val - vwap_touch_border_k * sigma_val) : na, "VWAP Touch Border Dn", color.new(color.gray, 100), linewidth=1)
fill(vwap_touch_dn_border, vwap_touch_dn_bx, color=color.new(color.green, 80))

// Label for Z
var label lb_vwap_z = na
if eff_vwap_z and vwap_z_show_label and stretch_state != "NORMAL" and barstate.islast
    label.delete(lb_vwap_z)
    color c_z = str.contains(stretch_state, "EXTREME") ? color.red : color.orange
    lb_vwap_z := label.new(bar_index, high, "Z: " + str.tostring(z_val, "#.##") + "\n⠀" + stretch_state, color=c_z, style=label.style_label_left, textcolor=color.white, size=size.small)
else
    label.delete(lb_vwap_z)
    lb_vwap_z := na

//----------------- MTF Candle Overlay removed (visual-only) -----------------

// --- Variables to track boxes for limit ---
var box[] boxes_fvg1 = array.new_box()
var box[] boxes_fvg2 = array.new_box()

// --- FVG 1 LOGIC ---

// Helper: Timeframe Duration
tf_ms1 = (fvg1_tf_sel == "" ? timeframe.in_seconds(timeframe.period) : timeframe.in_seconds(fvg1_tf_sel)) * 1000

// Variable to track the last drawn FVG time
var int last_fvg_time1 = 0

// Stage 3: Refactored FVG1 (No security if Current TF)
float h1_mtf1 = na, float l1_mtf1 = na, float h3_mtf1 = na, float l3_mtf1 = na, int t2_mtf1 = na

// Only fetch MTF data if valid TF selection AND enabled
if ON_FVG1 and fvg1_tf_sel != ""
    [t_h1, t_l1, t_h3, t_l3, t_t2] = request.security(syminfo.tickerid, fvg1_tf_sel, [high[1], low[1], high[3], low[3], time[2]], lookahead=barmerge.lookahead_off)
    h1_mtf1 := t_h1, l1_mtf1 := t_l1, h3_mtf1 := t_h3, l3_mtf1 := t_l3, t2_mtf1 := t_t2

if ON_FVG1
    box b_new = na
    // CASE A: Current Timeframe (Direct Source)
    if fvg1_tf_sel == ""
        if low > high[2] // Bullish
            _border_bull = color.new(color.green, 90)
            b_new := box.new(left=bar_index[2], top=low, right=bar_index + (fvg1_len - 1), bottom=high[2], border_color=_border_bull, bgcolor=col_fvg1_bull)

        if high < low[2] // Bearish
            _border_bear = color.new(color.red, 90)
            b_new := box.new(left=bar_index[2], top=low[2], right=bar_index + (fvg1_len - 1), bottom=high, border_color=_border_bear, bgcolor=col_fvg1_bear)

        // Registry
        sig.fvg_bull := low > high[2]
        sig.fvg_bear := high < low[2]

    // CASE B: Higher Timeframe (Security Source)
    else
        if t2_mtf1 != last_fvg_time1 and not na(t2_mtf1)
            t_left = t2_mtf1 - tf_ms1
            t_right = t2_mtf1 + (tf_ms1 * fvg1_len)

            if l1_mtf1 > h3_mtf1 // Bullish
                _border_bull = color.new(color.green, 90)
                b_new := box.new(left=t_left, top=l1_mtf1, right=t_right, bottom=h3_mtf1, xloc=xloc.bar_time, border_color=_border_bull, bgcolor=col_fvg1_bull)

            if h1_mtf1 < l3_mtf1 // Bearish
                _border_bear = color.new(color.red, 90)
                b_new := box.new(left=t_left, top=l3_mtf1, right=t_right, bottom=h1_mtf1, xloc=xloc.bar_time, border_color=_border_bear, bgcolor=col_fvg1_bear)

            last_fvg_time1 := t2_mtf1

    // Manage Box Limit
    if not na(b_new)
        array.push(boxes_fvg1, b_new)
        if array.size(boxes_fvg1) > fvg1_limit_eff
            box.delete(array.shift(boxes_fvg1))
else
    // Cleanup
    if array.size(boxes_fvg1) > 0
        for i = 0 to array.size(boxes_fvg1) - 1
            box.delete(array.get(boxes_fvg1, i))
        array.clear(boxes_fvg1)


// --- FVG 2 LOGIC ---

// Helper: Timeframe Duration
tf_ms2 = (fvg2_tf_sel == "" ? timeframe.in_seconds(timeframe.period) : timeframe.in_seconds(fvg2_tf_sel)) * 1000

// Variable to track the last drawn FVG time
var int last_fvg_time2 = 0

// Stage 3: Refactored FVG2 (No security if Current TF)
float h1_mtf2 = na, float l1_mtf2 = na, float h3_mtf2 = na, float l3_mtf2 = na, int t2_mtf2 = na

if ON_FVG2 and fvg2_tf_sel != ""
    [t_h1, t_l1, t_h3, t_l3, t_t2] = request.security(syminfo.tickerid, fvg2_tf_sel, [high[1], low[1], high[3], low[3], time[2]], lookahead=barmerge.lookahead_off)
    h1_mtf2 := t_h1, l1_mtf2 := t_l1, h3_mtf2 := t_h3, l3_mtf2 := t_l3, t2_mtf2 := t_t2

if ON_FVG2
    box b_new = na
    // CASE A: Current Timeframe (Direct Source)
    if fvg2_tf_sel == ""
        if low > high[2] // Bullish
            _border_bull = color.new(color.green, 90)
            b_new := box.new(left=bar_index[2], top=low, right=bar_index + (fvg2_len - 1), bottom=high[2], border_color=_border_bull, bgcolor=col_fvg2_bull)

        if high < low[2] // Bearish
            _border_bear = color.new(color.red, 90)
            b_new := box.new(left=bar_index[2], top=low[2], right=bar_index + (fvg2_len - 1), bottom=high, border_color=_border_bear, bgcolor=col_fvg2_bear)

    // CASE B: Higher Timeframe
    else
        if t2_mtf2 != last_fvg_time2 and not na(t2_mtf2)
            t_left = t2_mtf2 - tf_ms2
            t_right = t2_mtf2 + (tf_ms2 * fvg2_len)

            if l1_mtf2 > h3_mtf2 // Bullish
                _border_bull = color.new(color.green, 90)
                b_new := box.new(left=t_left, top=l1_mtf2, right=t_right, bottom=h3_mtf2, xloc=xloc.bar_time, border_color=_border_bull, bgcolor=col_fvg2_bull)

            if h1_mtf2 < l3_mtf2 // Bearish
                _border_bear = color.new(color.red, 90)
                b_new := box.new(left=t_left, top=l3_mtf2, right=t_right, bottom=h1_mtf2, xloc=xloc.bar_time, border_color=_border_bear, bgcolor=col_fvg2_bear)

            last_fvg_time2 := t2_mtf2

    // Manage Box Limit
    if not na(b_new)
        array.push(boxes_fvg2, b_new)
        if array.size(boxes_fvg2) > fvg2_limit_eff
            box.delete(array.shift(boxes_fvg2))
else
    // Cleanup
    if array.size(boxes_fvg2) > 0
        for i = 0 to array.size(boxes_fvg2) - 1
            box.delete(array.get(boxes_fvg2, i))
        array.clear(boxes_fvg2)


//--------------------------------------------------------- Real-time Fractal Alert ---------------------------------------------------------

// --- Logic Calculation ---
// We cannot use ta.pivothigh/low for the realtime bar effectively, so we check the structure manually.
// Structure: [Left2][Left1][Pivot][Right1][Current(Right2)]
// Indices:    [4]    [3]    [2]     [1]       [0]

// Check if bars 4, 3, 2, and 1 form a valid pre-fractal structure
valid_up_structure = high[2] > high[3] and high[2] > high[4] and high[2] > high[1]
valid_dn_structure = low[2] < low[3] and low[2] < low[4] and low[2] < low[1]

// Check if the current running bar (0) respects the fractal rule
// Up Fractal: Current High must be lower than Pivot High
rt_up_frac = valid_up_structure and high < high[2]

// Down Fractal: Current Low must be higher than Pivot Low
rt_dn_frac = valid_dn_structure and low > low[2]

// --- Trigger Alert ---
f_emit_rt_fractal_alert(alerts_enabled, any_alert_filter, rt_up_frac, rt_dn_frac)


//--------------------------------------------------------- Additional Context (No Plot-Limit Usage) ---------------------------------------------------------

// --- 2. Last Fractal S/R (Lines & Labels) ---

// Function to get last confirmed fractal price and time
f_get_last_fractal_data() =>
    ph = ta.pivothigh(high, 2, 2)
    pl = ta.pivotlow(low, 2, 2)
    // When ph is detected, the fractal apex is at [2]
    p_h_val = ta.valuewhen(not na(ph), high[2], 0)
    p_h_time = ta.valuewhen(not na(ph), time[2], 0)
    p_l_val = ta.valuewhen(not na(pl), low[2], 0)
    p_l_time = ta.valuewhen(not na(pl), time[2], 0)
    [p_h_val, p_h_time, p_l_val, p_l_time]

float frac_h_val = na
int frac_h_time = na
float frac_l_val = na
int frac_l_time = na

if ON_LAST_FR
    [t_fh, t_fht, t_fl, t_flt] = request.security(syminfo.tickerid, last_frac_tf, f_get_last_fractal_data())
    frac_h_val := t_fh
    frac_h_time := t_fht
    frac_l_val := t_fl
    frac_l_time := t_flt

var line l_last_fh = na
var line l_last_fl = na
var label lb_last_fh = na
var label lb_last_fl = na

if barstate.islast
    // Check Visibility
    is_valid_frac_tf = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(last_frac_tf)

    if ON_LAST_FR and is_valid_frac_tf
        if not na(frac_h_val)
            l_last_fh := f_line_get_or_create(l_last_fh, frac_h_time, frac_h_val, time, frac_h_val, color.new(color.gray, 50), line.style_dashed, xloc.bar_time)
            lb_last_fh := f_label_get_or_create(lb_last_fh, bar_index + 8, frac_h_val, "Frac High", color.new(color.gray, 30))

        if not na(frac_l_val)
            l_last_fl := f_line_get_or_create(l_last_fl, frac_l_time, frac_l_val, time, frac_l_val, color.new(color.gray, 50), line.style_dashed, xloc.bar_time)
            lb_last_fl := f_label_get_or_create(lb_last_fl, bar_index + 8, frac_l_val, "Frac Low", color.new(color.gray, 30))
    else
        line.delete(l_last_fh)
        l_last_fh := na
        line.delete(l_last_fl)
        l_last_fl := na
        label.delete(lb_last_fh)
        lb_last_fh := na
        label.delete(lb_last_fl)
        lb_last_fl := na
else
    // Cleanup if disabled (Hard Gating)
    line.delete(l_last_fh)
    l_last_fh := na
    line.delete(l_last_fl)
    l_last_fl := na
    label.delete(lb_last_fh)
    lb_last_fh := na
    label.delete(lb_last_fl)
    lb_last_fl := na


// --- 3. Volume Spikes (Char) ---
// Calculates if Volume is x-times larger than the SMA(20) of Volume
avg_vol = ta.sma(volume, 20)
is_vol_spike = volume > (avg_vol * vol_mult)

// Uses plotchar (Symbol 'V' in bold RED)
plotchar(eff_show_vol and is_vol_spike, char='v', location=location.bottom, color=color.new(color.red, 30), size=size.tiny, title="High Volume Spike")
sig.vol_spike := eff_show_vol and is_vol_spike


// --- Stage 2: ADR/Today Range Calculation ---
float d_range_local = na
float adr_local = na
float adr_pct = na

bool new_day = timeframe.change("D")
var float dayHi = na
var float dayLo = na

if timeframe.isintraday
    if new_day or na(dayHi) or na(dayLo)
        dayHi := high
        dayLo := low
    else
        dayHi := math.max(dayHi, high)
        dayLo := math.min(dayLo, low)

    d_range_local := dayHi - dayLo

    var float[] adr_buf = array.new_float()
    var float adr_sum = 0.0
    if new_day and not na(dayHi[1]) and not na(dayLo[1])
        float last_closed_day_range = dayHi[1] - dayLo[1]
        array.push(adr_buf, last_closed_day_range)
        adr_sum += last_closed_day_range
        if array.size(adr_buf) > eff_adr_len
            float popped = array.shift(adr_buf)
            adr_sum -= popped

    adr_local := array.size(adr_buf) > 0 ? adr_sum / array.size(adr_buf) : na
else
    d_range_local := high - low
    adr_local := ta.sma(high - low, eff_adr_len)

// 3. ADR %
if not na(d_range_local) and not na(adr_local) and adr_local > 0
    adr_pct := (d_range_local / adr_local) * 100

// ADR% is displayed through the panel only; no debug plot slot is used.

// ADR Label removed as per design requirements (Panel only)
var label lbl_adr = na
label.delete(lbl_adr)

// Update Panel Rows 9-13 (Range & Volatility Metrics)
if not na(info_panel) and barstate.islast
    string atr_txt = "ATR14 " + str.tostring(atr14_val, "#.#####")
    string atr_pct_txt = "ATR% " + (not na(atr_pct_of_price) ? str.tostring(atr_pct_of_price, "#.##") + "%" : "n/a")
    string adr_txt = "ADR% " + (not na(adr_pct) ? str.tostring(adr_pct, "#.#") + "%" : "n/a")
    string vol_txt = vpct_token != "" ? vpct_token : "Volatility% n/a"
    string vix_txt = "VIX " + (not na(vix_val) ? str.tostring(vix_val, "#.##") : "n/a")
    f_render_range_vol_rows(info_panel, panel_show_range_vol_metrics, atr_txt, atr_pct_txt, adr_txt, vol_txt, vix_txt, panel_col_tf, panel_col_last)


// --- Stage 3: ATR Expansion Logic ---
float calc_atr = ta.atr(eff_atr_len)
float atr_ref  = ta.sma(calc_atr, eff_atr_norm)
float atr_norm = (not na(atr_ref) and atr_ref > 0) ? (calc_atr / atr_ref) : 1.0

bool atr_is_low  = atr_norm < eff_atr_low
bool atr_is_high = atr_norm > eff_atr_high


// --- Stage 4: Keltner Channel & Squeeze Detector ---
// KC Calc
float kc_mid = ta.ema(close, eff_kc_len)
float kc_range = ta.atr(eff_kc_len)
float kc_up = kc_mid + (kc_range * eff_kc_mult)
float kc_dn = kc_mid - (kc_range * eff_kc_mult)

// BB Calc (Specific for Squeeze - Standard 20/2.0 per Regime defaults)
[s_bb_mid, s_bb_up, s_bb_dn] = ta.bb(close, eff_bb_len, eff_bb_mult)

// KC Squeeze: BB is fully INSIDE KC
bool squeeze_kc = (s_bb_up < kc_up) and (s_bb_dn > kc_dn)


// --- Stage 5 (Regime Upgrade): Squeeze Integration ---
// Trend / Range / Squeeze

var string regime_state = "RANGE"
var string regime_candidate = "RANGE"
var int regime_run = 0
var color regime_bg = na

// Calculate Regime regardless of display for history
// Calc BBW (Auto-tuned lookback) - Reusing Stage 4 values
bbw = (s_bb_up - s_bb_dn) / s_bb_mid
avg_bbw = ta.sma(bbw, eff_vol_len)

float trend_enter_th = eff_adx_th * eff_enter_k
float trend_exit_th  = eff_adx_th * eff_exit_k
float squeeze_enter_mult = 0.70 / eff_enter_k
float squeeze_exit_mult  = 0.70 / eff_exit_k

// Calc ADX
[_, _, adx_r] = ta.dmi(eff_adx_len, eff_adx_len)
var bool trend_active = false
var bool squeeze_active = false

[trend_active_runtime, squeeze_active_runtime, regime_candidate_eval] = f_update_regime_runtime(trend_active, squeeze_active, bbw, avg_bbw, squeeze_kc, eff_use_kc_squeeze, squeeze_strict, adx_r, trend_enter_th, trend_exit_th, squeeze_enter_mult, squeeze_exit_mult, barstate.isconfirmed)
trend_active := trend_active_runtime
squeeze_active := squeeze_active_runtime
[regime_state_next, regime_candidate_next, regime_run_next] = f_update_regime_state(regime_state, regime_candidate, regime_run, regime_candidate_eval, eff_persist_bars, barstate.isconfirmed)
regime_state := regime_state_next
regime_candidate := regime_candidate_next
regime_run := regime_run_next

regime_bg := regime_state == "SQUEEZE" ? color.new(color.yellow, 90) : regime_state == "TREND" ? color.new(color.blue, 92) : na

// Update Panel (Moved Up)
var string reg_conf = "RANGE"
var color reg_bg_conf = color.new(color.gray, 100)
var string rvol_conf = ""
var color rvol_bg_conf = color.new(color.gray, 100)
var string z_conf = ""
var color z_bg_conf = color.new(color.gray, 100)
var float reg_dist_z_conf = na
if eff_regime_panel and not na(info_panel) and barstate.islast
    color c_reg_bg_live = regime_state == "SQUEEZE" ? panel_reg_squeeze_color : regime_state == "TREND" ? panel_reg_trend_color : panel_reg_range_color
    bool reg_upd = barstate.isconfirmed or not barstate.isrealtime
    reg_conf := reg_upd ? regime_state : reg_conf
    reg_bg_conf := reg_upd ? c_reg_bg_live : reg_bg_conf
    reg_dist_z_conf := reg_upd ? c_panel_reg_dist_z_live : reg_dist_z_conf

    string reg_disp = panel_show_live ? regime_state : reg_conf
    float reg_dist_z_disp = panel_show_live ? c_panel_reg_dist_z_live : reg_dist_z_conf
    color reg_bg_disp = panel_show_live ? c_reg_bg_live : reg_bg_conf
    reg_bg_disp := reg_disp == "SQUEEZE" ? color.new(reg_bg_disp, 50) : reg_bg_disp
    reg_disp := reg_disp + " " + f_format_z_cell(reg_dist_z_disp)
    table.cell(info_panel, panel_col_tf, f_panel_row(16), "REG", text_size=marker_size_inline, text_color=color.silver, tooltip=f_tt_panel_reg())
    table.merge_cells(info_panel, panel_col_fvg, f_panel_row(16), panel_col_last, f_panel_row(16))
    table.cell(info_panel, panel_col_fvg, f_panel_row(16), reg_disp, text_size=marker_size_inline, text_color=color.silver, bgcolor=reg_bg_disp)

    string m_reg = f_marker(panel_show_live and barstate.isrealtime, barstate.isconfirmed)

    // Row 17: RVOL
    string rv_code = not na(rvol_val) ? (rvol_val < rvol_th_1 ? "L" : rvol_val < rvol_th_2 ? "M" : rvol_val < rvol_th_3 ? "H" : "E") : "-"
    string rvol_txt_live = (eff_rvol_enabled and not na(rvol_val)) ? str.tostring(rvol_val, "#.##") + "x " + rv_code : "OFF"
    color c_rv_p_live = (eff_rvol_enabled and not na(rvol_val)) ? (rvol_state == "3" ? color.new(color.red, 30) : rvol_state == "2" ? color.new(color.orange, 30) : color.new(color.gray, 100)) : color.new(color.gray, 100)

    bool rvol_init = rvol_conf == ""
    rvol_conf := rvol_init ? rvol_txt_live : rvol_conf
    rvol_bg_conf := rvol_init ? c_rv_p_live : rvol_bg_conf
    bool rvol_upd = barstate.isconfirmed or not barstate.isrealtime
    rvol_conf := rvol_upd ? rvol_txt_live : rvol_conf
    rvol_bg_conf := rvol_upd ? c_rv_p_live : rvol_bg_conf

    string rvol_disp = panel_show_live ? rvol_txt_live : rvol_conf
    color rvol_bg_disp = panel_show_live ? c_rv_p_live : rvol_bg_conf
    rvol_disp := f_with_marker(rvol_disp, m_reg)
    table.cell(info_panel, panel_col_tf, f_panel_row(17), "RVOL", text_size=marker_size_inline, text_color=color.silver, tooltip=f_tt_panel_rvol())
    table.merge_cells(info_panel, panel_col_fvg, f_panel_row(17), panel_col_last, f_panel_row(17))
    table.cell(info_panel, panel_col_fvg, f_panel_row(17), rvol_disp, text_size=marker_size_inline, text_color=color.silver, bgcolor=rvol_bg_disp)

    // Row 18: VWAP Z
    float abs_z = math.abs(z_val)
    string z_code = not na(abs_z) ? (abs_z < z_th_entry ? "N" : abs_z < z_th_tp ? "S" : abs_z < z_th_ext ? "T" : "E") : "-"
    bool show_vwp_panel_value = eff_vwap_enabled and eff_vwap_z and not na(z_val)
    string z_txt_live = show_vwp_panel_value ? str.tostring(z_val, "#.1") + "σ " + z_code : "OFF"

    color c_z_p_live = show_vwp_panel_value ? (str.contains(stretch_state, "EXTREME") ? color.new(color.red, 30) : str.contains(stretch_state, "TP") ? color.new(color.orange, 30) : color.new(color.gray, 100)) : color.new(color.gray, 100)

    bool z_init = z_conf == ""
    z_conf := z_init ? z_txt_live : z_conf
    z_bg_conf := z_init ? c_z_p_live : z_bg_conf
    bool z_upd = barstate.isconfirmed or not barstate.isrealtime
    z_conf := z_upd ? z_txt_live : z_conf
    z_bg_conf := z_upd ? c_z_p_live : z_bg_conf

    string z_disp = panel_show_live ? z_txt_live : z_conf
    color z_bg_disp = panel_show_live ? c_z_p_live : z_bg_conf
    z_disp := f_with_marker(z_disp, m_reg)
    table.cell(info_panel, panel_col_tf, f_panel_row(18), "VWP", text_size=marker_size_inline, text_color=color.silver, tooltip=f_tt_panel_vwp())
    table.merge_cells(info_panel, panel_col_fvg, f_panel_row(18), panel_col_last, f_panel_row(18))
    table.cell(info_panel, panel_col_fvg, f_panel_row(18), z_disp, text_size=marker_size_inline, text_color=color.silver, bgcolor=z_bg_disp)


//------------------------------------------------------- Squeeze Box Module -------------------------------------------------------
// Stage 6: Squeeze Box logic

var SqState sqs = SqState.new(na, na, false, false, na)

// Condition
bool in_sq_condition = (regime_state == "SQUEEZE")

bool sq_start = in_sq_condition and not in_sq_condition[1]
bool sq_end = not in_sq_condition and in_sq_condition[1]

// Events
bool sq_break_up = false
bool sq_break_dn = false

if eff_sq_box_enabled
    if sq_start
        sqs.hi := high
        sqs.lo := low
        sqs.active := true
        sqs.locked := false

        // Init/Reset (Single Object Recycle)
        if na(sqs.id_box)
            sqs.id_box := box.new(bar_index, high, bar_index, low, border_color=color.new(color.yellow, 30), bgcolor=color.new(color.yellow, 99))
        else
            box.set_left(sqs.id_box, bar_index)
            box.set_right(sqs.id_box, bar_index)
            box.set_top(sqs.id_box, high)
            box.set_bottom(sqs.id_box, low)
            box.set_border_style(sqs.id_box, line.style_solid)

    else if sqs.active
        // Update H/L
        sqs.hi := math.max(sqs.hi, high)
        sqs.lo := math.min(sqs.lo, low)

        box.set_top(sqs.id_box, sqs.hi)
        box.set_bottom(sqs.id_box, sqs.lo)
        box.set_right(sqs.id_box, bar_index + 1)

        if sq_end
            sqs.active := false
            if sq_lock
                sqs.locked := true
                box.set_right(sqs.id_box, bar_index + 5)
                box.set_border_style(sqs.id_box, line.style_dashed)

    else if sqs.locked
        if barstate.islast
            box.set_right(sqs.id_box, bar_index + 5)

        // Break Events
        if close > sqs.hi and close[1] <= sqs.hi
            sq_break_up := true
        if close < sqs.lo and close[1] >= sqs.lo
            sq_break_dn := true


//--------------------------------------------------------- CONF VWAP (Lightweight) ---------------------------------------------------------
float conf_vwap_val = na
float conf_z_val = na

bool use_sess = (conf_vwap_mode == "Session VWAP") or (conf_vwap_mode == "Auto" and tf_sec <= 3600)

if conf_use_vwap_quality
    // Session VWAP
    var float vs_c_cumVol = 0.0
    var float vs_c_cumPV  = 0.0
    var float vwap_c_sess = na
    bool c_new_day = timeframe.change("D")

    if use_sess
        if c_new_day
            vs_c_cumVol := 0.0
            vs_c_cumPV  := 0.0

        vs_c_cumVol += volume
        vs_c_cumPV  += volume * hlc3

        if vs_c_cumVol > 0
            vwap_c_sess := vs_c_cumPV / vs_c_cumVol
            conf_vwap_val := vwap_c_sess

    // Weekly VWAP
    var float vw_c_cumVol = 0.0
    var float vw_c_cumPV  = 0.0
    var float vwap_c_week = na
    bool c_new_week = timeframe.change("W")

    if not use_sess
        if c_new_week
            vw_c_cumVol := 0.0
            vw_c_cumPV  := 0.0

        vw_c_cumVol += volume
        vw_c_cumPV  += volume * hlc3

        if vw_c_cumVol > 0
            vwap_c_week := vw_c_cumPV / vw_c_cumVol
            conf_vwap_val := vwap_c_week

// Z-Score Calculation
bool reuse_z = false
if eff_vwap_enabled and eff_vwap_z and not na(z_val)
    if (use_sess and eff_vwap_anchor == "Session (Daily Reset)") or (not use_sess and eff_vwap_anchor == "Weekly")
        reuse_z := true

// Independent Calculation series are evaluated every bar to avoid Pine consistency warnings.
float dev_c = not na(conf_vwap_val) ? close - conf_vwap_val : na
float sigma_c = ta.stdev(dev_c, vwap_stdev_len)
if reuse_z
    conf_z_val := z_val
else if not na(conf_vwap_val)
    // Reuse vwap_stdev_len (Default 100)
    if sigma_c > 0
        conf_z_val := dev_c / sigma_c


//--------------------------------------------------------- CONF Engine v2: Core + Confirm + Regime Gate ---------------------------------------------------------

float conf_score = 50.0
string conf_bias = "Neutral"
string conf_quality = "L"
string conf_align_state = ""
float final_raw = 0.0 // Exposed for Alerts

bool eff_calc_conf = eff_show_conf_meter or conf_bg_conf_family or panel_show_htf_bias or panel_show_htf_reg

// Core Weights
float W_FR_CORE = 4.0
float W_FVG_CORE = 4.0
float W_KAMA_CORE = 2.0

// Variables for Smoothing & State
var int conf_state_engine = 0 // 0=Neut, 1=Bull, -1=Bear
var int conf_align_candidate = 0
var int conf_align_run = 0
var int conf_align_confirmed = 0

if eff_calc_conf
    // --- 1. Core Score Calculation ---
    float core_w_sum = 0.0
    float core_raw_sum = 0.0

    // Fractals (Core)
    if eff_fractals_plot
        core_w_sum += W_FR_CORE
        core_raw_sum += (fr_state_inf * W_FR_CORE)

    // FVG (Core + Regime Gate)
    // Gate: Dampen FVG in SQUEEZE
    float w_fvg_effective = W_FVG_CORE
    if regime_state == "SQUEEZE"
        w_fvg_effective := W_FVG_CORE * 0.35

    // Always available (Core). FVG State is calculated globally on Current TF.
    core_w_sum += w_fvg_effective
    core_raw_sum += (fvg_state_inf * w_fvg_effective)

    // KAMA (Core)
    float kama_val_score = 0.0
    if sig.kama_bull
        kama_val_score := 1.0
    else if sig.kama_bear
        kama_val_score := -1.0

    core_w_sum += W_KAMA_CORE
    core_raw_sum += (kama_val_score * W_KAMA_CORE)

    // Calculate Core Raw (-1.0 to 1.0)
    float core_raw = (core_w_sum > 0) ? (core_raw_sum / core_w_sum) : 0.0

    // --- 2. Smoothing (AUTO SCALED) ---
    float core_smooth = ta.ema(core_raw, eff_core_ema_len)

    // --- 3. Confirm-Events (Overlay) ---
    // Trendlines & Segments with Decay
    var float ov_tl = 0.0
    var float ov_seg = 0.0

    // Update Overlay States
    if sig.tl_bull
        ov_tl := 1.0
    else if sig.tl_bear
        ov_tl := -1.0
    else
        ov_tl := ov_tl * eff_ov_decay

    if sig.seg_bull
        ov_seg := 1.0
    else if sig.seg_bear
        ov_seg := -1.0
    else
        ov_seg := ov_seg * eff_ov_decay

    // Calculate Overlay Contribution
    // Weighted Average of active overlays
    float ov_w_sum = 0.0
    float ov_raw_sum = 0.0

    if eff_plot_trendline
        ov_w_sum += 1.0
        ov_raw_sum += ov_tl

    if eff_plot_segments
        ov_w_sum += 1.0
        ov_raw_sum += ov_seg

    float overlay_raw = (ov_w_sum > 0) ? (ov_raw_sum / ov_w_sum) : 0.0

    // --- Stage 8: Confirm-Events Upgrade (ATR Filter) ---
    float ov_scale = 1.0
    if atr_is_low
        ov_scale := 0.60
    else if atr_is_high
        ov_scale := 1.00

    // Clamp Overlay (Anti-Flip)
    float overlay_clamped = math.max(-eff_ov_clamp, math.min(eff_ov_clamp, overlay_raw)) * ov_scale

    // --- 6.1 ADR Exhaustion Flags (Stage 6) ---
    bool adr_warn = eff_use_adr_gate and not na(adr_pct) and adr_pct >= eff_adr_warn
    bool adr_hard = eff_use_adr_gate and not na(adr_pct) and adr_pct >= eff_adr_hard

    // --- 4. Final Calculation & Confidence Gate ---
    final_raw := core_smooth + overlay_clamped
    // Clamp Final
    final_raw := math.max(-1.0, math.min(1.0, final_raw))

    // Regime Confidence Gate (Dampen the Score magnitude, but preserve direction/state)
    float conf_gate = 1.0
    if regime_state == "SQUEEZE"
        conf_gate := 0.40
    else if regime_state == "RANGE"
        conf_gate := 0.70

    // ADR Gate Add-on (Confidence Dampening)
    if adr_warn
        conf_gate := conf_gate * 0.85
    if adr_hard
        conf_gate := conf_gate * 0.70

    // Apply Gate to Magnitude relative to 50
    // Score 0-100. Center 50.
    // 50 + (50 * final_raw * gate)
    conf_score := 50 + (50 * final_raw * conf_gate)

    // --- 4.5 Confirmed Bias (Profile + Persistence) ---
    // Panel background is score-based; panel label is Confirmed Bias.

    float _cb_enter_bull = math.max(eff_cb_enter_bull, eff_cb_exit_bull + 0.1)
    float _cb_exit_bull  = math.min(eff_cb_exit_bull, _cb_enter_bull - 0.1)
    float _cb_enter_bear = math.min(eff_cb_enter_bear, eff_cb_exit_bear - 0.1)
    float _cb_exit_bear  = math.max(eff_cb_exit_bear, _cb_enter_bear + 0.1)

    int _cb_enter_bars = math.max(1, eff_cb_enter_bars)
    int _cb_exit_bars  = math.max(1, eff_cb_exit_bars)

    // Confirmed-only (fixed)
    bool _cb_update = barstate.isconfirmed

    // Score-color thresholds derived from Confirmed Bias neutral-zone (exit thresholds).
    float _conf_color_hi = math.max(_cb_exit_bull, _cb_exit_bear + 0.1)
    float _conf_color_lo = math.min(_cb_exit_bear, _conf_color_hi - 0.1)

    bool _enter_bull = conf_score >= _cb_enter_bull
    bool _enter_bear = conf_score <= _cb_enter_bear
    bool _exit_bull  = conf_score <= _cb_exit_bull
    bool _exit_bear  = conf_score >= _cb_exit_bear

    int _run_enter_bull = nz(ta.barssince(not _enter_bull), 0)
    int _run_enter_bear = nz(ta.barssince(not _enter_bear), 0)
    int _run_exit_bull  = nz(ta.barssince(not _exit_bull), 0)
    int _run_exit_bear  = nz(ta.barssince(not _exit_bear), 0)

    bool _enter_bull_ok = _enter_bull and _run_enter_bull >= _cb_enter_bars
    bool _enter_bear_ok = _enter_bear and _run_enter_bear >= _cb_enter_bars
    bool _exit_bull_ok  = _exit_bull  and _run_exit_bull  >= _cb_exit_bars
    bool _exit_bear_ok  = _exit_bear  and _run_exit_bear  >= _cb_exit_bars

    if _cb_update
        if conf_state_engine == 0
            if _enter_bull_ok
                conf_state_engine := 1
            else if _enter_bear_ok
                conf_state_engine := -1
        else if conf_state_engine == 1
            if _exit_bull_ok
                conf_state_engine := 0
        else if conf_state_engine == -1
            if _exit_bear_ok
                conf_state_engine := 0

    // Confirmed Bias string used in panel text.
    conf_bias := conf_state_engine == 1 ? "BULL" : conf_state_engine == -1 ? "BEAR" : "NEUT"

    // Keep Current-TF panel BIAS/REG sourced from main engines (not FVG/FR proxy).
    int bias_state_c_engine = conf_state_engine
    int reg_state_c_engine = regime_state == "TREND" ? 1 : regime_state == "SQUEEZE" ? -1 : 0
    bool c_engine_upd = barstate.isconfirmed or not barstate.isrealtime
    bias_c_engine_conf := c_engine_upd ? bias_state_c_engine : bias_c_engine_conf
    reg_c_engine_conf := c_engine_upd ? reg_state_c_engine : reg_c_engine_conf

    float bias_c_reset_ma = f_bias_reset_mean()
    [reset_arm_c, reset_confirm_c] = f_bias_structure_reset_signals(bias_state_c_engine, c_panel_vwap_z_live, bias_c_reset_ma)
    bool bias_c_stretched = f_bias_is_stretched(c_panel_vwap_z_live)

    if c_engine_upd
        if bias_state_c_engine == 0
            bias_c_age_conf := 0
            bias_c_reset_age_conf := 0
            bias_c_reset_armed_conf := false
        else if bias_state_c_engine != bias_c_prev_conf
            bias_c_age_conf := 1
            bias_c_reset_age_conf := 1
            bias_c_reset_armed_conf := false
        else
            bias_c_age_conf += 1
            bias_c_reset_age_conf += 1

            bool can_structure_reset_c = bias_c_age_conf > f_bias_fresh_limit()
            if can_structure_reset_c and reset_arm_c and not bias_c_stretched
                bias_c_reset_armed_conf := true

            if can_structure_reset_c and bias_c_reset_armed_conf and reset_confirm_c and not bias_c_stretched
                bias_c_reset_age_conf := 1
                bias_c_reset_armed_conf := false

        bias_c_prev_conf := bias_state_c_engine

    int bias_c_age_live = not c_engine_upd and bias_state_c_engine != 0 and bias_state_c_engine != bias_c_prev_conf ? 1 : bias_c_age_conf
    int bias_c_reset_age_live = bias_c_reset_age_conf
    int bias_c_maturity_live = f_bias_maturity(bias_state_c_engine, bias_c_age_live, bias_c_reset_age_live, c_panel_vwap_z_live)
    bias_c_maturity_conf := c_engine_upd ? bias_c_maturity_live : bias_c_maturity_conf
    int bias_c_maturity_disp = panel_show_live ? bias_c_maturity_live : bias_c_maturity_conf

    if panel_pos != "None" and barstate.islast and not na(info_panel)
        int bias_c_disp_engine = panel_show_live ? bias_state_c_engine : bias_c_engine_conf
        int reg_c_disp_engine = panel_show_live ? reg_state_c_engine : reg_c_engine_conf
        color bias_c_bg_engine = bias_c_disp_engine == 1 ? panel_long_color : bias_c_disp_engine == -1 ? panel_short_color : panel_neutral_color
        color reg_c_bg_engine = reg_c_disp_engine == 1 ? panel_reg_trend_color : reg_c_disp_engine == -1 ? panel_reg_squeeze_color : panel_reg_range_color

        string bias_c_value_text = f_format_bias_maturity(bias_c_maturity_disp)
        string reg_c_value_text = f_format_z_cell(c_panel_reg_dist_z_disp)
        if panel_show_htf_bias and not na(panel_col_bias)
            table.cell(table_id=info_panel, column=panel_col_bias, row=f_panel_row(14), text=bias_c_value_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=bias_c_bg_engine, width=PANEL_TOP_COL_W)
        if panel_show_htf_reg and not na(panel_col_reg)
            table.cell(table_id=info_panel, column=panel_col_reg, row=f_panel_row(14), text=reg_c_value_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=reg_c_bg_engine, width=PANEL_TOP_COL_W)
        if not na(panel_current_tf_row)
            if panel_show_htf_bias and not na(panel_col_bias)
                table.cell(table_id=info_panel, column=panel_col_bias, row=f_panel_row(panel_current_tf_row), text=bias_c_value_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=bias_c_bg_engine, width=panel_runtime_col_width)
            if panel_show_htf_reg and not na(panel_col_reg)
                table.cell(table_id=info_panel, column=panel_col_reg, row=f_panel_row(panel_current_tf_row), text=reg_c_value_text, text_size=panel_value_size_grid, text_color=MARKER_COLOR, text_halign=panel_marker_halign, text_valign=panel_marker_valign, bgcolor=reg_c_bg_engine, width=panel_runtime_col_width)

    // --- 5. Quality Tag (H/M/L) ---
    // Agreement: How many cores match the state?
    // Cores: FR, FVG, KAMA
    float aligned_core = 0.0
    float active_core = 0.0
    int state_sign = conf_state_engine // 1, -1, 0

    // Helper for sign match (0 matches nothing)
    // FR
    if eff_fractals_plot
        active_core += 1.0
        if state_sign != 0 and math.sign(fr_state_inf) == state_sign
            aligned_core += 1.0

    // FVG (Use effective weight presence)
    if eff_plot_fvg1 or eff_plot_fvg2
        active_core += 1.0
        if state_sign != 0 and math.sign(fvg_state_inf) == state_sign
            aligned_core += 1.0

    // KAMA
    active_core += 1.0
    float kama_sign = sig.kama_bull ? 1.0 : sig.kama_bear ? -1.0 : 0.0
    if state_sign != 0 and kama_sign == state_sign
        aligned_core += 1.0

    float agreement = (active_core > 0) ? (aligned_core / active_core) : 0.0
    float magnitude = math.abs(final_raw)

    string quality = "L"
    if magnitude >= 0.35 and agreement >= 0.66 and regime_state != "SQUEEZE"
        quality := "H"
    else if magnitude >= 0.20 and agreement >= 0.50
        quality := "M"
    else
        quality := "L"

    // --- Stage 9: Quality Degrade (ADR/ATR) ---
    if adr_warn
        if quality == "H"
            quality := "M"
        else if quality == "M"
            quality := "L"

    if adr_hard
        quality := "L"

    // Optional: Low ATR in Non-Trend degrade
    if atr_is_low and regime_state != "TREND" and quality == "H"
        quality := "M"

    // --- Stage 10: VWAP Quality Gate (robust A/X + persistence) ---
    [quality_next, conf_align_state_new, conf_align_candidate_new, conf_align_run_new, conf_align_confirmed_new] = f_apply_vwap_quality_gate(quality, conf_use_vwap_quality, conf_vwap_val, conf_vwap_slope_len, state_sign, conf_z_val, conf_deadband_z, conf_align_min_z, conf_misalign_min_z, conf_use_slope_filter_for_bonus, conf_strong_align_z, conf_align_candidate, conf_align_run, conf_align_confirmed, conf_align_persist_bars, barstate.isconfirmed, conf_z_penalty_mode, z_th_entry, z_th_tp, z_th_ext)
    conf_align_state := conf_align_state_new
    conf_align_candidate := conf_align_candidate_new
    conf_align_run := conf_align_run_new
    conf_align_confirmed := conf_align_confirmed_new
    quality := quality_next
    conf_quality := quality

    // --- 6. Visualization (Panel) ---
    // BULL 72 H / NEUT 50 L
    if barstate.islast and eff_show_conf_meter and not na(info_panel)
        string conf_bias_panel = conf_bias
        string panel_txt_live = conf_bias_panel + " " + str.tostring(math.round(conf_score)) + " " + quality
        if conf_align_state != ""
            panel_txt_live := panel_txt_live + " " + conf_align_state
        panel_txt_live := panel_txt_live + " " + f_format_bias_maturity(bias_c_maturity_live)

        color c_conf_live = conf_score > _conf_color_hi ? color.new(color.green, 30) : conf_score < _conf_color_lo ? color.new(color.red, 30) : color.new(color.gray, 100)

        // Neutral remains transparent
        var string conf_txt_conf = ""
        var color conf_bg_conf = color.new(color.gray, 100)
        bool conf_init = conf_txt_conf == ""
        conf_txt_conf := conf_init ? panel_txt_live : conf_txt_conf
        conf_bg_conf := conf_init ? c_conf_live : conf_bg_conf
        bool conf_upd = barstate.isconfirmed or not barstate.isrealtime
        conf_txt_conf := conf_upd ? panel_txt_live : conf_txt_conf
        conf_bg_conf := conf_upd ? c_conf_live : conf_bg_conf

        string conf_txt_disp = panel_show_live ? panel_txt_live : conf_txt_conf
        color conf_bg_disp = panel_show_live ? c_conf_live : conf_bg_conf

        table.merge_cells(info_panel, panel_col_fvg, f_panel_row(15), panel_col_last, f_panel_row(15))
        table.cell(info_panel, panel_col_tf, f_panel_row(15), "BIAS", text_size=marker_size_inline, text_color=color.silver, tooltip=f_tt_panel_bias())
        table.cell(info_panel, panel_col_fvg, f_panel_row(15), conf_txt_disp, text_size=marker_size_inline, text_color=color.silver, bgcolor=conf_bg_disp)

float conf_score_clamped = math.max(0.0, math.min(100.0, conf_score))

// --- CENTRALIZED BACKGROUND ROUTING (Fix Bug #2) ---
color bg_final = na

// Logic to filter regime_bg (Squeeze/Trend only)
color regime_bg_filtered = na
if eff_regime_bg_enabled and (regime_state == "SQUEEZE" or regime_state == "TREND")
    regime_bg_filtered := regime_bg

// Logic for Confluence BG (Score vs Confirmed Bias)
color conf_bg_color = na

// Sharp Neutral boundary, very fast transitions within green/red zones.
float bull_raw = math.max(0.0, math.min(1.0, (conf_score_clamped - 55.0) / 45.0))
float bear_raw = math.max(0.0, math.min(1.0, (45.0 - conf_score_clamped) / 45.0))

// Fast in-zone ramp: intensity rises quickly right after entering a color zone.
float fast_curve_exp = 0.35
float bull_strength = math.pow(bull_raw, fast_curve_exp)
float bear_strength = math.pow(bear_raw, fast_curve_exp)

// Keep the +10 transparency uplift (less dominant overall):
// Zone edge -> 90% transp, extreme -> 10% transp
int bull_transp = int(math.round(90.0 - (bull_strength * 60.0)))
int bear_transp = int(math.round(90.0 - (bear_strength * 60.0)))
if conf_bg_meter_heat
    // Score-driven background with hard neutral cutoff and fast in-color heat gradient.
    if conf_score_clamped > 55
        conf_bg_color := color.new(color.green, bull_transp)
    else if conf_score_clamped < 45
        conf_bg_color := color.new(color.red, bear_transp)
    else
        conf_bg_color := color.new(color.gray, 100)
else if conf_bg_bias_plain
    // Confirmed Bias-driven hue with fixed transparency (no gradient).
    conf_bg_color := conf_state_engine == 1 ? color.new(color.green, transp_bg) : conf_state_engine == -1 ? color.new(color.red, transp_bg) : color.new(color.gray, 100)
else if conf_bg_meter_plain
    // Score-driven hue with fixed transparency (no gradient).
    if conf_score_clamped > 55
        conf_bg_color := color.new(color.green, transp_bg)
    else if conf_score_clamped < 45
        conf_bg_color := color.new(color.red, transp_bg)
    else
        conf_bg_color := color.new(color.gray, 100)
else if conf_bg_rvol_state
    // RVOL activity-only backdrop (non-directional intensity).
    conf_bg_color := not eff_rvol_enabled or na(rvol_val) ? color.new(color.gray, 100) : rvol_state == "3" ? color.new(color.red, transp_bg) : rvol_state == "2" ? color.new(color.orange, transp_bg) : color.new(color.gray, 100)
else if conf_bg_vwp_stretch
    // VWAP stretch backdrop using panel stretch states.
    bool vwp_active = eff_vwap_enabled and eff_vwap_z and not na(z_val)
    conf_bg_color := not vwp_active ? color.new(color.gray, 100) : str.contains(stretch_state, "EXTREME") ? color.new(color.red, transp_bg) : str.contains(stretch_state, "TP") ? color.new(color.orange, transp_bg) : color.new(color.gray, 100)
else if conf_bg_adr_heat
    // ADR%-driven heat: one hue (orange), intensity only via transparency.
    float adr_heat_score = na(adr_pct) ? 0.0 : math.max(0.0, math.min(100.0, adr_pct))
    int adr_heat_transp = int(math.round(90.0 - (adr_heat_score * 0.50)))
    conf_bg_color := color.new(color.orange, adr_heat_transp)
else if conf_bg_volatility_heat
    // Volatility%-driven heat: one hue (orange), intensity only via transparency.
    float volatility_heat_score = na(vpct_val) ? 0.0 : math.max(0.0, math.min(100.0, vpct_val))
    int volatility_heat_transp = int(math.round(90.0 - (volatility_heat_score * 0.70)))
    conf_bg_color := color.new(color.orange, volatility_heat_transp)

// Optional chart-top character overlays for Confluence Meter modes
float char_hi = ta.highest(high, 200)
float char_lo = ta.lowest(low, 200)
float char_rng = math.max(char_hi - char_lo, syminfo.mintick * 100)
float char_y = char_lo + (char_rng * 0.78)
float char_line_y1 = char_lo + (char_rng * 0.68)
float char_line_y2 = char_lo + (char_rng * 0.88)

bool show_conf_quality_char = conf_bg_meter_char and (conf_score_clamped > 55 or conf_score_clamped < 45)
bool show_conf_align_char = conf_bg_meter_aligned and (conf_score_clamped > 55 or conf_score_clamped < 45)

string char_curr = show_conf_quality_char ? conf_quality : show_conf_align_char ? conf_align_state : ""
string char_prev = show_conf_quality_char ? conf_quality[1] : show_conf_align_char ? conf_align_state[1] : ""
bool char_series_active = (show_conf_quality_char or show_conf_align_char) and char_curr != ""
bool char_prev_active = bar_index > 0 and char_prev != ""
bool char_changed = char_series_active and char_prev_active and char_curr != char_prev
bool char_segment_start = char_series_active and (not char_prev_active or char_changed)

if char_segment_start
    // Draw the boundary line that defines the start of this segment.
    line char_sep = line.new(bar_index, char_line_y1, bar_index, char_line_y2, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.gray, 20), width=1)
    array.push(conf_char_lines, char_sep)
    if array.size(conf_char_lines) > conf_char_obj_limit
        line.delete(array.shift(conf_char_lines))

    // Place the segment character exactly on its defining start line.
    int char_x = bar_index
    color char_txt_col = conf_score_clamped > 55 ? color.new(color.green, 0) : conf_score_clamped < 45 ? color.new(color.red, 0) : color.new(color.gray, 100)
    label char_lbl = label.new(char_x, char_y, char_curr, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=char_txt_col, size=size.small)
    array.push(conf_char_labels, char_lbl)
    if array.size(conf_char_labels) > conf_char_obj_limit
        label.delete(array.shift(conf_char_labels))

// Priority 1: Confluence BG (CONF)
if conf_bg_enabled and not conf_bg_regime
    bg_final := conf_bg_color
// Priority 2: Regime
else if not na(regime_bg_filtered)
    bg_final := regime_bg_filtered

// Single Output
bgcolor(bg_final, title="MCCS Master Background")

// --- Stage 5: Alerts (Centralized) ---
// Events based on registry

bool vwp_b1_touch = eff_vwap_enabled and not na(vwap_val) and not na(sigma_val) and (high >= (vwap_val + band_k1 * sigma_val) or low <= (vwap_val - band_k1 * sigma_val))
bool vwp_b2_touch = eff_vwap_enabled and not na(vwap_val) and not na(sigma_val) and (high >= (vwap_val + band_k2 * sigma_val) or low <= (vwap_val - band_k2 * sigma_val))
bool vwp_b3_touch = eff_vwap_enabled and not na(vwap_val) and not na(sigma_val) and (high >= (vwap_val + band_k3 * sigma_val) or low <= (vwap_val - band_k3 * sigma_val))
bool fractal_confirmed = eff_fractals_plot and (not na(up_fr) or not na(dn_fr))
bool trend_start = regime_state == "TREND" and (regime_state[1] == "SQUEEZE" or regime_state[1] == "RANGE")
bool range_start = regime_state == "RANGE" and (regime_state[1] == "SQUEEZE" or regime_state[1] == "TREND")
bool bull_start = conf_bias == "BULL" and (conf_bias[1] == "NEUT" or conf_bias[1] == "Neutral")
bool bear_start = conf_bias == "BEAR" and (conf_bias[1] == "NEUT" or conf_bias[1] == "Neutral")
bool neutral_start = (conf_bias == "NEUT" or conf_bias == "Neutral") and (conf_bias[1] == "BULL" or conf_bias[1] == "BEAR")
bool sweep_start = plot_sw_bar and is_confirmed_bar and (sweep_bear_curr or sweep_bull_curr)
bool squeezeWatchStart = is_confirmed_bar and regime_state == "SQUEEZE" and regime_state[1] != "SQUEEZE"

// Additional alerts via alert() (do not add alertcondition plot slots)
f_emit_additional_alert_events(alerts_enabled, any_alert_filter, fractal_confirmed, range_start, neutral_start)

// Alert Conditions (For TradingView Setup)
alertcondition(alerts_enabled and vwp_b1_touch, "VWP B1", "VWP B1 touched")
alertcondition(alerts_enabled and vwp_b2_touch, "VWP B2", "VWP B2 touched")
alertcondition(alerts_enabled and vwp_b3_touch, "VWP B3", "VWP B3 touched")
alertcondition(alerts_enabled and trend_start, "Trend", "Regime switched to Trend")
alertcondition(alerts_enabled and sq_start, "Squeeze", "New squeeze started")
alertcondition(alerts_enabled and bull_start, "Bull", "Bias switched from Neutral to Bull")
alertcondition(alerts_enabled and bear_start, "Bear", "Bias switched from Neutral to Bear")
alertcondition(alerts_enabled and sweep_start, "Sweep", "Sweep bar (S) detected")
alertcondition(alerts_enabled and squeezeWatchStart, "Squeeze Watch Start", "Squeeze watch started (preparation context, not direction signal)")
