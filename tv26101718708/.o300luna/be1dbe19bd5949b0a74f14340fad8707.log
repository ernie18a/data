    bool eff_plot_f_bar = plot_f_bar
    bool eff_plot_segments = plot_segments
    bool eff_plot_pivots_h1 = plot_pivots_all and plot_pivots_h1
    bool eff_plot_pivots_h4 = plot_pivots_all and plot_pivots_h4
    bool eff_plot_pivots_d = plot_pivots_all and plot_pivots_d
    bool eff_plot_pivots_w = plot_pivots_all and plot_pivots_w
    bool eff_plot_pivots_m = plot_pivots_all and plot_pivots_m
    bool eff_plot_pivots_3m = plot_pivots_all and plot_pivots_3m
    bool eff_plot_pivots_12m = plot_pivots_all and plot_pivots_12m
    bool eff_key_levels_enabled = key_levels_enabled
    bool eff_show_pdh = show_pdh
    bool eff_show_pdl = show_pdl
    bool eff_show_pdc = show_pdc
    bool eff_show_wopen = show_wopen
    bool eff_show_mopen = show_mopen
    bool eff_rvol_enabled = rvol_enabled
    bool eff_rvol_points_enabled = rvol_points_enabled
    bool eff_vwap_enabled = vwap_enabled
    string eff_vwap_anchor = vwap_anchor
    string eff_vwap_display_raw = vwap_display_mode
    string eff_vwap_display_mode = eff_vwap_display_raw == "Line only" ? "None" : eff_vwap_display_raw
