// MidTerm: 34999,43749,52499,61249,69998,78748,87498,96248,104998,113747,122497,131247,139997

//@version=6
indicator('CQ_(0)_[PRICE ACTION / CALCULATED LEVELS] V4', overlay = true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, explicit_plot_zorder = true, max_bars_back = 5000)

// ═══════════════════════════════════════════════════════════════════════
// SCRIPT OVERVIEW
// ═══════════════════════════════════════════════════════════════════════
// Three independent price-level subsystems:
//   1. MID/LONG-TERM TARGETS — Mid-Term is now an auto-generated
//      anchor×multiplier ladder (same engine as
//      CQ_(M)_[MID-TERM OBJECTIVE LADDER]); Long-Term is now auto-generated
//      from macro Low→High ranges (same engine as
//      CQ_(MR)_[MACRO RANGE LADDER]). Both (+ current-year and
//      previous-year open axis lines, each independently toggled/colored)
//      extend left from the current bar. The summary table folds all
//      four sources into one ladder, suffixed M/L/Y/PY respectively.
//   2. ENTRY/TARGET EVENTS — one "grade" set (Set 1), pairing entry
//      prices with target prices, filled automatically from the zigzag's
//      last CONFIRMED leg (Entry = 40/50/60/100%, Target = 125/160/200%)
//      — zigzag engine from CQ_(U)_Unconfirmed Leg Levels.
//      Lines, box captions and zone shading start at the current candle.
//      Label BACKGROUNDS follow the "Label Palette" input (Entry = palette
//      red tone, Target = palette green tone); LINES keep the set's own
//      Line Color inputs. The gaps Early 1 ↔ Early 2, Early 2 ↔ Event 1
//      and Event 1 ↔ Event 2 can each be shaded (gradient or solid, own
//      colors) — see the 🪙 E N T R Y - Z O N E - S H A D I N G group.
//      With "Shade Only Reached Zones" ON (default), a zone is shaded only
//      once price has reached it after the confirmed leg's end.
//      BUY/SELL SIGNALS follow these levels on the chart: BUY at the
//      40% / 50% early entries (risky) and the 60% / 100% entry events
//      (safer), SELL at the 125 / 160 / 200% targets, each label placed
//      just LEFT of the candle that reached its level (pointer on the
//      level), so it never covers the candles that follow, with
//      Entry/SL/TP/R:R/Signal Strength in its tooltip — see the
//      B U Y / S E L L   S I G N A L S block right after the Entry/Target
//      Events section. Unlike the level drawings, signals are evaluated
//      on every bar (history included).
//   3. REFERENCE LEVELS — up to 2 fully independent manual price levels,
//      each with its own style, start mode, and proximity alert.
//      Optionally, the gap between them (1↔2) can be shaded with a color
//      gradient built from the two levels' own colors.
//
// CAPTION MODE (🪙 C A P T I O N - M O D E group): a global switch for
// how every level's price caption is drawn — Mid/Long-Term, Current/
// Previous-Year Open, Set 1 Entry/Target and Reference Levels alike.
//   Labels: the classic pointer labels to the right of each line's end.
//   Boxes:  each caption is a thin box spanning its level's line, from the
//           line's start bar to its label offset. Text is aligned inside
//           it (Right by default, so it ends flush with the line tip) and
//           reads above or below the line per the Side input ("Away From
//           Price" = above for levels at/above close, below for levels
//           under it). Box height scales with price (≈0.001% of the level,
//           at least one tick), so it works on any symbol. Caption text
//           uses each level's own color instead of the black/white
//           contrast color (there's no solid label behind it anymore),
//           unless the global Label Text Color override is on. Boxes get
//           the same dynamic near/mid/far opacity as labels. Reference
//           Level description labels stay as labels in both modes.
//
// TABLE LAYOUT (🪙 T A B L E - L A Y O U T group): both summary tables
// can swap their NOW and ✓ columns (TARGET always stays in the center),
// or be merged into ONE table with a single NOW column (left/right, or
// top/bottom when horizontal), both TARGET columns side by side, and
// the two ladders vertically offset so both NOW values sit on one row.
//
// PIXEL DIALS (🪙 P I X E L - D I A L S group): optional — replaces both
// summary tables with round pixel dials in the Tachimeter style. The level
// closest to the current price sits at 12:00; the nearest levels below / above
// it (1–8 per side, default 3) fill the left / right side of the scale; the needle shows the current
// price within it. Each dial has its own Scale Refresh: the SHORT-TERM
// dial re-centers once per 1D candle by default (or live), the MID/LONG
// dial once per 1W candle by default (or live). Dial colors follow the Dial Color
// Theme (same palettes as CQ_(7)_[TACHIMETER]: Beige VU Meter, Aircraft
// Instrument, Volkswagen Tacho …), and the face can fade toward the bottom
// (Dial Face Gradient). Each dial's title row can follow its needle's
// direction (Up color right of 12:00, Down color left of it). Auto Dim
// cuts the dials' opacity by a set % during a daily time window (default
// 30% from 7 PM to 7 AM).
// See LEVEL PIXEL DIALS at the end of the script.
//
// REDRAW MODEL: every subsystem above is gated by
// `not barstate.isconfirmed and barstate.isrealtime` — i.e. it only
// (re)draws on the live, unclosed bar. Each subsystem keeps a var line[]/
// label[] pair tracking exactly what it drew last tick; f_clearLines/
// f_clearLabels wipe those before every redraw so objects don't pile up
// against the indicator's 500-line/500-label cap. The gradient shading
// additionally tracks var linefill[] state, cleared via f_clearLinefills.
// Box captions (Boxes caption mode) share one var box[] (capBoxes),
// cleared once at the start of every realtime tick via f_clearBoxes —
// every subsystem redraws on every tick, so one shared tracker suffices.
//
// SHARED DRAWING: all three subsystems draw the same visual trio (main
// line + start/dot marker pair + price label), so that trio is built once
// in f_drawStartMarker and wrapped per-subsystem by
// f_drawTermLevel / f_drawEventLevel / f_drawRefLevel below — see the
// SHARED HELPER FUNCTIONS block for details on each.
//
// PERFORMANCE NOTES (v3.1 optimization pass):
//   - yearly_open and prevYearly_open (both '12M' timeframe) are now
//     fetched via ONE request.security tuple call instead of two.
//   - fourHOpenPrice ('240' timeframe) is now only requested when
//     show4HOpen is actually enabled, instead of unconditionally every bar.
//     dailyOpenPrice ('D' timeframe) follows the same rule via show1DOpen.
//   - Both summary tables (Mid/Long-Term and SHORT-TERM) had a redundant
//     "default far-opacity" initialization loop that colored every row,
//     immediately followed by two more loops (idxAbove/idxBelow) that
//     between them ALWAYS re-color every single row anyway (every price is
//     either >= close or < close, so the two sets fully cover every index).
//     That first pass never survived to be seen — it's been removed.
//   - The dominant remaining cost is the per-tick "↤Candle"/"Pivot" start-
//     bar search for Reference Levels (f_nearestObstructionBar /
//     f_nearestPivotBar), which scans back up to refBarsBack bars per
//     level. That cost is proportional to (days-back × 1440 / chart
//     timeframe-in-minutes), so it grows fast on low timeframes. It's
//     already skipped for any level with no price set (na guard inside
//     both functions) and for levels left on "Fixed" mode. On very low
//     timeframes with many "↤Candle"/"Pivot" levels active, lowering
//     "Start N days in the past" (refBarsBackDays) or switching busy
//     levels to "Fixed" mode is the most effective further speed-up —
//     doing that automatically would change the script's behavior, so
//     it's left as a user choice rather than baked in here.
// ═══════════════════════════════════════════════════════════════════════

/////////////////////////////////////////////////
////           START MARKERS (ALL)            ///
/////////////////////////////////////////////////

startMarkerLength = input.int(1, '─── Bar Length ', minval = 0, maxval = 10, inline = 'sm', group = '🪙 A L L - L E V E L S - S T A R T - M A R K E R S', tooltip = 'Length of the solid tick mark drawn at the start of every level (Mid/Long-Term, Entry/Target, and Reference levels).')
startMarkerWidth  = input.int(1, 'Width', minval = 1, maxval = 10, inline = 'sm', group = '🪙 A L L - L E V E L S - S T A R T - M A R K E R S', tooltip = 'Line thickness of the start tick mark.')
dottedMarkerLength = input.float(0.4, '..... % Length ', minval = 0.1, maxval = 5.0, step = 0.1, inline = 'dm', tooltip = 'Height of the small dotted vertical marker at the start of every level, as a % of price.')
dottedMarkerWidth  = input.int(1, 'Width', minval = 1, maxval = 10, inline = 'dm', tooltip = 'Line thickness of the dotted vertical marker.')

/////////////////////////////////////////////////////////////
////        G L O B A L   L A B E L   O F F S E T S        ///
/////////////////////////////////////////////////////////////
// One shared "Labels Offset" input per group, replacing the individual
// per-subsystem offset inputs that used to live inside each group's own
// section. Every member of a group now scrolls to the same bar count, so
// nudging one input re-aligns every label in that group at once.
globalOffsetGroup   = '🪙 G L O B A L - L A B E L - O F F S E T S'
globalOffsetOthers  = input.int(30, 'Labels Offset — Entry-Target Events', minval = 0, maxval = 500, group = globalOffsetGroup, tooltip = 'Bars to the right of the current bar where price labels are placed for the Set 1 Entry/Target Events (the entry-zone shading ends here too). In Boxes caption mode, right-aligned captions end here.')
globalOffsetRef     = input.int(30, 'Labels Offset — Reference Levels (Ⅰ–Ⅱ)', minval = 0, maxval = 500, group = globalOffsetGroup, tooltip = 'Bars to the right of the current bar where price/description labels are placed for both manual Reference Levels. In Boxes caption mode, right-aligned captions end here.')
globalOffsetMidLong = input.int(40, 'Labels Offset — Mid/Long-Term', minval = 0, maxval = 500, group = globalOffsetGroup, tooltip = 'Bars to the right of the current bar where price labels are placed for the Mid-Term targets, the Long-Term targets, and the Current-Year/Previous-Year Open axis lines. Replaces what used to be two separate offset inputs (Mid Term Offset and Long Term Offset). In Boxes caption mode, right-aligned captions end here.')

/////////////////////////////////////////////////////////////
////        L A B E L   T E X T   C O L O R   ( A L L )    ///
/////////////////////////////////////////////////////////////
// One shared text color for every chart label (Mid-Term, Long-Term,
// Current/Previous-Year Open, Set 1 Entry/Target, Reference Level price
// and description labels). OFF keeps each label's own automatic text
// color (f_contrastText / marker color / white). The dynamic near/mid/far
// opacity still fades the chosen color, same as before. Summary tables
// keep their own text colors.
labelTextGroup    = '🪙 L A B E L - T E X T - C O L O R'
labelTextOverride = input.bool(false, 'Custom Text Color For All Labels', inline = 'lbltxt', group = labelTextGroup)
labelTextColor    = input.color(color.white, '', inline = 'lbltxt', group = labelTextGroup, tooltip = 'ON: every chart label uses this text color. OFF: each label keeps its own automatic text color (black/white contrast, marker color, or white). Rank-based opacity still applies either way.')

// Returns the user-selected label text color when the override is on,
// else the label's own default text color.
f_lblText(_default) =>
    labelTextOverride ? labelTextColor : _default

/////////////////////////////////////////////////////////////
////        C A P T I O N   M O D E   ( A L L )            ///
/////////////////////////////////////////////////////////////
// Global switch between pointer labels and box captions for every level's
// price caption — see CAPTION MODE in the SCRIPT OVERVIEW above.
captionGroup = '🪙 C A P T I O N - M O D E'
captionMode  = input.string('Boxes', 'Caption Mode', options = ['Labels', 'Boxes'], inline = 'cap', group = captionGroup)
captionAlign = input.string('Right', 'Align', options = ['Left', 'Center', 'Right'], inline = 'cap', group = captionGroup, tooltip = 'Labels: classic pointer labels to the right of each line\'s end. Boxes: captions ride on the lines themselves, inside a thin box spanning each line from its start bar to its label offset. Align applies to Boxes only: Right ends the text at the label offset, Left starts it at the line\'s start bar.')
captionSide  = input.string('Away From Price', 'Side (Boxes)', options = ['Away From Price', 'Above', 'Below'], group = captionGroup, tooltip = 'Boxes mode only. Away From Price: captions of levels at/above the current price read above their line, levels below it read under their line. Above / Below: every caption on that side of its line.')

bool   capBoxMode = captionMode == 'Boxes'
string capHAl     = switch captionAlign
    'Left'   => text.align_left
    'Center' => text.align_center
    => text.align_right

////////////////////////////////////////////////////////////
////        R E A C H E D   M A R K E R   ( A L L )        ///
////////////////////////////////////////////////////////////
// Appends a checkmark to every chart price label (Mid-Term, Long-Term, Current/Previous-Year Open, Entry/Target Events,
// and Reference Levels) whose own price has traded through (between a
// bar's high and low) at any point within the lookback below — the same
// "reached" idea already used by the ✓ column in both summary tables,
// applied here to the on-chart labels themselves. Kept as its own
// independent lookback (rather than reusing mltReachedMonths/
// secReachedMonths, which are declared much later in the script where
// the tables' own inputs live) so every label can be marked regardless
// of chart draw order.
reachedMarkGroup  = '🪙 R E A C H E D   M A R K E R'
showReachedMark   = input.bool(true, 'Show ✓ On Reached Labels', group = reachedMarkGroup, tooltip = 'Appends a checkmark to any chart price label whose own price has traded through (between a bar\'s high and low) at any point within the lookback below.')
reachedMarkMonths = input.int(6, 'Reached Lookback (Months)', minval = 1, maxval = 60, group = reachedMarkGroup, tooltip = 'How far back (in months) to check whether a level has been reached, for the ✓ suffix on chart labels.')

// Converts a duration in days into an approximate bar count for the
// CURRENT chart timeframe — used everywhere this script needs to turn
// "N months/days back" into a bar count (the ✓-reached lookbacks below
// and refBarsBack further down). timeframe.in_seconds() reports the
// actual seconds-per-bar for any regular chart resolution (seconds,
// minutes, hours, Daily, Weekly, Monthly), so this works correctly on
// every one of them — unlike a raw `days * 1440 / timeframe.multiplier`,
// which silently assumes an intraday-minutes chart: on a Daily/Weekly/
// Monthly chart that produces a bar count in the tens of thousands,
// which then blows past this script's own max_bars_back = 5000 and
// throws a runtime "requested too many historical bars" error the
// moment it feeds a historical-index loop or a ta.highest/ta.lowest
// call below. On non-standard chart types (Range/Renko/Kagi/PnF) where
// timeframe.in_seconds() can return na, the old minutes-based formula
// is kept as a fallback. The result is always clamped to [1, 4999] so
// it's guaranteed to stay inside max_bars_back regardless of timeframe.
f_periodBars(_days) =>
    float _secsPerBar = timeframe.in_seconds(timeframe.period)
    int _bars = na(_secsPerBar) or _secsPerBar <= 0 ?
         int(_days * 1440 / math.max(1, timeframe.multiplier)) :
         int(_days * 86400 / _secsPerBar)
    int(math.min(math.max(_bars, 1), 4999))

// Computed unconditionally every bar, same reasoning as mltReachedHigh/Low
// and secReachedHigh/Low further down — ta.highest/ta.lowest should not be
// called conditionally.
reachedMarkBars = f_periodBars(reachedMarkMonths * 30)
reachedMarkHigh = ta.highest(high, reachedMarkBars)
reachedMarkLow  = ta.lowest(low, reachedMarkBars)

// Returns ' ✓' when the given price has been reached within the lookback
// above (and the toggle is on), else an empty string — appended directly
// onto a label's own text.
f_reachedSuffix(_price) =>
    (showReachedMark and not na(_price) and _price <= reachedMarkHigh and _price >= reachedMarkLow) ? ' ✓' : ''

////////////////////////////////////////////////////
////        SHARED  H E L P E R  FUNCTIONS        ///
////////////////////////////////////////////////////
// Every "level" drawn by this script — Mid/Long-Term targets, Entry/Target events, and Reference Levels — is visually the
// same three-part object: a main line, a start/dot marker pair, and a
// price label. It's built once and parameterized, and array clearing is
// a one-line call per tracker.

// Deletes and clears every line object in a tracking array before a redraw.
f_clearLines(_arr) =>
    if array.size(_arr) > 0
        for ln in _arr
            line.delete(ln)
        array.clear(_arr)

// Deletes and clears every label object in a tracking array before a redraw.
f_clearLabels(_arr) =>
    if array.size(_arr) > 0
        for lb in _arr
            label.delete(lb)
        array.clear(_arr)

// Deletes and clears every linefill object in a tracking array before a redraw.
f_clearLinefills(_arr) =>
    if array.size(_arr) > 0
        for lf in _arr
            linefill.delete(lf)
        array.clear(_arr)

// Deletes and clears every box object in a tracking array before a redraw.
f_clearBoxes(_arr) =>
    if array.size(_arr) > 0
        for bx in _arr
            box.delete(bx)
        array.clear(_arr)

// Solid start-marker tick + dotted vertical marker at the left edge of a level.
f_drawStartMarker(_bar, _price, _color) =>
    startLine = line.new(_bar - startMarkerLength, _price * 0.998, _bar + startMarkerLength, _price * 1.002,
         color = _color, width = startMarkerWidth, style = line.style_solid)
    dotLine = line.new(_bar, _price * (1 - dottedMarkerLength / 100), _bar, _price * (1 + dottedMarkerLength / 100),
         color = _color, width = dottedMarkerWidth, style = line.style_dotted)
    [startLine, dotLine]

// Blink/constant visibility helper shared by every "Display Mode" input pair.
f_eventsVisible(_mode, _showSec, _hideSec) =>
    _mode == 'Constant' ? true : (timenow % ((_showSec + _hideSec) * 1000) < _showSec * 1000)

// Maps a line-style input string to the actual line.style constant.
f_lineStyle(_style) =>
    _style == 'Dotted' ? line.style_dotted :
     _style == 'Dashed' ? line.style_dashed : line.style_solid

// ── DYNAMIC OPACITY (shared by both summary tables AND their matching
// chart lines/labels) ──────────────────────────────────────────────────
// Computes a price level's rank-based opacity %, using the exact same
// near/mid/far convention already used by the Mid/Long-Term and SHORT-TERM
// tables: ranked by distance to `close`, separately among the companion
// levels sitting above close and those sitting below it. The nearest
// level on each side gets _pctNear, the next-nearest gets _pctMid, and
// every other level gets _pctFar. `_companions` must be the same price
// pool a level's own summary-table row is ranked against, so the plotted
// line/label always matches that table's own opacity for the same level.
f_rankPct(_price, _companions, _close, _pctNear, _pctMid, _pctFar) =>
    float _pct = _pctFar
    if not na(_price)
        int _closerCount = 0
        if _price >= _close
            for p in _companions
                if not na(p) and p >= _close and p < _price
                    _closerCount := _closerCount + 1
        else
            for p in _companions
                if not na(p) and p < _close and p > _price
                    _closerCount := _closerCount + 1
        _pct := _closerCount == 0 ? _pctNear : _closerCount == 1 ? _pctMid : _pctFar
    _pct

// Parses a comma-separated price-list input into a float array once, so
// downstream consumers can iterate the numbers directly instead of each
// re-running str.tonumber() on the same strings.
f_parsePrices(_strArr) =>
    _out = array.new_float(0)
    for x in _strArr
        array.push(_out, str.tonumber(x))
    _out

// Builds a price ladder from an anchor price and a multiplier array — the
// same anchor×multiplier engine used by CQ_(M)_[MID-TERM OBJECTIVE
// LADDER] — used to auto-generate the Mid-Term target list below instead
// of requiring it to be typed in as a fixed price list. No-ops (returns
// an empty array) while the anchor is unresolved or non-positive.
f_computeLadder(_anchor, _mults) =>
    _out = array.new_float(0)
    if not na(_anchor) and _anchor > 0
        for m in _mults
            if not na(m)
                array.push(_out, _anchor * m)
    _out

// Picks black or white text for legibility against a given background
// color, using the standard perceptual-luminance weighting (ITU-R
// BT.601: green reads brightest to the eye, blue darkest). Needed
// because label backgrounds now swing across the FULL opacity range
// (dynamic near/mid/far rank) instead of always sitting at one fixed,
// fairly transparent value — a light/bright background (yellow, light
// green, cyan…) at high opacity needs black text, not the flat white
// every label previously used regardless of its own color.
f_contrastText(_bgColor) =>
    _luminance = (color.r(_bgColor) * 299 + color.g(_bgColor) * 587 + color.b(_bgColor) * 114) / 1000
    _luminance > 150 ? color.black : color.white

// Set 1 Entry/Target events draw BEFORE the Reference Levels are known
// further down the script, so their rank can't be computed at draw time
// against the FULL SHORT-TERM-Table price pool. Instead,
// f_drawEventLevel/f_drawRefLevel register each
// level's main line + main label + price + base color here; a recolor
// pass placed right after the Reference Levels are drawn (once every
// SHORT-TERM-Table price source is finally known) rewrites each object's
// color via line.set_color/label.set_color with the correct dynamic
// opacity, keeping the object's own base color (hue) unchanged.
// secOpacityLabelColors holds each label's own BACKGROUND hue separately
// from its line hue (secOpacityBaseColors) — Entry/Target labels take
// their background from the Label Palette, while their lines keep the
// set's own Line Color. Reference Levels push the same color to both.
// secOpacityBoxes runs parallel to secOpacityLabels: in Boxes caption
// mode each entry holds the caption box and the label entry is na; in
// Labels mode it's the other way round. The recolor pass skips na ids.
var line[]  secOpacityLines       = array.new_line(0)
var label[] secOpacityLabels      = array.new_label(0)
var box[]   secOpacityBoxes       = array.new_box(0)
var float[] secOpacityPrices      = array.new_float(0)
var color[] secOpacityBaseColors  = array.new_color(0)
var color[] secOpacityLabelColors = array.new_color(0)
var color[] secOpacityTextColors  = array.new_color(0)

// Same tracker, for the Mid/Long-Term group (Mid-Term, Long-Term, and the
// Current/Previous-Year Open axis lines) — these draw before
// mltPctNear/mltPctMid/mltPctFar are declared further down the script
// (in the Mid/Long-Term Table inputs), so they need the same
// placeholder-then-recolor treatment.
var line[]  mltOpacityLines      = array.new_line(0)
var label[] mltOpacityLabels     = array.new_label(0)
var box[]   mltOpacityBoxes      = array.new_box(0)
var float[] mltOpacityPrices     = array.new_float(0)
var color[] mltOpacityBaseColors = array.new_color(0)
var color[] mltOpacityTextColors = array.new_color(0)

// Every caption box drawn this tick (Boxes caption mode), across all
// subsystems — cleared once at the start of each realtime tick.
var box[]   capBoxes = array.new_box(0)

// Box caption for one level (Boxes caption mode): a thin box spanning
// _left → _right on the level's line. Height scales with price (≈0.001%
// of the level, at least one tick). Above: box sits on the line with its
// text bottom-aligned, so the text reads above the line. Below: box
// hangs under the line with its text top-aligned, so it reads below.
// Registered in capBoxes for the next tick's cleanup.
f_capBox(_left, _right, _price, _txt, _bg, _tc, _size) =>
    float _h     = math.max(syminfo.mintick, _price * 0.00001)
    bool  _above = captionSide == 'Above' ? true : captionSide == 'Below' ? false : _price >= close
    bx = box.new(_left, _above ? _price + _h : _price, _right, _above ? _price : _price - _h, border_color = color(na), border_width = 0, bgcolor = _bg, text = _txt, text_size = _size, text_color = _tc, text_halign = capHAl, text_valign = _above ? text.align_bottom : text.align_top)
    array.push(capBoxes, bx)
    bx

// Persistent companion price pools, captured at draw time (when the
// underlying price lists are known) for the final recolor pass to reuse
// once the opacity-pct inputs of both tables are known.
var float[] mltCompanionPricesTracked = array.new_float(0)
var float[] secCompanionPricesTracked = array.new_float(0)
// Parallel tag array (same index as secCompanionPricesTracked) recording which
// SHORT-TERM-Table source group each companion price came from — 1 Set 1 Entry,
// 3 Set 1 Target, 7 Reference Levels. The final recolor pass uses it to drop any
// group the user has switched OFF in the SHORT-TERM Table settings, so a
// chart line's rank-based opacity is always computed against exactly the
// same pool as its table row.
var int[]   secCompanionGroupsTracked = array.new_int(0)

// Pushes one price + its group tag into the SHORT-TERM companion pool.
f_pushSecCompanion(_price, _grp) =>
    if not na(_price)
        array.push(secCompanionPricesTracked, _price)
        array.push(secCompanionGroupsTracked, _grp)

// One Mid/Long-Term target level: line extended left + start marker + label.
// Shared by the Mid-Term and Long-Term loops. Line/label opacity starts at
// a neutral placeholder (50) — mltPctNear/mltPctMid/mltPctFar aren't
// declared yet at this point in the script (they live in the Mid/Long-Term
// Table inputs further down), so the real dynamic opacity is applied by
// the recolor pass after those inputs are known — see "DYNAMIC OPACITY —
// FINAL RECOLOR PASS" near the SHORT-TERM Table section. This function
// registers into mltOpacityLines/Labels/Prices/BaseColors for that pass.
// Label text color is caller-supplied via _textColor: Long-Term passes
// f_contrastText(LongTermColor) (auto black/white for legibility against
// its own background), while Mid-Term passes a fixed color.white — either
// is replaced by labelTextColor when the global text-color override is on.
// In Boxes caption mode the caption is a box from the current bar to the
// label offset instead, and its text uses the level's own line color.
f_drawTermLevel(_price, _offset, _lineColor, _lineWidth, _markerColor, _labelPrefix, _labelBgColor, _labelSize, _linesArr, _labelsArr, _textColor) =>
    _txt = f_lblText(capBoxMode ? _lineColor : _textColor)
    ln = line.new(bar_index, _price, bar_index + _offset, _price, extend = extend.left, color = color.new(_lineColor, 50), width = _lineWidth)
    array.push(_linesArr, ln)
    [sM, dM] = f_drawStartMarker(bar_index, _price, _markerColor)
    array.push(_linesArr, sM)
    array.push(_linesArr, dM)
    _capTxt = str.tostring(_price, _labelPrefix + ' $' + '0,000') + f_reachedSuffix(_price)
    label lbl = na
    box   bx  = na
    if capBoxMode
        bx := f_capBox(bar_index, bar_index + _offset, _price, _capTxt, color.new(_labelBgColor, 50), _txt, _labelSize)
    else
        lbl := label.new(last_bar_index + _offset, _price, _capTxt, style = label.style_label_left, color = color.new(_labelBgColor, 50), textcolor = _txt, size = _labelSize, textalign = text.align_left)
        array.push(_labelsArr, lbl)
    if not na(_price)
        array.push(mltOpacityLines, ln)
        array.push(mltOpacityLabels, lbl)
        array.push(mltOpacityBoxes, bx)
        array.push(mltOpacityPrices, _price)
        array.push(mltOpacityBaseColors, _lineColor)
        array.push(mltOpacityTextColors, _txt)

// One Entry/Target event level: line + start marker + label with a
// caller-supplied text (so the same function serves both Entry ticks,
// which count up "EARLY 1/2, EVENT 1/2", and Target ticks, which show "+125%/+160%…").
// _color drives the line; _labelColor drives the label background (the
// Label Palette's red tone for Entry, green tone for Target).
// Line/label opacity starts at a neutral placeholder (50), corrected by
// the dynamic-opacity recolor pass after the Reference Levels are drawn
// — this function registers into the secOpacityLines/Labels/Prices/
// BaseColors/LabelColors tracker for that pass.
// The line, its start marker and (Boxes caption mode) the caption box
// all start at the current candle and run to the label offset.
f_drawEventLevel(_price, _offset, _color, _labelColor, _markerColor, _lineWidth, _labelText, _linesArr, _labelsArr) =>
    _txt = f_lblText(_markerColor)
    ln = line.new(bar_index, _price, bar_index + _offset, _price, color = color.new(_color, 50), width = _lineWidth)
    array.push(_linesArr, ln)
    [sM, dM] = f_drawStartMarker(bar_index, _price, _markerColor)
    array.push(_linesArr, sM)
    array.push(_linesArr, dM)
    _capTxt = _labelText + f_reachedSuffix(_price)
    label lbl = na
    box   bx  = na
    if capBoxMode
        bx := f_capBox(bar_index, bar_index + _offset, _price, _capTxt, color.new(_labelColor, 50), color.new(_txt, 0), size.small)
    else
        lbl := label.new(last_bar_index + _offset, _price, _capTxt, style = label.style_label_left, color = color.new(_labelColor, 50), textcolor = color.new(_txt, 0), size = size.small, textalign = text.align_left)
        array.push(_labelsArr, lbl)
    if not na(_price)
        array.push(secOpacityLines, ln)
        array.push(secOpacityLabels, lbl)
        array.push(secOpacityBoxes, bx)
        array.push(secOpacityPrices, _price)
        array.push(secOpacityBaseColors, _color)
        array.push(secOpacityLabelColors, _labelColor)
        array.push(secOpacityTextColors, _txt)

// A full Entry+Target event set (one "grade") from its two price lists.
// _targetPcts: ratios matching _targetPrices one-to-one (Set 1 passes
// ulTargetRatios, so its labels read the real 125/160/200% levels).
// _earlyCount: how many leading entries are labeled EARLY 1, EARLY 2…;
// the rest restart at EVENT 1 (Set 1 passes 2 → EARLY 1, EARLY 2,
// EVENT 1, EVENT 2).
// _entryLabelColor / _targetLabelColor: label background colors (from
// the Label Palette), independent of the line colors.
f_drawEventSet(_entryPrices, _targetPrices, _targetPcts, _earlyCount, _entryColor, _entryLabelColor, _entryTextColor, _targetColor, _targetLabelColor, _targetTextColor, _offset, _lineWidth, _linesArr, _labelsArr) =>
    count = 1
    for y in _entryPrices
        entryTxt = count <= _earlyCount ? 'EARLY ' + str.tostring(count, '0') : 'EVENT ' + str.tostring(count - _earlyCount, '0')
        f_drawEventLevel(y, _offset, _entryColor, _entryLabelColor, _entryTextColor, _lineWidth, entryTxt + '\n' + str.tostring(y, '$0,000'), _linesArr, _labelsArr)
        count := count + 1
    for [i, y] in _targetPrices
        pctTxt = str.tostring(math.round(array.get(_targetPcts, i) * 100), '0')
        f_drawEventLevel(y, _offset, _targetColor, _targetLabelColor, _targetTextColor, _lineWidth, '🎯+' + pctTxt + '%' + '\n' + str.tostring(y, '$0,000'), _linesArr, _labelsArr)

// One Reference Level: line (variable style) + start marker + price label +
// optional description label. Line/price-label opacity starts at a
// neutral placeholder (50/70) — secPctNear/secPctMid/secPctFar aren't
// declared yet at this point in the script (they live in the SHORT-TERM
// Table inputs further down), so the real dynamic opacity comes from the
// recolor pass placed after those inputs are known (see "DYNAMIC
// OPACITY — FINAL RECOLOR PASS" near the SHORT-TERM Table section). This
// function registers its main line + price label into secOpacityLines/
// Labels/Prices/BaseColors for that pass; the description label (a
// SHORT-TERM annotation, not "the" level line/label) keeps its original
// fixed opacity. In Boxes caption mode the price caption is a box
// spanning the line (start bar → end bar) with text in the level's own
// color; the description label stays a label in both modes.
f_drawRefLevel(_price, _desc, _color, _width, _style, _futureBars, _startBar, _extendLeft, _linesArr, _labelsArr) =>
    if not na(_price)
        startBar = _startBar
        endBar   = bar_index + _futureBars
        _txt     = f_lblText(capBoxMode ? _color : f_contrastText(_color))

        refLine = line.new(startBar, _price, endBar, _price,
                           xloc = xloc.bar_index,
                           extend = _extendLeft ? extend.left : extend.none,
                           color = color.new(_color, 50),
                           width = _width,
                           style = f_lineStyle(_style))
        array.push(_linesArr, refLine)

        [markerLine, dotLine] = f_drawStartMarker(startBar, _price, _color)
        array.push(_linesArr, markerLine)
        array.push(_linesArr, dotLine)

        _capTxt = str.tostring(_price, '$0,000') + f_reachedSuffix(_price)
        label priceLabel = na
        box   priceBox   = na
        if capBoxMode
            priceBox := f_capBox(startBar, endBar, _price, _capTxt, color.new(_color, 50), _txt, size.small)
        else
            priceLabel := label.new(endBar, _price,
                                   _capTxt,
                                   style = label.style_label_left,
                                   color = color.new(_color, 50),
                                   textcolor = _txt,
                                   size = size.small,
                                   textalign = text.align_left)
            array.push(_labelsArr, priceLabel)

        array.push(secOpacityLines, refLine)
        array.push(secOpacityLabels, priceLabel)
        array.push(secOpacityBoxes, priceBox)
        array.push(secOpacityPrices, _price)
        array.push(secOpacityBaseColors, _color)
        array.push(secOpacityLabelColors, _color)
        array.push(secOpacityTextColors, _txt)

        if _desc != ''
            descLabel = label.new(endBar + 4, _price * 1.002,
                                  _desc,
                                  style = label.style_label_down,
                                  color = color.new(_color, 70),
                                  textcolor = f_lblText(f_contrastText(_color)),
                                  size = size.tiny,
                                  textalign = text.align_left)
            array.push(_labelsArr, descLabel)

// Gradient shading between two price levels, built from N stacked
// linefill bands so the fill visually blends from _color1 (at _price1) to
// _color2 (at _price2) using color.from_gradient per band — linefill
// itself only accepts one flat color, so the "gradient" is simulated by
// slicing the price gap into bands, each with its own interpolated color.
// Orientation-safe: if _price1 > _price2 the color/price pairing is
// swapped internally so the gradient still runs low-price -> high-price.
// Skips entirely (no-op) if either price is unset (na). A solid fill is
// one band with the same color passed twice. Shared by the Reference
// Level shading and the Set 1 entry-zone shading.
f_drawGradientShade(_price1, _color1, _price2, _color2, _startBar, _endBar, _bands, _transparency, _linesArr, _fillsArr) =>
    if not na(_price1) and not na(_price2)
        float _lo = math.min(_price1, _price2)
        float _hi = math.max(_price1, _price2)
        color _colorLo = _price1 <= _price2 ? _color1 : _color2
        color _colorHi = _price1 <= _price2 ? _color2 : _color1
        for i = 0 to _bands - 1
            float _pA = _lo + (_hi - _lo) * i / _bands
            float _pB = _lo + (_hi - _lo) * (i + 1) / _bands
            color _bandColor = color.from_gradient((i + 0.5) / _bands, 0.0, 1.0, _colorLo, _colorHi)
            lnA = line.new(_startBar, _pA, _endBar, _pA, xloc = xloc.bar_index, color = color.new(_bandColor, 100), width = 1)
            lnB = line.new(_startBar, _pB, _endBar, _pB, xloc = xloc.bar_index, color = color.new(_bandColor, 100), width = 1)
            array.push(_linesArr, lnA)
            array.push(_linesArr, lnB)
            lf = linefill.new(lnA, lnB, color.new(_bandColor, _transparency))
            array.push(_fillsArr, lf)

// Weekly open — used only by the SHORT-TERM Table's automatic 1W Open row.
sundayOpen = request.security(syminfo.tickerid, 'W', open, lookahead = barmerge.lookahead_on)

// Cleared once each realtime tick, before any subsystem registers into
// the cross-subsystem dynamic-opacity tracker (secOpacityLines/Labels/
// Prices/BaseColors, see the SHARED HELPER FUNCTIONS block) so it never
// mixes entries from different ticks. secCompanionPricesTracked is then
// rebuilt incrementally by the Set 1 Entry/Target and Reference Levels
// blocks below. Every caption box from the previous tick (capBoxes) is
// deleted here too, since every subsystem redraws its captions below.
if not barstate.isconfirmed and barstate.isrealtime
    f_clearBoxes(capBoxes)
    array.clear(secOpacityLines)
    array.clear(secOpacityLabels)
    array.clear(secOpacityBoxes)
    array.clear(secOpacityPrices)
    array.clear(secOpacityBaseColors)
    array.clear(secOpacityLabelColors)
    array.clear(secOpacityTextColors)
    array.clear(secCompanionPricesTracked)
    array.clear(secCompanionGroupsTracked)

////////////////////////////////////////////
////        ENTRY / TARGET EVENTS        ///
////////////////////////////////////////////
// One event set ("Set 1" = 4H grade): a list of entry prices and a list
// of target prices, auto-filled from the last confirmed zigzag leg and
// drawn via f_drawEventSet, plus optional entry-zone shading. The set has
// its own blink/constant Display Mode.

// ＩＮＰＵＴＳ
// yearly_open and prevYearly_open both pull the '12M' series — merged
// into ONE request.security tuple call instead of two separate calls
// (prevYearly_open just reads one bar further back, open[1], on that
// same higher-timeframe series).
[yearly_open, prevYearly_open] = request.security(syminfo.tickerid, '12M', [open, open[1]], lookahead = barmerge.lookahead_on)

showSet1 = input.bool(true, '    PLOT [4H SHORTER GRADE (More Noise)]', group = '🪙 E N T R Y - A N D - T A R G E T - E V E N T S', tooltip = 'Show/hide the Set 1 Entry/Target event lines and labels (and the entry-zone shading).')

// === Palette Definitions ===
// Label-background scheme for the Set 1 Entry/Target event labels: Entry
// labels use colorRed, Target labels use colorGreen. Only the label
// backgrounds follow this palette — event lines keep the set's own Line
// Color inputs, and the dynamic near/mid/far opacity still fades the
// palette color (its transparency is always overridden by the recolor
// pass, so the fallback colorRed's built-in 100 transparency does not
// make labels invisible).
palette = input.string('Classic', '    🎨 Label Palette', options = ['Classic', 'Ocean', 'Sunset', 'Neon', 'Monochrome', 'Desert', 'Oldbook', 'OldWest', 'Default'], group = '🪙 E N T R Y - A N D - T A R G E T - E V E N T S', tooltip = 'Background color scheme for the Set 1 Entry and Target event labels. Entry labels use the palette\'s red tone, Target labels its green tone. Lines keep their own Line Color inputs. "Default" uses the bright fallback colors.')
colorGreen = palette == 'Classic' ? color.rgb(0, 57, 55) : palette == 'Ocean' ? color.rgb(0, 54, 93) : palette == 'Sunset' ? color.rgb(102, 61, 0) : palette == 'Neon' ? color.rgb(0, 80, 145) : palette == 'Monochrome' ? color.rgb(117, 117, 117) : palette == 'Desert' ? color.rgb(0, 39, 35) : palette == 'Oldbook' ? color.rgb(63, 73, 7) : palette == 'OldWest' ? color.rgb(63, 77, 3) : color.rgb(0, 255, 191)
colorRed   = palette == 'Classic' ? color.rgb(72, 0, 0)  : palette == 'Ocean' ? color.rgb(0, 20, 85) : palette == 'Sunset' ? color.rgb(35, 34, 32) : palette == 'Neon' ? color.rgb(42, 45, 51) : palette == 'Monochrome' ? color.rgb(65, 65, 65) : palette == 'Desert' ? color.rgb(61, 37, 0) : palette == 'Oldbook' ? color.rgb(49, 43, 5)    : palette == 'OldWest' ? color.rgb(49, 10, 0) : color.rgb(255, 0, 0, 100)

event_entry_Color   = input.color(color.rgb(0, 38, 255),   title = '    Line Color', inline = 'entry', tooltip = 'Color of the Set 1 Entry event lines (and their SHORT-TERM Table rows). Label backgrounds follow the Label Palette.')
event_entry_tColor  = input.color(color.rgb(52, 197, 255), title = '    Text Color', inline = 'entry', tooltip = 'Marker/text color of the Set 1 Entry event lines and labels.')

event_target_Color   = input.color(color.rgb(40, 143,   0), title = '    Line Color', inline = 'target', tooltip = 'Color of the Set 1 Target event lines (and their SHORT-TERM Table rows). Label backgrounds follow the Label Palette.')
event_target_tColor  = input.color(color.rgb(72, 255, 0),   title = '    Text Color', inline = 'target', tooltip = 'Marker/text color of the Set 1 Target event lines and labels.')

// ── AUTO LEVELS FROM THE LAST CONFIRMED LEG (Set 1) ─────────────────────
// Zigzag engine ported from CQ_(U)_Unconfirmed Leg Levels (same as the
// Phase Counter). ulZ holds pivots newest first: ulZ[0] is the newest
// pivot, which can still shift while price keeps making new extremes, so
// the leg ending there is unconfirmed. The last CONFIRMED leg is the one
// before it, from ulZ[4] (leg start) to ulZ[2] (leg end) — both of its
// pivots are locked in, because a newer pivot in the opposite direction
// (ulZ[0]) already exists. Set 1 is always filled from this leg:
// Entry = 40/50/60/100%, Target = 125/160/200% (rounded to whole
// numbers). The levels only change when a new pivot confirms the next leg.
ulPeriod = input.int(45, '    Auto Levels — ZigZag Period', minval = 2, inline = 'ulauto', group = '🪙 E N T R Y - A N D - T A R G E T - E V E N T S', tooltip = 'Lookback length in bars of the zigzag whose last CONFIRMED leg (the pivot-to-pivot leg before the still-developing one) feeds the auto Entry/Target levels. Runs on the chart timeframe.')
ulInvert = input.bool(false, 'Invert', inline = 'ulauto', group = '🪙 E N T R Y - A N D - T A R G E T - E V E N T S', tooltip = 'On: 0% = leg start, 100% = leg end (last confirmed pivot), so 125/160/200 project forward in the leg\'s direction.\nOff (default): 0% = leg end (last confirmed pivot), 100% = leg start, so 40/50/60 read as retracements and 125/160/200 extend beyond the leg start.')

ulPh = ta.highestbars(high, ulPeriod) == 0 ? high : na
ulPl = ta.lowestbars(low, ulPeriod) == 0 ? low : na

var int ulDir = 0
ulPrevDir = ulDir
ulDir := not na(ulPh) and na(ulPl) ? 1 : not na(ulPl) and na(ulPh) ? -1 : ulDir

var ulZ = array.new_float()   // [price0, time0, price1, time1, ...] newest first
if not na(ulPh) or not na(ulPl)
    ulV = ulDir == 1 ? ulPh : ulPl
    if ulDir != ulPrevDir
        ulZ.unshift(time)
        ulZ.unshift(ulV)
    else if not (not na(ulPh) and not na(ulPl)) and ulZ.size() > 0 and (ulDir == 1 ? ulV > ulZ.get(0) : ulV < ulZ.get(0))
        ulZ.set(0, ulV)
        ulZ.set(1, time)

var ulEntryRatios  = array.from(0.40, 0.50, 0.60, 1.00)
var ulTargetRatios = array.from(1.25, 1.60, 2.00)

// Prices of the given ratios on the last confirmed leg (empty until the
// zigzag has at least three pivots). ulZ layout: [price0, time0, price1,
// time1, price2, time2, ...] → ulZ.get(2) = leg end, ulZ.get(4) = leg start.
f_ulLevels(_ratios) =>
    _out = array.new_float(0)
    if ulZ.size() >= 6
        _p0   = ulInvert ? ulZ.get(4) : ulZ.get(2)   // 0% anchor
        _p100 = ulInvert ? ulZ.get(2) : ulZ.get(4)   // 100% anchor
        for r in _ratios
            _out.push(math.round(_p0 + (_p100 - _p0) * r))
    _out

// Set 1 uses globalOffsetOthers (see the 🪙 G L O B A L - L A B E L -
// O F F S E T S group near the top of the script) for its label offset.

// Display modes
set1DisplayMode = input.string('Constant', 'Display Mode', options = ['Constant', 'Interval'], inline = 'edisp1', tooltip = 'Constant = always visible. Interval = blinks on/off using the Show/Hide seconds below.')
set1ShowSeconds = input.int(5, 'Show (sec)', minval = 1, inline = 'edisp1', tooltip = 'Seconds Set 1 stays visible during each blink cycle (Interval display mode only).')
set1HideSeconds = input.int(2, 'Hide (sec)', minval = 1, inline = 'edisp1', tooltip = 'Seconds Set 1 stays hidden during each blink cycle (Interval display mode only).')

// ── ENTRY ZONE SHADING (Set 1) ──────────────────────────────────────────
// Automatically fills the gaps between consecutive Set 1 entry levels:
//   Early 1 ↔ Early 2 · Early 2 ↔ Event 1 · Event 1 ↔ Event 2
// Each zone has its own toggle and two colors: A sits at the first level
// of the pair, B at the second. Fill Style Gradient blends A → B across
// the zone in stacked linefill bands (f_drawGradientShade); Solid fills
// the whole zone with A. Shading spans the same bars as the event lines
// (current candle → label offset) and follows Set 1's Plot toggle and
// Display Mode, so it blinks together with the set in Interval mode.
// Shade Only Reached Zones (default ON): a zone is drawn only once price
// has reached its first level (Early 1 / Early 2 / Event 1 respectively)
// on some candle after the confirmed leg's end pivot — see the zone
// reach tracker below the Set 1 price arrays. OFF: every enabled zone is
// shaded as soon as the leg is confirmed.
zShadeGroup  = '🪙 E N T R Y - Z O N E - S H A D I N G'
zShadeE1E2   = input.bool(true, 'Early 1 ↔ Early 2', inline = 'zs1', group = zShadeGroup)
zColE1E2a    = input.color(color.rgb(168, 0, 0), 'A', inline = 'zs1', group = zShadeGroup)
zColE1E2b    = input.color(color.rgb(85, 0, 0), 'B', inline = 'zs1', group = zShadeGroup, tooltip = 'Shades the gap between EARLY 1 (color A) and EARLY 2 (color B).')
zShadeE2V1   = input.bool(true, 'Early 2 ↔ Event 1', inline = 'zs2', group = zShadeGroup)
zColE2V1a    = input.color(color.rgb(196, 111, 0), 'A', inline = 'zs2', group = zShadeGroup)
zColE2V1b    = input.color(color.rgb(102, 58, 0), 'B', inline = 'zs2', group = zShadeGroup, tooltip = 'Shades the gap between EARLY 2 (color A) and EVENT 1 (color B).')
zShadeV1V2   = input.bool(true, 'Event 1 ↔ Event 2', inline = 'zs3', group = zShadeGroup)
zColV1V2a    = input.color(color.rgb(76, 168, 0), 'A', inline = 'zs3', group = zShadeGroup)
zColV1V2b    = input.color(color.rgb(43, 95, 0), 'B', inline = 'zs3', group = zShadeGroup, tooltip = 'Shades the gap between EVENT 1 (color A) and EVENT 2 (color B).')
zShadeReached = input.bool(true, 'Shade Only Reached Zones', group = zShadeGroup, tooltip = 'ON: each zone is shaded only once price has reached it — i.e. a candle after the confirmed leg\'s end pivot touched the zone\'s first level (EARLY 1, EARLY 2 or EVENT 1). Zones price hasn\'t reached yet stay unshaded. OFF: every enabled zone is always shaded.')
zShadeStyle  = input.string('Gradient', 'Fill Style', options = ['Gradient', 'Solid'], group = zShadeGroup, tooltip = 'Gradient: each zone blends from its color A (first level) to its color B (second level). Solid: each zone is filled flat with its color A.')
zShadeBands  = input.int(20, 'Gradient Smoothness (Bands)', minval = 2, maxval = 50, group = zShadeGroup, tooltip = 'Gradient style only. More bands = smoother gradient, but each band uses 2 lines + 1 linefill from the shared 500-object budget (3 zones × 20 bands = 120 lines).')
zShadeTransp = input.int(85, 'Shade Transparency', minval = 0, maxval = 100, group = zShadeGroup, tooltip = 'Higher = more see-through shading. Lower = more opaque.')

showMidTerm = input(title='Mid Term ', defval=true, group='🪙 S H O W / H I D E - M I D / L O N G - T E R M', inline = 'mtf', tooltip = 'Show/hide the Mid-Term target lines and labels on the chart. Independent of the Mid/Long-Term summary table, which always includes Mid-Term rows regardless of this toggle.')
showLongTerm = input(title='Long Term ', defval=true, group='🪙 S H O W / H I D E - M I D / L O N G - T E R M', inline = 'mtf', tooltip = 'Show/hide the Long-Term target lines and labels, plus the Current-Year/Previous-Year Open axis lines, on the chart. Independent of the Mid/Long-Term summary table, which always includes Long-Term/Yearly-Open rows regardless of this toggle.')

// NOTE: Set 1 Entry/Target line+label opacity is driven automatically by
// the same dynamic near/mid/far rank-vs-close opacity used by the
// SHORT-TERM Table (secPctNear/secPctMid/secPctFar).

MidTermAnchorOverride = input.float(0.0, 'Anchor Override (0 = Year Open)', minval = 0.0, tooltip = 'Leave at 0 to anchor the Mid-Term ladder to the OPEN of the current year (same anchor used by the Current-Year-Open axis line below). Set a price to force a different anchor.', group = '🪙 M I D - T E R M - T A R G E T S ')
MidTermMultipliers = input.text_area('0.4,0.5,0.6,0.7,0.8,0.9,1.0,1.1,1.2,1.3,1.4,1.5,1.6', 'Targets [M I D - T E R M] — Multipliers', tooltip = 'Comma-separated multipliers applied to the anchor above to auto-generate the Mid-Term price ladder — same anchor×multiplier engine as CQ_(M)_[MID-TERM OBJECTIVE LADDER]. Edit, add, or remove freely; replaces what used to be a manually-typed price list.', group = '🪙 M I D - T E R M - T A R G E T S ')
MidTermColor = input.color(color.rgb(255, 200, 0), 'Mid Term Color', tooltip = 'Color of the Mid-Term target lines and labels.')
MidTermWidth = input.int(1, 'Width', inline = 'MidTerm', tooltip = 'Line thickness of the Mid-Term target lines.')

// ── LONG-TERM TARGETS — AUTO FROM MACRO RANGES ──────────────────────────
// Ported from CQ_(MR)_[MACRO RANGE LADDER]. Each enabled range (a cycle Low
// and a cycle High, normally the ATH) produces one rung per ratio in the
// Ratio List:   level = Low + ratio × (High − Low)
//   ratio < 1 → retracement inside the range · 1 → the High · > 1 → extension.
// With the ATH toggle on, a range's High follows the symbol's all-time high
// (read from the WEEKLY series, so it covers far more history than a
// low-timeframe chart has loaded), and every extension rung recalculates
// when a new ATH prints. Rungs from DIFFERENT ranges within the tolerance %
// of each other can be merged into one rung at their average price.
// Replaces the former manually-typed Long-Term price list.
ltGroup   = '🪙 L O N G - T E R M  - T A R G E T S '
ltAthAll  = input.bool(false, 'Use Weekly ATH For All Ranges', group = ltGroup, tooltip = 'Overrides the High of every enabled range with the symbol\'s all-time high (highest weekly high). Extension rungs (ratio > 1) then recalculate automatically each time price makes a new ATH. Leave OFF to use each range\'s own High (or its Auto High toggle).')
ltAOn     = input.bool(true, 'Range A', inline = 'ltA0', group = ltGroup)
ltAAuto   = input.bool(false, 'Auto High = ATH', inline = 'ltA0', group = ltGroup, tooltip = 'Range A: the current cycle\'s full range (bear-market low → cycle ATH). Auto High uses the weekly ATH as this range\'s High instead of the High input.')
ltALow    = input.float(15476.0, 'Low', minval = 0, inline = 'ltA1', group = ltGroup)
ltAHigh   = input.float(126199.0, 'High', minval = 0, inline = 'ltA1', group = ltGroup, tooltip = 'Default: Nov 2022 low ≈ 15,476 → Oct 2025 ATH ≈ 126,199. Use the exact weekly wicks of your feed. Skipped if High is not above Low.')
ltBOn     = input.bool(true, 'Range B', inline = 'ltB0', group = ltGroup)
ltBAuto   = input.bool(false, 'Auto High = ATH', inline = 'ltB0', group = ltGroup, tooltip = 'Range B: the secondary crash low that preceded the ATH run. Auto High uses the weekly ATH as this range\'s High.')
ltBLow    = input.float(49000.0, 'Low', minval = 0, inline = 'ltB1', group = ltGroup)
ltBHigh   = input.float(126199.0, 'High', minval = 0, inline = 'ltB1', group = ltGroup, tooltip = 'Default: Aug 2024 low ≈ 49,000 → Oct 2025 ATH ≈ 126,199. Skipped if High is not above Low.')
ltCOn     = input.bool(false, 'Range C', inline = 'ltC0', group = ltGroup)
ltCAuto   = input.bool(false, 'Auto High = ATH', inline = 'ltC0', group = ltGroup, tooltip = 'Range C: prior-cycle reference frame (off by default). Usually leave Auto High OFF.')
ltCLow    = input.float(3122.0, 'Low', minval = 0, inline = 'ltC1', group = ltGroup)
ltCHigh   = input.float(69000.0, 'High', minval = 0, inline = 'ltC1', group = ltGroup, tooltip = 'Default: Dec 2018 low 3,122 → Nov 2021 ATH 69,000 (1.618 = 109,713 · 2.0 = 134,878). Low 3,850 gives 0.618 = 44,113 and 1.5 = 101,575.')
ltRatioTxt = input.string('0.382, 0.5, 0.618, 1, 1.5, 1.618, 2', 'Ratio List', group = ltGroup, tooltip = 'Comma-separated ratios applied to every enabled range. Each produces one rung: Low + ratio × (High − Low). Spaces are ignored; invalid entries are skipped; rungs at or below zero are dropped.')
ltCfMerge = input.bool(true, 'Merge Confluence', inline = 'ltcf', group = ltGroup)
ltCfTol   = input.float(0.75, 'Tolerance %', minval = 0.01, step = 0.05, inline = 'ltcf', group = ltGroup, tooltip = 'Merge Confluence ON: rungs from two or more DIFFERENT ranges within this % of the cluster\'s lowest rung collapse into one rung at their average price (rungs of the same range never merge). OFF: every rung is kept at its own price.')
LongTermAxis = yearly_open
PrevYearlyAxis = prevYearly_open

LongTermColor = input.color(color.rgb(0, 85, 255), 'Long Term Label Color', tooltip = 'Color of the Long-Term target lines and labels.')
// NOTE: Mid/Long-Term label text color is picked automatically via
// f_contrastText for guaranteed legibility against the label's own
// (dynamically-opaque) background, unless the global
// 🪙 L A B E L - T E X T - C O L O R override is switched on.
LongTermWidth = input.int(2, 'Width', inline = 'LongTerm', tooltip = 'Line thickness of the Long-Term target lines. Also reused for the Entry/Target event lines.')

// Current/Previous-year open axis lines — grouped together since they're
// the same idea (a year's open plotted as a line+label) at two different
// anchor points. Each gets its own show toggle + color so either can be
// turned off or restyled independently.
yearlyOpenGroup = '🪙 Y E A R L Y - O P E N - L I N E S'
showCurrentYearlyOpen = input.bool(true, 'Show Current Year Open', inline = 'yopenA', group = yearlyOpenGroup, tooltip = 'Show/hide the current-year open axis line and label.')
CurrentYearlyOpenColor = input.color(color.rgb(131, 255, 59), 'Color', inline = 'yopenA', group = yearlyOpenGroup, tooltip = 'Color of the current-year open axis line and label.')
showPrevYearlyOpen = input.bool(true, 'Show Previous Year Open', inline = 'yopenB', group = yearlyOpenGroup, tooltip = 'Show/hide the previous-year open axis line and label.')
PrevYearlyOpenColor = input.color(color.rgb(0, 255, 128), 'Color', inline = 'yopenB', group = yearlyOpenGroup, tooltip = 'Color of the previous-year open axis line and label.')

// Mid-Term, Long-Term and the Current-Year/Previous-Year Open axis lines
// all read their label offset from globalOffsetMidLong (see the
// 🪙 G L O B A L - L A B E L - O F F S E T S group near the top).

// Price Arrays
var aMidTermMults    = str.split(MidTermMultipliers, ',')
// The multipliers list is static, so it's parsed once here; the LADDER
// ITSELF is computed fresh every bar just below, since its anchor
// (yearly_open, or MidTermAnchorOverride) can change when a new year begins.
var float[] pMidTermMults   = f_parsePrices(aMidTermMults)

// Set 1 Entry/Target: auto levels of the last confirmed zigzag leg —
// recomputed every bar (not a "var") so a newly confirmed leg is picked
// up on the bar its pivot confirms.
pEventsEntry  = f_ulLevels(ulEntryRatios)
pEventsTarget = f_ulLevels(ulTargetRatios)

// ── ZONE REACH TRACKER (Shade Only Reached Zones) ───────────────────────
// Running highest high / lowest low of every candle AFTER the confirmed
// leg's end pivot (ulZ.get(3) = its time, same leg ID the BUY/SELL
// signals use). When a new leg confirms, the tracker resets and back-
// fills the candles between that pivot and the current one; afterwards
// it just extends with each new candle (live candle included). A zone is
// "reached" once this extreme has touched its first level in the leg's
// travel direction (0% → 100%).
var float zLegCur = na
var float zExtHi  = na
var float zExtLo  = na
float zLegId = na
if ulZ.size() >= 6
    zLegId := ulZ.get(3)
if not na(zLegId)
    if na(zLegCur) or zLegId != zLegCur
        zLegCur := zLegId
        zExtHi  := high
        zExtLo  := low
        int zBack = 0
        while zBack < 4998 and not na(time[zBack + 1]) and time[zBack + 1] > zLegId
            zBack += 1
        if zBack > 0
            for i = 1 to zBack
                zExtHi := math.max(zExtHi, high[i])
                zExtLo := math.min(zExtLo, low[i])
    else
        zExtHi := math.max(zExtHi, high)
        zExtLo := math.min(zExtLo, low)

// True when price has reached _lvl since the leg end (travel direction
// _dir: 1 = levels above the leg end, -1 = below), or when the
// Shade Only Reached Zones option is off.
f_zReached(_lvl, _dir) =>
    not zShadeReached or (not na(_lvl) and (_dir == 1 ? zExtHi >= _lvl : zExtLo <= _lvl))

// Mid-Term ladder — anchor×multiplier engine (see f_computeLadder above),
// same convention as CQ_(M)_[MID-TERM OBJECTIVE LADDER]. Recomputed
// unconditionally every bar (not a "var") because its anchor tracks
// yearly_open, which itself updates once per year.
MidTermAnchor = MidTermAnchorOverride > 0.0 ? MidTermAnchorOverride : yearly_open
pMidTerm = f_computeLadder(MidTermAnchor, pMidTermMults)

// Long-Term ladder — macro-range engine (see the 🪙 L O N G - T E R M
// inputs above). ATH = running max of the WEEKLY high, so it isn't limited
// by how much history the current (lower) chart timeframe has loaded.
ltWeeklyAth = request.security(syminfo.tickerid, 'W', ta.max(high))

// Ratio list, parsed once on the first bar (spaces stripped).
var float[] ltRatios = array.new_float(0)
if barstate.isfirst
    for part in str.split(ltRatioTxt, ',')
        float v = str.tonumber(str.replace_all(part, ' ', ''))
        if not na(v)
            array.push(ltRatios, v)

// Collects every enabled range's rungs, then (optionally) merges clusters
// of rungs from 2+ different ranges within ltCfTol % into their average.
// Output is rounded to whole dollars, ascending.
f_macroLadder(_ath) =>
    _rawP = array.new_float(0)
    _rawS = array.new_int(0)
    for s = 0 to 2
        bool  _on = s == 0 ? ltAOn : s == 1 ? ltBOn : ltCOn
        float _lo = s == 0 ? ltALow : s == 1 ? ltBLow : ltCLow
        bool  _au = ltAthAll or (s == 0 ? ltAAuto : s == 1 ? ltBAuto : ltCAuto)
        float _hi = _au ? _ath : (s == 0 ? ltAHigh : s == 1 ? ltBHigh : ltCHigh)
        if _on and not na(_hi) and _hi > _lo
            for r in ltRatios
                float _p = _lo + r * (_hi - _lo)
                if _p > 0
                    array.push(_rawP, _p)
                    array.push(_rawS, s)
    _out = array.new_float(0)
    int _n = array.size(_rawP)
    if _n > 0
        _idx = array.sort_indices(_rawP, order.ascending)
        int _i = 0
        while _i < _n
            float _anchor = array.get(_rawP, array.get(_idx, _i))
            int _j = _i + 1
            while _j < _n
                if math.abs(array.get(_rawP, array.get(_idx, _j)) - _anchor) / _anchor * 100 > ltCfTol
                    break
                _j += 1
            bool _hasA = false
            bool _hasB = false
            bool _hasC = false
            for m = _i to _j - 1
                int _src = array.get(_rawS, array.get(_idx, m))
                _hasA := _hasA or _src == 0
                _hasB := _hasB or _src == 1
                _hasC := _hasC or _src == 2
            int _distinct = (_hasA ? 1 : 0) + (_hasB ? 1 : 0) + (_hasC ? 1 : 0)
            if ltCfMerge and _distinct >= 2
                float _sum = 0.0
                for m = _i to _j - 1
                    _sum += array.get(_rawP, array.get(_idx, m))
                array.push(_out, math.round(_sum / (_j - _i)))
            else
                for m = _i to _j - 1
                    array.push(_out, math.round(array.get(_rawP, array.get(_idx, m))))
            _i := _j
    _out

// Only the last bar consumes pLongTerm (realtime draw blocks and both
// islast tables), so the ladder is built there and left empty on
// historical bars instead of re-running the collect/sort/merge every bar.
pLongTerm = barstate.islast ? f_macroLadder(ltWeeklyAth) : array.new_float(0)

// Tracking arrays
var line[]     set1Lines      = array.new_line(0)
var label[]    set1Labels     = array.new_label(0)
var line[]     set1ShadeLines = array.new_line(0)
var linefill[] set1ShadeFills = array.new_linefill(0)

var line[]  longTermLines  = array.new_line(0)
var label[] longTermLabels = array.new_label(0)
var line[]  midTermLines   = array.new_line(0)
var label[] midTermLabels  = array.new_label(0)

// Display price arrays and respective timeframe Central AXIS
if not barstate.isconfirmed and barstate.isrealtime
    f_clearLines(longTermLines)
    f_clearLabels(longTermLabels)
    f_clearLines(midTermLines)
    f_clearLabels(midTermLabels)
    array.clear(mltOpacityLines)
    array.clear(mltOpacityLabels)
    array.clear(mltOpacityBoxes)
    array.clear(mltOpacityPrices)
    array.clear(mltOpacityBaseColors)
    array.clear(mltOpacityTextColors)

    // Companion pool for this tick's dynamic-opacity ranking — the exact
    // same sources as the Mid/Long-Term Table (Mid-Term + Long-Term
    // targets, plus the Current/Previous-Year Open axis prices when their
    // own toggle is on). mltPctNear/mltPctMid/mltPctFar (declared further
    // down, in the Mid/Long-Term Table inputs) aren't available yet at
    // this point in the script, so every line/label here draws with a
    // neutral placeholder opacity now and gets its real dynamic opacity
    // from the single recolor pass placed after both tables' opacity
    // inputs are declared (see "DYNAMIC OPACITY — FINAL RECOLOR PASS"
    // near the SHORT-TERM Table section). The companion pool itself IS
    // fully known already, so it's captured now into a persistent array
    // for that later pass to reuse.
    array.clear(mltCompanionPricesTracked)
    for y in pMidTerm
        if not na(y)
            array.push(mltCompanionPricesTracked, y)
    for y in pLongTerm
        if not na(y)
            array.push(mltCompanionPricesTracked, y)
    if showCurrentYearlyOpen
        array.push(mltCompanionPricesTracked, yearly_open)
    if showPrevYearlyOpen
        array.push(mltCompanionPricesTracked, prevYearly_open)

    if showLongTerm
        for y in pLongTerm
            f_drawTermLevel(y, globalOffsetMidLong, LongTermColor, LongTermWidth, LongTermColor, 'LT', LongTermColor, size.small, longTermLines, longTermLabels, f_contrastText(LongTermColor))

        // Current-year axis line — unique styling (slight slope, upper-left
        // label), kept as its own block rather than folded into
        // f_drawTermLevel. Color is user-selected via CurrentYearlyOpenColor;
        // opacity (placeholder here, corrected by the later recolor pass)
        // will end up the same dynamic rank-vs-close value as its table row.
        // In Boxes caption mode the label becomes a box caption.
        if showCurrentYearlyOpen
            axisTxt = f_lblText(capBoxMode ? CurrentYearlyOpenColor : f_contrastText(CurrentYearlyOpenColor))
            axisLine = line.new(bar_index, LongTermAxis + 1, bar_index + globalOffsetMidLong, LongTermAxis, extend = extend.left, color = color.new(CurrentYearlyOpenColor, 50), width = MidTermWidth)
            array.push(longTermLines, axisLine)
            [axisStart, axisDot] = f_drawStartMarker(bar_index, LongTermAxis, CurrentYearlyOpenColor)
            array.push(longTermLines, axisStart)
            array.push(longTermLines, axisDot)
            axisCap = str.tostring(LongTermAxis, '⨀Y $' + '0,000') + f_reachedSuffix(LongTermAxis)
            label axisLabel = na
            box   axisBox   = na
            if capBoxMode
                axisBox := f_capBox(bar_index, bar_index + globalOffsetMidLong, LongTermAxis, axisCap, color.new(CurrentYearlyOpenColor, 50), axisTxt, size.small)
            else
                axisLabel := label.new(last_bar_index + globalOffsetMidLong, LongTermAxis, axisCap, style = label.style_label_upper_left, color = color.new(CurrentYearlyOpenColor, 50), textcolor = axisTxt, size = size.small, textalign = text.align_left)
                array.push(longTermLabels, axisLabel)
            array.push(mltOpacityLines, axisLine)
            array.push(mltOpacityLabels, axisLabel)
            array.push(mltOpacityBoxes, axisBox)
            array.push(mltOpacityPrices, LongTermAxis)
            array.push(mltOpacityBaseColors, CurrentYearlyOpenColor)
            array.push(mltOpacityTextColors, axisTxt)

        // Previous-year axis line — same styling pattern as the current-year
        // axis above, distinguished by its own color and label prefix ('⨀PY').
        if showPrevYearlyOpen
            prevAxisTxt = f_lblText(capBoxMode ? PrevYearlyOpenColor : f_contrastText(PrevYearlyOpenColor))
            prevAxisLine = line.new(bar_index, PrevYearlyAxis + 1, bar_index + globalOffsetMidLong, PrevYearlyAxis, extend = extend.left, color = color.new(PrevYearlyOpenColor, 50), width = MidTermWidth)
            array.push(longTermLines, prevAxisLine)
            [prevAxisStart, prevAxisDot] = f_drawStartMarker(bar_index, PrevYearlyAxis, PrevYearlyOpenColor)
            array.push(longTermLines, prevAxisStart)
            array.push(longTermLines, prevAxisDot)
            prevAxisCap = str.tostring(PrevYearlyAxis, '⨀PY $' + '0,000') + f_reachedSuffix(PrevYearlyAxis)
            label prevAxisLabel = na
            box   prevAxisBox   = na
            if capBoxMode
                prevAxisBox := f_capBox(bar_index, bar_index + globalOffsetMidLong, PrevYearlyAxis, prevAxisCap, color.new(PrevYearlyOpenColor, 50), prevAxisTxt, size.small)
            else
                prevAxisLabel := label.new(last_bar_index + globalOffsetMidLong, PrevYearlyAxis, prevAxisCap, style = label.style_label_upper_left, color = color.new(PrevYearlyOpenColor, 50), textcolor = prevAxisTxt, size = size.small, textalign = text.align_left)
                array.push(longTermLabels, prevAxisLabel)
            array.push(mltOpacityLines, prevAxisLine)
            array.push(mltOpacityLabels, prevAxisLabel)
            array.push(mltOpacityBoxes, prevAxisBox)
            array.push(mltOpacityPrices, PrevYearlyAxis)
            array.push(mltOpacityBaseColors, PrevYearlyOpenColor)
            array.push(mltOpacityTextColors, prevAxisTxt)

    if showMidTerm
        for y in pMidTerm
            f_drawTermLevel(y, globalOffsetMidLong, MidTermColor, MidTermWidth, MidTermColor, 'MT', MidTermColor, size.small, midTermLines, midTermLabels, color.white)

    // Set 1 Entry/Target prices join the SHORT-TERM group's companion
    // pool here — their own arrays are only just built above.
    for y in pEventsEntry
        f_pushSecCompanion(y, 1)
    for y in pEventsTarget
        f_pushSecCompanion(y, 3)

    // ENTRY + TARGET EVENTS (SET 1) — label backgrounds from the palette
    // (Entry = colorRed, Target = colorGreen), plus the entry-zone shading
    // (see the 🪙 E N T R Y - Z O N E - S H A D I N G inputs). Entries are
    // [EARLY 1, EARLY 2, EVENT 1, EVENT 2] = indexes 0–3 of pEventsEntry.
    // Each zone is gated by f_zReached on its first level (always true
    // when Shade Only Reached Zones is off).
    f_clearLines(set1Lines)
    f_clearLabels(set1Labels)
    f_clearLines(set1ShadeLines)
    f_clearLinefills(set1ShadeFills)
    if showSet1 and f_eventsVisible(set1DisplayMode, set1ShowSeconds, set1HideSeconds)
        if array.size(pEventsEntry) >= 4
            bool  zGrad  = zShadeStyle == 'Gradient'
            int   zBands = zGrad ? zShadeBands : 1
            int   zStart = bar_index
            int   zEnd   = bar_index + globalOffsetOthers
            float zEarly1 = array.get(pEventsEntry, 0)
            float zEarly2 = array.get(pEventsEntry, 1)
            float zEvent1 = array.get(pEventsEntry, 2)
            float zEvent2 = array.get(pEventsEntry, 3)
            int   zDir    = zEvent2 > zEarly1 ? 1 : -1
            if zShadeE1E2 and f_zReached(zEarly1, zDir)
                f_drawGradientShade(zEarly1, zColE1E2a, zEarly2, zGrad ? zColE1E2b : zColE1E2a, zStart, zEnd, zBands, zShadeTransp, set1ShadeLines, set1ShadeFills)
            if zShadeE2V1 and f_zReached(zEarly2, zDir)
                f_drawGradientShade(zEarly2, zColE2V1a, zEvent1, zGrad ? zColE2V1b : zColE2V1a, zStart, zEnd, zBands, zShadeTransp, set1ShadeLines, set1ShadeFills)
            if zShadeV1V2 and f_zReached(zEvent1, zDir)
                f_drawGradientShade(zEvent1, zColV1V2a, zEvent2, zGrad ? zColV1V2b : zColV1V2a, zStart, zEnd, zBands, zShadeTransp, set1ShadeLines, set1ShadeFills)
        f_drawEventSet(pEventsEntry, pEventsTarget, ulTargetRatios, 2, event_entry_Color, colorRed, event_entry_tColor, event_target_Color, colorGreen, event_target_tColor, globalOffsetOthers, LongTermWidth, set1Lines, set1Labels)

////////////////////////////////////////////
////    END ENTRY / TARGET EVENTS        ///
////////////////////////////////////////////


////////////////////////////////////////////////////////////
////        B U Y / S E L L   S I G N A L S              ///
////////////////////////////////////////////////////////////
// Follows the Set 1 Fibonacci gauge level by level as price travels from
// the 0% anchor outward (0% → 100% → 125 / 160 / 200%):
//   40%  EARLY ENTRY #1 — BUY, risky  (Early Entry color, orange)
//   50%  EARLY ENTRY #2 — BUY, risky  (Early Entry color, orange)
//   60%  ENTRY EVENT #1 — BUY, safer  (Entry Event color, green)
//   100% ENTRY EVENT #2 — BUY, safer  (Entry Event color, green)
//   125% / 160% / 200% — SELL at TP1 / TP2 / TP3 (SELL color, red)
// There are no SELL signals at or inside the 100% level — SELLs exist only
// on the three extension targets.
// A level fires on the candle whose wick first reaches it AFTER the end
// of the last confirmed leg (its leg-end pivot candle). Its label sits
// just LEFT of that candle, its pointer touching the candle at exactly
// the level's price (40% / 50% / 60% / 100% / 125% / 160% / 200%), so
// the label body only spans earlier candles and never covers the candles
// that follow. Each level fires once per confirmed leg; a candle that
// reaches several levels labels every one of them, each at its own price.
// BUY: Entry = the level price. SL = the entry pulled back toward 0% by
// SL Distance (% of the leg). TP1–TP3 = the 125/160/200% target lines,
// each with its own R:R. SELL: exit price plus the result and R:R of
// every entry level.
// Signal Strength %: BUY = tier base 30/40/55/65 + R:R to TP1 (≤15) +
// volume vs its 20-bar average (≤10) + candle closed through the level
// (≤10). SELL = target base 50/60/70 + volume (≤10) + close through the
// target (≤10) + candle body in the travel direction (≤10). Capped at 100.
// Non-Repainting ON: a leg is used only once it was confirmed at a
// previous candle's close; levels price reached before that are skipped,
// so no label is ever painted into the past. OFF: those levels are
// back-filled onto the exact candles that reached them as soon as the leg
// confirms (labels then appear after the fact).
// Candle-Close Confirmation: signals are processed on closed candles only
// (OFF = live preview that can vanish before the close).
// History: a "set" = every signal from one confirmed leg; only the newest
// N sets stay on the chart (default 1 = current leg only).
sigGroup        = '🪙 B U Y / S E L L - S I G N A L S'
sigShow         = input.bool(true, 'Show BUY/SELL Signals', group = sigGroup, tooltip = 'BUY labels on the gauge entry levels (40% / 50% early entries, 60% / 100% entry events) and SELL labels on the 125% / 160% / 200% targets, each placed just left of the candle that reached the level so it never covers the following candles. Independent of the Set 1 Plot toggle. Hover a label for Entry, SL, TP, Risk:Reward and Signal Strength.')
sigTypes        = input.string('Early + Entry', 'BUY Signals', options = ['Early + Entry', 'Entry Only', 'Early Only'], group = sigGroup, tooltip = 'Early = EARLY ENTRY #1 (40%) / #2 (50%): risky.\nEntry = ENTRY EVENT #1 (60%) / #2 (100%): safer.')
sigShowSell     = input.bool(true, 'SELL Signals At Targets (125 / 160 / 200%)', group = sigGroup, tooltip = 'SELL (take-profit) labels on the candles that reach the 125%, 160% and 200% targets.')
sigNoRepaint    = input.bool(true, 'Non-Repainting', inline = 'sigrp', group = sigGroup)
sigCloseConfirm = input.bool(true, 'Candle-Close Confirmation', inline = 'sigrp', group = sigGroup, tooltip = 'Non-Repainting ON: a leg is used only after it was confirmed at a previous candle\'s close; levels reached before that are skipped, so labels never appear in the past. OFF: those levels are back-filled onto the exact candles that reached them once the leg confirms.\nCandle-Close Confirmation: labels print only once the candle closes. OFF = live preview that may vanish before the close.')
sigSlPct        = input.float(25.0, 'SL Distance (% of Leg)', minval = 1.0, maxval = 100.0, step = 1.0, group = sigGroup, tooltip = 'SL sits behind each entry level (toward the 0% anchor) by this % of the confirmed leg\'s length.')
sigKeepSets     = input.int(1, 'History Sets To Keep', minval = 1, maxval = 10, group = sigGroup, tooltip = 'A set = every BUY/SELL label from one confirmed zigzag leg. Only the newest N sets stay on the chart (1 = current leg only, 2 = current leg + the previous one).')
sigEarlyColor   = input.color(color.rgb(255, 152, 0), 'Early Entry', inline = 'sigcol', group = sigGroup)
sigEventColor   = input.color(color.rgb(0, 200, 120), 'Entry Event', inline = 'sigcol', group = sigGroup)
sigSellColor    = input.color(color.rgb(235, 50, 60), 'SELL', inline = 'sigcol', group = sigGroup, tooltip = 'Early Entry = BUY at 40% / 50% (risky). Entry Event = BUY at 60% / 100% (safer). SELL = take profit at 125% / 160% / 200%.')
sigTextColor    = input.color(color.white, 'Text', inline = 'sigsz', group = sigGroup)
sigSizeRaw      = input.string('Small', 'Size', options = ['Tiny', 'Small', 'Normal', 'Large'], inline = 'sigsz', group = sigGroup)
sigSize         = sigSizeRaw == 'Tiny' ? size.tiny : sigSizeRaw == 'Normal' ? size.normal : sigSizeRaw == 'Large' ? size.large : size.small

// Last-confirmed-leg anchors as series (same anchors as f_ulLevels), plus
// the leg-end pivot's time — the leg ID (it changes whenever a new pivot
// confirms the next leg) and the left limit for every signal label.
float ulSigP0   = na
float ulSigP100 = na
float ulSigLeg  = na
if ulZ.size() >= 6
    ulSigP0   := ulInvert ? ulZ.get(4) : ulZ.get(2)
    ulSigP100 := ulInvert ? ulZ.get(2) : ulZ.get(4)
    ulSigLeg  := ulZ.get(3)

float sigP0     = sigNoRepaint ? ulSigP0[1]   : ulSigP0
float sigP100   = sigNoRepaint ? ulSigP100[1] : ulSigP100
float sigLeg    = sigNoRepaint ? ulSigLeg[1]  : ulSigLeg
float sigVolAvg = ta.sma(volume, 20)

// Gauge levels 0–6: 40 / 50 / 60 / 100% entries, then 125 / 160 / 200%
// targets — the same ratio arrays that draw the Set 1 lines.
var sigRatios = array.concat(array.copy(ulEntryRatios), array.copy(ulTargetRatios))
var sigNames  = array.from('EARLY ENTRY #1', 'EARLY ENTRY #2', 'ENTRY EVENT #1', 'ENTRY EVENT #2', 'TP1', 'TP2', 'TP3')
var sigBase   = array.from(30, 40, 55, 65, 50, 60, 70)
var sigFired  = array.new_bool(7, false)   // level already reached on this leg
var sigState  = array.new_int(2, 0)        // [0] history set id · [1] 1 = this leg opened its set
var float   sigLegCur = na
var label[] sigLabels = array.new_label(0)
var int[]   sigSets   = array.new_int(0)

// Price of gauge level _k on the leg _p0 → _p100, rounded exactly like the
// plotted Set 1 lines (f_ulLevels).
f_sigLvl(float _p0, float _p100, int _k) =>
    math.round(_p0 + (_p100 - _p0) * array.get(sigRatios, _k))

// Level _k allowed by the BUY / SELL type inputs.
f_sigAllowed(int _k) =>
    _k < 2 ? sigTypes != 'Entry Only' : _k < 4 ? sigTypes != 'Early Only' : sigShowSell

// Marks every not-yet-reached level this candle's wick reaches (travel
// direction _d) and returns the indexes of the allowed ones, shallowest
// first.
f_sigScan(float _p0, float _p100, int _d, float _h, float _l) =>
    _out = array.new_int(0)
    for k = 0 to 6
        float _lvl = f_sigLvl(_p0, _p100, k)
        if not array.get(sigFired, k) and (_d == 1 ? _h >= _lvl : _l <= _lvl)
            array.set(sigFired, k, true)
            if f_sigAllowed(k)
                array.push(_out, k)
    _out

// Builds the label for gauge level _k on bar _bar from that candle's OHLCV.
// style_label_right: the label body sits to the LEFT of _bar with its
// pointer on the level price, so it never covers the following candles.
f_sigLabel(int _bar, int _k, float _p0, float _p100, float _o, float _h, float _l, float _c, float _v, float _vAvg) =>
    int    _d        = _p100 > _p0 ? 1 : -1
    float  _risk     = math.abs(_p100 - _p0) * sigSlPct / 100.0
    float  _lvl      = f_sigLvl(_p0, _p100, _k)
    float  _rng      = _h - _l
    float  _volPts   = na(_v) or na(_vAvg) or _vAvg <= 0 ? 0.0 : 10.0 * math.min(math.max(_v / _vAvg - 1.0, 0.0), 1.0)
    float  _closePts = (_c - _lvl) * _d > 0 ? 10.0 : 0.0
    int    _base     = array.get(sigBase, _k)
    string _nm       = array.get(sigNames, _k)
    string _pct      = str.tostring(math.round(array.get(sigRatios, _k) * 100)) + '%'
    string _conf     = (sigCloseConfirm ? 'Confirmed on candle close' : 'Live: unconfirmed until candle close') + ' · ' + (sigNoRepaint ? 'Non-repainting' : 'Back-filled on the reaching candle')
    bool   _buy      = _k < 4
    string _txt      = ''
    string _tip      = ''
    color  _col      = sigSellColor
    if _buy
        bool   _early = _k < 2
        float  _sl    = _lvl - _d * _risk
        string _tps   = ''
        float  _rr1   = na
        for t = 4 to 6
            float _tp = f_sigLvl(_p0, _p100, t)
            float _rw = (_tp - _lvl) * _d
            float _rr = _rw / _risk
            if na(_rr1)
                _rr1 := _rr
            _tps += 'TP' + str.tostring(t - 3) + ' 🎯' + str.tostring(math.round(array.get(sigRatios, t) * 100)) + '%: ' + str.tostring(_tp, '$0,000') + '  (+' + str.tostring(_rw, '$0,000') + ' · R:R 1 : ' + str.tostring(_rr, '0.00') + ')\n'
        float _rrPts = 15.0 * math.min(_rr1, 3.0) / 3.0
        int   _str   = math.min(100, math.round(_base + _rrPts + _volPts + _closePts))
        _col := _early ? sigEarlyColor : sigEventColor
        _txt := 'BUY ' + (_early ? '⚠' : '✔') + '\n' + _nm
        _tip := '🟢 BUY — ' + _nm + ' (' + _pct + ')\n' +
             (_early ? '⚠️ RISKY ENTRY — shallow gauge level, the move isn\'t confirmed yet. Consider a smaller size.' : '✅ SAFER ENTRY — deeper gauge level, more confirmation behind the move.') +
             '\n──────────\n' +
             'Entry: ' + str.tostring(_lvl, '$0,000') + '  (' + _pct + ' level)\n' +
             'SL: ' + str.tostring(_sl, '$0,000') + '  (risk ' + str.tostring(_risk, '$0,000') + ')\n' + _tps +
             'Signal Strength: ' + str.tostring(_str) + '%\n' +
             '   tier ' + str.tostring(_base) + ' + R:R ' + str.tostring(math.round(_rrPts)) + ' + volume ' + str.tostring(math.round(_volPts)) + ' + close ' + str.tostring(math.round(_closePts)) +
             '\n──────────\n' + _conf
    else
        float  _bodyPts = _rng > 0 and (_c - _o) * _d > 0 ? 10.0 * math.abs(_c - _o) / _rng : 0.0
        int    _str     = math.min(100, math.round(_base + _volPts + _closePts + _bodyPts))
        string _gains   = ''
        for e = 0 to 3
            float _en = f_sigLvl(_p0, _p100, e)
            float _g  = (_lvl - _en) * _d
            _gains += '   ' + array.get(sigNames, e) + ' ' + str.tostring(_en, '$0,000') + ' → +' + str.tostring(_g, '$0,000') + ' · R:R 1 : ' + str.tostring(_g / _risk, '0.00') + '\n'
        string _next = _k < 6 ? 'Next target: TP' + str.tostring(_k - 2) + ' ' + str.tostring(f_sigLvl(_p0, _p100, _k + 1), '$0,000') : 'Final target of the gauge'
        _txt := 'SELL 🎯\n' + _nm + ' ' + _pct
        _tip := '🔴 SELL — ' + _nm + ' 🎯' + _pct + '\nTake profit: price reached the ' + _pct + ' target of the gauge.\n──────────\n' +
             'Exit: ' + str.tostring(_lvl, '$0,000') + '\n' +
             'Result per entry (SL ' + str.tostring(sigSlPct, '0.#') + '% of leg behind each entry):\n' + _gains +
             _next + '\n' +
             'Signal Strength: ' + str.tostring(_str) + '%\n' +
             '   target ' + str.tostring(_base) + ' + volume ' + str.tostring(math.round(_volPts)) + ' + close ' + str.tostring(math.round(_closePts)) + ' + body ' + str.tostring(math.round(_bodyPts)) +
             '\n──────────\n' + _conf
    label.new(_bar, _lvl, _txt, yloc = yloc.price, style = label.style_label_right, color = _col, textcolor = sigTextColor, size = sigSize, textalign = text.align_right, tooltip = _tip)

// Registers a signal label in the current leg's history set and keeps only
// the newest sigKeepSets sets on the chart.
f_sigPush(label _lb) =>
    if array.get(sigState, 1) == 0
        array.set(sigState, 0, array.get(sigState, 0) + 1)
        array.set(sigState, 1, 1)
    int _set = array.get(sigState, 0)
    array.push(sigLabels, _lb)
    array.push(sigSets, _set)
    while array.size(sigSets) > 0 and array.get(sigSets, 0) <= _set - sigKeepSets
        label.delete(array.shift(sigLabels))
        array.shift(sigSets)

bool sigBuy  = false
bool sigSell = false
if sigShow and not na(sigLeg) and not na(sigP0) and not na(sigP100) and sigP100 != sigP0 and (not sigCloseConfirm or barstate.isconfirmed)
    int sigDir = sigP100 > sigP0 ? 1 : -1
    // New confirmed leg: reset, then walk the candles between its leg-end
    // pivot (excluded) and this one, oldest first. Levels reached there are retired; with
    // Non-Repainting OFF they're also labeled on the candle that reached them.
    if na(sigLegCur) or sigLeg != sigLegCur
        sigLegCur := sigLeg
        array.set(sigState, 1, 0)
        array.fill(sigFired, false)
        int sigBack = 0
        while sigBack < 4998 and not na(time[sigBack + 1]) and time[sigBack + 1] > sigLeg
            sigBack += 1
        if sigBack > 0
            for i = sigBack to 1
                firedPast = f_sigScan(sigP0, sigP100, sigDir, high[i], low[i])
                if not sigNoRepaint
                    for k in firedPast
                        f_sigPush(f_sigLabel(bar_index - i, k, sigP0, sigP100, open[i], high[i], low[i], close[i], volume[i], sigVolAvg[i]))
    // Current candle.
    firedNow = f_sigScan(sigP0, sigP100, sigDir, high, low)
    for k in firedNow
        f_sigPush(f_sigLabel(bar_index, k, sigP0, sigP100, open, high, low, close, volume, sigVolAvg))
        if k < 4
            sigBuy := true
            alert('BUY — ' + array.get(sigNames, k) + ' @ ' + str.tostring(f_sigLvl(sigP0, sigP100, k), '$0,000') + (k < 2 ? ' (risky early entry)' : ' (safer entry event)'), sigCloseConfirm ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
        else
            sigSell := true
            alert('SELL — ' + array.get(sigNames, k) + ' target @ ' + str.tostring(f_sigLvl(sigP0, sigP100, k), '$0,000'), sigCloseConfirm ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)

alertcondition(sigBuy,  'BUY SIGNAL',  'BUY signal on a Set 1 entry level (40/50/60/100%).')
alertcondition(sigSell, 'SELL SIGNAL', 'SELL signal on a Set 1 target (125/160/200%).')

////////////////////////////////////////////////////////////
////    END  B U Y / S E L L   S I G N A L S             ///
////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////
//      R A N D O M / R E F E R E N C E  P R I C E S     ///
////////////////////////////////////////////////////////////
// Two fully independent manual levels (ref1Group, ref2Group), each with
// its own price, color, width, line style, start mode, and alert
// distance — unlike the other subsystems, these aren't driven by a
// comma-separated price list. A level with price input left at 0.0
// is treated as "unset" (ref#Price becomes na) and f_drawRefLevel/the
// alertcondition below both no-op for it. Alert conditions live in global
// scope (outside the realtime-only draw block) so they still evaluate on
// confirmed bars, not just while a level is visibly drawn.

// --- GLOBAL SETTINGS FOR REFERENCE LEVELS ---
refGlobalGroup = '🪙 R E F E R E N C E - P R I C E - L E V E L S'
refBarsBackDays  = input.int(14, 'Start N days in the past', minval = 1, maxval = 60, group = refGlobalGroup, tooltip = 'The anchor point (in days back) a Fixed-mode Reference Level line extends left from — the line itself continues indefinitely past this point. Also the fallback (and the search range for ↤Candle/Pivot modes) if a level\'s Pivot/↤Candle mode has nothing to latch onto yet.')
refPivotLookback = input.int(5, 'Pivot Lookback (bars each side)', minval = 5, maxval = 100, group = refGlobalGroup, tooltip = 'Bars required on each side of a swing high/low for it to count as a confirmed pivot. Only used by levels set to Pivot mode.')
refPivotPriceTolerance = input.float(250.0, 'Pivot Price Tolerance ($)', minval = 1.0, maxval = 100000.0, group = refGlobalGroup, tooltip = 'When a level\'s Line Start Mode is Pivot, only a confirmed swing high/low priced within this many dollars of the level\'s own price counts as a match for its start bar.')

// constant default for the per-level Alert Distance input
const float refAlertDefaultConst  = 250.0

// Convert days to bars for the current chart timeframe — see f_periodBars
// above (declared in the 🪙 R E A C H E D   M A R K E R section near the
// top of the script) for why this is timeframe-in-seconds-based rather
// than a raw minutes-multiplier formula, and why it's capped at 4999.
refBarsBack = f_periodBars(refBarsBackDays)

// Confirmed swing pivot series (high or low). ta.pivothigh/pivotlow only
// return a non-na value on the bar where a pivot gets CONFIRMED — i.e.
// refPivotLookback bars after the actual swing extreme — and that
// returned value is the swing's own price. Indexing pivotHigh[i]/pivotLow[i]
// lets f_nearestPivotBar below walk back through every historical
// confirmation without maintaining a separate array.
pivotHigh = ta.pivothigh(high, refPivotLookback, refPivotLookback)
pivotLow  = ta.pivotlow(low, refPivotLookback, refPivotLookback)

// Scans backward through confirmed swing pivots (high and low) for the
// most recent one whose own price fell within _tolerance dollars of
// _price — unlike a plain "nearest in time" pivot, this only matches a
// pivot that also sits near the level's own price. Confirmation bar i
// corresponds to a swing that actually formed refPivotLookback bars
// earlier, so the returned bar is offset back by that lookback. Falls
// back to na (caller then uses the fixed bars-back default) if nothing
// within tolerance is found in the search window.
f_nearestPivotBar(_price, _tolerance, _maxBarsBack) =>
    int _bar = na
    if not na(_price)
        for i = 0 to _maxBarsBack - 1
            ph = pivotHigh[i]
            pl = pivotLow[i]
            if not na(ph) and math.abs(ph - _price) <= _tolerance
                _bar := bar_index - i - refPivotLookback
                break
            if not na(pl) and math.abs(pl - _price) <= _tolerance
                _bar := bar_index - i - refPivotLookback
                break
    _bar

// Scans left bar-by-bar from the current bar for the first one whose
// open/close body contains _price — i.e. the nearest candle that would
// visually "obstruct" a horizontal line at that price. Unlike the pivot
// search (chart-structure based, shared across levels), this is specific
// to each level's own price. Falls back to the fixed bars-back count if
// nothing obstructs within the search window. Wicks are ignored — only a candle's
// open/close body counts as an obstruction.
f_nearestObstructionBar(_price, _maxBarsBack) =>
    int _bar = bar_index - _maxBarsBack
    if not na(_price)
        for i = 1 to _maxBarsBack
            bodyTop = math.max(open[i], close[i])
            bodyBottom = math.min(open[i], close[i])
            if bodyBottom <= _price and bodyTop >= _price
                _bar := bar_index - i
                break
    _bar

// Resolves a level's own Line Start Mode into an absolute start bar.
// Only runs the scan its own mode actually needs — f_nearestPivotBar and
// f_nearestObstructionBar can each walk thousands of bars (refBarsBack),
// so computing a scan whose result is then discarded would be pure waste
// on every realtime tick.
f_refStartBar(_price, _mode) =>
    int _result = bar_index - refBarsBack
    if _mode == 'Pivot'
        pivotBar = f_nearestPivotBar(_price, refPivotPriceTolerance, refBarsBack)
        _result := na(pivotBar) ? bar_index - refBarsBack : pivotBar
    else if _mode == '↤Candle'
        _result := f_nearestObstructionBar(_price, refBarsBack)
    _result

// --- PER LEVEL INPUTS (UP TO 2) ---
// Each level's inputs are grouped onto inline rows: Price/Desc keep
// their own lines (long text fields don't compress well); Color+Width+
// Style share one row; Start Mode and Alert Distance get their own rows.
ref1Group = '🪙 R E F E R E N C E - L E V E L - [ Ⅰ ]'
ref1PriceInput   = input.float(0.0, 'Price Level 1', tooltip = 'Manual price for this level. Leave at 0.0 to disable/hide it.', group = ref1Group)
ref1Desc         = input.string('', 'Description (above label)', tooltip = "Optional short text shown just above the level's price label.", group = ref1Group)
ref1Price        = ref1PriceInput == 0.0 ? na : ref1PriceInput
ref1Color        = input.color(color.rgb(255, 0, 0), 'Color', inline = 'r1a', tooltip = "Color used for this level's line, start marker, and price label.", group = ref1Group)
ref1Width        = input.int(2, 'Width', minval = 1, maxval = 10, inline = 'r1a', tooltip = 'Line thickness for this level.', group = ref1Group)
ref1Style        = input.string('Solid', 'Style', options = ['Solid', 'Dotted', 'Dashed'], inline = 'r1a', tooltip = 'Line style used to draw this level.', group = ref1Group)
ref1StartMode    = input.string('↤Candle', 'Line Start Mode', options = ['Fixed', 'Pivot', '↤Candle'], inline = 'r1a2', tooltip = 'How the line\'s left side behaves. Fixed: extends indefinitely left, anchored past the global "Start N days in the past" point. Pivot: stops at the nearest confirmed swing high/low priced within the global Pivot Price Tolerance of this level\'s own price. ↤Candle: stops exactly at the nearest bar to the left whose candle BODY (open/close, not the wick) touches this level\'s price.', group = ref1Group)
ref1AlertDist    = input.float(refAlertDefaultConst, 'Alert Dist ($)', minval = 1.0, maxval = 100000.0, inline = 'r1b', tooltip = 'Triggers the proximity alert when price comes within this many dollars of the level.', group = ref1Group)

ref2Group = '🪙 R E F E R E N C E - L E V E L - [ Ⅱ ]'
ref2PriceInput   = input.float(0.0, 'Price Level 2', tooltip = 'Manual price for this level. Leave at 0.0 to disable/hide it.', group = ref2Group)
ref2Desc         = input.string('', 'Description (above label)', tooltip = "Optional short text shown just above the level's price label.", group = ref2Group)
ref2Price        = ref2PriceInput == 0.0 ? na : ref2PriceInput
ref2Color        = input.color(color.rgb(255, 0, 0), 'Color', inline = 'r2a', tooltip = "Color used for this level's line, start marker, and price label.", group = ref2Group)
ref2Width        = input.int(2, 'Width', minval = 1, maxval = 10, inline = 'r2a', tooltip = 'Line thickness for this level.', group = ref2Group)
ref2Style        = input.string('Solid', 'Style', options = ['Solid', 'Dotted', 'Dashed'], inline = 'r2a', tooltip = 'Line style used to draw this level.', group = ref2Group)
ref2StartMode    = input.string('↤Candle', 'Line Start Mode', options = ['Fixed', 'Pivot', '↤Candle'], inline = 'r2a2', tooltip = 'How the line\'s left side behaves. Fixed: extends indefinitely left, anchored past the global "Start N days in the past" point. Pivot: stops at the nearest confirmed swing high/low priced within the global Pivot Price Tolerance of this level\'s own price. ↤Candle: stops exactly at the nearest bar to the left whose candle BODY (open/close, not the wick) touches this level\'s price.', group = ref2Group)
ref2AlertDist    = input.float(refAlertDefaultConst, 'Alert Dist ($)', minval = 1.0, maxval = 100000.0, inline = 'r2b', tooltip = 'Triggers the proximity alert when price comes within this many dollars of the level.', group = ref2Group)

// --- SHADING BETWEEN REFERENCE LEVELS ---
// The 1↔2 gap has its own on/off switch. The gradient blends the two
// levels' own colors — see f_drawGradientShade above. Reference Levels
// are Constant-visibility only (no blink mode), so the shade simply draws
// whenever its toggle is on and both levels have a price set.
refShadeGroup = '🪙 R E F E R E N C E - L E V E L - S H A D I N G'
shade12Enable = input.bool(false, 'Shade Ref Ⅰ ↔ Ref Ⅱ', tooltip = "Fills the price gap between these two reference levels with a color gradient blended from their own colors.", group = refShadeGroup)
shadeBands = input.int(20, 'Gradient Smoothness (Bands)', minval = 2, maxval = 50, group = refShadeGroup, tooltip = 'More bands = smoother gradient, but each band uses 2 lines + 1 linefill from the shared 500-object budget.')
shadeTransparency = input.int(85, 'Shade Transparency', minval = 50, maxval = 95, group = refShadeGroup, tooltip = 'Higher = more see-through shading. Lower = more opaque.')

// --- STORAGE ARRAYS FOR CLEAN REDRAW / BLINKING ---
var line[]  refLines  = array.new_line()
var label[] refLabels = array.new_label()

var line[]     shadeLines = array.new_line(0)
var linefill[] shadeFills = array.new_linefill(0)

// --- DRAW / UPDATE REFERENCE LEVELS ---
if not barstate.isconfirmed and barstate.isrealtime
    f_clearLines(refLines)
    f_clearLabels(refLabels)

    // The last of the two contributions to the SHORT-TERM group's
    // dynamic-opacity companion pool — see the matching pushes in the
    // Set 1 Entry/Target section above.
    f_pushSecCompanion(ref1Price, 7)
    f_pushSecCompanion(ref2Price, 7)

    // Each level resolves its own start bar from its own Line Start Mode.
    ref1StartBar  = f_refStartBar(ref1Price,  ref1StartMode)
    ref2StartBar  = f_refStartBar(ref2Price,  ref2StartMode)

    f_drawRefLevel(ref1Price, ref1Desc, ref1Color, ref1Width, ref1Style, globalOffsetRef, ref1StartBar, ref1StartMode == 'Fixed', refLines, refLabels)
    f_drawRefLevel(ref2Price, ref2Desc, ref2Color, ref2Width, ref2Style, globalOffsetRef, ref2StartBar, ref2StartMode == 'Fixed', refLines, refLabels)

    // --- GRADIENT SHADING BETWEEN THE TWO REFERENCE LEVELS ---
    f_clearLines(shadeLines)
    f_clearLinefills(shadeFills)

    // The shade spans from the earlier (smaller bar_index) of its two
    // boundary levels' own start bars, so it never gets clipped short by
    // whichever boundary level has the tighter Line Start Mode result.
    if shade12Enable
        f_drawGradientShade(ref1Price, ref1Color, ref2Price, ref2Color, math.min(ref1StartBar, ref2StartBar), bar_index + globalOffsetRef, shadeBands, shadeTransparency, shadeLines, shadeFills)

// --- ALERT CONDITIONS (GLOBAL SCOPE, CONST MESSAGES) ---
bool ref1Approach = not na(ref1Price) and math.abs(close - ref1Price) <= ref1AlertDist
bool ref2Approach = not na(ref2Price) and math.abs(close - ref2Price) <= ref2AlertDist

alertcondition(ref1Approach, 'REF LEVEL 1 APPROACH', 'Price is near Reference Level 1.')
alertcondition(ref2Approach, 'REF LEVEL 2 APPROACH', 'Price is near Reference Level 2.')


////////////////////////////////////////////////////////////
////            T A B L E   L A Y O U T                  ///
////////////////////////////////////////////////////////////
// Controls shared by BOTH summary tables.
//   - Column Order: swaps the NOW and ✓ columns of the two separate
//     tables (TARGET always stays in the center).
//   - Merge Both Tables: replaces the two separate tables with ONE table
//     holding a single NOW column (placed on the chosen side), both
//     TARGET columns side by side in the center, and each ladder's own ✓
//     column on its outer edge. The two ladders are vertically offset so
//     that each one's NOW row lands on the SAME table row, and that
//     single NOW cell shows both distances (M/L and S/T) around the
//     current price. A ladder whose own "Show Table" toggle is off is
//     left out of the merged table. The merged table borrows its title
//     and NOW-column backgrounds from the Mid/Long-Term table settings,
//     and each ladder keeps its own header color and opacity settings.
tblLayoutGroup      = '🪙 T A B L E - L A Y O U T'
tblColumnOrder      = input.string('NOW | TARGET | ✓', 'Column Order (Separate Tables)', options = ['NOW | TARGET | ✓', '✓ | TARGET | NOW'], group = tblLayoutGroup, tooltip = 'Swaps the NOW and ✓ columns of both separate tables. TARGET always stays in the center. In Horizontal orientation this swaps the NOW and ✓ rows instead.')
tblMerge            = input.bool(false, 'Merge Both Tables Into One', group = tblLayoutGroup, tooltip = 'Replaces the Mid/Long-Term and SHORT-TERM tables with one table: a single NOW column, both TARGET columns side by side, and each ladder\'s ✓ column on its outer edge. Both NOW values are aligned on the same row.')
tblMergedNowSide    = input.string('Left / Top', 'Merged NOW Column Side', options = ['Left / Top', 'Right / Bottom', 'Split (M/L Left · S/T Right)'], group = tblLayoutGroup, tooltip = 'Left/Top or Right/Bottom: one combined NOW column on that side of the merged table (Left/Right in Vertical, Top/Bottom in Horizontal).\nSplit: each ladder gets its own NOW column hugging its TARGET column — the Mid/Long-Term NOW to the left (top) of the TARGET prices and the SHORT-TERM NOW to the right (bottom). Both stay aligned on the same row.')
tblMergedTitle      = input.string('MID/LONG + SHORT-TERM', 'Merged Table Title', group = tblLayoutGroup, tooltip = 'Title shown in the merged table\'s top row.')
tblMergedOrient     = input.string('Vertical', 'Merged Orientation', options = ['Vertical', 'Horizontal'], group = tblLayoutGroup, tooltip = 'Vertical: columns are NOW/✓/TARGET and each price is a row. Horizontal: those become rows and each price is a column.')
tblMergedPosRaw     = input.string('Top Right', 'Merged Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = tblLayoutGroup, tooltip = 'Corner/edge of the chart pane the merged table is anchored to.')
tblMergedSizeRaw    = input.string('Small', 'Merged Text Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = tblLayoutGroup, tooltip = 'Base font size of the merged table (far-rank rows still drop to tiny).')

////////////////////////////////////////////////////////////
////              P I X E L   D I A L S                   ///
////////////////////////////////////////////////////////////
// Optional display mode for both summary tables — see LEVEL PIXEL DIALS
// at the end of the script for how the dials are built.
ldGroup       = '🪙 P I X E L - D I A L S'
ldMode        = input.string('Pixel Dials', 'Summary Display', options = ['Tables', 'Pixel Dials'], group = ldGroup, tooltip = 'Tables: the classic Mid/Long-Term and SHORT-TERM tables (or the merged table).\nPixel Dials: each table becomes a round pixel dial instead — the level closest to the current price at 🕛, the nearest levels below it on the left side of the scale and the nearest above it on the right (how many is set by Levels Below / Above), and a needle showing the current price within that scale. The scale re-centers once per 1D candle (SHORT-TERM) / 1W candle (MID/LONG) by default, or live — see the two Scale Refresh inputs. Both dials sit side by side in one panel at Dials Position (order set by Dial Order — SHORT-TERM left by default); each dial follows its own table\'s Show Table toggle and Table Title.')
ldPosRaw      = input.string('Bottom Right', 'Dials Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = ldGroup, tooltip = 'Screen position of the dial panel (both dials side by side, in the order set by Dial Order). Pick a spot not used by another table — two tables in the same position draw on top of each other.')
ldRefreshST   = input.string('Every 1D', 'Scale Refresh — SHORT-TERM', options = ['Live', 'Every 1D'], group = ldGroup, tooltip = 'SHORT-TERM dial only.\nEvery 1D (default): the scale is a snapshot taken when each Daily candle opens and kept until the next one, so it never shifts under the needle; if price moves past the outer levels in between, the needle pegs at the end of the scale.\nLive: the scale is rebuilt on every tick, so the 🕛 position always holds the level closest to the current price and the scale re-centers as soon as price gets closer to another level.')
ldRefreshML   = input.string('Every 1W', 'Scale Refresh — MID/LONG', options = ['Live', 'Every 1W'], group = ldGroup, tooltip = 'MID/LONG dial only.\nEvery 1W (default): the scale is a snapshot taken when each Weekly candle opens and kept until the next one, so it never shifts under the needle; if price moves past the outer levels in between, the needle pegs at the end of the scale.\nLive: the scale is rebuilt on every tick, so the 🕛 position always holds the level closest to the current price.')
ldOrder       = input.string('SHORT-TERM | MID/LONG', 'Dial Order', options = ['SHORT-TERM | MID/LONG', 'MID/LONG | SHORT-TERM'], group = ldGroup, tooltip = 'Which dial sits on the left of the panel. Default: SHORT-TERM on the left, Mid/Long-Term on the right.')
ldPxW         = input.float(0.15, 'Pixel Width (% of chart)', minval = 0.05, maxval = 5.0, step = 0.05, inline = 'ldpx', group = ldGroup)
ldPxH         = input.float(0.3, 'Height', minval = 0.05, maxval = 10.0, step = 0.05, inline = 'ldpx', group = ldGroup, tooltip = 'Size of each dial pixel as a % of the chart pane width / height. Adjust the two together until the dials look round on your screen (wide monitors need a smaller width than height).')
ldScale       = input.float(1.0, 'Dial Size (×)', minval = 0.25, maxval = 5.0, step = 0.05, group = ldGroup, tooltip = 'Scales Pixel Width and Height together, so both dials grow or shrink without changing shape.')
ldNeedleCol   = input.color(color.white, 'Needle', inline = 'ldn', group = ldGroup)
ldNeedleW     = input.int(2, 'Thickness', minval = 1, maxval = 10, inline = 'ldn', group = ldGroup, tooltip = 'Needle color and thickness. The center hub grows with the thickness.\nThe needle color is used by the Custom theme only — a preset Dial Color Theme supplies its own needle color.')
ldBullDark    = input.color(color.rgb(0, 80, 40), 'Arc Above 🕛  Dark', inline = 'ldbu', group = ldGroup)
ldBullBright  = input.color(color.rgb(0, 255, 100), 'Bright', inline = 'ldbu', group = ldGroup, tooltip = 'Lit arc between the 🕛 level and the needle while price is above that level: fades from Dark at 🕛 to Bright at the end of the scale.')
ldBearDark    = input.color(color.rgb(90, 0, 0), 'Arc Below 🕛  Dark', inline = 'ldbe', group = ldGroup)
ldBearBright  = input.color(color.rgb(255, 40, 40), 'Bright', inline = 'ldbe', group = ldGroup, tooltip = 'Lit arc between the 🕛 level and the needle while price is below that level.')
ldFaceColor   = input.color(color.new(color.black, 35), 'Dial Face', group = ldGroup, tooltip = 'Fill color of the round dial face.\nCustom theme only — a preset Dial Color Theme supplies its own face color.')
ldTheme       = input.string('Aircraft Instrument', 'Dial Color Theme', options = ['Custom', 'Beige VU Meter', 'Aircraft Instrument', 'Volkswagen Tacho', 'Racing White Face', 'Amber Night', 'Marine Brass', 'Night Vision Green'], group = ldGroup, tooltip = 'Color palette for both level dials (same palettes as CQ_(7)_[TACHIMETER]): face, needle and hub, unlit ring, the M/L · S/T caption and inside 🕛 label, the tone the level price labels are blended toward (see Price Label Brightness), and the title / info row text.\nCustom: uses the Dial Face, Needle and Info Row Text inputs (labels blend toward white).\nBeige VU Meter: cream face, dark brown numbers, black needle.\nAircraft Instrument: matte black face, white numbers and needle.\nVolkswagen Tacho: black face, blue-lit numbers, red needle.\nRacing White Face: white face, black numbers, red needle.\nAmber Night: dark face with amber backlit numbers and needle.\nMarine Brass: navy face with brass numbers and cream needle.\nNight Vision Green: dark face with green NVG-style numbers.\nThe lit arc keeps the Arc Above / Below 🕛 colors.')
ldFaceGrad    = input.bool(true, 'Dial Face Gradient', inline = 'ldfg', group = ldGroup)
ldFaceGradPct = input.int(60, 'Bottom Opacity %', minval = 0, maxval = 100, inline = 'ldfg', group = ldGroup, tooltip = 'Fades the dial face from top to bottom. The top row uses the face color as-is; the bottom row is drawn at this percentage of the face color\'s own opacity (100 = no fade, 60 = 60% as opaque, 0 = fully transparent at the bottom). Applies to every Dial Color Theme, including Custom.')
ldNBelow      = input.int(3, 'Levels Below 🕛', minval = 1, maxval = 8, inline = 'ldlv', group = ldGroup)
ldNAbove      = input.int(3, 'Above', minval = 1, maxval = 8, inline = 'ldlv', group = ldGroup, tooltip = 'How many of the nearest levels below / above the 🕛 level (the level closest to the current price) make up each dial\'s scale. Below fills 🕛 → 8:00, Above fills 🕛 → 4:00, each level getting an equal share of its side. With up to 4 per side the labels show the full price (117,250); with 5–8 they get narrower to fit, and from 6 up they switch to a compact form (117.3K). Hover any label for the exact price.')
ldMarkSizeRaw = input.string('Small', 'Scale Text Size', options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = ldGroup, tooltip = 'Text size of the price labels on each dial\'s scale (and the M/L · S/T caption). Bigger sizes may need a larger Dial Size so the labels aren\'t cut off — hover a label to see its exact price and source (M, L, Y, PY / E1, T1, R1, 1D …).')
ldTopRow      = input.bool(false, '🕛 Label In Its Own Row Above The Ring', group = ldGroup, tooltip = 'ON: the 🕛 level\'s label gets its own row just above the top of the ring, where the needle can never reach it (the panel grows by one row).\nOFF (default): the 🕛 label sits inside the dial at 🕛 like the other labels, but it always stays visible — while the needle passes under it, the label covers that part of the needle.')
ldBright      = input.int(50, 'Price Label Brightness %', minval = 0, maxval = 100, group = ldGroup, tooltip = 'Blends each level\'s own color for its price label on the dial: 0 = the level\'s exact color, 100 = white (Custom theme) or the theme\'s number color (preset themes). The 🕛 level always uses that white / number color.')
ldInfoTxtCol  = input.color(color.white, 'Info Row Text', inline = 'ldinf', group = ldGroup)
ldInfoTxtOp   = input.int(50, 'Opacity %', minval = 0, maxval = 100, inline = 'ldinf', group = ldGroup, tooltip = 'Text color and opacity of the four info rows below each dial (🕛 level, PRICE, next level above, next level below). 100 = fully opaque, 0 = invisible. The title row above each dial keeps solid text.\nThe color is used by the Custom theme only — a preset Dial Color Theme supplies its own text color (the opacity still applies).')
ldTagSizeRaw  = input.string('Small', 'Info Row Text Size', options = ['Tiny', 'Small', 'Normal'], group = ldGroup, tooltip = 'Text size of the title and the 🕛 / PRICE / next-level rows of each dial.')
ldTitleDir    = input.bool(true, 'Title Row Follows Needle', inline = 'ldttl', group = ldGroup)
ldTitleUpCol  = input.color(color.new(color.teal, 50), 'Up', inline = 'ldttl', group = ldGroup)
ldTitleDnCol  = input.color(color.new(color.red, 50), 'Down', inline = 'ldttl', group = ldGroup, tooltip = 'ON: each dial\'s title row (SHORT-TERM LEVELS / MID/LONG TERM LEVELS) changes background with its own needle — Up while the needle points right of 🕛 (price above the 🕛 level), Down while it points left (price below it). With price exactly on the 🕛 level it keeps the neutral gray. OFF: the title row stays neutral gray.')
ldDimOn       = input.bool(true, 'Auto Dim Dials', inline = 'lddim', group = ldGroup)
ldDimPct      = input.int(30, 'Amount %', minval = 0, maxval = 100, step = 5, inline = 'lddim', group = ldGroup, tooltip = 'Dims both Pixel Dials (face, ring, needle, price labels, caption, title and info rows) during the Dim Period below. Dimming cuts the opacity of every dial color by this %, so every Dial Color Theme dims evenly: 30 = drawn at 70% of normal opacity, 0 = no dimming, 100 = hidden.\nUses the real clock, not bar time, so it works on any chart timeframe. Pine only redraws on incoming ticks, so the switch happens on the first tick after the period starts or ends.')
ldDimSess     = input.session('1900-0700', 'Dim Period', inline = 'lddim2', group = ldGroup)
ldDimTz       = input.string('America/Chicago', 'Timezone', inline = 'lddim2', group = ldGroup, tooltip = 'Start and end time of the dim period (default 7:00 PM to 7:00 AM; it may cross midnight; start equal to end = never dims), read in this timezone. Examples: America/Chicago, America/New_York, UTC, GMT-5. Blank = the symbol\'s exchange timezone (crypto exchanges usually use UTC).')
bool lvlDialMode = ldMode == 'Pixel Dials'
bool ldLiveST    = ldRefreshST == 'Live'
bool ldLiveML    = ldRefreshML == 'Live'

// ── Auto dim ──────────────────────────────────────────────────────────────────
// Minutes since midnight from an "HHMM" string.
f_ldHhmm(string s) =>
    int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))

string ldDimTzR   = ldDimTz == '' ? syminfo.timezone : ldDimTz
int    ldDimStart = f_ldHhmm(str.substring(ldDimSess, 0, 4))
int    ldDimEnd   = f_ldHhmm(str.substring(ldDimSess, 5, 9))
int    ldNowMin   = hour(timenow, ldDimTzR) * 60 + minute(timenow, ldDimTzR)
bool   ldDimNow   = ldDimOn and ldDimPct > 0 and
     (ldDimStart <= ldDimEnd ? ldNowMin >= ldDimStart and ldNowMin < ldDimEnd : ldNowMin >= ldDimStart or ldNowMin < ldDimEnd)

// Cuts a dial color's opacity by the dim amount while the dim period is active.
f_ldDim(color c) =>
    ldDimNow ? color.new(c, 100 - (100 - color.t(c)) * (1 - ldDimPct / 100.0)) : c

// ── Dial color theme ──────────────────────────────────────────────────────────
// Same palettes as CQ_(7)_[TACHIMETER]. Returns [face, numbers (caption,
// inside 🕛 label, label blend tone), needle, unlit ring, title/info text].
f_ldTheme(string th) =>
    color face   = ldFaceColor
    color num    = color.gray
    color needle = ldNeedleCol
    color track  = color.new(color.gray, 75)
    color txt    = color.white
    if th == 'Beige VU Meter'
        face   := #E9DDB5
        num    := #2A2016
        needle := #141414
        track  := color.new(#7A6A48, 55)
        txt    := #F3E9D2
    else if th == 'Aircraft Instrument'
        face   := #15181B
        num    := #F4F4F4
        needle := #FFFFFF
        track  := color.new(#5A5F66, 55)
        txt    := #FFFFFF
    else if th == 'Volkswagen Tacho'
        face   := #07080C
        num    := #5B9BFF
        needle := #FF3B1F
        track  := color.new(#1F3A66, 40)
        txt    := #A8C8FF
    else if th == 'Racing White Face'
        face   := #F4F2EC
        num    := #121212
        needle := #E3221B
        track  := color.new(#9A9A9A, 55)
        txt    := #FFFFFF
    else if th == 'Amber Night'
        face   := #160D02
        num    := #FFB000
        needle := #FFC24D
        track  := color.new(#5A3A00, 40)
        txt    := #FFC95A
    else if th == 'Marine Brass'
        face   := #0F2236
        num    := #D9B44A
        needle := #F4E6BC
        track  := color.new(#3C5670, 45)
        txt    := #E8CF83
    else if th == 'Night Vision Green'
        face   := #081408
        num    := #79FF66
        needle := #C2FFB8
        track  := color.new(#1E4A1E, 40)
        txt    := #9CFF8F
    [face, num, needle, track, txt]

[ldThFace, ldThNum, ldThNeedle, ldThTrack, ldThText] = f_ldTheme(ldTheme)
bool  ldCustom    = ldTheme == 'Custom'
// Inside 🕛 label color and the tone level labels blend toward (Custom keeps white).
color ldLabelTone = ldCustom ? color.white : ldThNum
// Info row text base color (Custom keeps the Info Row Text input).
color ldInfoBase  = ldCustom ? ldInfoTxtCol : ldThText

////////////////////////////////////////////////////////////
////   M I D / L O N G - T E R M   S U M M A R Y   T A B L E   ///
////////////////////////////////////////////////////////////
// A 3-column table (Vertical) or 3-row table (Horizontal) summarizing
// every Mid-Term + Long-Term target price in one sorted ladder:
//   Col/Row 1 — "NOW": blank on every row except one. Take the nearest
//     target ABOVE close and the nearest target BELOW close, and find the
//     midpoint (50%) between them. If close is above that midpoint, the
//     current price (with a ▼) is printed on the row of the nearest target
//     ABOVE it; if close is at or below the midpoint, the current price
//     (with a ▲) is printed on the row of the nearest target BELOW it. Text
//     color is mltCurrentColorDown (▼ case) or mltCurrentColorUp (▲ case).
//     If close sits beyond every target on one side (no bracketing pair
//     exists), the marker is skipped entirely. Background is fully
//     transparent, so the cell shows nothing but the marker itself.
//   Col/Row 2 — "TARGET": every Mid-Term + Long-Term price merged and
//     sorted highest → lowest (highest at the top row / leftmost column),
//     shaded with that price's own list color (MidTermColor / LongTermColor).
//     Opacity is RANK-based rather than distance-based: the level immediately
//     above the current price and the level immediately below it get
//     mltPctNear (100% by default); the next-nearest level on each side
//     gets mltPctMid (60%); every other level gets mltPctFar (30%). The
//     cell's TEXT uses that same opacity value (not a flat white), so text
//     and background fade together.
//   Col/Row 3 — "✓": a small checkmark if price has traded through that
//     level (between a bar's high and low) at any point in the last
//     mltReachedMonths months. Its cell BACKGROUND is flat, matching the
//     header row's own background (headerBg, driven by the user-selectable
//     mltHeaderColor input) — independent of the TARGET column's per-level
//     shading. The checkmark's own TEXT opacity still follows the same
//     rank-based mltPctNear/mltPctMid/mltPctFar criteria as TARGET.
//   (Columns 1 and 3 swap places when Column Order = '✓ | TARGET | NOW'.)
// LEVELS SHOWN: in 'Limited' mode only the mltMaxAbove levels nearest
// above close (>= close) and the mltMaxBelow levels nearest below it are
// kept (default 10 / 6); 'All' keeps every level. The limit applies to
// this table (and its rows in the merged table) only — chart lines and
// their dynamic opacity still use the full Mid/Long-Term pool.
// Rebuilt on every last bar (same barstate.islast pattern used by other
// CQ table implementations), independent of the realtime-only draw gate
// used by the line/label subsystems above, since a table is a single
// persistent object rather than something that accumulates.

mltTableGroup = '🪙 M I D / L O N G - T E R M   T A B L E'
showMltTable        = input.bool(true, 'Show Table', group = mltTableGroup, tooltip = 'Show/hide the Mid/Long-Term summary table entirely.')
mltTableTitle       = input.string('MID/LONG TERM LEVELS', 'Table Title', group = mltTableGroup, tooltip = 'Short title shown in its own row at the top of this table.')
mltTitleBgColor     = input.color(color.rgb(54, 58, 69, 50), 'Title Background', group = mltTableGroup, tooltip = 'Background color of the title row.')
mltNowBgColor       = input.color(color.rgb(0, 10, 37, 50), 'Now Column Background', group = mltTableGroup, tooltip = 'Background color of the NOW header cell and every NOW-column data cell.')
mltTableOrientation  = input.string('Vertical', 'Orientation', options = ['Vertical', 'Horizontal'], group = mltTableGroup, tooltip = 'Vertical: NOW/TARGET/✓ run as columns and each price is its own row. Horizontal: NOW/TARGET/✓ run as rows and each price is its own column.')
mltTablePositionRaw  = input.string('Bottom Right', 'Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = mltTableGroup, tooltip = 'Corner/edge of the chart pane this table is anchored to.')
mltTableSizeRaw      = input.string('Small', 'Text Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = mltTableGroup, tooltip = 'Font size used for every cell in this table.')
mltLevelsMode        = input.string('Limited', 'Levels Shown', options = ['Limited', 'All'], inline = 'mltlv', group = mltTableGroup)
mltMaxAbove          = input.int(10, 'Above', minval = 1, maxval = 100, inline = 'mltlv', group = mltTableGroup)
mltMaxBelow          = input.int(6, 'Below', minval = 1, maxval = 100, inline = 'mltlv', group = mltTableGroup, tooltip = 'Limited: the table only lists this many levels nearest ABOVE the current price (at or above close) and this many nearest BELOW it. All: every Mid-Term / Long-Term / Yearly-Open level is listed. Applies to this table and its rows in the merged table only — chart lines are unaffected.')
mltPctNear           = input.int(100, 'Nearest Levels Opacity % — Price Column', minval = 0, maxval = 100, group = mltTableGroup, tooltip = 'Opacity for the Mid/Long-Term level immediately above the current price and the one immediately below it.')
mltPctMid            = input.int(50, 'Next Levels Opacity % — Price Column', minval = 0, maxval = 100, group = mltTableGroup, tooltip = 'Opacity for the second-nearest level above the current price and the second-nearest level below it.')
mltPctFar            = input.int(20, 'Remaining Levels Opacity % — Price Column', minval = 0, maxval = 100, group = mltTableGroup, tooltip = 'Opacity for every other level, beyond the two nearest on each side of the current price.')
mltReachedMonths     = input.int(6, 'Reached Lookback (Months) — ✓ Column', minval = 1, maxval = 60, group = mltTableGroup, tooltip = "A small circle marks a price in the ✓ column if price has traded through it (between a bar's high and low) at any point within this many months.")
mltReachedMarkColor  = input.color(color.rgb(187, 255, 0), '✓ Column Marker Color', group = mltTableGroup, tooltip = 'Color of the ✓ checkmark shown for a row whose price has been reached within the Reached Lookback window above.')
mltCurrentColorUp    = input.color(color.rgb(255, 255, 255), 'Now Column Marker Color (▲ Below Midpoint)', group = mltTableGroup, tooltip = 'Text/arrow color when price sits at or below the midpoint between the nearest target below and nearest target above — the marker is placed on the BELOW target\'s row, with an up arrow.')
mltCurrentColorDown  = input.color(color.rgb(209, 209, 209), 'Now Column Marker Color (▼ Above Midpoint)', group = mltTableGroup, tooltip = 'Text/arrow color when price sits above the midpoint between the nearest target below and nearest target above — the marker is placed on the ABOVE target\'s row, with a down arrow.')
mltHeaderColor       = input.color(color.rgb(3, 19, 54, 60), 'Header Background', group = mltTableGroup, tooltip = 'Background color of the TARGET/✓ header cells and every ✓-column data cell (the ✓ column\'s background stays flat rather than rank-shaded like the TARGET column).')

f_mltTablePos(_sel) =>
    switch _sel
        'Top Left' => position.top_left
        'Top Center' => position.top_center
        'Top Right' => position.top_right
        'Middle Left' => position.middle_left
        'Middle Center' => position.middle_center
        'Middle Right' => position.middle_right
        'Bottom Left' => position.bottom_left
        'Bottom Center' => position.bottom_center
        => position.bottom_right

f_mltTextSize(_sel) =>
    _sel == 'Tiny' ? size.tiny : _sel == 'Small' ? size.small : _sel == 'Normal' ? size.normal : _sel == 'Large' ? size.large : size.huge

mltTablePos  = f_mltTablePos(mltTablePositionRaw)
mltTableSize = f_mltTextSize(mltTableSizeRaw)

// Table-layout values shared by both separate tables and the merged one.
// tblNowC/tblChkC are the NOW/✓ column indices (Vertical); tblNowR/tblChkR
// the NOW/✓ row indices (Horizontal, row 0 = title). TARGET stays at
// column 1 / row 2 either way.
tblMergedPos  = f_mltTablePos(tblMergedPosRaw)
tblMergedSize = f_mltTextSize(tblMergedSizeRaw)
tblSwapCols   = tblColumnOrder == '✓ | TARGET | NOW'
tblNowC       = tblSwapCols ? 2 : 0
tblChkC       = tblSwapCols ? 0 : 2
tblNowR       = tblSwapCols ? 3 : 1
tblChkR       = tblSwapCols ? 1 : 3

// Computed unconditionally every bar (not inside the islast branch below)
// since ta.highest/ta.lowest should not be called conditionally.
mltReachedBars = f_periodBars(mltReachedMonths * 30)
mltReachedHigh = ta.highest(high, mltReachedBars)
mltReachedLow  = ta.lowest(low, mltReachedBars)

// Exported copy of this ladder's finished rows, read by the MERGED
// SUMMARY TABLE at the end of the script. mlxAnchor is the row that
// carries the NOW marker (or, when price is off limits, the row where
// close would sit), used to align both ladders on one NOW row.
// mlxNowDir: 1 = marker on the BELOW row (➕), -1 = on the ABOVE row (➖),
// 0 = no marker (price off limits).
var string[] mlxPriceTxt = array.new_string(0)
var color[]  mlxBg       = array.new_color(0)
var color[]  mlxTxtCol2  = array.new_color(0)
var string[] mlxTxt3     = array.new_string(0)
var color[]  mlxTxtCol3  = array.new_color(0)
var string[] mlxSize     = array.new_string(0)
var int      mlxCount    = 0
var int      mlxAnchor   = 0
var int      mlxNowDir   = 0
var float    mlxNowDiff  = na
var color    mlxNowClr   = na

var table mltTable = na
if barstate.islast
    table.delete(mltTable)
    mlxCount  := 0
    mlxNowDir := 0
    if showMltTable and not lvlDialMode
        mltAllPrices = array.new_float(0)
        mltAllColors = array.new_color(0)
        mltAllSuffix = array.new_string(0)

        for y in pMidTerm
            if not na(y)
                array.push(mltAllPrices, y)
                array.push(mltAllColors, MidTermColor)
                array.push(mltAllSuffix, 'M')

        for y in pLongTerm
            if not na(y)
                array.push(mltAllPrices, y)
                array.push(mltAllColors, LongTermColor)
                array.push(mltAllSuffix, 'L')

        // Current/Previous-year open rows — included alongside the Mid/Long
        // Term ladder (same ranking, opacity, and ✓-reached treatment),
        // each following its own show toggle and using its own
        // user-selected color (CurrentYearlyOpenColor / PrevYearlyOpenColor).
        if showCurrentYearlyOpen
            array.push(mltAllPrices, yearly_open)
            array.push(mltAllColors, CurrentYearlyOpenColor)
            array.push(mltAllSuffix, 'Y')

        if showPrevYearlyOpen
            array.push(mltAllPrices, prevYearly_open)
            array.push(mltAllColors, PrevYearlyOpenColor)
            array.push(mltAllSuffix, 'PY')

        // Levels Shown limit — keep only the mltMaxAbove levels nearest
        // above close (>= close, same split as idxAbove below) and the
        // mltMaxBelow nearest below it. Sorted descending, the "above"
        // levels occupy the first mltNAbove slots with the nearest one last,
        // and the "below" levels follow with the nearest one first.
        if mltLevelsMode == 'Limited' and array.size(mltAllPrices) > 0
            mltLimIdx = array.sort_indices(mltAllPrices, order.descending)
            int mltNAbove = 0
            for p in mltAllPrices
                if p >= close
                    mltNAbove += 1
            mltKeepP = array.new_float(0)
            mltKeepC = array.new_color(0)
            mltKeepS = array.new_string(0)
            for i = 0 to array.size(mltLimIdx) - 1
                bool keep = i < mltNAbove ? i >= mltNAbove - mltMaxAbove : i < mltNAbove + mltMaxBelow
                if keep
                    k = array.get(mltLimIdx, i)
                    array.push(mltKeepP, array.get(mltAllPrices, k))
                    array.push(mltKeepC, array.get(mltAllColors, k))
                    array.push(mltKeepS, array.get(mltAllSuffix, k))
            mltAllPrices := mltKeepP
            mltAllColors := mltKeepC
            mltAllSuffix := mltKeepS

        mltCount = array.size(mltAllPrices)
        if mltCount > 0
            // Sort DESCENDING so the highest price lands in row/column 0 —
            // i.e. the highest number sits at the top of the Vertical table
            // (or leftmost in the Horizontal table).
            mltSortedIdx = array.sort_indices(mltAllPrices, order.descending)

            headerBg = color.new(mltHeaderColor, 20)

            rowPriceTxt = array.new_string(mltCount)
            rowPriceVal = array.new_float(mltCount)
            rowColorArr = array.new_color(mltCount)
            rowBgCol2   = array.new_color(mltCount)
            rowTxtCol2  = array.new_color(mltCount)
            rowTxtCol3  = array.new_color(mltCount)
            rowTxt3     = array.new_string(mltCount)
            rowSize     = array.new_string(mltCount, tblMerge ? tblMergedSize : mltTableSize)   // Far-opacity rows drop to tiny

            for i = 0 to mltCount - 1
                srcIdx    = array.get(mltSortedIdx, i)
                rowPrice  = array.get(mltAllPrices, srcIdx)
                rowColor  = array.get(mltAllColors, srcIdx)
                rowSuffix = array.get(mltAllSuffix, srcIdx)
                array.set(rowPriceVal, i, rowPrice)
                array.set(rowColorArr, i, rowColor)
                array.set(rowPriceTxt, i, str.tostring(rowPrice, '$0,000') + ' ' + rowSuffix)

                // Column 2 ("✓"): small checkmark if price traded through this level
                // (sat between the bar's high and low) within the lookback window.
                reached = rowPrice <= mltReachedHigh and rowPrice >= mltReachedLow
                array.set(rowTxt3, i, reached ? '✓' : '')

            // Column 1 ("TARGET") shading: rank each row's distance to
            // `close` separately above/below, then assign opacity by rank —
            // nearest on each side = mltPctNear, next-nearest = mltPctMid,
            // everything else = mltPctFar. Background (rowBgCol2) is built
            // from each price's own list color (MidTermColor /
            // LongTermColor); TEXT (rowTxtCol2) fades with that same
            // opacity. The ✓ column's checkmark text (rowTxtCol3) fades
            // with the same rank-based opacity, using mltReachedMarkColor
            // instead of white, but its BACKGROUND is flat (headerBg)
            // rather than rank-shaded — see the table-render block below.
            idxAbove = array.new_int(0)
            idxBelow = array.new_int(0)
            pxAbove  = array.new_float(0)
            pxBelow  = array.new_float(0)
            for i = 0 to mltCount - 1
                p = array.get(rowPriceVal, i)
                if p >= close
                    array.push(idxAbove, i)
                    array.push(pxAbove, p)
                else
                    array.push(idxBelow, i)
                    array.push(pxBelow, p)

            if array.size(idxAbove) > 0
                ordAbove = array.sort_indices(pxAbove, order.ascending)   // nearest to close first
                for r = 0 to array.size(ordAbove) - 1
                    ri  = array.get(idxAbove, array.get(ordAbove, r))
                    pct = r == 0 ? mltPctNear : r == 1 ? mltPctMid : mltPctFar
                    array.set(rowBgCol2, ri, color.new(array.get(rowColorArr, ri), 100 - pct))
                    array.set(rowTxtCol2, ri, color.new(color.white, 100 - pct))
                    array.set(rowTxtCol3, ri, color.new(mltReachedMarkColor, 100 - pct))
                    if r >= 2
                        array.set(rowSize, ri, size.tiny)

            if array.size(idxBelow) > 0
                ordBelow = array.sort_indices(pxBelow, order.descending)  // nearest to close first
                for r = 0 to array.size(ordBelow) - 1
                    ri  = array.get(idxBelow, array.get(ordBelow, r))
                    pct = r == 0 ? mltPctNear : r == 1 ? mltPctMid : mltPctFar
                    array.set(rowBgCol2, ri, color.new(array.get(rowColorArr, ri), 100 - pct))
                    array.set(rowTxtCol2, ri, color.new(color.white, 100 - pct))
                    array.set(rowTxtCol3, ri, color.new(mltReachedMarkColor, 100 - pct))
                    if r >= 2
                        array.set(rowSize, ri, size.tiny)

            // Export this ladder for the MERGED SUMMARY TABLE. Default
            // anchor = first row below close (clamped to the last row),
            // overwritten below by the actual NOW-marker row when one exists.
            mlxCount    := mltCount
            mlxPriceTxt := rowPriceTxt
            mlxBg       := rowBgCol2
            mlxTxtCol2  := rowTxtCol2
            mlxTxt3     := rowTxt3
            mlxTxtCol3  := rowTxtCol3
            mlxSize     := rowSize
            mlxAnchor   := math.min(array.size(idxAbove), mltCount - 1)

            // Column 3 ("NOW"): blank on every row except the one bracketing
            // target closest to the 50% midpoint side close currently sits
            // on. idxAbove/pxAbove and idxBelow/pxBelow (built above) already
            // separate rows by whether their price is >= or < close, so the
            // nearest neighbor on each side is just the smallest gap within
            // each set. If either side has no candidate (close sits beyond
            // every target), the marker is skipped — na guards below leave
            // every rowCurrentTxt entry blank in that case.
            rowCurrentTxt = array.new_string(mltCount, '')
            rowCurrentClr = array.new_color(mltCount, color.new(color.white, 100))

            nearestAbovePrice = float(na)
            nearestAboveRow   = int(na)
            if array.size(idxAbove) > 0
                for a = 0 to array.size(idxAbove) - 1
                    p = array.get(pxAbove, a)
                    if na(nearestAbovePrice) or p < nearestAbovePrice
                        nearestAbovePrice := p
                        nearestAboveRow   := array.get(idxAbove, a)

            nearestBelowPrice = float(na)
            nearestBelowRow   = int(na)
            if array.size(idxBelow) > 0
                for b = 0 to array.size(idxBelow) - 1
                    p = array.get(pxBelow, b)
                    if na(nearestBelowPrice) or p > nearestBelowPrice
                        nearestBelowPrice := p
                        nearestBelowRow   := array.get(idxBelow, b)

            if not na(nearestAbovePrice) and not na(nearestBelowPrice)
                midPoint = (nearestAbovePrice + nearestBelowPrice) / 2.0
                if close > midPoint
                    diffDown = nearestAbovePrice - close
                    array.set(rowCurrentTxt, nearestAboveRow, '➖' + str.tostring(diffDown, '$0,000') + '⁝\n↳ ' + str.tostring(close, '$0,000'))
                    array.set(rowCurrentClr, nearestAboveRow, mltCurrentColorDown)
                    mlxAnchor  := nearestAboveRow
                    mlxNowDir  := -1
                    mlxNowDiff := diffDown
                    mlxNowClr  := mltCurrentColorDown
                else
                    diffUp = close - nearestBelowPrice
                    array.set(rowCurrentTxt, nearestBelowRow, '↱ ' + str.tostring(close, '$0,000') + '\n➕' + str.tostring(diffUp, '$0,000') + '⁝')
                    array.set(rowCurrentClr, nearestBelowRow, mltCurrentColorUp)
                    mlxAnchor  := nearestBelowRow
                    mlxNowDir  := 1
                    mlxNowDiff := diffUp
                    mlxNowClr  := mltCurrentColorUp

            // If close sits beyond every target on one side, no bracketing
            // pair exists and every NOW cell above is left blank — flag
            // that in the title so it's clear the table isn't just stale.
            mltNowEmpty = na(nearestAbovePrice) or na(nearestBelowPrice)
            mltDisplayTitle = mltNowEmpty ? mltTableTitle + '\nPrice Off Limits' : mltTableTitle

            // Row/column 0 is a merged title bar (mltTableTitle) spanning
            // the full width (Vertical) or full height (Horizontal) of the
            // table; the NOW/TARGET/✓ header and every data row shift down
            // by one slot to make room for it. NOW and ✓ positions follow
            // tblNowC/tblChkC (Vertical) or tblNowR/tblChkR (Horizontal).
            // Skipped entirely in merged mode (see MERGED SUMMARY TABLE).
            if not tblMerge and mltTableOrientation == 'Vertical'
                mltTable := table.new(mltTablePos, 3, mltCount + 2, border_width = 1, border_color = color.new(color.black, 50))
                table.cell(mltTable, 0, 0, mltDisplayTitle, text_color = color.white, bgcolor = mltTitleBgColor, text_size = mltTableSize)
                table.merge_cells(mltTable, 0, 0, 2, 0)
                table.cell(mltTable, tblNowC, 1, 'NOW', text_color = color.white, bgcolor = mltNowBgColor, text_size = mltTableSize)
                table.cell(mltTable, 1, 1, 'TARGET', text_color = color.white, bgcolor = headerBg, text_size = mltTableSize)
                table.cell(mltTable, tblChkC, 1, '✅', text_color = color.white, bgcolor = headerBg, text_size = mltTableSize)
                for i = 0 to mltCount - 1
                    table.cell(mltTable, tblNowC, i + 2, array.get(rowCurrentTxt, i), text_color = array.get(rowCurrentClr, i), bgcolor = mltNowBgColor, text_size = array.get(rowSize, i), text_halign = tblSwapCols ? text.align_left : text.align_right, tooltip = 'NOW: shows the current price relative to the two nearest Mid-Term/Long-Term/Yearly-Open targets that bracket it (the closest one above and the closest one below). It appears on only ONE row per tick - whichever of those two targets sits on the same side of the halfway point (50%) between them as the current price. If price is at or below that midpoint, it prints on the BELOW target row: an up arrow, the current price, then how many dollars still short of that target. If price is above the midpoint, it prints on the ABOVE target row: how many dollars past that target already, then a down arrow and the current price. Every other row stays blank, and if price sits beyond every target on one side (no bracketing pair), the whole column is blank and the table title adds "Price Off Limits".')
                    table.cell(mltTable, 1, i + 2, array.get(rowPriceTxt, i), text_color = array.get(rowTxtCol2, i), bgcolor = array.get(rowBgCol2, i), text_size = array.get(rowSize, i))
                    table.cell(mltTable, tblChkC, i + 2, array.get(rowTxt3, i), text_color = array.get(rowTxtCol3, i), bgcolor = headerBg, text_size = array.get(rowSize, i))
            else if not tblMerge
                mltTable := table.new(mltTablePos, mltCount + 1, 4, border_width = 1, border_color = color.new(color.black, 50))
                table.cell(mltTable, 0, 0, mltDisplayTitle, text_color = color.white, bgcolor = mltTitleBgColor, text_size = mltTableSize)
                table.merge_cells(mltTable, 0, 0, mltCount, 0)
                table.cell(mltTable, 0, tblNowR, 'NOW', text_color = color.white, bgcolor = mltNowBgColor, text_size = mltTableSize)
                table.cell(mltTable, 0, 2, 'TARGET', text_color = color.white, bgcolor = headerBg, text_size = mltTableSize)
                table.cell(mltTable, 0, tblChkR, '✅', text_color = color.white, bgcolor = headerBg, text_size = mltTableSize)
                for i = 0 to mltCount - 1
                    table.cell(mltTable, i + 1, tblNowR, array.get(rowCurrentTxt, i), text_color = array.get(rowCurrentClr, i), bgcolor = mltNowBgColor, text_size = array.get(rowSize, i), tooltip = 'NOW: shows the current price relative to the two nearest Mid-Term/Long-Term/Yearly-Open targets that bracket it (the closest one above and the closest one below). It appears on only ONE column per tick - whichever of those two targets sits on the same side of the halfway point (50%) between them as the current price. If price is at or below that midpoint, it prints on the BELOW target column: an up arrow, the current price, then how many dollars still short of that target. If price is above the midpoint, it prints on the ABOVE target column: how many dollars past that target already, then a down arrow and the current price. Every other column stays blank, and if price sits beyond every target on one side (no bracketing pair), the whole row is blank and the table title adds "Price Off Limits".')
                    table.cell(mltTable, i + 1, 2, array.get(rowPriceTxt, i), text_color = array.get(rowTxtCol2, i), bgcolor = array.get(rowBgCol2, i), text_size = array.get(rowSize, i))
                    table.cell(mltTable, i + 1, tblChkR, array.get(rowTxt3, i), text_color = array.get(rowTxtCol3, i), bgcolor = headerBg, text_size = array.get(rowSize, i))

////////////////////////////////////////////////////////////
////   S H O R T - T E R M   S U M M A R Y   T A B L E    ///
////   ( E N T R Y / T A R G E T / W E E K L Y / R E F )  ///
////////////////////////////////////////////////////////////
// Same NOW/TARGET/✓ design as the Mid/Long-Term table above (rank-based
// opacity, reached-lookback checkmark, midpoint NOW marker with the
// +/- distance-to-level suffix), but built from every OTHER price list
// in the script: Set 1 Entry prices, Set 1 Target prices, and either of
// the 2 manual Reference Levels left non-zero. Each source keeps its OWN
// list's color (Entry/Target Line Colors, each Ref Level's own Color) —
// only the cell opacity is rank-based, exactly like the primary table. A
// source with nothing to show simply contributes no rows. Each source
// group (Set 1 Entry, Set 1 Target, Reference Levels) can also be switched
// on/off individually in this table's settings.

secTableGroup = '🪙 S H O R T - T E R M - T A B L E'
showSecTable        = input.bool(true, 'Show Table', group = secTableGroup, tooltip = 'Show/hide the SHORT-TERM summary table entirely.')
secTableTitle       = input.string('SHORT-TERM LEVELS', 'Table Title', group = secTableGroup, tooltip = 'Short title shown in its own row at the top of this table.')
secTitleBgColor     = input.color(color.rgb(54, 58, 69, 50), 'Title Background', group = secTableGroup, tooltip = 'Background color of the title row.')
secNowBgColor       = input.color(color.rgb(0, 10, 37, 50), 'Now Column Background', group = secTableGroup, tooltip = 'Background color of the NOW header cell and every NOW-column data cell.')
secTableOrientation = input.string('Vertical', 'Orientation', options = ['Vertical', 'Horizontal'], group = secTableGroup, tooltip = 'Vertical: NOW/TARGET/✓ run as columns and each price is its own row. Horizontal: NOW/TARGET/✓ run as rows and each price is its own column.')
secTablePositionRaw = input.string('Top Right', 'Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = secTableGroup, tooltip = 'Corner/edge of the chart pane this table is anchored to.')
secTableSizeRaw     = input.string('Small', 'Text Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = secTableGroup, tooltip = 'Font size used for every cell in this table.')
secPctNear          = input.int(100, 'Nearest Levels Opacity % — Price Column', minval = 0, maxval = 100, group = secTableGroup, tooltip = 'Opacity for the level immediately above the current price and the one immediately below it.')
secPctMid           = input.int(50, 'Next Levels Opacity % — Price Column', minval = 0, maxval = 100, group = secTableGroup, tooltip = 'Opacity for the second-nearest level above the current price and the second-nearest level below it.')
secPctFar           = input.int(20, 'Remaining Levels Opacity % — Price Column', minval = 0, maxval = 100, group = secTableGroup, tooltip = 'Opacity for every other level, beyond the two nearest on each side of the current price.')
secReachedMonths    = input.int(6, 'Reached Lookback (Months) — ✓ Column', minval = 1, maxval = 60, group = secTableGroup, tooltip = "Marks a price in the ✓ column if price has traded through it (between a bar's high and low) at any point within this many months.")
secReachedMarkColor = input.color(color.rgb(187, 255, 0), '✓ Column Marker Color', group = secTableGroup, tooltip = 'Color of the ✓ checkmark shown for a row whose price has been reached within the Reached Lookback window above.')
secCurrentColorUp   = input.color(color.rgb(255, 255, 255), 'Now Column Marker Color (▲ Below Midpoint)', group = secTableGroup, tooltip = 'Text/arrow color when price sits at or below the midpoint between the nearest level below and nearest level above.')
secCurrentColorDown = input.color(color.rgb(209, 209, 209), 'Now Column Marker Color (▼ Above Midpoint)', group = secTableGroup, tooltip = 'Text/arrow color when price sits above the midpoint between the nearest level below and nearest level above.')
secHeaderColor      = input.color(color.rgb(3, 19, 54, 60), 'Header Background', group = secTableGroup, tooltip = 'Background color of the TARGET/✓ header cells and every ✓-column data cell (the ✓ column\'s background stays flat rather than rank-shaded like the TARGET column).')

// Price-group selectors — choose which source groups are folded into this
// table (all default ON). Turning a group off removes its rows from the
// table AND from the ranking pool, so the near/mid/far opacity, NOW marker
// and on-chart line/label opacity are all computed only against the groups
// left on. This never hides the group's own lines/labels on the chart —
// use each group's own Plot toggle for that.
secInclEntry1     = input.bool(true, 'Set 1 Entry Events(E1)',  inline = 'secinc1', group = secTableGroup, tooltip = 'Include the Set 1 Entry Event prices in this table.')
secInclTarget1    = input.bool(true, 'Set 1 Targets (T1)', inline = 'secinc1', group = secTableGroup, tooltip = 'Include the Set 1 Target Event prices in this table.')
secInclRefs       = input.bool(true, 'Reference Levels (R1–R2)', group = secTableGroup, tooltip = 'Include both non-zero manual Reference Levels (Ⅰ–Ⅱ) in this table.')

// Maps a companion-pool group tag (see secCompanionGroupsTracked) to its toggle.
f_secGroupOn(_g) =>
    _g == 1 ? secInclEntry1 : _g == 3 ? secInclTarget1 : secInclRefs

// Automatic reference rows — the 1D, 1W and 4H opening prices. Each one
// has its own show toggle + color. They're structural context rather than
// a user-typed list, so they have no on-chart line/label — only a table
// row, ranked like every other row.
show1DOpen         = input.bool(true, 'Show 1D Open', inline = 'sec1d', group = secTableGroup, tooltip = "Adds the current Daily candle's opening price as a row in this table.")
secDailyOpenColor  = input.color(color.rgb(100, 147, 165), 'Color', inline = 'sec1d', group = secTableGroup, tooltip = "Color for the 1D Open row.")
show1WOpen         = input.bool(true, 'Show 1W Open', inline = 'sec1w', group = secTableGroup, tooltip = "Adds the current Weekly candle's opening price as a row in this table.")
secWeeklyOpenColor = input.color(color.rgb(23, 143, 173), 'Color', inline = 'sec1w', group = secTableGroup, tooltip = "Color for the 1W Open row.")
show4HOpen         = input.bool(true, 'Show 4H Open', inline = 'sec4h', group = secTableGroup, tooltip = "Adds the current 4H candle's opening price as a row in this table.")
sec4HOpenColor     = input.color(color.rgb(165, 160, 95), 'Color', inline = 'sec4h', group = secTableGroup, tooltip = "Color for the 4H Open row.")

// ── DYNAMIC OPACITY — FINAL RECOLOR PASS ────────────────────────────────
// Both tables' opacity-pct inputs (mltPctNear/mltPctMid/mltPctFar above,
// secPctNear/secPctMid/secPctFar just above) are only now fully known, so
// this is where every chart line/label tracked by the two "placeholder
// now, recolor here" trackers gets its real dynamic opacity — the same
// near/mid/far rank-vs-close value as its own row in the corresponding
// table — while keeping each object's own base color (hue) untouched.
// Label TEXT fades by that exact same transparency as its background.
// mltOpacity* covers Mid-Term/Long-Term/Current-Year-Open/Previous-Year-
// Open; secOpacity* covers Set 1 Entry/Target and Reference Levels 1–2
// (the plotted subset of the SHORT-TERM Table's rows — the automatic
// 1D/1W/4H Open rows have no chart line/label of their own, so they
// aren't recolored here, only ranked-against). SHORT-TERM labels are
// recolored from secOpacityLabelColors (their own background hue — the
// Label Palette for Entry/Target), not from the line hue, so the palette
// survives this pass. In Boxes caption mode the same opacity is applied
// to each caption box's background and text instead (whichever of
// label/box is na for an entry is skipped). The entry-zone and Reference
// Level shading keep their own transparency inputs and aren't recolored.
if not barstate.isconfirmed and barstate.isrealtime
    // Guarded with size > 0: "for i = 0 to array.size(X) - 1" is only
    // safe when X isn't empty — with an empty tracker the loop would
    // still run once with i = 0 (descending step to -1).
    if array.size(mltOpacityLines) > 0
        for i = 0 to array.size(mltOpacityLines) - 1
            mltLn      = array.get(mltOpacityLines, i)
            mltLbl     = array.get(mltOpacityLabels, i)
            mltBx      = array.get(mltOpacityBoxes, i)
            mltPrice   = array.get(mltOpacityPrices, i)
            mltColor   = array.get(mltOpacityBaseColors, i)
            mltTxtHue  = array.get(mltOpacityTextColors, i)
            mltPct     = f_rankPct(mltPrice, mltCompanionPricesTracked, close, mltPctNear, mltPctMid, mltPctFar)
            line.set_color(mltLn, color.new(mltColor, 100 - mltPct))
            if not na(mltLbl)
                label.set_color(mltLbl, color.new(mltColor, 100 - mltPct))
                label.set_textcolor(mltLbl, color.new(mltTxtHue, 100 - mltPct))
            if not na(mltBx)
                box.set_bgcolor(mltBx, color.new(mltColor, 100 - mltPct))
                box.set_text_color(mltBx, color.new(mltTxtHue, 100 - mltPct))

    if array.size(secOpacityLines) > 0
        // Ranking pool = only the source groups currently included in the
        // SHORT-TERM Table (same pool its own rows are ranked against).
        secFilteredPool = array.new_float(0)
        if array.size(secCompanionPricesTracked) > 0
            for k = 0 to array.size(secCompanionPricesTracked) - 1
                if f_secGroupOn(array.get(secCompanionGroupsTracked, k))
                    array.push(secFilteredPool, array.get(secCompanionPricesTracked, k))
        for i = 0 to array.size(secOpacityLines) - 1
            secLn       = array.get(secOpacityLines, i)
            secLbl      = array.get(secOpacityLabels, i)
            secBx       = array.get(secOpacityBoxes, i)
            secPrice    = array.get(secOpacityPrices, i)
            secColor    = array.get(secOpacityBaseColors, i)
            secLblColor = array.get(secOpacityLabelColors, i)
            secTxtHue   = array.get(secOpacityTextColors, i)
            secPct      = f_rankPct(secPrice, secFilteredPool, close, secPctNear, secPctMid, secPctFar)
            line.set_color(secLn, color.new(secColor, 100 - secPct))
            if not na(secLbl)
                label.set_color(secLbl, color.new(secLblColor, 100 - secPct))
                label.set_textcolor(secLbl, color.new(secTxtHue, 100 - secPct))
            if not na(secBx)
                box.set_bgcolor(secBx, color.new(secLblColor, 100 - secPct))
                box.set_text_color(secBx, color.new(secTxtHue, 100 - secPct))

secTablePos  = f_mltTablePos(secTablePositionRaw)
secTableSize = f_mltTextSize(secTableSizeRaw)

// Computed unconditionally every bar, same reasoning as mltReachedHigh/Low above.
secReachedBars = f_periodBars(secReachedMonths * 30)
secReachedHigh = ta.highest(high, secReachedBars)
secReachedLow  = ta.lowest(low, secReachedBars)

// Daily open price for the automatic table row. Like the 4H open below,
// it's opt-in (show1DOpen) — only pay for this request.security call when
// the row is actually going to be shown. Weekly open reuses sundayOpen
// (already pulled via request.security(..., 'W', ...) above) rather than
// requesting the same series twice.
dailyOpenPrice  = show1DOpen ? request.security(syminfo.tickerid, 'D', open, lookahead = barmerge.lookahead_on) : na
// 4H open is opt-in (show4HOpen) — only pay for this request.security
// call when the row is actually going to be shown.
fourHOpenPrice  = show4HOpen ? request.security(syminfo.tickerid, '240', open, lookahead = barmerge.lookahead_on) : na

// Exported copy of this ladder's finished rows for the MERGED SUMMARY
// TABLE — same meaning as the mlx* set above the Mid/Long-Term table.
var string[] stxPriceTxt = array.new_string(0)
var color[]  stxBg       = array.new_color(0)
var color[]  stxTxtCol2  = array.new_color(0)
var string[] stxTxt3     = array.new_string(0)
var color[]  stxTxtCol3  = array.new_color(0)
var string[] stxSize     = array.new_string(0)
var int      stxCount    = 0
var int      stxAnchor   = 0
var int      stxNowDir   = 0
var float    stxNowDiff  = na
var color    stxNowClr   = na

var table secTable = na
if barstate.islast
    table.delete(secTable)
    stxCount  := 0
    stxNowDir := 0
    if showSecTable and not lvlDialMode
        secAllPrices = array.new_float(0)
        secAllColors = array.new_color(0)
        secAllSuffix = array.new_string(0)

        for y in pEventsEntry
            if secInclEntry1 and not na(y)
                array.push(secAllPrices, y)
                array.push(secAllColors, event_entry_Color)
                array.push(secAllSuffix, 'E1')

        for y in pEventsTarget
            if secInclTarget1 and not na(y)
                array.push(secAllPrices, y)
                array.push(secAllColors, event_target_Color)
                array.push(secAllSuffix, 'T1')

        if secInclRefs and not na(ref1Price)
            array.push(secAllPrices, ref1Price)
            array.push(secAllColors, ref1Color)
            array.push(secAllSuffix, 'R1')
        if secInclRefs and not na(ref2Price)
            array.push(secAllPrices, ref2Price)
            array.push(secAllColors, ref2Color)
            array.push(secAllSuffix, 'R2')

        // Automatic 1D / 1W / 4H opens — each independently toggled by its
        // own show input (show1DOpen / show1WOpen / show4HOpen).
        if show1DOpen and not na(dailyOpenPrice)
            array.push(secAllPrices, dailyOpenPrice)
            array.push(secAllColors, secDailyOpenColor)
            array.push(secAllSuffix, '1D')
        if show1WOpen and not na(sundayOpen)
            array.push(secAllPrices, sundayOpen)
            array.push(secAllColors, secWeeklyOpenColor)
            array.push(secAllSuffix, '1W')
        if show4HOpen and not na(fourHOpenPrice)
            array.push(secAllPrices, fourHOpenPrice)
            array.push(secAllColors, sec4HOpenColor)
            array.push(secAllSuffix, '4H')

        secCount = array.size(secAllPrices)
        if secCount > 0
            // Sort DESCENDING so the highest price lands in row/column 0,
            // same convention as the Mid/Long-Term table.
            secSortedIdx = array.sort_indices(secAllPrices, order.descending)

            secHeaderBg = color.new(secHeaderColor, 20)

            secRowPriceTxt = array.new_string(secCount)
            secRowPriceVal = array.new_float(secCount)
            secRowColorArr = array.new_color(secCount)
            secRowBgCol2   = array.new_color(secCount)
            secRowTxtCol2  = array.new_color(secCount)
            secRowTxtCol3  = array.new_color(secCount)
            secRowTxt3     = array.new_string(secCount)
            secRowSize     = array.new_string(secCount, tblMerge ? tblMergedSize : secTableSize)   // Far-opacity rows drop to tiny

            for i = 0 to secCount - 1
                srcIdx    = array.get(secSortedIdx, i)
                rowPrice  = array.get(secAllPrices, srcIdx)
                rowColor  = array.get(secAllColors, srcIdx)
                rowSuffix = array.get(secAllSuffix, srcIdx)
                array.set(secRowPriceVal, i, rowPrice)
                array.set(secRowColorArr, i, rowColor)
                array.set(secRowPriceTxt, i, str.tostring(rowPrice, '$0,000') + ' ' + rowSuffix)

                // Column 3 ("✓"): traded-through-level checkmark, same rule
                // as the primary table but using this table's own lookback.
                reached = rowPrice <= secReachedHigh and rowPrice >= secReachedLow
                array.set(secRowTxt3, i, reached ? '✓' : '')

            // Column 1 ("TARGET") shading: same rank-by-distance-to-close
            // logic as the primary table, using this table's own colors
            // (each row's OWN source color) and this table's own opacity
            // inputs (secPctNear/secPctMid/secPctFar).
            secIdxAbove = array.new_int(0)
            secIdxBelow = array.new_int(0)
            secPxAbove  = array.new_float(0)
            secPxBelow  = array.new_float(0)
            for i = 0 to secCount - 1
                p = array.get(secRowPriceVal, i)
                if p >= close
                    array.push(secIdxAbove, i)
                    array.push(secPxAbove, p)
                else
                    array.push(secIdxBelow, i)
                    array.push(secPxBelow, p)

            if array.size(secIdxAbove) > 0
                secOrdAbove = array.sort_indices(secPxAbove, order.ascending)
                for r = 0 to array.size(secOrdAbove) - 1
                    ri  = array.get(secIdxAbove, array.get(secOrdAbove, r))
                    pct = r == 0 ? secPctNear : r == 1 ? secPctMid : secPctFar
                    array.set(secRowBgCol2, ri, color.new(array.get(secRowColorArr, ri), 100 - pct))
                    array.set(secRowTxtCol2, ri, color.new(color.white, 100 - pct))
                    array.set(secRowTxtCol3, ri, color.new(secReachedMarkColor, 100 - pct))
                    if r >= 2
                        array.set(secRowSize, ri, size.tiny)

            if array.size(secIdxBelow) > 0
                secOrdBelow = array.sort_indices(secPxBelow, order.descending)
                for r = 0 to array.size(secOrdBelow) - 1
                    ri  = array.get(secIdxBelow, array.get(secOrdBelow, r))
                    pct = r == 0 ? secPctNear : r == 1 ? secPctMid : secPctFar
                    array.set(secRowBgCol2, ri, color.new(array.get(secRowColorArr, ri), 100 - pct))
                    array.set(secRowTxtCol2, ri, color.new(color.white, 100 - pct))
                    array.set(secRowTxtCol3, ri, color.new(secReachedMarkColor, 100 - pct))
                    if r >= 2
                        array.set(secRowSize, ri, size.tiny)

            // Export this ladder for the MERGED SUMMARY TABLE (see the
            // matching block in the Mid/Long-Term table above).
            stxCount    := secCount
            stxPriceTxt := secRowPriceTxt
            stxBg       := secRowBgCol2
            stxTxtCol2  := secRowTxtCol2
            stxTxt3     := secRowTxt3
            stxTxtCol3  := secRowTxtCol3
            stxSize     := secRowSize
            stxAnchor   := math.min(array.size(secIdxAbove), secCount - 1)

            // Column 2 ("NOW"): same bracketing-midpoint marker as the
            // primary table, including the +/- distance-to-level suffix.
            secRowCurrentTxt = array.new_string(secCount, '')
            secRowCurrentClr = array.new_color(secCount, color.new(color.white, 100))

            secNearestAbovePrice = float(na)
            secNearestAboveRow   = int(na)
            if array.size(secIdxAbove) > 0
                for a = 0 to array.size(secIdxAbove) - 1
                    p = array.get(secPxAbove, a)
                    if na(secNearestAbovePrice) or p < secNearestAbovePrice
                        secNearestAbovePrice := p
                        secNearestAboveRow   := array.get(secIdxAbove, a)

            secNearestBelowPrice = float(na)
            secNearestBelowRow   = int(na)
            if array.size(secIdxBelow) > 0
                for b = 0 to array.size(secIdxBelow) - 1
                    p = array.get(secPxBelow, b)
                    if na(secNearestBelowPrice) or p > secNearestBelowPrice
                        secNearestBelowPrice := p
                        secNearestBelowRow   := array.get(secIdxBelow, b)

            if not na(secNearestAbovePrice) and not na(secNearestBelowPrice)
                secMidPoint = (secNearestAbovePrice + secNearestBelowPrice) / 2.0
                if close > secMidPoint
                    secDiffDown = secNearestAbovePrice - close
                    array.set(secRowCurrentTxt, secNearestAboveRow, '➖' + str.tostring(secDiffDown, '$0,000') + '⁝\n↳ ' + str.tostring(close, '$0,000'))
                    array.set(secRowCurrentClr, secNearestAboveRow, secCurrentColorDown)
                    stxAnchor  := secNearestAboveRow
                    stxNowDir  := -1
                    stxNowDiff := secDiffDown
                    stxNowClr  := secCurrentColorDown
                else
                    secDiffUp = close - secNearestBelowPrice
                    array.set(secRowCurrentTxt, secNearestBelowRow, '↱ ' + str.tostring(close, '$0,000') + '\n➕' + str.tostring(secDiffUp, '$0,000') + '⁝')
                    array.set(secRowCurrentClr, secNearestBelowRow, secCurrentColorUp)
                    stxAnchor  := secNearestBelowRow
                    stxNowDir  := 1
                    stxNowDiff := secDiffUp
                    stxNowClr  := secCurrentColorUp

            // If close sits beyond every level on one side, no bracketing
            // pair exists and every NOW cell above is left blank — flag
            // that in the title so it's clear the table isn't just stale.
            secNowEmpty = na(secNearestAbovePrice) or na(secNearestBelowPrice)
            secDisplayTitle = secNowEmpty ? secTableTitle + '\nPrice Off Limits' : secTableTitle

            // Same merged title-bar treatment as the Mid/Long-Term table
            // above — row/column 0 is secTableTitle, and the NOW/TARGET/✓
            // header plus every data row shift down by one slot. NOW/✓
            // positions follow the shared Column Order setting; skipped
            // entirely in merged mode.
            if not tblMerge and secTableOrientation == 'Vertical'
                secTable := table.new(secTablePos, 3, secCount + 2, border_width = 1, border_color = color.new(color.black, 50))
                table.cell(secTable, 0, 0, secDisplayTitle, text_color = color.white, bgcolor = secTitleBgColor, text_size = secTableSize)
                table.merge_cells(secTable, 0, 0, 2, 0)
                table.cell(secTable, tblNowC, 1, 'NOW', text_color = color.white, bgcolor = secNowBgColor, text_size = secTableSize)
                table.cell(secTable, 1, 1, 'TARGET', text_color = color.white, bgcolor = secHeaderBg, text_size = secTableSize)
                table.cell(secTable, tblChkC, 1, '✅', text_color = color.white, bgcolor = secHeaderBg, text_size = secTableSize)
                for i = 0 to secCount - 1
                    table.cell(secTable, tblNowC, i + 2, array.get(secRowCurrentTxt, i), text_color = array.get(secRowCurrentClr, i), bgcolor = secNowBgColor, text_size = array.get(secRowSize, i), text_halign = tblSwapCols ? text.align_left : text.align_right, tooltip = 'NOW: shows the current price relative to the two nearest levels (Entry/Target events, Reference Levels, and the automatic 1D/1W/4H Open rows) that bracket it (the closest one above and the closest one below). It appears on only ONE row per tick - whichever of those two levels sits on the same side of the halfway point (50%) between them as the current price. If price is at or below that midpoint, it prints on the BELOW level\'s row: an up arrow, the current price, then how many dollars still short of that level. If price is above the midpoint, it prints on the ABOVE level\'s row: how many dollars past that level already, then a down arrow and the current price. Every other row stays blank, and if price sits beyond every level on one side (no bracketing pair), the whole column is blank and the table title adds "Price Off Limits".')
                    table.cell(secTable, 1, i + 2, array.get(secRowPriceTxt, i), text_color = array.get(secRowTxtCol2, i), bgcolor = array.get(secRowBgCol2, i), text_size = array.get(secRowSize, i))
                    table.cell(secTable, tblChkC, i + 2, array.get(secRowTxt3, i), text_color = array.get(secRowTxtCol3, i), bgcolor = secHeaderBg, text_size = array.get(secRowSize, i))
            else if not tblMerge
                secTable := table.new(secTablePos, secCount + 1, 4, border_width = 1, border_color = color.new(color.black, 50))
                table.cell(secTable, 0, 0, secDisplayTitle, text_color = color.white, bgcolor = secTitleBgColor, text_size = secTableSize)
                table.merge_cells(secTable, 0, 0, secCount, 0)
                table.cell(secTable, 0, tblNowR, 'NOW', text_color = color.white, bgcolor = secNowBgColor, text_size = secTableSize)
                table.cell(secTable, 0, 2, 'TARGET', text_color = color.white, bgcolor = secHeaderBg, text_size = secTableSize)
                table.cell(secTable, 0, tblChkR, '✅', text_color = color.white, bgcolor = secHeaderBg, text_size = secTableSize)
                for i = 0 to secCount - 1
                    table.cell(secTable, i + 1, tblNowR, array.get(secRowCurrentTxt, i), text_color = array.get(secRowCurrentClr, i), bgcolor = secNowBgColor, text_size = array.get(secRowSize, i), text_halign = text.align_right, tooltip = 'NOW: shows the current price relative to the two nearest levels (Entry/Target events, Reference Levels, and the automatic 1D/1W/4H Open rows) that bracket it (the closest one above and the closest one below). It appears on only ONE column per tick - whichever of those two levels sits on the same side of the halfway point (50%) between them as the current price. If price is at or below that midpoint, it prints on the BELOW level\'s column: an up arrow, the current price, then how many dollars still short of that level. If price is above the midpoint, it prints on the ABOVE level\'s column: how many dollars past that level already, then a down arrow and the current price. Every other column stays blank, and if price sits beyond every level on one side (no bracketing pair), the whole row is blank and the table title adds "Price Off Limits".')
                    table.cell(secTable, i + 1, 2, array.get(secRowPriceTxt, i), text_color = array.get(secRowTxtCol2, i), bgcolor = array.get(secRowBgCol2, i), text_size = array.get(secRowSize, i))
                    table.cell(secTable, i + 1, tblChkR, array.get(secRowTxt3, i), text_color = array.get(secRowTxtCol3, i), bgcolor = secHeaderBg, text_size = array.get(secRowSize, i))

////////////////////////////////////////////////////////////////////////////
////  END  S H O R T - T E R M   S U M M A R Y   T A B L E               ///
////  ( E N T R Y / T A R G E T / W E E K L Y / R E F )                  ///
////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
////      M E R G E D   S U M M A R Y   T A B L E         ///
////////////////////////////////////////////////////////////
// Built only when "Merge Both Tables Into One" is on. Reads the rows
// exported by both tables above (mlx* = Mid/Long-Term, stx* = SHORT-TERM).
// Slot (column in Vertical / row in Horizontal) order:
//   NOW on Left/Top    → NOW | M/L ✓ | M/L TARGET | S/T TARGET | S/T ✓
//   NOW on Right/Bottom→ M/L ✓ | M/L TARGET | S/T TARGET | S/T ✓ | NOW
//   Split              → M/L ✓ | M/L NOW | M/L TARGET | S/T TARGET | S/T NOW | S/T ✓
//     (each split NOW cell uses its own ladder's original NOW text and
//     marker color, still aligned on the shared NOW row)
// NOW-row alignment: each ladder has an anchor row (its NOW-marker row).
// Both ladders are shifted down so their anchors land on the same merged
// row (mgRowR = the larger of the two anchors); the ladder with the
// smaller anchor gets blank padding rows above it. The single NOW cell
// on that row shows the M/L distance, the current price, and the S/T
// distance (➖ = price below that level, ➕ = price above it). Its text
// color follows the M/L marker colors (S/T's when M/L has no marker).
var table mergedTable = na
if barstate.islast
    table.delete(mergedTable)
    if tblMerge and (mlxCount > 0 or stxCount > 0)
        mgMlOn   = mlxCount > 0
        mgStOn   = stxCount > 0
        mgAnchM  = mgMlOn ? mlxAnchor : 0
        mgAnchS  = mgStOn ? stxAnchor : 0
        mgRowR   = math.max(mgAnchM, mgAnchS)
        mgOffM   = mgRowR - mgAnchM
        mgOffS   = mgRowR - mgAnchS
        mgRows   = math.max(mgMlOn ? mgOffM + mlxCount : 0, mgStOn ? mgOffS + stxCount : 0)
        mgVert   = tblMergedOrient == 'Vertical'
        mgNowFirst = tblMergedNowSide == 'Left / Top'
        mgSplit    = tblMergedNowSide == 'Split (M/L Left · S/T Right)'

        // Split-mode NOW texts — same format as each separate table's own
        // NOW marker (blank when that ladder is off limits).
        mgMlNowTxt = mlxNowDir == -1 ? '➖' + str.tostring(mlxNowDiff, '$0,000') + '⁝\n↳ ' + str.tostring(close, '$0,000') : mlxNowDir == 1 ? '↱ ' + str.tostring(close, '$0,000') + '\n➕' + str.tostring(mlxNowDiff, '$0,000') + '⁝' : ''
        mgStNowTxt = stxNowDir == -1 ? '➖' + str.tostring(stxNowDiff, '$0,000') + '⁝\n↳ ' + str.tostring(close, '$0,000') : stxNowDir == 1 ? '↱ ' + str.tostring(close, '$0,000') + '\n➕' + str.tostring(stxNowDiff, '$0,000') + '⁝' : ''

        // Single NOW cell text (both ladders' NOW values on one row).
        mgMlPart = mlxNowDir == 1 ? 'M/L ➕' + str.tostring(mlxNowDiff, '$0,000') + '⁝' : mlxNowDir == -1 ? 'M/L ➖' + str.tostring(mlxNowDiff, '$0,000') + '⁝' : 'M/L Off Limits'
        mgStPart = stxNowDir == 1 ? 'S/T ➕' + str.tostring(stxNowDiff, '$0,000') + '⁝' : stxNowDir == -1 ? 'S/T ➖' + str.tostring(stxNowDiff, '$0,000') + '⁝' : 'S/T Off Limits'
        mgNowTxt = (mgMlOn ? mgMlPart + '\n' : '') + '⨀ ' + str.tostring(close, '$0,000') + (mgStOn ? '\n' + mgStPart : '')
        mgNowClr = mgMlOn and mlxNowDir != 0 ? mlxNowClr : mgStOn and stxNowDir != 0 ? stxNowClr : color.white

        mgOffLimM = mgMlOn and mlxNowDir == 0
        mgOffLimS = mgStOn and stxNowDir == 0
        mgTitle   = mgOffLimM or mgOffLimS ? tblMergedTitle + '\nPrice Off Limits' + (mgOffLimM and mgOffLimS ? '' : mgOffLimM ? ' (M/L)' : ' (S/T)') : tblMergedTitle

        // Slot types: 0 NOW (combined), 1 M/L ✓, 2 M/L TARGET, 3 S/T TARGET,
        // 4 S/T ✓, 5 M/L NOW (split), 6 S/T NOW (split).
        mgSlots = array.new_int(0)
        if mgNowFirst
            array.push(mgSlots, 0)
        if mgMlOn
            array.push(mgSlots, 1)
            if mgSplit
                array.push(mgSlots, 5)
            array.push(mgSlots, 2)
        if mgStOn
            array.push(mgSlots, 3)
            if mgSplit
                array.push(mgSlots, 6)
            array.push(mgSlots, 4)
        if not mgNowFirst and not mgSplit
            array.push(mgSlots, 0)
        mgSlotCount = array.size(mgSlots)

        mgMlHdrBg = color.new(mltHeaderColor, 20)
        mgStHdrBg = color.new(secHeaderColor, 20)
        mgClear   = color.new(color.black, 100)
        mgNowTip  = 'NOW (merged): both ladders are aligned so their NOW rows coincide. M/L = distance to the bracketing Mid/Long-Term marker level, S/T = distance to the bracketing SHORT-TERM marker level (➖ price is below that level, ➕ price is above it); the middle line is the current price. "Off Limits" means price sits beyond every level of that ladder on one side.'

        mergedTable := mgVert ? table.new(tblMergedPos, mgSlotCount, mgRows + 2, border_width = 1, border_color = color.new(color.black, 50)) : table.new(tblMergedPos, mgRows + 1, mgSlotCount + 1, border_width = 1, border_color = color.new(color.black, 50))
        table.cell(mergedTable, 0, 0, mgTitle, text_color = color.white, bgcolor = mltTitleBgColor, text_size = tblMergedSize)
        if mgVert
            table.merge_cells(mergedTable, 0, 0, mgSlotCount - 1, 0)
        else
            table.merge_cells(mergedTable, 0, 0, mgRows, 0)

        for s = 0 to mgSlotCount - 1
            mgTyp  = array.get(mgSlots, s)
            mgHTxt = mgTyp == 0 or mgTyp == 5 or mgTyp == 6 ? 'NOW' : mgTyp == 2 ? 'M/L TARGET' : mgTyp == 3 ? 'S/T TARGET' : '✅'
            mgHBg  = mgTyp == 0 or mgTyp == 5 ? mltNowBgColor : mgTyp == 6 ? secNowBgColor : mgTyp <= 2 ? mgMlHdrBg : mgStHdrBg
            if mgVert
                table.cell(mergedTable, s, 1, mgHTxt, text_color = color.white, bgcolor = mgHBg, text_size = tblMergedSize)
            else
                table.cell(mergedTable, 0, s + 1, mgHTxt, text_color = color.white, bgcolor = mgHBg, text_size = tblMergedSize)
            for r = 0 to mgRows - 1
                string mgTxt    = ''
                color  mgTxtCol = color.white
                color  mgBg     = mgClear
                string mgSize   = tblMergedSize
                string mgTip    = ''
                if mgTyp == 0
                    mgBg := mltNowBgColor
                    if r == mgRowR
                        mgTxt    := mgNowTxt
                        mgTxtCol := mgNowClr
                        mgTip    := mgNowTip
                else if mgTyp == 5
                    mgBg := mltNowBgColor
                    if r == mgRowR and mlxNowDir != 0
                        mgTxt    := mgMlNowTxt
                        mgTxtCol := mlxNowClr
                        mgTip    := 'M/L NOW: distance from the current price to the bracketing Mid/Long-Term level on this row (➖ price is below it, ➕ price is above it). Aligned on the same row as the S/T NOW.'
                else if mgTyp == 6
                    mgBg := secNowBgColor
                    if r == mgRowR and stxNowDir != 0
                        mgTxt    := mgStNowTxt
                        mgTxtCol := stxNowClr
                        mgTip    := 'S/T NOW: distance from the current price to the bracketing SHORT-TERM level on this row (➖ price is below it, ➕ price is above it). Aligned on the same row as the M/L NOW.'
                else if mgTyp <= 2
                    iM = r - mgOffM
                    if iM >= 0 and iM < mlxCount
                        mgSize := array.get(mlxSize, iM)
                        if mgTyp == 2
                            mgTxt    := array.get(mlxPriceTxt, iM)
                            mgTxtCol := array.get(mlxTxtCol2, iM)
                            mgBg     := array.get(mlxBg, iM)
                        else
                            mgTxt    := array.get(mlxTxt3, iM)
                            mgTxtCol := array.get(mlxTxtCol3, iM)
                            mgBg     := mgMlHdrBg
                else
                    iS = r - mgOffS
                    if iS >= 0 and iS < stxCount
                        mgSize := array.get(stxSize, iS)
                        if mgTyp == 3
                            mgTxt    := array.get(stxPriceTxt, iS)
                            mgTxtCol := array.get(stxTxtCol2, iS)
                            mgBg     := array.get(stxBg, iS)
                        else
                            mgTxt    := array.get(stxTxt3, iS)
                            mgTxtCol := array.get(stxTxtCol3, iS)
                            mgBg     := mgStHdrBg
                mgHalign = not mgVert ? text.align_center : mgTyp == 0 ? (mgNowFirst ? text.align_right : text.align_left) : mgTyp == 5 ? text.align_right : mgTyp == 6 ? text.align_left : text.align_center
                if mgVert
                    table.cell(mergedTable, s, r + 2, mgTxt, text_color = mgTxtCol, bgcolor = mgBg, text_size = mgSize, text_halign = mgHalign, tooltip = mgTip)
                else
                    table.cell(mergedTable, r + 1, s + 1, mgTxt, text_color = mgTxtCol, bgcolor = mgBg, text_size = mgSize, text_halign = mgHalign, tooltip = mgTip)

////////////////////////////////////////////////////////////
////   END  M E R G E D   S U M M A R Y   T A B L E       ///
////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
////        L E V E L   P I X E L   D I A L S              ///
////////////////////////////////////////////////////////////
// Optional replacement for the two summary tables (Summary Display =
// 'Pixel Dials' in the 🪙 P I X E L - D I A L S group). Each ladder
// (Mid/Long-Term, SHORT-TERM) becomes a round 240° dial built from table
// cells, in the same style as CQ_(7)_[TACHIMETER]'s Pixel Dial:
//   - 12:00 = the ladder's level closest to the current price (keeps its
//     own tag and color; the current price itself if the ladder is empty).
//   - Scale: the nearest levels of that ladder BELOW it (Levels Below,
//     default 3) run counter-clockwise from 12:00 to 8:00 (−120°); the
//     nearest ABOVE (Levels Above, default 3) run clockwise to 4:00
//     (+120°). Every gap between consecutive marks gets an equal share of
//     its side's 120° (40° with 3 levels, 30° with 4; a side with fewer
//     levels available spreads them over the same 120°). Each level shows as
//     its price label on the scale, in its own color — the 12:00 level's label
//     is white and always visible: inside the dial at 12:00 by default
//     (covering the needle while it passes), or in its own row above the
//     ring when that option is ON —
//     hover a label for its source tag (M, L, Y, PY / E1, T1, R1, 1D …).
//   - Needle: the current price, placed by straight-line interpolation
//     between the two marks it sits between; pegged at the end of the
//     scale beyond the outermost level. The arc between 12:00 and the
//     needle lights up (bull colors above the 12:00 level, bear below).
//   - Title row: with Title Row Follows Needle ON, each dial's title row
//     takes the Up color while its needle points right of 12:00 (price
//     above the 12:00 level) and the Down color while it points left;
//     neutral gray with price exactly on the 12:00 level (or option OFF).
//   - Scale Refresh (one input per dial): the SHORT-TERM dial defaults
//     to Every 1D, the MID/LONG dial to Every 1W — the scale (12:00
//     level + its neighbors) is a snapshot taken when that candle opens
//     and kept until the next one, so it never shifts under the needle.
//     Live: the scale is rebuilt every tick, so 12:00 always holds the
//     level closest to the current price. Changing any input rebuilds
//     it immediately.
//   - Colors: face, needle, unlit ring, caption, 🕛 label, label blend
//     tone and tag text follow the Dial Color Theme (Custom = the
//     individual color inputs); the face fades toward the bottom when
//     Dial Face Gradient is on.
//   - Auto Dim: during the Dim Period (default 7 PM – 7 AM) every dial
//     color passes through f_ldDim, which cuts its opacity by the dim
//     amount (default 30%).
// Both dials sit side by side in one panel at Dials Position (order set
// by Dial Order — SHORT-TERM left by default), like the Tachimeter's
// X10 / X100 Pixel Dials. Each dial follows its own table's Show Table toggle and Table
// Title; its level pool uses the same sources and include toggles as
// that table. Neither the separate nor the merged tables are drawn
// in this mode.
LD_COLS = 41
LD_ROWS = 27
LD_CX   = 20.0
LD_CY   = 18.5
LD_R    = 17.2
LD_GAP  = 2      // blank columns between the two dials

// Dial face color for grid row j: the theme face color at the top, fading
// to Bottom Opacity % of its own opacity at the last row.
f_ldFaceAt(int j) =>
    float topOp = 100 - color.t(ldThFace)
    float frac  = ldFaceGrad ? j / (LD_ROWS - 1.0) : 0.0
    float op    = topOp * (1 - frac * (1 - ldFaceGradPct / 100.0))
    color.new(ldThFace, 100 - op)

// Open time of the current Daily / Weekly candle — the refresh triggers of
// the SHORT-TERM (Every 1D) and MID/LONG (Every 1W) dials.
ldTime1D = request.security(syminfo.tickerid, 'D', time, lookahead = barmerge.lookahead_on)
ldTime1W = request.security(syminfo.tickerid, 'W', time, lookahead = barmerge.lookahead_on)

f_ldAtan2(float y, float x) =>
    x > 0 ? math.atan(y / x) :
     x < 0 and y >= 0 ? math.atan(y / x) + math.pi :
     x < 0 ? math.atan(y / x) - math.pi :
     y > 0 ? math.pi / 2 : y < 0 ? -math.pi / 2 : 0.0

// Pixel (dx, dy from the hub) lies on the needle ray at angle tRad.
f_ldNeedle(float dx, float dy, float tRad, float perpMax, float len) =>
    float proj = dx * math.sin(tRad) + dy * math.cos(tRad)
    float perp = math.abs(dx * math.cos(tRad) - dy * math.sin(tRad))
    proj > 0 and proj < len and perp < perpMax

// Mixes a color toward the theme's label tone by _pct % (0 = unchanged,
// 100 = the tone: white in Custom, the number color in preset themes), opaque.
f_ldLighten(color _c, int _pct) =>
    float _k = _pct / 100.0
    color _t = ldLabelTone
    color.rgb(color.r(_c) + (color.r(_t) - color.r(_c)) * _k, color.g(_c) + (color.g(_t) - color.g(_c)) * _k, color.b(_c) + (color.b(_t) - color.b(_c)) * _k)

// Pushes one level (price, color, tag) into a pool, skipping na prices.
f_ldPush(float[] _p, color[] _c, string[] _s, float _v, color _col, string _tag) =>
    if not na(_v)
        array.push(_p, _v)
        array.push(_c, _col)
        array.push(_s, _tag)

// Mid/Long-Term pool — same sources and toggles as the Mid/Long-Term Table.
f_ldPoolML() =>
    _p = array.new_float(0)
    _c = array.new_color(0)
    _s = array.new_string(0)
    for y in pMidTerm
        f_ldPush(_p, _c, _s, y, MidTermColor, 'M')
    for y in pLongTerm
        f_ldPush(_p, _c, _s, y, LongTermColor, 'L')
    if showCurrentYearlyOpen
        f_ldPush(_p, _c, _s, yearly_open, CurrentYearlyOpenColor, 'Y')
    if showPrevYearlyOpen
        f_ldPush(_p, _c, _s, prevYearly_open, PrevYearlyOpenColor, 'PY')
    [_p, _c, _s]

// SHORT-TERM pool — same sources and include toggles as the SHORT-TERM Table.
f_ldPoolST() =>
    _p = array.new_float(0)
    _c = array.new_color(0)
    _s = array.new_string(0)
    if secInclEntry1
        for y in pEventsEntry
            f_ldPush(_p, _c, _s, y, event_entry_Color, 'E1')
    if secInclTarget1
        for y in pEventsTarget
            f_ldPush(_p, _c, _s, y, event_target_Color, 'T1')
    if secInclRefs
        f_ldPush(_p, _c, _s, ref1Price, ref1Color, 'R1')
        f_ldPush(_p, _c, _s, ref2Price, ref2Color, 'R2')
    if show1DOpen
        f_ldPush(_p, _c, _s, dailyOpenPrice, secDailyOpenColor, '1D')
    if show1WOpen
        f_ldPush(_p, _c, _s, sundayOpen, secWeeklyOpenColor, '1W')
    if show4HOpen
        f_ldPush(_p, _c, _s, fourHOpenPrice, sec4HOpenColor, '4H')
    [_p, _c, _s]

// Builds a dial scale from a pool. The 12:00 level (the anchor) is the
// pool level closest to _ref (the current price at snapshot time), keeping
// its own color and tag; with an empty pool it falls back to _ref itself,
// tagged PRICE. Then up to _maxB distinct levels below the anchor and up
// to _maxA above it are added, nearest first (other levels priced exactly
// at the anchor are skipped). Returned arrays run low → high: [farthest
// below … nearest below, 12:00 level, nearest above … farthest above], so
// index _nB is always the 12:00 level.
f_ldBuildScale(float _ref, float[] _p, color[] _c, string[] _s, int _maxB, int _maxA) =>
    float  _anchor = _ref
    color  _aCol   = color.white
    string _aTag   = 'PRICE'
    if array.size(_p) > 0
        float _best = na
        for [i, v] in _p
            if na(_best) or math.abs(v - _ref) < _best
                _best   := math.abs(v - _ref)
                _anchor := v
                _aCol   := array.get(_c, i)
                _aTag   := array.get(_s, i)
    _bP = array.new_float(0)
    _bI = array.new_int(0)
    _aP = array.new_float(0)
    _aI = array.new_int(0)
    if array.size(_p) > 0
        for [i, v] in _p
            if v < _anchor
                array.push(_bP, v)
                array.push(_bI, i)
            else if v > _anchor
                array.push(_aP, v)
                array.push(_aI, i)
    _v = array.new_float(0)
    _col = array.new_color(0)
    _tag = array.new_string(0)
    int _nB = 0
    if array.size(_bP) > 0
        float _last = na
        _ordB = array.sort_indices(_bP, order.descending)
        for k in _ordB
            if _nB >= _maxB
                break
            float v = array.get(_bP, k)
            if na(_last) or v != _last
                array.unshift(_v, v)
                array.unshift(_col, array.get(_c, array.get(_bI, k)))
                array.unshift(_tag, array.get(_s, array.get(_bI, k)))
                _nB += 1
                _last := v
    array.push(_v, _anchor)
    array.push(_col, _aCol)
    array.push(_tag, _aTag)
    int _nA = 0
    if array.size(_aP) > 0
        float _last = na
        _ordA = array.sort_indices(_aP, order.ascending)
        for k in _ordA
            if _nA >= _maxA
                break
            float v = array.get(_aP, k)
            if na(_last) or v != _last
                array.push(_v, v)
                array.push(_col, array.get(_c, array.get(_aI, k)))
                array.push(_tag, array.get(_s, array.get(_aI, k)))
                _nA += 1
                _last := v
    [_v, _col, _tag, _nB, _nA]

// Needle angle (degrees, 0 = 12:00, + clockwise) for a price on a scale:
// linear between the two marks it sits between, pegged at ±120° beyond
// the outermost level, 0 when that side of the 12:00 level has no levels.
f_ldAngle(float _price, float[] _v, int _nB, int _nA) =>
    float _anchor = array.get(_v, _nB)
    float _ang = 0.0
    if _price >= _anchor and _nA > 0
        float _step = 120.0 / _nA
        float _prevP = _anchor
        float _prevA = 0.0
        _ang := 120.0
        for k = 1 to _nA
            float _p = array.get(_v, _nB + k)
            float _a = k * _step
            if _price <= _p
                _ang := _prevA + (_p > _prevP ? (_price - _prevP) / (_p - _prevP) : 1.0) * (_a - _prevA)
                break
            _prevP := _p
            _prevA := _a
    else if _price < _anchor and _nB > 0
        float _step = 120.0 / _nB
        float _prevP = _anchor
        float _prevA = 0.0
        _ang := -120.0
        for k = 1 to _nB
            float _p = array.get(_v, _nB - k)
            float _a = -k * _step
            if _price >= _p
                _ang := _prevA + (_p < _prevP ? (_prevP - _price) / (_prevP - _p) : 1.0) * (_a - _prevA)
                break
            _prevP := _p
            _prevA := _a
    _ang

// Draws one level dial into _tb starting at column _ox: title row 0, the
// 12:00-level label in row 1 when its own-row option is ON, then the dial
// rows (from row _r0), then four info rows
// (12:00 level, PRICE, next level above, next level below), all spanning
// only this dial's own columns. Every color passes through f_ldDim.
f_ldDial(table _tb, int _ox, float[] _v, color[] _c, string[] _s, int _nB, int _nA, string _title, string _cap, float _pw, float _ph, string _mSz, string _tSz) =>
    float _anchor = array.get(_v, _nB)
    float _nAng   = f_ldAngle(close, _v, _nB, _nA)
    float _tRad   = math.toradians(_nAng)
    float _sweep  = math.toradians(120.0)
    float _nPerp  = 0.3 + 0.2 * ldNeedleW
    float _nLen   = LD_R - 2.4
    float _hubR   = 1.0 + 0.15 * ldNeedleW
    float _faceR  = LD_R * 1.08
    int   _r0     = ldTopRow ? 2 : 1    // table row of grid row 0 (row 1 = 12:00 label row when ON)
    color _clear  = color.new(color.black, 100)
    int   _nM     = array.size(_v)
    _mAng = array.new_float(_nM, 0.0)
    for m = 0 to _nM - 1
        int _k = m - _nB
        array.set(_mAng, m, _k < 0 ? _k * 120.0 / _nB : _k > 0 ? _k * 120.0 / _nA : 0.0)

    for j = 0 to LD_ROWS - 1
        color _rowFace = f_ldFaceAt(j)
        for i = 0 to LD_COLS - 1
            float dx  = i - LD_CX
            float dy  = LD_CY - j
            float d   = math.sqrt(dx * dx + dy * dy)
            float a   = f_ldAtan2(dx, dy)
            color col = d <= _faceR ? _rowFace : _clear
            // Ring: lit between the 12:00 level and the needle.
            if math.abs(d - LD_R) < 1.2 and math.abs(a) <= _sweep
                float aDeg = math.todegrees(a)
                bool  lit  = _nAng > 0 ? aDeg >= 0 and aDeg <= _nAng : _nAng < 0 ? aDeg <= 0 and aDeg >= _nAng : false
                col := lit ? (_nAng > 0 ? color.from_gradient(aDeg, 0, 120, ldBullDark, ldBullBright) : color.from_gradient(-aDeg, 0, 120, ldBearDark, ldBearBright)) : ldThTrack
            // Needle and hub.
            if f_ldNeedle(dx, dy, _tRad, _nPerp, _nLen) or d < _hubR
                col := ldThNeedle
            table.cell(_tb, _ox + i, j + _r0, '', width = _pw, height = _ph, bgcolor = f_ldDim(col))

    // Scale price labels in each level's own color, blended toward the
    // theme's label tone by Price Label Brightness (the 12:00 level uses
    // the tone itself); hidden while the needle crosses a
    // block so the needle is never covered. Hover a label for its source
    // tag. Block size / radius follow the larger of the two level-count
    // settings (W × H pixels at rf × radius):
    //   ≤4 → 8 × 2 @ 0.68 · 5 → 8 × 1 @ 0.64 · 6 → 7 × 1 @ 0.66
    //    7 → 7 × 1 @ 0.71 · 8 → 6 × 1 @ 0.71
    // Each was verified for every combination of 0..N levels below and
    // above the 12:00 level: no label overlaps another, the ring or the caption.
    // 8-wide blocks print the full price (117,250); narrower ones the
    // compact form (117.3K).
    int   _maxN = math.max(ldNBelow, ldNAbove)
    int   _bw   = _maxN <= 5 ? 8 : _maxN <= 7 ? 7 : 6
    int   _bh   = _maxN <= 4 ? 2 : 1
    float _rf   = _maxN <= 4 ? 0.68 : _maxN == 5 ? 0.64 : _maxN == 6 ? 0.66 : 0.71
    for m = 0 to _nM - 1
        bool _isC = m == _nB
        if _isC and ldTopRow
            continue
        float ta  = math.toradians(array.get(_mAng, m))
        int   i0  = int(math.round(LD_CX + LD_R * _rf * math.sin(ta) - (_bw - 1) / 2.0))
        int   j0  = int(math.round(LD_CY - LD_R * _rf * math.cos(ta) - (_bh - 1) / 2.0))
        bool  hit = false
        for jj = j0 to j0 + _bh - 1
            for ii = i0 to i0 + _bw - 1
                float bdx = ii - LD_CX
                float bdy = LD_CY - jj
                if f_ldNeedle(bdx, bdy, _tRad, _nPerp, _nLen) or math.sqrt(bdx * bdx + bdy * bdy) < _hubR
                    hit := true
        // The 12:00 label (inside-the-dial placement) is never hidden: in
        // Live mode the needle sits near 12:00 almost all the time, so
        // hiding it would leave 12:00 blank — it covers the needle instead.
        if not hit or _isC
            float _lv  = array.get(_v, m)
            string _lt = _bw >= 8 or _lv < 1000 ? str.tostring(_lv, '#,###') : str.tostring(_lv / 1000, '#.#') + 'K'
            table.cell(_tb, _ox + i0, j0 + _r0, _lt, width = _pw, height = _ph,
                 text_color = f_ldDim(_isC ? ldLabelTone : f_ldLighten(array.get(_c, m), ldBright)), text_size = _mSz, bgcolor = f_ldDim(f_ldFaceAt(j0)),
                 tooltip = (_isC ? '🕛 ' : '') + array.get(_s, m) + ' ' + str.tostring(_lv, '$0,000'))
            table.merge_cells(_tb, _ox + i0, j0 + _r0, _ox + i0 + _bw - 1, j0 + _bh + _r0 - 1)

    // 12:00 level in its own row (option ON): directly above the top of the
    // ring, spanning the dial's full width and centered on 12:00. The needle
    // never reaches past the ring, so this label is never covered and never
    // covers the needle.
    if ldTopRow
        float _cv = array.get(_v, _nB)
        table.cell(_tb, _ox, 1, '🕛 ' + array.get(_s, _nB) + ' ' + str.tostring(_cv, '#,###'), width = _pw,
             text_color = f_ldDim(ldThText), text_size = _mSz, bgcolor = color.new(color.black, 100),
             tooltip = '🕛 ' + array.get(_s, _nB) + ' ' + str.tostring(_cv, '$0,000') + ' — the level closest to the current price')
        table.merge_cells(_tb, _ox, 1, _ox + LD_COLS - 1, 1)

    // Caption (M/L · S/T) in the open bottom, clear of the needle at any thickness.
    table.cell(_tb, _ox + 17, 23 + _r0, _cap, width = _pw, height = _ph, text_color = f_ldDim(ldThNum), text_size = _mSz, bgcolor = f_ldDim(f_ldFaceAt(23)))
    table.merge_cells(_tb, _ox + 17, 23 + _r0, _ox + 23, 26 + _r0)

    // Nearest scale levels above / below the current price.
    float  _upP = na
    string _upS = ''
    float  _dnP = na
    string _dnS = ''
    for [m, v] in _v
        if v > close and (na(_upP) or v < _upP)
            _upP := v
            _upS := array.get(_s, m)
        if v <= close and (na(_dnP) or v > _dnP)
            _dnP := v
            _dnS := array.get(_s, m)

    bool  _isUp = close >= _anchor
    color _itc  = f_ldDim(color.new(ldInfoBase, 100 - ldInfoTxtOp))
    color _hdr  = f_ldDim(color.new(color.rgb(54, 58, 69), 50))
    color _val  = f_ldDim(color.new(_isUp ? color.teal : color.red, 50))
    // Title row follows the needle: Up color right of 12:00 (price above
    // the 12:00 level), Down color left of it; neutral gray on the level.
    color _ttl  = not ldTitleDir or close == _anchor ? _hdr : f_ldDim(close > _anchor ? ldTitleUpCol : ldTitleDnCol)
    table.cell(_tb, _ox, 0, _title, width = _pw, text_color = f_ldDim(ldThText), text_size = _tSz, bgcolor = _ttl)
    table.merge_cells(_tb, _ox, 0, _ox + LD_COLS - 1, 0)
    table.cell(_tb, _ox, LD_ROWS + 1 + _r0 - 1, '🕛 ' + array.get(_s, _nB) + ' ' + str.tostring(_anchor, '$0,000'), width = _pw, text_color = _itc, text_size = _tSz, bgcolor = _hdr)
    table.merge_cells(_tb, _ox, LD_ROWS + 1 + _r0 - 1, _ox + LD_COLS - 1, LD_ROWS + 1 + _r0 - 1)
    table.cell(_tb, _ox, LD_ROWS + 2 + _r0 - 1, 'PRICE ' + str.tostring(close, '$0,000') + (_isUp ? '  ▲ +' : '  ▼ −') + str.tostring(math.abs(close - _anchor), '$0,000'), width = _pw, text_color = _itc, text_size = _tSz, bgcolor = _val)
    table.merge_cells(_tb, _ox, LD_ROWS + 2 + _r0 - 1, _ox + LD_COLS - 1, LD_ROWS + 2 + _r0 - 1)
    table.cell(_tb, _ox, LD_ROWS + 3 + _r0 - 1, na(_upP) ? '↑ —' : '↑ ' + str.tostring(_upP, '$0,000') + ' ' + _upS + '  +' + str.tostring(_upP - close, '$0,000'), width = _pw, text_color = _itc, text_size = _tSz, bgcolor = _hdr)
    table.merge_cells(_tb, _ox, LD_ROWS + 3 + _r0 - 1, _ox + LD_COLS - 1, LD_ROWS + 3 + _r0 - 1)
    table.cell(_tb, _ox, LD_ROWS + 4 + _r0 - 1, na(_dnP) ? '↓ —' : '↓ ' + str.tostring(_dnP, '$0,000') + ' ' + _dnS + '  −' + str.tostring(close - _dnP, '$0,000'), width = _pw, text_color = _itc, text_size = _tSz, bgcolor = _hdr)
    table.merge_cells(_tb, _ox, LD_ROWS + 4 + _r0 - 1, _ox + LD_COLS - 1, LD_ROWS + 4 + _r0 - 1)

// Scale snapshots (one per dial): SHORT-TERM refreshed once per 1D candle,
// MID/LONG once per 1W candle (unless that dial's Scale Refresh is Live).
var float[]  ldMlV  = array.new_float(0)
var color[]  ldMlC  = array.new_color(0)
var string[] ldMlS  = array.new_string(0)
var int      ldMlNB = 0
var int      ldMlNA = 0
var int      ldMlT  = na
var float[]  ldStV  = array.new_float(0)
var color[]  ldStC  = array.new_color(0)
var string[] ldStS  = array.new_string(0)
var int      ldStNB = 0
var int      ldStNA = 0
var int      ldStT  = na

// One panel holds both dials side by side — order set by Dial Order
// (SHORT-TERM left by default), LD_GAP blank columns between them — like the Tachimeter's
// X10 / X100 Pixel Dials. A dial whose table toggle is off is left out.
var table ldTable = na
if barstate.islast
    table.delete(ldTable)
    bool ldMlOn = lvlDialMode and showMltTable
    bool ldStOn = lvlDialMode and showSecTable
    if ldMlOn or ldStOn
        float  ldPw  = ldPxW * ldScale
        float  ldPh  = ldPxH * ldScale
        string ldMSz = ldMarkSizeRaw == 'Auto' ? size.auto : f_mltTextSize(ldMarkSizeRaw)
        string ldTSz = f_mltTextSize(ldTagSizeRaw)

        // Scale rebuild: every tick in Live mode, else once per 1W candle
        // (MID/LONG) / 1D candle (SHORT-TERM).
        if ldMlOn and (ldLiveML or na(ldMlT) or ldTime1W != ldMlT or array.size(ldMlV) == 0)
            [mlPoolP, mlPoolC, mlPoolS] = f_ldPoolML()
            [mlSv, mlSc, mlSs, mlNb, mlNa] = f_ldBuildScale(close, mlPoolP, mlPoolC, mlPoolS, ldNBelow, ldNAbove)
            ldMlV  := mlSv
            ldMlC  := mlSc
            ldMlS  := mlSs
            ldMlNB := mlNb
            ldMlNA := mlNa
            ldMlT  := ldTime1W
        if ldStOn and (ldLiveST or na(ldStT) or ldTime1D != ldStT or array.size(ldStV) == 0)
            [stPoolP, stPoolC, stPoolS] = f_ldPoolST()
            [stSv, stSc, stSs, stNb, stNa] = f_ldBuildScale(close, stPoolP, stPoolC, stPoolS, ldNBelow, ldNAbove)
            ldStV  := stSv
            ldStC  := stSc
            ldStS  := stSs
            ldStNB := stNb
            ldStNA := stNa
            ldStT  := ldTime1D

        bool ldBoth = ldMlOn and ldStOn
        int  ldCols = ldBoth ? 2 * LD_COLS + LD_GAP : LD_COLS
        int  ldR0   = ldTopRow ? 2 : 1
        ldTable := table.new(f_mltTablePos(ldPosRaw), ldCols, LD_ROWS + 4 + ldR0, border_width = 1, border_color = color.new(color.black, 100))
        // Dial Order: the left dial starts at column 0, the right one after
        // the gap (a lone dial always starts at 0).
        bool ldStLeft = ldOrder == 'SHORT-TERM | MID/LONG'
        int  ldRightX = LD_COLS + LD_GAP
        if ldMlOn
            f_ldDial(ldTable, ldBoth and ldStLeft ? ldRightX : 0, ldMlV, ldMlC, ldMlS, ldMlNB, ldMlNA, mltTableTitle, 'M/L', ldPw, ldPh, ldMSz, ldTSz)
        if ldStOn
            f_ldDial(ldTable, ldBoth and not ldStLeft ? ldRightX : 0, ldStV, ldStC, ldStS, ldStNB, ldStNA, secTableTitle, 'S-T', ldPw, ldPh, ldMSz, ldTSz)
        // Blank gap columns between the dials.
        if ldBoth
            for g = 0 to LD_GAP - 1
                for j = 0 to LD_ROWS + 3 + ldR0
                    table.cell(ldTable, LD_COLS + g, j, '', width = ldPw, height = j >= ldR0 and j < LD_ROWS + ldR0 ? ldPh : 0, bgcolor = color.new(color.black, 100))

////////////////////////////////////////////////////////////
////   END  L E V E L   P I X E L   D I A L S            ///
////////////////////////////////////////////////////////////

//EOF
````


