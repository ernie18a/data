i_dAction   = input.bool(true, "Action", inline="dr4", group="Dashboard Rows")
i_dSigTail = input.string("Stop When In Position", "Signal Row Trailing Value", options=["Score", "Stop When In Position", "Both"], group="Dashboard Rows", tooltip="v1.8.5. What the Signal row ends with.\n\nSCORE: the 0-100 entry confluence score, always — the pre-v1.8.5 behavior.\nSTOP WHEN IN POSITION (default): the score until a signal confirms, then the live structural stop and its distance from price, e.g. ⊣ 231.40 (4.2%). Once you are in the trade the entry score is history; the stop is the number you act on. Which level is shown is set by Signal Engine > Stop Reference (bus).\nBOTH: score and stop together while in a position — widest, most complete.\n\nA dash means the selected stop reference has no value yet, e.g. Spring / UT Extreme before any qualified spring has printed.")
i_dSigSlopePct = input.bool(false, "Show Slope % in Signal Row", group="Dashboard Rows", tooltip="v1.8.5. Appends the measured slope percentages of the SLOPE-MEMBER EMAs immediately after the S flag, e.g. 'S✗ 0.42/0.18%', in slot order. These are the exact numbers the slope gate compares against Min Slope % over Lookback, so this is how you calibrate that threshold: turn it on, watch bars where the EMAs look clearly directional to you, and set the threshold just above the noise. Off by default because once calibrated you want the row narrow again. The same figures are always available in the row tooltip.")

i_brkOn   = input.bool(true, "Show Forecast Breakdown", group="Breakdown Table", tooltip="Component-by-component audit of the net score — score x weight = contribution. For model evaluation and improvement.")
i_brkPos  = input.string("Bottom Left", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group="Breakdown Table", tooltip="Where the Forecast Breakdown table sits on the chart.")
i_brkSize = input.string("Tiny", "Size", options=["Tiny", "Small", "Normal", "Large"], group="Breakdown Table", tooltip="Text size of the Forecast Breakdown table.")

// Breakdown row toggles
i_bMA   = input.bool(true, "MA Structure", inline="br1", group="Breakdown Rows", tooltip="Toggle any forecast component row on or off in the breakdown audit table.")
i_bReg  = input.bool(true, "Regime", inline="br1", group="Breakdown Rows")
i_bPos  = input.bool(true, "Entry Value", inline="br1", group="Breakdown Rows")
i_bDiv  = input.bool(true, "Divergence", inline="br2", group="Breakdown Rows")
i_bWyck = input.bool(true, "Wyckoff", inline="br2", group="Breakdown Rows")
i_bDisc = input.bool(true, "Discretionary", inline="br2", group="Breakdown Rows")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — Signal Engine (reversal reclaim + EMA1-test entries)
// ═══════════════════════════════════════════════════════════════════════════

i_sigOn   = input.bool(true, "Enable Signal Engine", group="Signal Engine", tooltip="Master switch for the mechanical entry engine (fresh reversal reclaim + EMA test). Its chart markers can still be toggled separately in Signal Display.")
i_sig1 = input.bool(true, "EMA1", inline="se1", group="Signal Engine")
i_sig2 = input.bool(true, "EMA2", inline="se1", group="Signal Engine")
i_sig3 = input.bool(true, "EMA3", inline="se1", group="Signal Engine")
i_sig4 = input.bool(false, "EMA4", inline="se2", group="Signal Engine")
i_sig5 = input.bool(false, "EMA5", inline="se2", group="Signal Engine")
i_sig6 = input.bool(true, "EMA6", inline="se2", group="Signal Engine", tooltip="Which EMAs participate in the signal. Reclaim/positioning, slope alignment, and invalidation are all measured against THESE EMAs only. v1.8: all of them are ranked by effective length for the stack ORDER check; the Stack Order Depth setting decides how many of the fastest must be stacked.")
i_sigTolMode    = input.string("% of Price", "Test Tolerance Mode", options=["% of Price", "ATR Fraction"], group="Signal Engine", tooltip="How close price must be to an EMA to count as TESTING it. ATR Fraction adapts to each ticker's volatility.")
i_sigTestTolPct = input.float(0.3, "Tolerance %", minval=0.05, maxval=3.0, step=0.05, inline="st", group="Signal Engine")
i_sigAtrFrac    = input.float(0.25, "ATR Fraction", minval=0.05, maxval=2.0, step=0.05, inline="st", group="Signal Engine", tooltip="How close price must be to an EMA to count as TESTING it — as a % of price, or as a fraction of ATR (which adapts to each ticker's volatility).")
i_sigAtrLen     = input.int(14, "ATR Length", minval=2, maxval=100, group="Signal Engine", tooltip="ATR length used when the test tolerance is in ATR-fraction mode.")
i_sigBelowTolMult = input.float(1.0, "Below-Tolerance Multiplier", minval=1.0, maxval=5.0, step=0.25, group="Signal Engine", tooltip="v1.8: widens the band used ONLY for classifying an EMA as BELOW price, without widening the band that counts as a TEST. At 1.0 (default, v1.7 behavior) a close 0.4% under EMA1 with a 0.3% tolerance instantly kills the setup — a routine test candle on a volatile name. 1.5-2.0 gives the test room to breathe while keeping the trigger tight. Applies to both sides.")
i_sigZoneLo = input.float(23.6, "Signal Zone Shallow %", minval=0.0, maxval=99.0, step=0.1, inline="sz", group="Signal Engine")
i_sigZoneHi = input.float(78.6, "Deep %", minval=1.0, maxval=100.0, step=0.1, inline="sz", group="Signal Engine", tooltip="The fib confluence zone for SIGNALS — independent of the display levels. Default 23.6-78.6 = 'within the fib levels'. Golden-pocket-only: 50 / 61.8. A fresh license (reclaim/stack/spring) bypasses this gate in Reclaim+Test mode; the dashboard shows Z-recycle when that happens.")
i_sigZoneRef = input.string("Price or EMA 1", "Zone Check Applies To", options=["Price", "EMA 1", "Price or EMA 1"], group="Signal Engine", tooltip="The confluence you trade is SUPPORT sitting inside the fib levels. 'Price or EMA 1' (default): the zone condition passes when the close OR the tested EMA1 is inside. v1.8: if you pick 'EMA 1' while EMA 1 is disabled, the check falls back to price instead of vetoing forever.")
i_sigZoneDir = input.string("Structure Only", "Signal Zone Orientation", options=["Structure Only", "Follow Display Fib"], group="Signal Engine", tooltip="v1.8 DECOUPLING. In v1.7 the signal zone inherited the DISPLAY fib direction, which follows netScore — so your Discretionary Overlay dropdowns (macro liquidity, catalysts, flows, analyst targets) silently moved the mechanical entry geometry, and a trigger could not be reproduced from price alone. STRUCTURE ONLY (default): the zone orientation comes from the regime, and when the regime is neutral, from which anchor formed LAST (low before high = the last leg was up = retrace down from the high). FOLLOW DISPLAY FIB restores v1.7 exactly.")
i_sigSlopeMode = input.string("All Rising", "Slope Alignment (long)", options=["All Rising", "Majority Rising", "Off"], group="Signal Engine", tooltip="Reversal requirement: slope-member EMA slopes must be rising for longs (falling for shorts). Slope = EMA vs its own value [Slope Lookback] HTF bars ago (HTF MA Stack setting). A fresh license bypasses the alignment requirement entirely — the license IS the reversal evidence, and the dashboard shows S-recycle so you can tell the two apart.")
i_slp1 = input.bool(true, "EMA1", inline="sm1", group="Signal Engine")
i_slp2 = input.bool(true, "EMA2", inline="sm1", group="Signal Engine")
i_slp3 = input.bool(false, "EMA3", inline="sm1", group="Signal Engine")
i_slp4 = input.bool(false, "EMA4", inline="sm2", group="Signal Engine")
i_slp5 = input.bool(false, "EMA5", inline="sm2", group="Signal Engine")
i_slp6 = input.bool(false, "EMA6", inline="sm2", group="Signal Engine", tooltip="Which EMAs' SLOPES the alignment requirement checks. Defaults exclude the slowest (EMA3/200): at genuine reversals its slope is the LAST to turn, and requiring it suppresses exactly the early reclaim setups this engine exists to catch. Price position is still measured against ALL signal EMAs.")
i_sigFreshOn   = input.bool(true, "Require FRESH Slope Flip", inline="sf", group="Signal Engine")
i_sigFreshBars = input.int(10, "within (bars)", minval=1, maxval=100, inline="sf", group="Signal Engine", tooltip="The slope alignment must have BEGUN within this many chart bars — this is what makes it a reversal signal, not a mid-trend state. Alignment older than the window no longer qualifies (unless a fresh license is active).")
i_sigStackOn   = input.bool(true, "Require EMA Stack Order", group="Signal Engine", tooltip="Longs: the fastest EMAs must be in strict descending order — 'freshly recrossed and STACKED'. v1.8: members are ranked by EFFECTIVE length (length x timeframe / chart timeframe), not slot number, so a weekly-50 is correctly treated as the slowest member rather than being excluded by a timeframe-string comparison. How many of the fastest participate is set by Stack Order Depth. Disable to catch earlier reversals before the stack forms.")
i_sigNoBypass = input.bool(true, "Strict: Licenses Cannot Bypass Slope / Zone", group="Signal Engine", tooltip="v1.8.2. ON (default): the slope-alignment and fib-zone conditions are HARD requirements — a fresh license (reclaim / fresh stack / spring) can no longer satisfy them by proxy. The licenses keep their real job, which is deciding WHEN an EMA test counts as an entry trigger, but they stop excusing a condition that is not met. This is what makes the engine behave as a conjunction: stacked AND sloped AND in zone. OFF restores the v1.3-v1.8.1 behavior where a reclaim bar could confirm with falling EMAs outside the zone. The dashboard S and Z flags show a recycle glyph whenever a bypass is in play, so you can see which mode you are in at a glance.")
i_sigNeedPriceInZone = input.bool(true, "Strict: Require Price Inside Zone", group="Signal Engine", tooltip="v1.8.2. Requires the CLOSE itself to sit inside the signal fib zone, independently of the Zone Check Applies To setting. With that set to 'Price or EMA 1' the zone condition passes when the tested EMA is inside even if price is not — useful for boundary entries, but it means a signal can print with price well outside the value area. This makes price-in-zone its own explicit requirement so the two ideas stop being conflated.")
i_sigNeedConf = input.bool(true, "Strict: Require EMA-Fib Confluence", group="Signal Engine", tooltip="v1.8.2. Makes the EMA-Fib confluence — the yellow band, 'a place to do business' — a hard entry requirement rather than a display cue. It was never a gate before; it only tinted the background and the dashboard row, which is why signals could confirm with no confluence present. NOTE ON DIRECTION: the confluence carries the direction set by EMA-Fib Confluence > Slope Direction. At the default 'Positive' the band is bullish by definition, so this gate will only ever pass for LONGS. Set Slope Direction to 'Either' if you want the gate active on both sides.")
i_sigStackDepth = input.int(3, "Stack Order Depth (fastest N)", minval=0, maxval=6, group="Signal Engine", tooltip="How many of the FASTEST signal EMAs must be in strict order, after duplicates are folded out. 0 = ALL ranked members. Default 3 = the chart 50/100/200 must be stacked, which reproduces v1.7 on a DAILY chart: the weekly-50 sits outside that depth for a real reason — it is a ~350-day-equivalent average, and at a genuine reversal the 200 is still BELOW it, so requiring that pair blocks every early entry. On a chart whose timeframe MATCHES a signal EMA's timeframe (e.g. a 1W chart with the weekly-50 in slot 6) the two are the same series; v1.8.1 collapses them and the dashboard shows K✓ 3/4 so you can see it happened. Raise the depth when you want confirmation over earliness.")
i_sigStackMem  = input.int(15, "Stack Memory (bars)", minval=1, maxval=100, group="Signal Engine", tooltip="A freshly FORMED stack order licenses entries for this many bars — the direct encoding of 'test of the EMAs while freshly stacked'. What counts as 'freshly formed' is set by Fresh-Stack Qualification below.")
i_sigStackMode = input.string("Un-stacked >= N bars", "Fresh-Stack Qualification", options=["Un-stacked >= N bars", "Full Opposite Stack", "Any Re-stack"], group="Signal Engine", tooltip="v1.8 CRITICAL FIX. v1.7 granted the stack license on ANY transition into stacked order, including a one-bar EMA1/EMA2 wobble inside an established uptrend — and that license voids the slope AND zone gates for 15 bars, which turned a reversal engine into a continuation engine and made the Expectancy Lab's numbers un-attributable. UN-STACKED >= N BARS (default): the stack must have been broken for at least N bars first, which filters wobbles without demanding a full cycle turn. FULL OPPOSITE STACK: the literal Playbook definition — the EMAs must have been in the OPPOSITE order within N bars ('the EMAs flip from bearish to bullish order'); strictest, rarest, purest reversal. ANY RE-STACK: v1.7 behavior, kept so you can A/B it in the Lab.")
i_sigStackQualBars = input.int(10, "Fresh-Stack Qualifier (bars)", minval=1, maxval=200, group="Signal Engine", tooltip="The N used by Fresh-Stack Qualification. In 'Un-stacked >= N bars' mode it is the minimum number of consecutive bars the stack must have been broken before re-forming. In 'Full Opposite Stack' mode it is how recently the opposite stack order must have existed. Ignored in 'Any Re-stack' mode.")
i_sigEntryMode = input.string("Reclaim + Test (fresh)", "Entry Trigger", options=["Reclaim + Test (fresh)", "Testing EMA 1", "Testing Any Signal EMA", "Reclaim All"], group="Signal Engine", tooltip="Reclaim + Test (default): the reclaim bar itself triggers, OR a test of EMA1 while a fresh license is active (reclaim window, un-consumed first-K tests, fresh stack, or a recent spring) — the fresh-reclaim confluence setup. Testing EMA 1 = test-only. Reclaim All = transition bar only.")
i_sigReclaimMem = input.int(8, "Reclaim Memory (bars)", minval=1, maxval=50, group="Signal Engine", tooltip="After a fresh reclaim (no signal EMA below, where at least one was below before), EMA1 tests within this window qualify as entries. Also counts as freshness: a fresh reclaim satisfies the reversal requirement even if the slope alignment is older than its window.")
i_sigReclaimBarTrig = input.bool(true, "Reclaim Bar Itself Triggers", group="Signal Engine", tooltip="v1.8.1. ON (default, existing behavior): the reclaim bar fires an entry on its own — structure recovered IS the event. OFF: the reclaim still LICENSES the setup (it satisfies freshness and bypasses the slope and zone vetoes) but an actual EMA 1 test must arrive before anything triggers. Turn this off if you keep seeing confirmed signals on bars that never came near an EMA; it is the cleanest way to make the engine trade only the tested-support entry the Playbook describes.")
i_sigReclaimClearsCd = input.bool(true, "Fresh Reclaim Clears Cooldown", group="Signal Engine", tooltip="A genuine reclaim after structure loss is a NEW setup — it should not be swallowed by the cooldown from the preceding reset.")
i_sigTestsPerReclaim = input.int(2, "Qualifying Tests per Reclaim", minval=0, maxval=10, group="Signal Engine", tooltip="The FIRST K EMA1-test episodes after a reclaim qualify as entries with NO bar limit, as long as the structure has held continuously since the reclaim — the first pullback test can come weeks later. 0 disables this route (bar-window only). Tests are consumed ON USE — only when the full candidate gate was open, the engine was out of cooldown, and the machine was actually able to act on the trigger.")
i_sigWyckAssist = input.bool(true, "Wyckoff Assist (springs)", group="Signal Engine", tooltip="A recent qualified SPRING also satisfies the freshness requirement for longs (UPTHRUST for shorts) — spring reversals are reclaim setups by construction. v1.8: this license now also makes the EMA1 test ELIGIBLE to trigger; in v1.7 it opened the gates but not the door, so a spring-only license produced a SETUP that could never fire.")
i_sigWyckMem = input.int(10, "Wyckoff License Memory (bars)", minval=1, maxval=100, group="Signal Engine", tooltip="v1.8: how recent a spring/upthrust must be to license an entry. In v1.7 this rode on Event Memory (30 bars), which meant a month-old spring was still voiding the slope and zone gates. Kept separate so the forecast can have a long memory while the trigger has a short one.")
i_licReclaim = input.bool(true, "Route: Reclaim", inline="lic", group="Signal Engine")
i_licStack   = input.bool(true, "Route: Fresh Stack", inline="lic", group="Signal Engine")
i_licSpring  = input.bool(true, "Route: Wyckoff", inline="lic", group="Signal Engine", tooltip="v1.8 ATTRIBUTION: the three fresh-license routes can now be enabled independently, and the route that produced each entry is latched at the trigger bar, shown in the dashboard, carried into the alert, and published on the EXT: Entry Route bus stream. Wire that stream as the Expectancy Lab's regime source to get per-route expectancy — these are structurally different setups and there is no reason to assume they share an edge.")
i_sigSymmetric = input.bool(false, "Symmetric Bear Rules", group="Signal Engine", tooltip="OFF (default): bears require price BELOW all signal EMAs (your asymmetric spec). v1.8 makes ONE carve-out in that rule: EMA 1 may sit inside the test tolerance band. Without it, short TEST entries were mathematically unreachable — the band that defines a test assigns status TESTING, not BELOW, so the qualifying bar was also the disqualifying bar and only outright rejection bars could ever fire. ON: bears mirror the bull rules (below-or-testing throughout).")
i_sigConfirmN  = input.int(2, "Confirmation Closes", minval=1, maxval=5, group="Signal Engine", tooltip="Trigger bar + (N-1) further bars must HOLD the EMA structure before the signal confirms. Kills one-bar fakeouts.")
i_sigCooldown  = input.int(5, "Cooldown (bars)", minval=0, maxval=100, group="Signal Engine", tooltip="After a confirmation, failed confirmation, or invalidation — no new trigger for this many bars. Kills the strobe effect on choppy shelves.")
i_sigInvalRef  = input.string("Lowest Signal EMA", "Invalidation Reference", options=["Lowest Signal EMA", "EMA 1", "Match Stop Reference"], group="Signal Engine", tooltip="v1.8: what a CONFIRMED signal invalidates against. LOWEST SIGNAL EMA (default, v1.7 behavior) is a very loose stop when a weekly EMA is in the signal set — in practice the signal almost always exited through the silent 'structure lost' branch instead, so the INVALIDATED state and this buffer rarely engaged at all. EMA 1 makes INVALIDATED the normal exit and gives the state machine a stop that matches how you actually trade. MATCH STOP REFERENCE (v1.8.6) invalidates at whatever the Stop Reference below resolves to, so the state machine and the level you actually trade are the same number. Either way the new Signal End event fires on BOTH exit paths.")
i_sigInvalBuf  = input.float(0.5, "Invalidation Buffer %", minval=0.0, maxval=5.0, step=0.1, group="Signal Engine", tooltip="Long signal invalidates on a close below the invalidation reference minus this buffer (mirror for shorts)")
i_sigStopRef   = input.string("Lowest Signal EMA", "Stop Reference (bus)", options=["Lowest Signal EMA", "EMA 1", "Spring / UT Extreme", "Fib 78.6%", "Fib 23.6%", "Fib Custom %", "Fib Auto (protective)"], group="Signal Engine", tooltip="v1.8: which structural stop is published on the EXT: Long/Short Stop Ref bus streams. The Playbook prescribes different stops per play — the lowest signal EMA minus the buffer for the reclaim and pullback plays, the spring low for the spring play, the 78.6% when it sits cleaner. Wiring this into the Expectancy Lab lets you simulate the stop you would actually use instead of a fixed ATR bracket. As of v1.8.5 it also drives the live stop shown in the Signal row.\n\nv1.8.6 ON THE FIB LEVELS: the pair swaps roles when the signal orientation flips. In UP orientation 78.6% is the deep level below price and 23.6% sits near the high; in DOWN orientation that reverses exactly. Under Structure Only the orientation follows the regime, so a shift into DISTRIBUTION puts a fixed 78.6% stop ABOVE price. FIB AUTO (PROTECTIVE) always takes whichever of the two sits on the protective side of the trade — below price for a long, above for a short — and therefore stays correct through every flip without being re-set by hand. FIB CUSTOM % takes any level from the float below, which is also how you build buffer room into a fib stop (82 rather than 78.6). A negative distance in the Signal row means the chosen level has ended up on the wrong side of price.")
i_sigStopFibPct = input.float(88.6, "Fib Custom Stop %", minval=0.0, maxval=200.0, step=0.1, group="Signal Engine", tooltip="v1.8.6. The level used when Stop Reference is set to Fib Custom %. Measured on the SIGNAL fib orientation, so it tracks the same flips as the other fib levels. Values beyond 100 project past the anchor for a wider structural stop; the result is guarded to a positive price, so an extreme setting on a low-priced symbol cannot publish a zero or negative stop. Common choices: 88.6 (deep but still inside the move), 100 (the anchor itself), 61.8 (tight, golden pocket).")
i_sigSignalBars = input.int(5, "Fresh-Signal Highlight (bars)", minval=1, maxval=50, group="Signal Engine", tooltip="CONFIRMED stays bright for this many bars, then dims to HOLDING while the structure lasts")
i_sigFlashBars  = input.int(3, "Invalidation Flash (bars)", minval=1, maxval=20, group="Signal Engine", tooltip="How many bars the INVALIDATED state stays flagged before the row resets.")
i_sigVetoHTF    = input.bool(true, "HTF Veto", inline="sg", group="Signal Engine", tooltip="No long signals while regime = TRENDING DOWN (mirror for shorts). Blocks counter-trend knife-catches; still allows reversals out of ranges.")
i_sigNeedRegime = input.bool(false, "Require Regime Agreement", inline="sg", group="Signal Engine", tooltip="Stricter: longs also need ACCUMULATION or TRENDING UP")
i_sigVolGate = input.bool(false, "Volume Gate on Trigger", inline="sv", group="Signal Engine")
i_sigVolMult = input.float(1.0, "x avg", minval=0.5, maxval=5.0, step=0.1, inline="sv", group="Signal Engine", tooltip="Optionally require the trigger bar's volume to exceed this multiple of average volume.")
i_sigVolLen  = input.int(20, "Volume SMA Length", minval=5, maxval=100, group="Signal Engine", tooltip="Bars used to compute the average volume for the signal volume gate. Ignored when the shared Volume Baseline is set to Session Relative.")
i_sigUseScore  = input.bool(false, "Gate by Confluence Score", inline="ss", group="Signal Engine")
i_sigMinScore  = input.int(60, "Min Score", minval=0, maxval=100, inline="ss", group="Signal Engine", tooltip="Optional strictness dial: candidate must score >= this (EMA status + slope freshness + zone depth + volume). NOTE: with Slope Alignment set to Off the slope component now scores 0 rather than a phantom 18, so the achievable maximum drops to 70 — lower this threshold accordingly if you disable slopes.")

// Signal Display
i_sigBullCol  = input.color(color.lime, "Bull", inline="sd1", group="Signal Display")
i_sigBearCol  = input.color(color.red, "Bear", inline="sd1", group="Signal Display")
i_sigSetupCol = input.color(color.yellow, "Setup", inline="sd1", group="Signal Display", tooltip="Marker/row colors for bull, bear, and setup signal states.")
i_sigTintOn    = input.bool(true, "Tint Whole Dashboard on CONFIRMED", inline="sd2", group="Signal Display")
i_sigTintAlpha = input.int(80, "Alpha", minval=0, maxval=100, inline="sd2", group="Signal Display", tooltip="Tint the whole Dashboard while a signal is CONFIRMED (only when the tint source includes the Signal Engine), and its transparency.")
i_sigTintHold = input.bool(false, "Tint Also While HOLDING", group="Signal Display", tooltip="v1.8.4. By default the whole-table signal tint only lights on a freshly CONFIRMED signal, so a long that has matured into HOLDING leaves the table to whatever the confluence says — which can be the opposite colour. Turn this on to keep the table tinted for the life of the position.")
i_sigMarkOn   = input.bool(true, "Chart Markers on CONFIRMED", group="Signal Display", tooltip="Print the up/down markers on the chart when a signal confirms (independent of the Signal dashboard row). Markers draw on bar close only — parity with the close-gated alerts.")
i_sigMarkTxtL = input.string("▲ LONG", "Long Text", inline="mk1", group="Signal Display")
i_sigMarkTxtS = input.string("▼ SHORT", "Short Text", inline="mk1", group="Signal Display", tooltip="Marker label text. For minimal markers use just the arrow character.")
i_sigMarkLCol    = input.color(color.lime, "Long", inline="mk2", group="Signal Display")
i_sigMarkLTxtCol = input.color(color.black, "Text", inline="mk2", group="Signal Display", tooltip="Background and text colors of the long marker.")
i_sigMarkSCol    = input.color(color.red, "Short", inline="mk3", group="Signal Display")
i_sigMarkSTxtCol = input.color(color.white, "Text", inline="mk3", group="Signal Display", tooltip="Background and text colors of the short marker.")
i_sigMarkAlpha = input.int(30, "Bg Alpha", minval=0, maxval=100, inline="mk4", group="Signal Display", tooltip="100 = fully transparent background (text only — least busy)")
i_sigMarkSize  = input.string("Small", "Size", options=["Tiny", "Small", "Normal", "Large"], inline="mk4", group="Signal Display")
i_sigMarkTip = input.bool(true, "Trade Data on Marker Hover", group="Signal Display", tooltip="v1.8.7. Hovering a CONFIRMED marker shows a frozen snapshot of what the engine knew at the moment it fired: route, confluence score, all gate flags, the structural stop with its distance and reference, the regime and the forecast probabilities. SETUP markers carry a lighter version (score, arming license, gates). The snapshot does NOT update afterwards — the stop reference keeps moving with the EMAs and fibs, so an old marker can legitimately disagree with the live dashboard row on the same trade. That is the point: it is the audit trail of the entry decision, same as the self-auditing marks in RSI Divergence Pro. Turn off for plain markers.")
i_sigMarkOffset = input.float(0.0, "Marker Offset (ATR)", minval=0.0, maxval=10.0, step=0.1, group="Signal Display", tooltip="v1.8.9. Pushes the entry, setup and exit markers away from the candle by this many ATRs (below-price markers move down, above-price markers move up). 0 = touching the bar, the previous behavior. On dense charts the markers sat inside the candle range, which looked busy and made the hover tooltips hard to hit — 0.5-1.0 usually clears the wicks. ATR-denominated (ATR Length from the Signal Engine group) so one setting scales across symbols and timeframes. Below-bar placements are floored at a positive price for log-scale safety.")
i_sigMarkSetup = input.bool(false, "Chart Markers on SETUP", group="Signal Display", tooltip="Small hollow markers when a setup arms (before trigger/confirmation) — early eyes, more noise")
i_sigSetupTxtL  = input.string("△", "Setup Long", inline="mk5", group="Signal Display")
i_sigSetupTxtS  = input.string("▽", "Short", inline="mk5", group="Signal Display")
i_sigSetupSize  = input.string("Tiny", "Size", options=["Tiny", "Small", "Normal", "Large"], inline="mk5", group="Signal Display", tooltip="Text and size of the optional SETUP markers (long/short).")
i_sigSetupAlpha = input.int(75, "Bg Alpha", minval=0, maxval=100, inline="mk6", group="Signal Display", tooltip="Background transparency of the SETUP markers.")
i_sigMarkExit  = input.bool(false, "Chart Markers on SIGNAL END", inline="mk7", group="Signal Display")
i_sigExitTxt   = input.string("✕", "Exit Text", inline="mk7", group="Signal Display", tooltip="v1.8: mark the bar where a CONFIRMED/HOLDING signal ends — either by invalidation or by losing the EMA structure. Default OFF to preserve your current chart; turn it on if you want the exit as visible as the entry.")
i_sigExitLCol    = input.color(#363a45, "Exit Long", inline="mk8", group="Signal Display")
i_sigExitLTxtCol = input.color(color.white, "Glyph", inline="mk8", group="Signal Display", tooltip="v1.8.3. Background panel and glyph colour for the LONG exit marker. Defaults to a white glyph on a neutral dark panel: the v1.8 marker inherited the side colour for both, so a lime ✕ sat on a lime panel and was unreadable against the entry marker and the confluence tint. Set the panel to your chart background and raise the alpha if you want a glyph with no panel at all.")
i_sigExitSCol    = input.color(#363a45, "Exit Short", inline="mk9", group="Signal Display")
i_sigExitSTxtCol = input.color(color.white, "Glyph", inline="mk9", group="Signal Display", tooltip="Background panel and glyph colour for the SHORT exit marker. Kept separate from the long side so you can colour-code direction if you prefer, but both default to the same neutral treatment — an exit is an exit.")
i_sigExitAlpha   = input.int(15, "Exit Bg Alpha", minval=0, maxval=100, inline="mk10", group="Signal Display")
i_sigExitSize    = input.string("Small", "Exit Size", options=["Tiny", "Small", "Normal", "Large"], inline="mk10", group="Signal Display", tooltip="Transparency of the exit marker panel and its text size. 100 alpha gives a floating glyph with no panel. These are independent of the SETUP marker controls, which the exit marker previously borrowed.")
i_sigMaxMarks = input.int(20, "Max Markers", minval=2, maxval=100, group="Signal Display", tooltip="How many recent signal markers to keep before the oldest are removed.")

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — Alerts
// ═══════════════════════════════════════════════════════════════════════════

i_alertMaster = input.bool(true, "Enable Dynamic Alerts", group="Alert Settings", tooltip="Create ONE TradingView alert with 'Any alert() function call' — covers all toggled events with rich messages.")
i_alertRegime = input.bool(true, "Regime Change", inline="a1", group="Alert Settings", tooltip="Toggle which events fire alerts. Create ONE TradingView alert on this indicator with 'Any alert() function call' to receive every enabled event.")
i_alertWyck   = input.bool(true, "Spring / Upthrust", inline="a1", group="Alert Settings")
i_alertDiv    = input.bool(true, "HTF Divergence", inline="a2", group="Alert Settings")
i_alertZone   = input.bool(true, "Entry Zone + Bias", inline="a2", group="Alert Settings")
i_alertProb   = input.bool(true, "Probability Threshold", inline="a3", group="Alert Settings")
i_alertConf   = input.bool(true, "EMA-Fib Confluence", inline="a4", group="Alert Settings")
i_alertSignal = input.bool(true, "Entry Signal Confirmed", inline="a4", group="Alert Settings")
i_alertSetup  = input.bool(false, "Signal Setup Forming", inline="a4", group="Alert Settings")
i_alertSigEnd = input.bool(true, "Signal Ended", group="Alert Settings", tooltip="v1.8: fires when a CONFIRMED or HOLDING signal ends — by invalidation OR by losing the EMA structure. v1.7 had entries with no exits: the INVALIDATED path needed a close below the LOWEST signal EMA (often a weekly average), while the common exit took a silent branch with no alert, no marker and nothing on the bus. The message states which path it took.")
i_alertRegimeMode = input.string("On HTF Close", "Regime Alert Timing", options=["On HTF Close", "Every Bar"], group="Alert Settings", tooltip="v1.8: HTF values develop on the live HTF candle, so a REGIME CHANGE evaluated per chart bar could fire mid-week and reverse before the weekly close — an alert log that history will not reproduce. ON HTF CLOSE (default) compares the regime at successive range-timeframe closes and fires only on a genuine change between them. EVERY BAR restores v1.7.")

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════

getLineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

getExtend(string s) =>
    s == "Left" ? extend.left : s == "Right" ? extend.right : s == "Both" ? extend.both : extend.none

getTablePos(string s) =>
    s == "Top Left" ? position.top_left : s == "Top Center" ? position.top_center : s == "Middle Left" ? position.middle_left : s == "Middle Center" ? position.middle_center : s == "Middle Right" ? position.middle_right : s == "Bottom Left" ? position.bottom_left : s == "Bottom Center" ? position.bottom_center : s == "Bottom Right" ? position.bottom_right : position.top_right

getSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

zebraBg(int r) =>
    color result = i_tblZebraOn and r % 2 == 1 ? i_tblZebraCol : color(na)
    result

discScore(string val, string s0, string s1, string s2, string s3, string s4) =>
    val == s0 ? 100.0 : val == s1 ? 50.0 : val == s3 ? -50.0 : val == s4 ? -100.0 : 0.0

probBar(float p) =>
    int filled = math.round(math.min(math.max(p, 0), 100) / 10)
    str.repeat("▰", filled) + str.repeat("▱", 10 - filled)

clamp100(float v) =>
    math.min(math.max(v, -100.0), 100.0)

// Resolve an empty timeframe input ("" = "Chart") to the chart's timeframe so
// request.security receives a valid string (it rejects "").
resolveTF(string tf) =>
    tf == "" ? timeframe.period : tf

formatSwingLbl(string prefix, float price, string fmt) =>
    fmt == "Price Only" ? str.tostring(price, format.mintick) : fmt == "Level Only" ? prefix : prefix + ": " + str.tostring(price, format.mintick)

// Display priority for the dashboard Signal row — a LIVE state must outrank
// the other side's dying INVALIDATED flash (numerically 5 > 3, which would
// otherwise let a flash mask a confirmed signal).
sigDispRank(int st) =>
    st == 3 ? 5 : st == 4 ? 4 : st == 2 ? 3 : st == 1 ? 2 : st == 5 ? 1 : 0

// Route code -> compact tag for the dashboard / alert payload.
routeTag(int r) =>
    r == 1 ? "reclaim" : r == 2 ? "stack" : r == 3 ? "wyckoff" : "—"

// v1.8.2: slope with a magnitude floor. A bare `ema > ema[n]` comparison
// treats a hundredth of a percent of drift as a trend; on a slow EMA that is
// pure noise and it is the usual cause of a long firing into a falling stack.
slopePct(float v, float vLag) =>
    not na(v) and not na(vLag) and vLag != 0 ? (v - vLag) / math.abs(vLag) * 100.0 : na

fmtSlp(float v, float vLag) =>
    float p = slopePct(v, vLag)
    na(p) ? "—" : str.tostring(p, "#.##")

slopeUpOK(float v, float vLag) =>
    float p = slopePct(v, vLag)
    not na(p) and p > i_maSlopeMinPct

slopeDnOK(float v, float vLag) =>
    float p = slopePct(v, vLag)
    not na(p) and -p > i_maSlopeMinPct

// v1.8: EFFECTIVE LENGTH — an EMA's length expressed in CHART bars.
// A 50-period EMA on the weekly is a ~350-day average on a daily chart; slot
// order says nothing about speed, which is why the v1.7 stack chain had to be
// patched. timeframe.in_seconds() is used rather than string equality because
// input.timeframe and timeframe.period do not always normalise identically,
// and a silent mismatch would drop an EMA from the ordering while the
// dashboard still reported the gate as satisfied.
float chartSecF = timeframe.in_seconds(timeframe.period)
effBarsOf(simple string tf, simple int len) =>
    float s = timeframe.in_seconds(tf == "" ? timeframe.period : tf)
    chartSecF > 0 ? len * s / chartSecF : len * 1.0

// ═══════════════════════════════════════════════════════════════════════════
// HTF MA STACK — six independent timeframe/length slots
// ═══════════════════════════════════════════════════════════════════════════

[ma1, ma1Lag] = request.security(syminfo.tickerid, resolveTF(i_ma1TF), [ta.ema(close, i_ma1Len), ta.ema(close, i_ma1Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)
[ma2, ma2Lag] = request.security(syminfo.tickerid, resolveTF(i_ma2TF), [ta.ema(close, i_ma2Len), ta.ema(close, i_ma2Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)
[ma3, ma3Lag] = request.security(syminfo.tickerid, resolveTF(i_ma3TF), [ta.ema(close, i_ma3Len), ta.ema(close, i_ma3Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)
[ma4, ma4Lag] = request.security(syminfo.tickerid, resolveTF(i_ma4TF), [ta.ema(close, i_ma4Len), ta.ema(close, i_ma4Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)
[ma5, ma5Lag] = request.security(syminfo.tickerid, resolveTF(i_ma5TF), [ta.ema(close, i_ma5Len), ta.ema(close, i_ma5Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)
[ma6, ma6Lag] = request.security(syminfo.tickerid, resolveTF(i_ma6TF), [ta.ema(close, i_ma6Len), ta.ema(close, i_ma6Len)[i_maSlopeLen]], lookahead=barmerge.lookahead_off)

float ef1 = effBarsOf(i_ma1TF, i_ma1Len)
float ef2 = effBarsOf(i_ma2TF, i_ma2Len)
float ef3 = effBarsOf(i_ma3TF, i_ma3Len)
float ef4 = effBarsOf(i_ma4TF, i_ma4Len)
float ef5 = effBarsOf(i_ma5TF, i_ma5Len)
float ef6 = effBarsOf(i_ma6TF, i_ma6Len)

plot(i_ma1On ? ma1 : na, "MA 1", i_ma1Col, i_maW)
plot(i_ma2On ? ma2 : na, "MA 2", i_ma2Col, i_maW)
plot(i_ma3On ? ma3 : na, "MA 3", i_ma3Col, i_maW)
plot(i_ma4On ? ma4 : na, "MA 4", i_ma4Col, i_maW)
plot(i_ma5On ? ma5 : na, "MA 5", i_ma5Col, i_maW)
plot(i_ma6On ? ma6 : na, "MA 6", i_ma6Col, i_maW)

int maAbove = 0
int maBelow = 0
int maActive = 0
int maSlopeUp = 0
int maSlopeDown = 0
if i_ma1On
    maActive += 1
    if close > ma1
        maAbove += 1
    if close < ma1
        maBelow += 1
    if slopeUpOK(ma1, ma1Lag)
        maSlopeUp += 1
    if slopeDnOK(ma1, ma1Lag)
        maSlopeDown += 1
if i_ma2On
    maActive += 1
    if close > ma2
        maAbove += 1
    if close < ma2
        maBelow += 1
    if slopeUpOK(ma2, ma2Lag)
        maSlopeUp += 1
    if slopeDnOK(ma2, ma2Lag)
        maSlopeDown += 1
if i_ma3On
    maActive += 1
    if close > ma3
        maAbove += 1
    if close < ma3
        maBelow += 1
    if slopeUpOK(ma3, ma3Lag)
        maSlopeUp += 1
    if slopeDnOK(ma3, ma3Lag)
        maSlopeDown += 1
if i_ma4On
    maActive += 1
    if close > ma4
        maAbove += 1
    if close < ma4
        maBelow += 1
    if slopeUpOK(ma4, ma4Lag)
        maSlopeUp += 1
    if slopeDnOK(ma4, ma4Lag)
        maSlopeDown += 1
if i_ma5On
    maActive += 1
    if close > ma5
        maAbove += 1
    if close < ma5
        maBelow += 1
    if slopeUpOK(ma5, ma5Lag)
        maSlopeUp += 1
    if slopeDnOK(ma5, ma5Lag)
        maSlopeDown += 1
if i_ma6On
    maActive += 1
    if close > ma6
        maAbove += 1
    if close < ma6
        maBelow += 1
    if slopeUpOK(ma6, ma6Lag)
        maSlopeUp += 1
    if slopeDnOK(ma6, ma6Lag)
        maSlopeDown += 1

// ═══════════════════════════════════════════════════════════════════════════
// HTF RANGE via WILLIAMS FRACTALS — native HTF pivots, deduped.
// v1.8: the raw fractal pair is kept separately from the EFFECTIVE range, so
// an incoherent pair can fall back to the HTF extremes instead of blanking
// the whole engine.
// ═══════════════════════════════════════════════════════════════════════════

[fracHRaw, fracLRaw, rangeTfClose, rangeTfClosePast, htfCtxHi, htfCtxLo] = request.security(syminfo.tickerid, resolveTF(i_rangeTF),
     [ta.pivothigh(high, i_fracWings, i_fracWings),
      ta.pivotlow(low, i_fracWings, i_fracWings),
      close, close[i_ctxLookback],
      ta.highest(high, i_ctxLookback), ta.lowest(low, i_ctxLookback)],
     lookahead=barmerge.lookahead_off)

bool newFracH = not na(fracHRaw) and (na(fracHRaw[1]) or fracHRaw != fracHRaw[1])
bool newFracL = not na(fracLRaw) and (na(fracLRaw[1]) or fracLRaw != fracLRaw[1])

var float fracHi = na
var float fracLo = na
var int fracHiBar = na
var int fracLoBar = na

if newFracH
    fracHi := fracHRaw
    fracHiBar := bar_index
if newFracL
    fracLo := fracLRaw
    fracLoBar := bar_index

// Coherence: a range needs a high ABOVE its low. A new fractal low confirming
// above the stale fractal high (a V-move) is incoherent, not merely misordered
// — swapping them would manufacture a degenerate sliver zone.
bool fracOK = not na(fracHi) and not na(fracLo) and fracHi > fracLo
bool fbOK = i_rangeFallback and not fracOK and not na(htfCtxHi) and not na(htfCtxLo) and htfCtxHi > htfCtxLo

float rangeHi = fracOK ? fracHi : fbOK ? htfCtxHi : na
float rangeLo = fracOK ? fracLo : fbOK ? htfCtxLo : na
int rangeHiBar = fracOK ? fracHiBar : na
int rangeLoBar = fracOK ? fracLoBar : na

bool rangeValid = not na(rangeHi) and not na(rangeLo) and rangeHi > rangeLo
bool rangeIsFallback = rangeValid and not fracOK
float rangeSpan = rangeValid ? rangeHi - rangeLo : na
float rangeMid  = rangeValid ? (rangeHi + rangeLo) / 2 : na
float rangePos  = rangeValid ? (close - rangeLo) / rangeSpan * 100 : na

int rangeAgeH = not na(fracHiBar) ? bar_index - fracHiBar : na
int rangeAgeL = not na(fracLoBar) ? bar_index - fracLoBar : na

float bufMult = i_rangeBufPct / 100.0
bool brokeUp   = rangeValid and rangeTfClose > rangeHi * (1.0 + bufMult)
bool brokeDown = rangeValid and rangeTfClose < rangeLo * (1.0 - bufMult)

bool fellIntoRange = rangeValid and not na(rangeTfClosePast) and rangeTfClosePast > rangeMid * (1.0 + bufMult)
bool roseIntoRange = rangeValid and not na(rangeTfClosePast) and rangeTfClosePast < rangeMid * (1.0 - bufMult)

// First chart bar of a new range-TF bar — i.e. the previous HTF bar has closed.
bool htfNewBar = ta.change(time(resolveTF(i_rangeTF))) != 0

// ═══════════════════════════════════════════════════════════════════════════
// SWING DETECTION (MFTA port) — native pivots on the swing TF, deduped.
// Detection runs unconditionally; only the DRAWING is gated by i_showSwings,
// so the "Swing H/L" fib anchor keeps working even with lines hidden.
// ═══════════════════════════════════════════════════════════════════════════

string swingTF = resolveTF(i_swingTF)
bool swingIsChartTF = swingTF == timeframe.period

[pivotHRaw, pivotLRaw] = request.security(syminfo.tickerid, swingTF,
     [ta.pivothigh(high, i_swingLookback, i_swingLookback),
      ta.pivotlow(low, i_swingLookback, i_swingLookback)],
     lookahead=barmerge.lookahead_off)

bool newPivotH = not na(pivotHRaw) and (na(pivotHRaw[1]) or pivotHRaw != pivotHRaw[1])
bool newPivotL = not na(pivotLRaw) and (na(pivotLRaw[1]) or pivotLRaw != pivotLRaw[1])

var float lastSwingH = na
var float lastSwingL = na
var int lastSwingHBar = na
var int lastSwingLBar = na
var array<line> swLines = array.new<line>()
var array<label> swLabels = array.new<label>()

string swStyle = i_swingStyle == "Dashed" ? line.style_dashed : i_swingStyle == "Dotted" ? line.style_dotted : line.style_solid
swExt = i_swingExtend ? extend.right : extend.none
swLblSz = getSize(i_swingLblSize)

// When swing TF != chart TF the exact pivot bar isn't recoverable at chart
// resolution, so lines anchor at the confirmation bar. The price levels are
// exact either way.
if newPivotH
    lastSwingH := pivotHRaw
    int xPosH = math.max(0, swingIsChartTF ? bar_index - i_swingLookback : bar_index)
    lastSwingHBar := xPosH
    if i_showSwings
        array.push(swLines, line.new(xPosH, pivotHRaw, bar_index, pivotHRaw, color=i_swingHighCol, width=i_swingWidth, style=swStyle, extend=swExt))
        if array.size(swLines) > i_maxSwingLines
            line.delete(array.shift(swLines))
        if i_showSwingLbl
            array.push(swLabels, label.new(math.max(0, xPosH + i_swingLblOffset), pivotHRaw, formatSwingLbl(i_swingHighPrefix, pivotHRaw, i_swingLblFormat), style=label.style_label_down, color=color.new(i_swingHighCol, i_swingLblAlpha), textcolor=i_swingHighCol, size=swLblSz))
            if array.size(swLabels) > i_maxSwingLines
                label.delete(array.shift(swLabels))

if newPivotL
    lastSwingL := pivotLRaw
    int xPosL = math.max(0, swingIsChartTF ? bar_index - i_swingLookback : bar_index)
    lastSwingLBar := xPosL
    if i_showSwings
        array.push(swLines, line.new(xPosL, pivotLRaw, bar_index, pivotLRaw, color=i_swingLowCol, width=i_swingWidth, style=swStyle, extend=swExt))
        if array.size(swLines) > i_maxSwingLines
            line.delete(array.shift(swLines))
        if i_showSwingLbl
            array.push(swLabels, label.new(math.max(0, xPosL + i_swingLblOffset), pivotLRaw, formatSwingLbl(i_swingLowPrefix, pivotLRaw, i_swingLblFormat), style=label.style_label_up, color=color.new(i_swingLowCol, i_swingLblAlpha), textcolor=i_swingLowCol, size=swLblSz))
            if array.size(swLabels) > i_maxSwingLines
                label.delete(array.shift(swLabels))

// ═══════════════════════════════════════════════════════════════════════════
// VOLUME BASELINE (shared) — SMA, or session-relative RVOL on intraday.
// A flat SMA on an intraday chart is dominated by the U-shaped session volume
// curve, which makes "stopping volume" trivially easy at the open and close
// and nearly impossible at midday. The session-relative baseline compares each
// bar to the same SLOT of previous sessions instead.
// ═══════════════════════════════════════════════════════════════════════════

float volSmaWyck = ta.sma(volume, i_wyckVolSmaLen)
float volSmaSig  = ta.sma(volume, i_sigVolLen)

var array<float> todAvg = array.new<float>(1440, na)
int bsSess = ta.barssince(session.isfirstbar)
bool todMode = i_volBaseMode == "Session Relative" and timeframe.isintraday
int volSlot = todMode and not na(bsSess) ? math.min(1439, math.max(0, bsSess)) : 0
float todPrev = na
if todMode
    todPrev := array.get(todAvg, volSlot)
    if not na(volume) and volume > 0
        array.set(todAvg, volSlot, na(todPrev) ? volume : todPrev + (volume - todPrev) / math.max(2, i_volTodDays))

float wyckVolSma = todMode and not na(todPrev) ? todPrev : volSmaWyck
float sigVolSma  = todMode and not na(todPrev) ? todPrev : volSmaSig

// ═══════════════════════════════════════════════════════════════════════════
// WYCKOFF ENGINE
// v1.8.9: marker-offset ATR, computed here so both the Wyckoff labels (this
// section) and the signal markers (later) can use it.
float markerAtr = ta.atr(i_sigAtrLen)

// A valid SPRING:    pokes below range low by <= MaxPen% of range height and
//                    CLOSES back above the low within the reclaim window, the
//                    HTF range is not already broken down, volume qualified on
//                    the UNDERCUT bar, and the cooldown has elapsed.
// A valid UPTHRUST:  exact mirror at the range high.
// ═══════════════════════════════════════════════════════════════════════════

// Symbols with no volume data qualify by default instead of never.
bool volQualifies = i_wyckVolMode == "Any" or na(volume) or na(wyckVolSma) or (i_wyckVolMode == "Low Volume Test (<avg)" and volume < wyckVolSma) or (i_wyckVolMode == "Stopping Volume (>mult x avg)" and volume > wyckVolSma * i_wyckVolMult)

float penBelow = rangeValid ? (rangeLo - low) / rangeSpan * 100 : na
float penAbove = rangeValid ? (high - rangeHi) / rangeSpan * 100 : na

// v1.8: the undercut / overshoot is latched so the reclaim may arrive later.
// With the window at 1 this reduces exactly to v1.7's same-bar condition.
var int   ucBar = -100000
var float ucLow = na
var bool  ucVol = false
if rangeValid and low < rangeLo and not na(penBelow) and penBelow <= i_springMaxPen
    ucBar := bar_index
    ucLow := low
    ucVol := volQualifies

var int   osBar = -100000
var float osHigh = na
var bool  osVol = false
if rangeValid and high > rangeHi and not na(penAbove) and penAbove <= i_springMaxPen
    osBar := bar_index
    osHigh := high
    osVol := volQualifies

bool springRaw = i_wyckOn and rangeValid and not brokeDown and close > rangeLo and (bar_index - ucBar) < i_springReclaimBars and ucVol
bool utRaw     = i_wyckOn and rangeValid and not brokeUp and close < rangeHi and (bar_index - osBar) < i_springReclaimBars and osVol

var int lastSpringSigBar = -100000
var int lastUtSigBar     = -100000

bool springSig = springRaw and bar_index - lastSpringSigBar > i_wyckCooldown
bool utSig     = utRaw and bar_index - lastUtSigBar > i_wyckCooldown

var float lastSpringLow = na
var float lastUtHigh    = na
if springSig
    lastSpringSigBar := bar_index
    lastSpringLow := ucLow
if utSig
    lastUtSigBar := bar_index
    lastUtHigh := osHigh

// Compact, styleable markers (labels)
var array<label> wyckLbls = array.new<label>()
if i_wyckMarkOn and springSig
    array.push(wyckLbls, label.new(bar_index, math.max(low - nz(markerAtr, 0.0) * i_wyckMarkOffset, syminfo.mintick), i_springTxt, style=label.style_label_up, color=color.new(i_springCol, i_wyckLblAlpha), textcolor=i_springCol, size=getSize(i_wyckLblSize)))
    if array.size(wyckLbls) > i_maxWyckLbls
        label.delete(array.shift(wyckLbls))
if i_wyckMarkOn and utSig
    array.push(wyckLbls, label.new(bar_index, high + nz(markerAtr, 0.0) * i_wyckMarkOffset, i_utTxt, style=label.style_label_down, color=color.new(i_utCol, i_wyckLblAlpha), textcolor=i_utCol, size=getSize(i_wyckLblSize)))
    if array.size(wyckLbls) > i_maxWyckLbls
        label.delete(array.shift(wyckLbls))

var int barsSinceSpring = 100000
var int barsSinceUT     = 100000
barsSinceSpring := springSig ? 0 : math.min(barsSinceSpring + 1, 100000)
barsSinceUT     := utSig ? 0 : math.min(barsSinceUT + 1, 100000)
bool recentSpring = i_wyckOn and barsSinceSpring <= i_eventMemory
bool recentUT     = i_wyckOn and barsSinceUT <= i_eventMemory

// Effort vs result: who is absorbing inside the range?
float upVol   = math.sum(close > open ? volume : 0.0, i_volLookback)
float downVol = math.sum(close < open ? volume : 0.0, i_volLookback)
float totalDirVol = upVol + downVol
float upVolShare = totalDirVol > 0 ? upVol / totalDirVol : 0.5

// ═══════════════════════════════════════════════════════════════════════════
// HTF DIVERGENCE — RSI regular divergence on the divergence TF
// ═══════════════════════════════════════════════════════════════════════════

[divPH, divPL, divRsiAtPivot] = request.security(syminfo.tickerid, resolveTF(i_divTF),
     [ta.pivothigh(high, i_divWings, i_divWings),
      ta.pivotlow(low, i_divWings, i_divWings),
      ta.rsi(close, i_divRsiLen)[i_divWings]],
     lookahead=barmerge.lookahead_off)

bool newDivPH = not na(divPH) and (na(divPH[1]) or divPH != divPH[1])
bool newDivPL = not na(divPL) and (na(divPL[1]) or divPL != divPL[1])

var float lastPH = na
var float prevPH = na
var float lastPHRsi = na
var float prevPHRsi = na
var float lastPL = na
var float prevPL = na
var float lastPLRsi = na
var float prevPLRsi = na

bool bearDivNew = false
bool bullDivNew = false

if newDivPH
    prevPH := lastPH
    prevPHRsi := lastPHRsi
    lastPH := divPH
    lastPHRsi := divRsiAtPivot
    if i_divOn and not na(prevPH) and not na(prevPHRsi) and lastPH > prevPH and lastPHRsi < prevPHRsi
        bearDivNew := true

if newDivPL
    prevPL := lastPL
    prevPLRsi := lastPLRsi
    lastPL := divPL
    lastPLRsi := divRsiAtPivot
    if i_divOn and not na(prevPL) and not na(prevPLRsi) and lastPL < prevPL and lastPLRsi > prevPLRsi
        bullDivNew := true

var int barsSinceBullDiv = 100000
var int barsSinceBearDiv = 100000
barsSinceBullDiv := bullDivNew ? 0 : math.min(barsSinceBullDiv + 1, 100000)
barsSinceBearDiv := bearDivNew ? 0 : math.min(barsSinceBearDiv + 1, 100000)
bool recentBullDiv = i_divOn and barsSinceBullDiv <= i_eventMemory
bool recentBearDiv = i_divOn and barsSinceBearDiv <= i_eventMemory

// ═══════════════════════════════════════════════════════════════════════════
// REGIME ENGINE — consolidation is the DEFAULT classification
// ═══════════════════════════════════════════════════════════════════════════

// Clamp the confirmation threshold to the active-EMA count so turning a slot
// off cannot silently make TRENDING unreachable (4-of-3 == never).
// v1.8: with ZERO active EMAs the confirmation FAILS. In v1.7 the test read
// (maAbove 0 >= 0) and (maSlopeUp 0 >= -1), both vacuously true, so disabling
// every EMA inverted the consolidation prior and made every breakout a
// confirmed trend — the exact opposite of the setting's purpose.
int maConfirmEff = math.min(i_maConfirmMin, maActive)
bool maConfirmUp   = maActive > 0 and maAbove >= maConfirmEff and maSlopeUp >= math.max(1, maConfirmEff - 1)
bool maConfirmDown = maActive > 0 and maBelow >= maConfirmEff and maSlopeDown >= math.max(1, maConfirmEff - 1)

bool trendingUp   = brokeUp and (not i_reqMaConfirm or maConfirmUp)
bool trendingDown = brokeDown and (not i_reqMaConfirm or maConfirmDown)

int accumEv = 0
int distEv = 0
if fellIntoRange
    accumEv += 1
if roseIntoRange
    distEv += 1
if upVolShare > i_volBias
    accumEv += 1
if upVolShare < 1.0 - i_volBias
    distEv += 1
if recentSpring
    accumEv += 1
if recentUT
    distEv += 1
if recentBullDiv
    accumEv += 1
if recentBearDiv
    distEv += 1

string regimeStr = "NEUTRAL RANGE"
color regimeCol = color.gray
int regimeDir = 0
if trendingUp
    regimeStr := "TRENDING UP"
    regimeCol := color.green
    regimeDir := 1
else if trendingDown
    regimeStr := "TRENDING DOWN"
    regimeCol := color.red
    regimeDir := -1
else if rangeValid and accumEv > distEv
    regimeStr := "ACCUMULATION"
    regimeCol := color.lime
    regimeDir := 1
else if rangeValid and distEv > accumEv
    regimeStr := "DISTRIBUTION"
    regimeCol := color.orange
    regimeDir := -1

int regimeConf = math.abs(accumEv - distEv)
string regimeConfStr = trendingUp or trendingDown ? "Confirmed" : regimeConf >= 3 ? "High" : regimeConf >= 2 ? "Med" : regimeConf >= 1 ? "Low" : "None"

// ═══════════════════════════════════════════════════════════════════════════
// FORECAST ENGINE — six transparent components, -100..+100 each.
// NOTE ON INDEPENDENCE: these components are presented side by side but they
// are not statistically independent. A single qualified spring raises the
// Wyckoff component, can flip Regime to ACCUMULATION, and doubles the Entry
// Value multiplier via regimeDir — roughly +22 net score, ~9 points of bull
// probability, from one bar of evidence. Read the breakdown table with that
// in mind before treating agreement across rows as corroboration.
// ═══════════════════════════════════════════════════════════════════════════

float sMA = maActive > 0 ? (maAbove - maBelow) * (100.0 / maActive) : 0.0
sMA := clamp100(sMA)

float sReg = trendingUp ? 80 : trendingDown ? -80 : regimeStr == "ACCUMULATION" ? 40 : regimeStr == "DISTRIBUTION" ? -40 : 0
sReg := clamp100(sReg)

float sPos = 0.0
if rangeValid and not na(rangePos)
    sPos := regimeDir > 0 ? (50.0 - rangePos) * 2.0 : regimeDir < 0 ? (rangePos - 50.0) * 2.0 : (50.0 - rangePos)
sPos := clamp100(sPos)

float sDiv = (recentBullDiv ? 80.0 : 0.0) + (recentBearDiv ? -80.0 : 0.0)
sDiv := clamp100(sDiv)

float sWyck = (recentSpring ? i_wyckEventPts * 1.0 : 0.0) + (recentUT ? -i_wyckEventPts * 1.0 : 0.0) + (upVolShare - 0.5) * 2.0 * i_wyckVolPts
sWyck := clamp100(sWyck)

float dMacroS   = discScore(i_dMacro, "Strongly Expanding", "Expanding", "Neutral", "Contracting", "Strongly Contracting")
float dCatS     = discScore(i_dCatalyst, "Strong Bullish", "Bullish", "None / Mixed", "Bearish", "Strong Bearish")
float dSmartS   = discScore(i_dSmart, "Strong Buying", "Net Buying", "Neutral", "Net Selling", "Strong Selling")
float dAnalystS = discScore(i_dAnalyst, "Well Above Price", "Above Price", "Near Price", "Below Price", "Well Below Price")
float sDisc = clamp100((dMacroS + dCatS + dSmartS + dAnalystS) / 4.0)

float wSum = i_wMA + i_wReg + i_wPos + i_wDiv + i_wWyck + i_wDisc
float netScore = wSum > 0 ? clamp100((sMA * i_wMA + sReg * i_wReg + sPos * i_wPos + sDiv * i_wDiv + sWyck * i_wWyck + sDisc * i_wDisc) / wSum) : 0.0

float basePF = math.max(i_baseFloor * 1.0, i_basePrior - math.abs(netScore) * i_baseSens)
float remF   = 100.0 - basePF
float bullPF = remF * (50.0 + netScore / 2.0) / 100.0
float bearPF = remF - bullPF

int bullP = math.round(bullPF)
int baseP = math.round(basePF)
int bearP = 100 - bullP - baseP
if bearP < 0
    baseP += bearP
    bearP := 0

string biasStr = bullP >= i_actThresh ? "BULL" : bearP >= i_actThresh ? "BEAR" : "BASE"

// ═══════════════════════════════════════════════════════════════════════════
// FIBONACCI (MFTA v3.1 engine) — anchor source selectable, orientation follows
// the regime/forecast bias unless overridden.
// ═══════════════════════════════════════════════════════════════════════════

// v1.8: ONE direction variable end to end. v1.7 carried a non-sticky biasBull
// used by the Zone+Bias alert and bus stream alongside the sticky orientation
// used to DRAW the zone; inside the hysteresis band they disagreed, so the
// alert could test a bull threshold against bear-side geometry.
var bool biasStickyBull = true
biasStickyBull := regimeDir > 0 ? true : regimeDir < 0 ? false : netScore >= 10 ? true : netScore <= -10 ? false : biasStickyBull
bool biasBull = biasStickyBull

// Lookback extremes (for the "Lookback High/Low" source)
float lbHigh   = ta.highest(high, i_fibLookback)
float lbLow    = ta.lowest(low, i_fibLookback)
int   lbHighBar = bar_index + ta.highestbars(high, i_fibLookback)
int   lbLowBar  = bar_index + ta.lowestbars(low, i_fibLookback)

// Resolve the fib anchor (high, low, and their bar indices) by source
float fibH = na
float fibL = na
int fibHBar = na
int fibLBar = na
if i_fibSource == "Swing H/L"
    fibH := not na(lastSwingH) ? lastSwingH : rangeHi
    fibL := not na(lastSwingL) ? lastSwingL : rangeLo
    fibHBar := not na(lastSwingHBar) ? lastSwingHBar : rangeHiBar
    fibLBar := not na(lastSwingLBar) ? lastSwingLBar : rangeLoBar
else if i_fibSource == "Lookback High/Low"
    fibH := lbHigh
    fibL := lbLow
    fibHBar := lbHighBar
    fibLBar := lbLowBar
else
    fibH := rangeHi
    fibL := rangeLo
    fibHBar := rangeHiBar
    fibLBar := rangeLoBar

// Guard against an inverted anchor (high < low) — a legitimate ordering
// artifact for the Swing / Lookback sources, where the two levels come from
// independent detectors.
if not na(fibH) and not na(fibL) and fibH < fibL
    float tmpP = fibH
    fibH := fibL
    fibL := tmpP
    int tmpB = fibHBar
    fibHBar := fibLBar
    fibLBar := tmpB

// For the HTF Range source, coherence is decided upstream (with the optional
// fallback), so validity is simply the range's validity.
bool fibValid = i_fibSource == "HTF Range" ? rangeValid : not na(fibH) and not na(fibL) and fibH > fibL
float fibSpan = fibValid ? fibH - fibL : na

// Display direction: Auto follows the forecast bias (with hysteresis).
bool fibUp = i_fibTrend == "Uptrend" ? true : i_fibTrend == "Downtrend" ? false : biasStickyBull

// v1.8: SIGNAL direction — independent of the forecast unless you opt in.
// Structural read: if the LOW anchor formed before the HIGH anchor, the last
// completed leg was up, so retracements are measured DOWN from the high.
// v1.8.1: when both anchor bars are unknown (the fallback range supplies
// prices but no bar indices) do NOT default to uptrend — that made the signal
// zone silently long-biased in exactly the broken-fractal case the fallback
// exists for. Fall through to the swing anchors, then to range position.
bool anchorUp = not na(fibHBar) and not na(fibLBar) ? fibLBar <= fibHBar : not na(lastSwingHBar) and not na(lastSwingLBar) ? lastSwingLBar <= lastSwingHBar : not na(rangePos) ? rangePos <= 50 : true
bool sigFibUp = i_sigZoneDir == "Follow Display Fib" ? fibUp : (regimeDir > 0 ? true : regimeDir < 0 ? false : anchorUp)

// Uptrend: retracements measured DOWN from the high (pullback buys),
// extensions project ABOVE the high (targets). Downtrend: exact mirror.
calcRetDir(float pct, bool up) =>
    up ? fibH - fibSpan * (pct / 100) : fibL + fibSpan * (pct / 100)

calcRetR(float pct) =>
    calcRetDir(pct, fibUp)

calcExtR(float pct) =>
    fibUp ? fibH + fibSpan * ((pct - 100) / 100) : fibL - fibSpan * ((pct - 100) / 100)

// Canonical golden zone (38.2-61.8) for entry detection — independent of
// which display levels are toggled/edited (same philosophy as MFTA v3.1)
float gz382 = fibValid ? calcRetR(38.2) : na
float gz618 = fibValid ? calcRetR(61.8) : na
float gzTop = fibValid ? math.max(gz382, gz618) : na
float gzBot = fibValid ? math.min(gz382, gz618) : na
bool inEntryZone = fibValid and close >= gzBot and close <= gzTop
bool aboveFibZone = fibValid and close > gzTop
bool belowFibZone = fibValid and close < gzBot

bool zoneAligned = inEntryZone and ((biasBull and bullP >= i_actThresh) or (not biasBull and bearP >= i_actThresh))
bgcolor(i_gzBgOn and zoneAligned ? i_gzBgCol : na, title="Entry Zone + Bias Background")
bgcolor(i_fibBgAboveOn and aboveFibZone ? color.new(i_fibBgAboveCol, i_fibBgAboveAlpha) : na, title="Above Fib Zone Bg")
bgcolor(i_fibBgBelowOn and belowFibZone ? color.new(i_fibBgBelowCol, i_fibBgBelowAlpha) : na, title="Below Fib Zone Bg")

// ═══════════════════════════════════════════════════════════════════════════
// EMA-FIB CONFLUENCE (ported from MFTA Suite) — selected EMAs inside/near the
// canonical golden zone, optional price-in-zone and slope filters, yellow bg.
// Tolerance is a % of the FIB RANGE (MFTA semantics), not of price.
// ═══════════════════════════════════════════════════════════════════════════

float cfTolAmt = fibValid ? fibSpan * (i_emaFibTolerance / 100.0) : na

cfInZone(float v, float zTop, float zBot, float tolAmt) =>
    not na(v) and not na(zTop) and not na(zBot) and not na(tolAmt) and v >= zBot - tolAmt and v <= zTop + tolAmt

bool cfEma1InZone = i_emaFibEma1 and i_ma1On and fibValid and cfInZone(ma1, gzTop, gzBot, cfTolAmt)
bool cfEma2InZone = i_emaFibEma2 and i_ma2On and fibValid and cfInZone(ma2, gzTop, gzBot, cfTolAmt)
bool cfEma3InZone = i_emaFibEma3 and i_ma3On and fibValid and cfInZone(ma3, gzTop, gzBot, cfTolAmt)

int cfSelCount = (i_emaFibEma1 and i_ma1On ? 1 : 0) + (i_emaFibEma2 and i_ma2On ? 1 : 0) + (i_emaFibEma3 and i_ma3On ? 1 : 0)
int cfInCount  = (cfEma1InZone ? 1 : 0) + (cfEma2InZone ? 1 : 0) + (cfEma3InZone ? 1 : 0)

float cfSlope1 = ma1 - ma1[i_emaFibSlopePeriod]
float cfSlope2 = ma2 - ma2[i_emaFibSlopePeriod]
float cfSlope3 = ma3 - ma3[i_emaFibSlopePeriod]

cfSlopeOK(float sl) =>
    i_emaFibSlopeDir == "Positive" ? sl > 0 : i_emaFibSlopeDir == "Negative" ? sl < 0 : sl != 0

int cfSlopeCount = 0
int cfSlopeTrue = 0
if i_emaFibUseSlope
    if i_emaFibSlope1 and i_ma1On
        cfSlopeCount += 1
        if cfSlopeOK(cfSlope1)
            cfSlopeTrue += 1
    if i_emaFibSlope2 and i_ma2On
        cfSlopeCount += 1
        if cfSlopeOK(cfSlope2)
            cfSlopeTrue += 1
    if i_emaFibSlope3 and i_ma3On
        cfSlopeCount += 1
        if cfSlopeOK(cfSlope3)
            cfSlopeTrue += 1

bool cfSlopeMet = true
if i_emaFibUseSlope and cfSlopeCount > 0
    cfSlopeMet := i_emaFibSlopeLogic == "AND" ? cfSlopeTrue == cfSlopeCount : cfSlopeTrue > 0

bool emaFibConfluence = false
if i_emaFibOn and cfSelCount > 0 and fibValid
    bool cfEmasMet = i_emaFibLogic == "Any" ? cfInCount > 0 : cfInCount == cfSelCount
    emaFibConfluence := cfEmasMet
    if i_emaFibPriceInZone
        emaFibConfluence := emaFibConfluence and inEntryZone
    if i_emaFibUseSlope
        emaFibConfluence := emaFibConfluence and cfSlopeMet

bgcolor(emaFibConfluence ? color.new(i_emaFibCol, i_emaFibAlpha) : na, title="EMA-Fib Confluence Background")

// Direction of the confluence for table coloring: explicit slope direction
// wins; "Either" or slope-off follows the fib orientation.
// v1.8.4: measured direction. cfDirUp/Dn count the slope SIGN of the EMAs
// included in the confluence; cfPriceBull mirrors the MA Stack row.
int cfDirUp = 0
int cfDirDn = 0
if i_emaFibEma1 and i_ma1On
    if cfSlope1 > 0
        cfDirUp += 1
    if cfSlope1 < 0
        cfDirDn += 1
if i_emaFibEma2 and i_ma2On
    if cfSlope2 > 0
        cfDirUp += 1
    if cfSlope2 < 0
        cfDirDn += 1
if i_emaFibEma3 and i_ma3On
    if cfSlope3 > 0
        cfDirUp += 1
    if cfSlope3 < 0
        cfDirDn += 1
bool cfSlopesBull = cfDirUp > cfDirDn
bool cfPriceBull  = maAbove > maBelow
bool confFibBull  = i_emaFibUseSlope ? (i_emaFibSlopeDir == "Positive" ? true : i_emaFibSlopeDir == "Negative" ? false : fibUp) : fibUp
bool confBull = i_confDirSrc == "EMA Slopes" ? cfSlopesBull : i_confDirSrc == "Price vs EMAs" ? cfPriceBull : i_confDirSrc == "Slopes + Price" ? (cfSlopesBull and cfPriceBull) : i_confDirSrc == "Regime" ? regimeDir >= 0 : confFibBull
color confCol = confBull ? i_confBullCol : i_confBearCol

// Multi-level zone fills (MFTA style): 38.2-50 and 50-61.8
bool showFill = i_fibFillOn and fibValid
float fill382 = showFill ? calcRetR(38.2) : na
float fill500 = showFill ? calcRetR(50.0) : na
float fill618 = showFill ? calcRetR(61.8) : na
color fill382_500Col = i_fibFillMulti ? color.new(i_fibFill382Col, i_fibFillAlpha) : color.new(i_fibFillSingleCol, i_fibFillAlpha)
color fill500_618Col = i_fibFillMulti ? color.new(i_fibFill618Col, i_fibFillAlpha) : color.new(i_fibFillSingleCol, i_fibFillAlpha)
plot382 = plot(fill382, "Fill 38.2%", color=na, display=display.none)
plot500 = plot(fill500, "Fill 50%", color=na, display=display.none)
plot618 = plot(fill618, "Fill 61.8%", color=na, display=display.none)
fill(plot382, plot500, color=showFill ? fill382_500Col : na, title="Fill 38.2-50%")
fill(plot500, plot618, color=showFill ? fill500_618Col : na, title="Fill 50-61.8%")

formatFibLbl(float pct, float price) =>
    i_fibLblFmt == "Percent" ? str.tostring(pct, "#.#") + "%" : i_fibLblFmt == "Price" ? str.tostring(price, format.mintick) : str.tostring(pct, "#.#") + "% | " + str.tostring(price, format.mintick)

var array<line> fibLines = array.new<line>()
var array<label> fibLabels = array.new<label>()

drawFib(bool enabled, float pct, color baseCol, bool isExt, int x1, int x2, string lblStyle) =>
    float p = isExt ? calcExtR(pct) : calcRetR(pct)
    // Down-orientation extensions can project to ZERO or NEGATIVE prices
    // (e.g. 161.8%+ measured below a low). Handing a non-positive y to
    // line.new/label.new on a LOG-SCALE chart degenerates the object into a
    // vertical artifact anchored at the current bar. Only draw valid prices.
    if enabled and not na(p) and p > syminfo.mintick
        color c = i_fibSingleCol ? i_fibUniformCol : baseCol
        array.push(fibLines, line.new(x1, p, x2, p, color=c, width=isExt ? i_fibExtW : i_fibRetW, style=isExt ? getLineStyle(i_fibExtStyle) : getLineStyle(i_fibRetStyle), extend=getExtend(i_fibExtend)))
        if i_fibLblOn
            array.push(fibLabels, label.new(x2, p, formatFibLbl(pct, p) + (isExt ? " TGT" : ""), style=lblStyle, color=color.new(c, 100), textcolor=c, size=getSize(i_fibLblSize)))

// ═══════════════════════════════════════════════════════════════════════════
// SIGNAL ENGINE — reversal reclaim detection with EMA1-test entries.
// State machine per side: NONE(0) -> SETUP(1) -> PENDING(2) -> CONFIRMED(3)
// -> HOLDING(4) -> INVALIDATED flash(5).
//
// GATE COMPOSITION: three "fresh licenses" mark a setup as NEW — reclaim,
// fresh stack (now qualified), and Wyckoff. Any license satisfies the
// reversal-freshness requirement, bypasses the slope-alignment veto, bypasses
// the fib-zone veto in Reclaim+Test mode, AND makes the EMA1 test eligible to
// trigger. The route that actually opened the door is latched and published.
// ═══════════════════════════════════════════════════════════════════════════

float sigAtr  = ta.atr(i_sigAtrLen)
float tolFrac = i_sigTolMode == "ATR Fraction" ? (sigAtr * i_sigAtrFrac) / close : i_sigTestTolPct / 100.0
float belowFrac = tolFrac * i_sigBelowTolMult

// Per-EMA status: 1 = ABOVE (beyond tolerance, no touch), 0 = TESTING
// (within tolerance, or the bar straddles it without closing below the BELOW
// band), -1 = BELOW, -2 = not included in the signal set.
emaSigStatus(bool incl, float v) =>
    int st = -2
    if incl and not na(v)
        bool ab = close > v * (1 + tolFrac)
        bool be = close < v * (1 - belowFrac)
        bool straddle = low <= v and high >= v
        st := ab and not straddle ? 1 : be ? -1 : 0
    st

bool sIncl1 = i_ma1On and i_sig1
bool sIncl2 = i_ma2On and i_sig2
bool sIncl3 = i_ma3On and i_sig3
bool sIncl4 = i_ma4On and i_sig4
bool sIncl5 = i_ma5On and i_sig5
bool sIncl6 = i_ma6On and i_sig6

int st1 = emaSigStatus(sIncl1, ma1)
int st2 = emaSigStatus(sIncl2, ma2)
int st3 = emaSigStatus(sIncl3, ma3)
int st4 = emaSigStatus(sIncl4, ma4)
int st5 = emaSigStatus(sIncl5, ma5)
int st6 = emaSigStatus(sIncl6, ma6)

int nSig = (st1 != -2 ? 1 : 0) + (st2 != -2 ? 1 : 0) + (st3 != -2 ? 1 : 0) + (st4 != -2 ? 1 : 0) + (st5 != -2 ? 1 : 0) + (st6 != -2 ? 1 : 0)
int nAb  = (st1 == 1 ? 1 : 0) + (st2 == 1 ? 1 : 0) + (st3 == 1 ? 1 : 0) + (st4 == 1 ? 1 : 0) + (st5 == 1 ? 1 : 0) + (st6 == 1 ? 1 : 0)
int nTe  = (st1 == 0 ? 1 : 0) + (st2 == 0 ? 1 : 0) + (st3 == 0 ? 1 : 0) + (st4 == 0 ? 1 : 0) + (st5 == 0 ? 1 : 0) + (st6 == 0 ? 1 : 0)
int nBe  = (st1 == -1 ? 1 : 0) + (st2 == -1 ? 1 : 0) + (st3 == -1 ? 1 : 0) + (st4 == -1 ? 1 : 0) + (st5 == -1 ? 1 : 0) + (st6 == -1 ? 1 : 0)

// Lowest / highest signal EMA (invalidation and stop references)
float lowestSig = na
float highestSig = na
if sIncl1
    lowestSig := na(lowestSig) ? ma1 : math.min(lowestSig, ma1)
    highestSig := na(highestSig) ? ma1 : math.max(highestSig, ma1)
if sIncl2
    lowestSig := na(lowestSig) ? ma2 : math.min(lowestSig, ma2)
    highestSig := na(highestSig) ? ma2 : math.max(highestSig, ma2)
if sIncl3
    lowestSig := na(lowestSig) ? ma3 : math.min(lowestSig, ma3)
    highestSig := na(highestSig) ? ma3 : math.max(highestSig, ma3)
if sIncl4
    lowestSig := na(lowestSig) ? ma4 : math.min(lowestSig, ma4)
    highestSig := na(highestSig) ? ma4 : math.max(highestSig, ma4)
if sIncl5
    lowestSig := na(lowestSig) ? ma5 : math.min(lowestSig, ma5)
    highestSig := na(highestSig) ? ma5 : math.max(highestSig, ma5)
if sIncl6
    lowestSig := na(lowestSig) ? ma6 : math.min(lowestSig, ma6)
    highestSig := na(highestSig) ? ma6 : math.max(highestSig, ma6)

// Slope counts over slope-member EMAs (slope = EMA vs itself [Slope Lookback]
// bars ago on ITS OWN timeframe — already computed by the MA stack)
bool pIncl1 = i_ma1On and i_slp1
bool pIncl2 = i_ma2On and i_slp2
bool pIncl3 = i_ma3On and i_slp3
bool pIncl4 = i_ma4On and i_slp4
bool pIncl5 = i_ma5On and i_slp5
bool pIncl6 = i_ma6On and i_slp6
int nSlp = (pIncl1 ? 1 : 0) + (pIncl2 ? 1 : 0) + (pIncl3 ? 1 : 0) + (pIncl4 ? 1 : 0) + (pIncl5 ? 1 : 0) + (pIncl6 ? 1 : 0)
int sUpC = (pIncl1 and slopeUpOK(ma1, ma1Lag) ? 1 : 0) + (pIncl2 and slopeUpOK(ma2, ma2Lag) ? 1 : 0) + (pIncl3 and slopeUpOK(ma3, ma3Lag) ? 1 : 0) + (pIncl4 and slopeUpOK(ma4, ma4Lag) ? 1 : 0) + (pIncl5 and slopeUpOK(ma5, ma5Lag) ? 1 : 0) + (pIncl6 and slopeUpOK(ma6, ma6Lag) ? 1 : 0)
int sDnC = (pIncl1 and slopeDnOK(ma1, ma1Lag) ? 1 : 0) + (pIncl2 and slopeDnOK(ma2, ma2Lag) ? 1 : 0) + (pIncl3 and slopeDnOK(ma3, ma3Lag) ? 1 : 0) + (pIncl4 and slopeDnOK(ma4, ma4Lag) ? 1 : 0) + (pIncl5 and slopeDnOK(ma5, ma5Lag) ? 1 : 0) + (pIncl6 and slopeDnOK(ma6, ma6Lag) ? 1 : 0)

// nSlp == 0 -> slope requirement vacuously passes (user opted every EMA out)
bool slopeAlignedUp = nSlp == 0 or (i_sigSlopeMode == "All Rising" ? sUpC == nSlp : i_sigSlopeMode == "Majority Rising" ? sUpC * 2 > nSlp : true)
bool slopeAlignedDn = nSlp == 0 or (i_sigSlopeMode == "All Rising" ? sDnC == nSlp : i_sigSlopeMode == "Majority Rising" ? sDnC * 2 > nSlp : true)

// Freshness: bars since the alignment BEGAN (continuous run). This is the
// reversal detector — an alignment older than the window is a trend, not a flip.
var int alignAgeUp = 100000
var int alignAgeDn = 100000
alignAgeUp := slopeAlignedUp ? (slopeAlignedUp[1] ? math.min(alignAgeUp + 1, 100000) : 0) : 100000
alignAgeDn := slopeAlignedDn ? (slopeAlignedDn[1] ? math.min(alignAgeDn + 1, 100000) : 0) : 100000
bool slopeGenuineUp = slopeAlignedUp and (not i_sigFreshOn or alignAgeUp <= i_sigFreshBars)
bool slopeGenuineDn = slopeAlignedDn and (not i_sigFreshOn or alignAgeDn <= i_sigFreshBars)

// Composite EMA states. v1.8: in asymmetric mode EMA 1 may sit inside the test
// band without breaking the "below all" requirement — otherwise the bar that
// DEFINES a short test (close inside the tolerance band -> status TESTING) is
// the same bar that disqualifies the state, and short test entries are
// mathematically unreachable.
bool bullStruct = nSig > 0 and nBe == 0
// The `nBe >= 1` term keeps the carve-out from making bullStruct and
// bearStruct simultaneously true in the degenerate single-signal-EMA config
// (nSig == 1, EMA 1 inside the band: nBe == 0 satisfies both otherwise).
bool bearStruct = nSig > 0 and (i_sigSymmetric ? nAb == 0 : (nBe == nSig or (nBe >= 1 and nBe == nSig - 1 and st1 == 0)))
bool bullStateSig = i_sigOn and bullStruct
bool bearStateSig = i_sigOn and bearStruct

// Fresh-reclaim tracking: age in bars since the structure was recovered
// (no signal EMA below, where at least one WAS below on the prior bar).
bool reclaimEdgeL = bullStateSig and not bullStateSig[1]
bool reclaimEdgeS = bearStateSig and not bearStateSig[1]
var int reclaimAgeL = 100000
var int reclaimAgeS = 100000
reclaimAgeL := reclaimEdgeL ? 0 : bullStateSig ? math.min(reclaimAgeL + 1, 100000) : 100000
reclaimAgeS := reclaimEdgeS ? 0 : bearStateSig ? math.min(reclaimAgeS + 1, 100000) : 100000
bool reclaimModeOn = i_sigEntryMode == "Reclaim + Test (fresh)"

// First-K-tests tracking: test episodes consumed since the last reclaim.
// Expires the moment the structure is lost; resets to 0 on a new reclaim.
var int testsSinceRecL = 99
var int testsSinceRecS = 99
if reclaimEdgeL
    testsSinceRecL := 0
else if not bullStateSig
    testsSinceRecL := 99
if reclaimEdgeS
    testsSinceRecS := 0
else if not bearStateSig
    testsSinceRecS := 99

bool reclaimRouteL = i_licReclaim and reclaimModeOn and (reclaimAgeL <= i_sigReclaimMem or testsSinceRecL < i_sigTestsPerReclaim)
bool reclaimRouteS = i_licReclaim and reclaimModeOn and (reclaimAgeS <= i_sigReclaimMem or testsSinceRecS < i_sigTestsPerReclaim)

// ── STACK ORDER, ranked by EFFECTIVE length ────────────────────────────────
// Members are ranked fastest-first by length-in-chart-bars, then the fastest N
// ("Stack Order Depth", 0 = all) must be in strict descending order.
//
// v1.8.1 DUPLICATE COLLAPSE. Two members with IDENTICAL effective length are
// the same average — a 50 EMA on 1W IS the chart 50 when the chart IS 1W.
// v1.7 chained them anyway and demanded ma1 > ... > ma6 with ma6 == ma1, an
// arithmetic contradiction that left stackUp and stackDn permanently false and
// the whole engine mute. v1.8 skipped tied pairs so they could not deadlock,
// but the tie still OCCUPIED a slot of the depth window and so deleted a real
// constraint from the chain. Duplicates are now folded out BEFORE the window
// is built, so every pair inside it is enforceable. On a tie the lowest slot
// number supplies the value, i.e. the member you configured first.
var array<float> stkLen  = array.new<float>()
var array<float> stkVal  = array.new<float>()
var array<int>   stkSlot = array.new<int>()
array.clear(stkLen)
array.clear(stkVal)
array.clear(stkSlot)
if sIncl1 and not na(ma1)
    array.push(stkLen, ef1)
    array.push(stkVal, ma1)
    array.push(stkSlot, 1)
if sIncl2 and not na(ma2)
    array.push(stkLen, ef2)
    array.push(stkVal, ma2)
    array.push(stkSlot, 2)
if sIncl3 and not na(ma3)
    array.push(stkLen, ef3)
    array.push(stkVal, ma3)
    array.push(stkSlot, 3)
if sIncl4 and not na(ma4)
    array.push(stkLen, ef4)
    array.push(stkVal, ma4)
    array.push(stkSlot, 4)
if sIncl5 and not na(ma5)
    array.push(stkLen, ef5)
    array.push(stkVal, ma5)
    array.push(stkSlot, 5)
if sIncl6 and not na(ma6)
    array.push(stkLen, ef6)
    array.push(stkVal, ma6)
    array.push(stkSlot, 6)

int stackMembers = array.size(stkLen)

// Rank ascending by effective length, folding equal-length runs into one entry.
var array<float> stkRank = array.new<float>()
array.clear(stkRank)
if stackMembers > 0
    array<int> stkOrd = array.sort_indices(stkLen, order.ascending)
    float runLen  = na
    int   runSlot = 99
    float runVal  = na
    for i = 0 to stackMembers - 1
        int   idx = array.get(stkOrd, i)
        float rL  = array.get(stkLen, idx)
        int   rS  = array.get(stkSlot, idx)
        float rV  = array.get(stkVal, idx)
        if na(runLen) or rL > runLen
            if not na(runVal)
                array.push(stkRank, runVal)
            runLen  := rL
            runSlot := rS
            runVal  := rV
        else if rS < runSlot
            runSlot := rS
            runVal  := rV
    if not na(runVal)
        array.push(stkRank, runVal)

int stackDistinct = array.size(stkRank)
int stackDupes = stackMembers - stackDistinct
int stackDepthEff = i_sigStackDepth <= 0 ? stackDistinct : math.min(i_sigStackDepth, stackDistinct)
bool stackNA = stackDepthEff < 2
bool stackUp = not stackNA
bool stackDn = not stackNA
if not stackNA
    for i = 1 to stackDepthEff - 1
        float vPrev = array.get(stkRank, i - 1)
        float vCur  = array.get(stkRank, i)
        stackUp := stackUp and vPrev > vCur
        stackDn := stackDn and vPrev < vCur

bool stackOKUp = not i_sigStackOn or stackNA or stackUp
bool stackOKDn = not i_sigStackOn or stackNA or stackDn

// How long the stack has been BROKEN, ending on the previous bar.
var int unstkRunUp = 0
var int unstkRunDn = 0
unstkRunUp := stackUp ? 0 : unstkRunUp + 1
unstkRunDn := stackDn ? 0 : unstkRunDn + 1

// Last bar on which the OPPOSITE order existed (for the strict recross mode).
var int lastBearStkBar = -100000
var int lastBullStkBar = -100000

// v1.8: qualification. An unqualified re-stack no longer licenses anything.
bool stackQualUp = i_sigStackMode == "Any Re-stack" ? true : i_sigStackMode == "Full Opposite Stack" ? (bar_index - lastBearStkBar) <= i_sigStackQualBars : nz(unstkRunUp[1], 0) >= i_sigStackQualBars
bool stackQualDn = i_sigStackMode == "Any Re-stack" ? true : i_sigStackMode == "Full Opposite Stack" ? (bar_index - lastBullStkBar) <= i_sigStackQualBars : nz(unstkRunDn[1], 0) >= i_sigStackQualBars

bool stackEdgeUp = stackUp and not stackUp[1] and stackQualUp
bool stackEdgeDn = stackDn and not stackDn[1] and stackQualDn

if stackDn
    lastBearStkBar := bar_index
if stackUp
    lastBullStkBar := bar_index

var int stackAgeUp = 100000
var int stackAgeDn = 100000
stackAgeUp := stackEdgeUp ? 0 : (stackUp and stackAgeUp < 100000) ? math.min(stackAgeUp + 1, 100000) : 100000
stackAgeDn := stackEdgeDn ? 0 : (stackDn and stackAgeDn < 100000) ? math.min(stackAgeDn + 1, 100000) : 100000
bool stackRouteL = i_licStack and stackAgeUp <= i_sigStackMem
bool stackRouteS = i_licStack and stackAgeDn <= i_sigStackMem

// Wyckoff license — its OWN short window, not the forecast's event memory.
bool wyckRouteL = i_licSpring and i_sigWyckAssist and barsSinceSpring <= i_sigWyckMem
bool wyckRouteS = i_licSpring and i_sigWyckAssist and barsSinceUT <= i_sigWyckMem

bool freshLicL = reclaimRouteL or stackRouteL or wyckRouteL
bool freshLicS = reclaimRouteS or stackRouteS or wyckRouteS
// Route precedence when several are live at once: reclaim is the most
// specific event, then the stack turn, then the Wyckoff context.
int licCodeL = reclaimRouteL ? 1 : stackRouteL ? 2 : wyckRouteL ? 3 : 0
int licCodeS = reclaimRouteS ? 1 : stackRouteS ? 2 : wyckRouteS ? 3 : 0

// Slope gate. A fresh license bypasses the ALIGNMENT requirement itself, not
// merely its freshness term — EMA slopes mathematically lag both a reclaim
// (still falling on the reclaim bar) and a pullback (the fast EMA's slope dips
// exactly on the test bar), and both vetoes killed entries the licenses were
// specifically designed to permit. The dashboard distinguishes the two.
// v1.8.2: in strict mode the alignment is a HARD requirement. Outside strict
// mode a fresh license still bypasses it (v1.3-v1.8.1 behavior) because EMA
// slopes lag both a reclaim and a pullback — that was the original rationale,
// but it also let a long confirm into a falling stack, which is not a trade.
bool slopeGateUp = i_sigSlopeMode == "Off" ? true : i_sigNoBypass ? slopeGenuineUp : (slopeGenuineUp or freshLicL)
bool slopeGateDn = i_sigSlopeMode == "Off" ? true : i_sigNoBypass ? slopeGenuineDn : (slopeGenuineDn or freshLicS)

// Signal fib zone (own bounds AND, as of v1.8, its own orientation)
float szA = fibValid ? calcRetDir(math.min(i_sigZoneLo, i_sigZoneHi), sigFibUp) : na
float szB = fibValid ? calcRetDir(math.max(i_sigZoneLo, i_sigZoneHi), sigFibUp) : na
float sigZTop = fibValid ? math.max(szA, szB) : na
float sigZBot = fibValid ? math.min(szA, szB) : na
bool przInZone  = fibValid and close >= sigZBot and close <= sigZTop
bool ema1InZone = fibValid and sIncl1 and not na(ma1) and ma1 >= sigZBot and ma1 <= sigZTop
// v1.8: "EMA 1" with EMA 1 disabled falls back to price instead of vetoing forever.
bool zoneRefEma1Usable = sIncl1
bool inSigZone = i_sigZoneRef == "Price" ? przInZone : i_sigZoneRef == "EMA 1" ? (zoneRefEma1Usable ? ema1InZone : przInZone) : (przInZone or ema1InZone)
float sigRetPct = fibValid ? (sigFibUp ? (fibH - close) / fibSpan * 100.0 : (close - fibL) / fibSpan * 100.0) : na
bool inGoldenPkt = not na(sigRetPct) and sigRetPct >= 50 and sigRetPct <= 61.8

// The zone is a hard veto only when NO fresh license is active. The tradeable
// confluence is support being tested WHILE the setup is new.
bool zoneOKL = i_sigNoBypass ? inSigZone : (inSigZone or (reclaimModeOn and freshLicL))
bool zoneOKS = i_sigNoBypass ? inSigZone : (inSigZone or (reclaimModeOn and freshLicS))

// Entry triggers
bool testE1L = sIncl1 and not na(ma1) and (math.abs(close - ma1) / close <= tolFrac or (low <= ma1 and close >= ma1))
bool testE1S = sIncl1 and not na(ma1) and (math.abs(close - ma1) / close <= tolFrac or (high >= ma1 and close <= ma1))
// Symbols with no volume data pass the gate instead of never passing.
bool volGateOK = not i_sigVolGate or na(volume) or na(sigVolSma) or volume > sigVolSma * i_sigVolMult

// Test EPISODES (a multi-bar touch counts once — the episode-start bar).
// v1.8: every fresh license makes a test eligible, including Wyckoff. In v1.7
// the spring license opened the gates but not the door.
bool testEdgeL = testE1L and not testE1L[1]
bool testEdgeS = testE1S and not testE1S[1]
bool testEligL = bullStateSig and (reclaimRouteL or stackRouteL or wyckRouteL)
bool testEligS = bearStateSig and (reclaimRouteS or stackRouteS or wyckRouteS)

bool reclaimTrigL = i_licReclaim and i_sigReclaimBarTrig and reclaimAgeL == 0
bool reclaimTrigS = i_licReclaim and i_sigReclaimBarTrig and reclaimAgeS == 0

bool trigL = volGateOK and (reclaimModeOn ? (reclaimTrigL or (testEdgeL and testEligL)) : i_sigEntryMode == "Testing EMA 1" ? testE1L : i_sigEntryMode == "Testing Any Signal EMA" ? nTe > 0 : reclaimEdgeL)
bool trigS = volGateOK and (reclaimModeOn ? (reclaimTrigS or (testEdgeS and testEligS)) : i_sigEntryMode == "Testing EMA 1" ? testE1S : i_sigEntryMode == "Testing Any Signal EMA" ? nTe > 0 : reclaimEdgeS)

// Gates
bool vetoOKL = not i_sigVetoHTF or regimeStr != "TRENDING DOWN"
bool vetoOKS = not i_sigVetoHTF or regimeStr != "TRENDING UP"
bool regOKL  = not i_sigNeedRegime or regimeDir > 0
bool regOKS  = not i_sigNeedRegime or regimeDir < 0

// Confluence sub-score 0-100 (display always; gating optional)
int sigEmaPtsL = nSig > 0 ? (bullStruct ? (nAb == nSig ? 30 : 22) : math.round(15.0 * nAb / nSig)) : 0
int sigEmaPtsS = nSig > 0 ? (bearStruct ? (nBe == nSig ? 30 : 22) : math.round(15.0 * nBe / nSig)) : 0
int sigSlpPtsL = i_sigSlopeMode == "Off" ? 0 : slopeAlignedUp ? (alignAgeUp <= i_sigFreshBars ? 30 : 18) : (sUpC * 2 > nSlp ? 10 : 0)
int sigSlpPtsS = i_sigSlopeMode == "Off" ? 0 : slopeAlignedDn ? (alignAgeDn <= i_sigFreshBars ? 30 : 18) : (sDnC * 2 > nSlp ? 10 : 0)
int sigZonePts = inGoldenPkt ? 25 : inSigZone ? 18 : 0
int sigVolPts  = na(volume) or na(sigVolSma) ? 8 : volume > sigVolSma ? 15 : volume > sigVolSma * 0.8 ? 5 : 0
int sigScoreL = math.min(100, sigEmaPtsL + sigSlpPtsL + sigZonePts + sigVolPts)
int sigScoreS = math.min(100, sigEmaPtsS + sigSlpPtsS + sigZonePts + sigVolPts)
bool scoreOKL = not i_sigUseScore or sigScoreL >= i_sigMinScore
bool scoreOKS = not i_sigUseScore or sigScoreS >= i_sigMinScore

// v1.8.2 strict gates. Confluence is gated on the SAME flag that lights the
// yellow band, so the gate and what you see on the chart can never disagree.
// With EMA-Fib Slope Direction at its default "Positive" the band is bullish
// by definition and confGateS can never pass — set that dropdown to "Either"
// if you want the confluence requirement active on the short side too.
bool confGateL = not i_sigNeedConf or (emaFibConfluence and (i_emaFibSlopeDir == "Either" or confBull))
bool confGateS = not i_sigNeedConf or (emaFibConfluence and (i_emaFibSlopeDir == "Either" or not confBull))
bool przGateL = not i_sigNeedPriceInZone or przInZone
bool przGateS = not i_sigNeedPriceInZone or przInZone

// Candidates (all structural conditions; the trigger is separate)
bool candL = i_sigOn and bullStateSig and slopeGateUp and stackOKUp and zoneOKL and przGateL and confGateL and vetoOKL and regOKL and scoreOKL
bool candS = i_sigOn and bearStateSig and slopeGateDn and stackOKDn and zoneOKS and przGateS and confGateS and vetoOKS and regOKS and scoreOKS

// State-machine vars — declared before the test-consumption block so the
// consumption condition can see the cooldown counters.
var int sigStL = 0
var int pendL = 0
var int confAgeSL = 0
var int coolSigL = 0
var int flashSigL = 0
var int sigRouteL = 0
var int pendRouteL = 0
var int sigStS = 0
var int pendS = 0
var int confAgeSS = 0
var int coolSigS = 0
var int flashSigS = 0
var int sigRouteS = 0
var int pendRouteS = 0

// Consume a test episode ON USE only — the candidate gate must have been open,
// the engine out of cooldown, and the machine actually able to act (states 3
// and 4 ignore triggers entirely, so a test during HOLDING must not bill the
// budget). The reclaim bar's own cross of EMA1 never counts.
// (coolSig is pre-decrement here; the machine decrements before testing == 0,
// so <= 1 mirrors its trigger gate exactly.)
bool machineIdleL = sigStL != 3 and sigStL != 4 and sigStL != 5
bool machineIdleS = sigStS != 3 and sigStS != 4 and sigStS != 5
if testEdgeL and bullStateSig and candL and machineIdleL and reclaimAgeL > 0 and coolSigL <= 1 and testsSinceRecL < 99
    testsSinceRecL += 1
if testEdgeS and bearStateSig and candS and machineIdleS and reclaimAgeS > 0 and coolSigS <= 1 and testsSinceRecS < 99
    testsSinceRecS += 1

// ── STOP REFERENCE ────────────────────────────────────────────────────────
// v1.8.6: the fib pair SWAPS ROLES when the signal orientation flips. In UP
// orientation 78.6% is the deep level (below price, a valid long stop) while
// 23.6% sits near the high; in DOWN orientation that reverses exactly. So a
// fixed level is the correct stop only half the time, and "Fib Auto" takes
// whichever of the pair sits on the protective side of the trade instead.
// Every fib stop is guarded to a positive price so a custom level beyond 100%
// cannot publish a zero or negative stop on the bus.
fibStopAt(float pct) =>
    float p = fibValid ? calcRetDir(pct, sigFibUp) : na
    not na(p) and p > syminfo.mintick ? p : na

float fibStop786 = fibStopAt(78.6)
float fibStop236 = fibStopAt(23.6)
float fibStopCus = fibStopAt(i_sigStopFibPct)
float fibStopAutoL = not na(fibStop236) and not na(fibStop786) ? math.min(fibStop236, fibStop786) : na
float fibStopAutoS = not na(fibStop236) and not na(fibStop786) ? math.max(fibStop236, fibStop786) : na

float sigStopL = i_sigStopRef == "EMA 1" ? (sIncl1 and not na(ma1) ? ma1 * (1 - i_sigInvalBuf / 100.0) : na) : i_sigStopRef == "Spring / UT Extreme" ? lastSpringLow : i_sigStopRef == "Fib 78.6%" ? fibStop786 : i_sigStopRef == "Fib 23.6%" ? fibStop236 : i_sigStopRef == "Fib Custom %" ? fibStopCus : i_sigStopRef == "Fib Auto (protective)" ? fibStopAutoL : (not na(lowestSig) ? lowestSig * (1 - i_sigInvalBuf / 100.0) : na)
float sigStopS = i_sigStopRef == "EMA 1" ? (sIncl1 and not na(ma1) ? ma1 * (1 + i_sigInvalBuf / 100.0) : na) : i_sigStopRef == "Spring / UT Extreme" ? lastUtHigh : i_sigStopRef == "Fib 78.6%" ? fibStop786 : i_sigStopRef == "Fib 23.6%" ? fibStop236 : i_sigStopRef == "Fib Custom %" ? fibStopCus : i_sigStopRef == "Fib Auto (protective)" ? fibStopAutoS : (not na(highestSig) ? highestSig * (1 + i_sigInvalBuf / 100.0) : na)

// ── INVALIDATION ──────────────────────────────────────────────────────────
// v1.8.6: "Match Stop Reference" lets the state machine invalidate at the level
// you actually treat as the stop. The EMA references carry the Invalidation
// Buffer; the fib levels are already exact, so build room in with Fib Custom %
// rather than buffering them twice.
float invalLevelL = i_sigInvalRef == "EMA 1" ? ((sIncl1 and not na(ma1) ? ma1 : lowestSig) * (1 - i_sigInvalBuf / 100.0)) : i_sigInvalRef == "Match Stop Reference" ? sigStopL : (not na(lowestSig) ? lowestSig * (1 - i_sigInvalBuf / 100.0) : na)
float invalLevelS = i_sigInvalRef == "EMA 1" ? ((sIncl1 and not na(ma1) ? ma1 : highestSig) * (1 + i_sigInvalBuf / 100.0)) : i_sigInvalRef == "Match Stop Reference" ? sigStopS : (not na(highestSig) ? highestSig * (1 + i_sigInvalBuf / 100.0) : na)
bool invalidL = not na(invalLevelL) and close < invalLevelL
bool invalidS = not na(invalLevelS) and close > invalLevelS

// ── State machine: LONG ──
int prevStL = sigStL
if i_sigReclaimClearsCd and reclaimEdgeL
    coolSigL := 0
if coolSigL > 0
    coolSigL -= 1
if sigStL == 3 or sigStL == 4
    if invalidL
        sigStL := 5
        flashSigL := i_sigFlashBars
        coolSigL := i_sigCooldown
    else if not bullStateSig
        sigStL := 0
        coolSigL := i_sigCooldown
    else
        confAgeSL += 1
        if sigStL == 3 and confAgeSL >= i_sigSignalBars
            sigStL := 4
else if sigStL == 2
    if not bullStateSig
        sigStL := 0
        pendL := 0
        coolSigL := i_sigCooldown
    else
        pendL += 1
        if pendL >= i_sigConfirmN
            sigStL := 3
            confAgeSL := 0
            sigRouteL := pendRouteL
else
    if sigStL == 5
        flashSigL -= 1
        if flashSigL <= 0
            sigStL := 0
    if sigStL != 5
        if candL and trigL and coolSigL == 0
            pendL := 1
            pendRouteL := licCodeL
            if pendL >= i_sigConfirmN
                sigStL := 3
                confAgeSL := 0
                sigRouteL := pendRouteL
            else
                sigStL := 2
        else if candL
            sigStL := 1
        else
            sigStL := 0

// ── State machine: SHORT ──
int prevStS = sigStS
if i_sigReclaimClearsCd and reclaimEdgeS
    coolSigS := 0
if coolSigS > 0
    coolSigS -= 1
if sigStS == 3 or sigStS == 4
    if invalidS
        sigStS := 5
        flashSigS := i_sigFlashBars
        coolSigS := i_sigCooldown
    else if not bearStateSig
        sigStS := 0
        coolSigS := i_sigCooldown
    else
        confAgeSS += 1
        if sigStS == 3 and confAgeSS >= i_sigSignalBars
            sigStS := 4
else if sigStS == 2
    if not bearStateSig
        sigStS := 0
        pendS := 0
        coolSigS := i_sigCooldown
    else
        pendS += 1
        if pendS >= i_sigConfirmN
            sigStS := 3
            confAgeSS := 0
            sigRouteS := pendRouteS
else
    if sigStS == 5
        flashSigS -= 1
        if flashSigS <= 0
            sigStS := 0
    if sigStS != 5
        if candS and trigS and coolSigS == 0
            pendS := 1
            pendRouteS := licCodeS
            if pendS >= i_sigConfirmN
                sigStS := 3
                confAgeSS := 0
                sigRouteS := pendRouteS
            else
                sigStS := 2
        else if candS
            sigStS := 1
        else
            sigStS := 0

bool sigConfL  = sigStL == 3 and prevStL != 3 and prevStL != 4
bool sigConfS  = sigStS == 3 and prevStS != 3 and prevStS != 4
bool sigSetupL = sigStL == 1 and prevStL == 0
bool sigSetupS = sigStS == 1 and prevStS == 0

// v1.8: SIGNAL END — fires on BOTH exit paths out of CONFIRMED/HOLDING, the
// invalidation AND the far more common silent "structure lost" reset. This is
// the exit the system previously did not have.
bool sigEndL = (prevStL == 3 or prevStL == 4) and (sigStL == 0 or sigStL == 5)
bool sigEndS = (prevStS == 3 or prevStS == 4) and (sigStS == 0 or sigStS == 5)
string sigEndWhyL = sigStL == 5 ? "invalidated" : "structure lost"
string sigEndWhyS = sigStS == 5 ? "invalidated" : "structure lost"

// v1.8.8: trade-result tracking. Latched at confirmation, excursions updated
// through the life of the position INCLUDING the exit bar (the trade was live
// intra-bar there), read by the exit tooltip and the Signal Ended alert.
var float entPxL   = na
var int   entTimeL = na
var int   entBarL  = na
var float entStopAtL = na
var float mfeHiL = na
var float maeLoL = na
var float entPxS   = na
var int   entTimeS = na
var int   entBarS  = na
var float entStopAtS = na
var float mfeLoS = na
var float maeHiS = na

if sigConfL
    entPxL := close
    entTimeL := time
    entBarL := bar_index
    entStopAtL := sigStopL
    mfeHiL := high
    maeLoL := low
else if sigStL == 3 or sigStL == 4 or sigEndL
    mfeHiL := math.max(nz(mfeHiL, high), high)
    maeLoL := math.min(nz(maeLoL, low), low)

if sigConfS
    entPxS := close
    entTimeS := time
    entBarS := bar_index
    entStopAtS := sigStopS
    mfeLoS := low
    maeHiS := high
else if sigStS == 3 or sigStS == 4 or sigEndS
    mfeLoS := math.min(nz(mfeLoS, low), low)
    maeHiS := math.max(nz(maeHiS, high), high)

// One-line result for the alert; multi-line for the tooltip. R is computed
// against the ENTRY-time stop; if that stop was missing or on the wrong side
// of entry (possible pre-v1.8.6 with a fixed fib level) R reads "—" rather
// than a fabricated number.
fmtD(int tm) =>
    na(tm) ? "—" : str.format("{0,date,d MMM yy}", tm)

exitBrief(bool useL) =>
    float ep = useL ? entPxL : entPxS
    float xp = close
    if na(ep)
        "result: — (no latched entry)"
    else
        float dPct = useL ? (xp - ep) / ep * 100.0 : (ep - xp) / ep * 100.0
        float risk = useL ? ep - entStopAtL : entStopAtS - ep
        string rTxt = na(risk) or risk <= 0 ? "—" : str.tostring((useL ? xp - ep : ep - xp) / risk, "#.##") + "R"
        int held = bar_index - (useL ? entBarL : entBarS)
        str.tostring(ep, format.mintick) + " → " + str.tostring(xp, format.mintick) + " = " + (dPct >= 0 ? "+" : "") + str.tostring(dPct, "#.##") + "% (" + rTxt + "), " + str.tostring(held) + " bars"

exitSnap(bool useL) =>
    float ep = useL ? entPxL : entPxS
    float xp = close
    int   et = useL ? entTimeL : entTimeS
    int   eb = useL ? entBarL : entBarS
    float es = useL ? entStopAtL : entStopAtS
    string head = (useL ? "LONG" : "SHORT") + " signal ended — " + (useL ? sigEndWhyL : sigEndWhyS) + " · route: " + routeTag(useL ? sigRouteL : sigRouteS)
    if na(ep)
        head + "\nresult unavailable — no latched entry (signal predates this update on the live bar)"
    else
        float dPct = useL ? (xp - ep) / ep * 100.0 : (ep - xp) / ep * 100.0
        float risk = useL ? ep - es : es - ep
        string rTxt = na(risk) or risk <= 0 ? "— (entry stop invalid)" : str.tostring((useL ? xp - ep : ep - xp) / risk, "#.##") + "R vs entry stop " + str.tostring(es, format.mintick)
        float mfeP = useL ? (nz(mfeHiL, ep) - ep) / ep * 100.0 : (ep - nz(mfeLoS, ep)) / ep * 100.0
        float maeP = useL ? (nz(maeLoL, ep) - ep) / ep * 100.0 : (ep - nz(maeHiS, ep)) / ep * 100.0
        head + "\nEntry " + str.tostring(ep, format.mintick) + " (" + fmtD(et) + ")  →  Exit " + str.tostring(xp, format.mintick) + " (" + fmtD(time) + ")" + "\nDelta " + (dPct >= 0 ? "+" : "") + str.tostring(dPct, "#.##") + "% · " + rTxt + "\nMFE " + (mfeP >= 0 ? "+" : "") + str.tostring(mfeP, "#.##") + "% · MAE " + str.tostring(maeP, "#.##") + "% · " + str.tostring(bar_index - eb) + " bars held" + "\nSignal result, close-to-close — not your fill"

// v1.8.7: self-auditing marker tooltips — a FROZEN snapshot of what the
// engine knew at the bar the marker was printed. Gate glyphs mirror the
// dashboard exactly so the two vocabularies never diverge.
gateSnap(bool useL) =>
    string zT = inSigZone ? "Z✓" : (useL ? zoneOKL : zoneOKS) ? "Z↺" : "Z✗"
    string pT = przInZone ? "P✓" : "P✗"
    string sT = i_sigSlopeMode == "Off" ? "S–" : (useL ? slopeGenuineUp : slopeGenuineDn) ? "S✓" : (useL ? slopeGateUp : slopeGateDn) ? "S↺" : "S✗"
    string kT = stackNA ? "K–" : (useL ? stackOKUp : stackOKDn) ? "K✓" : "K✗"
    string cT = not i_sigNeedConf ? "C–" : (useL ? confGateL : confGateS) ? "C✓" : "C✗"
    zT + " " + pT + " " + sT + " " + kT + " " + cT

entrySnap(bool useL) =>
    int rt = useL ? sigRouteL : sigRouteS
    int sc = useL ? sigScoreL : sigScoreS
    float sp = useL ? sigStopL : sigStopS
    float dist = not na(sp) and close != 0 ? (useL ? (close - sp) / close * 100.0 : (sp - close) / close * 100.0) : na
    string stopLine = na(sp) ? "Stop ⊣ — · ref: " + i_sigStopRef : "Stop ⊣ " + str.tostring(sp, format.mintick) + " (" + str.tostring(dist, "#.#") + "% risk) · ref: " + i_sigStopRef
    (useL ? "▲ LONG" : "▼ SHORT") + " confirmed · route: " + routeTag(rt) + "\nScore " + str.tostring(sc) + " · " + gateSnap(useL) + "\n" + stopLine + "\nRegime: " + regimeStr + " · Bull " + str.tostring(bullP) + "% / Bear " + str.tostring(bearP) + "%\nSnapshot at confirmation — levels move afterwards"

setupSnap(bool useL) =>
    int lc = useL ? licCodeL : licCodeS
    int sc = useL ? sigScoreL : sigScoreS
    (useL ? "△ Setup LONG" : "▽ Setup SHORT") + " · arming license: " + routeTag(lc) + "\nScore " + str.tostring(sc) + " · " + gateSnap(useL) + "\nAwaiting trigger · snapshot at arming"

// v1.8.9: marker placement, offset from the candle by an ATR multiple.
float sigMarkOff = nz(markerAtr, 0.0) * i_sigMarkOffset
float sigYBelow = math.max(low - sigMarkOff, syminfo.mintick)
float sigYAbove = high + sigMarkOff

// Chart markers. Drawn on bar close only — parity with the close-gated alerts.
var array<label> sigMarks = array.new<label>()
if i_sigMarkOn and sigConfL and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYBelow, i_sigMarkTxtL, style=label.style_label_up, color=color.new(i_sigMarkLCol, i_sigMarkAlpha), textcolor=i_sigMarkLTxtCol, size=getSize(i_sigMarkSize), tooltip=i_sigMarkTip ? entrySnap(true) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))
if i_sigMarkOn and sigConfS and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYAbove, i_sigMarkTxtS, style=label.style_label_down, color=color.new(i_sigMarkSCol, i_sigMarkAlpha), textcolor=i_sigMarkSTxtCol, size=getSize(i_sigMarkSize), tooltip=i_sigMarkTip ? entrySnap(false) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))
if i_sigMarkSetup and sigSetupL and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYBelow, i_sigSetupTxtL, style=label.style_label_up, color=color.new(i_sigSetupCol, i_sigSetupAlpha), textcolor=i_sigSetupCol, size=getSize(i_sigSetupSize), tooltip=i_sigMarkTip ? setupSnap(true) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))
if i_sigMarkSetup and sigSetupS and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYAbove, i_sigSetupTxtS, style=label.style_label_down, color=color.new(i_sigSetupCol, i_sigSetupAlpha), textcolor=i_sigSetupCol, size=getSize(i_sigSetupSize), tooltip=i_sigMarkTip ? setupSnap(false) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))
if i_sigMarkExit and sigEndL and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYAbove, i_sigExitTxt, style=label.style_label_down, color=color.new(i_sigExitLCol, i_sigExitAlpha), textcolor=i_sigExitLTxtCol, size=getSize(i_sigExitSize), tooltip=i_sigMarkTip ? exitSnap(true) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))
if i_sigMarkExit and sigEndS and barstate.isconfirmed
    array.push(sigMarks, label.new(bar_index, sigYBelow, i_sigExitTxt, style=label.style_label_up, color=color.new(i_sigExitSCol, i_sigExitAlpha), textcolor=i_sigExitSTxtCol, size=getSize(i_sigExitSize), tooltip=i_sigMarkTip ? exitSnap(false) : na))
    if array.size(sigMarks) > i_sigMaxMarks
        label.delete(array.shift(sigMarks))

// ═══════════════════════════════════════════════════════════════════════════
// RANGE LINES + FIB DRAWING (last bar)
// ═══════════════════════════════════════════════════════════════════════════

var line rangeHiLine = na
var line rangeLoLine = na

if barstate.islast
    if not na(rangeHiLine)
        line.delete(rangeHiLine)
    if not na(rangeLoLine)
        line.delete(rangeLoLine)
    if i_rangeLinesOn and rangeValid
        int hiX1 = math.max(0, not na(rangeHiBar) ? rangeHiBar : bar_index - 50)
        int loX1 = math.max(0, not na(rangeLoBar) ? rangeLoBar : bar_index - 50)
        rangeHiLine := line.new(hiX1, rangeHi, bar_index, rangeHi, color=i_rangeHiCol, width=i_rangeW, style=getLineStyle(i_rangeStyle), extend=extend.right)
        rangeLoLine := line.new(loX1, rangeLo, bar_index, rangeLo, color=i_rangeLoCol, width=i_rangeW, style=getLineStyle(i_rangeStyle), extend=extend.right)

    while array.size(fibLines) > 0
        line.delete(array.pop(fibLines))
    while array.size(fibLabels) > 0
        label.delete(array.pop(fibLabels))

    if (i_fibOn or i_fibExtOn) and fibValid
        // Anchor at the TREND-ORIGIN of the resolved fib range: uptrend = the
        // low (the move being retraced started there); downtrend = the high.
        int originBar = fibUp ? (not na(fibLBar) ? fibLBar : bar_index - 50) : (not na(fibHBar) ? fibHBar : bar_index - 50)
        int fx1 = math.max(0, originBar + i_fibLineOffset)
        int fx2 = bar_index + i_fibLblOffset
        string fibLblStyle = i_fibLblPosition == "Below" ? label.style_label_up : label.style_label_down

        drawFib(i_fibOn and i_r0On,   i_r0Val,   i_r0Col,   false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r236On, i_r236Val, i_r236Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r382On, i_r382Val, i_r382Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r500On, i_r500Val, i_r500Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r618On, i_r618Val, i_r618Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r786On, i_r786Val, i_r786Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibOn and i_r100On, i_r100Val, i_r100Col, false, fx1, fx2, fibLblStyle)
        drawFib(i_fibExtOn and i_e127On, i_e127Val, i_e127Col, true, fx1, fx2, fibLblStyle)
        drawFib(i_fibExtOn and i_e161On, i_e161Val, i_e161Col, true, fx1, fx2, fibLblStyle)
        drawFib(i_fibExtOn and i_e200On, i_e200Val, i_e200Col, true, fx1, fx2, fibLblStyle)
        drawFib(i_fibExtOn and i_e261On, i_e261Val, i_e261Col, true, fx1, fx2, fibLblStyle)
        drawFib(i_fibExtOn and i_e361On, i_e361Val, i_e361Col, true, fx1, fx2, fibLblStyle)

// ═══════════════════════════════════════════════════════════════════════════
// VOLUME PROFILE — granular, optional up/down split, right-anchored.
// v1.8: rebuilt once per bar rather than on every realtime tick.
// ═══════════════════════════════════════════════════════════════════════════

float vpTop = ta.highest(high, i_vpLookback)
float vpBot = ta.lowest(low, i_vpLookback)

var array<box> vpBoxes = array.new<box>()
var array<line> vpLines = array.new<line>()
var array<label> vpLabels = array.new<label>()
var float pocPrice = na
var float vahPrice = na
var float valPrice = na
var int vpLastBar = -1

if barstate.islast and (i_vpLiveUpdate or bar_index != vpLastBar)
    vpLastBar := bar_index
    while array.size(vpBoxes) > 0
        box.delete(array.pop(vpBoxes))
    while array.size(vpLines) > 0
        line.delete(array.pop(vpLines))
    while array.size(vpLabels) > 0
        label.delete(array.pop(vpLabels))
    pocPrice := na
    vahPrice := na
    valPrice := na

    int avail = math.min(i_vpLookback, bar_index + 1)
    float vpRange = vpTop - vpBot
    if i_vpOn and avail > 10 and vpRange > 0
        int rows = i_vpRows
        float rowH = vpRange / rows
        array<float> rowVolUp = array.new<float>(rows, 0.0)
        array<float> rowVolDn = array.new<float>(rows, 0.0)

        for j = 0 to avail - 1
            float bTop = high[j]
            float bBot = low[j]
            float bVol = volume[j]
            bool bUp = close[j] >= open[j]
            if not na(bVol) and bVol > 0
                float bSpan = bTop - bBot
                int rStart = math.min(rows - 1, math.max(0, int(math.floor((bBot - vpBot) / rowH))))
                // v1.8: clamped at BOTH ends. Pine's for-loop counts DOWN when
                // `to` < `from`, and v6 negative array indexing would then have
                // written silently into the wrong bucket.
                int rEnd   = math.min(rows - 1, math.max(rStart, int(math.floor((bTop - vpBot) / rowH))))
                if bSpan <= 0
                    if bUp
                        array.set(rowVolUp, rStart, array.get(rowVolUp, rStart) + bVol)
                    else
                        array.set(rowVolDn, rStart, array.get(rowVolDn, rStart) + bVol)
                else
                    for r = rStart to rEnd
                        float rBot = vpBot + r * rowH
                        float rTop = rBot + rowH
                        float overlap = math.min(bTop, rTop) - math.max(bBot, rBot)
                        if overlap > 0
                            float slice = bVol * (overlap / bSpan)
                            if bUp
                                array.set(rowVolUp, r, array.get(rowVolUp, r) + slice)
                            else
                                array.set(rowVolDn, r, array.get(rowVolDn, r) + slice)

        array<float> rowVol = array.new<float>(rows, 0.0)
        for r = 0 to rows - 1
            array.set(rowVol, r, array.get(rowVolUp, r) + array.get(rowVolDn, r))

        float totalVol = array.sum(rowVol)
        float maxRowVol = array.max(rowVol)
        if totalVol > 0 and maxRowVol > 0
            int pocIdx = array.indexof(rowVol, maxRowVol)

            int vaLo = pocIdx
            int vaHi = pocIdx
            float vaVol = array.get(rowVol, pocIdx)
            float vaTarget = totalVol * (i_vpVaPct / 100.0)
            while vaVol < vaTarget and (vaLo > 0 or vaHi < rows - 1)
                float volBelow = vaLo > 0 ? array.get(rowVol, vaLo - 1) : -1.0
                float volAbove = vaHi < rows - 1 ? array.get(rowVol, vaHi + 1) : -1.0
                if volAbove < 0 and volBelow < 0
                    break
                if volAbove >= volBelow
                    vaHi += 1
                    vaVol += volAbove
                else
                    vaLo -= 1
                    vaVol += volBelow

            pocPrice := vpBot + (pocIdx + 0.5) * rowH
            vahPrice := vpBot + (vaHi + 1) * rowH
            valPrice := vpBot + vaLo * rowH

            int xRight = bar_index + i_vpOffset + i_vpWidth
            for r = 0 to rows - 1
                float rv = array.get(rowVol, r)
                if rv > 0
                    float rBot = vpBot + r * rowH
                    float rTop = rBot + rowH
                    int barLen = math.max(1, math.round(rv / maxRowVol * i_vpWidth))
                    bool inVA = r >= vaLo and r <= vaHi
                    if i_vpSplit
                        float upShareRow = array.get(rowVolUp, r) / rv
                        int upLen = int(math.round(barLen * upShareRow))
                        int dnLen = barLen - upLen
                        color vaBorder = inVA ? i_vpVaCol : color(na)
                        if upLen > 0
                            array.push(vpBoxes, box.new(left=xRight - upLen, top=rTop, right=xRight, bottom=rBot, border_color=vaBorder, border_width=1, bgcolor=i_vpUpCol))
                        if dnLen > 0
                            array.push(vpBoxes, box.new(left=xRight - upLen - dnLen, top=rTop, right=xRight - upLen, bottom=rBot, border_color=vaBorder, border_width=1, bgcolor=i_vpDownCol))
                    else
                        array.push(vpBoxes, box.new(left=xRight - barLen, top=rTop, right=xRight, bottom=rBot, border_color=color(na), bgcolor=inVA ? i_vpVaCol : i_vpBarCol))

            if i_vpLinesOn
                int lx1 = math.max(0, i_vpExtend ? bar_index - avail + 1 : bar_index + i_vpOffset)
                array.push(vpLines, line.new(lx1, pocPrice, xRight, pocPrice, color=i_vpPocCol, width=i_vpPocW))
                array.push(vpLines, line.new(lx1, vahPrice, xRight, vahPrice, color=i_vpVaLineCol, width=i_vpVaLineW, style=line.style_dashed))
                array.push(vpLines, line.new(lx1, valPrice, xRight, valPrice, color=i_vpVaLineCol, width=i_vpVaLineW, style=line.style_dashed))
            if i_vpLblOn
                array.push(vpLabels, label.new(xRight, pocPrice, "POC " + str.tostring(pocPrice, format.mintick), style=label.style_label_left, color=color.new(i_vpPocCol, 100), textcolor=i_vpPocCol, size=size.tiny))
                array.push(vpLabels, label.new(xRight, vahPrice, "VAH " + str.tostring(vahPrice, format.mintick), style=label.style_label_left, color=color.new(i_vpVaLineCol, 100), textcolor=i_vpVaLineCol, size=size.tiny))
                array.push(vpLabels, label.new(xRight, valPrice, "VAL " + str.tostring(valPrice, format.mintick), style=label.style_label_left, color=color.new(i_vpVaLineCol, 100), textcolor=i_vpVaLineCol, size=size.tiny))

// ═══════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE — per-row toggles, dynamic height
// ═══════════════════════════════════════════════════════════════════════════

var table dashTbl = na

if i_dashOn and barstate.islast
    if not na(dashTbl)
        table.delete(dashTbl)

    int dashRows = 1
    if i_dRegime
        dashRows += 1
    if i_dMaRow
        dashRows += 1
    if i_dRange
        dashRows += 1
    if i_dSwing
        dashRows += 1
    if i_dZone
        dashRows += 1
    if i_dConf
        dashRows += 1
    if i_dSignal
        dashRows += 1
    if i_dWyck
        dashRows += 1
    if i_dDiv
        dashRows += 1
    if i_dVP
        dashRows += 1
    if i_dForecast
        dashRows += 4
    if i_dNet
        dashRows += 1
    if i_dAction
        dashRows += 1

    dashSz = getSize(i_dashSize)
    // Reactive whole-table tint: confluence zone and/or confirmed signal
    bool tintSigL = (i_tintSource == "Signal Engine" or i_tintSource == "Both") and i_sigTintOn and (sigStL == 3 or (i_sigTintHold and sigStL == 4))
    bool tintSigS = (i_tintSource == "Signal Engine" or i_tintSource == "Both") and i_sigTintOn and (sigStS == 3 or (i_sigTintHold and sigStS == 4))
    bool tintConf = (i_tintSource == "EMA-Fib Confluence" or i_tintSource == "Both") and emaFibConfluence
    color dashBgEff = tintSigL ? color.new(i_sigBullCol, i_sigTintAlpha) : tintSigS ? color.new(i_sigBearCol, i_sigTintAlpha) : tintConf ? color.new(confCol, i_confTintAlpha) : i_dashBg
    dashTbl := table.new(getTablePos(i_dashPos), 3, dashRows, bgcolor=dashBgEff, frame_color=i_tblFrameCol, frame_width=i_tblFrameW, border_color=i_tblBorderCol, border_width=i_tblBorderW)
    int row = 0

    table.cell(dashTbl, 0, row, "HTF NAVIGATOR", text_color=i_tblHeaderTxt, text_size=dashSz, bgcolor=i_tblHeaderBg, text_halign=text.align_left)
    table.cell(dashTbl, 1, row, syminfo.ticker, text_color=i_tblHeaderTxt, text_size=dashSz, bgcolor=i_tblHeaderBg)
    table.cell(dashTbl, 2, row, timeframe.period, text_color=i_tblHeaderTxt, text_size=dashSz, bgcolor=i_tblHeaderBg)
    row += 1

    if i_dRegime
        table.cell(dashTbl, 0, row, "Regime", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, regimeStr, text_color=regimeCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, regimeConfStr, text_color=regimeCol, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dMaRow
        string maStr = (i_ma1On ? (close > ma1 ? "✓" : "✗") : "·") + (i_ma2On ? (close > ma2 ? "✓" : "✗") : "·") + (i_ma3On ? (close > ma3 ? "✓" : "✗") : "·") + (i_ma4On ? (close > ma4 ? "✓" : "✗") : "·") + (i_ma5On ? (close > ma5 ? "✓" : "✗") : "·") + (i_ma6On ? (close > ma6 ? "✓" : "✗") : "·")
        color maCol = maAbove > maBelow ? color.green : maBelow > maAbove ? color.red : color.gray
        table.cell(dashTbl, 0, row, "MA Stack 1-6", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, maStr, text_color=maCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, str.tostring(maAbove) + "/" + str.tostring(maActive) + " abv", text_color=maCol, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dRange
        string rangeTip = rangeValid ? (rangeIsFallback ? "FALLBACK RANGE: the Williams fractal pair is incoherent (a new fractal low confirmed ABOVE the stale fractal high), so the range is the highest high / lowest low over the last " + str.tostring(i_ctxLookback) + " " + i_rangeTF + " bars. Treat range position, the golden zone and the spring/upthrust levels as approximate until a coherent fractal pair re-forms." : "Fractal range. Bars since the high fractal confirmed: " + (na(rangeAgeH) ? "—" : str.tostring(rangeAgeH)) + ". Bars since the low fractal confirmed: " + (na(rangeAgeL) ? "—" : str.tostring(rangeAgeL)) + ". A range whose newest anchor is hundreds of bars old is stale — range position and the fib anchor are both measured against it.") : "No valid range: the fractal pair is incoherent and the fallback is disabled. The regime engine, golden zone and non-reclaim signal modes are all inactive until a new fractal confirms."
        table.cell(dashTbl, 0, row, "Range " + i_rangeTF + (rangeIsFallback ? " FB" : ""), text_color=rangeIsFallback ? color.orange : i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left, tooltip=rangeTip)
        table.cell(dashTbl, 1, row, rangeValid ? str.tostring(rangeLo, format.mintick) + " – " + str.tostring(rangeHi, format.mintick) : "forming…", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), tooltip=rangeTip)
        string posStr = rangeValid and not na(rangePos) ? str.tostring(math.min(math.max(rangePos, -50), 150), "#.#") + "%" : "—"
        color posCol = rangeValid and not na(rangePos) ? (rangePos < 38.2 ? color.green : rangePos > 61.8 ? color.red : color.yellow) : color.gray
        table.cell(dashTbl, 2, row, posStr, text_color=posCol, text_size=dashSz, bgcolor=zebraBg(row), tooltip=rangeTip)
        row += 1

    if i_dSwing
        string swTfTxt = swingIsChartTF ? timeframe.period : i_swingTF
        table.cell(dashTbl, 0, row, "Swing " + swTfTxt, text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, not na(lastSwingL) ? "L " + str.tostring(lastSwingL, format.mintick) : "L —", text_color=i_swingLowCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, not na(lastSwingH) ? "H " + str.tostring(lastSwingH, format.mintick) : "H —", text_color=i_swingHighCol, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dZone
        string gzLabel = i_fibSource == "Swing H/L" ? "Golden (Swing)" : i_fibSource == "Lookback High/Low" ? "Golden (LB)" : "Golden Zone"
        table.cell(dashTbl, 0, row, gzLabel, text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, fibValid ? str.tostring(gzBot, format.mintick) + " – " + str.tostring(gzTop, format.mintick) : "—", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, inEntryZone ? "IN ZONE" : "outside", text_color=inEntryZone ? color.yellow : color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dConf
        string cfParts = (i_emaFibEma1 and i_ma1On ? (cfEma1InZone ? "E1✓" : "E1·") : "") + (i_emaFibEma2 and i_ma2On ? (cfEma2InZone ? " E2✓" : " E2·") : "") + (i_emaFibEma3 and i_ma3On ? (cfEma3InZone ? " E3✓" : " E3·") : "")
        string cfDetail = cfParts + (i_emaFibPriceInZone ? (inEntryZone ? " · P✓" : " · P✗") : "") + (i_emaFibUseSlope ? (cfSlopeMet ? " · S✓" : " · S✗") : "")
        string cfTxt = not i_emaFibOn ? "off" : emaFibConfluence ? (confBull ? "▲ " : "▼ ") + i_confActiveTxt : "—"
        color cfBg = emaFibConfluence ? color.new(confCol, i_confRowAlpha) : zebraBg(row)
        color cfTxtCol = emaFibConfluence ? confCol : color.gray
        table.cell(dashTbl, 0, row, "EMA-Fib Conf", text_color=i_dashTxt, text_size=dashSz, bgcolor=cfBg, text_halign=text.align_left)
        table.cell(dashTbl, 1, row, cfTxt, text_color=cfTxtCol, text_size=dashSz, bgcolor=cfBg)
        table.cell(dashTbl, 2, row, cfDetail, text_color=cfTxtCol, text_size=dashSz, bgcolor=cfBg)
        row += 1

    if i_dSignal
        // Rank by LIVE-ness (CONFIRMED > HOLDING > PENDING > SETUP >
        // INVALIDATED flash > none) so a dying flash can't mask a live signal.
        bool useL = sigDispRank(sigStL) >= sigDispRank(sigStS)
        int sst = useL ? sigStL : sigStS
        string sideTxt = useL ? "LONG" : "SHORT"
        color sideCol = useL ? i_sigBullCol : i_sigBearCol
        int pendShow = useL ? pendL : pendS
        int scShow = useL ? sigScoreL : sigScoreS
        int rtShow = useL ? sigRouteL : sigRouteS
        string rtSuffix = (sst == 3 or sst == 4) and rtShow > 0 ? " (" + routeTag(rtShow) + ")" : ""
        string sigTxt = sst == 3 ? sideTxt + " · CONFIRMED ✔" + rtSuffix : sst == 4 ? sideTxt + " · HOLDING" + rtSuffix : sst == 2 ? sideTxt + " · CONFIRM " + str.tostring(pendShow) + "/" + str.tostring(i_sigConfirmN) : sst == 1 ? sideTxt + " · SETUP (await trigger)" : sst == 5 ? "INVALIDATED" : i_sigOn ? "—" : "off"
        color sigRowBg = sst == 3 ? color.new(sideCol, 45) : sst == 4 ? color.new(sideCol, 78) : sst == 2 ? color.new(sideCol, 70) : sst == 1 ? color.new(i_sigSetupCol, 80) : sst == 5 ? color.new(i_sigBearCol, 55) : zebraBg(row)
        color sigTxtCol = sst >= 1 and sst <= 4 ? (sst == 1 ? i_sigSetupCol : sideCol) : sst == 5 ? i_sigBearCol : color.gray
        int rAge = useL ? reclaimAgeL : reclaimAgeS
        int tCnt = useL ? testsSinceRecL : testsSinceRecS
        int fAge = useL ? stackAgeUp : stackAgeDn
        bool fFresh = useL ? stackRouteL : stackRouteS
        bool wFresh = useL ? wyckRouteL : wyckRouteS
        string rTag = rAge <= i_sigReclaimMem ? " · R" + str.tostring(rAge) : tCnt < i_sigTestsPerReclaim ? " · T" + str.tostring(tCnt) + "/" + str.tostring(i_sigTestsPerReclaim) : fFresh ? " · F" + str.tostring(fAge) : wFresh ? " · W" : ""
        // Z✓ in zone / Z↺ bypassed by a fresh license / Z✗ vetoed.
        string zTag = inSigZone ? " · Z✓" : (useL ? zoneOKL : zoneOKS) ? " · Z↺" : " · Z✗"
        // v1.8: S↺ distinguishes a genuine fresh alignment from a bypass.
        string sBase = i_sigSlopeMode == "Off" ? " · S–" : (useL ? slopeGenuineUp : slopeGenuineDn) ? " · S✓" : (useL ? slopeGateUp : slopeGateDn) ? " · S↺" : " · S✗"
        // v1.8.5: the numbers the slope gate actually compares, in slot order,
        // for the SLOPE-MEMBER EMAs only — those are the ones that decide it.
        string slpTxt = ""
        if i_dSigSlopePct
            if pIncl1
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma1, ma1Lag)
            if pIncl2
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma2, ma2Lag)
            if pIncl3
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma3, ma3Lag)
            if pIncl4
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma4, ma4Lag)
            if pIncl5
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma5, ma5Lag)
            if pIncl6
                slpTxt := slpTxt + (slpTxt == "" ? "" : "/") + fmtSlp(ma6, ma6Lag)
        string sTag = sBase + (slpTxt == "" ? "" : " " + slpTxt + "%")
        // K– when fewer than two ranked members exist (order is undefined).
        // v1.8.1: show the duplicate fold (K✓ 3/4 = 4 signal EMAs ranked, one
        // was a duplicate of another, 3 distinct members ordered).
        string kBase = stackNA ? " · K–" : (useL ? stackOKUp : stackOKDn) ? " · K✓" : " · K✗"
        string kTag = kBase + ((stackDupes > 0 or (i_sigStackDepth > 0 and stackDepthEff < stackMembers)) ? " " + str.tostring(stackDepthEff) + "/" + str.tostring(stackMembers) : "")
        int nWith = useL ? nAb + nTe : nBe + nTe
        string cTag = not i_sigNeedConf ? "" : ((useL ? confGateL : confGateS) ? " · C✓" : " · C✗")
        string pTag = not i_sigNeedPriceInZone ? "" : (przInZone ? " · P✓" : " · P✗")
        // v1.8.5: once a position exists the entry score is history — the stop
        // is the number acted on every bar. Distance is signed toward risk, so
        // it reads positive for a stop correctly placed on the losing side.
        bool inPos = sst == 3 or sst == 4
        float stopShow = useL ? sigStopL : sigStopS
        float stopDistPct = not na(stopShow) and close != 0 ? (useL ? (close - stopShow) / close * 100.0 : (stopShow - close) / close * 100.0) : na
        string stopTxt = na(stopShow) ? "⊣ —" : "⊣ " + str.tostring(stopShow, format.mintick) + (na(stopDistPct) ? "" : " (" + str.tostring(stopDistPct, "#.#") + "%)")
        string tailTxt = i_dSigTail == "Score" ? str.tostring(scShow) : i_dSigTail == "Both" ? (inPos ? str.tostring(scShow) + " · " + stopTxt : str.tostring(scShow)) : (inPos ? stopTxt : str.tostring(scShow))
        string sigDetail = str.tostring(nWith) + "/" + str.tostring(nSig) + " EMA" + zTag + pTag + sTag + kTag + cTag + rTag + " · " + tailTxt
        string sigTip = "Gate flags. Z = signal fib zone, S = slope alignment, K = stack order. A ↺ means the gate was BYPASSED by a fresh license rather than genuinely satisfied — the setup is still valid by design, but it is a weaker read than a ✓ and worth a smaller size. R = bars since reclaim, T = first-K tests consumed, F = bars since the stack qualified as fresh, W = a Wyckoff license is carrying the setup. Trailing value = the 0-100 entry confluence score, or while a signal is CONFIRMED/HOLDING the live structural stop marked ⊣ with its distance from price (reference: " + i_sigStopRef + "). The n/m after K is how many EMAs are actually ORDERED versus how many are in the signal set — members with identical effective length (a weekly-50 on a weekly chart IS the chart-50) are folded into one, and members slower than the Stack Order Depth are not chained. If that ratio is not what you expect, the stack gate is testing fewer constraints than you think. P = price itself inside the zone, C = EMA-Fib confluence gate. LIVE SLOPES over the " + str.tostring(i_maSlopeLen) + "-bar lookback, threshold " + str.tostring(i_maSlopeMinPct, "#.##") + "%: EMA1 " + (na(slopePct(ma1, ma1Lag)) ? "—" : str.tostring(slopePct(ma1, ma1Lag), "#.###") + "%") + ", EMA2 " + (na(slopePct(ma2, ma2Lag)) ? "—" : str.tostring(slopePct(ma2, ma2Lag), "#.###") + "%") + ", EMA3 " + (na(slopePct(ma3, ma3Lag)) ? "—" : str.tostring(slopePct(ma3, ma3Lag), "#.###") + "%") + ". If those read as tiny positives while the lines look like they are falling, raise Min Slope % over Lookback."
        table.cell(dashTbl, 0, row, "Signal", text_color=i_dashTxt, text_size=dashSz, bgcolor=sigRowBg, text_halign=text.align_left, tooltip=sigTip)
        table.cell(dashTbl, 1, row, sigTxt, text_color=sigTxtCol, text_size=dashSz, bgcolor=sigRowBg, tooltip=sigTip)
        table.cell(dashTbl, 2, row, sigDetail, text_color=sigTxtCol, text_size=dashSz, bgcolor=sigRowBg, tooltip=sigTip)
        row += 1

    if i_dWyck
        string wyckStr = (recentSpring ? "SPRING " : "") + (recentUT ? "UPTHRUST " : "")
        wyckStr := wyckStr == "" ? (i_wyckOn ? "none recent" : "off") : wyckStr
        table.cell(dashTbl, 0, row, "Wyckoff", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, wyckStr, text_color=recentSpring ? i_springCol : recentUT ? i_utCol : color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, "UpVol " + str.tostring(upVolShare * 100, "#") + "%", text_color=upVolShare > i_volBias ? color.green : upVolShare < 1 - i_volBias ? color.red : color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dDiv
        string divStr = recentBullDiv ? "BULLISH DIV" : recentBearDiv ? "BEARISH DIV" : i_divOn ? "none recent" : "off"
        table.cell(dashTbl, 0, row, "Div " + i_divTF + " RSI", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, divStr, text_color=recentBullDiv ? color.green : recentBearDiv ? color.red : color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, "", text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dVP
        table.cell(dashTbl, 0, row, "Vol Profile", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, not na(pocPrice) ? "POC " + str.tostring(pocPrice, format.mintick) : "—", text_color=i_vpPocCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, not na(vahPrice) and not na(valPrice) ? "VA " + str.tostring(valPrice, format.mintick) + "–" + str.tostring(vahPrice, format.mintick) : "—", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dForecast
        string fcTip = "These six components are displayed side by side but they are NOT independent. One qualified spring raises the Wyckoff score, can flip Regime to ACCUMULATION, and doubles the Entry Value multiplier — roughly +22 net score from a single bar of evidence. Read agreement across rows accordingly."
        table.cell(dashTbl, 0, row, "SUPERFORECAST", text_color=i_tblHeaderTxt, text_size=dashSz, bgcolor=i_tblHeaderBg, text_halign=text.align_left, tooltip=fcTip)
        table.cell(dashTbl, 1, row, "Prob", text_color=i_tblHeaderTxt, text_size=dashSz, bgcolor=i_tblHeaderBg, tooltip=fcTip)
        table.cell(dashTbl, 2, row, "", text_size=dashSz, bgcolor=i_tblHeaderBg)
        row += 1
        table.cell(dashTbl, 0, row, "Bull Case", text_color=color.green, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, str.tostring(bullP) + "%", text_color=color.green, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, probBar(bullP), text_color=color.green, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1
        table.cell(dashTbl, 0, row, "Base Case", text_color=color.gray, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, str.tostring(baseP) + "%", text_color=color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, probBar(baseP), text_color=color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1
        table.cell(dashTbl, 0, row, "Bear Case", text_color=color.red, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, str.tostring(bearP) + "%", text_color=color.red, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, probBar(bearP), text_color=color.red, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dNet
        color nsCol = netScore > 20 ? color.green : netScore < -20 ? color.red : color.gray
        table.cell(dashTbl, 0, row, "Net Score", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, str.tostring(netScore, "#.#"), text_color=nsCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, "(-100…+100)", text_color=color.gray, text_size=dashSz, bgcolor=zebraBg(row))
        row += 1

    if i_dAction
        string actionStr = "STAND ASIDE"
        color actionCol = color.gray
        if bullP >= i_actThresh
            actionStr := inEntryZone ? "LONG @ GOLDEN ZONE" : "LONG BIAS — AWAIT ZONE"
            actionCol := color.green
        else if bearP >= i_actThresh
            actionStr := inEntryZone ? "SHORT @ GOLDEN ZONE" : "SHORT BIAS — AWAIT ZONE"
            actionCol := color.red
        table.cell(dashTbl, 0, row, "Action", text_color=i_dashTxt, text_size=dashSz, bgcolor=zebraBg(row), text_halign=text.align_left)
        table.cell(dashTbl, 1, row, actionStr, text_color=actionCol, text_size=dashSz, bgcolor=zebraBg(row))
        table.cell(dashTbl, 2, row, biasStr, text_color=actionCol, text_size=dashSz, bgcolor=zebraBg(row))

// ═══════════════════════════════════════════════════════════════════════════
// FORECAST BREAKDOWN TABLE — per-row toggles, full audit trail
// ═══════════════════════════════════════════════════════════════════════════

brkRow(table t, int r, string nameStr, float s, int w, string sz) =>
    float contrib = wSum > 0 ? s * w / wSum : 0.0
    color sCol = s > 10 ? color.green : s < -10 ? color.red : color.gray
    table.cell(t, 0, r, nameStr, text_color=i_dashTxt, text_size=sz, bgcolor=zebraBg(r), text_halign=text.align_left)
    table.cell(t, 1, r, str.tostring(s, "#"), text_color=sCol, text_size=sz, bgcolor=zebraBg(r))
    table.cell(t, 2, r, str.tostring(w), text_color=color.gray, text_size=sz, bgcolor=zebraBg(r))
    table.cell(t, 3, r, (contrib >= 0 ? "+" : "") + str.tostring(contrib, "#.#"), text_color=sCol, text_size=sz, bgcolor=zebraBg(r))

var table brkTbl = na

if i_brkOn and barstate.islast
    if not na(brkTbl)
        table.delete(brkTbl)

    int brkRows = 2
    if i_bMA
        brkRows += 1
    if i_bReg
        brkRows += 1
    if i_bPos
        brkRows += 1
    if i_bDiv
        brkRows += 1
    if i_bWyck
        brkRows += 1
    if i_bDisc
        brkRows += 1

    brkSz = getSize(i_brkSize)
    brkTbl := table.new(getTablePos(i_brkPos), 4, brkRows, bgcolor=i_dashBg, frame_color=i_tblFrameCol, frame_width=i_tblFrameW, border_color=i_tblBorderCol, border_width=i_tblBorderW)

    table.cell(brkTbl, 0, 0, "COMPONENT", text_color=i_tblHeaderTxt, text_size=brkSz, bgcolor=i_tblHeaderBg, text_halign=text.align_left)
    table.cell(brkTbl, 1, 0, "Score", text_color=i_tblHeaderTxt, text_size=brkSz, bgcolor=i_tblHeaderBg)
    table.cell(brkTbl, 2, 0, "Wt", text_color=i_tblHeaderTxt, text_size=brkSz, bgcolor=i_tblHeaderBg)
    table.cell(brkTbl, 3, 0, "Contrib", text_color=i_tblHeaderTxt, text_size=brkSz, bgcolor=i_tblHeaderBg)

    int br = 1
    if i_bMA
        brkRow(brkTbl, br, "MA Structure", sMA, i_wMA, brkSz)
        br += 1
    if i_bReg
        brkRow(brkTbl, br, "Regime", sReg, i_wReg, brkSz)
        br += 1
    if i_bPos
        brkRow(brkTbl, br, "Entry Value", sPos, i_wPos, brkSz)
        br += 1
    if i_bDiv
        brkRow(brkTbl, br, "HTF Divergence", sDiv, i_wDiv, brkSz)
        br += 1
    if i_bWyck
        brkRow(brkTbl, br, "Wyckoff Vol", sWyck, i_wWyck, brkSz)
        br += 1
    if i_bDisc
        brkRow(brkTbl, br, "Discretionary", sDisc, i_wDisc, brkSz)
        br += 1

    color netCol = netScore > 20 ? color.green : netScore < -20 ? color.red : color.gray
    table.cell(brkTbl, 0, br, "NET", text_color=i_tblHeaderTxt, text_size=brkSz, bgcolor=i_tblHeaderBg, text_halign=text.align_left)
    table.cell(brkTbl, 1, br, str.tostring(netScore, "#.#"), text_color=netCol, text_size=brkSz, bgcolor=i_tblHeaderBg)
    table.cell(brkTbl, 2, br, str.tostring(wSum, "#"), text_color=color.gray, text_size=brkSz, bgcolor=i_tblHeaderBg)
    table.cell(brkTbl, 3, br, "B" + str.tostring(bullP) + "/N" + str.tostring(baseP) + "/S" + str.tostring(bearP), text_color=netCol, text_size=brkSz, bgcolor=i_tblHeaderBg)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS — dynamic alert() system + alertcondition()s
// ═══════════════════════════════════════════════════════════════════════════

buildMsg(string evt) =>
    evt + " | " + syminfo.ticker + " " + timeframe.period + " | Regime: " + regimeStr + " | Bull " + str.tostring(bullP) + "% / Base " + str.tostring(baseP) + "% / Bear " + str.tostring(bearP) + "% | Px " + str.tostring(close, format.mintick)

// v1.8: regime change measured between successive HTF closes by default, so a
// mid-HTF-bar flicker cannot produce an alert that history will not reproduce.
var string regimeAtHtf = ""
bool regimeChangedHtf = false
if htfNewBar
    if regimeAtHtf != "" and regimeStr != regimeAtHtf
        regimeChangedHtf := true
    regimeAtHtf := regimeStr

bool regimeChangedBar = not barstate.isfirst and regimeStr != regimeStr[1]
bool regimeChanged = i_alertRegimeMode == "Every Bar" ? regimeChangedBar : regimeChangedHtf
bool bullProbCross = bullP >= i_actThresh and bullP[1] < i_actThresh
bool bearProbCross = bearP >= i_actThresh and bearP[1] < i_actThresh

if i_alertMaster and barstate.isconfirmed
    if i_alertRegime and regimeChanged
        alert(buildMsg("REGIME CHANGE → " + regimeStr), alert.freq_once_per_bar_close)
    if i_alertWyck and springSig
        alert(buildMsg("WYCKOFF SPRING"), alert.freq_once_per_bar_close)
    if i_alertWyck and utSig
        alert(buildMsg("WYCKOFF UPTHRUST"), alert.freq_once_per_bar_close)
    if i_alertDiv and bullDivNew
        alert(buildMsg("BULLISH DIVERGENCE (" + i_divTF + ")"), alert.freq_once_per_bar_close)
    if i_alertDiv and bearDivNew
        alert(buildMsg("BEARISH DIVERGENCE (" + i_divTF + ")"), alert.freq_once_per_bar_close)
    if i_alertZone and zoneAligned and not zoneAligned[1]
        alert(buildMsg("ENTRY ZONE + BIAS ALIGNED — " + (biasBull ? "LONG" : "SHORT")), alert.freq_once_per_bar_close)
    if i_alertProb and bullProbCross
        alert(buildMsg("BULL PROBABILITY ≥ " + str.tostring(i_actThresh) + "%"), alert.freq_once_per_bar_close)
    if i_alertProb and bearProbCross
        alert(buildMsg("BEAR PROBABILITY ≥ " + str.tostring(i_actThresh) + "%"), alert.freq_once_per_bar_close)
    if i_alertConf and emaFibConfluence and not emaFibConfluence[1]
        alert(buildMsg("EMA-FIB CONFLUENCE — " + (confBull ? "BULL" : "BEAR") + " zone active"), alert.freq_once_per_bar_close)
    if i_alertSignal and sigConfL
        alert(buildMsg("ENTRY SIGNAL CONFIRMED — LONG (route: " + routeTag(sigRouteL) + ", score " + str.tostring(sigScoreL) + ", stop ref " + (na(sigStopL) ? "—" : str.tostring(sigStopL, format.mintick)) + ")"), alert.freq_once_per_bar_close)
    if i_alertSignal and sigConfS
        alert(buildMsg("ENTRY SIGNAL CONFIRMED — SHORT (route: " + routeTag(sigRouteS) + ", score " + str.tostring(sigScoreS) + ", stop ref " + (na(sigStopS) ? "—" : str.tostring(sigStopS, format.mintick)) + ")"), alert.freq_once_per_bar_close)
    if i_alertSetup and sigSetupL
        alert(buildMsg("SIGNAL SETUP FORMING — LONG"), alert.freq_once_per_bar_close)
    if i_alertSetup and sigSetupS
        alert(buildMsg("SIGNAL SETUP FORMING — SHORT"), alert.freq_once_per_bar_close)
    if i_alertSigEnd and sigEndL
        alert(buildMsg("SIGNAL ENDED — LONG (" + sigEndWhyL + ", route " + routeTag(sigRouteL) + ") · " + exitBrief(true)), alert.freq_once_per_bar_close)
    if i_alertSigEnd and sigEndS
        alert(buildMsg("SIGNAL ENDED — SHORT (" + sigEndWhyS + ", route " + routeTag(sigRouteS) + ") · " + exitBrief(false)), alert.freq_once_per_bar_close)

alertcondition(regimeChanged, "Regime Change", "HTF regime classification changed")
alertcondition(springSig, "Wyckoff Spring", "Qualified spring: shallow undercut + reclaim")
alertcondition(utSig, "Wyckoff Upthrust", "Qualified upthrust: shallow overshoot + rejection")
alertcondition(bullDivNew, "Bullish HTF Divergence", "Regular bullish RSI divergence on divergence TF")
alertcondition(bearDivNew, "Bearish HTF Divergence", "Regular bearish RSI divergence on divergence TF")
alertcondition(zoneAligned and not zoneAligned[1], "Entry Zone + Bias", "Price in golden zone with actionable probability")
alertcondition(emaFibConfluence and not emaFibConfluence[1], "EMA-Fib Confluence Start", "Selected EMAs aligned within the golden zone (MFTA confluence)")
alertcondition(not emaFibConfluence and emaFibConfluence[1], "EMA-Fib Confluence End", "EMA-Fib confluence condition ended")
alertcondition(sigConfL, "Signal Confirmed Long", "Reversal reclaim + EMA test entry confirmed (long)")
alertcondition(sigConfS, "Signal Confirmed Short", "Reversal reclaim + EMA test entry confirmed (short)")
alertcondition(sigSetupL or sigSetupS, "Signal Setup Forming", "Structure aligned, awaiting entry trigger")
alertcondition(sigEndL, "Signal Ended Long", "A confirmed long signal ended (invalidated or structure lost)")
alertcondition(sigEndS, "Signal Ended Short", "A confirmed short signal ended (invalidated or structure lost)")

// ═══════════════════════════════════════════════════════════════════════════
// EXTERNAL SIGNAL BUS — hidden plots for companion tools.
// Not visible on the chart; selectable as a Source input by other indicators
// on this chart (e.g. the Setup Expectancy Lab).
// Regime code: 2=TrendUp, 1=Accum, 0=Neutral, -1=Dist, -2=TrendDown.
// Event streams: +1 = long-side event bar, -1 = short-side, 0 = none.
// Known limitation: a same-bar spring AND upthrust (one bar poking both range
// edges) emits only the spring (+1) on the event stream.
// ═══════════════════════════════════════════════════════════════════════════

int extRegimeCode = trendingUp ? 2 : trendingDown ? -2 : regimeStr == "ACCUMULATION" ? 1 : regimeStr == "DISTRIBUTION" ? -1 : 0
plot(extRegimeCode, "EXT: Regime Code", display=display.none)
plot(springSig ? 1 : utSig ? -1 : 0, "EXT: Spring / Upthrust", display=display.none)
plot(sigConfL ? 1 : sigConfS ? -1 : 0, "EXT: Entry Signal Confirmed", display=display.none)
plot(emaFibConfluence and not emaFibConfluence[1] ? (confBull ? 1 : -1) : 0, "EXT: Confluence Start", display=display.none)
plot(zoneAligned and not zoneAligned[1] ? (biasBull ? 1 : -1) : 0, "EXT: Zone+Bias Start", display=display.none)

// v1.8 additions. ENTRY ROUTE: +1/+2/+3 = long via reclaim / fresh stack /
// Wyckoff; -1/-2/-3 = the short mirrors. Wire this as the Lab's REGIME source
// to bucket expectancy per route — these are structurally different setups.
// Uses the route LATCHED at the trigger bar, not the current bar's license —
// with Confirmation Closes > 1 the licence can lapse during confirmation, and
// the route that opened the door is the one worth measuring.
plot(sigConfL ? sigRouteL : sigConfS ? -sigRouteS : 0, "EXT: Entry Route", display=display.none)
plot(sigEndL ? 1 : sigEndS ? -1 : 0, "EXT: Signal Ended", display=display.none)
// v1.8.8: realised R at exit, close-to-close vs the entry-time stop; na off
// exit bars and when the entry stop was missing/invalid.
float exitR_L = sigEndL and not na(entPxL) and not na(entStopAtL) and entPxL - entStopAtL > 0 ? (close - entPxL) / (entPxL - entStopAtL) : na
float exitR_S = sigEndS and not na(entPxS) and not na(entStopAtS) and entStopAtS - entPxS > 0 ? (entPxS - close) / (entStopAtS - entPxS) : na
plot(sigEndL ? exitR_L : sigEndS ? exitR_S : na, "EXT: Exit R Multiple", display=display.none)
plot(sigStopL, "EXT: Long Stop Ref", display=display.none)
plot(sigStopS, "EXT: Short Stop Ref", display=display.none)
plot(sigStL, "EXT: Long State", display=display.none)
plot(sigStS, "EXT: Short State", display=display.none)

// ═══════════════════════════════════════════════════════════════════════════
// DEBUG (uncomment to verify calculations)
// ═══════════════════════════════════════════════════════════════════════════
// plot(netScore, "Debug: Net Score", display=display.data_window)
// plot(rangePos, "Debug: Range Position %", display=display.data_window)
// plot(upVolShare * 100, "Debug: Up-Volume Share %", display=display.data_window)
// plot(penBelow, "Debug: Spring Penetration %", display=display.data_window)
// plot(stackAgeUp, "Debug: Stack Age (long)", display=display.data_window)
// plot(reclaimAgeL, "Debug: Reclaim Age (long)", display=display.data_window)
// plot(testsSinceRecL, "Debug: Tests Consumed (long)", display=display.data_window)
// plot(ef1, "Debug: EMA1 Effective Bars", display=display.data_window)
// plot(ef6, "Debug: EMA6 Effective Bars", display=display.data_window)
// plot(stackMembers, "Debug: Stack Members Ranked", display=display.data_window)
// plot(licCodeL, "Debug: Long License Route", display=display.data_window)
