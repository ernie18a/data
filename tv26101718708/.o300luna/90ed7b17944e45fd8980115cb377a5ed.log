bool main_short_fire = (ICHI_signal_1 and b1_short_canonical_fire) or (pic_sig_plot and ib_short_canonical_fire) or (comb_enable and cb_short_canonical_fire)
bool main_signal_conflict = main_long_fire and main_short_fire
int main_signal_dir = main_signal_conflict ? 0 : main_long_fire ? 1 : main_short_fire ? -1 : 0
int main_signal_family = (ICHI_signal_1 and (b1_long_canonical_fire or b1_short_canonical_fire)) ? SIGSTAT_B1S1 : (pic_sig_plot and (ib_long_canonical_fire or ib_short_canonical_fire)) ? SIGSTAT_IBIS : (comb_enable and (cb_long_canonical_fire or cb_short_canonical_fire)) ? SIGSTAT_CBCS : SIGSTAT_B1S1
bool main_signal_projection_rr_on = main_signal_rr_source == 'Main Signal Projection'
