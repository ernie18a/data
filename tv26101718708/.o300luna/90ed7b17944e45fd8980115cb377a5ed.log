f_ctx_collect_recent_events(array<signalEventRecord> _active, array<signalEventRecord> _history, int _limit) =>
    array<signalEventRecord> _recent = array.new<signalEventRecord>()
    if _limit > 0
        _active_idx = array.size(_active) - 1
        _history_idx = array.size(_history) - 1
        while array.size(_recent) < _limit and (_active_idx >= 0 or _history_idx >= 0)
            _use_active = false
            if _active_idx >= 0 and _history_idx >= 0
                _active_event = array.get(_active, _active_idx)
                _history_event = array.get(_history, _history_idx)
                _use_active := _active_event.start_bar_index >= _history_event.start_bar_index
            else
                _use_active := _active_idx >= 0
            if _use_active
                array.push(_recent, array.get(_active, _active_idx))
                _active_idx -= 1
            else
                array.push(_recent, array.get(_history, _history_idx))
                _history_idx -= 1
    _recent

f_recent_signal_flip_count_in_arrays(array<signalEventRecord> _history, array<signalEventRecord> _active, int _lookback) =>
    array<signalEventRecord> _recent = f_ctx_collect_recent_events(_active, _history, _lookback)
    int _count = 0
    int _last_dir = 0
    _recent_size = array.size(_recent)
    if _recent_size > 0
        for _idx = 0 to _recent_size - 1
            signalEventRecord _event = array.get(_recent, _idx)
            _dir = _event.direction
            if _dir != 0
                if _last_dir != 0 and _last_dir != _dir
                    _count += 1
                _last_dir := _dir
    _count

f_recent_same_dir_count_in_arrays(array<signalEventRecord> _history, array<signalEventRecord> _active, int _dir, int _lookback) =>
    array<signalEventRecord> _recent = f_ctx_collect_recent_events(_active, _history, _lookback)
    int _count = 0
    _recent_size = array.size(_recent)
    if _recent_size > 0
        for _idx = 0 to _recent_size - 1
            signalEventRecord _event = array.get(_recent, _idx)
            if _event.direction != 0
                _count += _event.direction == _dir ? 1 : 0
    _count

f_recent_opposite_count_in_arrays(array<signalEventRecord> _history, array<signalEventRecord> _active, int _dir, int _lookback) =>
    array<signalEventRecord> _recent = f_ctx_collect_recent_events(_active, _history, _lookback)
    int _count = 0
    _recent_size = array.size(_recent)
    if _recent_size > 0
        for _idx = 0 to _recent_size - 1
            signalEventRecord _event = array.get(_recent, _idx)
            if _event.direction != 0
                _count += _event.direction == -_dir ? 1 : 0
    _count

f_recent_unfavorable_count_in_arrays(array<signalEventRecord> _history, array<signalEventRecord> _active, int _lookback) =>
    array<signalEventRecord> _recent = f_ctx_collect_recent_events(_active, _history, _lookback)
    int _count = 0
    _recent_size = array.size(_recent)
    if _recent_size > 0
        for _idx = 0 to _recent_size - 1
            signalEventRecord _event = array.get(_recent, _idx)
            if _event.direction != 0
                _count += _event.outcome.invalidated ? 1 : 0
    _count

f_recent_neutral_count_in_arrays(array<signalEventRecord> _history, array<signalEventRecord> _active, int _lookback) =>
    array<signalEventRecord> _recent = f_ctx_collect_recent_events(_active, _history, _lookback)
    int _count = 0
    _recent_size = array.size(_recent)
    if _recent_size > 0
        for _idx = 0 to _recent_size - 1
            signalEventRecord _event = array.get(_recent, _idx)
            if _event.direction != 0
                _count += _event.outcome.timed_out ? 1 : 0
    _count

f_recent_signal_flip_count(int _family_id, int _lookback) =>
    if _family_id == SIGSTAT_B1S1
        f_recent_signal_flip_count_in_arrays(ctx_b1s1_history, ctx_b1s1_active, _lookback)
    else if _family_id == SIGSTAT_IBIS
        f_recent_signal_flip_count_in_arrays(ctx_ibis_history, ctx_ibis_active, _lookback)
