         na, OPP_NEUTRAL, na, na, na,
         na, na, na, na, na, na, na, na, na, na, na, na,
         EXT_NEUTRAL, 0, false, NT_NONE, 'NONE',
         '')

f_signal_subtype_id(int _family_id, int _direction) =>
    if _family_id == SIGSTAT_B1S1
        _direction == 1 ? SESUB_B1 : SESUB_S1
    else if _family_id == SIGSTAT_IBIS
        _direction == 1 ? SESUB_IB : SESUB_IS
    else
        _direction == 1 ? SESUB_CB : SESUB_CS

f_snapshot_ichimoku_fields(foundationSnapshot _snap, regimeState _reg) =>
    int _sig_tk_kj = _snap.sig_tk_kj
    int _sig_chikou_price = _snap.sig_chikou_price
    int _sig_chikou_cloud = _snap.sig_chikou_cloud
    int _sig_cloud_flip = _snap.sig_cloud_flip
    bool _chikou_clear = _reg.chikou_clear
    bool _cloud_supportive = _reg.cloud_supportive
    bool _cloud_thin = _reg.cloud_thin
    bool _price_above_cloud = _snap.price_above_cloud
    bool _price_below_cloud = _snap.price_below_cloud
    bool _price_inside_cloud = _snap.price_inside_cloud
    bool _close_above_kijun = _snap.close_above_kijun
    bool _close_below_kijun = _snap.close_below_kijun
    float _price_to_kijun_atr = _snap.price_to_kijun_atr
    [_sig_tk_kj, _sig_chikou_price, _sig_chikou_cloud, _sig_cloud_flip, _chikou_clear, _cloud_supportive, _cloud_thin, _price_above_cloud, _price_below_cloud, _price_inside_cloud, _close_above_kijun, _close_below_kijun, _price_to_kijun_atr]

f_selected_signal_assessment(int _family_id, playbookState _pb, foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, tradePlan _plan, rrState _rr, setupScore _score, presetConfig _cfg) =>
    _direction = _pb.direction != 0 ? _pb.direction : _plan.direction
    [_sig_tk_kj, _sig_chikou_price, _sig_chikou_cloud, _sig_cloud_flip, _chikou_clear, _cloud_supportive, _cloud_thin, _price_above_cloud, _price_below_cloud, _price_inside_cloud, _close_above_kijun, _close_below_kijun, _price_to_kijun_atr] = f_snapshot_ichimoku_fields(_snap, _reg)
    _snapshot = signalOccurrenceSnapshot.new(
         _family_id,
         _direction,
         _plan.signal_price,
         _plan.entry_type,
         _plan.entry_reference,
         _plan.order_price,
         _snap.ctx.atr,
         _reg.regime_id,
         _reg.direction,
         _reg.conflict_count,
         _reg.is_trend,
         _reg.is_pullback,
         _reg.is_range,
         _reg.is_transition,
         _reg.is_low_quality,
         _loc.location_id,
         _loc.location_score,
         _sig_tk_kj,
         _sig_chikou_price,
         _sig_chikou_cloud,
         _sig_cloud_flip,
         _chikou_clear,
         _cloud_supportive,
         _cloud_thin,
         _price_above_cloud,
         _price_below_cloud,
         _price_inside_cloud,
         _close_above_kijun,
         _close_below_kijun,
         _price_to_kijun_atr,
         _snap.price_to_kumo_edge_atr,
         _cfg.timing_chase_dist_atr,
         _cfg.timing_overext_atr,
         _loc.near_kijun,
         _loc.near_kumo_edge,
         _loc.mid_range,
         _loc.bad_location,
         _nt.active,
         _nt.reason_id,
         _nt.against_regime,
         _nt.conflict,
         _pb.playbook_id,
         _pb.state_id,
         _pb.direction,
         _pb.context_ok,
         _pb.location_ok,
         _pb.trigger_ok,
         _pb.invalidated,
         _plan.invalidation,
         _plan.target_1,
         _plan.target_2,
         _rr.rr_t1,
         _rr.rr_t2,
         _plan.entry_distance_from_price,
         0,
         0,
         0,
         0,
         0)
    // Keep descriptive diagnostics from the occurrence snapshot, but adapt the
    // final quality, context and confidence from the already capped SetupScore.
    // This keeps one scoring authority for decision, event, panel and alerts.
    _atr_ref = math.max(_snapshot.atr_at_signal, syminfo.mintick)
    _entry_dist_atr = na(_snapshot.entry_distance_from_price) ? 0.0 : _snapshot.entry_distance_from_price / _atr_ref
    _extension_state = f_classify_extension_state(_snapshot.playbook_id, _snapshot.price_to_kijun_atr, _snapshot.price_to_kumo_edge_atr, _entry_dist_atr, _snapshot.near_kijun, _snapshot.near_kumo_edge, _snapshot.price_inside_cloud, _snapshot.timing_chase_dist_atr, _snapshot.timing_overext_atr)
    _role_id = f_assessment_signal_role(_snapshot)
    _quality = _score.final_score
    _quality_class = _score.grade_text == 'A+' or _score.grade_text == 'A' ? OPP_FAVORABLE : _score.grade_text == 'SKIP' ? OPP_UNFAVORABLE : OPP_NEUTRAL
    _context = f_assessment_clamp((_score.regime_score + _score.structure_score) * (100.0 / 45.0))
    _confidence = f_assessment_clamp(_score.regime_score * 4.0)
    _tradeability = f_assessment_clamp((_score.location_score + _score.trigger_score + _score.rr_timing_score) * (100.0 / 55.0))
    _cap_reason_id = _score.cap_text == 'LOW_QUALITY_CAP' ? NT_LOW_QUALITY : _score.cap_text == 'BAD_LOCATION_CAP' ? NT_BAD_LOCATION : _score.cap_text == 'MID_RANGE_CAP' ? NT_MID_RANGE : _score.cap_text == 'POOR_RR_CAP' ? NT_WEAK_CONTEXT : _score.cap_text == 'INVALIDATED_CAP' ? NT_WEAK_CONTEXT : _score.cap_text == 'NO_TRADE_CAP' ? _nt.reason_id : NT_NONE
    _reason = f_quality_class_text(_quality_class) + ' | R/S/L/T/RR ' + f_safe_score_int_text(_score.regime_score * 4.0) + '/' + f_safe_score_int_text(_score.structure_score * 5.0) + '/' + f_safe_score_int_text(_score.location_score * 5.0) + '/' + f_safe_score_int_text(_score.trigger_score * 5.0) + '/' + f_safe_score_int_text(_score.rr_timing_score * (100.0 / 15.0)) + ' | Total ' + f_safe_score_int_text(_quality) + ' | Cap ' + _score.cap_text
    signalOpportunityAssessment.new(_quality, _quality_class, _context, _tradeability, _confidence, _confidence, _score.regime_score * 4.0, _score.structure_score * 5.0, _score.location_score * 5.0, _score.trigger_score * 5.0, _score.rr_timing_score * (100.0 / 15.0), f_assessment_clamp(100.0 - _snapshot.regime_conflict_count * 20.0), _score.rr_timing_score * (100.0 / 15.0), _score.rr_timing_score * (100.0 / 15.0), f_assessment_clamp((_score.trigger_score + _score.rr_timing_score) * (100.0 / 35.0)), _nt.active ? 0.0 : 100.0, _score.structure_score * 5.0, _extension_state, _role_id, _score.capped, _cap_reason_id, _score.cap_text, _reason)

