plotshape(quality_badge_size_large and quality_badge_short_confirmed, style = shape.square, location = location.abovebar, color = quality_badge_short_color, size = size.large)

ctx_stats_b1s1 := f_runtime_ctx_seed_if_fire(ICHI_signal_1 and b1_long_canonical_fire, SIGSTAT_B1S1, 1, evaluation_snapshot, ctx_b1s1_active, ctx_b1s1_history, ctx_stats_b1s1, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_b1s1 := f_runtime_ctx_seed_if_fire(ICHI_signal_1 and b1_short_canonical_fire, SIGSTAT_B1S1, -1, evaluation_snapshot, ctx_b1s1_active, ctx_b1s1_history, ctx_stats_b1s1, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_ibis := f_runtime_ctx_seed_if_fire(pic_sig_plot and ib_long_canonical_fire, SIGSTAT_IBIS, 1, evaluation_snapshot, ctx_ibis_active, ctx_ibis_history, ctx_stats_ibis, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_ibis := f_runtime_ctx_seed_if_fire(pic_sig_plot and ib_short_canonical_fire, SIGSTAT_IBIS, -1, evaluation_snapshot, ctx_ibis_active, ctx_ibis_history, ctx_stats_ibis, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_cbcs := f_runtime_ctx_seed_if_fire(comb_enable and cb_long_canonical_fire, SIGSTAT_CBCS, 1, evaluation_snapshot, ctx_cbcs_active, ctx_cbcs_history, ctx_stats_cbcs, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_cbcs := f_runtime_ctx_seed_if_fire(comb_enable and cb_short_canonical_fire, SIGSTAT_CBCS, -1, evaluation_snapshot, ctx_cbcs_active, ctx_cbcs_history, ctx_stats_cbcs, foundation_snap, foundation_regime, foundation_location, foundation_no_trade, selected_pb, selected_plan, selected_score, active_cfg, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, MAX_CTX_ACTIVE_PER_FAMILY, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_b1s1 := f_ctx_process_active_events(ctx_b1s1_active, ctx_b1s1_history, ctx_stats_b1s1, high, low, bar_index, MAX_CTX_HISTORY_PER_FAMILY)
ctx_stats_ibis := f_ctx_process_active_events(ctx_ibis_active, ctx_ibis_history, ctx_stats_ibis, high, low, bar_index, MAX_CTX_HISTORY_PER_FAMILY)
