kj_p = plot(TK_cloud_plot ? KJ : na, color = color.new(color.orange, 100), linewidth = 1, title = 'KijunSen') // Kijun-Sen plotten
fill(tk_p, kj_p, color = TK > KJ ? color.new(color.fuchsia, transp_CL) : color.new(color.orange, transp_CL), title = 'TK cloud', show_last = TK_cloud_plot ? 10000 : 0) // TK-KJ Wolkenfüllung
KJ_htf = request.security(syminfo.tickerid, timeframe.period == '1' ? '5' : timeframe.period == '3' ? '15' : timeframe.period == '5' ? '15' : timeframe.period == '15' ? '60' : (timeframe.period == '60' or timeframe.period == '1h') ? '240' : timeframe.isintraday ? 'D' : timeframe.period == 'D' ? 'W' : timeframe.period == '3D' ? 'W' : timeframe.isweekly ? 'M' : na, evaluation_mode == 'Fully Confirmed HTF' ? KJ[1] : KJ, lookahead = barmerge.lookahead_off)

plot(KJ_htf_plot ? KJ_htf : na, color = color.new(color.orange, 0), linewidth = 2, show_last = 2, title = 'Kijun htf 1')

KJ_htf_2 = request.security(syminfo.tickerid, timeframe.period == '1' ? '15' : timeframe.period == '3' ? '60' : timeframe.period == '5' ? '60' : timeframe.period == '15' ? '240' : (timeframe.period == '60' or timeframe.period == '1h') ? 'D' : timeframe.isintraday ? 'W' : timeframe.period == 'D' ? 'M' : timeframe.period == '3D' ? 'M' : timeframe.isweekly ? '3M' : na, evaluation_mode == 'Fully Confirmed HTF' ? KJ[1] : KJ, lookahead = barmerge.lookahead_off)

plot(KJ_htf_plot ? KJ_htf_2 : na, color = color.new(color.orange, 0), linewidth = 3, show_last = 2, title = 'Kijun htf 2')

buy_strong_B1 = TK >= KJ and close > kumo_high and CS > high[CSHSlength] and CS > kumo_high[CSHSlength] and SA > SB
sell_strong_S1 = TK <= KJ and close < kumo_low and CS < low[CSHSlength] and CS < kumo_low[CSHSlength] and SA < SB
b1_fire_raw = buy_strong_B1 and not buy_strong_B1[1]
s1_fire_raw = sell_strong_S1 and not sell_strong_S1[1]

var int b1s1_last_fired_dir = 0
bool b1s1_flip_mode = b1s1_sig_mode == 'Direction Change Only'
bool b1_fire = b1_fire_raw
bool s1_fire = s1_fire_raw
bool b1_marker_fire = b1s1_flip_mode ? b1_fire_raw and b1s1_last_fired_dir != 1 : b1_fire_raw
bool s1_marker_fire = b1s1_flip_mode ? s1_fire_raw and b1s1_last_fired_dir != -1 : s1_fire_raw

if b1_marker_fire
    b1s1_last_fired_dir := 1
if s1_marker_fire
    b1s1_last_fired_dir := -1

f_ichi_ctx() =>
    _tk = math.avg(ta.lowest(TKlength), ta.highest(TKlength))
    _kj = math.avg(ta.lowest(KJlength), ta.highest(KJlength))
    _sa = math.avg(_tk, _kj)
    _sb = math.avg(ta.lowest(SBlength), ta.highest(SBlength))
    _cs = close

    _price_high_delayed = high[CSHSlength]
    _price_low_delayed = low[CSHSlength]
    _tk_delayed = _tk[CSHSlength]
    _kj_delayed = _kj[CSHSlength]
    _kumo_h_lag = math.max(_sa[CSHSlength * 2], _sb[CSHSlength * 2])
    _kumo_l_lag = math.min(_sa[CSHSlength * 2], _sb[CSHSlength * 2])
    _kumo_h_cur = math.max(_sa[CSHSlength], _sb[CSHSlength])
    _kumo_l_cur = math.min(_sa[CSHSlength], _sb[CSHSlength])

    ssa_at_price = _sa[CSHSlength]
    ssb_at_price = _sb[CSHSlength]
    ssa_lag = _sa[CSHSlength * 2]
    ssb_lag = _sb[CSHSlength * 2]
    ssa_ahead = _sa
    ssb_ahead = _sb

    _atr = ta.atr(14)

    thick_atr_at_price = math.abs(ssa_at_price - ssb_at_price) / _atr
    thick_atr_ahead = math.abs(ssa_ahead - ssb_ahead) / _atr

    ichiContext.new(_tk, _kj, _sa, _sb, _cs, _atr, _price_high_delayed, _price_low_delayed, _tk_delayed, _kj_delayed, _kumo_h_cur, _kumo_l_cur, _kumo_h_lag, _kumo_l_lag, ssa_at_price, ssb_at_price, ssa_lag, ssb_lag, ssa_ahead, ssb_ahead, thick_atr_at_price, thick_atr_ahead)

f_ichi_ctx_from_values(_tk, _kj, _sa, _sb, _cs, _atr, _h, _l) =>
    _price_high_delayed = _h[CSHSlength]
    _price_low_delayed = _l[CSHSlength]
    _tk_delayed = _tk[CSHSlength]
    _kj_delayed = _kj[CSHSlength]
    _kumo_h_lag = math.max(_sa[CSHSlength * 2], _sb[CSHSlength * 2])
    _kumo_l_lag = math.min(_sa[CSHSlength * 2], _sb[CSHSlength * 2])
    _kumo_h_cur = math.max(_sa[CSHSlength], _sb[CSHSlength])
    _kumo_l_cur = math.min(_sa[CSHSlength], _sb[CSHSlength])
    ssa_at_price = _sa[CSHSlength]
    ssb_at_price = _sb[CSHSlength]
    ssa_lag = _sa[CSHSlength * 2]
    ssb_lag = _sb[CSHSlength * 2]
    ssa_ahead = _sa
    ssb_ahead = _sb
    thick_atr_at_price = math.abs(ssa_at_price - ssb_at_price) / _atr
    thick_atr_ahead = math.abs(ssa_ahead - ssb_ahead) / _atr

    ichiContext.new(_tk, _kj, _sa, _sb, _cs, _atr, _price_high_delayed, _price_low_delayed, _tk_delayed, _kj_delayed, _kumo_h_cur, _kumo_l_cur, _kumo_h_lag, _kumo_l_lag, ssa_at_price, ssb_at_price, ssa_lag, ssb_lag, ssa_ahead, ssb_ahead, thick_atr_at_price, thick_atr_ahead)
f_eval_signal_core(int _sig_id, ichiContext _ctx, float _c, float _h, float _l, int _frac_state, int _fvg_state) =>
    _tk = _ctx.tk
    _kj = _ctx.kj
    _sa = _ctx.sa
    _sb = _ctx.sb
    _cs = _ctx.cs
    _price_high_delayed = _ctx.price_high_delayed
    _price_low_delayed = _ctx.price_low_delayed
    _tk_delayed = _ctx.tk_delayed
    _kj_delayed = _ctx.kj_delayed
    _kumo_h_cur = _ctx.kumo_h_cur
    _kumo_l_cur = _ctx.kumo_l_cur
    _kumo_h_lag = _ctx.kumo_h_lag
    _kumo_l_lag = _ctx.kumo_l_lag
    ssa_at_price = _ctx.ssa_at_price
    ssb_at_price = _ctx.ssb_at_price
    ssa_lag = _ctx.ssa_lag
    ssb_lag = _ctx.ssb_lag
    thick_atr_at_price = _ctx.thick_atr_at_price
    thick_atr_ahead = _ctx.thick_atr_ahead

    _b1 = _tk >= _kj and _c > _kumo_h_cur and _cs > _price_high_delayed and _cs > _kumo_h_lag and _sa > _sb
    _s1 = _tk <= _kj and _c < _kumo_l_cur and _cs < _price_low_delayed and _cs < _kumo_l_lag and _sa < _sb

    int _res = 0
    if _sig_id == SIG_PRICE_X_TENKAN
        _res := _c > _tk ? 1 : _c < _tk ? -1 : 0
    else if _sig_id == SIG_PRICE_X_KIJUN
        _res := _c > _kj ? 1 : _c < _kj ? -1 : 0
    else if _sig_id == SIG_PRICE_X_CLOUD
        _res := _c > _kumo_h_cur ? 1 : _c < _kumo_l_cur ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_PRICE
        _res := _cs > _price_high_delayed ? 1 : _cs < _price_low_delayed ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_TENKAN
        _res := _cs > _tk_delayed ? 1 : _cs < _tk_delayed ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_KIJUN
        _res := _cs > _kj_delayed ? 1 : _cs < _kj_delayed ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_CLOUD
        _res := _cs > _kumo_h_lag ? 1 : _cs < _kumo_l_lag ? -1 : 0
    else if _sig_id == SIG_TENKAN_X_KIJUN
        _res := _tk > _kj ? 1 : _tk < _kj ? -1 : 0
    else if _sig_id == SIG_TENKAN_X_CLOUD
        _res := _tk > _kumo_h_cur ? 1 : _tk < _kumo_l_cur ? -1 : 0
    else if _sig_id == SIG_KIJUN_X_CLOUD
        _res := _kj > _kumo_h_cur ? 1 : _kj < _kumo_l_cur ? -1 : 0
    else if _sig_id == SIG_CLOUD_FLIP
        _res := _sa > _sb ? 1 : _sa < _sb ? -1 : 0
    else if _sig_id == SIG_PRICE_FILTERED_FLIP
        _res := _sa > _sb and _l > _kumo_h_cur ? 1 : _sa < _sb and _h < _kumo_l_cur ? -1 : 0
    else if _sig_id == SIG_CLOUD_FILTERED_TKXKJ
        _res := _tk > _kj and _tk > _kumo_h_cur and _kj > _kumo_h_cur ? 1 : _tk < _kj and _tk < _kumo_l_cur and _kj < _kumo_l_cur ? -1 : 0
    else if _sig_id == SIG_B1S1
        _res := _b1 ? 1 : _s1 ? -1 : 0
    else if _sig_id == SIG_PASS_THIN_AT_PRICE
        _res := thick_atr_at_price < 0.5 ? 2 : 0
    else if _sig_id == SIG_PASS_NORMAL_AT_PRICE
        _res := thick_atr_at_price >= 0.5 and thick_atr_at_price <= 1.2 ? 2 : 0
    else if _sig_id == SIG_PASS_THICK_AT_PRICE
        _res := thick_atr_at_price > 1.2 ? 2 : 0
    else if _sig_id == SIG_PASS_THIN_AHEAD
        _res := thick_atr_ahead < 0.5 ? 2 : 0
    else if _sig_id == SIG_PASS_NORMAL_AHEAD
        _res := thick_atr_ahead >= 0.5 and thick_atr_ahead <= 1.2 ? 2 : 0
    else if _sig_id == SIG_PASS_THICK_AHEAD
        _res := thick_atr_ahead > 1.2 ? 2 : 0
    else if _sig_id == SIG_PRICE_X_SA
        _res := _c > ssa_at_price ? 1 : _c < ssa_at_price ? -1 : 0
    else if _sig_id == SIG_TENKAN_X_SA
        _res := _tk > ssa_at_price ? 1 : _tk < ssa_at_price ? -1 : 0
    else if _sig_id == SIG_KIJUN_X_SA
        _res := _kj > ssa_at_price ? 1 : _kj < ssa_at_price ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_SA
        _res := _cs > ssa_lag ? 1 : _cs < ssa_lag ? -1 : 0
    else if _sig_id == SIG_PRICE_X_SB
        _res := _c > ssb_at_price ? 1 : _c < ssb_at_price ? -1 : 0
    else if _sig_id == SIG_TENKAN_X_SB
        _res := _tk > ssb_at_price ? 1 : _tk < ssb_at_price ? -1 : 0
    else if _sig_id == SIG_KIJUN_X_SB
        _res := _kj > ssb_at_price ? 1 : _kj < ssb_at_price ? -1 : 0
    else if _sig_id == SIG_CHIKOU_X_SB
        _res := _cs > ssb_lag ? 1 : _cs < ssb_lag ? -1 : 0
    else if _sig_id == SIG_FRACTAL
        _res := _frac_state
    else if _sig_id == SIG_FVG
        _res := _fvg_state
    _res

f_fvg_flip_logic() =>
    var int _state = 0
    bool _bull = low > high[2]
    bool _bear = high < low[2]

    if _bull
        _state := 1
        _state
    else if _bear
        _state := -1
        _state
    _state

f_fractal_flip_logic(_per) =>
    _up = ta.pivothigh(_per, _per)
    _dn = ta.pivotlow(_per, _per)
    _v_up = ta.valuewhen(not na(_up), _up, 0)
    _v_dn = ta.valuewhen(not na(_dn), _dn, 0)

    var int _state = 0
    if high > _v_up
        _state := 1
        _state
    else if low < _v_dn
        _state := -1
        _state
    _state

f_ichi_bg_logic(_mode) =>
    ctx = f_ichi_ctx()
    int _sig_id = f_signal_mode_to_id(_mode)
    int _frac_state = _sig_id == SIG_FRACTAL ? f_fractal_flip_logic(fr_period) : 0
    int _fvg_state = _sig_id == SIG_FVG ? f_fvg_flip_logic() : 0
    f_eval_signal_core(_sig_id, ctx, close, high, low, _frac_state, _fvg_state)
f_ichi_eval_fast_by_id(int _sig_id, _tk, _kj, _sa, _sb, _cs, _atr, _c, _h, _l, _frac_state, _fvg_state) =>
    _ctx = f_ichi_ctx_from_values(_tk, _kj, _sa, _sb, _cs, _atr, _h, _l)
    f_eval_signal_core(_sig_id, _ctx, _c, _h, _l, _frac_state, _fvg_state)

f_location_name(int _location_id) =>
    switch _location_id
        LOC_VALUE_BULL => 'VALUE_BULL'
        LOC_VALUE_BEAR => 'VALUE_BEAR'
        LOC_KIJUN_SUPPORT => 'KIJUN_SUPPORT'
        LOC_KIJUN_RESIST => 'KIJUN_RESIST'
        LOC_KUMO_EDGE_BULL => 'KUMO_EDGE_BULL'
        LOC_KUMO_EDGE_BEAR => 'KUMO_EDGE_BEAR'
        LOC_IMBALANCE_BULL => 'IMBALANCE_BULL'
        LOC_IMBALANCE_BEAR => 'IMBALANCE_BEAR'
        LOC_FRACTAL_BREAK_BULL => 'FRACTAL_BREAK_BULL'
        LOC_FRACTAL_BREAK_BEAR => 'FRACTAL_BREAK_BEAR'
        LOC_MID_RANGE => 'MID_RANGE'
        LOC_RANGE_EDGE_LOW => 'RANGE_EDGE_LOW'
        LOC_RANGE_EDGE_HIGH => 'RANGE_EDGE_HIGH'
        LOC_BAD => 'BAD'
        => 'NONE'

f_conflict_count(int _s1, int _s2, int _s3, int _s4, int _s5, int _s6) =>
    int _bull = 0
    int _bear = 0
    _bull := (_s1 == 1 ? 1 : 0) + (_s2 == 1 ? 1 : 0) + (_s3 == 1 ? 1 : 0) + (_s4 == 1 ? 1 : 0) + (_s5 == 1 ? 1 : 0) + (_s6 == 1 ? 1 : 0)
    _bear := (_s1 == -1 ? 1 : 0) + (_s2 == -1 ? 1 : 0) + (_s3 == -1 ? 1 : 0) + (_s4 == -1 ? 1 : 0) + (_s5 == -1 ? 1 : 0) + (_s6 == -1 ? 1 : 0)
    math.min(_bull, _bear)

f_bool_to_score(bool _b, float _w) =>
    _b ? _w : 0.0

f_is_price_near(float _a, float _b, float _atr, float _mult) =>
    _atr > 0 and math.abs(_a - _b) <= _atr * _mult

f_clamp01(float _v) =>
    math.max(0.0, math.min(1.0, _v))

f_build_foundation_snapshot(presetConfig _cfg) =>
    _ctx = f_ichi_ctx()
    int _frac_state = f_fractal_flip_logic(fr_period)
    int _fvg_state = f_fvg_flip_logic()
    _atr_safe = math.max(_ctx.atr, syminfo.mintick)

    _sig_price_cloud = f_eval_signal_core(SIG_PRICE_X_CLOUD, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_tk_kj = f_eval_signal_core(SIG_TENKAN_X_KIJUN, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_chikou_price = f_eval_signal_core(SIG_CHIKOU_X_PRICE, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_chikou_cloud = f_eval_signal_core(SIG_CHIKOU_X_CLOUD, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_cloud_flip = f_eval_signal_core(SIG_CLOUD_FLIP, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_b1s1 = f_eval_signal_core(SIG_B1S1, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_fvg = f_eval_signal_core(SIG_FVG, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_fractal = f_eval_signal_core(SIG_FRACTAL, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_pass_at_price = f_eval_signal_core(SIG_PASS_NORMAL_AT_PRICE, _ctx, close, high, low, _frac_state, _fvg_state)
    _sig_pass_ahead = f_eval_signal_core(SIG_PASS_NORMAL_AHEAD, _ctx, close, high, low, _frac_state, _fvg_state)

    _kumo_mid = math.avg(_ctx.kumo_h_cur, _ctx.kumo_l_cur)
    _price_to_kijun_atr = math.abs(close - _ctx.kj) / _atr_safe
    _price_to_kumo_mid_atr = math.abs(close - _kumo_mid) / _atr_safe
    _price_to_kumo_edge_atr = math.min(math.abs(close - _ctx.kumo_h_cur), math.abs(close - _ctx.kumo_l_cur)) / _atr_safe

    _price_above_cloud = close > _ctx.kumo_h_cur
    _price_below_cloud = close < _ctx.kumo_l_cur
    _price_inside_cloud = not _price_above_cloud and not _price_below_cloud
    _recent_high = ta.highest(high, _cfg.sweep_lookback)
    _recent_low = ta.lowest(low, _cfg.sweep_lookback)
    _recent_range_high = ta.highest(high, _cfg.range_lookback)
    _recent_range_low = ta.lowest(low, _cfg.range_lookback)
    // Explicit [1] sources keep setup structure independent of the live bar.
    _prev_recent_high = ta.highest(high[1], _cfg.sweep_lookback)
    _prev_recent_low = ta.lowest(low[1], _cfg.sweep_lookback)
    _prev_range_high = ta.highest(high[1], _cfg.range_lookback)
    _prev_range_low = ta.lowest(low[1], _cfg.range_lookback)
    _close_above_kijun = close > _ctx.kj
    _close_below_kijun = close < _ctx.kj
    _close_above_kumo_high = close > _ctx.kumo_h_cur
    _close_below_kumo_low = close < _ctx.kumo_l_cur
    _kijun_buffer_low = _ctx.kj - _atr_safe * _cfg.buffer_atr
    _kijun_buffer_high = _ctx.kj + _atr_safe * _cfg.buffer_atr

    foundationSnapshot.new(_ctx, _sig_price_cloud, _sig_tk_kj, _sig_chikou_price, _sig_chikou_cloud, _sig_cloud_flip, _sig_b1s1, _sig_fvg, _sig_fractal, _price_to_kijun_atr, _price_to_kumo_mid_atr, _price_to_kumo_edge_atr, _price_above_cloud, _price_below_cloud, _price_inside_cloud, _recent_high, _recent_low, _recent_range_high, _recent_range_low, _prev_recent_high, _prev_recent_low, _prev_range_high, _prev_range_low, _close_above_kijun, _close_below_kijun, _close_above_kumo_high, _close_below_kumo_low)

f_detect_regime(foundationSnapshot _snap) =>
    _bull_points = (_snap.sig_price_cloud == 1 ? 1 : 0) + (_snap.sig_tk_kj == 1 ? 1 : 0) + (_snap.sig_chikou_price == 1 ? 1 : 0) + (_snap.sig_chikou_cloud == 1 ? 1 : 0) + (_snap.sig_cloud_flip == 1 ? 1 : 0) + (_snap.sig_b1s1 == 1 ? 1 : 0)
    _bear_points = (_snap.sig_price_cloud == -1 ? 1 : 0) + (_snap.sig_tk_kj == -1 ? 1 : 0) + (_snap.sig_chikou_price == -1 ? 1 : 0) + (_snap.sig_chikou_cloud == -1 ? 1 : 0) + (_snap.sig_cloud_flip == -1 ? 1 : 0) + (_snap.sig_b1s1 == -1 ? 1 : 0)
    _conflict_count = f_conflict_count(_snap.sig_price_cloud, _snap.sig_tk_kj, _snap.sig_chikou_price, _snap.sig_chikou_cloud, _snap.sig_cloud_flip, _snap.sig_b1s1)
    _dominance = _bull_points - _bear_points

    _cloud_thin = _snap.ctx.thick_atr_at_price < 0.5 or _snap.ctx.thick_atr_ahead < 0.5
    _price_in_cloud = _snap.price_inside_cloud
    _chikou_clear = _snap.sig_chikou_price != 0 and _snap.sig_chikou_cloud != 0 and _snap.sig_chikou_price == _snap.sig_chikou_cloud
    _htf_aligned = _snap.sig_b1s1 != 0 and _snap.sig_b1s1 == _snap.sig_cloud_flip
    _cloud_supportive = _dominance > 0 and _snap.sig_cloud_flip == 1 or _dominance < 0 and _snap.sig_cloud_flip == -1

    _near_kijun = _snap.price_to_kijun_atr <= 0.6
    _near_kumo_edge = _snap.price_to_kumo_edge_atr <= 0.5

    int _regime_id = REGIME_NONE
    if _bull_points >= 4 and _dominance >= 2 and not _price_in_cloud and _conflict_count <= 1
        _regime_id := REGIME_TREND_BULL
    else if _bear_points >= 4 and _dominance <= -2 and not _price_in_cloud and _conflict_count <= 1
        _regime_id := REGIME_TREND_BEAR
    else if _snap.sig_tk_kj == 1 and (_snap.sig_chikou_price == 1 or _snap.sig_chikou_cloud == 1 or _snap.sig_cloud_flip == 1) and (_near_kijun or _near_kumo_edge) and not _snap.price_below_cloud
        _regime_id := REGIME_PULLBACK_BULL
    else if _snap.sig_tk_kj == -1 and (_snap.sig_chikou_price == -1 or _snap.sig_chikou_cloud == -1 or _snap.sig_cloud_flip == -1) and (_near_kijun or _near_kumo_edge) and not _snap.price_above_cloud
        _regime_id := REGIME_PULLBACK_BEAR
    else if _price_in_cloud and math.abs(_dominance) <= 1
        _regime_id := REGIME_RANGE
    else if _conflict_count >= 3 or (_price_in_cloud and _cloud_thin and math.abs(_dominance) <= 1)
        _regime_id := REGIME_LOW_QUALITY
    else if (_snap.sig_cloud_flip != 0 and _snap.sig_cloud_flip != _snap.sig_price_cloud) or (_snap.sig_tk_kj != 0 and _snap.sig_tk_kj != _snap.sig_price_cloud)
        _regime_id := REGIME_TRANSITION

    _direction = _regime_id == REGIME_TREND_BULL or _regime_id == REGIME_PULLBACK_BULL ? 1 : _regime_id == REGIME_TREND_BEAR or _regime_id == REGIME_PULLBACK_BEAR ? -1 : 0
    _confidence_raw = (math.abs(_dominance) / 6.0) - (_conflict_count * 0.12) + f_bool_to_score(_chikou_clear, 0.15) + f_bool_to_score(_cloud_supportive, 0.1) - f_bool_to_score(_cloud_thin, 0.1)
    _confidence = 100.0 * f_clamp01(_confidence_raw)

    regimeState.new(_regime_id, _direction, _direction == 1, _direction == -1, _regime_id == REGIME_TREND_BULL or _regime_id == REGIME_TREND_BEAR, _regime_id == REGIME_PULLBACK_BULL or _regime_id == REGIME_PULLBACK_BEAR, _regime_id == REGIME_RANGE, _regime_id == REGIME_TRANSITION, _regime_id == REGIME_LOW_QUALITY, _confidence, _conflict_count, _chikou_clear, _cloud_supportive, _cloud_thin, _price_in_cloud)

f_detect_location(foundationSnapshot _snap, regimeState _reg, presetConfig _cfg) =>
    _atr_safe = math.max(_snap.ctx.atr, syminfo.mintick)
    _near_kijun = f_is_price_near(close, _snap.ctx.kj, _atr_safe, 0.6)
    _near_kumo_edge = _snap.price_to_kumo_edge_atr <= 0.5
    // Retain one lightweight active zone per direction. Direction is context;
    // location is true only while price is spatially inside an unmitigated gap.
    var float _bull_fvg_top = na
    var float _bull_fvg_bottom = na
    var float _bear_fvg_top = na
    var float _bear_fvg_bottom = na
    if low > high[2]
        _bull_fvg_top := low
        _bull_fvg_bottom := high[2]
    if high < low[2]
        _bear_fvg_top := low[2]
        _bear_fvg_bottom := high
    _in_bull_fvg = not na(_bull_fvg_top) and high >= _bull_fvg_bottom and low <= _bull_fvg_top
    _in_bear_fvg = not na(_bear_fvg_top) and high >= _bear_fvg_bottom and low <= _bear_fvg_top
    if not na(_bull_fvg_bottom) and close < _bull_fvg_bottom
        _bull_fvg_top := na
        _bull_fvg_bottom := na
    if not na(_bear_fvg_top) and close > _bear_fvg_top
        _bear_fvg_top := na
        _bear_fvg_bottom := na
    _in_fvg_zone = _in_bull_fvg or _in_bear_fvg
    // Raw price series are used here so bar zero safely yields na; dereferencing
    // a historical UDT object on bar zero raises TradingView runtime error RE10041.
    _fractal_level = _snap.sig_fractal == 1 ? ta.highest(high[1], _cfg.sweep_lookback) : _snap.sig_fractal == -1 ? ta.lowest(low[1], _cfg.sweep_lookback) : na
    _near_fractal_break = not na(_fractal_level) and math.abs(close - _fractal_level) / _atr_safe <= 0.5
    _mid_range = _snap.price_inside_cloud or _snap.price_to_kumo_mid_atr <= 0.35
    _near_range_low = math.abs(close - _snap.recent_range_low) <= _atr_safe * 0.75
    _near_range_high = math.abs(close - _snap.recent_range_high) <= _atr_safe * 0.75
    _range_center = _mid_range and not _near_range_low and not _near_range_high
    _bad_location = _reg.is_low_quality and _range_center

    int _location_id = LOC_NONE
    if _reg.is_range and _near_range_low
        _location_id := LOC_RANGE_EDGE_LOW
    else if _reg.is_range and _near_range_high
        _location_id := LOC_RANGE_EDGE_HIGH
    else if _bad_location
        _location_id := LOC_BAD
    else if _range_center
        _location_id := LOC_MID_RANGE
    else if _reg.direction == 1 and _near_kijun
        _location_id := LOC_KIJUN_SUPPORT
    else if _reg.direction == -1 and _near_kijun
        _location_id := LOC_KIJUN_RESIST
    else if _reg.direction == 1 and _near_kumo_edge
        _location_id := LOC_KUMO_EDGE_BULL
    else if _reg.direction == -1 and _near_kumo_edge
        _location_id := LOC_KUMO_EDGE_BEAR
    else if _in_fvg_zone and _snap.sig_fvg == 1
        _location_id := LOC_IMBALANCE_BULL
    else if _in_fvg_zone and _snap.sig_fvg == -1
        _location_id := LOC_IMBALANCE_BEAR
    else if _near_fractal_break and _snap.sig_fractal == 1
        _location_id := LOC_FRACTAL_BREAK_BULL
    else if _near_fractal_break and _snap.sig_fractal == -1
        _location_id := LOC_FRACTAL_BREAK_BEAR
    else if _reg.is_trend and _snap.sig_price_cloud == 1 and _snap.price_to_kijun_atr <= 1.0
        _location_id := LOC_VALUE_BULL
    else if _reg.is_trend and _snap.sig_price_cloud == -1 and _snap.price_to_kijun_atr <= 1.0
        _location_id := LOC_VALUE_BEAR

    _dir = _location_id > 0 and _location_id != LOC_MID_RANGE and _location_id != LOC_BAD ? 1 : _location_id < 0 ? -1 : 0
    _score_raw = 0.0
    // Location describes where price is; regime direction is deliberately not
    // rewarded here because it belongs to the bounded regime category.
    _score_raw := _score_raw + f_bool_to_score(_near_kijun, 0.35) + f_bool_to_score(_near_kumo_edge, 0.25) + f_bool_to_score(_in_fvg_zone, 0.2) + f_bool_to_score(_near_fractal_break, 0.2)
    _score_raw := _score_raw - f_bool_to_score(_range_center, 0.45) - f_bool_to_score(_bad_location, 0.55)
    _location_score = 100.0 * f_clamp01(_score_raw)
    _location_text = f_location_name(_location_id)

    locationState.new(_location_id, _dir, _near_kijun, _near_kumo_edge, _in_fvg_zone, _near_fractal_break, _range_center, _bad_location, _location_score, _location_text)

f_playbook_name(int _pb_id) =>
    switch _pb_id
        PB_PULLBACK_CONT => 'Pullback Continuation'
        PB_BREAKOUT_ACCEPT => 'Breakout Accept'
        PB_SWEEP_RECLAIM => 'Sweep Reclaim'
        PB_RANGE_REVERT => 'Range Revert'
        => 'None'

f_playbook_state_name(int _state_id) =>
    switch _state_id
        PBS_CONTEXT_VALID => 'CONTEXT_VALID'
        PBS_LOCATION_VALID => 'LOCATION_VALID'
        PBS_TRIGGER_PENDING => 'TRIGGER_PENDING'
        PBS_TRIGGERED => 'TRIGGERED'
        PBS_INVALIDATED => 'INVALIDATED'
        PBS_DONE => 'DONE'
        => 'INACTIVE'

f_no_trade_reason_name(int _reason_id) =>
    switch _reason_id
        NT_LOW_QUALITY => 'LOW_QUALITY'
        NT_BAD_LOCATION => 'BAD_LOCATION'
        NT_MID_RANGE => REASON_RANGE_CENTER
        NT_AGAINST_REGIME => 'AGAINST_REGIME'
        NT_NO_ACCEPTANCE => 'NO_ACCEPTANCE'
        NT_NO_RECLAIM => 'NO_RECLAIM'
        NT_WEAK_CONTEXT => REASON_NO_CONTEXT
        NT_CONFLICT => 'CONFLICT'
        => 'NONE'

f_action_name(int _action_id) =>
    switch _action_id
        ACT_WATCH => 'WATCH'
        ACT_ARMED => 'ARMED'
        ACT_VALID => 'TRIGGERED'
        ACT_INVALIDATED => 'INVALIDATED'
        => 'NO_TRADE'

f_trigger_reclaim_long(foundationSnapshot _snap) =>
    not _snap.price_inside_cloud and (_snap.close_above_kijun or _snap.close_above_kumo_high or _snap.sig_price_cloud == 1)

f_trigger_reclaim_short(foundationSnapshot _snap) =>
    not _snap.price_inside_cloud and (_snap.close_below_kijun or _snap.close_below_kumo_low or _snap.sig_price_cloud == -1)

f_detect_sweep_long(foundationSnapshot _snap, presetConfig _cfg) =>
    _prev_recent_low = _snap.prev_recent_low
    _prev_recent_range_low = _snap.prev_range_low
    _swept = low < _prev_recent_low or low < _prev_recent_range_low
    _reclaim = close > _prev_recent_range_low or math.abs(close - _prev_recent_range_low) <= _snap.ctx.atr * _cfg.reclaim_near_atr or f_trigger_reclaim_long(_snap)
    _swept and _reclaim

f_detect_sweep_short(foundationSnapshot _snap, presetConfig _cfg) =>
    _prev_recent_high = _snap.prev_recent_high
    _prev_recent_range_high = _snap.prev_range_high
    _swept = high > _prev_recent_high or high > _prev_recent_range_high
    _reclaim = close < _prev_recent_range_high or math.abs(close - _prev_recent_range_high) <= _snap.ctx.atr * _cfg.reclaim_near_atr or f_trigger_reclaim_short(_snap)
    _swept and _reclaim

f_detect_no_trade(foundationSnapshot _snap, regimeState _reg, locationState _loc, presetConfig _cfg) =>
    _low_quality = _reg.is_low_quality
    // Only invariant, market-wide failures belong here. Location/timing is
    // evaluated by each playbook, so range and sweep setups remain reachable.
    _bad_location = false
    _mid_range = _loc.mid_range and not (math.abs(close - _snap.recent_range_high) <= _snap.ctx.atr * _cfg.edge_near_atr or math.abs(close - _snap.recent_range_low) <= _snap.ctx.atr * _cfg.edge_near_atr)
    _against_regime = (_reg.direction == 1 and _loc.direction == -1) or (_reg.direction == -1 and _loc.direction == 1)
    _conflict = _reg.conflict_count >= 3
    _weak_context = _reg.regime_id == REGIME_NONE or (_reg.is_transition and _loc.location_id == LOC_NONE)

    _reason_id = NT_NONE
    if _low_quality
        _reason_id := NT_LOW_QUALITY
    else if _conflict
        _reason_id := NT_CONFLICT
    else if _against_regime
        _reason_id := NT_AGAINST_REGIME
    else if _weak_context
        _reason_id := NT_WEAK_CONTEXT

    noTradeState.new(_reason_id != NT_NONE, _reason_id, f_no_trade_reason_name(_reason_id), _low_quality, _bad_location, _mid_range, _against_regime, _conflict, _weak_context)

f_structural_buffer(foundationSnapshot _snap, presetConfig _cfg) =>
    math.max(syminfo.mintick, _snap.ctx.atr * _cfg.buffer_atr)

f_stop_is_valid(float _stop, float _entry, int _dir) =>
    not na(_stop) and not na(_entry) and (_dir == 1 ? _stop < _entry - syminfo.mintick : _dir == -1 ? _stop > _entry + syminfo.mintick : false)

f_target_is_valid(float _target, float _entry, int _dir) =>
    not na(_target) and not na(_entry) and (_dir == 1 ? _target > _entry + syminfo.mintick : _dir == -1 ? _target < _entry - syminfo.mintick : false)

f_project_target(float _entry, float _stop, int _dir, float _multiple) =>
    _risk = f_stop_is_valid(_stop, _entry, _dir) ? math.abs(_entry - _stop) : na
    not na(_risk) and _risk > syminfo.mintick ? (_dir == 1 ? _entry + _multiple * _risk : _entry - _multiple * _risk) : na

f_playbook_freeze_ready(playbookState _pb) =>
    _qualified_state = _pb.state_id == PBS_LOCATION_VALID or _pb.state_id == PBS_TRIGGER_PENDING or _pb.state_id == PBS_TRIGGERED
    _base_ready = _pb.direction != 0 and _pb.location_ok and not _pb.invalidated and _qualified_state and not na(_pb.invalidation_reference) and not na(_pb.entry_reference) and not na(_pb.target1_reference) and not na(_pb.target2_reference)
    _refs_ready = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? not na(_pb.breakout_level_ref) : _pb.playbook_id == PB_RANGE_REVERT ? not na(_pb.range_high_ref) and not na(_pb.range_low_ref) : not na(_pb.structure_reference)
    _range_ready = _pb.playbook_id != PB_RANGE_REVERT or _pb.range_high_ref > _pb.range_low_ref
    _prices_ready = f_stop_is_valid(_pb.invalidation_reference, _pb.entry_reference, _pb.direction) and f_target_is_valid(_pb.target1_reference, _pb.entry_reference, _pb.direction) and f_target_is_valid(_pb.target2_reference, _pb.entry_reference, _pb.direction)
    _base_ready and _refs_ready and _range_ready and _prices_ready

f_pb_pullback_eval(foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, presetConfig _cfg, int _frozen_dir, float _frozen_structure, float _frozen_inv, float _frozen_entry, float _frozen_t1, float _frozen_t2) =>
    _has_frozen = _frozen_dir != 0 and not na(_frozen_inv)
    _dir = _has_frozen ? _frozen_dir : _reg.direction
    _context_raw = not _nt.active and (_reg.regime_id == REGIME_PULLBACK_BULL or _reg.regime_id == REGIME_PULLBACK_BEAR or (_reg.is_trend and (_loc.location_id == LOC_VALUE_BULL or _loc.location_id == LOC_VALUE_BEAR)))
    _context_ok = _has_frozen or _context_raw
    _location_ok_long = _loc.location_id == LOC_KIJUN_SUPPORT or _loc.location_id == LOC_KUMO_EDGE_BULL or _loc.location_id == LOC_IMBALANCE_BULL or _loc.location_id == LOC_VALUE_BULL
    _location_ok_short = _loc.location_id == LOC_KIJUN_RESIST or _loc.location_id == LOC_KUMO_EDGE_BEAR or _loc.location_id == LOC_IMBALANCE_BEAR or _loc.location_id == LOC_VALUE_BEAR
    _location_ok = _has_frozen or (_dir == 1 ? _location_ok_long : _dir == -1 ? _location_ok_short : false)
    _trigger_ok = _dir == 1 ? (f_trigger_reclaim_long(_snap) or _snap.sig_fractal == 1 or _snap.sig_price_cloud == 1) : _dir == -1 ? (f_trigger_reclaim_short(_snap) or _snap.sig_fractal == -1 or _snap.sig_price_cloud == -1) : false
    _trigger_persistent = _trigger_ok and _trigger_ok[1]
    _buffer = f_structural_buffer(_snap, _cfg)
    _candidate_structure = _dir == 1 ? _snap.prev_recent_low : _snap.prev_recent_high
    _swing_ref = _has_frozen ? _frozen_structure : _candidate_structure
    _cloud_ref = _dir == 1 ? _snap.ctx.kumo_l_cur : _snap.ctx.kumo_h_cur
    _candidate_inv = _dir == 1 ? math.min(_swing_ref, _cloud_ref) - _buffer : _dir == -1 ? math.max(_swing_ref, _cloud_ref) + _buffer : na
    _inv_ref = _has_frozen ? _frozen_inv : _candidate_inv
    _candidate_entry = _dir == 1 ? math.max(_snap.ctx.kj, _snap.ctx.kumo_l_cur) : _dir == -1 ? math.min(_snap.ctx.kj, _snap.ctx.kumo_h_cur) : na
    _entry_ref = _has_frozen ? _frozen_entry : _candidate_entry
    _candidate_t1 = _dir == 1 ? _snap.prev_recent_high : _dir == -1 ? _snap.prev_recent_low : na
    _candidate_t2 = _dir == 1 ? _snap.prev_range_high : _dir == -1 ? _snap.prev_range_low : na
    _target1_ref = _has_frozen ? _frozen_t1 : na(_candidate_t1) ? na : f_target_is_valid(_candidate_t1, _entry_ref, _dir) ? _candidate_t1 : f_project_target(_entry_ref, _inv_ref, _dir, 1.0)
    _target2_ref = _has_frozen ? _frozen_t2 : na(_candidate_t2) ? na : f_target_is_valid(_candidate_t2, _entry_ref, _dir) ? _candidate_t2 : f_project_target(_entry_ref, _inv_ref, _dir, 2.0)
    _invalidated = _has_frozen and (_dir == 1 ? close < _inv_ref : close > _inv_ref)
    _state_id = _invalidated ? PBS_INVALIDATED : not _context_ok ? PBS_INACTIVE : _context_ok and not _location_ok ? PBS_CONTEXT_VALID : _context_ok and _location_ok and not _trigger_ok ? PBS_LOCATION_VALID : _context_ok and _location_ok and _trigger_ok and not _trigger_persistent ? PBS_TRIGGER_PENDING : _context_ok and _location_ok and _trigger_ok and _trigger_persistent ? PBS_TRIGGERED : PBS_LOCATION_VALID
    _priority = (_reg.is_pullback ? 0.92 : _reg.is_trend ? 0.72 : 0.15)
    playbookState.new(PB_PULLBACK_CONT, _state_id, _dir, _context_ok, _location_ok, _trigger_ok, _invalidated, _priority, f_playbook_name(PB_PULLBACK_CONT), f_playbook_state_name(_state_id), _trigger_ok ? 'RECLAIM/CONT' : 'WAIT_RECLAIM', _context_ok ? 'OK' : 'NO_CONTEXT', _swing_ref, _inv_ref, na, na, na, _entry_ref, _target1_ref, _target2_ref)

f_pb_breakout_eval(foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, presetConfig _cfg, int _frozen_dir, float _frozen_inv, float _frozen_break, float _frozen_t1, float _frozen_t2) =>
    _prev_high = _snap.prev_recent_high
    _prev_low = _snap.prev_recent_low
    _break_long = not na(_prev_high) and high > _prev_high and close > _prev_high
    _break_short = not na(_prev_low) and low < _prev_low and close < _prev_low
    _candidate_long = ta.barssince(_break_long) >= 0 and ta.barssince(_break_long) <= 3
    _candidate_short = ta.barssince(_break_short) >= 0 and ta.barssince(_break_short) <= 3
    _long_break_level = ta.valuewhen(_break_long, _prev_high, 0)
    _short_break_level = ta.valuewhen(_break_short, _prev_low, 0)
    _has_frozen = _frozen_dir != 0 and not na(_frozen_inv) and not na(_frozen_break)
    _candidate_dir = _candidate_long and not _candidate_short ? 1 : _candidate_short and not _candidate_long ? -1 : 0
    _dir = _has_frozen ? _frozen_dir : _candidate_dir
    _break_level = _has_frozen ? _frozen_break : _dir == 1 ? _long_break_level : _short_break_level
    _context_raw = not _nt.active and (_reg.regime_id == REGIME_TREND_BULL or _reg.regime_id == REGIME_TREND_BEAR or _reg.regime_id == REGIME_TRANSITION)
    _context_ok = _has_frozen or _context_raw
    _location_ok = _has_frozen or (_dir != 0 and (_loc.near_kumo_edge or _loc.near_fractal_break or (_dir == 1 ? _snap.price_above_cloud : _snap.price_below_cloud)))
    _accept_long = (_has_frozen or _candidate_long) and close >= _break_level and low >= _break_level - _snap.ctx.atr * _cfg.buffer_atr
    _accept_short = (_has_frozen or _candidate_short) and close <= _break_level and high <= _break_level + _snap.ctx.atr * _cfg.buffer_atr
    _trigger_ok = _dir == 1 ? _accept_long : _dir == -1 ? _accept_short : false
    _trigger_persistent = _trigger_ok and _trigger_ok[1]
    _candidate_inv = _dir == 1 ? _break_level - f_structural_buffer(_snap, _cfg) : _dir == -1 ? _break_level + f_structural_buffer(_snap, _cfg) : na
    _inv_ref = _has_frozen ? _frozen_inv : _candidate_inv
    _risk = f_stop_is_valid(_inv_ref, _break_level, _dir) ? math.abs(_break_level - _inv_ref) : na
    _target1_ref = _has_frozen ? _frozen_t1 : _dir == 1 ? _break_level + _risk : _dir == -1 ? _break_level - _risk : na
    _target2_ref = _has_frozen ? _frozen_t2 : _dir == 1 ? _break_level + 2.0 * _risk : _dir == -1 ? _break_level - 2.0 * _risk : na
    _invalidated = _has_frozen and (_dir == 1 ? close < _inv_ref : close > _inv_ref)
    _state_id = _invalidated ? PBS_INVALIDATED : not _context_ok ? PBS_INACTIVE : _context_ok and not _location_ok ? PBS_CONTEXT_VALID : _context_ok and _location_ok and not _trigger_ok ? PBS_LOCATION_VALID : _context_ok and _location_ok and _trigger_ok and not _trigger_persistent ? PBS_TRIGGER_PENDING : _context_ok and _location_ok and _trigger_ok and _trigger_persistent ? PBS_TRIGGERED : PBS_LOCATION_VALID
    _priority = (_reg.regime_id == REGIME_TRANSITION ? 0.9 : _reg.is_trend ? 0.8 : 0.2)
    playbookState.new(PB_BREAKOUT_ACCEPT, _state_id, _dir, _context_ok, _location_ok, _trigger_ok, _invalidated, _priority, f_playbook_name(PB_BREAKOUT_ACCEPT), f_playbook_state_name(_state_id), _trigger_ok ? 'BREAK+ACCEPT' : 'WAIT_ACCEPT', _context_ok ? 'OK' : 'NO_CONTEXT', _break_level, _inv_ref, na, na, _break_level, _break_level, _target1_ref, _target2_ref)

f_pb_sweep_eval(foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, presetConfig _cfg, int _frozen_dir, float _frozen_structure, float _frozen_inv, float _frozen_t1, float _frozen_t2) =>
    _long_sweep = f_detect_sweep_long(_snap, _cfg)
    _short_sweep = f_detect_sweep_short(_snap, _cfg)
    _has_frozen = _frozen_dir != 0 and not na(_frozen_inv)
    _dir = _has_frozen ? _frozen_dir : _long_sweep ? 1 : _short_sweep ? -1 : 0
    _context_raw = not _nt.low_quality and not _nt.conflict and (_reg.is_transition or _reg.is_pullback or _reg.is_range)
    _context_ok = _has_frozen or _context_raw
    _location_ok = _has_frozen or _loc.near_kumo_edge or _loc.in_fvg_zone or _loc.location_id == LOC_MID_RANGE or math.abs(close - _snap.recent_range_low) <= _snap.ctx.atr * _cfg.edge_near_atr or math.abs(close - _snap.recent_range_high) <= _snap.ctx.atr * _cfg.edge_near_atr
    _trigger_ok = _dir == 1 ? _long_sweep : _dir == -1 ? _short_sweep : false
    _trigger_persistent = _trigger_ok and _trigger_ok[1]
    // The swept, pre-bar structure is stable; the sweep bar cannot move it.
    _long_structure_ref = low < _snap.prev_recent_low and low < _snap.prev_range_low ? math.min(_snap.prev_recent_low, _snap.prev_range_low) : low < _snap.prev_recent_low ? _snap.prev_recent_low : _snap.prev_range_low
    _short_structure_ref = high > _snap.prev_recent_high and high > _snap.prev_range_high ? math.max(_snap.prev_recent_high, _snap.prev_range_high) : high > _snap.prev_recent_high ? _snap.prev_recent_high : _snap.prev_range_high
    _candidate_structure = _dir == 1 ? _long_structure_ref : _dir == -1 ? _short_structure_ref : na
    _structure_ref = _has_frozen ? _frozen_structure : _candidate_structure
    _candidate_inv = _dir == 1 ? _structure_ref - f_structural_buffer(_snap, _cfg) : _dir == -1 ? _structure_ref + f_structural_buffer(_snap, _cfg) : na
    _inv_ref = _has_frozen ? _frozen_inv : _candidate_inv
    _candidate_t1 = _dir == 1 ? _snap.prev_recent_high : _dir == -1 ? _snap.prev_recent_low : na
    _candidate_t2 = _dir == 1 ? _snap.prev_range_high : _dir == -1 ? _snap.prev_range_low : na
    _target1_ref = _has_frozen ? _frozen_t1 : na(_candidate_t1) ? na : f_target_is_valid(_candidate_t1, _structure_ref, _dir) ? _candidate_t1 : f_project_target(_structure_ref, _inv_ref, _dir, 1.0)
    _target2_ref = _has_frozen ? _frozen_t2 : na(_candidate_t2) ? na : f_target_is_valid(_candidate_t2, _structure_ref, _dir) ? _candidate_t2 : f_project_target(_structure_ref, _inv_ref, _dir, 2.0)
    _invalidated = _has_frozen and (_dir == 1 ? close < _inv_ref : close > _inv_ref)
    _state_id = _invalidated ? PBS_INVALIDATED : not _context_ok ? PBS_INACTIVE : _context_ok and not _location_ok ? PBS_CONTEXT_VALID : _context_ok and _location_ok and not _trigger_ok ? PBS_LOCATION_VALID : _context_ok and _location_ok and _trigger_ok and not _trigger_persistent ? PBS_TRIGGER_PENDING : _context_ok and _location_ok and _trigger_ok and _trigger_persistent ? PBS_TRIGGERED : PBS_LOCATION_VALID
    _priority = (_trigger_ok and _reg.is_transition ? 0.88 : _trigger_ok ? 0.78 : 0.35)
    playbookState.new(PB_SWEEP_RECLAIM, _state_id, _dir, _context_ok, _location_ok, _trigger_ok, _invalidated, _priority, f_playbook_name(PB_SWEEP_RECLAIM), f_playbook_state_name(_state_id), _trigger_ok ? 'SWEEP+RECLAIM' : 'WAIT_SWEEP', _context_ok ? 'OK' : 'NO_CONTEXT', _structure_ref, _inv_ref, _snap.prev_range_high, _snap.prev_range_low, na, _structure_ref, _target1_ref, _target2_ref)

f_pb_range_eval(foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, presetConfig _cfg, int _frozen_dir, float _frozen_inv, float _frozen_range_high, float _frozen_range_low, float _frozen_t1, float _frozen_t2) =>
    _near_low = math.abs(close - _snap.recent_range_low) <= _snap.ctx.atr * _cfg.edge_near_atr
    _near_high = math.abs(close - _snap.recent_range_high) <= _snap.ctx.atr * _cfg.edge_near_atr
    _has_frozen = _frozen_dir != 0 and not na(_frozen_inv)
    _dir = _has_frozen ? _frozen_dir : _near_low ? 1 : _near_high ? -1 : 0
    _range_high_ref = _has_frozen ? _frozen_range_high : _snap.prev_range_high
    _range_low_ref = _has_frozen ? _frozen_range_low : _snap.prev_range_low
    _context_raw = not _nt.low_quality and _reg.regime_id == REGIME_RANGE
    _context_ok = _has_frozen or _context_raw
    _location_ok = _has_frozen or _near_low or _near_high
    _trigger_ok = _dir == 1 ? (f_trigger_reclaim_long(_snap) or _snap.sig_fractal == 1) : _dir == -1 ? (f_trigger_reclaim_short(_snap) or _snap.sig_fractal == -1) : false
    _trigger_persistent = _trigger_ok and _trigger_ok[1]
    _structure_ref = _dir == 1 ? _range_low_ref : _range_high_ref
    _candidate_inv = _dir == 1 ? _structure_ref - f_structural_buffer(_snap, _cfg) : _dir == -1 ? _structure_ref + f_structural_buffer(_snap, _cfg) : na
    _inv_ref = _has_frozen ? _frozen_inv : _candidate_inv
    _target1_ref = _has_frozen ? _frozen_t1 : math.avg(_range_high_ref, _range_low_ref)
    _target2_ref = _has_frozen ? _frozen_t2 : _dir == 1 ? _range_high_ref : _dir == -1 ? _range_low_ref : na
    _invalidated = _has_frozen and (_dir == 1 ? close < _inv_ref : close > _inv_ref)
    _state_id = _invalidated ? PBS_INVALIDATED : not _context_ok ? PBS_INACTIVE : _context_ok and not _location_ok ? PBS_CONTEXT_VALID : _context_ok and _location_ok and not _trigger_ok ? PBS_LOCATION_VALID : _context_ok and _location_ok and _trigger_ok and not _trigger_persistent ? PBS_TRIGGER_PENDING : _context_ok and _location_ok and _trigger_ok and _trigger_persistent ? PBS_TRIGGERED : PBS_LOCATION_VALID
    _priority = (_context_ok and _location_ok ? 0.9 : 0.0)
    playbookState.new(PB_RANGE_REVERT, _state_id, _dir, _context_ok, _location_ok, _trigger_ok, _invalidated, _priority, f_playbook_name(PB_RANGE_REVERT), f_playbook_state_name(_state_id), _trigger_ok ? 'EDGE_RECLAIM' : 'WAIT_EDGE', _context_ok ? 'OK' : 'NO_CONTEXT', _structure_ref, _inv_ref, _range_high_ref, _range_low_ref, na, _structure_ref, _target1_ref, _target2_ref)

f_select_playbook(playbookState _pb1, playbookState _pb2, playbookState _pb3, playbookState _pb4, noTradeState _nt) =>
    if _nt.active
        playbookState.new(PB_NONE, PBS_INACTIVE, 0, false, false, false, false, 0.0, f_playbook_name(PB_NONE), f_playbook_state_name(PBS_INACTIVE), 'NO_TRADE', _nt.reason_text, na, na, na, na, na, na, na, na)
    else
        // Terminal states are never selectable. Rank is semantic, not state ID.
        _rank1 = _pb1.state_id == PBS_TRIGGERED ? 4 : _pb1.state_id == PBS_TRIGGER_PENDING ? 3 : _pb1.state_id == PBS_LOCATION_VALID ? 2 : _pb1.state_id == PBS_CONTEXT_VALID ? 1 : 0
        _best = _rank1 > 0 ? _pb1 : playbookState.new(PB_NONE, PBS_INACTIVE, 0, false, false, false, false, 0.0, f_playbook_name(PB_NONE), f_playbook_state_name(PBS_INACTIVE), 'NO_CANDIDATE', 'NO_CONTEXT', na, na, na, na, na, na, na, na)
        _best_rank = _rank1
        _rank2 = _pb2.state_id == PBS_TRIGGERED ? 4 : _pb2.state_id == PBS_TRIGGER_PENDING ? 3 : _pb2.state_id == PBS_LOCATION_VALID ? 2 : _pb2.state_id == PBS_CONTEXT_VALID ? 1 : 0
        if _rank2 > _best_rank or (_rank2 == _best_rank and _rank2 > 0 and _pb2.priority > _best.priority)
            _best := _pb2
            _best_rank := _rank2
        _rank3 = _pb3.state_id == PBS_TRIGGERED ? 4 : _pb3.state_id == PBS_TRIGGER_PENDING ? 3 : _pb3.state_id == PBS_LOCATION_VALID ? 2 : _pb3.state_id == PBS_CONTEXT_VALID ? 1 : 0
        if _rank3 > _best_rank or (_rank3 == _best_rank and _rank3 > 0 and _pb3.priority > _best.priority)
            _best := _pb3
            _best_rank := _rank3
        _rank4 = _pb4.state_id == PBS_TRIGGERED ? 4 : _pb4.state_id == PBS_TRIGGER_PENDING ? 3 : _pb4.state_id == PBS_LOCATION_VALID ? 2 : _pb4.state_id == PBS_CONTEXT_VALID ? 1 : 0
        if _rank4 > _best_rank or (_rank4 == _best_rank and _rank4 > 0 and _pb4.priority > _best.priority)
            _best := _pb4
        _best

f_compute_structural_invalidation(playbookState _pb, foundationSnapshot _snap, regimeState _reg, locationState _loc, presetConfig _cfg) =>
    _dir = _pb.direction
    // Playbook invalidation and trade-plan stop share the exact frozen structure.
    float _inv_price = _pb.invalidation_reference
    int _src_id = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? INV_SRC_BREAKOUT_LEVEL : _pb.playbook_id == PB_RANGE_REVERT ? INV_SRC_RANGE_LEVEL : _pb.playbook_id == PB_SWEEP_RECLAIM ? INV_SRC_FRACTAL : _pb.playbook_id == PB_PULLBACK_CONT ? INV_SRC_FRACTAL : INV_SRC_NONE
    string _reason = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? 'ACCEPT_LEVEL' : _pb.playbook_id == PB_RANGE_REVERT ? 'RANGE_EDGE' : _pb.playbook_id == PB_SWEEP_RECLAIM ? (_dir == 1 ? 'SWEEP_LOW' : 'SWEEP_HIGH') : _pb.playbook_id == PB_PULLBACK_CONT ? (_dir == 1 ? 'SWING_LOW' : 'SWING_HIGH') : 'NONE'
    if na(_inv_price)
        _buffer = f_structural_buffer(_snap, _cfg)
        _inv_price := _dir == 1 ? close - _buffer : _dir == -1 ? close + _buffer : na
        _src_id := INV_SRC_FALLBACK
        _reason := 'BUFFER_FALLBACK'
    [_inv_price, _src_id, _reason]

f_build_trade_plan(playbookState _pb, foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, presetConfig _cfg) =>
    _action_id = _nt.active ? ACT_SKIP : _pb.state_id == PBS_INVALIDATED ? ACT_INVALIDATED : _pb.state_id == PBS_TRIGGERED ? ACT_VALID : _pb.state_id == PBS_TRIGGER_PENDING ? ACT_ARMED : _pb.state_id == PBS_LOCATION_VALID or _pb.state_id == PBS_CONTEXT_VALID ? ACT_WATCH : ACT_SKIP
    _legacy_entry = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? _pb.breakout_level_ref : _pb.playbook_id == PB_SWEEP_RECLAIM ? _pb.structure_reference : _pb.playbook_id == PB_RANGE_REVERT ? (_pb.direction == 1 ? _pb.range_low_ref : _pb.range_high_ref) : close
    _entry_reference = _pb.playbook_id == PB_NONE ? close : not na(_pb.entry_reference) ? _pb.entry_reference : _legacy_entry
    _entry_type = _pb.playbook_id == PB_NONE ? ENTRY_NONE : ENTRY_LIMIT_RETEST
    _signal_price = close
    _order_price = _entry_reference
    [_invalidation, _invalidation_source_id, _invalidation_reason_short] = f_compute_structural_invalidation(_pb, _snap, _reg, _loc, _cfg)
    _stop_valid = f_stop_is_valid(_invalidation, _entry_reference, _pb.direction)
    _stop_distance = _stop_valid ? math.abs(_entry_reference - _invalidation) : na
    _projection_t1 = f_project_target(_entry_reference, _invalidation, _pb.direction, 1.0)
    _projection_t2 = f_project_target(_entry_reference, _invalidation, _pb.direction, 2.0)
    // Setup-owned targets are immutable. Previous structure is a conservative
    // initialization fallback; the final fallback is the symmetric 1R/2R model.
    _previous_t1 = _pb.direction == 1 ? _snap.prev_recent_high : _pb.direction == -1 ? _snap.prev_recent_low : na
    _previous_t2 = _pb.direction == 1 ? _snap.prev_range_high : _pb.direction == -1 ? _snap.prev_range_low : na
    _range_t1 = not na(_pb.range_high_ref) and not na(_pb.range_low_ref) ? math.avg(_pb.range_high_ref, _pb.range_low_ref) : na
    _range_t2 = _pb.direction == 1 ? _pb.range_high_ref : _pb.direction == -1 ? _pb.range_low_ref : na
    _fallback_t1 = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? _projection_t1 : _pb.playbook_id == PB_RANGE_REVERT ? _range_t1 : not na(_previous_t1) ? _previous_t1 : _projection_t1
    _fallback_t2 = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? _projection_t2 : _pb.playbook_id == PB_RANGE_REVERT ? _range_t2 : not na(_previous_t2) ? _previous_t2 : _projection_t2
    _candidate_t1 = not na(_pb.target1_reference) ? _pb.target1_reference : _fallback_t1
    _candidate_t2 = not na(_pb.target2_reference) ? _pb.target2_reference : _fallback_t2
    _target_1 = f_target_is_valid(_candidate_t1, _entry_reference, _pb.direction) ? _candidate_t1 : _projection_t1
    _target_2 = f_target_is_valid(_candidate_t2, _entry_reference, _pb.direction) ? _candidate_t2 : _projection_t2
    _targets_valid = f_target_is_valid(_target_1, _entry_reference, _pb.direction) and f_target_is_valid(_target_2, _entry_reference, _pb.direction)
    _target1_distance = _targets_valid ? math.abs(_target_1 - _entry_reference) : na
    _target2_distance = _targets_valid ? math.abs(_target_2 - _entry_reference) : na
    _rr_t1 = _stop_valid and _targets_valid and _stop_distance > syminfo.mintick ? _target1_distance / _stop_distance : 0.0
    _rr_t2 = _stop_valid and _targets_valid and _stop_distance > syminfo.mintick ? _target2_distance / _stop_distance : 0.0
    _rr_text = 'Targets ' + str.tostring(_rr_t1, '#.00') + ' / ' + str.tostring(_rr_t2, '#.00')
    _entry_dist = math.abs(close - _entry_reference)
    _action_text = f_action_name(_action_id)
    _decision_text = _action_text + ' | PENDING_GRADE'
    _invalid_text = 'Stop @ ' + str.tostring(_invalidation, format.mintick)
    _target_text = 'Targets ' + str.tostring(_target_1, format.mintick) + ' / ' + str.tostring(_target_2, format.mintick)
    _plan_text = f_playbook_name(_pb.playbook_id) + ' ' + _action_text
    tradePlan.new(_pb.playbook_id, _action_id, _pb.direction, _signal_price, _entry_type, _entry_reference, _order_price, _invalidation, _target_1, _target_2, _stop_distance, _target1_distance, _target2_distance, _rr_t1, _rr_t2, _invalidation_source_id, _invalidation_reason_short, _rr_text, _decision_text, _entry_dist, _action_text, _invalid_text, _target_text, _plan_text)

f_apply_main_projection_to_plan(tradePlan _base, int _dir, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low) =>
    _entry = close
    [_sl, _anchor_offset, _risk, _r1, _r2, _r3] = f_compute_projection_levels(_dir, _sl_mode, _atr, _kijun, _kumo_high, _kumo_low, _entry)
    _target1_dist = math.abs(_r1 - _entry)
    _target2_dist = math.abs(_r2 - _entry)
    _rr_t1 = _risk > syminfo.mintick ? _target1_dist / _risk : 0.0
    _rr_t2 = _risk > syminfo.mintick ? _target2_dist / _risk : 0.0
    _invalid_text = 'Visual SL @ ' + str.tostring(_sl, format.mintick)
    _target_text = 'R1/R2 ' + str.tostring(_r1, format.mintick) + ' / ' + str.tostring(_r2, format.mintick)
    _rr_text = 'Projection RR ' + str.tostring(_rr_t1, '#.00') + ' / ' + str.tostring(_rr_t2, '#.00')
    _plan_text = _base.plan_text + ' | Projection SL'
    tradePlan.new(_base.playbook_id, _base.action_id, _dir, _entry, ENTRY_MARKET_SIGNAL, _entry, _entry, _sl, _r1, _r2, _risk, _target1_dist, _target2_dist, _rr_t1, _rr_t2, _base.invalidation_source_id, 'PROJECTION_' + _sl_mode, _rr_text, _base.decision_text, 0.0, _base.action_text, _invalid_text, _target_text, _plan_text)

// A family plan deliberately contains no playbook execution semantics. It uses
// the same robust SL/R projection as the visible main signal, but always enters
// at the confirmed signal price so every enabled family event is comparable.
f_build_family_signal_plan(int _family_id, int _dir, float _signal_price, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low) =>
    [_sl, _anchor_offset, _risk, _r1, _r2, _r3] = f_compute_projection_levels(_dir, _sl_mode, _atr, _kijun, _kumo_high, _kumo_low, _signal_price)
    _family_name = _family_id == SIGSTAT_B1S1 ? 'B1/S1' : _family_id == SIGSTAT_IBIS ? 'IB/IS' : 'CB/CS'
    _invalid_text = 'Family SL @ ' + str.tostring(_sl, format.mintick)
    _target_text = 'Family R1/R2 ' + str.tostring(_r1, format.mintick) + ' / ' + str.tostring(_r2, format.mintick)
    tradePlan.new(PB_NONE, ACT_VALID, _dir, _signal_price, ENTRY_MARKET_SIGNAL, _signal_price, _signal_price, _sl, _r1, _r2, _risk, _risk, 2.0 * _risk, 1.0, 2.0, INV_SRC_NONE, 'FAMILY_PROJECTION_' + _sl_mode, 'Family RR 1.00 / 2.00', 'FAMILY_EVALUATION', 0.0, 'MARKET SIGNAL', _invalid_text, _target_text, _family_name + ' Family Evaluation')
f_grade_name(int _grade_id) =>
    switch _grade_id
        GRADE_A_PLUS => 'A+'
        GRADE_A => 'A'
        GRADE_B => 'B'
        GRADE_C => 'C'
        => 'SKIP'
f_signal_setup_compatible(int _signal_dir, playbookState _setup) =>
    _signal_dir != 0 and _setup.direction == _signal_dir and not _setup.invalidated and _setup.state_id != PBS_DONE
f_signal_plan_compatible(int _signal_dir, playbookState _setup, tradePlan _plan) =>
    f_signal_setup_compatible(_signal_dir, _setup) and _plan.playbook_id == _setup.playbook_id and _plan.direction == _signal_dir and _plan.direction == _setup.direction and _plan.entry_type != ENTRY_NONE and not na(_plan.order_price) and _plan.action_id != ACT_SKIP and _plan.action_id != ACT_INVALIDATED
f_cap_name(int _cap_id) =>
    switch _cap_id
        CAP_LOW_QUALITY => 'LOW_QUALITY_CAP'
        CAP_BAD_LOCATION => 'BAD_LOCATION_CAP'
        CAP_MID_RANGE => 'MID_RANGE_CAP'
        CAP_POOR_RR => 'POOR_RR_CAP'
        CAP_INVALIDATED => 'INVALIDATED_CAP'
        CAP_NO_TRADE => 'NO_TRADE_CAP'
        => 'NONE'
f_grade_from_score(float _score) =>
    _score >= SCORE_A_PLUS_MIN ? GRADE_A_PLUS : _score >= SCORE_A_MIN ? GRADE_A : _score >= SCORE_B_MIN ? GRADE_B : _score >= SCORE_C_MIN ? GRADE_C : GRADE_SKIP
f_safe_dist(float _a, float _b) =>
    math.abs(_a - _b)
f_safe_rr(float _target_dist, float _stop_dist) =>
    _stop_dist > syminfo.mintick ? _target_dist / _stop_dist : 0.0
f_clamp_score(float _v, float _min, float _max) =>
    math.max(_min, math.min(_max, _v))
f_norm_score(float _v, float _max) =>
    f_clamp_score(_v, 0.0, 100.0) * (_max / 100.0)
f_eval_rr(tradePlan _plan, presetConfig _cfg) =>
    _stop_distance = f_safe_dist(_plan.order_price, _plan.invalidation)
    _target1_distance = f_safe_dist(_plan.target_1, _plan.order_price)
    _target2_distance = f_safe_dist(_plan.target_2, _plan.order_price)
    _rr_t1 = f_safe_rr(_target1_distance, _stop_distance)
    _rr_t2 = f_safe_rr(_target2_distance, _stop_distance)
    // R1/R2 remain management milestones. Projection quality consistently uses
    // the primary expected target (R2), while structural plans use T1.
    _quality_rr = str.contains(_plan.invalidation_reason_short, 'PROJECTION_') ? _rr_t2 : _rr_t1
    _poor_rr = _quality_rr < _cfg.rr_poor_max
    _good_rr = _quality_rr >= _cfg.rr_good_min
    _strong_rr = _quality_rr >= _cfg.rr_strong_min
    rrState.new(_stop_distance, _target1_distance, _target2_distance, _rr_t1, _rr_t2, _quality_rr, _poor_rr, _good_rr, _strong_rr)
f_score_regime(playbookState _pb, regimeState _reg, foundationSnapshot _snap) =>
    // Confidence already aggregates the correlated Ichimoku votes.  Cloud,
    // TK/KJ and Chikou therefore refine one bounded regime dimension instead
    // of earning independent full-size bonuses elsewhere.
    _aligned = (_pb.direction == 1 and (_reg.is_bull or _reg.direction == 1)) or (_pb.direction == -1 and (_reg.is_bear or _reg.direction == -1))
    _regime_fit = _pb.playbook_id == PB_RANGE_REVERT ? (_reg.is_range ? 6.0 : _reg.is_transition ? 4.0 : 1.0) : _pb.playbook_id == PB_SWEEP_RECLAIM ? (_reg.is_range or _reg.is_transition ? 6.0 : _reg.is_pullback ? 4.0 : 2.0) : _reg.is_trend ? 6.0 : _reg.is_pullback ? 5.0 : _reg.is_transition ? 3.0 : 1.0
    _ichi_consistency = (_reg.chikou_clear and _reg.cloud_supportive ? 4.0 : _reg.chikou_clear or _reg.cloud_supportive ? 2.5 : 1.0)
    _score = f_norm_score(_reg.confidence, 15.0) + _regime_fit + _ichi_consistency
    _score := _score - (not _aligned and _reg.direction != 0 ? 5.0 : 0.0)
    _score := _score - (_reg.price_in_cloud ? 2.0 : 0.0) - math.min(4.0, _reg.conflict_count * 1.5)
    f_clamp_score(_score, 0.0, 25.0)
f_score_structure(playbookState _pb, foundationSnapshot _snap) =>
    _dir = _pb.direction
    _has_reference = not na(_pb.structure_reference) or not na(_pb.breakout_level_ref) or not na(_pb.range_high_ref) or not na(_pb.range_low_ref)
    _family_structure = _pb.playbook_id == PB_BREAKOUT_ACCEPT ? (_snap.sig_fractal == _dir ? 6.0 : 3.0) : _pb.playbook_id == PB_SWEEP_RECLAIM ? (not na(_pb.range_high_ref) and not na(_pb.range_low_ref) ? 6.0 : 3.0) : _pb.playbook_id == PB_RANGE_REVERT ? (not na(_pb.range_high_ref) and not na(_pb.range_low_ref) ? 6.0 : 3.0) : _pb.playbook_id == PB_PULLBACK_CONT ? (not na(_pb.structure_reference) ? 6.0 : 3.0) : 0.0
    _directional_structure = _dir == 1 ? (_snap.recent_high > _snap.prev_recent_high ? 4.0 : 2.0) : _dir == -1 ? (_snap.recent_low < _snap.prev_recent_low ? 4.0 : 2.0) : 0.0
    _score = (_pb.context_ok ? 6.0 : 2.0) + (_has_reference ? 4.0 : 0.0) + _family_structure + _directional_structure
    _score := _score - (_pb.invalidated ? 20.0 : 0.0)
    f_clamp_score(_score, 0.0, 20.0)
f_score_location(playbookState _pb, locationState _loc) =>
    _score = f_norm_score(_loc.location_score, 20.0)
    _score := _score - (_loc.mid_range ? 7.0 : 0.0) - (_loc.bad_location ? 16.0 : 0.0)
    f_clamp_score(_score, 0.0, 20.0)
f_score_trigger(playbookState _pb) =>
    _base = _pb.state_id == PBS_CONTEXT_VALID ? 4.0 : _pb.state_id == PBS_LOCATION_VALID ? 9.0 : _pb.state_id == PBS_TRIGGER_PENDING ? 14.0 : _pb.state_id == PBS_TRIGGERED ? 20.0 : 0.0
    _bonus = _pb.trigger_ok and _pb.state_id >= PBS_TRIGGER_PENDING ? 1.0 : 0.0
    f_clamp_score(_base + _bonus, 0.0, 20.0)
f_score_rr(rrState _rr, presetConfig _cfg) =>
    _score = _rr.quality_rr < _cfg.rr_poor_max ? 1.0 : _rr.quality_rr < _cfg.rr_good_min ? 4.0 : _rr.quality_rr < _cfg.rr_strong_min ? 6.0 : 8.0
    f_clamp_score(_score, 0.0, 8.0)
f_score_timing(playbookState _pb, foundationSnapshot _snap, tradePlan _plan, presetConfig _cfg) =>
    _atr_safe = math.max(_snap.ctx.atr, syminfo.mintick)
    _entry_dist_atr = _plan.entry_distance_from_price / _atr_safe
    _kijun_dist_atr = math.abs(close - _snap.ctx.kj) / _atr_safe
    _score = _entry_dist_atr <= TIMING_GOOD_DIST_ATR ? 7.0 : _entry_dist_atr <= _cfg.timing_chase_dist_atr ? 5.0 : 2.0
    _score := _score - (_entry_dist_atr > _cfg.timing_overext_atr ? 2.0 : 0.0)
    _score := _score - (_kijun_dist_atr > _cfg.timing_overext_atr ? 1.0 : 0.0)
    f_clamp_score(_score, 0.0, 7.0)
f_eval_setup_score(playbookState _pb, foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, tradePlan _plan, rrState _rr, presetConfig _cfg) =>
    _regime_score = f_score_regime(_pb, _reg, _snap)
    _structure_score = f_score_structure(_pb, _snap)
    _location_score = f_score_location(_pb, _loc)
    _trigger_score = f_score_trigger(_pb)
    _rr_timing_score = f_clamp_score(f_score_rr(_rr, _cfg) + f_score_timing(_pb, _snap, _plan, _cfg), 0.0, 15.0)
    _total_raw = f_clamp_score(_regime_score + _structure_score + _location_score + _trigger_score + _rr_timing_score, 0.0, 100.0)
    _grade_id = f_grade_from_score(_total_raw)
    setupScore.new(_regime_score, _structure_score, _location_score, _trigger_score, _rr_timing_score, _total_raw, _total_raw, f_grade_name(_grade_id), f_cap_name(CAP_NONE), false)
f_apply_score_caps(setupScore _score, playbookState _pb, noTradeState _nt, regimeState _reg, locationState _loc, rrState _rr) =>
    _final_score = _score.total_score_raw
    _cap_id = CAP_NONE
    _grade_max = GRADE_A_PLUS
    if _pb.invalidated or _pb.state_id == PBS_INVALIDATED
        _final_score := 0.0
        _cap_id := CAP_INVALIDATED
        _grade_max := GRADE_SKIP
    else if _nt.active
        _final_score := math.min(_final_score, 49.0)
        _cap_id := CAP_NO_TRADE
        _grade_max := GRADE_SKIP
    else if _nt.low_quality or _reg.is_low_quality
        _final_score := math.min(_final_score, 39.0)
        _cap_id := CAP_LOW_QUALITY
        _grade_max := GRADE_SKIP
    else if _loc.mid_range
        _final_score := math.min(_final_score, 49.0)
        _cap_id := CAP_MID_RANGE
        _grade_max := GRADE_SKIP
    else if _loc.bad_location
        _final_score := math.min(_final_score, 44.0)
        _cap_id := CAP_BAD_LOCATION
        _grade_max := GRADE_SKIP
    else if _rr.poor_rr
        _final_score := math.min(_final_score, 59.0)
        _cap_id := CAP_POOR_RR
        _grade_max := GRADE_C
    _final_score := f_clamp_score(_final_score, 0.0, 100.0)
    _grade_id = f_grade_from_score(_final_score)
    _grade_id := _grade_max == GRADE_SKIP ? GRADE_SKIP : _grade_max == GRADE_C and _grade_id > GRADE_C ? GRADE_C : _grade_id
    setupScore.new(_score.regime_score, _score.structure_score, _score.location_score, _score.trigger_score, _score.rr_timing_score, _score.total_score_raw, _final_score, f_grade_name(_grade_id), f_cap_name(_cap_id), _cap_id != CAP_NONE)
f_build_decision_text(playbookState _pb, tradePlan _plan, setupScore _score, noTradeState _nt) =>
    _state_head = _plan.action_id == ACT_VALID ? 'TRIGGERED' : _plan.action_id == ACT_ARMED ? 'ARMED' : _plan.action_id == ACT_WATCH ? 'WATCH' : 'SKIP'
    _state_head := _nt.active ? 'SKIP' : _state_head
    _txt = _state_head + ' | ' + _pb.playbook_text + ' | ' + _score.grade_text
    _txt := _score.capped ? _txt + ' | ' + _score.cap_text : _txt
    _txt
f_ampel_text(int _id) =>
    _id == 3 ? 'GREEN' : _id == 2 ? 'YELLOW' : 'RED'

f_ampel_color(int _id) =>
    _id == 3 ? color.new(color.lime, 55) : _id == 2 ? color.new(color.yellow, 65) : color.new(color.red, 55)

f_ampel_text_color(int _id) =>
    _id == 2 ? color.black : color.white

f_decision_bg_color(string _source, int _quality_id, int _ampel_trg, int _ampel_ctx, int _ampel_reg, int _ampel_loc, int _extension_state_id, bool _stand_aside, int _cooldown_remaining) =>
    color _bg = na
    if _source == 'Signal Quality'
        _bg := _quality_id == OPP_FAVORABLE ? color_green : _quality_id == OPP_NEUTRAL ? color_yellow : _quality_id == OPP_UNFAVORABLE ? color_red : na
    else if _source == 'Confirmation'
        _bg := _ampel_trg == 3 ? color_green : _ampel_trg == 2 ? color_yellow : _ampel_trg == 1 ? color_red : na
    else if _source == 'Context Fit'
        _bg := _ampel_ctx == 3 ? color_green : _ampel_ctx == 2 ? color_yellow : _ampel_ctx == 1 ? color_red : na
    else if _source == 'Regime Fit'
        _bg := _ampel_reg == 3 ? color_green : _ampel_reg == 2 ? color_yellow : _ampel_reg == 1 ? color_red : na
    else if _source == 'Location'
        _bg := _ampel_loc == 3 ? color_green : _ampel_loc == 2 ? color_yellow : _ampel_loc == 1 ? color_red : na
    else if _source == 'Extension'
        _bg := color.new(f_extension_state_bgcolor(_extension_state_id), transp_bg)
    else if _source == 'Stand Aside'
        _bg := _stand_aside ? color_red : color_green
    else if _source == 'Cooldown'
        _bg := _cooldown_remaining > 0 ? color_yellow : color_green
    _bg

f_bias_zone_direction(decisionSnapshot _d, int _early_dir) =>
    int _dir = 0
    if _d.regime_id == REGIME_TREND_BULL or _d.regime_id == REGIME_PULLBACK_BULL
        _dir := 1
    else if _d.regime_id == REGIME_TREND_BEAR or _d.regime_id == REGIME_PULLBACK_BEAR
        _dir := -1
    else if _early_dir != 0
        _dir := _early_dir
    _dir

f_ampel_score(int _ampel) =>
    _ampel == 3 ? 100.0 : _ampel == 2 ? 55.0 : 20.0

f_readiness_market_context_ampel(int _dir, int _regime_ampel, int _location_ampel, float _clarity) =>
    _dir == 0 or _regime_ampel < 2 or _clarity < 30 ? 1 : _regime_ampel == 3 and _location_ampel >= 2 and _clarity >= 55 ? 3 : 2

f_readiness_context_score(int _dir, int _regime_ampel, int _location_ampel, float _clarity) =>
    int _market_context = f_readiness_market_context_ampel(_dir, _regime_ampel, _location_ampel, _clarity)
    f_ampel_score(_market_context)

f_readiness_regime_score(int _regime_id, int _regime_ampel) =>
    float _base = _regime_id == REGIME_TREND_BULL or _regime_id == REGIME_TREND_BEAR ? 100.0 : _regime_id == REGIME_PULLBACK_BULL or _regime_id == REGIME_PULLBACK_BEAR ? 82.0 : _regime_id == REGIME_TRANSITION ? 45.0 : _regime_id == REGIME_RANGE ? 35.0 : _regime_id == REGIME_LOW_QUALITY ? 20.0 : 20.0
    math.min(_base, f_ampel_score(_regime_ampel))

f_readiness_structure_score(int _dir, int _regime_id, int _regime_ampel, float _clarity) =>
    float _regime_structure = _regime_id == REGIME_TREND_BULL or _regime_id == REGIME_TREND_BEAR ? 95.0 : _regime_id == REGIME_PULLBACK_BULL or _regime_id == REGIME_PULLBACK_BEAR ? 78.0 : _regime_id == REGIME_TRANSITION ? 45.0 : _regime_id == REGIME_RANGE ? 35.0 : 20.0
    float _dir_penalty = _dir == 0 ? 25.0 : 0.0
    math.max(0.0, math.min(100.0, _regime_structure * 0.65 + _clarity * 0.35 - _dir_penalty - (_regime_ampel == 1 ? 15.0 : 0.0)))

f_bias_zone_state_text(int _state_id) =>
    _state_id == RD_READY_LONG ? 'LONG' : _state_id == RD_READY_SHORT ? 'SHORT' : _state_id == RD_CHOP ? 'CHOP' : 'NO EDGE'

f_readiness_state_text(int _state_id) =>
    f_bias_zone_state_text(_state_id)

f_readiness_state_color(int _state_id) =>
    _state_id == RD_READY_LONG ? color.lime : _state_id == RD_READY_SHORT ? color.red : _state_id == RD_CHOP ? color.gray : _state_id == RD_NO_TRADE ? color.orange : color.silver

f_readiness_bg_color(int _zone_dir) =>
    _zone_dir == 1 ? color_green : _zone_dir == -1 ? color_red : na

f_readiness_setup_state_text(decisionSnapshot _d) =>
    // Status precedence keeps a real terminal event distinct from a policy stand-aside.
    _invalidated = _d.playbook_engine_state_text == 'invalidated'
    _late = _d.extension_state_id == EXT_EXTENDED or _d.extension_state_id == EXT_WAIT_PULLBACK
    _invalidated ? 'INVALIDATED' : _d.cooldown_remaining > 0 ? 'COOLDOWN' : _d.stand_aside ? 'NO TRADE' : _d.playbook_actionable ? 'TRIGGER' : _late ? 'LATE' : 'WAIT'

f_readiness_setup_state_color(string _state) =>
    _state == 'TRIGGER' ? color.lime : _state == 'WAIT' ? color.yellow : _state == 'LATE' ? color.new(color.orange, 20) : _state == 'NO TRADE' ? color.orange : _state == 'COOLDOWN' ? color.yellow : _state == 'INVALIDATED' ? color.red : color.silver

f_bias_hard_block(decisionSnapshot _d, float _chop_score, biasZoneProfileConfig _cfg) =>
    bool _major_chop = _chop_score >= _cfg.major_chop
    bool _major_context_fail = _d.regime_ampel == 1 and _d.context_ampel == 1
    bool _hard_reason = _d.stand_aside and (_d.stand_aside_reason_id == NT_LOW_QUALITY or _d.stand_aside_reason_id == NT_CONFLICT or _d.stand_aside_reason_id == NT_WEAK_CONTEXT)
    _major_chop or _major_context_fail or _hard_reason

f_build_bias_zone_state(decisionSnapshot _d, int _early_dir, biasZoneProfileConfig _cfg) =>
    int _dir = f_bias_zone_direction(_d, _early_dir)
    float _clarity = _d.clarity_score_i
    float _chop_score = 100.0 - _clarity
    float _context = f_readiness_context_score(_dir, _d.regime_ampel, _d.location_ampel, _clarity)
    float _regime = f_readiness_regime_score(_d.regime_id, _d.regime_ampel)
    float _structure = f_readiness_structure_score(_dir, _d.regime_id, _d.regime_ampel, _clarity)
    float _location = f_ampel_score(_d.location_ampel)
    bool _early_trend = _early_dir != 0 and _early_dir == _dir
    float _raw_score = _context * 0.30 + _regime * 0.25 + _structure * 0.20 + _location * 0.10 + _clarity * 0.15 + (_early_trend ? _cfg.early_trend_bonus : 0.0)
    float _score = f_assessment_clamp(_raw_score)
    bool _chop = _chop_score >= _cfg.chop_block
    bool _hard_block = f_bias_hard_block(_d, _chop_score, _cfg)
    bool _long_bias = _dir == 1 and _score >= _cfg.enter and _clarity >= _cfg.min_clarity and not _hard_block and not _chop and _d.regime_ampel >= 2
    bool _short_bias = _dir == -1 and _score >= _cfg.enter and _clarity >= _cfg.min_clarity and not _hard_block and not _chop and _d.regime_ampel >= 2
    int _state_id = _long_bias ? RD_READY_LONG : _short_bias ? RD_READY_SHORT : _hard_block or _chop ? RD_CHOP : RD_NONE
    string _reason = 'score=' + str.tostring(f_score_to_int(_score)) + ' chop=' + str.tostring(f_score_to_int(_chop_score)) + ' cfg=' + bias_zone_profile + ' ctx=' + str.tostring(f_score_to_int(_context)) + ' reg=' + str.tostring(f_score_to_int(_regime)) + ' struct=' + str.tostring(f_score_to_int(_structure)) + ' loc=' + str.tostring(f_score_to_int(_location)) + ' clarity=' + str.tostring(f_score_to_int(_clarity))
    tradeReadinessState.new(_state_id, _dir, _score, f_score_to_int(_score), f_bias_zone_state_text(_state_id), _reason)

f_alert_message_from_bias_zone(tradeReadinessState _r, decisionSnapshot _d, string _event, int _zone_age) =>
    'Event=' + _event + ' | Bias=' + _r.state_text + ' | Setup=' + f_readiness_setup_state_text(_d) + ' | BiasScore=' + str.tostring(_r.score_i) + ' | ChopScore=' + str.tostring(100 - _d.clarity_score_i) + ' | Clarity=' + str.tostring(_d.clarity_score_i) + ' | Context=' + str.tostring(_d.context_fit_i) + ' | Regime=' + str.tostring(f_score_to_int(_d.regime_fit_score)) + ' | Location=' + str.tostring(_d.structure_score_i) + ' | ZoneAge=' + str.tostring(_zone_age)

f_get_default_config() =>
    presetConfig.new('Manual / Default', PB_SWEEP_LOOKBACK, PB_RANGE_LOOKBACK, PB_BUFFER_ATR, PB_EDGE_NEAR_ATR, PB_RECLAIM_NEAR_ATR, RR_POOR_MAX, RR_GOOD_MIN, RR_STRONG_MIN, TIMING_CHASE_DIST_ATR, TIMING_OVEREXT_ATR)

f_resolve_preset_id(string _preset_name) =>
    switch _preset_name
        'Balanced' => PRESET_BALANCED
        'Fast' => PRESET_FAST
        'Slow' => PRESET_SLOW
        => PRESET_MANUAL

f_get_preset_config(int _preset_id) =>
    // Profiles intentionally share robust RR thresholds. Only structure speed and
    // ATR-normalized proximity/timing tolerances vary moderately.
    if _preset_id == PRESET_FAST
        presetConfig.new('Fast', 8, 16, 0.16, 0.52, 0.36, RR_POOR_MAX, RR_GOOD_MIN, RR_STRONG_MIN, 1.25, 1.85)
    else if _preset_id == PRESET_SLOW
        presetConfig.new('Slow', 14, 28, 0.14, 0.48, 0.34, RR_POOR_MAX, RR_GOOD_MIN, RR_STRONG_MIN, 1.15, 1.70)
    else if _preset_id == PRESET_BALANCED
        presetConfig.new('Balanced', PB_SWEEP_LOOKBACK, PB_RANGE_LOOKBACK, PB_BUFFER_ATR, PB_EDGE_NEAR_ATR, PB_RECLAIM_NEAR_ATR, RR_POOR_MAX, RR_GOOD_MIN, RR_STRONG_MIN, TIMING_CHASE_DIST_ATR, TIMING_OVEREXT_ATR)
    else
        f_get_default_config()

f_init_signal_opportunity_assessment() =>
