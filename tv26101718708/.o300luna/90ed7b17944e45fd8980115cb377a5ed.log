int bias_early_dir_live = f_bias_early_trend_dir(foundation_snap, foundation_regime)
int bias_early_dir = evaluation_mode == 'Realtime' ? bias_early_dir_live : nz(bias_early_dir_live[1], 0)
tradeReadinessState panel_bias_raw = f_build_bias_zone_state(panel_snapshot, bias_early_dir, profile_cfg)
var int bias_zone_dir = 0
var int bias_zone_state = RD_NONE
var int bias_zone_age = 0
var int bias_gap_count = 0
var int bias_candidate_dir = 0
var int bias_candidate_count = 0
int raw_dir = panel_bias_raw.state_id == RD_READY_LONG ? 1 : panel_bias_raw.state_id == RD_READY_SHORT ? -1 : 0
if raw_dir != 0 and raw_dir == bias_candidate_dir
    bias_candidate_count += 1
else
    bias_candidate_dir := raw_dir
    bias_candidate_count := raw_dir != 0 ? 1 : 0
bool candidate_confirmed = raw_dir != 0 and bias_candidate_count >= profile_cfg.confirm_bars
if bias_zone_dir == 0 and candidate_confirmed
    bias_zone_dir := raw_dir
    bias_zone_state := raw_dir == 1 ? RD_READY_LONG : RD_READY_SHORT
    bias_zone_age := 1
    bias_gap_count := 0
float active_chop_score = 100.0 - panel_snapshot.clarity_score_i
bool is_hold_profile = bias_zone_profile == 'Hold'
bool is_anti_chop_profile = bias_zone_profile == 'Anti-Chop'
bool raw_opposite = (bias_zone_dir == 1 and raw_dir == -1) or (bias_zone_dir == -1 and raw_dir == 1)
bool raw_opposite_confirmed = bias_zone_dir != 0 and raw_opposite and bias_candidate_count >= profile_cfg.opposite_confirm_bars
bool major_chop_now = active_chop_score >= profile_cfg.major_chop
bool normal_chop_now = active_chop_score >= profile_cfg.chop_block
bool chop_closes_zone = is_anti_chop_profile ? normal_chop_now : major_chop_now
bool score_keep_ok = panel_bias_raw.score_i >= profile_cfg.exit
bool hold_soft_keep = is_hold_profile and bias_zone_dir != 0 and panel_bias_raw.score_i >= profile_cfg.exit and not major_chop_now and not raw_opposite_confirmed
bool keep_current = bias_zone_dir != 0 and not chop_closes_zone and not raw_opposite_confirmed and (score_keep_ok or hold_soft_keep)
if bias_zone_dir != 0
    bias_zone_age += 1
    if keep_current
        bias_gap_count := 0
    else
        bias_gap_count += 1
    bool min_age_protect = bias_zone_age < profile_cfg.min_zone_bars
    bool grace_protect = bias_gap_count <= profile_cfg.gap_grace_bars
    if not keep_current and not min_age_protect and not grace_protect
        bias_zone_dir := 0
        bias_zone_state := panel_bias_raw.state_id == RD_CHOP ? RD_CHOP : RD_NONE
        bias_zone_age := 0
        bias_gap_count := 0
bool opposite_confirmed = (bias_zone_dir == 1 and bias_candidate_dir == -1 and bias_candidate_count >= profile_cfg.opposite_confirm_bars) or (bias_zone_dir == -1 and bias_candidate_dir == 1 and bias_candidate_count >= profile_cfg.opposite_confirm_bars)
if opposite_confirmed
    bias_zone_dir := bias_candidate_dir
    bias_zone_state := bias_candidate_dir == 1 ? RD_READY_LONG : RD_READY_SHORT
    bias_zone_age := 1
    bias_gap_count := 0
if bias_zone_dir != 0
    bias_zone_state := bias_zone_dir == 1 ? RD_READY_LONG : RD_READY_SHORT
else if panel_bias_raw.state_id == RD_CHOP
    bias_zone_state := RD_CHOP
else
    bias_zone_state := RD_NONE
int readiness_state_id = bias_zone_state
tradeReadinessState panel_readiness_raw = tradeReadinessState.new(readiness_state_id, bias_zone_dir != 0 ? bias_zone_dir : panel_bias_raw.direction, panel_bias_raw.score, panel_bias_raw.score_i, f_bias_zone_state_text(readiness_state_id), panel_bias_raw.reason_text)
color decision_panel_bg_color_raw = f_decision_bg_color(decision_bg_source, panel_snapshot.quality_class_id, panel_snapshot.confirmation_ampel, panel_snapshot.context_ampel, panel_snapshot.regime_ampel, panel_snapshot.location_ampel, panel_snapshot.extension_state_id, panel_snapshot.stand_aside, panel_snapshot.cooldown_remaining)
color readiness_bg_color = decision_bg_source == 'Bias Zone' ? f_readiness_bg_color(bias_zone_dir) : na
color decision_panel_bg_color = decision_bg_source == 'Bias Zone' ? readiness_bg_color : decision_panel_bg_color_raw

// Evaluation mode owns the admissible data; alert confirmation controls timing only.
decisionSnapshot alert_snapshot = evaluation_snapshot
bool alert_plan_compatible = main_signal_dir != 0 and alert_snapshot.direction == main_signal_dir
bool alert_snapshot_ok = alert_snapshot.valid_plan and not alert_snapshot.stand_aside and alert_snapshot.cooldown_remaining <= 0 and alert_snapshot.playbook_actionable and alert_plan_compatible and not main_signal_conflict
bool alert_b1 = signal_alerts_on and ICHI_signal_1 and _alert_gate and alert_snapshot_ok and b1_long_canonical_fire
bool alert_s1 = signal_alerts_on and ICHI_signal_1 and _alert_gate and alert_snapshot_ok and b1_short_canonical_fire
bool alert_ib = signal_alerts_on and pic_sig_plot and _alert_gate and alert_snapshot_ok and ib_long_canonical_fire
bool alert_is = signal_alerts_on and pic_sig_plot and _alert_gate and alert_snapshot_ok and ib_short_canonical_fire
bool alert_cb = signal_alerts_on and comb_enable and _alert_gate and alert_snapshot_ok and cb_long_canonical_fire
bool alert_cs = signal_alerts_on and comb_enable and _alert_gate and alert_snapshot_ok and cb_short_canonical_fire
bool alert_any_bull = alert_b1 or alert_ib or alert_cb
bool alert_any_bear = alert_s1 or alert_is or alert_cs
bool alert_any_signal = alert_any_bull or alert_any_bear
alert_family = alert_b1 or alert_s1 ? 'B1/S1' : alert_ib or alert_is ? 'IB/IS' : alert_cb or alert_cs ? 'CB/CS' : 'NONE'
alert_direction = alert_any_bull ? 'LONG' : alert_any_bear ? 'SHORT' : 'FLAT'
signal_alert_message = f_alert_message_from_signal(alert_family, alert_direction, alert_snapshot)
if signal_alerts_on and alert_any_signal
    _alert_freq = alerts_confirmed_only ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
    alert(signal_alert_message, freq = _alert_freq)

bool readiness_alert_gate = signal_alerts_on and bias_zone_alerts_on and _alert_gate
bool alert_long_context_open = readiness_alert_gate and readiness_state_id == RD_READY_LONG and readiness_state_id[1] != RD_READY_LONG
bool alert_short_context_open = readiness_alert_gate and readiness_state_id == RD_READY_SHORT and readiness_state_id[1] != RD_READY_SHORT
bool alert_chop_enter = readiness_alert_gate and readiness_state_id == RD_CHOP and readiness_state_id[1] != RD_CHOP
bool alert_context_closed = readiness_alert_gate and (readiness_state_id != RD_READY_LONG and readiness_state_id != RD_READY_SHORT) and (readiness_state_id[1] == RD_READY_LONG or readiness_state_id[1] == RD_READY_SHORT)
bool alert_readiness_any = alert_long_context_open or alert_short_context_open or alert_chop_enter or alert_context_closed
if alert_readiness_any
    _readiness_alert_freq = alerts_confirmed_only ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
    _readiness_event = alert_long_context_open ? 'BIAS LONG OPEN' : alert_short_context_open ? 'BIAS SHORT OPEN' : alert_chop_enter ? 'CHOP ENTER' : 'BIAS CLOSED'
    alert(f_alert_message_from_bias_zone(panel_readiness_raw, alert_snapshot, _readiness_event, bias_zone_age), freq = _readiness_alert_freq)

decisionSnapshot validation_snapshot_confirmed = not na(confirmed_snapshot.bar_time) ? confirmed_snapshot : live_snapshot
validation_b1_opp = f_validation_entry_opp_id_if_fire_snapshot(b1_long_canonical_fire, validation_snapshot_confirmed)
validation_s1_opp = f_validation_entry_opp_id_if_fire_snapshot(b1_short_canonical_fire, validation_snapshot_confirmed)
validation_ib_opp = f_validation_entry_opp_id_if_fire_snapshot(ib_long_canonical_fire, validation_snapshot_confirmed)
validation_is_opp = f_validation_entry_opp_id_if_fire_snapshot(ib_short_canonical_fire, validation_snapshot_confirmed)
validation_cb_opp = f_validation_entry_opp_id_if_fire_snapshot(cb_long_canonical_fire, validation_snapshot_confirmed)
validation_cs_opp = f_validation_entry_opp_id_if_fire_snapshot(cb_short_canonical_fire, validation_snapshot_confirmed)

bool quality_square_mode_none = quality_square_mode == 'None'
bool quality_square_mode_realtime = quality_square_mode == 'Realtime'
bool quality_square_mode_confirmed = quality_square_mode == 'Confirmed'
bool quality_square_enabled = quality_badges_on and not quality_square_mode_none
bool quality_square_confirmed_gate = barstate.isconfirmed

bool sq_family_b1_enabled = ICHI_signal_1
bool sq_family_ib_enabled = pic_sig_plot
bool sq_family_cb_enabled = comb_enable

bool sq_b1_fire_rt = sq_family_b1_enabled and b1_long_canonical_fire_preview
bool sq_s1_fire_rt = sq_family_b1_enabled and b1_short_canonical_fire_preview
bool sq_ib_fire_rt = sq_family_ib_enabled and ib_long_canonical_fire_preview
bool sq_is_fire_rt = sq_family_ib_enabled and ib_short_canonical_fire_preview
bool sq_cb_fire_rt = sq_family_cb_enabled and cb_long_canonical_fire_preview
bool sq_cs_fire_rt = sq_family_cb_enabled and cb_short_canonical_fire_preview

bool sq_b1_fire_confirmed = sq_family_b1_enabled and b1_long_canonical_fire
bool sq_s1_fire_confirmed = sq_family_b1_enabled and b1_short_canonical_fire
bool sq_ib_fire_confirmed = sq_family_ib_enabled and ib_long_canonical_fire
bool sq_is_fire_confirmed = sq_family_ib_enabled and ib_short_canonical_fire
bool sq_cb_fire_confirmed = sq_family_cb_enabled and cb_long_canonical_fire
bool sq_cs_fire_confirmed = sq_family_cb_enabled and cb_short_canonical_fire

validation_b1_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_b1_fire_rt, live_snapshot)
validation_s1_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_s1_fire_rt, live_snapshot)
validation_ib_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_ib_fire_rt, live_snapshot)
validation_is_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_is_fire_rt, live_snapshot)
validation_cb_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_cb_fire_rt, live_snapshot)
validation_cs_opp_rt = f_validation_entry_opp_id_if_fire_snapshot(sq_cs_fire_rt, live_snapshot)

bool quality_badge_show_confirmed = quality_square_enabled and (quality_square_mode_realtime or quality_square_mode_confirmed)
bool quality_badge_show_preview = quality_square_enabled and quality_square_mode_realtime and not quality_square_confirmed_gate

long_opp_confirmed = quality_badge_show_confirmed ? f_quality_opp_if_any_fire(sq_b1_fire_confirmed, validation_b1_opp, sq_ib_fire_confirmed, validation_ib_opp, sq_cb_fire_confirmed, validation_cb_opp) : na
short_opp_confirmed = quality_badge_show_confirmed ? f_quality_opp_if_any_fire(sq_s1_fire_confirmed, validation_s1_opp, sq_is_fire_confirmed, validation_is_opp, sq_cs_fire_confirmed, validation_cs_opp) : na
long_opp_preview = quality_badge_show_preview ? f_quality_opp_if_any_fire(sq_b1_fire_rt, validation_b1_opp_rt, sq_ib_fire_rt, validation_ib_opp_rt, sq_cb_fire_rt, validation_cb_opp_rt) : na
short_opp_preview = quality_badge_show_preview ? f_quality_opp_if_any_fire(sq_s1_fire_rt, validation_s1_opp_rt, sq_is_fire_rt, validation_is_opp_rt, sq_cs_fire_rt, validation_cs_opp_rt) : na

color quality_badge_long_color = na(long_opp_confirmed) ? na : f_quality_badge_color(long_opp_confirmed)
