f_outcome_horizon_bars(int _playbook_id) =>
    // Simple lifecycle horizons; deliberately not symbol/preset optimized.
    _playbook_id == PB_BREAKOUT_ACCEPT ? 18 : _playbook_id == PB_RANGE_REVERT ? 14 : _playbook_id == PB_PULLBACK_CONT ? 12 : _playbook_id == PB_SWEEP_RECLAIM ? 10 : 12

f_seed_signal_event_record(int _family_id, int _direction, decisionSnapshot _decision, foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, playbookState _pb, setupScore _score, presetConfig _cfg, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low) =>
    _family_plan = f_build_family_signal_plan(_family_id, _direction, close, _sl_mode, _atr, _kijun, _kumo_high, _kumo_low)
    _family_rr = f_eval_rr(_family_plan, _cfg)
    // Preserve the strategy/playbook context, while freezing independent family
    // entry, stop and targets into the event snapshot.
    _snapshot = f_build_signal_occurrence_snapshot(_family_id, f_signal_subtype_id(_family_id, _direction), _direction, _snap, _reg, _loc, _nt, _pb, _family_plan, _family_rr, _score, _cfg)
    _assessment_snapshot = f_selected_signal_assessment(_family_id, _pb, _snap, _reg, _loc, _nt, _family_plan, _family_rr, _score, _cfg)
    _outcome = f_build_signal_outcome_state(_snapshot, bar_index + f_outcome_horizon_bars(PB_NONE), 0.75, 0.50)
    signalEventRecord.new(true, false, _family_id, _direction, bar_index, _snapshot, _assessment_snapshot, _outcome)

f_runtime_ctx_seed_if_fire(bool _fire, int _family_id, int _direction, decisionSnapshot _decision, array<signalEventRecord> _active, array<signalEventRecord> _history, signalFamilyAggregateStats _agg, foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, playbookState _pb, tradePlan _strategy_plan, setupScore _score, presetConfig _cfg, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low, int _max_active, int _max_history) =>
    _next_agg = _agg
    if _fire
        _seed = f_seed_signal_event_record(_family_id, _direction, _decision, _snap, _reg, _loc, _nt, _pb, _score, _cfg, _sl_mode, _atr, _kijun, _kumo_high, _kumo_low)
        _compatible = f_signal_setup_compatible(_direction, _pb) and f_signal_plan_compatible(_direction, _pb, _strategy_plan)
        // Opportunity remains a strategy-compatibility diagnostic only. Every
        // confirmed enabled signal enters the independent family lifecycle.
        _next_agg := f_ctx_update_family_occurrence_aggregate(_next_agg, _seed, _compatible)
        if _seed.outcome.filled
            _next_agg := f_ctx_increment_filled(_next_agg)
        array.push(_active, _seed)
        while array.size(_active) > _max_active
            _overflow = array.shift(_active)
            f_ctx_push_bounded_history(_history, f_ctx_cancel_overflow(_overflow), _max_history)
            _next_agg := f_ctx_increment_cancelled(_next_agg)
    _next_agg

