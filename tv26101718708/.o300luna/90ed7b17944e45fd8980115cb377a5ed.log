bgcolor(final_bg_color, title = 'Signal Background')

f_get_col_from_state(_s) =>
    _s == 1 ? color.new(color.green, 20) : _s == -1 ? color.new(color.red, 20) : _s == 2 ? color.new(color.yellow, 20) : color.new(color.gray, 100)

array<string> panel_active_slot_modes = f_panel_active_slot_modes()
array<string> panel_tf_labels = array.from('1M', '1W', '1D', '4H', '1H', '15m', '5m', 'Chart')
array<bool> panel_tf_enabled = array.from(timeframe.isintraday or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly, timeframe.isintraday or timeframe.isdaily or timeframe.isweekly, timeframe.isintraday or timeframe.isdaily, true, true, true, true, true)
int panel_atr_row = array.size(panel_tf_labels) + 1

f_build_panel_states_for_tf(string _tf, bool _enabled, int _slot_count) =>
    _enabled ? f_fetch_panel_row(_tf, pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4) : array.new<int>(_slot_count, 0)

var table info_panel = na
var string info_panel_pos = ''
var int info_panel_cols = 0

if not panel_on or array.size(panel_active_slot_modes) == 0
    if not na(info_panel)
        table.delete(info_panel)
        info_panel := na
        info_panel_pos := ''
        info_panel_cols := 0
else
    atr_val = ta.atr(14)
    pos_tbl = pr_kumo_rel == 'Top Right' ? position.top_right : pr_kumo_rel == 'Bottom Left' ? position.bottom_left : pr_kumo_rel == 'Middle Right' ? position.middle_right : pr_kumo_rel == 'Middle Left' ? position.middle_left : position.bottom_right
    active_slot_count = array.size(panel_active_slot_modes)
    expected_cols = 1 + active_slot_count
    if na(info_panel) or info_panel_pos != pr_kumo_rel or info_panel_cols != expected_cols
        if not na(info_panel)
            table.delete(info_panel)
        info_panel := table.new(position = pos_tbl, columns = expected_cols, rows = panel_atr_row + 1, bgcolor = color.new(color.blue, 95), frame_width = 1, border_width = 1, frame_color = color.new(color.black, 50), border_color = color.new(color.black, 50))
        info_panel_pos := pr_kumo_rel
        info_panel_cols := expected_cols

    panel_states_1m = f_build_panel_states_for_tf('M', array.get(panel_tf_enabled, 0), active_slot_count)
    panel_states_1w = f_build_panel_states_for_tf('W', array.get(panel_tf_enabled, 1), active_slot_count)
    panel_states_1d = f_build_panel_states_for_tf('D', array.get(panel_tf_enabled, 2), active_slot_count)
    panel_states_4h = f_fetch_panel_row('240', pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4)
    panel_states_1h = f_fetch_panel_row('60', pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4)
    panel_states_15m = f_fetch_panel_row('15', pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4)
    panel_states_5m = f_fetch_panel_row('5', pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4)
    panel_states_chart = f_fetch_panel_row(timeframe.period, pan_opt_bg_1, pan_opt_bg_2, pan_opt_bg_3, pan_opt_bg_4)
    panel_state_rows = array.new<panelStateRow>()
    array.push(panel_state_rows, panelStateRow.new(panel_states_1m))
    array.push(panel_state_rows, panelStateRow.new(panel_states_1w))
    array.push(panel_state_rows, panelStateRow.new(panel_states_1d))
    array.push(panel_state_rows, panelStateRow.new(panel_states_4h))
    array.push(panel_state_rows, panelStateRow.new(panel_states_1h))
    array.push(panel_state_rows, panelStateRow.new(panel_states_15m))
    array.push(panel_state_rows, panelStateRow.new(panel_states_5m))
    array.push(panel_state_rows, panelStateRow.new(panel_states_chart))

    if barstate.islast and not na(info_panel)
        table.cell(table_id = info_panel, column = 0, row = 0, text = 'TF', text_size = size.small, text_color = color.silver)
        for _slot = 0 to active_slot_count - 1
            _mode = array.get(panel_active_slot_modes, _slot)
            table.cell(table_id = info_panel, column = _slot + 1, row = 0, text = f_panel_slot_header(_mode), text_size = size.small, text_color = color.silver)

        for _row = 0 to array.size(panel_tf_labels) - 1
            _label = array.get(panel_tf_labels, _row)
            _enabled = array.get(panel_tf_enabled, _row)
            _states = array.get(panel_state_rows, _row).states
            table.cell(table_id = info_panel, column = 0, row = _row + 1, text = _label, text_size = size.small, text_color = color.silver)
            for _slot = 0 to active_slot_count - 1
                _state = array.get(_states, _slot)
                _bg = _enabled ? f_get_col_from_state(_state) : color.new(color.gray, 100)
                table.cell(table_id = info_panel, column = _slot + 1, row = _row + 1, text = '', bgcolor = _bg, width = 1.8)

        table.cell(table_id = info_panel, column = 0, row = panel_atr_row, text = 'ATR14: ' + str.tostring(atr_val, format.mintick), text_size = size.small, text_color = color.silver)
        table.merge_cells(info_panel, 0, panel_atr_row, expected_cols - 1, panel_atr_row)
var array<box> boxes_fvg1 = array.new_box()
tf_ms1 = (fvg1_tf_sel == '' ? timeframe.in_seconds(timeframe.period) : timeframe.in_seconds(fvg1_tf_sel)) * 1000
chart_tf_ms = timeframe.in_seconds(timeframe.period) * 1000
[h1_mtf1, l1_mtf1, h3_mtf1, l3_mtf1, t2_mtf1] = request.security(syminfo.tickerid, fvg1_tf_sel == '' ? timeframe.period : fvg1_tf_sel, [high[1], low[1], high[3], low[3], time[2]], lookahead = barmerge.lookahead_off)
var int last_fvg_time1 = 0

if plot_fvg1
    box b_new = na
    if fvg1_tf_sel == ''
        if low > high[2] // Bullish
            _border_bull = color.new(color.green, 90)
            t_left_cur = time[2]
            t_right_cur = time + chart_tf_ms * (fvg1_len - 1)
            b_new := box.new(left = t_left_cur, top = low, right = t_right_cur, bottom = high[2], xloc = xloc.bar_time, border_color = _border_bull, bgcolor = col_fvg1_bull)

        if high < low[2] // Bearish
            _border_bear = color.new(color.red, 90)
            t_left_cur = time[2]
            t_right_cur = time + chart_tf_ms * (fvg1_len - 1)
            b_new := box.new(left = t_left_cur, top = low[2], right = t_right_cur, bottom = high, xloc = xloc.bar_time, border_color = _border_bear, bgcolor = col_fvg1_bear)
    else
        if t2_mtf1 != last_fvg_time1 and not na(t2_mtf1)
            t_left = t2_mtf1 - tf_ms1
            t_right = t2_mtf1 + tf_ms1 * fvg1_len

            if l1_mtf1 > h3_mtf1 // Bullish
                _border_bull = color.new(color.green, 90)
                b_new := box.new(left = t_left, top = l1_mtf1, right = t_right, bottom = h3_mtf1, xloc = xloc.bar_time, border_color = _border_bull, bgcolor = col_fvg1_bull)

            if h1_mtf1 < l3_mtf1 // Bearish
                _border_bear = color.new(color.red, 90)
                b_new := box.new(left = t_left, top = l3_mtf1, right = t_right, bottom = h1_mtf1, xloc = xloc.bar_time, border_color = _border_bear, bgcolor = col_fvg1_bear)

            last_fvg_time1 := t2_mtf1
    if not na(b_new)
        array.push(boxes_fvg1, b_new)
    while array.size(boxes_fvg1) > fvg1_limit
        box.delete(array.shift(boxes_fvg1))
else
    while array.size(boxes_fvg1) > 0
        box.delete(array.shift(boxes_fvg1))
    last_fvg_time1 := 0

