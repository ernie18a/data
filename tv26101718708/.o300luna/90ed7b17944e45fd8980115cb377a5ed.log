f_comb_compute_core(array<int> _signal_ids, float _atr_v, int _frac_state, int _fvg_state) =>
    int _dir_score = 0
    int _dir_count = 0
    bool _pass_selected = false
    bool _pass_ok_all = true
    bool _strict_buy_ok = true
    bool _strict_sell_ok = true

    if array.size(_signal_ids) > 0
        for i = 0 to array.size(_signal_ids) - 1 by 1
            int _sig_id = array.get(_signal_ids, i)
            int _val = f_ichi_eval_fast_by_id(_sig_id, TK, KJ, SA, SB, CS, _atr_v, close, high, low, _frac_state, _fvg_state)

            if f_signal_is_pass(_sig_id)
                _pass_selected := true
                if _val != 2
                    _pass_ok_all := false
                    _pass_ok_all
            else
                _dir_count := _dir_count + 1
                if _val == 1
                    _dir_score := _dir_score + 1
                    _strict_sell_ok := false
                    _strict_sell_ok
                else if _val == -1
                    _dir_score := _dir_score - 1
                    _strict_buy_ok := false
                    _strict_buy_ok
                else
                    _strict_buy_ok := false
                    _strict_sell_ok := false
                    _strict_sell_ok

    [_dir_score, _dir_count, _pass_selected, _pass_ok_all, _strict_buy_ok, _strict_sell_ok]

f_comb_compute_visual(bool _enabled, array<int> _signal_ids, float _atr_v, int _frac_state, int _fvg_state) =>
    if _enabled
        f_comb_compute_core(_signal_ids, _atr_v, _frac_state, _fvg_state)
    else
        [0, 0, false, true, true, true]

f_comb_raw_triggers_core(int _dir_count, int _dir_score, bool _strict_buy_ok, bool _strict_sell_ok) =>
    bool _raw_buy = false
    bool _raw_sell = false

    if _dir_count > 0
        if comb_mode == 'Strict (No Opposing)'
            if _strict_buy_ok
                _raw_buy := true
                _raw_buy
            if _strict_sell_ok
                _raw_sell := true
                _raw_sell
        else if comb_mode == 'Majority (Net Score)'
            if _dir_score > 0
                _raw_buy := true
                _raw_buy
            if _dir_score < 0
                _raw_sell := true
                _raw_sell
        else if comb_mode == 'Threshold %'
            float _thresh_val = float(_dir_count) * (comb_thresh / 100.0)
            if float(_dir_score) >= _thresh_val
                _raw_buy := true
                _raw_buy
            if float(_dir_score) <= -_thresh_val
                _raw_sell := true
                _raw_sell

    [_raw_buy, _raw_sell]

f_comb_raw_triggers_visual(bool _enabled, int _dir_count, int _dir_score, bool _strict_buy_ok, bool _strict_sell_ok) =>
    if _enabled
        f_comb_raw_triggers_core(_dir_count, _dir_score, _strict_buy_ok, _strict_sell_ok)
    else
        [false, false]

f_comb_bg_color(bool _enabled, bool _bg_plot, bool _buy, bool _sell, bool _pass_selected, bool _pass_ok_all, bool _grad_enable, int _dir_count, int _dir_score) =>
    float _transp = 80.0
    float _ratio = _dir_count > 0 ? math.abs(_dir_score) / float(_dir_count) : 0.0
    float _target = _grad_enable and _dir_count > 0 ? 100.0 - _ratio * 50.0 : 80.0
    _transp := ta.ema(_target, 10)

    color _bg_col = na
    if _enabled and _bg_plot
        if _buy
            _bg_col := color.new(color.green, _transp)
            _bg_col
        else if _sell
            _bg_col := color.new(color.red, _transp)
            _bg_col
        else if _pass_selected and _pass_ok_all
            _bg_col := color.new(color.yellow, transp_bg)
            _bg_col
    _bg_col
