bool rr_b1s1_long_signal = ICHI_signal_1 and b1_long_canonical_fire
bool rr_b1s1_short_signal = ICHI_signal_1 and b1_short_canonical_fire
bool rr_ibis_long_signal = pic_sig_plot and ib_long_canonical_fire
bool rr_ibis_short_signal = pic_sig_plot and ib_short_canonical_fire
bool rr_cbcs_long_signal = comb_enable and cb_long_canonical_fire
bool rr_cbcs_short_signal = comb_enable and cb_short_canonical_fire
bool rr_main_long_signal = rr_b1s1_long_signal or rr_ibis_long_signal or rr_cbcs_long_signal
bool rr_main_short_signal = rr_b1s1_short_signal or rr_ibis_short_signal or rr_cbcs_short_signal
bool rr_main_signal_conflict = rr_main_long_signal and rr_main_short_signal
int rr_main_signal_family_id = rr_b1s1_long_signal or rr_b1s1_short_signal ? SIGSTAT_B1S1 : rr_ibis_long_signal or rr_ibis_short_signal ? SIGSTAT_IBIS : rr_cbcs_long_signal or rr_cbcs_short_signal ? SIGSTAT_CBCS : SIG_NONE
int rr_main_signal_dir = rr_main_signal_conflict ? 0 : rr_main_long_signal ? 1 : rr_main_short_signal ? -1 : 0
bool rr_long_signal = rr_main_signal_dir == 1
bool rr_short_signal = rr_main_signal_dir == -1
bool rr_sq_long_signal = quality_badges_on and not na(long_opp_confirmed)
bool rr_sq_short_signal = quality_badges_on and not na(short_opp_confirmed)

var int rr_active_dir = 0
var int rr_active_family_id = SIG_NONE
var int rr_active_event_bar = na
var line rr_sl_line = na
var line rr_r1_line = na
var line rr_r2_line = na
var line rr_r3_line = na
var int rr_sq_active_dir = 0
var line rr_sq_sl_line = na
var line rr_sq_r1_line = na
var line rr_sq_r2_line = na
var line rr_sq_r3_line = na

if rr_lines_on
    _new_dir = rr_long_signal ? 1 : rr_short_signal ? -1 : 0
    _new_family_id = _new_dir != 0 ? rr_main_signal_family_id : SIG_NONE
    _should_replot = _new_dir != 0 and bar_index != rr_active_event_bar
    if _should_replot
        rr_entry = close
        [rr_sl_price, rr_anchor_offset, rr_risk, rr_r1, rr_r2, rr_r3] = f_compute_projection_levels(_new_dir, rr_sl_mode, _atr_g, KJ, kumo_high, kumo_low, rr_entry)
        rr_anchor_bar = bar_index - rr_anchor_offset
        rr_start_bar = math.max(0, rr_anchor_bar)
        rr_end_bar_base = bar_index + 5

        if not na(rr_sl_line)
            line.delete(rr_sl_line)
        if not na(rr_r1_line)
            line.delete(rr_r1_line)
        if not na(rr_r2_line)
            line.delete(rr_r2_line)
        if not na(rr_r3_line)
            line.delete(rr_r3_line)

        rr_sl_line := line.new(x1 = rr_start_bar, y1 = rr_sl_price, x2 = rr_end_bar_base, y2 = rr_sl_price, color = color.new(color.red, 0), style = line.style_dashed, width = 1)
        rr_r1_line := line.new(x1 = rr_start_bar, y1 = rr_r1, x2 = rr_end_bar_base, y2 = rr_r1, color = color.new(color.lime, 0), style = line.style_dashed, width = 1)
        rr_r2_line := line.new(x1 = rr_start_bar, y1 = rr_r2, x2 = rr_end_bar_base, y2 = rr_r2, color = color.new(color.lime, 0), style = line.style_dashed, width = 1)
        rr_r3_line := line.new(x1 = rr_start_bar, y1 = rr_r3, x2 = rr_end_bar_base, y2 = rr_r3, color = color.new(color.lime, 0), style = line.style_dashed, width = 1)
        rr_active_dir := _new_dir
        rr_active_family_id := _new_family_id
        rr_active_event_bar := bar_index
else
    rr_active_dir := 0
    rr_active_family_id := SIG_NONE
    rr_active_event_bar := na
    if not na(rr_sl_line)
        line.delete(rr_sl_line)
        rr_sl_line := na
    if not na(rr_r1_line)
        line.delete(rr_r1_line)
        rr_r1_line := na
    if not na(rr_r2_line)
        line.delete(rr_r2_line)
        rr_r2_line := na
    if not na(rr_r3_line)
        line.delete(rr_r3_line)
        rr_r3_line := na

if rr_sq_lines_on
    _new_sq_dir = rr_sq_long_signal ? 1 : rr_sq_short_signal ? -1 : 0
    _should_sq_replot = _new_sq_dir != 0
    if _should_sq_replot
        rr_sq_entry = close
        [rr_sq_sl_price, rr_sq_anchor_offset, rr_sq_risk, rr_sq_r1, rr_sq_r2, rr_sq_r3] = f_compute_projection_levels(_new_sq_dir, rr_sq_sl_mode, _atr_g, KJ, kumo_high, kumo_low, rr_sq_entry)
        rr_sq_anchor_bar = bar_index - rr_sq_anchor_offset
        rr_sq_start_bar = math.max(0, rr_sq_anchor_bar)
        rr_sq_end_bar_base = math.max(rr_sq_start_bar + 3, bar_index + 1)

        if not na(rr_sq_sl_line)
            line.delete(rr_sq_sl_line)
        if not na(rr_sq_r1_line)
            line.delete(rr_sq_r1_line)
        if not na(rr_sq_r2_line)
            line.delete(rr_sq_r2_line)
        if not na(rr_sq_r3_line)
            line.delete(rr_sq_r3_line)

        rr_sq_sl_line := line.new(x1 = rr_sq_start_bar, y1 = rr_sq_sl_price, x2 = rr_sq_end_bar_base, y2 = rr_sq_sl_price, color = color.new(color.red, 50), style = line.style_dashed, width = 1)
        rr_sq_r1_line := line.new(x1 = rr_sq_start_bar, y1 = rr_sq_r1, x2 = rr_sq_end_bar_base, y2 = rr_sq_r1, color = color.new(color.lime, 50), style = line.style_dashed, width = 1)
        rr_sq_r2_line := line.new(x1 = rr_sq_start_bar, y1 = rr_sq_r2, x2 = rr_sq_end_bar_base, y2 = rr_sq_r2, color = color.new(color.lime, 50), style = line.style_dashed, width = 1)
        rr_sq_r3_line := line.new(x1 = rr_sq_start_bar, y1 = rr_sq_r3, x2 = rr_sq_end_bar_base, y2 = rr_sq_r3, color = color.new(color.lime, 50), style = line.style_dashed, width = 1)
        rr_sq_active_dir := _new_sq_dir
    else if rr_sq_active_dir != 0
        if not na(rr_sq_sl_line)
            line.set_x2(rr_sq_sl_line, bar_index + 1)
        if not na(rr_sq_r1_line)
            line.set_x2(rr_sq_r1_line, bar_index + 1)
        if not na(rr_sq_r2_line)
            line.set_x2(rr_sq_r2_line, bar_index + 1)
        if not na(rr_sq_r3_line)
            line.set_x2(rr_sq_r3_line, bar_index + 1)
else
    rr_sq_active_dir := 0
    if not na(rr_sq_sl_line)
        line.delete(rr_sq_sl_line)
        rr_sq_sl_line := na
    if not na(rr_sq_r1_line)
        line.delete(rr_sq_r1_line)
        rr_sq_r1_line := na
    if not na(rr_sq_r2_line)
        line.delete(rr_sq_r2_line)
        rr_sq_r2_line := na
    if not na(rr_sq_r3_line)
        line.delete(rr_sq_r3_line)
        rr_sq_r3_line := na

bool marker_b1 = ICHI_signal_1 and b1_long_canonical_fire
