setupScore selected_score = f_apply_score_caps(selected_score_raw, selected_pb, foundation_no_trade, foundation_regime, foundation_location, selected_rr)
string selected_decision_text = f_build_decision_text(selected_pb, selected_plan, selected_score, foundation_no_trade)
selected_plan := tradePlan.new(selected_plan.playbook_id, selected_plan.action_id, selected_plan.direction, selected_plan.signal_price, selected_plan.entry_type, selected_plan.entry_reference, selected_plan.order_price, selected_plan.invalidation, selected_plan.target_1, selected_plan.target_2, selected_plan.stop_distance, selected_plan.target1_distance, selected_plan.target2_distance, selected_plan.rr_t1, selected_plan.rr_t2, selected_plan.invalidation_source_id, selected_plan.invalidation_reason_short, selected_plan.rr_text, selected_decision_text, selected_plan.entry_distance_from_price, selected_plan.action_text, selected_plan.invalidation_text, selected_plan.target_text, selected_plan.plan_text)
bool selected_trade_intent_valid = selected_pb.playbook_id != PB_NONE and selected_pb.state_id == PBS_TRIGGERED and f_playbook_freeze_ready(selected_pb) and selected_plan.playbook_id == selected_pb.playbook_id and selected_plan.direction == selected_pb.direction and selected_plan.action_id == ACT_VALID and selected_plan.entry_type != ENTRY_NONE and not na(selected_plan.order_price) and not na(selected_plan.invalidation) and not na(selected_plan.target_1) and not na(selected_plan.target_2)
bool selected_pullback_handoff_fire = lifecycle_commit and selected_trade_intent_valid and selected_pb.playbook_id == PB_PULLBACK_CONT and not pullback_handoff_committed and not _pb_pullback_invalidated_fire
bool selected_breakout_handoff_fire = lifecycle_commit and selected_trade_intent_valid and selected_pb.playbook_id == PB_BREAKOUT_ACCEPT and not breakout_handoff_committed and not _pb_breakout_invalidated_fire
bool selected_sweep_handoff_fire = lifecycle_commit and selected_trade_intent_valid and selected_pb.playbook_id == PB_SWEEP_RECLAIM and not sweep_handoff_committed and not _pb_sweep_invalidated_fire
bool selected_range_handoff_fire = lifecycle_commit and selected_trade_intent_valid and selected_pb.playbook_id == PB_RANGE_REVERT and not range_handoff_committed and not _pb_range_invalidated_fire
