f_extension_state_bgcolor(int _state_id) =>
    _state_id == EXT_PULLBACK_FAVORABLE ? color.new(color.lime, 25) : _state_id == EXT_EXTENDED ? color.new(color.orange, 25) : _state_id == EXT_WAIT_PULLBACK ? color.new(color.red, 35) : _state_id == EXT_NO_CLEAN_EDGE ? color.new(color.yellow, 45) : color.new(color.silver, 70)

f_extension_state_textcolor(int _state_id) =>
    _state_id == EXT_NEUTRAL ? color.silver : color.white

f_classify_extension_state(int _playbook_id, float _price_to_kijun_atr, float _price_to_kumo_edge_atr, float _entry_dist_atr, bool _near_kijun, bool _near_kumo_edge, bool _price_inside_cloud, float _timing_chase_dist_atr, float _timing_overext_atr) =>
    _kijun_dist = na(_price_to_kijun_atr) ? 0.0 : _price_to_kijun_atr
    _kumo_edge_dist = na(_price_to_kumo_edge_atr) ? 0.0 : _price_to_kumo_edge_atr
    _entry_dist = na(_entry_dist_atr) ? 0.0 : _entry_dist_atr
    _pb_chase_mult = _playbook_id == PB_BREAKOUT_ACCEPT ? 1.20 : _playbook_id == PB_PULLBACK_CONT ? 0.92 : _playbook_id == PB_RANGE_REVERT ? 0.96 : 1.0
    _pb_overext_mult = _playbook_id == PB_BREAKOUT_ACCEPT ? 1.28 : _playbook_id == PB_PULLBACK_CONT ? 0.95 : _playbook_id == PB_RANGE_REVERT ? 0.98 : 1.0
    _chase_threshold = _timing_chase_dist_atr * _pb_chase_mult
    _overext_threshold = _timing_overext_atr * _pb_overext_mult
    _cloud_near = _near_kumo_edge or _kumo_edge_dist <= _chase_threshold * 0.65
    _kijun_near = _near_kijun or _kijun_dist <= _chase_threshold * 0.70
    _cloud_far = _kumo_edge_dist > _overext_threshold * 1.06
    _kijun_far = _kijun_dist > _overext_threshold * 1.12
    _favorable_zone = not _price_inside_cloud and (_cloud_near or (_kijun_near and _kumo_edge_dist <= _chase_threshold * 1.05)) and _entry_dist <= _chase_threshold
    _wait_pullback = not _cloud_near and _entry_dist > _overext_threshold and _cloud_far and _kijun_far
    _extended = not _wait_pullback and not _favorable_zone and (not _cloud_near and (_entry_dist > _chase_threshold or _cloud_far))
    _price_inside_cloud ? EXT_NO_CLEAN_EDGE : _favorable_zone ? EXT_PULLBACK_FAVORABLE : _wait_pullback ? EXT_WAIT_PULLBACK : _extended ? EXT_EXTENDED : EXT_NEUTRAL

f_quality_reason_panel_text(signalOpportunityAssessment _assessment) =>
    _quality_text = f_quality_class_text(_assessment.quality_class_id) + ' Quality'
    _scores_text = 'R/S/L/T/RR: ' + f_safe_score_int_text(_assessment.regime_fit_score) + '/' + f_safe_score_int_text(_assessment.structure_score) + '/' + f_safe_score_int_text(_assessment.location_quality_score) + '/' + f_safe_score_int_text(_assessment.trigger_score) + '/' + f_safe_score_int_text(_assessment.rr_timing_score)
    _grade_text = _assessment.quality_score >= SCORE_A_PLUS_MIN ? 'A+' : _assessment.quality_score >= SCORE_A_MIN ? 'A' : _assessment.quality_score >= SCORE_B_MIN ? 'B' : _assessment.quality_score >= SCORE_C_MIN ? 'C' : 'SKIP'
    _total_text = 'Total/Grade: ' + f_safe_score_int_text(_assessment.quality_score) + '/' + _grade_text
    _cap_text = 'Cap: ' + (_assessment.hard_cap_active ? _assessment.hard_cap_reason_text : 'NONE')
    _quality_text + '\n' + _scores_text + '\n' + _total_text + '\n' + _cap_text

f_panel_pretty_text(string _text) =>
    _safe = na(_text) ? 'n/a' : _text
    str.replace_all(_safe, '_', ' ')

f_panel_limit_text(string _text, int _max_chars) =>
    _safe = na(_text) ? 'n/a' : _text
    _limit = math.max(1, _max_chars)
    str.length(_safe) <= _limit ? _safe : _limit == 1 ? '…' : str.substring(_safe, 0, _limit - 1) + '…'

f_panel_pad_center(string _text, int _min_chars) =>
    _safe = na(_text) ? 'n/a' : _text
    _need = math.max(0, _min_chars - str.length(_safe))
    _left = math.floor(_need * 0.5)
    _right = _need - _left
    _out = _safe
    if _left > 0
        for _i = 0 to _left - 1
            _out := ' ' + _out
    if _right > 0
        for _i = 0 to _right - 1
            _out += ' '
    _out

f_panel_display_extension(int _state_id) =>
    _state_id == EXT_PULLBACK_FAVORABLE ? 'Pullback OK' : _state_id == EXT_EXTENDED ? 'Extended' : _state_id == EXT_WAIT_PULLBACK ? 'Need Pullback' : _state_id == EXT_NO_CLEAN_EDGE ? 'No Clean Edge' : 'Neutral'

f_panel_display_engine_state(string _engine_state_text) =>
    _engine_state_text == 'stand_aside' ? 'st-aside' : _engine_state_text == 'cooldown' ? 'cool' : _engine_state_text == 'watch' ? 'watch' : _engine_state_text == 'candidate' ? 'cand' : _engine_state_text == 'ready' ? 'ready' : _engine_state_text == 'triggered' ? 'trig' : _engine_state_text == 'invalidated' ? 'inval' : 'inactive'

f_panel_display_playbook(string _playbook_text, string _engine_state_text) =>
    _pb = _playbook_text == 'None' ? 'None' : _playbook_text == 'Pullback Continuation' ? 'Pullback' : _playbook_text == 'Breakout Acceptance' or _playbook_text == 'Breakout Accept' ? 'Breakout' : _playbook_text == 'Sweep Reclaim' ? 'Sweep' : _playbook_text == 'Range Revert' ? 'Range' : _playbook_text
    _engine = f_panel_display_engine_state(_engine_state_text)
    _pb == 'None' ? 'None' : _pb + ' [' + _engine + ']'

f_panel_display_reason(string _reason_text) =>
    _pretty = f_panel_pretty_text(_reason_text)
    _s1 = str.replace_all(_pretty, ';', '\n')
    _s1 := str.replace_all(_s1, ' | ', '\n')
    _s2 = str.replace_all(_s1, 'Role: Con', 'Role: Confirm')
    _s2 := str.replace_all(_s2, 'WEAK CONT', 'WEAK CONTEXT')
    _s2 := str.replace_all(_s2, 'NO ACCEP', 'NO ACCEPTANCE')
    _s2 := str.replace_all(_s2, 'NO RECLA', 'NO RECLAIM')
    _s3 = str.replace_all(_s2, '  ', ' ')
    f_panel_limit_text(_s3, 64)

f_panel_display_stand_aside_reasons(string _text) =>
    _pretty = f_panel_pretty_text(_text)
    _s1 = str.replace_all(_pretty, 'Status:', 'Status')
    _s2 = str.replace_all(_s1, 'INACTIVE', 'Inactive')
    _s3 = str.replace_all(_s2, 'Primary:', 'Primary')
    _s4 = str.replace_all(_s3, 'Also:', 'Also')
    _s5 = str.replace_all(_s4, 'NONE', 'None')
    _s6 = str.replace_all(_s5, 'Primary ', 'Primary ')
    _s7 = str.replace_all(_s6, 'Also None', '')
    _s8 = str.replace_all(_s7, 'Also ', 'Also ')
    _s9 = str.replace_all(_s8, ';', '\n')
    _s9 := str.replace_all(_s9, 'WEAK CONT', 'WEAK CONTEXT')
    _s9 := str.replace_all(_s9, 'CONTEXT CON', 'CONTEXT CONFLICT')
    f_panel_limit_text(_s9, 64)

f_panel_layout_show_row(string _layout, int _row) =>
    if _layout == 'Full'
        true
    else if _layout == 'Trader'
        _row == 0 or _row == 1 or _row == 2 or _row == 6 or _row == 8 or _row == 9 or _row == 10 or _row == 12 or _row == 15 or _row == 17
    else
        _row != 16

f_alert_playbook_name(int _pb_id) =>
    _pb_id == PB_PULLBACK_CONT ? 'Pullback Continuation' : _pb_id == PB_BREAKOUT_ACCEPT ? 'Breakout Acceptance' : _pb_id == PB_SWEEP_RECLAIM ? 'Sweep Reclaim' : _pb_id == PB_RANGE_REVERT ? 'Range Revert' : 'None'

f_build_playbook_engine_state(playbookState _pb, noTradeState _nt, int _cooldown_remaining) =>
    int _engine_state_id = 0
    string _engine_state_text = 'inactive'
    bool _actionable = false
    string _reason_text = 'none'

    if _nt.active
        _engine_state_id := 1
        _engine_state_text := 'stand_aside'
        _reason_text := _nt.reason_text
    else if _cooldown_remaining > 0
        _engine_state_id := 2
        _engine_state_text := 'cooldown'
        _reason_text := 'cooldown ' + str.tostring(_cooldown_remaining) + ' bars'
    else if _pb.state_id == PBS_CONTEXT_VALID
        _engine_state_id := 3
        _engine_state_text := 'watch'
        _reason_text := _pb.state_text
    else if _pb.state_id == PBS_LOCATION_VALID
        _engine_state_id := 4
        _engine_state_text := 'candidate'
        _reason_text := _pb.state_text
    else if _pb.state_id == PBS_TRIGGER_PENDING
        _engine_state_id := 5
        _engine_state_text := 'ready'
        _reason_text := _pb.trigger_text
    else if _pb.state_id == PBS_TRIGGERED
        _engine_state_id := 6
        _engine_state_text := 'triggered'
        _actionable := true
        _reason_text := _pb.trigger_text
    else if _pb.state_id == PBS_INVALIDATED
        _engine_state_id := 0
        _engine_state_text := 'invalidated'
        _reason_text := _pb.reason_text

    playbookEngineState.new( _engine_state_text, _actionable, _reason_text)

f_score_to_int(float _score) =>
    int(math.round(math.max(0.0, math.min(100.0, _score))))

f_bias_zone_profile_config(string _profile) =>
    if _profile == 'Early'
        biasZoneProfileConfig.new(46, 34, 28, 76, 88, 2, 2, 1, 1, 14.0, 0.85, 0.70)
    else if _profile == 'Hold'
        biasZoneProfileConfig.new(56, 24, 30, 82, 94, 10, 10, 2, 4, 3.0, 0.75, 1.25)
    else if _profile == 'Anti-Chop'
        biasZoneProfileConfig.new(64, 48, 54, 56, 72, 3, 1, 3, 3, 0.0, 1.30, 0.35)
    else
        biasZoneProfileConfig.new(54, 36, 38, 66, 82, 4, 3, 2, 2, 5.0, 1.00, 0.65)

f_bias_trend_efficiency(int _len) =>
    float _net = math.abs(close - close[_len])
    float _path = ta.sma(math.abs(close - close[1]), _len) * _len
    float _er = _path > syminfo.mintick ? _net / _path : 0.0
    math.max(0.0, math.min(100.0, _er * 100.0))

f_bias_trend_quality(foundationSnapshot _snap, regimeState _reg) =>
    float _atr_safe = math.max(_snap.ctx.atr, syminfo.mintick)
    float _er = f_bias_trend_efficiency(timeframe.isintraday ? 34 : 21)
    float _kijun_now = _snap.ctx.kj
    float _kijun_slope = math.abs(_kijun_now - _kijun_now[5]) / _atr_safe
    float _kijun_slope_score = _kijun_slope >= 0.45 ? 100.0 : _kijun_slope >= 0.25 ? 70.0 : _kijun_slope >= 0.12 ? 45.0 : 15.0
    bool _bull_stack = close > _snap.ctx.kj and _snap.ctx.tk > _snap.ctx.kj and _reg.direction == 1
    bool _bear_stack = close < _snap.ctx.kj and _snap.ctx.tk < _snap.ctx.kj and _reg.direction == -1
    float _stack_score = _bull_stack or _bear_stack ? 100.0 : 25.0
    bool _outside_cloud = close > math.max(_snap.ctx.ssa_at_price, _snap.ctx.ssb_at_price) or close < math.min(_snap.ctx.ssa_at_price, _snap.ctx.ssb_at_price)
    float _cloud_acceptance_score = _outside_cloud ? 85.0 : _snap.price_inside_cloud ? 15.0 : 45.0
    float _regime_score = _reg.regime_id == REGIME_TREND_BULL or _reg.regime_id == REGIME_TREND_BEAR ? 100.0 : _reg.regime_id == REGIME_PULLBACK_BULL or _reg.regime_id == REGIME_PULLBACK_BEAR ? 78.0 : _reg.is_transition ? 45.0 : 20.0
    math.max(0.0, math.min(100.0, _er * 0.25 + _kijun_slope_score * 0.25 + _stack_score * 0.20 + _cloud_acceptance_score * 0.15 + _regime_score * 0.15))

f_bias_early_trend_dir(foundationSnapshot _snap, regimeState _reg) =>
    float _atr_safe = math.max(_snap.ctx.atr, syminfo.mintick)
    float _cloud_high = math.max(_snap.ctx.ssa_at_price, _snap.ctx.ssb_at_price)
    float _cloud_low = math.min(_snap.ctx.ssa_at_price, _snap.ctx.ssb_at_price)
    float _kijun_now = _snap.ctx.kj
    float _kijun_prev5 = _kijun_now[5]
    bool _bull_escape = close > _cloud_high and close > _kijun_now and _snap.ctx.tk >= _kijun_now and (_kijun_now - _kijun_prev5) / _atr_safe > 0.10
    bool _bear_escape = close < _cloud_low and close < _kijun_now and _snap.ctx.tk <= _kijun_now and (_kijun_prev5 - _kijun_now) / _atr_safe > 0.10
    _bull_escape and not _reg.is_low_quality ? 1 : _bear_escape and not _reg.is_low_quality ? -1 : 0

f_ichimoku_market_chop_score(foundationSnapshot _snap, regimeState _reg) =>
    int _chop_len = timeframe.isintraday ? 34 : 21
    float _atr_safe = math.max(_snap.ctx.atr, syminfo.mintick)
    bool _price_in_or_near_cloud = _snap.price_inside_cloud or _snap.price_to_kumo_edge_atr <= 0.25
    float _price_in_cloud_rate = ta.sma(_price_in_or_near_cloud ? 1.0 : 0.0, _chop_len) * 100.0
    float _kijun_now = _snap.ctx.kj
    float _kijun_cross_rate = math.min(100.0, ta.sma(ta.cross(close, _kijun_now) ? 1.0 : 0.0, _chop_len) * 100.0 * 6.0)
    float _tk_spread_atr = math.abs(_snap.ctx.tk - _kijun_now) / _atr_safe
    float _kijun_slope_atr = math.abs(_kijun_now - _kijun_now[5]) / _atr_safe
    float _flat_kijun_score = _kijun_slope_atr < 0.15 ? 100.0 : _kijun_slope_atr < 0.30 ? 60.0 : 20.0
    float _tk_compression_score = _tk_spread_atr < 0.25 ? 100.0 : _tk_spread_atr < 0.50 ? 60.0 : 20.0
    int _regime_dir_now = _reg.direction
    bool _regime_dir_flip = _regime_dir_now != 0 and _regime_dir_now[1] != 0 and _regime_dir_now != _regime_dir_now[1]
    float _regime_flip_score = math.min(100.0, ta.sma(_regime_dir_flip ? 1.0 : 0.0, _chop_len) * 100.0 * 8.0)
    float _regime_state_score = _reg.is_range ? 100.0 : _reg.is_transition ? 80.0 : _reg.is_low_quality ? 70.0 : _reg.conflict_count >= 2 ? 55.0 : 20.0
    float _regime_conflict_score = math.min(100.0, _regime_state_score * 0.65 + _regime_flip_score * 0.35)
    bool _chikou_blocked = not _reg.chikou_clear or _snap.sig_chikou_price == 0 or _snap.sig_chikou_cloud == 0
    float _chikou_block_score = _chikou_blocked ? 100.0 : 20.0
    float _thin_cloud_score = _reg.cloud_thin ? 100.0 : _snap.ctx.thick_atr_at_price < 0.8 or _snap.ctx.thick_atr_ahead < 0.8 ? 60.0 : 20.0
    float _kumo_twist_score = math.min(100.0, ta.sma(ta.cross(_snap.ctx.ssa_ahead, _snap.ctx.ssb_ahead) ? 1.0 : 0.0, _chop_len) * 100.0 * 10.0)
    float _cloud_instability_score = math.min(100.0, _thin_cloud_score * 0.60 + _kumo_twist_score * 0.40)
    biasZoneProfileConfig _cfg = f_bias_zone_profile_config(bias_zone_profile)
    float _trend_quality = f_bias_trend_quality(_snap, _reg)
    float _raw_chop = math.max(0.0, math.min(100.0, (_price_in_cloud_rate * 0.23 + _kijun_cross_rate * 0.16 + _flat_kijun_score * 0.18 + _tk_compression_score * 0.13 + _regime_conflict_score * 0.14 + _chikou_block_score * 0.10 + _cloud_instability_score * 0.06) * _cfg.chop_weight))
    float _trend_override = (_trend_quality >= 75.0 ? 24.0 : _trend_quality >= 60.0 ? 14.0 : _trend_quality >= 45.0 ? 6.0 : 0.0) * _cfg.trend_override_strength
    math.max(0.0, math.min(100.0, _raw_chop - _trend_override))

f_build_decision_snapshot(foundationSnapshot _snap, regimeState _reg, locationState _loc, noTradeState _nt, playbookState _pb, tradePlan _plan, signalOpportunityAssessment _assessment, presetConfig _cfg, int _cooldown_remaining) =>
    _regime_text = _reg.regime_id == REGIME_TREND_BULL ? 'TREND_BULL' : _reg.regime_id == REGIME_TREND_BEAR ? 'TREND_BEAR' : _reg.regime_id == REGIME_PULLBACK_BULL ? 'PULLBACK_BULL' : _reg.regime_id == REGIME_PULLBACK_BEAR ? 'PULLBACK_BEAR' : _reg.regime_id == REGIME_RANGE ? 'RANGE' : _reg.regime_id == REGIME_TRANSITION ? 'TRANSITION' : _reg.regime_id == REGIME_LOW_QUALITY ? 'LOW_QUALITY' : 'NONE'
    _location_text = _loc.location_text
    _reason_panel_text = f_quality_reason_panel_text(_assessment)
    _reason_short = _assessment.reason_text_short
    _engine = f_build_playbook_engine_state(_pb, _nt, _cooldown_remaining)
    _direction = _pb.direction
    _tradeable = _engine.actionable and _pb.playbook_id != PB_NONE
    _ampel_trigger = _pb.state_id == PBS_INVALIDATED or _pb.state_id == PBS_INACTIVE ? 1 : _pb.state_id == PBS_TRIGGERED ? 3 : 2
    _ampel_context = _assessment.context_fit >= 70 ? 3 : _assessment.context_fit >= 45 ? 2 : 1
    _ampel_regime = _reg.is_low_quality or _reg.regime_id == REGIME_NONE ? 1 : _reg.is_transition or _reg.conflict_count >= 2 or _reg.confidence < 60.0 ? 2 : 3
    _ampel_location = _loc.bad_location ? 1 : _loc.mid_range or _loc.location_score < 45.0 ? 2 : _loc.location_score >= 70.0 ? 3 : 2
    _status = _nt.active ? 'ACTIVE' : 'INACTIVE'
    _primary = _nt.active ? _nt.reason_text : 'NONE'
    _also = ''
    _n = 0
    if _nt.low_quality and _nt.reason_id != NT_LOW_QUALITY and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'LOW_QUALITY'
        _n += 1
    if _nt.bad_location and _nt.reason_id != NT_BAD_LOCATION and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'BAD_LOCATION'
        _n += 1
    if _nt.mid_range and _nt.reason_id != NT_MID_RANGE and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'MID_RANGE'
        _n += 1
    if _nt.conflict and _nt.reason_id != NT_CONFLICT and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'CONTEXT_CONFLICT'
        _n += 1
    if _nt.against_regime and _nt.reason_id != NT_AGAINST_REGIME and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'AGAINST_REGIME'
        _n += 1
    if _nt.weak_context and _nt.reason_id != NT_WEAK_CONTEXT and _n < 3
        _also := _also + (_n > 0 ? ', ' : '') + 'WEAK_CONTEXT'
        _n += 1
    _stand_aside_reasons_text = 'Status: ' + _status + '\nPrimary: ' + _primary + '\nAlso: ' + (_n > 0 ? _also : 'NONE')
    _cooldown_text = _cooldown_remaining > 0 ? str.tostring(_cooldown_remaining) + ' bars' : 'none'
    _quality_i = f_score_to_int(_assessment.quality_score)
    _context_i = f_score_to_int(_assessment.context_fit)
    _structure_i = f_score_to_int(_assessment.location_quality_score)
    _potential_i = f_score_to_int(_assessment.tradeability)
    _market_chop_score = f_ichimoku_market_chop_score(_snap, _reg)
    _market_clarity = math.max(0.0, math.min(100.0, 100.0 - _market_chop_score))
    _clarity_i = f_score_to_int(_market_clarity)
    _composite_i = f_score_to_int(_assessment.quality_score * 0.30 + _assessment.tradeability * 0.25 + _assessment.location_quality_score * 0.20 + _assessment.context_fit * 0.15 + _market_clarity * 0.10)
    _foundation_i = f_score_to_int((_context_i + _structure_i + f_score_to_int(_assessment.regime_fit_score)) / 3.0)
    _execution_i = f_score_to_int((_potential_i + _clarity_i + _composite_i) / 3.0)
    _final_i = _tradeable ? _composite_i : math.min(_composite_i, 45)
    _valid_plan = _plan.entry_type != ENTRY_NONE and not na(_plan.entry_reference) and not na(_plan.order_price) and not na(_plan.invalidation)
    decisionSnapshot.new( time, _reg.regime_id, _regime_text, _loc.location_id, _location_text, _nt.active, _nt.reason_id, _nt.reason_text, _pb.playbook_id, _pb.playbook_text, _engine.engine_state_text, _engine.actionable, _direction, _assessment.quality_score, _assessment.quality_class_id, _assessment.context_fit, _context_i, _assessment.regime_fit_score, _assessment.location_quality_score, _structure_i, _assessment.tradeability, _assessment.extension_state_id, _ampel_trigger, _ampel_context, _ampel_regime, _ampel_location, _cooldown_remaining, _cooldown_text, _reason_short, _reason_panel_text, _stand_aside_reasons_text, _clarity_i, _foundation_i, _execution_i, _final_i, _cfg.preset_name, _valid_plan, _plan.order_price, _plan.invalidation)

f_alert_message_from_signal(string _family, string _direction, decisionSnapshot _decision) =>
    _quality_text = f_quality_class_text(_decision.quality_class_id)
    'Family=' + _family + ' | Dir=' + _direction + ' | Event=SIGNAL | Playbook=' + f_alert_playbook_name(_decision.playbook_id) + ' | PBState=' + _decision.playbook_engine_state_text + ' | PBReady=' + (_decision.playbook_actionable ? 'true' : 'false') + ' | Quality=' + _quality_text + ' | Foundation=' + str.tostring(_decision.foundation_score_i) + ' | Execution=' + str.tostring(_decision.execution_score_i) + ' | Final=' + str.tostring(_decision.final_score_i) + ' | Entry=' + str.tostring(_decision.order_price, format.mintick) + ' | Invalid=' + str.tostring(_decision.invalidation, format.mintick)

f_assessment_clamp(float _value) =>
    math.max(0.0, math.min(100.0, _value))

f_bool_text(bool _value) =>
    _value ? 'true' : 'false'

f_is_hard_no_trade_reason(int _reason_id) =>
    _reason_id == NT_LOW_QUALITY or _reason_id == NT_BAD_LOCATION or _reason_id == NT_MID_RANGE or _reason_id == NT_AGAINST_REGIME or _reason_id == NT_CONFLICT or _reason_id == NT_WEAK_CONTEXT

f_hard_no_trade_reason_text(int _reason_id) =>
    switch _reason_id
        NT_LOW_QUALITY => 'LOW_QUALITY'
        NT_BAD_LOCATION => 'BAD_LOCATION'
        NT_MID_RANGE => REASON_RANGE_CENTER
        NT_AGAINST_REGIME => 'AGAINST_REGIME'
        NT_CONFLICT => 'CONFLICT'
        NT_WEAK_CONTEXT => REASON_NO_CONTEXT
        => 'NONE'
f_assessment_no_trade_reason_text(int _reason_id) =>
    switch _reason_id
        NT_LOW_QUALITY => 'LOW_QUALITY'
        NT_BAD_LOCATION => 'BAD_LOCATION'
        NT_MID_RANGE => REASON_RANGE_CENTER
        NT_AGAINST_REGIME => 'AGAINST_REGIME'
        NT_NO_ACCEPTANCE => 'NO_ACCEPTANCE'
        NT_NO_RECLAIM => 'NO_RECLAIM'
        NT_WEAK_CONTEXT => REASON_NO_CONTEXT
        NT_CONFLICT => 'CONFLICT'
        => 'NONE'
f_assessment_signal_role(signalOccurrenceSnapshot _occ) =>
    if _occ.signal_family_id == SIGSTAT_B1S1
        ROLE_TREND_FOLLOW
    else if _occ.signal_family_id == SIGSTAT_IBIS
        ROLE_CONFIRMATION
    else if cbcs_role_input == 'Trend Follow'
        ROLE_TREND_FOLLOW
    else if cbcs_role_input == 'Breakout'
        ROLE_BREAKOUT
    else if cbcs_role_input == 'Reversal'
        ROLE_REVERSAL
    else if cbcs_role_input == 'Hybrid'
        ROLE_HYBRID
    else if _occ.is_transition or _occ.is_range
        ROLE_REVERSAL
    else if _occ.mid_range or _occ.bad_location
        ROLE_HYBRID
    else if _occ.is_trend or _occ.is_pullback
        ROLE_BREAKOUT
    else
        ROLE_HYBRID
