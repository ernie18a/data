    _cancelled = signalOutcomeState.new(false, true, TRADE_CANCELLED_TRACKING_LIMIT, _o.filled, _o.entry_type, _o.order_price, _o.fill_price, _o.stop_price, _o.target1_price, _o.target2_price, _o.expiry_bar_index, _o.hit_half_r, _o.hit_t1, _o.hit_t2, _o.hit_1r, _o.hit_2r, false, false, false, false, _o.mae_atr, _o.mfe_atr)
    signalEventRecord.new(false, true, _event.family_id, _event.direction, _event.start_bar_index, _event.snapshot, _event.assessment, _cancelled)

f_outcome_price_is_valid(float _price, float _entry_price, int _direction, bool _is_stop) =>
    not na(_price) and not na(_entry_price) and (_direction == 1 ? (_is_stop ? _price < _entry_price : _price > _entry_price) : _direction == -1 ? (_is_stop ? _price > _entry_price : _price < _entry_price) : false)

f_build_signal_outcome_state(signalOccurrenceSnapshot _snapshot, int _expiry_bar_index, float _fallback_good_atr, float _fallback_fail_atr) =>
    _order = _snapshot.order_price
    _atr = _snapshot.atr_at_signal
    _fallback_stop = _atr > 0 ? _fallback_fail_atr * _atr : na
    _stop = f_outcome_price_is_valid(_snapshot.invalidation, _order, _snapshot.direction, true) ? _snapshot.invalidation : _snapshot.direction == 1 ? _order - _fallback_stop : _order + _fallback_stop
    _risk = math.abs(_order - _stop)
    _t1_fallback = _snapshot.direction == 1 ? _order + math.max(_risk, _fallback_good_atr * _atr) : _order - math.max(_risk, _fallback_good_atr * _atr)
    _t2_fallback = _snapshot.direction == 1 ? _order + 2.0 * _risk : _order - 2.0 * _risk
    _t1 = f_outcome_price_is_valid(_snapshot.target_1, _order, _snapshot.direction, false) ? _snapshot.target_1 : _t1_fallback
    _t2 = f_outcome_price_is_valid(_snapshot.target_2, _order, _snapshot.direction, false) ? _snapshot.target_2 : _t2_fallback
    _market_fill = _snapshot.entry_type == ENTRY_MARKET_SIGNAL
    _fill_price = _market_fill ? _snapshot.signal_price : na
    signalOutcomeState.new(true, false, _market_fill ? TRADE_ACTIVE : TRADE_WAITING_ENTRY, _market_fill, _snapshot.entry_type, _order, _fill_price, _stop, _t1, _t2, _expiry_bar_index, false, false, false, false, false, false, false, false, false, _market_fill ? 0.0 : na, _market_fill ? 0.0 : na)

f_update_signal_outcome(signalEventRecord _event, float _high, float _low, int _bar_index) =>
    _o = _event.outcome
    _dir = _event.direction
    _after_signal = _bar_index > _event.start_bar_index
    _entry_touched = _o.entry_type == ENTRY_LIMIT_RETEST and _after_signal and _low <= _o.order_price and _high >= _o.order_price
    _filled_this_bar = not _o.filled and _entry_touched
    _filled = _o.filled or _entry_touched
    _fill_price = _filled_this_bar ? _o.order_price : _o.fill_price
    _expired_unfilled = not _filled and _bar_index >= _o.expiry_bar_index
    // A first-touch bar is never evaluated: OHLC cannot order entry vs stop/target.
    // Market fills likewise begin outcome evaluation after their signal bar.
    _can_evaluate = _filled and not _filled_this_bar and _after_signal and not _o.resolved
    _stop_now = _can_evaluate and (_dir == 1 ? _low <= _o.stop_price : _high >= _o.stop_price)
    _t1_now = _can_evaluate and (_dir == 1 ? _high >= _o.target1_price : _low <= _o.target1_price)
    _t2_now = _can_evaluate and (_dir == 1 ? _high >= _o.target2_price : _low <= _o.target2_price)
    _ambiguous = _can_evaluate and _stop_now and (_t1_now or _t2_now)
    _resolved_target = not _ambiguous and _t2_now
    _resolved_stop = not _ambiguous and _stop_now
    _timed_out = _can_evaluate and not _resolved_target and not _resolved_stop and not _ambiguous and _bar_index >= _o.expiry_bar_index
    _resolved = _expired_unfilled or _ambiguous or _resolved_target or _resolved_stop or _timed_out
    _risk = math.abs(_o.order_price - _o.stop_price)
    _r1 = _dir == 1 ? _o.order_price + _risk : _o.order_price - _risk
    _r2 = _dir == 1 ? _o.order_price + 2.0 * _risk : _o.order_price - 2.0 * _risk
    _hit_half = _o.hit_half_r or (_can_evaluate and (_dir == 1 ? _high >= _o.order_price + 0.5 * _risk : _low <= _o.order_price - 0.5 * _risk))
    _hit_t1 = _o.hit_t1 or (_t1_now and not _ambiguous)
    _hit_t2 = _o.hit_t2 or (_t2_now and not _ambiguous)
    _hit_1r = _o.hit_1r or (_can_evaluate and not _ambiguous and (_dir == 1 ? _high >= _r1 : _low <= _r1))
    _hit_2r = _o.hit_2r or (_can_evaluate and not _ambiguous and (_dir == 1 ? _high >= _r2 : _low <= _r2))
    _fav = _dir == 1 ? math.max(0.0, _high - _o.order_price) : math.max(0.0, _o.order_price - _low)
    _adv = _dir == 1 ? math.max(0.0, _o.order_price - _low) : math.max(0.0, _high - _o.order_price)
    _mfe = _can_evaluate and _event.snapshot.atr_at_signal > 0 ? math.max(nz(_o.mfe_atr), _fav / _event.snapshot.atr_at_signal) : _o.mfe_atr
    _mae = _can_evaluate and _event.snapshot.atr_at_signal > 0 ? math.max(nz(_o.mae_atr), _adv / _event.snapshot.atr_at_signal) : _o.mae_atr
    _state = _expired_unfilled ? TRADE_EXPIRED_UNFILLED : _ambiguous ? TRADE_RESOLVED_AMBIGUOUS : _resolved_target ? TRADE_RESOLVED_TARGET : _resolved_stop ? TRADE_RESOLVED_STOP : _timed_out ? TRADE_RESOLVED_TIMEOUT : _filled_this_bar ? TRADE_FILLED : _filled ? TRADE_ACTIVE : TRADE_WAITING_ENTRY
    _next = signalOutcomeState.new(not _resolved, _resolved, _state, _filled, _o.entry_type, _o.order_price, _fill_price, _o.stop_price, _o.target1_price, _o.target2_price, _o.expiry_bar_index, _hit_half, _hit_t1, _hit_t2, _hit_1r, _hit_2r, _resolved_stop, _timed_out, _ambiguous, _expired_unfilled, _mae, _mfe)
    signalEventRecord.new(not _resolved, _resolved, _event.family_id, _dir, _event.start_bar_index, _event.snapshot, _event.assessment, _next)

f_ctx_update_single_event(signalEventRecord _event, float _high, float _low, int _bar_index) =>
    f_update_signal_outcome(_event, _high, _low, _bar_index)

f_ctx_update_running_average(float _avg, int _count, float _value) =>
    _count <= 0 or na(_avg) ? _value : (_avg * _count + _value) / (_count + 1)

f_ctx_safe_rate(int _num, int _den) =>
    _den > 0 ? _num * 100.0 / _den : 0.0

f_event_is_long(signalEventRecord _event) =>
    _event.direction == 1

f_event_is_short(signalEventRecord _event) =>
    _event.direction == -1

f_event_is_favorable(signalEventRecord _event) =>
    _event.assessment.quality_class_id == OPP_FAVORABLE

f_event_is_neutral(signalEventRecord _event) =>
    _event.assessment.quality_class_id == OPP_NEUTRAL

f_event_is_unfavorable(signalEventRecord _event) =>
    _event.assessment.quality_class_id == OPP_UNFAVORABLE

f_ctx_update_family_occurrence_aggregate(signalFamilyAggregateStats _agg, signalEventRecord _event, bool _opportunity) =>
    _count = _agg.occurrence_count + 1
    signalFamilyAggregateStats.new(
         _agg.signal_id, _count,
         _agg.long_count + (f_event_is_long(_event) ? 1 : 0),
         _agg.short_count + (f_event_is_short(_event) ? 1 : 0),
         _agg.favorable_count + (f_event_is_favorable(_event) ? 1 : 0),
         _agg.neutral_count + (f_event_is_neutral(_event) ? 1 : 0),
         _agg.unfavorable_count + (f_event_is_unfavorable(_event) ? 1 : 0),
         f_ctx_update_running_average(_agg.avg_context_fit, _agg.occurrence_count, _event.assessment.context_fit),
         f_ctx_update_running_average(_agg.avg_tradeability, _agg.occurrence_count, _event.assessment.tradeability),
         f_ctx_update_running_average(_agg.avg_confidence, _agg.occurrence_count, _event.assessment.confidence),
         _agg.resolved_count, _agg.win_1r_count, _agg.win_2r_count, _agg.loss_count, _agg.timeout_count, _agg.avg_mae_atr, _agg.avg_mfe_atr,
         _agg.opportunity_count + (_opportunity ? 1 : 0), _agg.filled_count, _agg.unfilled_count, _agg.cancelled_count, _agg.ambiguous_count, _agg.stop_count, _agg.t1_hit_count, _agg.t2_hit_count,
         _agg.high_outcomes, _agg.medium_outcomes, _agg.low_outcomes)

f_ctx_increment_cancelled(signalFamilyAggregateStats _agg) =>
    signalFamilyAggregateStats.new(
         _agg.signal_id, _agg.occurrence_count, _agg.long_count, _agg.short_count, _agg.favorable_count, _agg.neutral_count, _agg.unfavorable_count,
         _agg.avg_context_fit, _agg.avg_tradeability, _agg.avg_confidence,
         _agg.resolved_count, _agg.win_1r_count, _agg.win_2r_count, _agg.loss_count, _agg.timeout_count, _agg.avg_mae_atr, _agg.avg_mfe_atr,
         _agg.opportunity_count, _agg.filled_count, _agg.unfilled_count, _agg.cancelled_count + 1, _agg.ambiguous_count, _agg.stop_count, _agg.t1_hit_count, _agg.t2_hit_count,
         _agg.high_outcomes, _agg.medium_outcomes, _agg.low_outcomes)

f_ctx_increment_filled(signalFamilyAggregateStats _agg) =>
    signalFamilyAggregateStats.new(
         _agg.signal_id, _agg.occurrence_count, _agg.long_count, _agg.short_count, _agg.favorable_count, _agg.neutral_count, _agg.unfavorable_count,
         _agg.avg_context_fit, _agg.avg_tradeability, _agg.avg_confidence,
         _agg.resolved_count, _agg.win_1r_count, _agg.win_2r_count, _agg.loss_count, _agg.timeout_count, _agg.avg_mae_atr, _agg.avg_mfe_atr,
         _agg.opportunity_count, _agg.filled_count + 1, _agg.unfilled_count, _agg.cancelled_count, _agg.ambiguous_count, _agg.stop_count, _agg.t1_hit_count, _agg.t2_hit_count,
         _agg.high_outcomes, _agg.medium_outcomes, _agg.low_outcomes)

f_update_quality_outcomes(qualityOutcomeStats _bucket, signalEventRecord _event) =>
    _count = _bucket.resolved_count + 1
    qualityOutcomeStats.new(
         _count,
         _bucket.t1_hit_count + (_event.outcome.hit_t1 ? 1 : 0),
         _bucket.one_r_hit_count + (_event.outcome.hit_1r ? 1 : 0),
         _bucket.two_r_hit_count + (_event.outcome.hit_2r ? 1 : 0),
         _bucket.stop_count + (_event.outcome.invalidated ? 1 : 0),
         f_ctx_update_running_average(_bucket.avg_mae_atr, _bucket.resolved_count, _event.outcome.mae_atr),
         f_ctx_update_running_average(_bucket.avg_mfe_atr, _bucket.resolved_count, _event.outcome.mfe_atr))

f_ctx_update_family_outcome_aggregate(signalFamilyAggregateStats _agg, signalEventRecord _event) =>
    _filled = _event.outcome.filled
    _ambiguous = _event.outcome.ambiguous
    // Timeout is reported separately and, like ambiguous/cancelled/unfilled,
    // is excluded from unequivocal win/loss performance.
    _eligible = _filled and not _ambiguous and not _event.outcome.timed_out
    _high = _eligible and f_event_is_favorable(_event) ? f_update_quality_outcomes(_agg.high_outcomes, _event) : _agg.high_outcomes
    _medium = _eligible and f_event_is_neutral(_event) ? f_update_quality_outcomes(_agg.medium_outcomes, _event) : _agg.medium_outcomes
    _low = _eligible and f_event_is_unfavorable(_event) ? f_update_quality_outcomes(_agg.low_outcomes, _event) : _agg.low_outcomes
    _perf_count = _agg.resolved_count - _agg.ambiguous_count - _agg.timeout_count
    signalFamilyAggregateStats.new(
         _agg.signal_id, _agg.occurrence_count, _agg.long_count, _agg.short_count, _agg.favorable_count, _agg.neutral_count, _agg.unfavorable_count,
         _agg.avg_context_fit, _agg.avg_tradeability, _agg.avg_confidence,
         _agg.resolved_count + (_filled ? 1 : 0),
         _agg.win_1r_count + (_eligible and _event.outcome.hit_1r ? 1 : 0),
         _agg.win_2r_count + (_eligible and _event.outcome.hit_2r ? 1 : 0),
         _agg.loss_count + (_eligible and _event.outcome.invalidated ? 1 : 0),
         _agg.timeout_count + (_filled and not _ambiguous and _event.outcome.timed_out ? 1 : 0),
         _eligible ? f_ctx_update_running_average(_agg.avg_mae_atr, _perf_count, _event.outcome.mae_atr) : _agg.avg_mae_atr,
         _eligible ? f_ctx_update_running_average(_agg.avg_mfe_atr, _perf_count, _event.outcome.mfe_atr) : _agg.avg_mfe_atr,
         _agg.opportunity_count, _agg.filled_count, _agg.unfilled_count + (_event.outcome.expired_unfilled ? 1 : 0), _agg.cancelled_count,
         _agg.ambiguous_count + (_ambiguous ? 1 : 0), _agg.stop_count + (_eligible and _event.outcome.invalidated ? 1 : 0),
         _agg.t1_hit_count + (_eligible and _event.outcome.hit_t1 ? 1 : 0), _agg.t2_hit_count + (_eligible and _event.outcome.hit_t2 ? 1 : 0), _high, _medium, _low)

f_ctx_process_active_events(array<signalEventRecord> _active, array<signalEventRecord> _history, signalFamilyAggregateStats _agg, float _high, float _low, int _bar_index, int _max_history) =>
    _next_agg = _agg
    _idx = array.size(_active) - 1
    while _idx >= 0
        _event = array.get(_active, _idx)
        _updated = f_ctx_update_single_event(_event, _high, _low, _bar_index)
        // Count the lifecycle transition exactly once, while the trade is active.
        if not _event.outcome.filled and _updated.outcome.filled
            _next_agg := f_ctx_increment_filled(_next_agg)
        if _updated.resolved
            array.remove(_active, _idx)
            f_ctx_push_bounded_history(_history, f_ctx_archive_event(_updated), _max_history)
            // Every finalized opportunity is classified; only eligible filled,
            // unambiguous trades enter performance rates inside the aggregate.
            _next_agg := f_ctx_update_family_outcome_aggregate(_next_agg, _updated)
        else
            array.set(_active, _idx, _updated)
        _idx -= 1
    _next_agg

f_signal_quality_row_name(int _sig_id) =>
    _sig_id == SIGSTAT_B1S1 ? 'B1/S1' : _sig_id == SIGSTAT_IBIS ? 'IB/IS' : _sig_id == SIGSTAT_CBCS ? 'CB/CS' : 'N/A'

int MIN_STABILITY_SAMPLE = 20

f_safe_pct(float _num, float _den, float _fallback) =>
    _den > 0 ? _num * 100.0 / _den : _fallback

f_clamp_0_100(float _value) =>
    math.max(0.0, math.min(100.0, _value))

f_stability_component_or_neutral(float _value) =>
    na(_value) ? 50.0 : f_clamp_0_100(_value)

f_calc_signal_stability_bucket(float _stability_score, int _resolved_count) =>
    _resolved_count < MIN_STABILITY_SAMPLE ? 'n/a' : _stability_score >= 65 ? 'High' : _stability_score >= 50 ? 'Mid' : 'Low'

f_calc_context_signal_stability_score(signalFamilyAggregateStats _agg) =>
    _total_events = _agg.favorable_count + _agg.unfavorable_count + _agg.neutral_count
    _favorable_share = f_safe_pct(_agg.favorable_count, _total_events, 50.0)
    _unfavorable_share = f_safe_pct(_agg.unfavorable_count, _total_events, 50.0)
    _neutral_share = f_safe_pct(_agg.neutral_count, _total_events, 0.0)
    _quality_edge = f_clamp_0_100(50.0 + 1.25 * (_favorable_share - _unfavorable_share) - 0.20 * _neutral_share)
    // Model stability intentionally contains no ex-post outcome component.
    f_clamp_0_100(0.35 * f_stability_component_or_neutral(_agg.avg_context_fit) + 0.30 * f_stability_component_or_neutral(_agg.avg_confidence) + 0.20 * f_stability_component_or_neutral(_agg.avg_tradeability) + 0.15 * _quality_edge)

f_calc_realized_performance(signalFamilyAggregateStats _agg) =>
    _performance_resolved_count = _agg.resolved_count - _agg.ambiguous_count - _agg.timeout_count
    _performance_resolved_count > 0 ? f_clamp_0_100(0.60 * f_safe_pct(_agg.win_1r_count, _performance_resolved_count, 0.0) + 0.40 * (100.0 - f_safe_pct(_agg.loss_count, _performance_resolved_count, 0.0))) : na

f_stats_panel_col_width(int _col) =>
    // Keep adjacent headings visually separated; proportional fonts need more
    // room than their raw character counts suggest.
    _col == 0 ? 3.8 : _col >= 1 and _col <= 5 ? 2.5 : _col == 6 ? 3.8 : _col == 7 ? 4.4 : _col == 8 ? 3.8 : 5.0

f_render_signal_quality_headers(table _panel, string _size) =>
    _labels = array.from('Signal', 'Long', 'Short', 'High', 'Low', 'Med', 'Context', 'Confidence', 'Realized', 'Model Stability')
    for _col = 0 to 9
        table.cell(_panel, _col, 0, array.get(_labels, _col), text_color = color.white, text_size = _size, width = f_stats_panel_col_width(_col), text_halign = text.align_center)

f_ctx_panel_avg_text(float _value, int _count) =>
    _count > 0 ? f_safe_score_int_text(_value) : 'n/a'

f_ctx_last_event(array<signalEventRecord> _active, array<signalEventRecord> _history) =>
    _active_size = array.size(_active)
    _history_size = array.size(_history)
    _use_active = _active_size > 0 and (_history_size == 0 or array.get(_active, _active_size - 1).start_bar_index >= array.get(_history, _history_size - 1).start_bar_index)
    _use_active ? array.get(_active, _active_size - 1) : _history_size > 0 ? array.get(_history, _history_size - 1) : f_init_signal_event_record(SIGSTAT_B1S1)

f_ctx_last_event_label(signalEventRecord _event) =>
    not na(_event.start_bar_index) ? 'Last Event: ' + f_signal_quality_row_name(_event.family_id) + ' ' + f_quality_class_text(_event.assessment.quality_class_id) + ' | ' + _event.assessment.reason_text_short : 'Last family: n/a'

f_ctx_latest_of_three(signalEventRecord _a, signalEventRecord _b, signalEventRecord _c) =>
    _ab = na(_a.start_bar_index) ? _b : na(_b.start_bar_index) ? _a : _a.start_bar_index >= _b.start_bar_index ? _a : _b
    na(_ab.start_bar_index) ? _c : na(_c.start_bar_index) ? _ab : _ab.start_bar_index >= _c.start_bar_index ? _ab : _c

f_render_ctx_panel_row(table _panel, int _row, signalFamilyAggregateStats _agg, string _size) =>
    _performance_resolved_count = _agg.resolved_count - _agg.ambiguous_count - _agg.timeout_count
    _values = array.from(f_signal_quality_row_name(_agg.signal_id), str.tostring(_agg.long_count), str.tostring(_agg.short_count), str.tostring(_agg.favorable_count), str.tostring(_agg.unfavorable_count), str.tostring(_agg.neutral_count), f_ctx_panel_avg_text(_agg.avg_context_fit, _agg.occurrence_count), f_ctx_panel_avg_text(_agg.avg_confidence, _agg.occurrence_count), f_ctx_panel_avg_text(f_calc_realized_performance(_agg), _performance_resolved_count), f_calc_signal_stability_bucket(f_calc_context_signal_stability_score(_agg), _agg.resolved_count))
    _colors = array.from(color.silver, color.silver, color.silver, color.lime, color.red, color.yellow, color.silver, color.silver, color.silver, color.silver)
    for _col = 0 to 9
        table.cell(_panel, _col, _row, array.get(_values, _col), text_color = array.get(_colors, _col), text_size = _size, width = f_stats_panel_col_width(_col), text_halign = _col == 0 ? text.align_left : text.align_center)

f_quality_bucket_text(string _name, qualityOutcomeStats _bucket) =>
    _n = _bucket.resolved_count
    _n < 5 ? _name + ': n/a' : _name + ': N=' + str.tostring(_n) + ' · T1 ' + str.tostring(math.round(f_ctx_safe_rate(_bucket.t1_hit_count, _n))) + ' · 1R ' + str.tostring(math.round(f_ctx_safe_rate(_bucket.one_r_hit_count, _n))) + ' · 2R ' + str.tostring(math.round(f_ctx_safe_rate(_bucket.two_r_hit_count, _n))) + ' · Stop ' + str.tostring(math.round(f_ctx_safe_rate(_bucket.stop_count, _n))) + ' · MAE/MFE ' + str.tostring(_bucket.avg_mae_atr, '#.##') + '/' + str.tostring(_bucket.avg_mfe_atr, '#.##')

f_quality_calibration_text(signalFamilyAggregateStats _agg) =>
    f_signal_quality_row_name(_agg.signal_id) + ' | ' + f_quality_bucket_text('High', _agg.high_outcomes) + ' | ' + f_quality_bucket_text('Med', _agg.medium_outcomes) + ' | ' + f_quality_bucket_text('Low', _agg.low_outcomes)

f_render_signal_quality_panel(signalFamilyAggregateStats _ctx_b1s1, signalFamilyAggregateStats _ctx_ibis, signalFamilyAggregateStats _ctx_cbcs, array<signalEventRecord> _ctx_b1s1_active, array<signalEventRecord> _ctx_b1s1_history, array<signalEventRecord> _ctx_ibis_active, array<signalEventRecord> _ctx_ibis_history, array<signalEventRecord> _ctx_cbcs_active, array<signalEventRecord> _ctx_cbcs_history, string _stats_pos_input) =>
    var table stats_panel = na
    var string _stats_pos_prev = ''
    _cols = 10
    _rows = 9
    if _stats_pos_input == 'None'
        if not na(stats_panel)
            table.delete(stats_panel)
            stats_panel := na
        _stats_pos_prev := ''
        0
    else
        _stats_pos = f_pos_from_input(_stats_pos_input)
        if na(stats_panel) or _stats_pos_prev != _stats_pos_input
            if not na(stats_panel)
                table.delete(stats_panel)
            stats_panel := table.new(_stats_pos, _cols, _rows, bgcolor = color.new(color.black, 70), frame_width = 1, frame_color = color.new(color.white, 50))
            _stats_pos_prev := _stats_pos_input
        _stats_text_size = f_text_size_from_input(panel_font_stats)
        _last_event = f_ctx_latest_of_three(f_ctx_last_event(_ctx_b1s1_active, _ctx_b1s1_history), f_ctx_last_event(_ctx_ibis_active, _ctx_ibis_history), f_ctx_last_event(_ctx_cbcs_active, _ctx_cbcs_history))
        f_render_signal_quality_headers(stats_panel, _stats_text_size)
        f_render_ctx_panel_row(stats_panel, 1, _ctx_b1s1, _stats_text_size)
        f_render_ctx_panel_row(stats_panel, 2, _ctx_ibis, _stats_text_size)
        f_render_ctx_panel_row(stats_panel, 3, _ctx_cbcs, _stats_text_size)
        table.cell(stats_panel, 0, 4, f_quality_calibration_text(_ctx_b1s1), text_color = color.silver, text_size = _stats_text_size, text_halign = text.align_left)
        table.merge_cells(stats_panel, 0, 4, 9, 4)
        table.cell(stats_panel, 0, 5, f_quality_calibration_text(_ctx_ibis), text_color = color.silver, text_size = _stats_text_size, text_halign = text.align_left)
        table.merge_cells(stats_panel, 0, 5, 9, 5)
        table.cell(stats_panel, 0, 6, f_quality_calibration_text(_ctx_cbcs), text_color = color.silver, text_size = _stats_text_size, text_halign = text.align_left)
        table.merge_cells(stats_panel, 0, 6, 9, 6)
        _last_sig_summary = 'Last Signal: ' + f_signal_quality_row_name(_last_event.family_id) + ' | ' + (_last_event.direction == 1 ? 'Long' : _last_event.direction == -1 ? 'Short' : 'n/a') + ' | ' + f_quality_class_text(_last_event.assessment.quality_class_id) + ' | Ctx/Trade ' + f_safe_score_int_text(_last_event.assessment.context_fit) + '/' + f_safe_score_int_text(_last_event.assessment.tradeability) + ' | Loc ' + f_safe_score_int_text(_last_event.assessment.location_quality_score) + ' | ' + (not na(_last_event.start_bar_index) ? f_signal_role_text(_last_event.assessment.signal_role_id) : 'n/a')
        table.cell(stats_panel, 0, 7, _last_sig_summary, text_color = color.new(color.silver, 20), text_size = _stats_text_size, text_halign = text.align_left)
        table.merge_cells(stats_panel, 0, 7, 9, 7)
        table.cell(stats_panel, 0, 8, f_ctx_last_event_label(_last_event), text_color = color.new(color.silver, 20), text_size = _stats_text_size, text_halign = text.align_left)
        table.merge_cells(stats_panel, 0, 8, 9, 8)
        0

f_ichi_sig_state(_mode) =>
    f_ichi_bg_logic(_mode)
f_bg_color_from_state(int _bg_state, bool _sig_only) =>
    _bg_state == 2 ? color_yellow : _sig_only ? na : _bg_state == 1 ? color_green : _bg_state == -1 ? color_red : na

f_bg_arrow_buy(int _bg_state) =>
    _bg_state == 1 and _bg_state[1] != 1

f_bg_arrow_sell(int _bg_state) =>
    _bg_state == -1 and _bg_state[1] != -1
_tf_req = bg_sig_tf == 'Current' ? timeframe.period : bg_sig_tf
f_engine_mtf_value(int _value, bool _use_closed) =>
    _use_closed ? _value[1] : _value

bool bg_sig_use_closed = evaluation_mode == 'Fully Confirmed HTF' and timeframe.in_seconds(_tf_req) > timeframe.in_seconds(timeframe.period)
bg_sig_state = X_opt_bg != '---' ? request.security(syminfo.tickerid, _tf_req, f_engine_mtf_value(f_ichi_bg_logic(X_opt_bg), bg_sig_use_closed), lookahead = barmerge.lookahead_off) : 0
bg_render_color = f_bg_color_from_state(bg_sig_state, X_opt_bg_sig_only)
bg_arrow_buy_raw = f_bg_arrow_buy(bg_sig_state)
bg_arrow_sell_raw = f_bg_arrow_sell(bg_sig_state)
bg_render_buy = X_opt_bg_sig_only and bg_arrow_buy_raw
bg_render_sell = X_opt_bg_sig_only and bg_arrow_sell_raw

f_get_weight_by_id(int _sig_id) =>
    _sig_id == SIG_PRICE_X_CLOUD or _sig_id == SIG_CHIKOU_X_CLOUD or _sig_id == SIG_TENKAN_X_CLOUD or _sig_id == SIG_KIJUN_X_CLOUD or _sig_id == SIG_CLOUD_FLIP or _sig_id == SIG_B1S1 ? 2.0 : 1.0

f_calc_slot_by_id(int _sig_id, ichiContext _ctx) =>
    _res = 0.0
    _fractal_state = f_fractal_flip_logic(fr_period)
    _core_state = f_eval_signal_core(_sig_id, _ctx, close, high, low, 0, 0)
    if _sig_id != SIG_NONE and not f_signal_is_pass(_sig_id)
        int _s = _sig_id == SIG_FRACTAL ? _fractal_state : _core_state
        float _w = pic_weight_mode == 'Weighted' ? f_get_weight_by_id(_sig_id) : 1.0
        if _s == 1
            _res := _w
            _res
        else if _s == -1
            _res := -_w
            _res
    _res

f_pic_logic_v2(_extra_bias) =>
    bias_total = pic_bias_manual + _extra_bias
    float score = 0

    _ctx = f_ichi_ctx()

    array<int> _pic_sig_ids = array.from(SIG_PRICE_X_TENKAN, SIG_PRICE_X_KIJUN, SIG_PRICE_X_CLOUD, SIG_CHIKOU_X_PRICE, SIG_CHIKOU_X_TENKAN, SIG_CHIKOU_X_KIJUN, SIG_CHIKOU_X_CLOUD, SIG_TENKAN_X_KIJUN, SIG_TENKAN_X_CLOUD, SIG_KIJUN_X_CLOUD, SIG_CLOUD_FLIP, SIG_B1S1, SIG_PASS_THIN_AT_PRICE, SIG_PASS_NORMAL_AT_PRICE, SIG_PASS_THICK_AT_PRICE, SIG_PASS_THIN_AHEAD, SIG_PASS_NORMAL_AHEAD, SIG_PASS_THICK_AHEAD, SIG_PRICE_X_SA, SIG_TENKAN_X_SA, SIG_KIJUN_X_SA, SIG_CHIKOU_X_SA, SIG_PRICE_X_SB, SIG_TENKAN_X_SB, SIG_KIJUN_X_SB, SIG_CHIKOU_X_SB)
    for i = 0 to array.size(_pic_sig_ids) - 1 by 1
        int _sig_id = array.get(_pic_sig_ids, i)
        score := score + f_calc_slot_by_id(_sig_id, _ctx)
    long_thr_adj = pic_long_thr - bias_total
    short_thr_adj = pic_short_thr + bias_total
    if long_thr_adj < 0
        long_thr_adj := 0
        long_thr_adj
    if short_thr_adj < 0
        short_thr_adj := 0
        short_thr_adj
    int _final_sig = 0
    if score >= long_thr_adj + pic_gap
        _final_sig := 1
        _final_sig
    else if score <= -(short_thr_adj + pic_gap)
        _final_sig := -1
        _final_sig

    _final_sig

