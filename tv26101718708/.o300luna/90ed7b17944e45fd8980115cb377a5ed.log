    while array.size(_history) > _max_size
        array.shift(_history)

f_ctx_archive_event(signalEventRecord _event) =>
    _o = _event.outcome
    _archived = signalOutcomeState.new(false, true, _o.lifecycle_state, _o.filled, _o.entry_type, _o.order_price, _o.fill_price, _o.stop_price, _o.target1_price, _o.target2_price, _o.expiry_bar_index, _o.hit_half_r, _o.hit_t1, _o.hit_t2, _o.hit_1r, _o.hit_2r, _o.invalidated, _o.timed_out, _o.ambiguous, _o.expired_unfilled, _o.mae_atr, _o.mfe_atr)
