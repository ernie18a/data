plotshape(fractals_plot ? dn_fractal : na, style = shape.triangledown, location = location.belowbar, offset = -fr_period, color = color.new(color.white, 30))
f_fractal_logic(_per) =>
    _up = ta.pivothigh(_per, _per)
    _dn = ta.pivotlow(_per, _per)
    _v_up = ta.valuewhen(not na(_up), high[_per], 0)
    _v_dn = ta.valuewhen(not na(_dn), low[_per], 0)

    _res = 0
    if high > _v_up
        _res := 1
        _res
    else if low < _v_dn
        _res := -1
        _res
    else
        _res := 0 // Neutral/No Break
        _res
    _res

