bool marker_cs = comb_enable and cb_short_canonical_fire

plotshape(marker_b1, color = color.new(color.lime, 0), textcolor = color.new(color.lime, 0), style = shape.arrowup, location = location.belowbar, size = size.small, text = 'B1')
plotshape(marker_s1, color = color.new(color.red, 0), textcolor = color.new(color.red, 0), style = shape.arrowdown, location = location.abovebar, size = size.small, text = 'S1')
plotshape(marker_ib, color = color.new(color.lime, 0), textcolor = color.new(color.lime, 0), style = shape.arrowup, location = location.belowbar, size = size.small, text = 'IB')
