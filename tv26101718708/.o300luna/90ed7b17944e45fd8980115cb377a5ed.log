color c_bg_col = f_comb_bg_color(comb_enable, comb_bg_plot, c_buy, c_sell, pass_selected, pass_ok_all, comb_grad_enable, dir_count, dir_score)

signal_bg_color = comb_enable and comb_bg_plot and not na(c_bg_col) ? c_bg_col : not na(pic_signal_bg_color) ? pic_signal_bg_color : bg_render_color
