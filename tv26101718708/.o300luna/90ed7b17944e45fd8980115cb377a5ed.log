            table.cell(decision_panel, 1, 11, f_panel_pad_center(str.tostring(panel_snapshot.clarity_score_i), _decision_value_min_chars), text_color = color.silver, text_size = _decision_text_size, width = _decision_value_w, text_halign = text.align_center)
            _playbook_engine_text = f_panel_display_playbook(_playbook_panel_text, panel_snapshot.playbook_engine_state_text)
            table.cell(decision_panel, 1, 12, f_panel_limit_text(_playbook_engine_text, 16), text_color = panel_snapshot.playbook_actionable ? color.lime : color.silver, text_size = _decision_text_size, width = _decision_value_w, text_halign = text.align_left)
            table.cell(decision_panel, 1, 13, f_panel_limit_text(panel_snapshot.preset_name, 16), text_color = color.silver, text_size = _decision_text_size, width = _decision_value_w, text_halign = text.align_left)
