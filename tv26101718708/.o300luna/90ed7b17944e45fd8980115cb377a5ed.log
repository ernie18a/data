f_compute_projection_sl(int _dir, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low) =>
    float _sl_price = na
    int _anchor_offset = 0

    if _dir == 1
        if _sl_mode == 'Current Bar'
            _sl_price := low
            _anchor_offset := 0
        else if _sl_mode == 'One Bar' and bar_index >= 1
            _use_curr = low <= low[1]
            _sl_price := _use_curr ? low : low[1]
            _anchor_offset := _use_curr ? 0 : 1
        else if _sl_mode == 'Two Bars' and bar_index >= 2
            _use_curr = low <= low[1] and low <= low[2]
            _use_prev = not _use_curr and low[1] <= low[2]
            _sl_price := _use_curr ? low : _use_prev ? low[1] : low[2]
            _anchor_offset := _use_curr ? 0 : _use_prev ? 1 : 2
        else if _sl_mode == 'Cloud H/L'
            _sl_price := _kumo_low
        else if _sl_mode == 'Kijun'
            _sl_price := _kijun
        else if _sl_mode == '1x ATR14'
            _sl_price := low - _atr
        else if _sl_mode == '2x ATR14'
            _sl_price := low - _atr * 2.0
    else if _dir == -1
        if _sl_mode == 'Current Bar'
            _sl_price := high
            _anchor_offset := 0
        else if _sl_mode == 'One Bar' and bar_index >= 1
            _use_curr = high >= high[1]
            _sl_price := _use_curr ? high : high[1]
            _anchor_offset := _use_curr ? 0 : 1
        else if _sl_mode == 'Two Bars' and bar_index >= 2
            _use_curr = high >= high[1] and high >= high[2]
            _use_prev = not _use_curr and high[1] >= high[2]
            _sl_price := _use_curr ? high : _use_prev ? high[1] : high[2]
            _anchor_offset := _use_curr ? 0 : _use_prev ? 1 : 2
        else if _sl_mode == 'Cloud H/L'
            _sl_price := _kumo_high
        else if _sl_mode == 'Kijun'
            _sl_price := _kijun
        else if _sl_mode == '1x ATR14'
            _sl_price := high + _atr
        else if _sl_mode == '2x ATR14'
            _sl_price := high + _atr * 2.0

    if na(_sl_price)
        _sl_price := _dir == 1 ? low : _dir == -1 ? high : close
        _anchor_offset := 0

    _anchor_offset := math.max(0, _anchor_offset)
    [_sl_price, _anchor_offset]

f_compute_projection_levels(int _dir, string _sl_mode, float _atr, float _kijun, float _kumo_high, float _kumo_low, float _entry) =>
    [_sl_price, _anchor_offset] = f_compute_projection_sl(_dir, _sl_mode, _atr, _kijun, _kumo_high, _kumo_low)
    _risk = math.max(math.abs(_entry - _sl_price), syminfo.mintick)
    _r1 = _entry + _risk * _dir
    _r2 = _entry + _risk * 2.0 * _dir
    _r3 = _entry + _risk * 3.0 * _dir
    [_sl_price, _anchor_offset, _risk, _r1, _r2, _r3]

