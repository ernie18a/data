// Cached prior-bar extremes for every touch test below (alert stream, alert
// conditions, S/D and confluence loops).
_lPrev = _l[1]
_hPrev = _h[1]
//#endregion

//#region Prior Period Levels
var line _pdhLine  = na
var line _pdlLine  = na
var label _pdhLbl  = na
var label _pdlLbl  = na
var line _pwhlLine = na
var line _pwllLine = na
var label _pwhlLbl = na
var label _pwllLbl = na
var line _pmhlLine = na
var line _pmllLine = na
var label _pmhlLbl = na
var label _pmllLbl = na

// Prior-period highs/lows are pulled straight from the daily/weekly/monthly series
// rather than accumulated from chart bars. Two reasons:
//   • Timeframe-independent — the prior day/week/month H/L reads identically on a 1m
//     chart and a 4H chart. Bar-by-bar bucketing broke on timeframes coarser than the
//     period (e.g. on a weekly chart every bar is a new "day", so the old PDH was
//     really the prior week's high).
//   • Always available — bucketing needs a full completed prior period inside the
//     processed-bar window (calc_bars_count = 500), so on low timeframes a prior
//     week/month often didn't exist yet and the levels simply never drew.
// high[1]/low[1] with lookahead_on returns the PRIOR COMPLETED period only — no repaint.
// RTH-only forces the symbol's regular session; otherwise the chart's default session.
_priorTicker = prior_rth_only ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
[_priorDayH, _priorDayL] = if show_pdhl
    request.security(_priorTicker, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]
[_priorWeekH, _priorWeekL] = if show_pwhl
    request.security(_priorTicker, 'W', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]
[_priorMonthH, _priorMonthL] = if show_pmhl
    request.security(_priorTicker, 'M', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]

_priorStyle = prior_line_style == 'Solid' ? line.style_solid : prior_line_style == 'Dotted' ? line.style_dotted : line.style_dashed

updatePriorLine(line _ln, bool _show, float _price, color _col) =>
    line _out = _ln
    if _show and not na(_price)
        if na(_out)
            _out := line.new(bar_index, _price, bar_index + prior_label_offset, _price, extend = extend.left, style = _priorStyle, color = _col, width = 1)
        else
            line.set_xy1(_out, bar_index, _price)
            line.set_xy2(_out, bar_index + prior_label_offset, _price)
            line.set_color(_out, _col)
            line.set_style(_out, _priorStyle)
            line.set_extend(_out, extend.left)
    else
        line.delete(_out)
        _out := na
    _out

updatePriorLabel(label _lb, bool _show, float _price, color _col, string _txt) =>
    label _out = _lb
    if _show and not na(_price) and show_prior_labels
        if na(_out)
            _out := label.new(bar_index + prior_label_offset, _price, _txt, xloc.bar_index, yloc.price, color.new(_col, 85), label.style_label_left, _col, size.tiny)
        else
            label.set_xy(_out, bar_index + prior_label_offset, _price)
    else
        label.delete(_out)
        _out := na
    _out

_pdhLine  := updatePriorLine(_pdhLine,  show_pdhl, _priorDayH,   pdhl_color)
_pdlLine  := updatePriorLine(_pdlLine,  show_pdhl, _priorDayL,   pdhl_color)
_pwhlLine := updatePriorLine(_pwhlLine, show_pwhl, _priorWeekH,  pwhl_color)
_pwllLine := updatePriorLine(_pwllLine, show_pwhl, _priorWeekL,  pwhl_color)
_pmhlLine := updatePriorLine(_pmhlLine, show_pmhl, _priorMonthH, pmhl_color)
_pmllLine := updatePriorLine(_pmllLine, show_pmhl, _priorMonthL, pmhl_color)

_pdhLbl  := updatePriorLabel(_pdhLbl,  show_pdhl, _priorDayH,   pdhl_color, 'PDH')
_pdlLbl  := updatePriorLabel(_pdlLbl,  show_pdhl, _priorDayL,   pdhl_color, 'PDL')
_pwhlLbl := updatePriorLabel(_pwhlLbl, show_pwhl, _priorWeekH,  pwhl_color, 'PWH')
_pwllLbl := updatePriorLabel(_pwllLbl, show_pwhl, _priorWeekL,  pwhl_color, 'PWL')
_pmhlLbl := updatePriorLabel(_pmhlLbl, show_pmhl, _priorMonthH, pmhl_color, 'PMH')
_pmllLbl := updatePriorLabel(_pmllLbl, show_pmhl, _priorMonthL, pmhl_color, 'PML')
//#endregion

//#region Supply / Demand Zones
var array<box> _demandBoxes = array.new_box()
var array<box> _supplyBoxes = array.new_box()
var array<int> _demandRetests = array.new_int()
var array<int> _supplyRetests = array.new_int()
var array<bool> _demandVolFlags = array.new_bool()
var array<bool> _supplyVolFlags = array.new_bool()
// Per-zone retest latch: true while price sits outside the zone's proximal edge.
// A retest is only counted on a fresh entry (outside -> inside), so a single
// continuous penetration can't be miscounted as several retests as the edge shrinks.
var array<bool> _demandOutside = array.new_bool()
var array<bool> _supplyOutside = array.new_bool()

_tr = math.max(_h - _l, math.max(math.abs(_h - _c[1]), math.abs(_l - _c[1])))
// ATR / structure lookups are only consumed when S/D is enabled. Gate the
// stateful ta.rma / ta.highest / ta.lowest calls behind that flag so they
// don't run every bar when the user has S/D zones turned off.
sd_atr = _sdEnabled ? ta.rma(_tr, 14) : na
_bodySize = math.abs(_c - _o)
_recentHigh = _sdEnabled ? ta.highest(_h, sd_lookback)[1] : na
_recentLow = _sdEnabled ? ta.lowest(_l, sd_lookback)[1] : na
_sdConfirmOk = not sd_confirm or barstate.isconfirmed
_isImpulseUp = _sdEnabled and _sdConfirmOk and _bodySize > sd_atr * sd_atr_mult and _c > _o and (not sd_bos or _c > _recentHigh)
_isImpulseDown = _sdEnabled and _sdConfirmOk and _bodySize > sd_atr * sd_atr_mult and _c < _o and (not sd_bos or _c < _recentLow)
_sdHighVol = vol_enhance_on and volume > vol_sma

if not _sdEnabled
    if array.size(_demandBoxes) > 0
        for i = array.size(_demandBoxes) - 1 to 0 by 1
            box.delete(array.remove(_demandBoxes, i))
            array.remove(_demandRetests, i)
            array.remove(_demandVolFlags, i)
            array.remove(_demandOutside, i)
    if array.size(_supplyBoxes) > 0
        for i = array.size(_supplyBoxes) - 1 to 0 by 1
            box.delete(array.remove(_supplyBoxes, i))
            array.remove(_supplyRetests, i)
            array.remove(_supplyVolFlags, i)
            array.remove(_supplyOutside, i)

if _sdEnabled
    // Demand zone: order block — last bearish candle before the impulse up
    if _isImpulseUp
        _zoneHigh = 0.0
        _zoneLow = 0.0
        _obIdx = bar_index
        for j = 1 to sd_lookback by 1
            if j < bar_index and _c[j] < _o[j]
                _zoneHigh := _h[j]
                _zoneLow := _l[j]
                _obIdx := bar_index - j
                break
        if _zoneHigh > _zoneLow
            // Clamp zone height to ATR multiple
            _maxH = sd_atr * sd_max_height
            if _zoneHigh - _zoneLow > _maxH
                _zoneLow := _zoneHigh - _maxH
            // Same-side overlap: merge into existing zone instead of leaving a sandwich.
            // The existing zone is extended to the union of both, vol flag becomes ★ if either was ★,
            // and we skip pushing a redundant new box.
            bool _dMerged = false
            if array.size(_demandBoxes) > 0
                for k = array.size(_demandBoxes) - 1 to 0 by 1
                    _eBox = array.get(_demandBoxes, k)
                    _eTop = box.get_top(_eBox)
                    _eBot = box.get_bottom(_eBox)
                    _oTop = math.min(_zoneHigh, _eTop)
                    _oBot = math.max(_zoneLow, _eBot)
                    if _oTop > _oBot and (_oTop - _oBot) / math.min(_eTop - _eBot, _zoneHigh - _zoneLow) >= sd_overlap
                        if _dMerged
                            // Already merged into another zone earlier in this pass; remove this duplicate
                            box.delete(array.remove(_demandBoxes, k))
                            array.remove(_demandRetests, k)
                            array.remove(_demandVolFlags, k)
                            array.remove(_demandOutside, k)
                        else
                            _mergedTop = math.max(_eTop, _zoneHigh)
                            _mergedBot = math.min(_eBot, _zoneLow)
                            // Clamp merged height to ATR multiple (anchor at top to preserve recent demand high)
                            if _mergedTop - _mergedBot > _maxH
                                _mergedBot := _mergedTop - _maxH
                            box.set_top(_eBox, _mergedTop)
                            box.set_bottom(_eBox, _mergedBot)
                            _wasVol = array.get(_demandVolFlags, k)
                            _newVolFlag = _wasVol or _sdHighVol
                            array.set(_demandVolFlags, k, _newVolFlag)
                            _dColorM = boostColor(sd_demand_color, _newVolFlag)
                            box.set_bgcolor(_eBox, _dColorM)
                            box.set_border_color(_eBox, _dColorM)
                            box.set_text(_eBox, sd_show_labels ? 'Demand' + (_newVolFlag and show_volume_stars ? ' ★' : '') : '')
                            _zoneHigh := _mergedTop
                            _zoneLow := _mergedBot
                            _dMerged := true
            if not _dMerged
                _dColor = boostColor(sd_demand_color, _sdHighVol)
                _dLabel = sd_show_labels ? 'Demand' + (_sdHighVol and show_volume_stars ? ' ★' : '') : ''
                array.push(_demandBoxes, box.new(_obIdx, _zoneHigh, bar_index + 1, _zoneLow, bgcolor = _dColor, border_color = _dColor, border_style = _borderStyle, text = _dLabel, text_color = _sdLabelTextColor, text_size = size.tiny))
                array.push(_demandRetests, 0)
                array.push(_demandVolFlags, _sdHighVol)
                // Arm the latch only if the impulse candle is fully clear above the zone;
                // otherwise it must rise out and return before the first retest counts.
                array.push(_demandOutside, _l > _zoneHigh)
            // Cross-invalidate: remove supply zones overlapping new demand (skip if old is ★ and new is not)
            if array.size(_supplyBoxes) > 0
                for m = array.size(_supplyBoxes) - 1 to 0 by 1
                    _xBox = array.get(_supplyBoxes, m)
                    _xTop = box.get_top(_xBox)
                    _xBot = box.get_bottom(_xBox)
                    _xOTop = math.min(_zoneHigh, _xTop)
                    _xOBot = math.max(_zoneLow, _xBot)
                    if _xOTop > _xOBot and (_xOTop - _xOBot) / math.min(_xTop - _xBot, _zoneHigh - _zoneLow) > sd_overlap
                        _oldIsVol = array.get(_supplyVolFlags, m)
                        if not _oldIsVol or _sdHighVol
                            box.delete(array.remove(_supplyBoxes, m))
                            array.remove(_supplyRetests, m)
                            array.remove(_supplyVolFlags, m)
                            array.remove(_supplyOutside, m)

    // Supply zone: order block — last bullish candle before the impulse down
    if _isImpulseDown
        _zoneHigh = 0.0
        _zoneLow = 0.0
        _obIdx = bar_index
        for j = 1 to sd_lookback by 1
            if j < bar_index and _c[j] > _o[j]
                _zoneHigh := _h[j]
                _zoneLow := _l[j]
                _obIdx := bar_index - j
                break
        if _zoneHigh > _zoneLow
            // Clamp zone height to ATR multiple
            _maxH = sd_atr * sd_max_height
            if _zoneHigh - _zoneLow > _maxH
                _zoneHigh := _zoneLow + _maxH
            // Same-side overlap: merge into existing zone (see Demand block for rationale).
            bool _sMerged = false
            if array.size(_supplyBoxes) > 0
                for k = array.size(_supplyBoxes) - 1 to 0 by 1
                    _eBox = array.get(_supplyBoxes, k)
                    _eTop = box.get_top(_eBox)
                    _eBot = box.get_bottom(_eBox)
                    _oTop = math.min(_zoneHigh, _eTop)
                    _oBot = math.max(_zoneLow, _eBot)
                    if _oTop > _oBot and (_oTop - _oBot) / math.min(_eTop - _eBot, _zoneHigh - _zoneLow) >= sd_overlap
                        if _sMerged
                            box.delete(array.remove(_supplyBoxes, k))
                            array.remove(_supplyRetests, k)
                            array.remove(_supplyVolFlags, k)
                            array.remove(_supplyOutside, k)
                        else
                            _mergedTop = math.max(_eTop, _zoneHigh)
                            _mergedBot = math.min(_eBot, _zoneLow)
                            // Clamp merged height to ATR multiple (anchor at bottom to preserve recent supply low)
                            if _mergedTop - _mergedBot > _maxH
                                _mergedTop := _mergedBot + _maxH
                            box.set_top(_eBox, _mergedTop)
                            box.set_bottom(_eBox, _mergedBot)
                            _wasVol = array.get(_supplyVolFlags, k)
                            _newVolFlag = _wasVol or _sdHighVol
                            array.set(_supplyVolFlags, k, _newVolFlag)
                            _sColorM = boostColor(sd_supply_color, _newVolFlag)
                            box.set_bgcolor(_eBox, _sColorM)
                            box.set_border_color(_eBox, _sColorM)
                            box.set_text(_eBox, sd_show_labels ? 'Supply' + (_newVolFlag and show_volume_stars ? ' ★' : '') : '')
                            _zoneHigh := _mergedTop
                            _zoneLow := _mergedBot
                            _sMerged := true
            if not _sMerged
                _sColor = boostColor(sd_supply_color, _sdHighVol)
                _sLabel = sd_show_labels ? 'Supply' + (_sdHighVol and show_volume_stars ? ' ★' : '') : ''
                array.push(_supplyBoxes, box.new(_obIdx, _zoneHigh, bar_index + 1, _zoneLow, bgcolor = _sColor, border_color = _sColor, border_style = _borderStyle, text = _sLabel, text_color = _sdLabelTextColor, text_size = size.tiny))
                array.push(_supplyRetests, 0)
                array.push(_supplyVolFlags, _sdHighVol)
                // Arm the latch only if the impulse candle is fully clear below the zone;
                // otherwise it must drop out and return before the first retest counts.
                array.push(_supplyOutside, _h < _zoneLow)
            // Cross-invalidate: remove demand zones overlapping new supply (skip if old is ★ and new is not)
            if array.size(_demandBoxes) > 0
                for m = array.size(_demandBoxes) - 1 to 0 by 1
                    _xBox = array.get(_demandBoxes, m)
                    _xTop = box.get_top(_xBox)
                    _xBot = box.get_bottom(_xBox)
                    _xOTop = math.min(_zoneHigh, _xTop)
                    _xOBot = math.max(_zoneLow, _xBot)
                    if _xOTop > _xOBot and (_xOTop - _xOBot) / math.min(_xTop - _xBot, _zoneHigh - _zoneLow) > sd_overlap
                        _oldIsVol = array.get(_demandVolFlags, m)
                        if not _oldIsVol or _sdHighVol
                            box.delete(array.remove(_demandBoxes, m))
                            array.remove(_demandRetests, m)
                            array.remove(_demandVolFlags, m)
                            array.remove(_demandOutside, m)

    // Enforce max zones per side
    while array.size(_demandBoxes) > sd_max_zones
        box.delete(array.remove(_demandBoxes, 0))
        array.remove(_demandRetests, 0)
        array.remove(_demandVolFlags, 0)
        array.remove(_demandOutside, 0)
    while array.size(_supplyBoxes) > sd_max_zones
        box.delete(array.remove(_supplyBoxes, 0))
        array.remove(_supplyRetests, 0)
        array.remove(_supplyVolFlags, 0)
        array.remove(_supplyOutside, 0)

    // Extend active zones + retest counting
    if array.size(_demandBoxes) > 0
        for i = array.size(_demandBoxes) - 1 to 0 by 1
            _box = array.get(_demandBoxes, i)
            _boxHigh = box.get_top(_box)
            _boxLow = box.get_bottom(_box)
            box.set_right(_box, bar_index + 1)
            if sd_invalidate and _c < _boxLow
                // Broken: a candle closed below the zone bottom — remove it.
                box.delete(array.remove(_demandBoxes, i))
                array.remove(_demandRetests, i)
                array.remove(_demandVolFlags, i)
                array.remove(_demandOutside, i)
            else
                _wasOutside = array.get(_demandOutside, i)
                _probe = sd_retest_close ? _c : _l
                if _wasOutside and _probe <= _boxHigh
                    // Fresh entry from above — count one retest and disarm the latch.
                    array.set(_demandOutside, i, false)
                    _rt = array.get(_demandRetests, i) + 1
                    array.set(_demandRetests, i, _rt)
                    if _rt >= sd_retests
                        box.delete(array.remove(_demandBoxes, i))
                        array.remove(_demandRetests, i)
                        array.remove(_demandVolFlags, i)
                        array.remove(_demandOutside, i)
                    else
                        // Shrink zone — orders at the tested edge are absorbed
                        _shrink = (_boxHigh - _boxLow) / sd_retests
                        box.set_top(_box, _boxHigh - _shrink)
                else if not _wasOutside and _l > _boxHigh
                    // Price cleared fully back above the proximal edge — re-arm for the next retest.
                    array.set(_demandOutside, i, true)

    if array.size(_supplyBoxes) > 0
        for i = array.size(_supplyBoxes) - 1 to 0 by 1
            _box = array.get(_supplyBoxes, i)
            _boxLow = box.get_bottom(_box)
            _boxTop = box.get_top(_box)
            box.set_right(_box, bar_index + 1)
            if sd_invalidate and _c > _boxTop
                // Broken: a candle closed above the zone top — remove it.
                box.delete(array.remove(_supplyBoxes, i))
                array.remove(_supplyRetests, i)
                array.remove(_supplyVolFlags, i)
                array.remove(_supplyOutside, i)
            else
                _wasOutside = array.get(_supplyOutside, i)
                _probe = sd_retest_close ? _c : _h
                if _wasOutside and _probe >= _boxLow
                    // Fresh entry from below — count one retest and disarm the latch.
                    array.set(_supplyOutside, i, false)
                    _rt = array.get(_supplyRetests, i) + 1
                    array.set(_supplyRetests, i, _rt)
                    if _rt >= sd_retests
                        box.delete(array.remove(_supplyBoxes, i))
                        array.remove(_supplyRetests, i)
                        array.remove(_supplyVolFlags, i)
                        array.remove(_supplyOutside, i)
                    else
                        // Shrink zone — orders at the tested edge are absorbed
                        _shrink = (_boxTop - _boxLow) / sd_retests
                        box.set_bottom(_box, _boxLow + _shrink)
                else if not _wasOutside and _h < _boxLow
                    // Price cleared fully back below the proximal edge — re-arm for the next retest.
                    array.set(_supplyOutside, i, true)

// S/D state signature — used by Confluence to detect zone adds/removes/shrinks
_sdSig = array.size(_demandBoxes) * 1e9 + array.size(_supplyBoxes) * 1e6
if array.size(_demandBoxes) > 0
    for i = 0 to array.size(_demandBoxes) - 1 by 1
        _dB = array.get(_demandBoxes, i)
        _sdSig += box.get_top(_dB) + box.get_bottom(_dB)
if array.size(_supplyBoxes) > 0
    for i = 0 to array.size(_supplyBoxes) - 1 by 1
        _sB = array.get(_supplyBoxes, i)
        _sdSig += box.get_top(_sB) + box.get_bottom(_sB)
_sdDirty = na(_sdSig[1]) or _sdSig != _sdSig[1]
//#endregion

//#region Alerts
// All-events alert stream — one pass over the zone registry. Message and id
// formats are identical to the previous per-slot implementation:
//   GP:              "Bull 15 Intraday Golden Pocket Hit on TICKER"
//   Extension:       "Bull 15 Intraday GP Extension Hit on TICKER"
//   Persistent:      "Day GP Hit on TICKER"
//   Persistent ext:  "Bull Day GP Extension Hit on TICKER"
if alert_on
    _zan = array.size(_zBoxes)
    if _zan > 0
        for i = 0 to _zan - 1 by 1
            _zab = array.get(_zBoxes, i)
            _zaTop = box.get_top(_zab)
            _zaBot = box.get_bottom(_zab)
            if (_l <= _zaTop and _lPrev > _zaTop) or (_h >= _zaBot and _hPrev < _zaBot)
                _zak = array.get(_zKind, i)
                _zaDir = array.get(_zDir, i) > 0 ? 'Bull' : 'Bear'
                _zaTf = array.get(_zTf, i)
                _zaProf = array.get(_zProf, i)
                if _zak == 0
                    _zaId = _zaDir + ' ' + _zaTf + ' ' + _zaProf
                    al.rAlert(_zaId + ' Golden Pocket Hit on ' + syminfo.ticker, _zaId)
                else if _zak == 1
                    _zaId = _zaDir + ' ' + _zaTf + ' ' + _zaProf
                    al.rAlert(_zaId + ' GP Extension Hit on ' + syminfo.ticker, _zaId + ' Ext')
                else if _zak == 2
                    al.rAlert(_zaProf + ' GP Hit on ' + syminfo.ticker, _zaProf + ' GP')
                else if _zak == 3
                    al.rAlert(_zaDir + ' ' + _zaProf + ' GP Extension Hit on ' + syminfo.ticker, _zaProf + ' ' + _zaDir + ' GP Ext')
                else
                    al.rAlert(_zaDir + ' FVG Hit on ' + syminfo.ticker, _zaDir + ' FVG ' + str.tostring(i))

    // S/D zone alerts
    if _sdEnabled and array.size(_demandBoxes) > 0
        for i = 0 to array.size(_demandBoxes) - 1 by 1
            _box = array.get(_demandBoxes, i)
            _boxHigh = box.get_top(_box)
            if _l <= _boxHigh and _l[1] > _boxHigh
                al.rAlert('Demand Zone Hit on ' + syminfo.ticker, 'Demand ' + str.tostring(i))
    if _sdEnabled and array.size(_supplyBoxes) > 0
        for i = 0 to array.size(_supplyBoxes) - 1 by 1
            _box = array.get(_supplyBoxes, i)
            _boxLow = box.get_bottom(_box)
            if _h >= _boxLow and _h[1] < _boxLow
                al.rAlert('Supply Zone Hit on ' + syminfo.ticker, 'Supply ' + str.tostring(i))

// ─── Approaching-zone detection ────────────────────────────────────────────
// Fires once when price first comes within `approach_atr` ATR of a zone edge
// while still outside the zone. The detection runs unconditionally every bar
// so the "Approaching Any Zone" alert condition stays history-consistent;
// the stream messages themselves are gated on the Approaching-Zone toggle.
_apprAtr = ta.rma(_tr, 14)
_apprDist = _apprAtr * approach_atr
_apprCPrev = _c[1]
_anyApproach = false
_zpn = array.size(_zBoxes)
if _zpn > 0
    for i = 0 to _zpn - 1 by 1
        _zpb = array.get(_zBoxes, i)
        _zpTop = box.get_top(_zpb)
        _zpBot = box.get_bottom(_zpb)
        _fromAbove = _c > _zpTop and _c - _zpTop <= _apprDist and _apprCPrev - _zpTop > _apprDist
        _fromBelow = _c < _zpBot and _zpBot - _c <= _apprDist and _zpBot - _apprCPrev > _apprDist
        if _fromAbove or _fromBelow
            _anyApproach := true
            if approach_on
                _zpk = array.get(_zKind, i)
                _zpDir = array.get(_zDir, i) > 0 ? 'Bull' : 'Bear'
                _zpTf = array.get(_zTf, i)
                _zpProf = array.get(_zProf, i)
                if _zpk == 0
                    _zpId = _zpDir + ' ' + _zpTf + ' ' + _zpProf
                    al.rAlert(_zpId + ' Golden Pocket Approaching on ' + syminfo.ticker, _zpId + ' Near')
                else if _zpk == 1
                    _zpId = _zpDir + ' ' + _zpTf + ' ' + _zpProf
                    al.rAlert(_zpId + ' GP Extension Approaching on ' + syminfo.ticker, _zpId + ' Ext Near')
                else if _zpk == 2
                    al.rAlert(_zpProf + ' GP Approaching on ' + syminfo.ticker, _zpProf + ' GP Near')
                else if _zpk == 3
                    al.rAlert(_zpDir + ' ' + _zpProf + ' GP Extension Approaching on ' + syminfo.ticker, _zpProf + ' ' + _zpDir + ' GP Ext Near')
                else
                    al.rAlert(_zpDir + ' FVG Approaching on ' + syminfo.ticker, _zpDir + ' FVG Near ' + str.tostring(i))
// S/D zones approach from their proximal edge only (demand from above,
// supply from below — the side price trades on).
if array.size(_demandBoxes) > 0
    for i = 0 to array.size(_demandBoxes) - 1 by 1
        _apb = array.get(_demandBoxes, i)
        _apTop = box.get_top(_apb)
        if _c > _apTop and _c - _apTop <= _apprDist and _apprCPrev - _apTop > _apprDist
            _anyApproach := true
            if approach_on
                al.rAlert('Demand Zone Approaching on ' + syminfo.ticker, 'Demand Near ' + str.tostring(i))
if array.size(_supplyBoxes) > 0
    for i = 0 to array.size(_supplyBoxes) - 1 by 1
        _apb = array.get(_supplyBoxes, i)
        _apBot = box.get_bottom(_apb)
        if _c < _apBot and _apBot - _c <= _apprDist and _apBot - _apprCPrev > _apprDist
            _anyApproach := true
            if approach_on
                al.rAlert('Supply Zone Approaching on ' + syminfo.ticker, 'Supply Near ' + str.tostring(i))
//#endregion

//#region MA Plots
plot(show_ma_fast ? ma_fast : na, 'Fast MA', color = ma_fast_color, linewidth = 1, linestyle = _maFastLineStyle)
plot(show_ma_slow ? ma_slow : na, 'Slow MA', color = ma_slow_color, linewidth = 1, linestyle = _maSlowLineStyle)
//#endregion

//#region Confluence Zones
var array<box> _confluenceBoxes = array.new_box()
var array<string> _confluenceLabels = array.new_string()

// Only rebuild when something actually changed — GP pivot/invalidation, S/D
// add/remove/shrink, or a persistent Day/Week/Month rollover (without the
// persistent flags, confluence involving those boxes went stale after each
// period handover until an unrelated pivot or S/D change forced a rebuild).
_anyGpChg = chart_chg_scalp or chart_chg_intr or chart_chg_swing or chart_chg_quick or tf1_chg_scalp or tf1_chg_intr or tf1_chg_swing or tf1_chg_custom or tf1_chg_quick or tf2_chg_scalp or tf2_chg_intr or tf2_chg_swing or tf2_chg_custom or tf2_chg_quick or tf3_chg_scalp or tf3_chg_intr or tf3_chg_swing or tf3_chg_custom or tf3_chg_quick or _dayChanged or _weekChanged or _monthChanged
_confluenceRebuild = show_confluence and (_anyGpChg or _sdDirty or _fvgDirty)

if not show_confluence
    // Visibility turned off — clear any lingering overlay boxes
    if array.size(_confluenceBoxes) > 0
        for i = array.size(_confluenceBoxes) - 1 to 0 by 1
            box.delete(array.remove(_confluenceBoxes, i))
            array.remove(_confluenceLabels, i)

if _confluenceRebuild
    // Clear previous confluence boxes
    if array.size(_confluenceBoxes) > 0
        for i = array.size(_confluenceBoxes) - 1 to 0 by 1
            box.delete(array.remove(_confluenceBoxes, i))
            array.remove(_confluenceLabels, i)

    // Split the zone registry into GP-kind and Ext-kind lists for the
    // pairwise overlap scans below. Names carry the confluence tokens
    // ('GP', 'Ext', 'Day GP', ...) exactly as before.
    _gpAll = array.new_box()
    _gpAllNames = array.new_string()
    _extAll = array.new_box()
    _extAllNames = array.new_string()
    _zrn = array.size(_zBoxes)
    if _zrn > 0
        for zi = 0 to _zrn - 1 by 1
            _zrk = array.get(_zKind, zi)
            if _zrk == 0 or _zrk == 2
                array.push(_gpAll, array.get(_zBoxes, zi))
                array.push(_gpAllNames, array.get(_zName, zi))
            else
                array.push(_extAll, array.get(_zBoxes, zi))
                array.push(_extAllNames, array.get(_zName, zi))

    // GP vs GP confluence. Skip persistent-vs-persistent pairs (Day/Week/Month
    // main GPs stacking) — those boxes live at fixed right-side positions and
    // their overlap is visually obvious without a separate confluence band.
    if array.size(_gpAll) > 1
        for i = 0 to array.size(_gpAll) - 2 by 1
            _aBox = array.get(_gpAll, i)
            _aTop = box.get_top(_aBox)
            _aBot = box.get_bottom(_aBox)
            _aN = array.get(_gpAllNames, i)
            for j = i + 1 to array.size(_gpAll) - 1 by 1
                _bBox = array.get(_gpAll, j)
                _bTop = box.get_top(_bBox)
                _bBot = box.get_bottom(_bBox)
                _overlapTop = math.min(_aTop, _bTop)
                _overlapBot = math.max(_aBot, _bBot)
                if _overlapTop > _overlapBot
                    _bN = array.get(_gpAllNames, j)
                    if not (isPersistentName(_aN) and isPersistentName(_bN))
                        _overlapLeft = math.max(box.get_left(_aBox), box.get_left(_bBox))
                        _lbl = use_short_labels ? shortToken(_aN) + '+' + shortToken(_bN) : _aN + ' + ' + _bN
                        array.push(_confluenceBoxes, box.new(_overlapLeft, _overlapTop, bar_index + 1, _overlapBot, bgcolor = confluence_color, border_color = confluence_color, border_style = line.style_dotted, text = show_confluence_label ? _lbl : '', text_color = _labelTextColor, text_size = size.tiny))
                        array.push(_confluenceLabels, _lbl)

    // GP vs S/D confluence
    _sdAll = array.new_box()
    if _sdEnabled
        if array.size(_demandBoxes) > 0
            for i = 0 to array.size(_demandBoxes) - 1 by 1
                array.push(_sdAll, array.get(_demandBoxes, i))
        if array.size(_supplyBoxes) > 0
            for i = 0 to array.size(_supplyBoxes) - 1 by 1
                array.push(_sdAll, array.get(_supplyBoxes, i))
    if _sdEnabled and array.size(_gpAll) > 0 and array.size(_sdAll) > 0
        for gi = 0 to array.size(_gpAll) - 1 by 1
            _gBox = array.get(_gpAll, gi)
            _gTop = box.get_top(_gBox)
            _gBot = box.get_bottom(_gBox)
            _gN = array.get(_gpAllNames, gi)
            // Skip persistent (Day/Week/Month) GPs unless the user explicitly enables it.
            // The persistent boxes are large and frequently intersect S/D, which clutters
            // the chart without adding signal.
            if isPersistentName(_gN) and not show_persistent_sd_confluence
                continue
            for si = 0 to array.size(_sdAll) - 1 by 1
                _sBox = array.get(_sdAll, si)
                _sTop = box.get_top(_sBox)
                _sBot = box.get_bottom(_sBox)
                _overlapTop = math.min(_gTop, _sTop)
                _overlapBot = math.max(_gBot, _sBot)
                if _overlapTop > _overlapBot
                    _overlapLeft = math.max(box.get_left(_gBox), box.get_left(_sBox))
                    _lbl = use_short_labels ? shortToken(_gN) + '+S/D' : _gN + ' + S/D'
                    array.push(_confluenceBoxes, box.new(_overlapLeft, _overlapTop, bar_index + 1, _overlapBot, bgcolor = confluence_color, border_color = confluence_color, border_style = line.style_dotted, text = show_confluence_label ? _lbl : '', text_color = _labelTextColor, text_size = size.tiny))
                    array.push(_confluenceLabels, _lbl)

    // Ext vs Ext confluence (extension targets stacking across TFs/profiles).
    // Skip persistent-vs-persistent pairs for the same reason as the GP loop above.
    if array.size(_extAll) > 1
        for i = 0 to array.size(_extAll) - 2 by 1
            _aBox = array.get(_extAll, i)
            _aTop = box.get_top(_aBox)
            _aBot = box.get_bottom(_aBox)
            _aN = array.get(_extAllNames, i)
            for j = i + 1 to array.size(_extAll) - 1 by 1
                _bBox = array.get(_extAll, j)
                _bTop = box.get_top(_bBox)
                _bBot = box.get_bottom(_bBox)
                _overlapTop = math.min(_aTop, _bTop)
                _overlapBot = math.max(_aBot, _bBot)
                if _overlapTop > _overlapBot
                    _bN = array.get(_extAllNames, j)
                    if not (isPersistentName(_aN) and isPersistentName(_bN))
                        _overlapLeft = math.max(box.get_left(_aBox), box.get_left(_bBox))
                        _lbl = use_short_labels ? shortToken(_aN) + '+' + shortToken(_bN) : _aN + ' + ' + _bN
                        array.push(_confluenceBoxes, box.new(_overlapLeft, _overlapTop, bar_index + 1, _overlapBot, bgcolor = confluence_color, border_color = confluence_color, border_style = line.style_dotted, text = show_confluence_label ? _lbl : '', text_color = _labelTextColor, text_size = size.tiny))
                        array.push(_confluenceLabels, _lbl)

    // Ext vs GP confluence (extension target landing inside another GP)
    if array.size(_extAll) > 0 and array.size(_gpAll) > 0
        for ei = 0 to array.size(_extAll) - 1 by 1
            _eBox = array.get(_extAll, ei)
            _eTop = box.get_top(_eBox)
            _eBot = box.get_bottom(_eBox)
            _eN = array.get(_extAllNames, ei)
            for gi = 0 to array.size(_gpAll) - 1 by 1
                _gBox = array.get(_gpAll, gi)
                _gTop = box.get_top(_gBox)
                _gBot = box.get_bottom(_gBox)
                _overlapTop = math.min(_eTop, _gTop)
                _overlapBot = math.max(_eBot, _gBot)
                if _overlapTop > _overlapBot
                    _gN = array.get(_gpAllNames, gi)
                    // Skip persistent-vs-persistent: same-period self-confluence (Day Ext
                    // touching Day GP — just the period's own fib geometry) and cross-period
                    // persistent overlap (Week Ext + Month GP — both right-anchored, overlap
                    // is visually obvious). Ext-into-chart-GP overlaps still register — those
                    // pair a moving zone with a fixed one and carry information.
                    if not (isPersistentName(_eN) and isPersistentName(_gN))
                        _overlapLeft = math.max(box.get_left(_eBox), box.get_left(_gBox))
                        _lbl = use_short_labels ? shortToken(_eN) + '+' + shortToken(_gN) : _eN + ' + ' + _gN
                        array.push(_confluenceBoxes, box.new(_overlapLeft, _overlapTop, bar_index + 1, _overlapBot, bgcolor = confluence_color, border_color = confluence_color, border_style = line.style_dotted, text = show_confluence_label ? _lbl : '', text_color = _labelTextColor, text_size = size.tiny))
                        array.push(_confluenceLabels, _lbl)

    // Ext vs S/D confluence
    if _sdEnabled and array.size(_extAll) > 0 and array.size(_sdAll) > 0
        for ei = 0 to array.size(_extAll) - 1 by 1
            _eBox = array.get(_extAll, ei)
            _eTop = box.get_top(_eBox)
            _eBot = box.get_bottom(_eBox)
            _eN = array.get(_extAllNames, ei)
            // Skip persistent (Day/Week/Month) Ext × S/D — same rationale as the GP loop.
            if isPersistentName(_eN) and not show_persistent_sd_confluence
                continue
            for si = 0 to array.size(_sdAll) - 1 by 1
                _sBox = array.get(_sdAll, si)
                _sTop = box.get_top(_sBox)
                _sBot = box.get_bottom(_sBox)
                _overlapTop = math.min(_eTop, _sTop)
                _overlapBot = math.max(_eBot, _sBot)
                if _overlapTop > _overlapBot
                    _overlapLeft = math.max(box.get_left(_eBox), box.get_left(_sBox))
                    _lbl = use_short_labels ? shortToken(_eN) + '+S/D' : _eN + ' + S/D'
                    array.push(_confluenceBoxes, box.new(_overlapLeft, _overlapTop, bar_index + 1, _overlapBot, bgcolor = confluence_color, border_color = confluence_color, border_style = line.style_dotted, text = show_confluence_label ? _lbl : '', text_color = _labelTextColor, text_size = size.tiny))
                    array.push(_confluenceLabels, _lbl)

    // Merge heavily-overlapping confluence boxes (>70% of smaller box) so labels don't stack on
    // top of each other. Repeats until no more merges are possible to handle transitive chains.
    bool _mergeChanged = array.size(_confluenceBoxes) > 1
    while _mergeChanged
        _mergeChanged := false
        if array.size(_confluenceBoxes) > 1
            int _mi = 0
            while _mi < array.size(_confluenceBoxes) - 1
                _aBox = array.get(_confluenceBoxes, _mi)
                _aTopM = box.get_top(_aBox)
                _aBotM = box.get_bottom(_aBox)
                _aLeftM = box.get_left(_aBox)
                _aHeightM = _aTopM - _aBotM
                int _mj = _mi + 1
                while _mj < array.size(_confluenceBoxes)
                    _bBox = array.get(_confluenceBoxes, _mj)
                    _bTopM = box.get_top(_bBox)
                    _bBotM = box.get_bottom(_bBox)
                    _bLeftM = box.get_left(_bBox)
                    _bHeightM = _bTopM - _bBotM
                    _ovTopM = math.min(_aTopM, _bTopM)
                    _ovBotM = math.max(_aBotM, _bBotM)
                    _ovHeightM = _ovTopM - _ovBotM
                    _minHeightM = math.min(_aHeightM, _bHeightM)
                    if _ovHeightM > 0 and _minHeightM > 0 and _ovHeightM / _minHeightM > 0.7
                        _newTopM = math.max(_aTopM, _bTopM)
                        _newBotM = math.min(_aBotM, _bBotM)
                        _newLeftM = math.min(_aLeftM, _bLeftM)
                        box.set_top(_aBox, _newTopM)
                        box.set_bottom(_aBox, _newBotM)
                        box.set_left(_aBox, _newLeftM)
                        if show_confluence_label
                            _aLbl = array.get(_confluenceLabels, _mi)
                            _bLbl = array.get(_confluenceLabels, _mj)
                            if _bLbl != ''
                                // Tokenize each label, dedupe, re-join. This collapses
                                // pairwise overlap labels (e.g. "GP + Day GP" merged with
                                // "GP + Week GP") into a single multi-zone label
                                // ("GP + Day GP + Week GP") instead of the old "& "
                                // concatenation that produced runaway duplicates when many
                                // zones stacked at the same level.
                                _joiner = use_short_labels ? '+' : ' + '
                                _aTokens = str.split(_aLbl, _joiner)
                                _bTokens = str.split(_bLbl, _joiner)
                                if array.size(_bTokens) > 0
                                    for _bt = 0 to array.size(_bTokens) - 1
                                        _tok = array.get(_bTokens, _bt)
                                        if not array.includes(_aTokens, _tok)
                                            array.push(_aTokens, _tok)
                                _newLbl = ''
                                if array.size(_aTokens) > 0
                                    for _ti = 0 to array.size(_aTokens) - 1
                                        _newLbl := _ti == 0 ? array.get(_aTokens, _ti) : _newLbl + _joiner + array.get(_aTokens, _ti)
                                array.set(_confluenceLabels, _mi, _newLbl)
                                box.set_text(_aBox, _newLbl)
                        box.delete(array.remove(_confluenceBoxes, _mj))
                        array.remove(_confluenceLabels, _mj)
                        _aTopM := _newTopM
                        _aBotM := _newBotM
                        _aLeftM := _newLeftM
                        _aHeightM := _aTopM - _aBotM
                        _mergeChanged := true
                    else
                        _mj += 1
                _mi += 1

    // Strength scoring — after merging, count how many distinct zones share
    // each highlighted area (the merge step already deduped their names).
    // Stacks of 3+ get a ×N tag and a more solid fill so the areas with the
    // most agreement stand out at a glance.
    if conf_score_on and array.size(_confluenceBoxes) > 0
        _scJoiner = use_short_labels ? '+' : ' + '
        for ci = 0 to array.size(_confluenceBoxes) - 1 by 1
            _scLbl = array.get(_confluenceLabels, ci)
            _scScore = _scLbl == '' ? 0 : array.size(str.split(_scLbl, _scJoiner))
            if _scScore > 2
                _scBox = array.get(_confluenceBoxes, ci)
                _scCol = color.new(confluence_color, math.max(color.t(confluence_color) - conf_score_boost * (_scScore - 2), 25))
                box.set_bgcolor(_scBox, _scCol)
                box.set_border_color(_scBox, _scCol)
                if show_confluence_label
                    box.set_text(_scBox, _scLbl + ' ×' + str.tostring(_scScore))

// Extend right edge of existing confluence boxes each bar
if show_confluence and array.size(_confluenceBoxes) > 0
    for i = 0 to array.size(_confluenceBoxes) - 1 by 1
        box.set_right(array.get(_confluenceBoxes, i), bar_index + 1)
//#endregion

//#region Alert Conditions
// These produce selectable entries in TradingView's alert dialog (Condition
// dropdown). Each fires when price first crosses into the matching zone type
// from outside on the current bar. Pick one when creating an alert to filter
// to just that event type — independent of the verbose "All-Events Alert
// Stream" toggle above, which uses alert() messages instead.

isBoxTouch(_box) =>
    _hit = false
    if not na(_box)
        _bH = box.get_top(_box)
        _bL = box.get_bottom(_box)
        _hit := (_l <= _bH and _l[1] > _bH) or (_h >= _bL and _h[1] < _bL)
    _hit

// Aggregate touch flags per zone class — one pass over the zone registry.
// The loop runs unconditionally every bar with top-level cached _lPrev/_hPrev,
// so every zone's touch test executes identically on every bar (no
// short-circuit skipping of historical series).
_bullGpTouch = false
_bearGpTouch = false
_bullGpExtTouch = false
_bearGpExtTouch = false
_fvgTouchCond = false
_zcn = array.size(_zBoxes)
if _zcn > 0
    for i = 0 to _zcn - 1 by 1
        _zcb = array.get(_zBoxes, i)
        _zcTop = box.get_top(_zcb)
        _zcBot = box.get_bottom(_zcb)
        _zcHit = (_l <= _zcTop and _lPrev > _zcTop) or (_h >= _zcBot and _hPrev < _zcBot)
        _zck = array.get(_zKind, i)
        _zcd = array.get(_zDir, i)
        if _zck == 0
            if _zcd > 0
                _bullGpTouch := _bullGpTouch or _zcHit
            else
                _bearGpTouch := _bearGpTouch or _zcHit
        else if _zck == 1 or _zck == 3
            if _zcd > 0
                _bullGpExtTouch := _bullGpExtTouch or _zcHit
            else
                _bearGpExtTouch := _bearGpExtTouch or _zcHit
        else if _zck == 4
            _fvgTouchCond := _fvgTouchCond or _zcHit

_dayGpTouchCond = isBoxTouch(_dayGpBox)
_weekGpTouchCond = isBoxTouch(_weekGpBox)
_monthGpTouchCond = isBoxTouch(_monthGpBox)

// S/D and confluence touch tests inline the comparison with the top-level
// _lPrev/_hPrev cached in the Zone Registry block, so every iteration runs
// identically every bar with no historical inconsistency.
_demandTouchCond = false
_demandSize = array.size(_demandBoxes)
if _demandSize > 0
    for i = 0 to _demandSize - 1 by 1
        _b = array.get(_demandBoxes, i)
        _bH = box.get_top(_b)
        _bL = box.get_bottom(_b)
        _hit = (_l <= _bH and _lPrev > _bH) or (_h >= _bL and _hPrev < _bL)
        _demandTouchCond := _demandTouchCond or _hit

_supplyTouchCond = false
_supplySize = array.size(_supplyBoxes)
if _supplySize > 0
    for i = 0 to _supplySize - 1 by 1
        _b = array.get(_supplyBoxes, i)
        _bH = box.get_top(_b)
        _bL = box.get_bottom(_b)
        _hit = (_l <= _bH and _lPrev > _bH) or (_h >= _bL and _hPrev < _bL)
        _supplyTouchCond := _supplyTouchCond or _hit

_confluenceTouchCond = false
_confSize = array.size(_confluenceBoxes)
if _confSize > 0
    for i = 0 to _confSize - 1 by 1
        _b = array.get(_confluenceBoxes, i)
        _bH = box.get_top(_b)
        _bL = box.get_bottom(_b)
        _hit = (_l <= _bH and _lPrev > _bH) or (_h >= _bL and _hPrev < _bL)
        _confluenceTouchCond := _confluenceTouchCond or _hit

alertcondition(_bullGpTouch,                   title = 'Bull GP Touch',           message = 'Bull Golden Pocket touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_bearGpTouch,                   title = 'Bear GP Touch',           message = 'Bear Golden Pocket touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_bullGpExtTouch,                title = 'Bull GP Extension Touch', message = 'Bull GP Extension touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_bearGpExtTouch,                title = 'Bear GP Extension Touch', message = 'Bear GP Extension touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_dayGpTouchCond,                title = 'Day GP Touch',            message = 'Day GP touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_weekGpTouchCond,               title = 'Week GP Touch',           message = 'Week GP touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_monthGpTouchCond,              title = 'Month GP Touch',          message = 'Month GP touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_demandTouchCond,               title = 'Demand Zone Touch',       message = 'Demand zone touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_supplyTouchCond,               title = 'Supply Zone Touch',       message = 'Supply zone touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_confluenceTouchCond,           title = 'Confluence Zone Touch',   message = 'Confluence zone touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_fvgTouchCond,                  title = 'FVG Touch',               message = 'Fair Value Gap touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_bullGpTouch or _bearGpTouch or _bullGpExtTouch or _bearGpExtTouch or _dayGpTouchCond or _weekGpTouchCond or _monthGpTouchCond or _demandTouchCond or _supplyTouchCond or _confluenceTouchCond or _fvgTouchCond, title = 'Any Zone Touch', message = 'Zone touched on {{ticker}} ({{interval}}) at {{close}}')
alertcondition(_anyApproach,                   title = 'Approaching Any Zone',    message = 'Price approaching a zone on {{ticker}} ({{interval}}) at {{close}}')
//#endregion

//#region Zone Dashboard
// Corner table of every active zone, sorted nearest-to-price first. Built
// fresh on the last bar from the zone registry + S/D arrays, so it always
// matches what's drawn on the chart. Distances are expressed in ATR so the
// readout means the same thing on every symbol and timeframe.
_dashPos = dash_pos == 'Top Left' ? position.top_left : dash_pos == 'Bottom Right' ? position.bottom_right : dash_pos == 'Bottom Left' ? position.bottom_left : dash_pos == 'Middle Right' ? position.middle_right : position.top_right
_dashTxtSize = dash_size == 'Tiny' ? size.tiny : dash_size == 'Normal' ? size.normal : size.small
// The Side/Vertical Gap inputs are implemented as invisible spacer cells: an
// extra rightmost column of blank text pushes the content away from the
// chart's right edge (useful when a right-edge overlay like the Volume
// Strata histogram sits there), and blank rows push it vertically. Tables
// can't be pixel-offset in Pine, so spacer cells are the reliable nudge.
// Cell backgrounds are painted per-cell (not table-wide) so the spacers
// stay fully transparent.
_dashTopAnchored = dash_pos == 'Top Right' or dash_pos == 'Top Left'
_dashRowOff = _dashTopAnchored ? dash_pad_y : 0
// Extra row budget for the Hit-Rate section (1 header + up to 4 profile rows).
// Unused rows have no cells and collapse to zero height, so reserving them is free.
_dashStatCap = dash_stats ? 5 : 0
var table _dashTbl = dash_on ? table.new(_dashPos, 5, dash_max + 1 + dash_pad_y + _dashStatCap) : na

if dash_on and barstate.islast and not na(_dashTbl)
    table.clear(_dashTbl, 0, 0, 4, dash_max + dash_pad_y + _dashStatCap)
    // Gather every zone with its nearest-edge price and distance
    _dbName = array.new_string()
    _dbEdge = array.new_float()
    _dbDist = array.new_float()
    _dbSide = array.new_string()
    _dbn = array.size(_zBoxes)
    if _dbn > 0
        for i = 0 to _dbn - 1 by 1
            _dbb = array.get(_zBoxes, i)
            _dbTop = box.get_top(_dbb)
            _dbBot = box.get_bottom(_dbb)
            _dbk = array.get(_zKind, i)
            _dbDirTxt = array.get(_zDir, i) > 0 ? 'Bull' : 'Bear'
            _dbTfTxt = prettyTF(array.get(_zTf, i))
            _dbProf = array.get(_zProf, i)
            _dbNm = _dbk == 0 ? _dbDirTxt + ' ' + _dbTfTxt + ' ' + _dbProf : _dbk == 1 ? _dbDirTxt + ' ' + _dbTfTxt + ' ' + _dbProf + ' Ext' : _dbk == 2 ? _dbProf + ' GP' : _dbk == 3 ? _dbProf + ' ' + _dbDirTxt + ' Ext' : _dbDirTxt + ' FVG'
            _dbInside = _c <= _dbTop and _c >= _dbBot
            array.push(_dbName, _dbNm)
            array.push(_dbEdge, _dbInside ? (_dbTop + _dbBot) / 2 : _c > _dbTop ? _dbTop : _dbBot)
            array.push(_dbDist, _dbInside ? 0.0 : _c > _dbTop ? _c - _dbTop : _dbBot - _c)
            array.push(_dbSide, _dbInside ? 'Inside' : _c > _dbTop ? 'Below' : 'Above')
    if array.size(_demandBoxes) > 0
        for i = 0 to array.size(_demandBoxes) - 1 by 1
            _dbb = array.get(_demandBoxes, i)
            _dbTop = box.get_top(_dbb)
            _dbBot = box.get_bottom(_dbb)
            _dbInside = _c <= _dbTop and _c >= _dbBot
            array.push(_dbName, 'Demand' + (array.get(_demandVolFlags, i) and show_volume_stars ? ' ★' : ''))
            array.push(_dbEdge, _dbInside ? (_dbTop + _dbBot) / 2 : _c > _dbTop ? _dbTop : _dbBot)
            array.push(_dbDist, _dbInside ? 0.0 : _c > _dbTop ? _c - _dbTop : _dbBot - _c)
            array.push(_dbSide, _dbInside ? 'Inside' : _c > _dbTop ? 'Below' : 'Above')
    if array.size(_supplyBoxes) > 0
        for i = 0 to array.size(_supplyBoxes) - 1 by 1
            _dbb = array.get(_supplyBoxes, i)
            _dbTop = box.get_top(_dbb)
            _dbBot = box.get_bottom(_dbb)
            _dbInside = _c <= _dbTop and _c >= _dbBot
            array.push(_dbName, 'Supply' + (array.get(_supplyVolFlags, i) and show_volume_stars ? ' ★' : ''))
            array.push(_dbEdge, _dbInside ? (_dbTop + _dbBot) / 2 : _c > _dbTop ? _dbTop : _dbBot)
            array.push(_dbDist, _dbInside ? 0.0 : _c > _dbTop ? _c - _dbTop : _dbBot - _c)
            array.push(_dbSide, _dbInside ? 'Inside' : _c > _dbTop ? 'Below' : 'Above')
    // Header (shifted down by the vertical-gap spacer rows when top-anchored)
    _dbHdrBg = color.new(#363a45, 20)
    _dbHdrTx = color.new(color.white, 20)
    _dbRowBg = color.new(#1e222d, 25)
    table.cell(_dashTbl, 0, _dashRowOff, 'Zone', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_left)
    table.cell(_dashTbl, 1, _dashRowOff, 'Edge', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_right)
    table.cell(_dashTbl, 2, _dashRowOff, 'Dist', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_right)
    table.cell(_dashTbl, 3, _dashRowOff, 'Where', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_left)
    _dbTotal = array.size(_dbName)
    if _dbTotal > 0
        _dbOrder = array.sort_indices(_dbDist, order.ascending)
        _dbRows = math.min(dash_max, _dbTotal)
        for r = 0 to _dbRows - 1 by 1
            _dbSlot = array.get(_dbOrder, r)
            _dbSideTxt = array.get(_dbSide, _dbSlot)
            _dbSideCol = _dbSideTxt == 'Inside' ? color.new(color.orange, 15) : _dbSideTxt == 'Below' ? color.new(#26A69A, 15) : color.new(#EF5350, 15)
            _dbAtrTxt = _apprAtr > 0 ? str.tostring(array.get(_dbDist, _dbSlot) / _apprAtr, '#.##') : '—'
            table.cell(_dashTbl, 0, _dashRowOff + r + 1, array.get(_dbName, _dbSlot), text_color = color.new(color.white, 15), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_left)
            table.cell(_dashTbl, 1, _dashRowOff + r + 1, str.tostring(array.get(_dbEdge, _dbSlot), format.mintick), text_color = color.new(color.white, 15), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_right)
            table.cell(_dashTbl, 2, _dashRowOff + r + 1, _dbAtrTxt, text_color = color.new(color.white, 15), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_right)
            table.cell(_dashTbl, 3, _dashRowOff + r + 1, (_dbSideTxt == 'Inside' ? '◆ ' : _dbSideTxt == 'Below' ? '▼ ' : '▲ ') + _dbSideTxt, text_color = _dbSideCol, text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_left)
    else
        table.cell(_dashTbl, 0, _dashRowOff + 1, 'No active zones', text_color = color.new(color.gray, 10), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_left)
    // Hit-Rate rows — how each pivot profile's GPs have fared over the
    // processed history. Rendered below the zone list; rows between the last
    // zone and this section have no cells, so they take up no space.
    if dash_stats
        bool _hrAny = false
        for hp = 0 to 3 by 1
            if array.get(_hrHeld, hp) + array.get(_hrFail, hp) > 0
                _hrAny := true
        if _hrAny
            int _hrRow = _dashRowOff + dash_max + 1
            table.cell(_dashTbl, 0, _hrRow, 'Hit Rate', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_left)
            table.cell(_dashTbl, 1, _hrRow, 'Held', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_right)
            table.cell(_dashTbl, 2, _hrRow, '%', text_color = _dbHdrTx, text_size = _dashTxtSize, bgcolor = _dbHdrBg, text_halign = text.align_right)
            table.cell(_dashTbl, 3, _hrRow, '', text_size = _dashTxtSize, bgcolor = _dbHdrBg)
            _hrNames = array.from('Scalping GP', 'Intraday GP', 'Swing GP', 'Custom GP')
            for hp = 0 to 3 by 1
                _hrH = array.get(_hrHeld, hp)
                _hrT = _hrH + array.get(_hrFail, hp)
                if _hrT > 0
                    _hrRow += 1
                    _hrPct = 100.0 * _hrH / _hrT
                    _hrCol = _hrPct >= 60 ? color.new(#26A69A, 15) : _hrPct >= 40 ? color.new(color.orange, 15) : color.new(#EF5350, 15)
                    table.cell(_dashTbl, 0, _hrRow, array.get(_hrNames, hp), text_color = color.new(color.white, 15), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_left)
                    table.cell(_dashTbl, 1, _hrRow, str.tostring(_hrH) + '/' + str.tostring(_hrT), text_color = color.new(color.white, 15), text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_right)
                    table.cell(_dashTbl, 2, _hrRow, str.tostring(_hrPct, '#') + '%', text_color = _hrCol, text_size = _dashTxtSize, bgcolor = _dbRowBg, text_halign = text.align_right)
                    table.cell(_dashTbl, 3, _hrRow, '', text_size = _dashTxtSize, bgcolor = _dbRowBg)
    // Invisible spacers implementing the Side/Vertical Gap inputs. The cell
    // text is the braille-blank character — an invisible glyph that still
    // takes up width/height, so the spacer reliably reserves space.
    if dash_pad_x > 0
        _dbPadTxt = ''
        for px = 1 to dash_pad_x by 1
            _dbPadTxt := _dbPadTxt + '⠀'
        table.cell(_dashTbl, 4, _dashRowOff, _dbPadTxt, text_color = color.new(color.white, 100), text_size = _dashTxtSize)
    if dash_pad_y > 0
        for pr = 0 to dash_pad_y - 1 by 1
            table.cell(_dashTbl, 0, _dashTopAnchored ? pr : dash_max + 1 + _dashStatCap + pr, '⠀', text_color = color.new(color.white, 100), text_size = _dashTxtSize)
//#endregion

//#region Non-Standard Chart Warning
// Detect Heikin Ashi: HA defines open[t] = (HA_open[t-1] + HA_close[t-1]) / 2 exactly.
// On real candles this equality only holds by coincidence. Three consecutive matching
// bars gives high confidence with no extra request.security call.
_isHABar = not na(open[1]) and not na(close[1]) and open == (open[1] + close[1]) / 2
var int _haRunLen = 0
_haRunLen := _isHABar ? _haRunLen + 1 : 0

var label _sdWarningLabel = na
if barstate.islast
    label.delete(_sdWarningLabel)
    _sdWarningLabel := na
    // Only warn when zones are actually being built from HA values — with
    // Use Real OHLC on, every zone already uses real traded prices and the
    // warning would be noise.
    if _haRunLen >= 3 and sd_on and show_ha_warning and not use_real_ohlc
        _sdWarningLabel := label.new(
             bar_index, na,
             'Heikin Ashi chart detected and Use Real OHLC is off.\nZones are built from smoothed HA prices, which can\nadd extra S/D signals and shift levels away from\nprices that actually traded. Turn on Use Real OHLC\n(Chart GPs section) or use a standard chart.',
             xloc.bar_index, yloc.abovebar,
             color     = color.new(color.orange, 10),
             textcolor = color.white,
             style     = label.style_label_down,
             size      = size.small)
//#endregion
````


