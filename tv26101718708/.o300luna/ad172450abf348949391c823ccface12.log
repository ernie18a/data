// Persistent GPs (Day / Week / Month) — anchored to fixed Day/Week/Month periods
// rather than swing pivots. Each box draws from the prior COMPLETED period's High/Low,
// pulled from the higher-timeframe series via request.security (see the H/L resolution
// block below). This is the same source the Prior Period Levels lines use, so the boxes
// and the PDH/PDL/PWH/PWL/PMH/PML lines always agree, identically on every chart
// timeframe. The earlier futures concern (the daily bar collapsing the range after the
// 6 PM CME rollover) doesn't apply here: these use the prior completed period, never the
// live developing range, so a session rollover just hands over the finished period.
// Per-period RTH toggles force the symbol's regular session when set.

var box _dayGpBox = na
var line _dayGpMidLine = na
var box _dayGpBullExtBox = na
var box _dayGpBearExtBox = na
var line _dayGpBullExtLine = na
var line _dayGpBearExtLine = na
var box _weekGpBox = na
var line _weekGpMidLine = na
var box _weekGpBullExtBox = na
var box _weekGpBearExtBox = na
var line _weekGpBullExtLine = na
var line _weekGpBearExtLine = na
var box _monthGpBox = na
var line _monthGpMidLine = na
var box _monthGpBullExtBox = na
var box _monthGpBearExtBox = na
var line _monthGpBullExtLine = na
var line _monthGpBearExtLine = na

// Persistent GPs read the prior COMPLETED day/week/month straight from the higher-
// timeframe series — the same source as the Prior Period Levels lines — so the boxes,
// the PDH/PDL/PWH/PWL/PMH/PML lines, and the ladder all agree on identical levels on
// every chart timeframe. (See the Prior Period Levels region for the full rationale:
// timeframe-independent, available even on low timeframes, and non-repainting via
// high[1]/low[1] + lookahead_on.) Each period keeps its own RTH toggle — RTH-only
// forces the symbol's regular session; otherwise the chart's default session is used.
// Values stay na until a full prior period has completed (no box on the first ever
// day/week/month), exactly as before.
_dayTicker   = day_gp_rth_only   ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
_weekTicker  = week_gp_rth_only  ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
_monthTicker = month_gp_rth_only ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
[_dayHigh, _dayLow] = if show_day_gp
    request.security(_dayTicker, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]
[_weekHighSel, _weekLowSel] = if show_week_gp
    request.security(_weekTicker, 'W', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]
[_monthHighSel, _monthLowSel] = if show_month_gp
    request.security(_monthTicker, 'M', [high[1], low[1]], lookahead = barmerge.lookahead_on)
else
    [float(na), float(na)]

// Ladder change-signal — fires on the bar each prior-period value actually updates
// (the higher-timeframe roll, which is exactly when its box repositions), plus the
// first bar a valid value appears. Replaces the old calendar-rollover flags so the
// persistent ladder locks to the same range its box draws.
_dayChanged   = show_day_gp   and not na(_dayHigh)      and (na(_dayHigh[1])      or _dayHigh != _dayHigh[1]           or _dayLow != _dayLow[1])
_weekChanged  = show_week_gp  and not na(_weekHighSel)  and (na(_weekHighSel[1])  or _weekHighSel != _weekHighSel[1]   or _weekLowSel != _weekLowSel[1])
_monthChanged = show_month_gp and not na(_monthHighSel) and (na(_monthHighSel[1]) or _monthHighSel != _monthHighSel[1] or _monthLowSel != _monthLowSel[1])

// Render a persistent GP. Returns updated box/line refs so the caller's
// `var` slots can be re-assigned across bars.
drawPersistentGp(bool enabled, float hi, float lo, color col, float fib1, float fib2, string lblText, string lblValign, int rightOff, int width, bool midExt, bool extOn, bool extLineOn, box prevBox, line prevLine, box prevBullExtBox, box prevBearExtBox, line prevBullExtLine, line prevBearExtLine) =>
    box _b = prevBox
    line _ln = prevLine
    box _bullExt = prevBullExtBox
    box _bearExt = prevBearExtBox
    line _bullExtLn = prevBullExtLine
    line _bearExtLn = prevBearExtLine
    if enabled and not na(hi) and not na(lo) and hi > lo
        _range = hi - lo
        _top = hi - _range * fib1
        _bot = hi - _range * fib2
        _right = bar_index + 1 + rightOff
        _left = _right - width
        if na(_b)
            _b := box.new(_left, _top, _right, _bot, bgcolor = col, border_color = col, border_style = _borderStyle, text = lblText, text_color = _labelTextColor, text_size = size.small, text_halign = text.align_left, text_valign = lblValign)
        else
            box.set_left(_b, _left)
            box.set_right(_b, _right)
            box.set_top(_b, _top)
            box.set_bottom(_b, _bot)
            box.set_bgcolor(_b, col)
            box.set_border_color(_b, col)
            box.set_border_style(_b, _borderStyle)
            box.set_text(_b, lblText)
            box.set_text_color(_b, _labelTextColor)
            box.set_text_halign(_b, text.align_left)
            box.set_text_valign(_b, lblValign)
        if show_mid
            _mid = (_top + _bot) / 2
            // Persistent midpoints can either inherit the period's GP color (default —
            // makes Day/Week/Month midpoints distinguishable when extended left) or
            // share the global custom color picked in the Persistent GPs group.
            _midCol = persistent_mid_match_color ? col : persistent_mid_color
            if na(_ln)
                _ln := line.new(_left, _mid, _right, _mid, style = _midStyle, color = _midCol, extend = midExt ? extend.left : extend.none)
            else
                line.set_xy1(_ln, _left, _mid)
                line.set_xy2(_ln, _right, _mid)
                line.set_style(_ln, _midStyle)
                line.set_color(_ln, _midCol)
                line.set_extend(_ln, midExt ? extend.left : extend.none)
        else
            line.delete(_ln)
            _ln := na
        // Per-period extension band (uses the period's own fib1/fib2 mirrored outward).
        if extOn
            _bullExtTop = hi + _range * fib2
            _bullExtBot = hi + _range * fib1
            _bearExtTop = lo - _range * fib1
            _bearExtBot = lo - _range * fib2
            if na(_bullExt)
                _bullExt := box.new(_left, _bullExtTop, _right, _bullExtBot, bgcolor = col, border_color = col, border_style = _borderStyle, text = show_ext_label ? 'Ex.' : '', text_color = _labelTextColor, text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom)
            else
                box.set_left(_bullExt, _left)
                box.set_right(_bullExt, _right)
                box.set_top(_bullExt, _bullExtTop)
                box.set_bottom(_bullExt, _bullExtBot)
                box.set_bgcolor(_bullExt, col)
                box.set_border_color(_bullExt, col)
                box.set_text(_bullExt, show_ext_label ? 'Ex.' : '')
            if na(_bearExt)
                _bearExt := box.new(_left, _bearExtTop, _right, _bearExtBot, bgcolor = col, border_color = col, border_style = _borderStyle, text = show_ext_label ? 'Ex.' : '', text_color = _labelTextColor, text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom)
            else
                box.set_left(_bearExt, _left)
                box.set_right(_bearExt, _right)
                box.set_top(_bearExt, _bearExtTop)
                box.set_bottom(_bearExt, _bearExtBot)
                box.set_bgcolor(_bearExt, col)
                box.set_border_color(_bearExt, col)
                box.set_text(_bearExt, show_ext_label ? 'Ex.' : '')
        else
            box.delete(_bullExt)
            box.delete(_bearExt)
            _bullExt := na
            _bearExt := na
        // Global bonus line at user-defined extension level.
        if extLineOn
            _bullY = hi + _range * (persistent_ext_line_level - 1)
            _bearY = lo - _range * (persistent_ext_line_level - 1)
            _extLnCol = color.new(col, 0)
            if na(_bullExtLn)
                _bullExtLn := line.new(_left, _bullY, _right, _bullY, style = _midStyle, color = _extLnCol)
            else
                line.set_xy1(_bullExtLn, _left, _bullY)
                line.set_xy2(_bullExtLn, _right, _bullY)
                line.set_color(_bullExtLn, _extLnCol)
            if na(_bearExtLn)
                _bearExtLn := line.new(_left, _bearY, _right, _bearY, style = _midStyle, color = _extLnCol)
            else
                line.set_xy1(_bearExtLn, _left, _bearY)
                line.set_xy2(_bearExtLn, _right, _bearY)
                line.set_color(_bearExtLn, _extLnCol)
        else
            line.delete(_bullExtLn)
            line.delete(_bearExtLn)
            _bullExtLn := na
            _bearExtLn := na
    else
        box.delete(_b)
        _b := na
        line.delete(_ln)
        _ln := na
        box.delete(_bullExt)
        box.delete(_bearExt)
        line.delete(_bullExtLn)
        line.delete(_bearExtLn)
        _bullExt := na
        _bearExt := na
        _bullExtLn := na
        _bearExtLn := na
    [_b, _ln, _bullExt, _bearExt, _bullExtLn, _bearExtLn]

[_dayGpBox2, _dayGpMidLine2, _dayBullExt2, _dayBearExt2, _dayBullExtLn2, _dayBearExtLn2] = drawPersistentGp(show_day_gp, _dayHigh, _dayLow, day_gp_color, day_gp_fib_1, day_gp_fib_2, show_day_gp_label ? (use_short_labels ? 'D' : 'Day GP') : '', text.align_top, day_gp_right_offset, day_gp_width, day_gp_mid_extend_left, show_day_gp_ext, show_persistent_ext_line and show_day_gp, _dayGpBox, _dayGpMidLine, _dayGpBullExtBox, _dayGpBearExtBox, _dayGpBullExtLine, _dayGpBearExtLine)
_dayGpBox := _dayGpBox2
_dayGpMidLine := _dayGpMidLine2
_dayGpBullExtBox := _dayBullExt2
_dayGpBearExtBox := _dayBearExt2
_dayGpBullExtLine := _dayBullExtLn2
_dayGpBearExtLine := _dayBearExtLn2
manageLadder('Day', 'Day', false, _dayChanged, _dayChanged, false, show_day_gp and not na(_dayGpBox), show_day_gp and not na(_dayGpBox), _dayHigh, _dayLow, day_gp_color)

[_weekGpBox2, _weekGpMidLine2, _weekBullExt2, _weekBearExt2, _weekBullExtLn2, _weekBearExtLn2] = drawPersistentGp(show_week_gp, _weekHighSel, _weekLowSel, week_gp_color, week_gp_fib_1, week_gp_fib_2, show_week_gp_label ? (use_short_labels ? 'W' : 'Week GP') : '', text.align_center, week_gp_right_offset, week_gp_width, week_gp_mid_extend_left, show_week_gp_ext, show_persistent_ext_line and show_week_gp, _weekGpBox, _weekGpMidLine, _weekGpBullExtBox, _weekGpBearExtBox, _weekGpBullExtLine, _weekGpBearExtLine)
_weekGpBox := _weekGpBox2
_weekGpMidLine := _weekGpMidLine2
_weekGpBullExtBox := _weekBullExt2
_weekGpBearExtBox := _weekBearExt2
_weekGpBullExtLine := _weekBullExtLn2
_weekGpBearExtLine := _weekBearExtLn2
manageLadder('Week', 'Week', false, _weekChanged, _weekChanged, false, show_week_gp and not na(_weekGpBox), show_week_gp and not na(_weekGpBox), _weekHighSel, _weekLowSel, week_gp_color)

[_monthGpBox2, _monthGpMidLine2, _monthBullExt2, _monthBearExt2, _monthBullExtLn2, _monthBearExtLn2] = drawPersistentGp(show_month_gp, _monthHighSel, _monthLowSel, month_gp_color, month_gp_fib_1, month_gp_fib_2, show_month_gp_label ? (use_short_labels ? 'M' : 'Month GP') : '', text.align_bottom, month_gp_right_offset, month_gp_width, month_gp_mid_extend_left, show_month_gp_ext, show_persistent_ext_line and show_month_gp, _monthGpBox, _monthGpMidLine, _monthGpBullExtBox, _monthGpBearExtBox, _monthGpBullExtLine, _monthGpBearExtLine)
_monthGpBox := _monthGpBox2
_monthGpMidLine := _monthGpMidLine2
_monthGpBullExtBox := _monthBullExt2
_monthGpBearExtBox := _monthBearExt2
_monthGpBullExtLine := _monthBullExtLn2
_monthGpBearExtLine := _monthBearExtLn2
manageLadder('Month', 'Month', false, _monthChanged, _monthChanged, false, show_month_gp and not na(_monthGpBox), show_month_gp and not na(_monthGpBox), _monthHighSel, _monthLowSel, month_gp_color)
//#endregion

//#region Fair Value Gaps
// ICT Fair Value Gap — a three-candle imbalance. Bullish: the current bar's
// low sits ABOVE the high from two bars ago, so the middle (displacement)
// candle left a strip of prices nobody traded; price often returns to
// rebalance it, making the gap a support zone. Bearish is the mirror image
// (resistance above). Zones are only created once the third candle has
// closed (no repaint) and are computed on chart-TF real OHLC.
var array<box> _bullFvg = array.new_box()
var array<box> _bearFvg = array.new_box()
// Original gap midpoints — the ICT consequent-encroachment level, used by the
// Midpoint Touched removal rule. Kept separately so shrinking the box as it
// part-fills doesn't move the removal trigger.
var array<float> _bullFvgMid = array.new_float()
var array<float> _bearFvgMid = array.new_float()

_fvgTrRaw = math.max(_h - _l, math.max(math.abs(_h - _c[1]), math.abs(_l - _c[1])))
_fvgAtr = fvg_on ? ta.rma(_fvgTrRaw, 14) : na

if not fvg_on
    while array.size(_bullFvg) > 0
        box.delete(array.pop(_bullFvg))
        array.pop(_bullFvgMid)
    while array.size(_bearFvg) > 0
        box.delete(array.pop(_bearFvg))
        array.pop(_bearFvgMid)

if fvg_on
    // The displacement candle is the middle bar of the pattern — its volume
    // decides the ★ flag.
    _fvgHighVol = vol_enhance_on and volume[1] > vol_sma[1]
    if barstate.isconfirmed
        if _l > _h[2] and _l - _h[2] >= _fvgAtr * fvg_min_atr
            _fvgBCol = boostColor(fvg_bull_color, _fvgHighVol)
            _fvgBLbl = fvg_show_labels ? 'FVG' + (_fvgHighVol and show_volume_stars ? ' ★' : '') : ''
            array.push(_bullFvg, box.new(bar_index - 1, _l, bar_index + 1, _h[2], bgcolor = _fvgBCol, border_color = _fvgBCol, border_style = _borderStyle, text = _fvgBLbl, text_color = _sdLabelTextColor, text_size = size.tiny))
            array.push(_bullFvgMid, (_l + _h[2]) / 2)
        if _h < _l[2] and _l[2] - _h >= _fvgAtr * fvg_min_atr
            _fvgSCol = boostColor(fvg_bear_color, _fvgHighVol)
            _fvgSLbl = fvg_show_labels ? 'FVG' + (_fvgHighVol and show_volume_stars ? ' ★' : '') : ''
            array.push(_bearFvg, box.new(bar_index - 1, _l[2], bar_index + 1, _h, bgcolor = _fvgSCol, border_color = _fvgSCol, border_style = _borderStyle, text = _fvgSLbl, text_color = _sdLabelTextColor, text_size = size.tiny))
            array.push(_bearFvgMid, (_l[2] + _h) / 2)
    // Oldest-first cap per side
    while array.size(_bullFvg) > fvg_max_zones
        box.delete(array.remove(_bullFvg, 0))
        array.remove(_bullFvgMid, 0)
    while array.size(_bearFvg) > fvg_max_zones
        box.delete(array.remove(_bearFvg, 0))
        array.remove(_bearFvgMid, 0)
    // Extend, fill-check, shrink. A bull gap fills from its top downward
    // (price dipping into it); a bear gap fills from its bottom upward.
    if array.size(_bullFvg) > 0
        for i = array.size(_bullFvg) - 1 to 0 by 1
            _fvb = array.get(_bullFvg, i)
            box.set_right(_fvb, bar_index + 1)
            _fvbKill = fvg_fill_rule == 'Midpoint Touched' ? _l <= array.get(_bullFvgMid, i) : _l <= box.get_bottom(_fvb)
            if _fvbKill
                box.delete(array.remove(_bullFvg, i))
                array.remove(_bullFvgMid, i)
            else if fvg_shrink and _l < box.get_top(_fvb)
                box.set_top(_fvb, _l)
    if array.size(_bearFvg) > 0
        for i = array.size(_bearFvg) - 1 to 0 by 1
            _fvs = array.get(_bearFvg, i)
            box.set_right(_fvs, bar_index + 1)
            _fvsKill = fvg_fill_rule == 'Midpoint Touched' ? _h >= array.get(_bearFvgMid, i) : _h >= box.get_top(_fvs)
            if _fvsKill
                box.delete(array.remove(_bearFvg, i))
                array.remove(_bearFvgMid, i)
            else if fvg_shrink and _h > box.get_bottom(_fvs)
                box.set_bottom(_fvs, _h)

// FVG state signature — lets Confluence notice gap adds/removes/shrinks
// (mirrors the S/D signature further down).
_fvgSig = array.size(_bullFvg) * 1e6 + array.size(_bearFvg) * 1e3
if array.size(_bullFvg) > 0
    for i = 0 to array.size(_bullFvg) - 1 by 1
        _fsb = array.get(_bullFvg, i)
        _fvgSig += box.get_top(_fsb) + box.get_bottom(_fsb)
if array.size(_bearFvg) > 0
    for i = 0 to array.size(_bearFvg) - 1 by 1
        _fss = array.get(_bearFvg, i)
        _fvgSig += box.get_top(_fss) + box.get_bottom(_fss)
_fvgDirty = na(_fvgSig[1]) or _fvgSig != _fvgSig[1]
//#endregion

//#region Zone Registry
// Every active zone box, collected once per bar with the metadata each
// downstream consumer needs (alert stream, confluence, alert conditions).
// Kind: 0 = pivot/quick GP · 1 = its extension · 2 = persistent Day/Week/
// Month GP · 3 = persistent extension · 4 = chart-TF FVG.
// Dir: 1 bull · -1 bear · 0 none.
// Prof carries the profile name (kind 0/1) or period name (kind 2/3).
_zBoxes = array.new_box()
_zKind  = array.new_int()
_zDir   = array.new_int()
_zTf    = array.new_string()
_zProf  = array.new_string()
_zName  = array.new_string()

zPush(box _zpB, int _zpKind, int _zpDir, string _zpTf, string _zpProf, string _zpName) =>
    if not na(_zpB)
        array.push(_zBoxes, _zpB)
        array.push(_zKind, _zpKind)
        array.push(_zDir, _zpDir)
        array.push(_zTf, _zpTf)
        array.push(_zProf, _zpProf)
        array.push(_zName, _zpName)

_zChartTf = timeframe.period
zPush(chart_bull_scalp,     0,  1, _zChartTf, 'Scalping', 'GP')
zPush(chart_bear_scalp,     0, -1, _zChartTf, 'Scalping', 'GP')
zPush(chart_bullExt_scalp,  1,  1, _zChartTf, 'Scalping', 'Ext')
zPush(chart_bearExt_scalp,  1, -1, _zChartTf, 'Scalping', 'Ext')
zPush(chart_bull_intr,      0,  1, _zChartTf, 'Intraday', 'GP')
zPush(chart_bear_intr,      0, -1, _zChartTf, 'Intraday', 'GP')
zPush(chart_bullExt_intr,   1,  1, _zChartTf, 'Intraday', 'Ext')
zPush(chart_bearExt_intr,   1, -1, _zChartTf, 'Intraday', 'Ext')
zPush(chart_bull_swing,     0,  1, _zChartTf, 'Swing', 'GP')
zPush(chart_bear_swing,     0, -1, _zChartTf, 'Swing', 'GP')
zPush(chart_bullExt_swing,  1,  1, _zChartTf, 'Swing', 'Ext')
zPush(chart_bearExt_swing,  1, -1, _zChartTf, 'Swing', 'Ext')
zPush(chart_bull_quick,     0,  1, _zChartTf, 'Quick', 'GP')
zPush(chart_bear_quick,     0, -1, _zChartTf, 'Quick', 'GP')
