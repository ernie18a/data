    if array.size(_bullFvg) > 0
        for _fvi = 0 to array.size(_bullFvg) - 1 by 1
            zPush(array.get(_bullFvg, _fvi), 4, 1, _zChartTf, 'FVG', 'FVG')
    if array.size(_bearFvg) > 0
