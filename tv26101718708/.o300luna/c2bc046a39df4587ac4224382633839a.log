mdAbsMode = input.string("Either", "Absorption measures", options = ["Range", "Body", "Either"], group = G9,
     tooltip = "What counts as 'little movement for the size traded'. Range: volume against the bar's full high-to-low. Body: volume against open-to-close. Either (default): a bar qualifies on whichever fits.\n\nBody matters because a bar that runs hard both ways and closes near its open has enormous rotation but a wide range, so the range test throws it out. On the test data, body-based absorption caught 1,748 bars the range test missed — median body 0.31x normal against a range of 1.08x. That is the rejection bar, and it was invisible.")
mdAbsDebug = input.bool(false, "Absorption debug", group = G9, inline = "mdbg")
mdAbsDebugN = input.int(20, "keep", minval = 5, maxval = 60, group = G9, inline = "mdbg",
     tooltip = "Grey labels, so they never read as prints. Shows the three absorption readings under every bar that had the volume to be a candidate but failed — effort ratio, range/body ratio, relative volume, each ticked or crossed. Shows which gate is actually blocking instead of leaving you to guess from an empty chart.")
mdColAgg = input.color(#ff7b00, "Aggression", group = G9, inline = "mc")
mdColAbs = input.color(#a855f7, "Absorption", group = G9, inline = "mc")
mdSigStyle = input.string("Short", "Signal text", options = ["Short", "Full", "Marker only"], group = G9, inline = "mg")
mdSigSize = input.string("Tiny", "size", options = ["Tiny", "Small", "Normal", "Large"], group = G9, inline = "mg",
     tooltip = "Short: AGG Δ▲ / ABS Δ▼. Full: the whole word with the same arrow. Marker only: a coloured triangle. Δ▲ / Δ▼ is the side that aggressed, not the candle direction.")
mdReadWAcc = input.float(1.5, "MDP read weights:  acceptance", minval = 0.0, maxval = 3.0, step = 0.25, group = G9, inline = "rdw")
mdReadWStr = input.float(1.0, "structure", minval = 0.0, maxval = 3.0, step = 0.25, group = G9, inline = "rdw")
mdReadWLoc = input.float(1.0, "location", minval = 0.0, maxval = 3.0, step = 0.25, group = G9, inline = "rdw2")
mdReadWPath = input.float(1.5, "print path", minval = 0.0, maxval = 3.0, step = 0.25, group = G9, inline = "rdw2")
mdReadWFlow = input.float(0.5, "flow", minval = 0.0, maxval = 3.0, step = 0.25, group = G9, inline = "rdw2",
     tooltip = "Acceptance carries most because a migrating POC cannot be faked by one aggressive burst. Structure is price truth. Location says which side of value price is trading. Flow is the fastest and the noisiest, so it carries least.")
mdPathN = input.int(10, "Print path: prints compared", minval = 4, maxval = 50, group = G9, inline = "rdp")
mdPathMin = input.float(0.5, "flat below (ATR)", minval = 0.1, maxval = 5.0, step = 0.1, group = G9, inline = "rdp",
     tooltip = "Where the last N prints are landing relative to each other: the newer half's average price against the older half's, measured in ATR. Rising prints mean size keeps trading higher and higher — each print is a fresh commitment at a better price for buyers. Below this many ATR of separation it reads flat, so a sideways cluster of prints does not masquerade as a trend.")
mdReadTh = input.float(1.5, "MDP read: BULL/BEAR threshold", minval = 0.25, maxval = 6.0, step = 0.25, group = G9, inline = "rdt")
mdReadDamp = input.float(0.4, "unsponsored floor", minval = 0.0, maxval = 1.0, step = 0.1, group = G9, inline = "rdt",
     tooltip = "Threshold: the score at or beyond which the read commits to a side; inside it the row says FLAT. Unsponsored floor: how much of the score survives when participation is dead and fuel unpaid — 0.4 means a move with nobody behind it keeps 40% of its conviction, so it needs the other drivers to agree strongly before it can call a side. Set 1.0 to ignore sponsorship entirely.")
mdLdrN = input.int(5, "MDP-LDR: prints in the tally", minval = 2, maxval = 50, group = G9, inline = "ld")
mdLdrTh = input.float(1.5, "net for a call", minval = 0.5, maxval = 20.0, step = 0.5, group = G9, inline = "ld",
     tooltip = "MDP-LDR reads the last N prints against the market structure in force when each one landed. A print whose aggressor FOUGHT the trend votes for continuation — someone had to supply the liquidity for the trend to keep going. A print whose aggressor AGREED with the trend votes the other way — one-sided flow, with nobody left to take the other side. Net is those two subtracted, and it must reach this number before the row calls anything.\n\nUNTESTED: on two years of ES futures this rule showed no significant edge against a shuffled null (p is about 0.17), and what lean there was ran the opposite way. That test had no bid/ask data though, so the exact case the rule is about — a down bar with buying delta — was invisible to it. Your chart has real footprint delta, and the row shows its own running tally so you can judge it on your own data.")
mdLdrWw = input.float(1.0, "MDP-LDR weights:  one-sided", minval = 0.0, maxval = 2.0, step = 0.1, group = G9, inline = "ldw")
mdLdrWc = input.float(0.5, "fuel", minval = 0.0, maxval = 2.0, step = 0.1, group = G9, inline = "ldw")
mdLdrWa = input.float(0.5, "absorption", minval = 0.0, maxval = 2.0, step = 0.1, group = G9, inline = "ldw",
     tooltip = "Set from the research, not guessed. Across 105,984 bars of real aggressor data on two symbols:\n\nONE-SIDED (aggressor agrees with the trend) was the most consistent leg — continuation ran at 44% on both symbols, below a coin flip, so it carries full weight.\n\nFUEL (aggressor fights the trend) leaned the right way but roughly half as reliably once overlapping samples were removed, so it carries half.\n\nABSORPTION ran against the trend on both symbols, which is why it votes for reversal at half weight instead of the zero it had before.\n\nVotes are NOT scaled by print size on purpose: the effect showed no dose-response with size, so a huge print counts the same as a modest one.")
mdLevels = input.string("-0.625, -0.5, -0.375, 0, 0.375, 0.5, 0.625, 1, 1.375, 1.5, 1.625", "Levels (ratios)", group = G9,
     tooltip = "Comma-separated ratios of the print's own range. 0 = the print's low, 1 = its high, so 0.5 is its midpoint; anything below 0 or above 1 is an extension beyond the bar. Blank entries and anything that is not a number are skipped.")
mdLnAbove = input.color(#4ade80, "Above 1", group = G9, inline = "ml")
mdLnInside = input.color(#e0b042, "inside", group = G9, inline = "ml")
mdLnBelow = input.color(#e24b4a, "below 0", group = G9, inline = "ml")
mdLnW = input.int(1, "Line width", minval = 1, maxval = 4, group = G9, inline = "ml2")
mdLnLbl = input.bool(true, "ratio labels", group = G9, inline = "ml2",
     tooltip = "Extensions above the print take the first colour, levels between its high and low the second, extensions below it the third. Lines extend right until a new print replaces them.")
mdSigText = input.int(20, "Signals with text", minval = 0, maxval = 200, group = G9,
     tooltip = "The newest prints carry the full AGG / ABS reading. Older ones keep their marker and colour but drop the text, so the chart stays legible when you scroll back and the label budget goes further.")
mdSigKeep = input.int(60, "Signals kept on chart", minval = 0, maxval = 190, group = G9,
     tooltip = "How many past MDP markers stay on the chart, text or not. The script reserves 200 labels in total and the ladder's ratio labels and the debug labels come out of the same pool, so 60 leaves room without reserving memory you are not using. The candle colour itself is permanent, painted on the bar that qualified, so prints stay findable however far back you scroll.")

// ── 9R · MDP research — downstream measurement only ──────────────────────────
mdResearch = input.bool(false, "Research mode", group = G9R,
     tooltip = "Diagnostic only: it measures what happens AFTER a print and never feeds back into which candle qualifies. Keeping the two apart is the whole point — a measurement that can change what it measures tells you nothing.")
mdFwdBars = input.int(20, "Forward bars", minval = 1, maxval = 200, group = G9R, inline = "rs")
mdRMax = input.int(60, "max open events", minval = 10, maxval = 300, group = G9R, inline = "rs",
     tooltip = "How many bars each print is followed for, and how many can be tracked at once. Events beyond the cap are dropped oldest-first and never counted, so raise it if prints are frequent and the window is long.")
mdRCtrl = input.int(50, "Control: sample every N bars", minval = 0, maxval = 500, group = G9R,
     tooltip = "The number that makes the rest mean something. Ordinary bars are sampled at this interval and measured identically, giving a baseline. Average MFE of 0.6R sounds impressive until the control says ordinary bars also do 0.6R. 0 turns the control off, and then the print numbers have nothing to be compared against.")
mdRUnit = input.string("ATR", "Measure in", options = ["ATR", "Event range (R)"], group = G9R,
     tooltip = "ATR (recommended): every event is measured in ATR(14) at the time it fired, so prints and control bars share one yardstick. Event range: each event is measured in its own high-to-low range. That reads naturally for a single print, but it makes the control column meaningless — control bars are ordinary-sized, so their smaller denominator inflates their numbers against the much larger MDP bars. Use ATR whenever you are comparing the columns.")
mdRFrom = input.string("Bar close", "Measure from", options = ["Bar close", "Range edge"], group = G9R,
     tooltip = "Where the forward measurement starts. Bar close (recommended): from the event bar's close, like an entry. Range edge: from the print's high or low, so 0 means no progress beyond the bar itself.\n\nEdge looks natural for a single print but it is unfair in the control column: an MDP bar is far wider than an ordinary bar, so its edge sits much further from its close, and it starts every measurement deep in the hole. The same bias explains part of the hit-high and hit-low gap — a wide bar's extremes are simply further away and get touched less often, whatever the level means.")
mdShowPanel = input.bool(true, "Show research panel", group = G9R,
     tooltip = "Research mode runs the measurement; this shows or hides its table. Turn the panel off to keep collecting without the box on your chart.")
mdRPos = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = G9R)

// ── Resolution: delta TF, chart seconds, auto intrabar ladder ────────────────
int chartSec = timeframe.in_seconds(timeframe.period)
string dTf = autoRaiseTf and timeframe.in_seconds(htfTf) < chartSec ? timeframe.period : htfTf
if not autoRaiseTf and timeframe.in_seconds(htfTf) < chartSec
    runtime.error("Delta timeframe is below the chart timeframe. Raise the delta timeframe or enable auto-raise.")
tfStrOf(int sec) =>
    sec < 60 ? str.tostring(sec) + "S" : str.tostring(sec / 60)
int budgetBars = dataBudget == "200K (Ultimate)" ? 200000 : dataBudget == "125K (Expert)" ? 125000 : dataBudget == "50K (replay-safe)" ? 50000 : dataBudget == "25K (memory saver)" ? 25000 : 100000
int needSec = math.max(int(lenN * timeframe.in_seconds(dTf) * histMult), 172800)
var int[] ladder = array.from(1, 5, 10, 15, 30, 60, 300, 900)
int autoSec = 0
for c in ladder
    if autoSec == 0 and budgetBars * c >= needSec and c < chartSec
        autoSec := c
// memory saver: requesting the CHART timeframe from security_lower_tf returns a
// one-element array per bar — no intrabar data is fetched or held at all.
string ltf = memSaver ? timeframe.period : (useAutoLtf ? (autoSec > 0 ? tfStrOf(autoSec) : "1") : manualLtf)
signedVol() =>
    float v = nz(volume)
    float out = 0.0
    if close > open
        out := v
    else if close < open
        out := -v
    else if close > close[1]
        out := v
    else if close < close[1]
        out := -v
    out

// footprint first (unconditional); estimate requested only when needed (dynamic request)
// unconditional: this exact call is compiler-proven on the account. In
// "Estimate only" mode the result is simply ignored (fpOk gates it below).
footprint fp = request.footprint(fpTicks, 70, 300)
bool fpOk = deltaSrc != "Estimate only" and not na(fp)
// ONE intrabar pull serves everything: signed volume (estimate-path delta),
// close + volume (POC profiles). Three separate calls previously fetched the
// same intrabars three times over — this is a 3× saving on the intrabar budget.
[ivS, pocIvC, pocIvV] = request.security_lower_tf(syminfo.tickerid, ltf, [signedVol(), close, nz(volume)])

// ── Per-bar delta ────────────────────────────────────────────────────────────
float barBuy  = 0.0
float barSell = 0.0
if fpOk
    barBuy  := nz(fp.buy_volume())
    barSell := nz(fp.sell_volume())
else
    int nIB = array.size(ivS)
    if nIB > 0
        for i = 0 to nIB - 1
            float sv = nz(array.get(ivS, i))
            if sv > 0
                barBuy += sv
            else
                barSell -= sv
    else
        float v0 = nz(volume)
        barBuy  := close > open ? v0 : 0.0
        barSell := close < open ? v0 : 0.0
float barDelta = barBuy - barSell

// ── MDP engine — candle override, rides on whichever paint mode is active ────
bool mdpPaintOn = mMdp

string mdTz = mdTzIn == "Exchange" ? syminfo.timezone : mdTzIn
bool mdInSess = not na(time(timeframe.period, mdSessStr, mdTz))
// session open is read from the CLOCK: on a 17:00-16:00 session every bar is
// inside the session, so "inSess turned on" would fire once and never again
int mdOpenMin = int(nz(str.tonumber(str.substring(mdSessStr, 0, 2)), 17)) * 60 +
     int(nz(str.tonumber(str.substring(mdSessStr, 2, 4)), 0))
int mdMinOfDay = hour(time, mdTz) * 60 + minute(time, mdTz)
bool mdDailyPlus = timeframe.in_seconds() >= 86400
bool mdNewSess = mdDailyPlus ? barstate.isnew :
     mdMinOfDay >= mdOpenMin and (mdMinOfDay[1] < mdOpenMin or mdMinOfDay[1] > mdMinOfDay)
// slot comes from the clock, not a bar counter: a chart with missing bars would
// drift a counter out of alignment, so the same session minute would stop
// mapping to the same bucket
int mdTfSec = math.max(1, timeframe.in_seconds())
int mdElapsed = (mdMinOfDay - mdOpenMin) * 60
if mdElapsed < 0
    mdElapsed += 86400
int mdSlot = mdInSess ? math.min(4999, math.max(0, int(math.floor(mdElapsed / mdTfSec)))) : -1

float mdVol = barBuy + barSell > 0 ? barBuy + barSell : nz(volume)
float mdAbs = math.abs(nz(barDelta))
float mdEffPct = mdVol > 0 ? mdAbs / mdVol : na

// rolling baseline — set in hours so it spans the same market time on any chart
// clamped at 300: eight rolling medians run off this length on every bar. A
// median over 300 samples is stable; longer windows cost real memory to move the
// number by noise. Matches max_bars_back, so the buffer reserved and the history
// requested are the same size.
int mdBaseBars = math.min(300, math.max(20, int(math.round(mdBaseHours * 3600 / timeframe.in_seconds()))))
// modified z (median/MAD): the outlier being measured barely moves the yardstick,
// where a mean/stdev z is inflated by the very print it is meant to flag
float mdMed = ta.median(barDelta, mdBaseBars)
float mdMad = ta.median(math.abs(barDelta - mdMed), mdBaseBars)
float mdVolSma = ta.sma(mdVol, mdBaseBars)
float mdZ = not na(mdMad) and mdMad > 0 ? math.abs(0.6745 * (barDelta - mdMed) / mdMad) : na

// time-of-day slots: one per bar-of-session, EMA of volume and |delta|.
// ORDER MATTERS: the baseline is READ before this bar is folded into it. Doing
// it the other way lets a huge bar inflate the very average it is measured
// against, which quietly hides the prints this engine exists to find — the same
// masking the modified z-score avoids on the delta side.
var array<float> mdTodVol = array.new_float(0)
var array<float> mdTodDel = array.new_float(0)
var array<int> mdTodN = array.new_int(0)
if mdTodSess > 0 and mdInSess and mdSlot >= 0
    while array.size(mdTodVol) <= mdSlot
        array.push(mdTodVol, na)
        array.push(mdTodDel, na)
        array.push(mdTodN, 0)
bool mdSlotReady = mdTodSess > 0 and mdSlot >= 0 and mdSlot < array.size(mdTodN) and array.get(mdTodN, mdSlot) >= mdTodWarm
float mdSlotVol = mdSlotReady ? array.get(mdTodVol, mdSlot) : na
float mdSlotDel = mdSlotReady ? array.get(mdTodDel, mdSlot) : na
float mdRelVol = mdSlotReady and mdSlotVol > 0 ? mdVol / mdSlotVol : (not na(mdVolSma) and mdVolSma > 0 ? mdVol / mdVolSma : na)
float mdRelDel = mdSlotReady and mdSlotDel > 0 ? mdAbs / mdSlotDel : na
// now fold this bar into its slot, after it has been judged against the others
if mdTodSess > 0 and mdInSess and mdSlot >= 0
    int mn = array.get(mdTodN, mdSlot)
    float mAlpha = 2.0 / (math.min(mdTodSess, mn + 1) + 1.0)
    float mpv = array.get(mdTodVol, mdSlot)
    float mpd = array.get(mdTodDel, mdSlot)
    array.set(mdTodVol, mdSlot, na(mpv) ? mdVol : mpv + mAlpha * (mdVol - mpv))
    array.set(mdTodDel, mdSlot, na(mpd) ? mdAbs : mpd + mAlpha * (mdAbs - mpd))
    array.set(mdTodN, mdSlot, mn + 1)

// effort vs result: volume per tick of range. Huge size that barely moves price
// is absorption — someone large filling passively while the aggressor exhausts.
float mdRngTicks = math.max(1.0, (high - low) / syminfo.mintick)
float mdEffort = mdVol / mdRngTicks
float mdMedEffort = ta.median(mdEffort, mdBaseBars)
float mdMedRng = ta.median(mdRngTicks, mdBaseBars)
float mdMedAbs = ta.median(mdAbs, mdBaseBars)
float mdMedEffPct = ta.median(mdEffPct, mdBaseBars)
float mdEffortRatio = not na(mdMedEffort) and mdMedEffort > 0 ? mdEffort / mdMedEffort : na
float mdRangeRatio = not na(mdMedRng) and mdMedRng > 0 ? mdRngTicks / mdMedRng : na
// body measure: a bar that travels hard both ways and closes near its open is
// absorption with a WIDE range — the range test alone never sees it
float mdBodyTicks = math.max(1.0, math.abs(close - open) / syminfo.mintick)
float mdEffortB = mdVol / mdBodyTicks
float mdMedEffortB = ta.median(mdEffortB, mdBaseBars)
float mdMedBody = ta.median(mdBodyTicks, mdBaseBars)
float mdEffortBRatio = not na(mdMedEffortB) and mdMedEffortB > 0 ? mdEffortB / mdMedEffortB : na
float mdBodyRatio = not na(mdMedBody) and mdMedBody > 0 ? mdBodyTicks / mdMedBody : na
// every part is a multiple of its own baseline, so nothing caps: a print twice
// as extreme as the incumbent scores twice as high instead of tying at the top
float mdMagRatio = not na(mdMedAbs) and mdMedAbs > 0 ? mdAbs / mdMedAbs : na
float mdEffRatio = not na(mdMedEffPct) and mdMedEffPct > 0 ? mdEffPct / mdMedEffPct : na
float mdAnomRatio = mdSlotReady and not na(mdRelDel) ? mdRelDel : mdZ
float mdComposite = (0.40 * nz(mdMagRatio) + 0.30 * nz(mdAnomRatio) + 0.30 * nz(mdEffRatio))

float mdMinZ = switch mdSens
    "Fast"    => 2.0
    "Average" => 3.5
    => 5.0
float mdMinEffort = switch mdSens
    "Fast"    => 1.5
    "Average" => 2.0
    => 3.0
float mdMaxRange = switch mdSens
    "Fast"    => 0.85
    "Average" => 0.70
    => 0.55
float mdMinRelVol = switch mdSens
    "Fast"    => 1.2
    "Average" => 1.6
    => 2.5

bool mdStatsReady = not na(mdZ) and not na(mdRelVol) and not na(mdComposite)
bool mdAggrPass = mdStatsReady and mdZ >= mdMinZ and mdRelVol >= mdMinRelVol and mdAbs >= mdMinDelta
bool mdAbsByRange = mdAbsMode != "Body" and not na(mdEffortRatio) and not na(mdRangeRatio) and
     mdEffortRatio >= mdMinEffort and mdRangeRatio <= mdMaxRange
bool mdAbsByBody = mdAbsMode != "Range" and not na(mdEffortBRatio) and not na(mdBodyRatio) and
     mdEffortBRatio >= mdMinEffort and mdBodyRatio <= mdMaxRange
bool mdAbsPass = mdStatsReady and mdRelVol >= mdMinRelVol and (mdAbsByRange or mdAbsByBody)
// an absorption print is ranked on whichever measure it actually qualified on
float mdAbsEffort = mdAbsByRange and mdAbsByBody ? math.max(nz(mdEffortRatio), nz(mdEffortBRatio)) :
     mdAbsByBody ? nz(mdEffortBRatio) : nz(mdEffortRatio)
bool mdOkAggr = mdType != "Absorption only"
bool mdOkAbs = mdType != "Aggression only"
bool mdAbsOnly = mdAbsPass and mdOkAbs and not (mdAggrPass and mdOkAggr)
bool mdBoth = mdAbsPass and mdOkAbs and mdAggrPass and mdOkAggr
bool mdIsAbs = mdAbsOnly or (mdBoth and mdAbsEffort > nz(mdComposite))
bool mdQualified = mdpPaintOn and mdInSess and ((mdAggrPass and mdOkAggr) or (mdAbsPass and mdOkAbs))
float mdCandScore = mdIsAbs ? mdAbsEffort : mdComposite

// Each type keeps its OWN incumbent. The two scores are not on one scale — a
// composite (aggression) runs about 5.7 where an effort ratio (absorption) runs
// about 3.7 — so a single incumbent let the first aggression print of the session
// lock absorption out for the rest of it: a qualifying absorption bar cleared a
// typical aggression incumbent only 20% of the time. Competing like against like
// removes the comparison instead of trying to rescale one into the other.
var float mdScoreAgg = na
var float mdScoreAbs = na
if mdNewSess and mdReset
    mdScoreAgg := na
    mdScoreAbs := na
float mdIncumbent = mdIsAbs ? mdScoreAbs : mdScoreAgg
// >= not > : ties go to the newer print, which is the more relevant one
bool mdBetter = na(mdIncumbent) or mdCandScore >= mdIncumbent
bool mdAccept = mdQualified and mdBetter and (mdConfirm ? barstate.isconfirmed : true)
if mdAccept
    if mdIsAbs
        mdScoreAbs := mdCandScore
    else
        mdScoreAgg := mdCandScore

// level ladder on the current print — cleared and rebuilt when a print lands
var array<line> mdLnArr = array.new_line(0)
var array<label> mdLnLbls = array.new_label(0)
var float mdHi = na
var float mdLo = na
if mdAccept
    mdHi := high
    mdLo := low
    while array.size(mdLnArr) > 0
        line.delete(array.shift(mdLnArr))
    while array.size(mdLnLbls) > 0
        label.delete(array.shift(mdLnLbls))
    if mMdpLines and mdpPaintOn
        float rng = mdHi - mdLo
        if rng > 0
            array<string> parts = str.split(mdLevels, ",")
            int np = array.size(parts)
            if np > 0
                for i = 0 to np - 1
                    float r = str.tonumber(str.trim(array.get(parts, i)))
                    if not na(r)
                        float px = mdLo + rng * r
                        color lc = r > 1.0 ? mdLnAbove : r < 0.0 ? mdLnBelow : mdLnInside
                        array.push(mdLnArr, line.new(bar_index, px, bar_index + 1, px, color = lc, width = mdLnW, extend = extend.right))
                        if mdLnLbl
                            array.push(mdLnLbls, label.new(bar_index + 1, px, str.tostring(r), style = label.style_none,
                                 textcolor = lc, size = size.tiny))
// lines carry extend.right, so they reach the newest bar without being rewritten
// every bar; only the ratio labels need repositioning, and only on the last bar
if barstate.islast and array.size(mdLnLbls) > 0
    for i = 0 to array.size(mdLnLbls) - 1
        label.set_x(array.get(mdLnLbls, i), bar_index + 1)

// signals under the qualifying candle — colour follows the print's own type
var array<label> mdSigs = array.new_label(0)
if mdAccept and mdSigOn and mdSigKeep > 0
    // the arrow is the DELTA side, not the candle direction. On an absorption bar
    // delta is small by definition, so it reads as a lean rather than conviction.
    string mdSide = barDelta > 0 ? " Δ▲" : barDelta < 0 ? " Δ▼" : " Δ="
    string mdTxt = mdSigStyle == "Marker only" ? "" :
         (mdIsAbs ? (mdSigStyle == "Short" ? "ABS" : "ABSORPTION") :
         (mdSigStyle == "Short" ? "AGG" : "AGGRESSION")) + mdSide
    array.push(mdSigs, label.new(bar_index, low, mdTxt, xloc = xloc.bar_index, yloc = yloc.belowbar,
         style = mdSigStyle == "Marker only" ? label.style_triangleup : label.style_label_up,
         color = mdIsAbs ? mdColAbs : mdColAgg, textcolor = color.white,
         size = mdSigSize == "Tiny" ? size.tiny : mdSigSize == "Small" ? size.small : mdSigSize == "Normal" ? size.normal : size.large))
// the print that just fell out of the text window keeps its marker, loses its text
if mdAccept and array.size(mdSigs) > mdSigText
    label old = array.get(mdSigs, array.size(mdSigs) - 1 - mdSigText)
    label.set_text(old, "")
    label.set_style(old, label.style_triangleup)
while array.size(mdSigs) > mdSigKeep
    label.delete(array.shift(mdSigs))

// ── POC profile engine (Delta size / Delta size HTF) — intrabar volume-at-price,
// independent of footprint availability (see tooltip above). ────────────────
int nPocIB = memSaver ? 0 : math.min(array.size(pocIvC), array.size(pocIvV))
float pocBinSize = pocBinTicks * syminfo.mintick
addBin(map<int, float> m, int k, float v) =>
    map.put(m, k, (map.contains(m, k) ? map.get(m, k) : 0.0) + v)
pocOf(map<int, float> m) =>
    float best = -1.0
    int bestK = 0
    array<int> ks = map.keys(m)
    for k in ks
        float v = map.get(m, k)
        if v > best
            best := v
            bestK := k
    best > 0 ? bestK * pocBinSize : na
f_binProfile(map<int, float> m, int startBack, simple int n) =>
    // n = 0 must do nothing: `for i = 0 to -1` counts DOWN in Pine and would read high[-1]
    if n > 0
        for i = startBack to startBack + n - 1
            float hi = high[i]
            float lo = low[i]
            float vo = nz(volume[i])
            if not na(hi) and not na(lo) and vo > 0
                int bHi = math.round(hi / pocBinSize)
                int bLo = math.round(lo / pocBinSize)
                // 60 slices per bar instead of 200: this loop runs for every bar of every
                // window profile inside three request contexts, so it is the heaviest thing
                // in the script. Past ~60 slices the POC and value area stop moving.
                int span = math.max(1, bHi - bLo + 1)
                int steps = math.min(span, 60)
                float per = vo / steps
                float stepSz = span * 1.0 / steps
                for k = 0 to steps - 1
                    int b = bLo + math.round(k * stepSz)
                    map.put(m, b, (map.contains(m, b) ? map.get(m, b) : 0.0) + per)
// value area: expand from the POC bin toward the heavier side until vaPct of
// the session's volume is inside. Returns [VAH, VAL] in price.
f_valueArea(map<int, float> m, int pct) =>
    float vah = na
    float val = na
    array<int> ks = map.keys(m)
    int n = array.size(ks)
    if n > 0
        array.sort(ks)
        array<float> vs = array.new_float(n, 0.0)
        float total = 0.0
        int pocIdx = 0
        float best = -1.0
        for i = 0 to n - 1
            float v = map.get(m, array.get(ks, i))
            array.set(vs, i, v)
            total += v
            if v > best
                best := v
                pocIdx := i
        float acc = array.get(vs, pocIdx)
        int up = pocIdx + 1
        int dn = pocIdx - 1
        float target = total * pct / 100.0
        while acc < target and (up < n or dn >= 0)
            float vUp = up < n ? array.get(vs, up) : -1.0
            float vDn = dn >= 0 ? array.get(vs, dn) : -1.0
            if vUp >= vDn
                acc += vUp
                up += 1
            else
                acc += vDn
                dn -= 1
        vah := array.get(ks, up - 1) * pocBinSize
        val := array.get(ks, dn + 1) * pocBinSize
        if vah <= val
            vah := vah + pocBinSize / 2.0
            val := val - pocBinSize / 2.0
    [vah, val]
// current window's [poc, vah, val], the POC of the same-sized window migBack
// bars back, and the POC of the previous non-overlapping window — all built in
// ONE request context, returned as floats only (never a map across the boundary).
f_windowProfile(simple int n, simple int migBack, simple bool wantPrev) =>
    map<int, float> prof = map.new<int, float>()
    f_binProfile(prof, 0, n)
    float poc = pocOf(prof)
    [vah, val] = f_valueArea(prof, vaPct)
    // migration reference: same-sized window migBack bars back (skipped if 0)
    float pocBack = na
    if migBack > 0
        map<int, float> profBack = map.new<int, float>()
        f_binProfile(profBack, migBack, n)
        pocBack := pocOf(profBack)
    // prior-period reference: the PREVIOUS non-overlapping window (shifted by n)
    float pocPrevWin = na
    if wantPrev
        map<int, float> profPrev = map.new<int, float>()
        f_binProfile(profPrev, n, n)
        pocPrevWin := pocOf(profPrev)
    [poc, vah, val, pocBack, pocPrevWin]
// this single chart bar's own POC (for the "Delta size" bar-level mode)
var map<int, float> barProf = map.new<int, float>()
map.clear(barProf)
if nPocIB > 0
    for i = 0 to nPocIB - 1
        float pc = array.get(pocIvC, i)
        float vv = nz(array.get(pocIvV, i))
        if not na(pc)
            addBin(barProf, math.round(pc / pocBinSize), vv)
else if not memSaver
    addBin(barProf, math.round(close / pocBinSize), nz(volume))
float barPocNow = pocOf(barProf)
// Bias row: array-based rolling window on CHART bars only, independent of the
// POC trend row's source setting. Same pattern as deltaHist/pvHist elsewhere —
// push/shift capped arrays, so the lookback is memory-free regardless of size
// and isn't bounded by max_bars_back (which stays small for Replay mode).
var array<float> biasPocHist = array.new_float()
var array<float> biasDeltaHist = array.new_float()
array.push(biasPocHist, nz(barPocNow, array.size(biasPocHist) > 0 ? array.get(biasPocHist, array.size(biasPocHist) - 1) : close))
array.push(biasDeltaHist, nz(barDelta))
if array.size(biasPocHist) > biasLook
    array.shift(biasPocHist)
    array.shift(biasDeltaHist)
[barVahNow, barValNow] = f_valueArea(barProf, vaPct)

f_pocColor(float px, float anchor, float rng, float dlt, float avgAbs) =>
    color result = colNeut
    if not na(anchor) and not na(rng) and rng > 0
        float bandW = rng * (pocBandPct / 100.0)
        float rampW = rng * (pocRampPct / 100.0)
        float dist = px - anchor
        if math.abs(dist) <= bandW
            float centering = 1.0 - math.abs(dist) / bandW
            float dq = avgAbs > 0 ? 1.0 - math.min(1.0, math.abs(dlt) / avgAbs) : 0.5
            float depth = math.max(0.0, math.min(1.0, (centering + dq) / 2.0))
            int transp = int(math.round(70 - depth * 70))
            result := color.new(colNeut, transp)
        else
            float beyond = math.abs(dist) - bandW
            float frac = math.max(0.0, math.min(1.0, beyond / math.max(syminfo.mintick, rampW)))
            bool greenZone = dist > 0
            bool aligned = (greenZone and dlt > 0) or (not greenZone and dlt < 0)
            float adj = aligned ? math.min(1.0, frac + pocAlignBoost) : frac * (1.0 - pocAlignBoost)
            result := greenZone ? color.from_gradient(adj, 0, 1, colNeut, colBull) : color.from_gradient(adj, 0, 1, colNeut, colBear)
    result

// ── Delta-TF candle state ────────────────────────────────────────────────────
var float liveDelta = 0.0
var float liveBuy   = 0.0
var float liveSell  = 0.0
var float htfOpen   = na
var array<float> deltaHist = array.new_float()
var float htfHiPoc = na
var float htfLoPoc = na
var float prevHtfPocVal = na
var float prevHtfRangeVal = na
var float prevHtfVah = na
var float prevHtfVal = na
var map<int, float> htfProf = map.new<int, float>()
bool htfRoll = timeframe.change(dTf)
if htfRoll
    if not na(htfOpen)
        array.push(deltaHist, liveDelta)
        if array.size(deltaHist) > lenN
            array.shift(deltaHist)
        prevHtfPocVal := pocOf(htfProf)
        prevHtfRangeVal := (na(htfHiPoc) or na(htfLoPoc)) ? na : (htfHiPoc - htfLoPoc)
        [hv, lv] = f_valueArea(htfProf, vaPct)
        prevHtfVah := hv
        prevHtfVal := lv
    liveDelta := 0.0
    liveBuy := 0.0
    liveSell := 0.0
    htfOpen := open
    htfHiPoc := na
    htfLoPoc := na
    htfProf := map.new<int, float>()
liveDelta += nz(barDelta)
liveBuy   += nz(barBuy)
liveSell  += nz(barSell)
htfHiPoc := na(htfHiPoc) ? high : math.max(htfHiPoc, high)
htfLoPoc := na(htfLoPoc) ? low : math.min(htfLoPoc, low)
if nPocIB > 0
    for i = 0 to nPocIB - 1
        float pc3 = array.get(pocIvC, i)
        float vv3 = nz(array.get(pocIvV, i))
        if not na(pc3)
            addBin(htfProf, math.round(pc3 / pocBinSize), vv3)
else if not memSaver
    addBin(htfProf, math.round(close / pocBinSize), nz(volume))

// ── Rolling VWAP over N delta-TF candles — ring buffer, running sums ────────
int winBars = math.min(4000, math.max(1, math.round(lenN * timeframe.in_seconds(dTf) / chartSec)))
var array<float> rbV  = array.new_float()
var array<float> rbPv = array.new_float()
var array<float> rbP2 = array.new_float()
var float vSum  = 0.0
var float pvSum = 0.0
var float p2Sum = 0.0
float vNow  = nz(volume)
float pvNow = hlc3 * vNow
float p2Now = hlc3 * hlc3 * vNow
bool commit = barstate.isconfirmed or barstate.ishistory
if commit
    array.push(rbV, vNow)
    array.push(rbPv, pvNow)
    array.push(rbP2, p2Now)
    vSum  += vNow
    pvSum += pvNow
    p2Sum += p2Now
    while array.size(rbV) > winBars
        vSum  -= array.shift(rbV)
        pvSum -= array.shift(rbPv)
        p2Sum -= array.shift(rbP2)
// live window: on the forming bar, add it AND drop the oldest stored bar so the
// window is always exactly winBars (previously winBars + 1 while a bar formed)
bool rbFull = array.size(rbV) >= winBars
float oldV  = not commit and rbFull ? array.get(rbV, 0)  : 0.0
float oldPv = not commit and rbFull ? array.get(rbPv, 0) : 0.0
float oldP2 = not commit and rbFull ? array.get(rbP2, 0) : 0.0
float vSumL  = commit ? vSum  : vSum  + vNow  - oldV
float pvSumL = commit ? pvSum : pvSum + pvNow - oldPv
float p2SumL = commit ? p2Sum : p2Sum + p2Now - oldP2
float rvwap = vSumL > 0 ? pvSumL / vSumL : na
float rvar  = vSumL > 0 ? math.max(0.0, p2SumL / vSumL - rvwap * rvwap) : na
float rsd   = na(rvar) ? na : math.sqrt(rvar)
// visual smoothing (calls unconditional)
float rvwapS = ta.ema(rvwap, vwapSmooth)
float rsdS   = ta.ema(rsd, vwapSmooth)

// ── EMA + smoothing MA (TradingView standard) ────────────────────────────────
float emaRaw = ta.ema(emaSrc, emaLen)
float emaOut = ta.ema(emaRaw, emaSmooth)
ma(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)
float smoothingMA    = enableMA ? ma(emaOut, maLengthInput, maTypeInput) : na
float smoothingStDev = isBB ? ta.stdev(emaOut, maLengthInput) * bbMultInput : na

// ── DWM period detection (intraday: session-open hour; D+: symbol session) ──
int hrNow = hour(time, syminfo.timezone)
bool newDManual = hrNow == sessOpenHr and (na(hrNow[1]) or hrNow[1] != sessOpenHr)
bool newD = chartSec <= 3600 ? (sessDetect == "Manual hour" ? newDManual : session.isfirstbar) : timeframe.change("D")
// Intraday: week/month boundaries derive from the session-open day (week-start
// input honoured). Daily and above: use TradingView's own W/M boundaries, which
// are correct regardless of how the exchange stamps daily bar times.
bool dailyPlus = chartSec >= 86400
int dowNow = dayofweek(time, syminfo.timezone)
bool newW = dailyPlus ? timeframe.change("W") : newD and dowNow == (weekStartDay == "Sunday" ? dayofweek.sunday : dayofweek.monday)
var int lastMo = na
bool newM = false
if dailyPlus
    newM := timeframe.change("M")
else if newD
    int moNow = month(time, syminfo.timezone)
    newM := not na(lastMo) and moNow != lastMo
    lastMo := moNow

// period high/low tracking → previous completed values
var float curDH = na
var float curDL = na
var float prevDH = na
var float prevDL = na
var float curWH = na
var float curWL = na
var float prevWH = na
var float prevWL = na
var float curMH = na
var float curML = na
var float prevMH = na
var float prevML = na
var int curDStart = na
var int prevDStart = na
var int curWStart = na
var int prevWStart = na
var int curMStart = na
var int prevMStart = na
var map<int, float> sessProf = map.new<int, float>()
if newD
    prevDH := curDH
    prevDL := curDL
    prevDStart := curDStart
    curDStart := bar_index
    curDH := high
    curDL := low
    sessProf := map.new<int, float>()
else
    curDH := na(curDH) ? high : math.max(curDH, high)
    curDL := na(curDL) ? low : math.min(curDL, low)
if nPocIB > 0
    for i = 0 to nPocIB - 1
        float pcS = array.get(pocIvC, i)
        float vvS = nz(array.get(pocIvV, i))
        if not na(pcS)
            addBin(sessProf, math.round(pcS / pocBinSize), vvS)
else if not memSaver
    addBin(sessProf, math.round(close / pocBinSize), nz(volume))
float sessPoc = pocOf(sessProf)

// ── shared window profile for POC trend / VA width / Release ────────────────
string ptTfRaw = ptTf == "1 hour" ? "60" : ptTf == "2 hours" ? "120" : ptTf == "4 hours" ? "240" : ptTf == "1 day" ? "D" : ptTf == "1 week" ? "W" : "M"
string ptTfEff = memSaver or timeframe.in_seconds(ptTfRaw) < chartSec ? timeframe.period : ptTfRaw
[ptWinPoc, ptWinVah, ptWinVal, ptWinPocBack, ptWinPocPrev] = request.security(syminfo.tickerid, ptTfEff, f_windowProfile(memSaver ? 0 : ptLook, ptMigBack, ptPrevBoost > 0), lookahead = barmerge.lookahead_off)

// Delta size HTF reference: one profile over the last N candles of the DELTA
// timeframe — the same 1H × N the VWAP window and the paint scale already use,
// so changing either in the Delta Engine moves this band with it.
[hwPoc, hwVah, hwVal, hwBack, hwPrev] = request.security(syminfo.tickerid, memSaver ? timeframe.period : dTf, f_windowProfile(memSaver ? 0 : lenN, htfMigK, false), lookahead = barmerge.lookahead_off)

string valocTfRaw = valocTf == "1 hour" ? "60" : valocTf == "2 hours" ? "120" : valocTf == "4 hours" ? "240" : valocTf == "1 day" ? "D" : valocTf == "1 week" ? "W" : "M"
string valocTfEff = memSaver or timeframe.in_seconds(valocTfRaw) < chartSec ? timeframe.period : valocTfRaw
// when VA Location points at the same timeframe AND lookback as the shared
// POC-trend profile, this request rebuilds an identical profile — reuse that
// one's result instead of paying for the same work twice
bool valocSame = valocTfEff == ptTfEff and valocLook == ptLook
[valocPocR, valocVahR, valocValR, valocBack, valocPrev] = request.security(syminfo.tickerid, valocTfEff, f_windowProfile(memSaver or not (bxVaLoc or bxPocLoc) ? 0 : valocLook, 0, false), lookahead = barmerge.lookahead_off)
float valocPoc = valocSame ? ptWinPoc : valocPocR
float valocVah = valocSame ? ptWinVah : valocVahR
float valocVal = valocSame ? ptWinVal : valocValR
bool valocOk = not na(valocVah) and not na(valocVal) and not na(valocPoc) and valocVah > valocVal
float valocTolPx = valocPocTol * syminfo.mintick
float valocW = valocOk ? valocVah - valocVal : na
float valocInPct = valocOk ? math.max(0.0, math.min(1.0, (close - valocVal) / valocW)) * 100 : na
float valocPPct = valocOk ? (close - valocPoc) / valocW * 100 : na
float valocPocPct = valocOk ? math.max(0.0, math.min(1.0, (valocPoc - valocVal) / valocW)) * 100 : na
// state: 2 above VAH · 1 at VAH · 3 at POC · 0 inside · -1 at VAL · -2 below VAL
// POC wins over an edge touch when the two sit within the tolerance of each other
int valocState = not valocOk ? 99 : math.abs(close - valocPoc) <= valocTolPx ? 3 : math.abs(close - valocVah) <= valocTolPx ? 1 : math.abs(close - valocVal) <= valocTolPx ? -1 : close > valocVah ? 2 : close < valocVal ? -2 : 0
string valocPTxt = valocOk ? "P" + (valocPPct >= 0 ? "+" : "") + str.tostring(math.round(valocPPct)) + "%" : ""
// VA Location row — where price sits against the value area
string valocLbl = valocState == 99 ? "—" : close > valocVah ? "Above VAH" : close < valocVal ? "Below VAL" : "Inside " + str.tostring(math.round(valocInPct)) + "%"
color valocCol = valocState == 99 ? color.gray : close > valocVah ? colBull : close < valocVal ? colBear : colNeut
// POC Location row — signed distance from that profile's POC, % of value-area width
string pocLocLbl = valocState == 99 ? "—" : valocState == 3 ? "POC" : valocPTxt
color pocLocCol = valocState == 99 ? color.gray : #ff6a00

[sessVah, sessVal] = f_valueArea(sessProf, vaPct)
if newW
    prevWH := curWH
    prevWL := curWL
    prevWStart := curWStart
    curWStart := bar_index
    curWH := high
    curWL := low
else
    curWH := na(curWH) ? high : math.max(curWH, high)
    curWL := na(curWL) ? low : math.min(curWL, low)
if newM
    prevMH := curMH
    prevML := curML
    prevMStart := curMStart
    curMStart := bar_index
    curMH := high
    curML := low
else
    curMH := na(curMH) ? high : math.max(curMH, high)
    curML := na(curML) ? low : math.min(curML, low)


// ── Asian range engine (Stryk: Ranges, verbatim; tail reconstructed) ─────────
// Asian range needs bars inside the overnight window — it cannot form on daily
// or higher charts, and is coarse on 4H. Off automatically at daily and above.
bool showAsian = mAsian and asianOn and chartSec < 86400 and not memSaver
f_hhmm(s) => str.tonumber(str.substring(s, 0, 2)) * 60 + str.tonumber(str.substring(s, 2, 4))
aStart = f_hhmm(asianStart)
aEnd = f_hhmm(asianEnd)
curMin = hour * 60 + minute
inAsian = aStart > aEnd ? (curMin >= aStart or curMin < aEnd) : (curMin >= aStart and curMin < aEnd)
newAsian = inAsian and not inAsian[1]
endAsian = not inAsian and inAsian[1]
var float asianHi = na
var float asianLo = na
var int asianStartBar = na
var int asianStartTime = na
var array<line> asianHiLines = array.new<line>()
var array<line> asianLoLines = array.new<line>()
var array<label> asianHiLbls = array.new<label>()
var array<label> asianLoLbls = array.new<label>()
if newAsian
    asianHi := high
    asianLo := low
    asianStartBar := bar_index
    asianStartTime := time
else if inAsian
    asianHi := math.max(asianHi, high)
    asianLo := math.min(asianLo, low)
var line liveHiLine = na
var line liveLoLine = na
if showAsian and inAsian
    if newAsian
        liveHiLine := line.new(asianStartBar, asianHi, bar_index, asianHi, color = color.new(asianColor, 35), width = asianWidth, style = line.style_dotted)
        liveLoLine := line.new(asianStartBar, asianLo, bar_index, asianLo, color = color.new(asianColor, 35), width = asianWidth, style = line.style_dotted)
    if not na(liveHiLine)
        line.set_xy1(liveHiLine, asianStartBar, asianHi)
        line.set_xy2(liveHiLine, bar_index, asianHi)
        line.set_xy1(liveLoLine, asianStartBar, asianLo)
        line.set_xy2(liveLoLine, bar_index, asianLo)
var line activeHiLine = na
var line activeLoLine = na
if newAsian
    activeHiLine := na
    activeLoLine := na
bool newTradingDay = timeframe.change("D")
if newTradingDay
    activeHiLine := line(na)
    activeLoLine := line(na)
    if not na(liveHiLine)
        line.delete(liveHiLine)
        line.delete(liveLoLine)
        liveHiLine := na
        liveLoLine := na
if showAsian and endAsian and not na(asianHi)
    if not na(liveHiLine)
        line.delete(liveHiLine)
        line.delete(liveLoLine)
        liveHiLine := na
        liveLoLine := na
    line hiLn = line.new(asianStartTime, asianHi, time, asianHi, xloc = xloc.bar_time, color = asianColor, width = asianWidth)
    line loLn = line.new(asianStartTime, asianLo, time, asianLo, xloc = xloc.bar_time, color = asianColor, width = asianWidth)
    if asianEndOfDay
        activeHiLine := hiLn
        activeLoLine := loLn
    array.push(asianHiLines, hiLn)
    array.push(asianLoLines, loLn)
    if showAsianLabels
        array.push(asianHiLbls, label.new(time, asianHi, "Asia High", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
        array.push(asianLoLbls, label.new(time, asianLo, "Asia Low", xloc = xloc.bar_time, textcolor = color.white, size = size.small))
    while array.size(asianHiLines) > asianShow
        line.delete(array.shift(asianHiLines))
        line.delete(array.shift(asianLoLines))
    while array.size(asianHiLbls) > asianShow
        label.delete(array.shift(asianHiLbls))
        label.delete(array.shift(asianLoLbls))
// extension tail: end-of-chart keeps every stored range at the newest bar;
// end-of-day keeps only the current day's confirmed pair extending until the roll
int asProjMs = (dwmProject ? dwmProjBars : 0) * timeframe.in_seconds() * 1000
if showAsian
    if asianEndOfChart
        int nA = array.size(asianHiLines)
        if nA > 0
            for i = 0 to nA - 1
                line.set_x2(array.get(asianHiLines, i), time + asProjMs)
                line.set_x2(array.get(asianLoLines, i), time + asProjMs)
    else if asianEndOfDay and not na(activeHiLine)
        line.set_x2(activeHiLine, time + asProjMs)
        line.set_x2(activeLoLine, time + asProjMs)


// ── Candle paint — shared engines (all calls unconditional) ──────────────────
string paintModeSel = mPaintMode == "Use Paint section" ? paintMode : mPaintMode
string paintModeEff = memSaver ? replayPaint : paintModeSel
float atrV = ta.atr(14)
// Truth Line fuel: spike-aware participation → plateau bell → agreement
float pVolEma = ta.ema(nz(volume), partEmaLen)
float prankEma = ta.percentrank(pVolEma, partLook)
float prankBar = ta.percentrank(nz(volume), partLook)
float part = partFast ? math.max(nz(prankEma, 50.0), nz(prankBar, 50.0)) : nz(prankEma, 50.0)
// Participation band: smooth two-stage gradient across the full 0-100 rank —
// red at 0, gold at 50, cyan at 100, continuously interpolated (no hard bands).
color partBandCol = part >= 50 ? color.from_gradient(part, 50, 100, volOscYellow, volOscGreen) : color.from_gradient(part, 0, 50, volOscRed, volOscYellow)
float bell = part >= bellPeak ? 1.0 : math.exp(-math.pow(part - bellPeak, 2) / (2.0 * bellWidth * bellWidth))
float climaxF = climaxCuts and part > bandClimax ? math.max(0.15, 1.0 - climaxDecay * (part - bandClimax)) : 1.0
float mvBar = close - open
bool sameSide = (barDelta > 0 and mvBar > 0) or (barDelta < 0 and mvBar < 0) or mvBar == 0
float agree = useAgree and fpOk and not sameSide ? agreePen : 1.0
float fuelVal = bell * climaxF * agree
bool emaSideUp = close > emaOut
bool emaAlign = (barDelta > 0 and emaSideUp) or (barDelta < 0 and not emaSideUp)
float emaMult = fuelEmaOn and not na(emaOut) ? (emaAlign ? 1.0 + fuelEmaBoost : 1.0 - fuelEmaBoost) : 1.0
fuelVal := math.max(0.0, math.min(1.0, fuelVal * emaMult))
// pivot structure: last confirmed pivots (confirm pivLen bars late, non-repainting)
float phP = ta.pivothigh(pivLen, pivLen)
float plP = ta.pivotlow(pivLen, pivLen)
var float lastPH = na
var float lastPL = na
if not na(phP)
    lastPH := phP
if not na(plP)
    lastPL := plP
// HTF pivots: same pivLen, computed on the current DELTA TIMEFRAME's own bars.
// var-state inside the function persists across calls in the requested context —
// same pattern as the HTF bias engine. lookahead_off keeps it non-repainting.
htfPivots(simple int n) =>
    float ph2 = ta.pivothigh(n, n)
    float pl2 = ta.pivotlow(n, n)
    var float lph = na
    var float lpl = na
    if not na(ph2)
        lph := ph2
    if not na(pl2)
        lpl := pl2
    [lph, lpl]
[htfLastPH, htfLastPL] = request.security(syminfo.tickerid, memSaver ? timeframe.period : dTf, htfPivots(pivLen), lookahead = barmerge.lookahead_off)
// always-on continuous "beyond" series (0 inside the pivots) so ta.percentrank
// runs every bar with a well-defined input, regardless of which mode is active
float pivBeyond = not na(lastPH) and close > lastPH ? (close - lastPH) / math.max(syminfo.mintick, atrV * pivGradAtr) : not na(lastPL) and close < lastPL ? (lastPL - close) / math.max(syminfo.mintick, atrV * pivGradAtr) : 0.0
float pivBeyondHtf = not na(htfLastPH) and close > htfLastPH ? (close - htfLastPH) / math.max(syminfo.mintick, atrV * pivGradAtr) : not na(htfLastPL) and close < htfLastPL ? (htfLastPL - close) / math.max(syminfo.mintick, atrV * pivGradAtr) : 0.0
float pivBeyondRank = ta.percentrank(pivBeyond, pivCalibLook)
float pivBeyondHtfRank = ta.percentrank(pivBeyondHtf, pivCalibLook)
f_pivotColor(float px, float ph3, float pl3, float dlt, float rank, float rawBeyond) =>
    color result = colNeut
    if not na(ph3) and px > ph3
        float frac = pivCalib ? nz(rank, 50.0) / 100.0 : math.min(1.0, rawBeyond)
        bool aligned = dlt > 0
        float adj = aligned ? math.min(1.0, frac + pivAlignBoost) : frac * (1.0 - pivAlignBoost)
        result := color.from_gradient(adj, 0, 1, colNeut, colBull)
    else if not na(pl3) and px < pl3
        float frac = pivCalib ? nz(rank, 50.0) / 100.0 : math.min(1.0, rawBeyond)
        bool aligned = dlt < 0
        float adj = aligned ? math.min(1.0, frac + pivAlignBoost) : frac * (1.0 - pivAlignBoost)
        result := color.from_gradient(adj, 0, 1, colNeut, colBear)
    result
// latched market-structure state: +1 after a close above the last pivot high,
// −1 after a close below the last pivot low, held until the opposite break
var int structDir = 0
if not na(lastPH) and close > lastPH
    structDir := 1
if not na(lastPL) and close < lastPL
    structDir := -1
// flip freshness + quality: captured ONCE at the moment structDir changes, then
// the paint decays from a quality-scaled flash down to a quality-scaled settled
// baseline over msFreshBars — a strong, delta-confirmed flip flashes brighter
// and settles brighter than a weak or delta-unconfirmed one.
var int msFlipBar = na
var float msFlipQuality = 0.5
bool msJustFlippedUp = structDir == 1 and structDir[1] != 1
bool msJustFlippedDn = structDir == -1 and structDir[1] != -1
if msJustFlippedUp or msJustFlippedDn
    msFlipBar := bar_index
    float msBrk = msJustFlippedUp ? (not na(lastPH) ? (close - lastPH) / math.max(syminfo.mintick, atrV * pivGradAtr) : 0.0) : (not na(lastPL) ? (lastPL - close) / math.max(syminfo.mintick, atrV * pivGradAtr) : 0.0)
    bool msDeltaOk = msJustFlippedUp ? barDelta > 0 : barDelta < 0
    float msStrengthNorm = math.min(1.0, msBrk)
    msFlipQuality := (msDeltaOk ? 1.0 : 0.55) * math.max(0.4, msStrengthNorm)
int msBarsSince = na(msFlipBar) ? 999 : bar_index - msFlipBar
float msDecayFrac = math.min(1.0, msBarsSince / msFreshBars)
float msFreshPeak = math.max(0.5, msFlipQuality)
float msBaseline = msMinBaseline + (0.85 - msMinBaseline) * msFlipQuality
float msIntensity = msFreshPeak - (msFreshPeak - msBaseline) * msDecayFrac
// ── Absorption debug — why a candidate failed ────────────────────────────────
// A candidate is any bar with the volume to be absorption. If it did not print,
// the three readings say which gate blocked it, so tuning is reading rather than
// guessing from an empty chart.
var array<label> mdDbg = array.new_label(0)
if mdAbsDebug and mdpPaintOn and barstate.isconfirmed and not mdAbsPass and mdRelVol >= mdMinRelVol and not na(mdEffortRatio)
    bool okE = mdAbsMode == "Body" ? nz(mdEffortBRatio) >= mdMinEffort : nz(mdEffortRatio) >= mdMinEffort
    bool okR = mdAbsMode == "Body" ? nz(mdBodyRatio, 99) <= mdMaxRange : nz(mdRangeRatio, 99) <= mdMaxRange
    string dTxt = "ER " + str.tostring(mdAbsMode == "Body" ? nz(mdEffortBRatio) : nz(mdEffortRatio), "#.##") + (okE ? " ✓" : " ✗") +
         "\n" + (mdAbsMode == "Body" ? "BR " : "RR ") + str.tostring(mdAbsMode == "Body" ? nz(mdBodyRatio) : nz(mdRangeRatio), "#.##") + (okR ? " ✓" : " ✗") +
         "\nRV " + str.tostring(nz(mdRelVol), "#.##") + " ✓"
    array.push(mdDbg, label.new(bar_index, low, dTxt, xloc = xloc.bar_index, yloc = yloc.belowbar,
         style = label.style_label_up, color = color.new(color.gray, 55), textcolor = color.new(color.white, 20), size = size.tiny))
while array.size(mdDbg) > (mdAbsDebug ? mdAbsDebugN : 0)
    label.delete(array.shift(mdDbg))

// ── MDP research — measures what happens after a print, never feeds back ─────
// Event kinds: 0 control (an ordinary bar), 1 aggression, 2 absorption.
// MFE/MAE/final all measure from the print's RANGE EDGE in the print's own
// direction, so 0 means "went nowhere beyond the bar that made it" for all
// three. Measuring the final from the bar's midpoint instead would hand every
// event half a range of free progress before it had done anything.
var array<int> mdREvBar = array.new_int()
var array<float> mdREvOrig = array.new_float()
var array<float> mdREvEdge = array.new_float()
var array<float> mdREvOpp = array.new_float()
var array<float> mdREvRng = array.new_float()
var array<int> mdREvDir = array.new_int()
var array<int> mdREvKind = array.new_int()
var array<float> mdREvMfe = array.new_float()
var array<float> mdREvMae = array.new_float()
var array<int> mdREvAge = array.new_int()
var array<bool> mdREvHitHi = array.new_bool()
var array<bool> mdREvHitLo = array.new_bool()
// running totals per kind
var array<int> mdRN = array.new_int(3, 0)
var array<float> mdRMfe = array.new_float(3, 0.0)
var array<float> mdRMae = array.new_float(3, 0.0)
var array<float> mdRFin = array.new_float(3, 0.0)
var array<int> mdRWin = array.new_int(3, 0)
var array<int> mdRHitHi = array.new_int(3, 0)
var array<int> mdRHitLo = array.new_int(3, 0)

f_mdRPush(int kind, int dir, float unit) =>
    float rr = math.max(syminfo.mintick, unit)
    array.push(mdREvBar, bar_index)
    // origin = where the forward measurement starts; the high/low are kept
    // separately because the hit-high and hit-low rows still need them
    array.push(mdREvOrig, mdRFrom == "Bar close" ? close : (dir > 0 ? high : low))
    array.push(mdREvEdge, dir > 0 ? high : low)
    array.push(mdREvOpp, dir > 0 ? low : high)
    array.push(mdREvRng, rr)
    array.push(mdREvDir, dir)
    array.push(mdREvKind, kind)
    array.push(mdREvMfe, 0.0)
    array.push(mdREvMae, 0.0)
    array.push(mdREvAge, 0)
    array.push(mdREvHitHi, false)
    array.push(mdREvHitLo, false)

bool mdRCtrlBar = mdResearch and not memSaver and mdRCtrl > 0 and not mdAccept and barstate.isconfirmed and bar_index % mdRCtrl == 0 and barDelta != 0
if mdResearch and not memSaver and mdAccept
    f_mdRPush(mdIsAbs ? 2 : 1, barDelta >= 0 ? 1 : -1, mdRUnit == "ATR" ? nz(atrV, high - low) : high - low)
if mdResearch and mdRCtrlBar
    f_mdRPush(0, barDelta > 0 ? 1 : -1, mdRUnit == "ATR" ? nz(atrV, high - low) : high - low)
while mdResearch and array.size(mdREvBar) > mdRMax
    array.shift(mdREvBar), array.shift(mdREvOrig), array.shift(mdREvEdge), array.shift(mdREvOpp), array.shift(mdREvRng)
    array.shift(mdREvDir), array.shift(mdREvKind), array.shift(mdREvMfe), array.shift(mdREvMae)
    array.shift(mdREvAge), array.shift(mdREvHitHi), array.shift(mdREvHitLo)

int mdRopen = array.size(mdREvBar)
if mdResearch and not memSaver and mdRopen > 0
    int j = mdRopen - 1
    while j >= 0
        if bar_index > array.get(mdREvBar, j)
            int age = array.get(mdREvAge, j) + 1
            array.set(mdREvAge, j, age)
            float orig = array.get(mdREvOrig, j)
            float edge = array.get(mdREvEdge, j)
            float opp = array.get(mdREvOpp, j)
            float rr = array.get(mdREvRng, j)
            int dir = array.get(mdREvDir, j)
            float fav = dir > 0 ? (high - orig) / rr : (orig - low) / rr
            float adv = dir > 0 ? (orig - low) / rr : (high - orig) / rr
            array.set(mdREvMfe, j, math.max(array.get(mdREvMfe, j), fav))
            array.set(mdREvMae, j, math.max(array.get(mdREvMae, j), adv))
            array.set(mdREvHitHi, j, array.get(mdREvHitHi, j) or high >= (dir > 0 ? edge : opp))
            array.set(mdREvHitLo, j, array.get(mdREvHitLo, j) or low <= (dir > 0 ? opp : edge))
            if age >= mdFwdBars
                int kd = array.get(mdREvKind, j)
                float fin = dir > 0 ? (close - orig) / rr : (orig - close) / rr
                array.set(mdRN, kd, array.get(mdRN, kd) + 1)
                array.set(mdRMfe, kd, array.get(mdRMfe, kd) + array.get(mdREvMfe, j))
                array.set(mdRMae, kd, array.get(mdRMae, kd) + array.get(mdREvMae, j))
                array.set(mdRFin, kd, array.get(mdRFin, kd) + fin)
                if fin > 0
                    array.set(mdRWin, kd, array.get(mdRWin, kd) + 1)
                if array.get(mdREvHitHi, j)
                    array.set(mdRHitHi, kd, array.get(mdRHitHi, kd) + 1)
                if array.get(mdREvHitLo, j)
                    array.set(mdRHitLo, kd, array.get(mdRHitLo, kd) + 1)
                array.remove(mdREvBar, j), array.remove(mdREvOrig, j), array.remove(mdREvEdge, j), array.remove(mdREvOpp, j)
                array.remove(mdREvRng, j), array.remove(mdREvDir, j), array.remove(mdREvKind, j)
                array.remove(mdREvMfe, j), array.remove(mdREvMae, j), array.remove(mdREvAge, j)
                array.remove(mdREvHitHi, j), array.remove(mdREvHitLo, j)
        j -= 1

// ── MDP-LDR — liquidity-provision tally ─────────────────────────────────────
// Each print is filed with the structure state at the moment it landed:
//   FUEL      aggressor FOUGHT the trend  -> it supplied the liquidity the trend
//             needed, so the vote goes WITH the trend
//   ONE-SIDED aggressor AGREED with the trend -> crowded flow, nobody left to
//             take the other side, so the vote goes AGAINST it
//   ABSORB    passive size -> votes against the trend at its own weight; on real
//             aggressor data it ran against continuation on both symbols tested
// Weights come from that research; votes are deliberately NOT scaled by print
// size, because the effect showed no dose-response with size.
var array<float> mdLdrVote = array.new_float(0)
var array<int> mdLdrKind = array.new_int(0)
var array<float> mdPathPx = array.new_float(0)
if mdAccept
    int mdTrendAt = structDir
    int mdSideAt = barDelta > 0 ? 1 : barDelta < 0 ? -1 : 0
    int mdKindAt = mdTrendAt == 0 ? 0 : mdIsAbs ? 2 : mdSideAt == 0 ? 0 : mdSideAt * mdTrendAt < 0 ? 1 : -1
    float mdVoteAt = mdKindAt == 1 ? mdTrendAt * mdLdrWc :
         mdKindAt == -1 ? -mdTrendAt * mdLdrWw :
         mdKindAt == 2 ? -mdTrendAt * mdLdrWa : 0.0
    array.push(mdLdrVote, mdVoteAt)
    array.push(mdLdrKind, mdKindAt)
    // where the print landed — the path of prints is its own read
    array.push(mdPathPx, (high + low) / 2.0)
    while array.size(mdLdrVote) > 50
        array.shift(mdLdrVote)
        array.shift(mdLdrKind)
        array.shift(mdPathPx)
float mdLdrNet = 0.0
int mdLdrCnt = 0
int mdLdrFuel = 0
int mdLdrOne = 0
int mdLdrAbsN = 0
int mdLdrTot = array.size(mdLdrVote)
if mdLdrTot > 0
    int mdFrom = math.max(0, mdLdrTot - math.min(mdLdrN, mdLdrTot))
    for i = mdFrom to mdLdrTot - 1
        mdLdrNet += array.get(mdLdrVote, i)
        mdLdrCnt += 1
        int kk = array.get(mdLdrKind, i)
        if kk == 1
            mdLdrFuel += 1
        if kk == -1
            mdLdrOne += 1
        if kk == 2
            mdLdrAbsN += 1
// always a verdict: BULL, BEAR or FLAT, with what is driving it
bool mdLdrReady = mdLdrCnt >= 2
string mdLdrWhy = mdLdrOne > mdLdrFuel ? "rev" : mdLdrFuel > mdLdrOne ? "cont" : "mix"
string mdLdrTxt = not mdLdrReady ? "FLAT" :
     mdLdrNet >= mdLdrTh ? "BULL " + mdLdrWhy :
     mdLdrNet <= -mdLdrTh ? "BEAR " + mdLdrWhy : "FLAT"

// EMA trend engine: self-calibrated distance × slope alignment, with a
// fresh-cross flash that decays into the steady read (same mechanic as
// Market structure's flip-quality decay).
float emaDistRaw = (close - emaOut) / math.max(syminfo.mintick, atrV)
float emaDistAbsRank = ta.percentrank(math.abs(emaDistRaw), emaCalibLook)
int emaSide = close > emaOut ? 1 : close < emaOut ? -1 : 0
float emaSlopeVal = na(emaOut[emaSlopeLen]) ? 0.0 : emaOut - emaOut[emaSlopeLen]
bool emaSlopeAlignedNow = (emaSide == 1 and emaSlopeVal > 0) or (emaSide == -1 and emaSlopeVal < 0)
float emaDistCalibN = emaCalib ? nz(emaDistAbsRank, 50.0) / 100.0 : math.min(1.0, math.abs(emaDistRaw) / emaGradAtr)
float emaSlopeMult = emaSlopeAlignedNow ? math.min(1.0, emaDistCalibN + emaSlopeBoost) : emaDistCalibN * (1.0 - emaSlopeBoost)
// third confluence layer: EMA vs its own smoothing line (and, if Bollinger is
// the smoothing type, EMA vs its own band) — only active when a smoothing MA
// type is actually selected; otherwise these multipliers are neutral (1.0).
bool emaSmoothAvail = enableMA and not na(smoothingMA)
bool emaSmoothAligned = emaSmoothAvail and ((emaSide == 1 and emaOut > smoothingMA) or (emaSide == -1 and emaOut < smoothingMA))
float emaSmoothMult = emaSmoothAvail ? (emaSmoothAligned ? 1.0 + emaSmoothBoost : 1.0 - emaSmoothBoost) : 1.0
bool emaBBAvail = isBB and emaSmoothAvail and not na(smoothingStDev)
bool emaBBExtreme = emaBBAvail and ((emaSide == 1 and emaOut > smoothingMA + smoothingStDev) or (emaSide == -1 and emaOut < smoothingMA - smoothingStDev))
float emaBBMult = emaBBExtreme ? 1.0 + emaSmoothBoost : 1.0
bool emaJustCrossed = emaSide != 0 and emaSide != nz(emaSide[1], emaSide)
var int emaFlipBar = na
var float emaFlipQuality = 0.5
if emaJustCrossed
    emaFlipBar := bar_index
    float emaBodyFrac = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.5
    emaFlipQuality := (emaSlopeAlignedNow ? 1.0 : 0.55) * math.max(0.4, emaBodyFrac)
int emaBarsSince = na(emaFlipBar) ? 999 : bar_index - emaFlipBar
float emaDecayFrac = math.min(1.0, emaBarsSince / emaFreshBars)
float emaFreshPeak = math.max(0.5, emaFlipQuality)
float emaBaseline = emaMinBaseline + (0.85 - emaMinBaseline) * emaFlipQuality
float emaFlashIntensity = emaFreshPeak - (emaFreshPeak - emaBaseline) * emaDecayFrac
float emaSteadyIntensity = math.min(1.0, emaSlopeMult * emaSmoothMult * emaBBMult)
float emaFinalIntensity = emaSide * (emaBarsSince < emaFreshBars ? math.max(emaFlashIntensity, emaSteadyIntensity) : emaSteadyIntensity)
// array-rank helper (used by the Asian tight-range factor)
f_arrRank(array<float> arr, float v) =>
    int n = array.size(arr)
    float result = 50.0
    if n > 0
        int cnt = 0
        for i = 0 to n - 1
            if array.get(arr, i) <= v
                cnt += 1
        result := 100.0 * cnt / n
    result
// Day range position: YESTERDAY's completed range as the reference box.
// Inside = blue, deepest at the midpoint, fading toward the edges. Above the
// high = green, below the low = red, ramping with distance beyond the edge.
f_dayColor(float px, float hi, float lo, float dlt) =>
    color result = colNeut
    if not na(hi) and not na(lo) and hi > lo
        float rng = hi - lo
        float ramp = math.max(syminfo.mintick, rng * drRampPct / 100.0)
        if px > hi
            float frac = math.min(1.0, (px - hi) / ramp)
            float adj = drAlignBoost > 0 ? (dlt > 0 ? math.min(1.0, frac + drAlignBoost) : frac * (1.0 - drAlignBoost)) : frac
            result := color.from_gradient(adj, 0, 1, colNeut, colBull)
        else if px < lo
            float frac = math.min(1.0, (lo - px) / ramp)
            float adj = drAlignBoost > 0 ? (dlt < 0 ? math.min(1.0, frac + drAlignBoost) : frac * (1.0 - drAlignBoost)) : frac
            result := color.from_gradient(adj, 0, 1, colNeut, colBear)
        else
            float centering = 1.0 - math.abs(px - (hi + lo) / 2.0) / (rng / 2.0)
            int transp = int(math.round(80.0 - math.max(0.0, math.min(1.0, centering)) * 80.0))
            result := color.new(colNeut, transp)
    result
color dayColOut = f_dayColor(close, prevDH, prevDL, barDelta)
// RSI: self-calibration → velocity → fast/slow agreement → pivot divergence
float rsiV = ta.rsi(close, rsiLen)
float rsiDist = rsiV - 50.0
float rsiDistAbsRank = ta.percentrank(math.abs(rsiDist), rsiCalibLook)
float rsiCalibN = rsiCalib ? math.sign(rsiDist) * nz(rsiDistAbsRank, 50.0) / 100.0 : math.max(-1.0, math.min(1.0, rsiDist / 50.0))
float rsiVel = na(rsiV[rsiVelLen]) ? 0.0 : rsiV - rsiV[rsiVelLen]
bool rsiVelAligned = (rsiDist > 0 and rsiVel > 0) or (rsiDist < 0 and rsiVel < 0)
float rsiVelMult = rsiVelAligned ? 1.0 + rsiVelBoost : 1.0 - rsiVelBoost
float rsiFast = ta.rsi(close, rsiFastLen)
float rsiSlow = ta.rsi(close, rsiSlowLen)
bool rsiFsAgree = (rsiFast > 50 and rsiSlow > 50) or (rsiFast < 50 and rsiSlow < 50)
float rsiFsMult = rsiFsAgree ? 1.0 + rsiFsBoost : 1.0 - rsiFsBoost
float rsiFinal = math.max(-1.0, math.min(1.0, rsiCalibN * rsiVelMult * rsiFsMult))
// pivot divergence: reuses the SAME confirmed pivots (phP/plP, pivLen) as Pivot
// structure — price/RSI comparison at each confirmed pivot pair, latched until
// the next pivot of that type re-evaluates it.
var float divPh1 = na
var float divPh2 = na
var float divPhRsi1 = na
var float divPhRsi2 = na
var float divPl1 = na
var float divPl2 = na
var float divPlRsi1 = na
var float divPlRsi2 = na
var bool divBearActive = false
var bool divBullActive = false
if not na(phP)
    divPh1 := divPh2
    divPhRsi1 := divPhRsi2
    divPh2 := phP
    divPhRsi2 := rsiV[pivLen]
    divBearActive := not na(divPh1) and divPh2 > divPh1 and divPhRsi2 < divPhRsi1
    if divBearActive
        divBullActive := false
if not na(plP)
    divPl1 := divPl2
    divPlRsi1 := divPlRsi2
    divPl2 := plP
    divPlRsi2 := rsiV[pivLen]
    divBullActive := not na(divPl1) and divPl2 < divPl1 and divPlRsi2 > divPlRsi1
    if divBullActive
        divBearActive := false

// ── Asian range position engine: calibrated break distance × delta alignment ×
// tight-range significance; inside the range = blue, deepest at the midpoint.
var array<float> arRangeHist = array.new_float()
if endAsian and not na(asianHi) and not na(asianLo) and asianHi > asianLo
    array.push(arRangeHist, asianHi - asianLo)
    if array.size(arRangeHist) > arRangeLook
        array.shift(arRangeHist)
float arBeyond = not na(asianHi) and close > asianHi ? (close - asianHi) / math.max(syminfo.mintick, atrV * pivGradAtr) : not na(asianLo) and close < asianLo ? (asianLo - close) / math.max(syminfo.mintick, atrV * pivGradAtr) : 0.0
float arBeyondRank = ta.percentrank(arBeyond, arCalibLook)
float arRangeNow = (na(asianHi) or na(asianLo)) ? na : asianHi - asianLo
float arRangeRank = na(arRangeNow) ? 50.0 : f_arrRank(arRangeHist, arRangeNow)
float arTightMult = 1.0 + arTightBoost * (1.0 - arRangeRank / 100.0)
f_asianColor(float px, float hi, float lo, float dlt, float rank, float rawBeyond, float tightMult) =>
    color result = colNeut
    if not na(hi) and not na(lo) and hi > lo
        if px > hi
            float frac = arCalib ? nz(rank, 50.0) / 100.0 : math.min(1.0, rawBeyond)
            float adj = dlt > 0 ? math.min(1.0, frac + arAlignBoost) : frac * (1.0 - arAlignBoost)
            result := color.from_gradient(math.min(1.0, adj * tightMult), 0, 1, colNeut, colBull)
        else if px < lo
            float frac = arCalib ? nz(rank, 50.0) / 100.0 : math.min(1.0, rawBeyond)
            float adj = dlt < 0 ? math.min(1.0, frac + arAlignBoost) : frac * (1.0 - arAlignBoost)
            result := color.from_gradient(math.min(1.0, adj * tightMult), 0, 1, colNeut, colBear)
        else
            float centering = 1.0 - math.abs(px - (hi + lo) / 2.0) / ((hi - lo) / 2.0)
            int transp = int(math.round(70.0 - math.max(0.0, math.min(1.0, centering)) * 70.0))
            result := color.new(colNeut, transp)
    result
color asianColOut = f_asianColor(close, asianHi, asianLo, barDelta, arBeyondRank, arBeyond, arTightMult)

// ── VWAP σ-distance engine: σ-normalised stretch (self-calibrating by construction)
// × delta alignment × VWAP-slope alignment, with an exhaustion override.
float vwZ = not na(rvwap) and not na(rsd) and rsd > 0 ? (close - rvwap) / rsd : 0.0
float vwSlopeVal = na(rvwap[vwSlopeLen]) ? 0.0 : rvwap - rvwap[vwSlopeLen]
int vwSide = vwZ > 0 ? 1 : vwZ < 0 ? -1 : 0
bool vwDeltaAligned = (vwSide == 1 and barDelta > 0) or (vwSide == -1 and barDelta < 0)
bool vwSlopeAligned = (vwSide == 1 and vwSlopeVal > 0) or (vwSide == -1 and vwSlopeVal < 0)
float vwBase = math.min(1.0, math.abs(vwZ) / 2.0)
float vwMult = (vwDeltaAligned ? 1.0 + vwAlignBoost : 1.0 - vwAlignBoost) * (vwSlopeAligned ? 1.0 + vwAlignBoost * 0.5 : 1.0 - vwAlignBoost * 0.5)
float vwFinal = vwSide * math.min(1.0, vwBase * vwMult)
bool vwDeltaAgainst = (vwSide == 1 and barDelta < 0) or (vwSide == -1 and barDelta > 0)
bool vwExhaust = vwSide != 0 and math.abs(vwZ) >= vwExhaustSigma and vwDeltaAgainst

// ── Candle conviction engine: calibrated body dominance × range gate × delta
// alignment × confirmed-bar streak.
float ccRange = high - low
float ccBody = ccRange > 0 ? math.abs(close - open) / ccRange : 0.0
float ccBodyRank = ta.percentrank(ccBody, ccCalibLook)
float ccRangeRank = ta.percentrank(ccRange, ccCalibLook)
int ccDir = close > open ? 1 : close < open ? -1 : 0
float ccBase = ccCalib ? nz(ccBodyRank, 50.0) / 100.0 : math.min(1.0, ccBody / 0.9)
float ccGate = nz(ccRangeRank, 50.0) <= ccGateFloor ? math.max(0.0, nz(ccRangeRank, 50.0) / math.max(1.0, ccGateFloor)) : 1.0
bool ccAligned = (ccDir == 1 and barDelta > 0) or (ccDir == -1 and barDelta < 0)
float ccMult = ccDir == 0 ? 1.0 : ccAligned ? 1.0 + ccAlignBoost : 1.0 - ccAlignBoost
var int ccStreak = 1
var int ccLastDir = 0
if barstate.isconfirmed
    bool ccSig = ccDir != 0 and nz(ccBodyRank, 50.0) >= 60
    ccStreak := ccSig and ccDir == ccLastDir ? math.min(ccStreakCap, ccStreak + 1) : 1
    ccLastDir := ccDir
float ccStreakMult = ccDir == ccLastDir ? 1.0 + ccStreakBoost * (ccStreak - 1) : 1.0
float ccFinal = ccDir * math.min(1.0, ccBase * ccGate * ccMult * ccStreakMult)

// ── POC trend engine: shared-window-profile migration × price alignment ─────
float ptPocNow = ptWinPoc
float ptRefBack = ptWinPocBack
float ptPrevRef = ptWinPocPrev
float ptVahNow = ptWinVah
float ptValNow = ptWinVal
float ptMig = na(ptPocNow) or na(ptRefBack) ? 0.0 : (ptPocNow - ptRefBack) / math.max(syminfo.mintick, atrV)
float ptMigRank = ta.percentrank(math.abs(ptMig), ptCalibLook)
int ptDir = ptMig > 0 ? 1 : ptMig < 0 ? -1 : 0
float ptBase = nz(ptMigRank, 50.0) / 100.0
bool ptAligned = not na(ptPocNow) and ((ptDir == 1 and close > ptPocNow) or (ptDir == -1 and close < ptPocNow))
bool ptPrevOk = not na(ptPocNow) and not na(ptPrevRef) and ((ptDir == 1 and ptPocNow > ptPrevRef) or (ptDir == -1 and ptPocNow < ptPrevRef))
float ptMult = (ptAligned ? 1.0 + ptAlignBoost : 1.0 - ptAlignBoost) * (ptPrevOk ? 1.0 + ptPrevBoost : 1.0)
float ptFinal0 = ptDir * math.min(1.0, ptBase * ptMult)
bool inVa = not na(ptVahNow) and not na(ptValNow) and close <= ptVahNow and close >= ptValNow
bool outVaWithMig = not na(ptVahNow) and not na(ptValNow) and ((ptDir == 1 and close > ptVahNow) or (ptDir == -1 and close < ptValNow))
float ptFinal = ptVaGate ? (inVa ? ptFinal0 * 0.5 : outVaWithMig ? math.sign(ptFinal0) * math.min(1.0, math.abs(ptFinal0) * (1.0 + ptAlignBoost)) : ptFinal0) : ptFinal0

// ── Value area paint: VAH/VAL as the box, POC as the centre ─────────────────
f_vaColor(float px, float vah, float val, float poc, float dlt) =>
    color result = colNeut
    if not na(vah) and not na(val) and not na(poc) and vah > val
        float w = vah - val
        float ramp = math.max(syminfo.mintick, w * vaRampPct / 100.0)
        if px > vah
            float frac = math.min(1.0, (px - vah) / ramp)
            float adj = dlt > 0 ? math.min(1.0, frac + vaAlignBoost) : frac * (1.0 - vaAlignBoost)
            result := color.from_gradient(adj, 0, 1, colNeut, colBull)
        else if px < val
            float frac = math.min(1.0, (val - px) / ramp)
            float adj = dlt < 0 ? math.min(1.0, frac + vaAlignBoost) : frac * (1.0 - vaAlignBoost)
            result := color.from_gradient(adj, 0, 1, colNeut, colBear)
        else
            float halfW = math.max(syminfo.mintick, math.max(vah - poc, poc - val))
            float centering = 1.0 - math.min(1.0, math.abs(px - poc) / halfW)
            int transp = int(math.round(80.0 - centering * 80.0))
            result := color.new(colNeut, transp)
    result
color vaColOut = f_vaColor(close, sessVah, sessVal, sessPoc, barDelta)

// ── Candle paint (mode → normalized −1..+1 → curve → floor → gradient) ──────
float avgAbsD = 0.0
if array.size(deltaHist) > 0
    for d in deltaHist
        avgAbsD += math.abs(nz(d))
    avgAbsD /= array.size(deltaHist)
float totVLive = liveBuy + liveSell
float dPctRaw  = totVLive > 0 ? nz(liveDelta) / totVLive : 0.0

// ── Delta % (imbalance) — trajectory → self-calibration → size gate → streak ──
// Trajectory needs intrabar granularity, only present on the estimate path
// (ivS holds signed volume per intrabar; empty when footprint supplied barDelta).
// trajectory: the developing-hour ratio tilted toward the CURRENT bar's own
// ratio — same horizon on every data path (the earlier version swapped to a
// chart-bar-only measure on the estimate path, changing what the colour meant)
float barTot = nz(barBuy) + nz(barSell)
float barImb = barTot > 0 ? (nz(barBuy) - nz(barSell)) / barTot : 0.0
float dpctBase = dpctTrajOn ? (1.0 - dpctTrajTilt) * dPctRaw + dpctTrajTilt * barImb : dPctRaw

// self-calibration: percentile rank of |imbalance| vs its own recent history
float dpctRank = ta.percentrank(math.abs(dpctBase), dpctCalibLook)
float volRankPct = ta.percentrank(totVLive, dpctCalibLook)
float calibN = dpctCalib ? math.sign(dpctBase) * (nz(dpctRank, 50.0) / 100.0) : math.max(-1.0, math.min(1.0, dpctBase * paintSens / 0.15))
// size gate: tapers intensity below the volume-percentile floor
float gateMult = 1.0
if dpctGateOn
    float vr = nz(volRankPct, 50.0)
    gateMult := vr <= dpctGateFloor ? math.max(0.0, vr / math.max(1.0, dpctGateFloor)) : 1.0
float dPctGated = calibN * gateMult
// persistence streak: advances only on confirmed (completed) bars
var int dpctStreak = 1
var int dpctLastDir = 0
int dpctCurDir = dPctGated > 0.02 ? 1 : dPctGated < -0.02 ? -1 : 0
if dpctStreakOn and barstate.isconfirmed
    bool sigNow = nz(dpctRank, 50.0) >= dpctStreakThresh
    if sigNow and dpctCurDir != 0 and dpctCurDir == dpctLastDir
        dpctStreak := math.min(dpctStreakCap, dpctStreak + 1)
    else if sigNow and dpctCurDir != 0
        dpctStreak := 1
    else
        dpctStreak := 1
    dpctLastDir := dpctCurDir
float dpctStreakMult = dpctStreakOn and dpctCurDir == dpctLastDir ? 1.0 + dpctStreakBoost * (dpctStreak - 1) : 1.0
float dPctFinal = math.sign(dPctGated) * math.min(1.0, math.abs(dPctGated) * dpctStreakMult)

// Delta HTF (Δ candles): the plain ΔC engine — sign and intensity come from the
// LIVE delta of the delta-timeframe candle this bar belongs to, scaled against
// the average |Δ| of the last N completed candles. No POC, no percentile rank,
// no upgrades: every bar inside the hour shades with that hour's own delta as it
// builds, which is what makes the MDP override read as an interruption.
float htfDeltaN = avgAbsD > 0 ? math.max(-1.0, math.min(1.0, nz(liveDelta) / avgAbsD)) : 0.0

float rawN = 0.0
if paintModeEff == "Delta HTF (Δ candles)"
    rawN := htfDeltaN
else if paintModeEff == "Delta % (imbalance)"
    rawN := dPctFinal
else if paintModeEff == "Fuel × Δ (Truth Line)"
    rawN := math.sign(nz(barDelta)) * fuelVal
else if paintModeEff == "Market structure"
    rawN := structDir * msIntensity
else if paintModeEff == "VWAP σ-distance"
    rawN := vwFinal
else if paintModeEff == "POC trend"
    rawN := ptFinal
else if paintModeEff == "Candle conviction"
    rawN := ccFinal
else if paintModeEff == "EMA trend"
    rawN := emaFinalIntensity
else if paintModeEff == "RSI momentum"
    rawN := rsiFinal
float curvedN = paintCurve == "Boosted" ? math.sign(rawN) * math.pow(math.abs(rawN), 0.55) : rawN
float normD = paintFloor > 0 and math.abs(curvedN) > 0.05 ? math.sign(curvedN) * math.max(math.abs(curvedN), paintFloor) : curvedN
color gradCol = normD >= 0 ? color.from_gradient(normD, 0, 1, colNeut, colBull) : color.from_gradient(normD, -1, 0, colBear, colNeut)
// VA-band variant of f_pocColor: blue between VAL and VAH (deepest at the POC and
// on quiet delta), green/red beyond, ramp = pocRampPct of the value-area width.
f_pocVaColor(float px, float poc, float vah, float val, float dlt, float avgAbs, float extra) =>
    color result = colNeut
    if not na(poc) and not na(vah) and not na(val) and vah > val
        float w = vah - val
        float rampW = math.max(syminfo.mintick, w * pocRampPct / 100.0)
        if px > vah or px < val
            float beyond = px > vah ? px - vah : val - px
            float fracD = math.min(1.0, beyond / rampW)
            // distance alone, distance averaged with the other factors, or
            // whichever single factor reads highest
            float frac = na(extra) or htfIntMode == "Distance only" ? fracD :
                 htfIntMode == "Strongest" ? math.max(fracD, extra) : (fracD + extra) / 2.0
            bool greenZone = px > vah
            bool aligned = (greenZone and dlt > 0) or (not greenZone and dlt < 0)
            float adj = aligned ? math.min(1.0, frac + pocAlignBoost) : frac * (1.0 - pocAlignBoost)
            result := greenZone ? color.from_gradient(adj, 0, 1, colNeut, colBull) : color.from_gradient(adj, 0, 1, colNeut, colBear)
        else
            float halfW = math.max(syminfo.mintick, math.max(vah - poc, poc - val))
            float centering = 1.0 - math.min(1.0, math.abs(px - poc) / halfW)
            float dq = avgAbs > 0 ? 1.0 - math.min(1.0, math.abs(dlt) / avgAbs) : 0.5
            float depth = math.max(0.0, math.min(1.0, (centering + dq) / 2.0))
            int transp = int(math.round(70 - depth * 70))
            // inside value, lean by which side of the POC price is accepting:
            // neutral on the POC, tilting toward bull/bear out at the VA edge
            float lean = htfInsideLean * math.min(1.0, math.abs(px - poc) / halfW)
            color leanCol = px > poc ? color.from_gradient(lean, 0, 1, colNeut, colBull) : color.from_gradient(lean, 0, 1, colNeut, colBear)
            result := color.new(htfInsideLean > 0 ? leanCol : colNeut, transp)
    result
bool pocUseVa = pocBandMode == "Value area (VAH/VAL)"
color deltaSizeCol = pocUseVa ? f_pocVaColor(close, barPocNow[1], barVahNow[1], barValNow[1], barDelta, avgAbsD, na) : f_pocColor(close, barPocNow[1], high[1] - low[1], barDelta, avgAbsD)
bool htfWinRef = htfRefMode == "HTF window (N candles)" and not na(hwPoc) and not na(hwVah) and not na(hwVal)
float htfRefPoc = htfWinRef ? hwPoc : prevHtfPocVal
float htfRefVah = htfWinRef ? hwVah : prevHtfVah
float htfRefVal = htfWinRef ? hwVal : prevHtfVal
float htfRefRng = htfWinRef ? (na(hwVah) or na(hwVal) ? na : hwVah - hwVal) : prevHtfRangeVal
// ACCEPTANCE — consecutive closes beyond the edge; a return inside collapses it
var int htfAccCnt = 0
bool htfBeyondUp = not na(htfRefVah) and close > htfRefVah
bool htfBeyondDn = not na(htfRefVal) and close < htfRefVal
if barstate.isconfirmed
    htfAccCnt := htfBeyondUp or htfBeyondDn ?
         ((htfBeyondUp and htfBeyondUp[1]) or (htfBeyondDn and htfBeyondDn[1]) ? htfAccCnt + 1 : 1) : 0
float htfAccF = math.min(1.0, htfAccCnt / math.max(1.0, htfAccBars))
// RELATIVE SIZE — this bar's volume against what this time of day normally trades
float htfSizeF = na(mdRelVol) ? 0.0 : math.max(0.0, math.min(1.0, (mdRelVol - 1.0) / math.max(0.1, htfSizeFull - 1.0)))
// MIGRATION — is accepted value itself moving the way price broke
float htfVaW = (na(htfRefVah) or na(htfRefVal)) ? na : htfRefVah - htfRefVal
float htfMig = (na(hwPoc) or na(hwBack) or na(htfVaW) or htfVaW <= 0) ? 0.0 : (hwPoc - hwBack) / htfVaW
bool htfMigAligned = (htfBeyondUp and htfMig > 0) or (htfBeyondDn and htfMig < 0)
float htfMigF = htfMigAligned ? math.min(1.0, math.abs(htfMig)) : 0.0
// combined: averaged with distance, or the strongest single reading
float htfExtraF = htfIntMode == "Strongest" ? math.max(htfAccF, math.max(htfSizeF, htfMigF)) :
     (htfAccF + htfSizeF + htfMigF) / 3.0

color deltaSizeHtfCol = pocUseVa ? f_pocVaColor(close, htfRefPoc, htfRefVah, htfRefVal, liveDelta, avgAbsD, htfExtraF) : f_pocColor(close, htfRefPoc, htfRefRng, liveDelta, avgAbsD)
color pivColBar = f_pivotColor(close, lastPH, lastPL, barDelta, pivBeyondRank, pivBeyond)
color pivColHtf = f_pivotColor(close, htfLastPH, htfLastPL, liveDelta, pivBeyondHtfRank, pivBeyondHtf)
color dCol = paintModeEff == "Delta size" ? deltaSizeCol : paintModeEff == "Delta size HTF" ? deltaSizeHtfCol : paintModeEff == "Participation band" ? partBandCol : paintModeEff == "Pivot structure" ? pivColBar : paintModeEff == "Pivot structure HTF" ? pivColHtf : paintModeEff == "Asian range position" ? asianColOut : paintModeEff == "Value area" ? vaColOut : paintModeEff == "Day range position" ? dayColOut : paintModeEff == "VWAP σ-distance" and vwExhaust ? vwExhaustCol : paintModeEff == "RSI momentum" and divBearActive ? rsiDivBearCol : paintModeEff == "RSI momentum" and divBullActive ? rsiDivBullCol : na(gradCol) ? colNeut : gradCol
bool paintOn = mPaint and paintOn_i
// MDP override: the bar that claimed the print is painted in its own colour
// instead of the active mode's, and keeps it — the paint is decided on the bar
// that qualified, so it never repaints as later bars come in.
color dColOut = mdpPaintOn and mdAccept ? (mdIsAbs ? mdColAbs : mdColAgg) : dCol
barcolor(paintOn or (mdpPaintOn and mdAccept) ? dColOut : na, title = "Δ candle paint")
plotcandle(open, high, low, close, "Δ Candles", color = paintOn or (mdpPaintOn and mdAccept) ? dColOut : na, wickcolor = paintOn or (mdpPaintOn and mdAccept) ? dColOut : na, bordercolor = paintOn or (mdpPaintOn and mdAccept) ? dColOut : na)


// ── Volume participation BG (Stryk: ΔC engine; calls unconditional) ─────────
float volEma = ta.ema(nz(volume), volOscEmaLen)
float volHi = ta.highest(volEma, volOscLook)
float volLo = ta.lowest(volEma, volOscLook)
float volOsc = volHi > volLo ? (volEma - volLo) / (volHi - volLo) * 100 : 50.0
bool volBgAutoOff = paintOn and paintModeEff == "Participation band"
bool volBgOn = mVolBg and showVolBg_i and not volBgAutoOff
color volBg = volBgOn ? (volOsc >= volBgHigh ? color.new(volOscGreen, volBgTransp) : volOsc <= volBgLow ? color.new(volOscRed, volBgTransp) : na) : na
bgcolor(volBg, title = "Vol participation tint")

// ── DWM drawing engine ───────────────────────────────────────────────────────
bool rangesOn = mRanges and dwmHLOn and not memSaver
bool hlLinesOn = rangesOn and mDwmHL
bool quartsOn = rangesOn and dwmQuartOn and mQuart
bool zonesOn = rangesOn and dwmZoneOn and mZones
szOf(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

// per-TF line/label stores: [hiLine, loLine, q25, q50, q75] per period, flat arrays
var array<line> dLines = array.new<line>()
var array<line> wLines = array.new<line>()
var array<line> mLines = array.new<line>()
var array<label> dLbls = array.new<label>()
var array<label> wLbls = array.new<label>()
var array<label> mLbls = array.new<label>()
// per-TF zone stores: [hiZone, loZone] per period
var array<box> dBoxes = array.new<box>()
var array<box> wBoxes = array.new<box>()
var array<box> mBoxes = array.new<box>()

f_fade(array<line> lns, color baseCol) =>
    int sets = array.size(lns) / 5
    if dwmHLGradient and sets > 1
        for si = 0 to sets - 2
            int age = sets - 1 - si
            int tr = math.min(88, 25 + age * 25)
            color fadedC = color.new(baseCol, tr)
            for k = 0 to 1
                line ln = array.get(lns, si * 5 + k)
                if not na(ln)
                    line.set_color(ln, fadedC)

f_spawn(array<line> lns, array<label> lbls, array<box> bxs, float ph, float pl, int pStart, color colHL, int w, int keepN, string nm, color lblCol, string lblSz, bool hlOn, bool qOn, bool zOn) =>
    if not na(ph) and not na(pl)
        int x1 = na(pStart) ? bar_index : pStart
        box hiZ = na
        box loZ = na
        if zOn
            float half = (ph - pl) * 0.125
            color zc = color.new(colHL, dwmZoneTransp)
            hiZ := box.new(x1, ph + half, bar_index, ph - half, border_color = na, bgcolor = zc)
            loZ := box.new(x1, pl + half, bar_index, pl - half, border_color = na, bgcolor = zc)
        array.push(bxs, hiZ)
        array.push(bxs, loZ)
        while array.size(bxs) > keepN * 2
            box oldB = array.shift(bxs)
            if not na(oldB)
                box.delete(oldB)
        line hiL = na
        line loL = na
        if hlOn
            hiL := line.new(x1, ph, bar_index, ph, color = colHL, width = w)
            loL := line.new(x1, pl, bar_index, pl, color = colHL, width = w)
        color qc = color.new(colHL, dwmQuartTransp)
        float rng = ph - pl
        line q1 = na
        line q2 = na
        line q3 = na
        if qOn
            q1 := line.new(x1, pl + rng * 0.25, bar_index, pl + rng * 0.25, color = qc, width = dwmQuartW, style = line.style_dashed)
            q2 := line.new(x1, pl + rng * 0.50, bar_index, pl + rng * 0.50, color = qc, width = dwmQuartW, style = line.style_dashed)
            q3 := line.new(x1, pl + rng * 0.75, bar_index, pl + rng * 0.75, color = qc, width = dwmQuartW, style = line.style_dashed)
        array.push(lns, hiL)
        array.push(lns, loL)
        array.push(lns, q1)
        array.push(lns, q2)
        array.push(lns, q3)
        if hlOn and dwmHLLabels
            string stH = dwmHLLabelPos == "Outside left" ? label.style_label_right : dwmHLLabelPos == "Inside middle" ? label.style_label_center : label.style_label_left
            int lx0 = dwmHLLabelPos == "Outside left" ? x1 : bar_index
            label hiT = label.new(lx0, ph, nm + " High", style = stH, textcolor = lblCol, color = color.new(color.black, 100), size = szOf(lblSz))
            label loT = label.new(lx0, pl, nm + " Low", style = stH, textcolor = lblCol, color = color.new(color.black, 100), size = szOf(lblSz))
            array.push(lbls, hiT)
            array.push(lbls, loT)
        while array.size(lns) > keepN * 5
            for k = 1 to 5
                line old = array.shift(lns)
                if not na(old)
                    line.delete(old)
        while array.size(lbls) > keepN * 2
            label oldL = array.shift(lbls)
            label.delete(oldL)

f_extend(array<line> lns, array<label> lbls, array<box> bxs) =>
    int sets = array.size(lns) / 5
    if sets > 0
        int x2 = bar_index + (dwmProject ? dwmProjBars : 0)
        int fromSet = dwmExtend ? 0 : sets - 1
        for si = fromSet to sets - 1
            for k = 0 to 4
                line ln = array.get(lns, si * 5 + k)
                if not na(ln)
                    line.set_x2(ln, x2)
        int bsets = array.size(bxs) / 2
        if bsets > 0
            int bFrom = dwmExtend ? 0 : bsets - 1
            for si = bFrom to bsets - 1
                for k = 0 to 1
                    box bx = array.get(bxs, si * 2 + k)
                    if not na(bx)
                        box.set_right(bx, x2)
        int lsets = array.size(lbls) / 2
        if lsets > 0 and dwmHLLabelPos != "Outside left"
            int lFrom = dwmExtend ? 0 : lsets - 1
            for si = lFrom to lsets - 1
                label hb = array.get(lbls, si * 2)
                label lb = array.get(lbls, si * 2 + 1)
                int lx = dwmHLLabelPos == "Inside middle" ? (label.get_x(hb) + x2) / 2 : x2
                label.set_x(hb, lx)
                label.set_x(lb, lx)

if rangesOn and dwmHLDaily and newD
    f_spawn(dLines, dLbls, dBoxes, prevDH, prevDL, prevDStart, dwmHLDailyColor, dwmHLDailyW, dwmHLDailyShow, "Day", dwmLblDCol, dwmLblDSz, hlLinesOn, quartsOn, zonesOn)
    f_fade(dLines, dwmHLDailyColor)
if rangesOn and dwmHLWeekly and newW
    f_spawn(wLines, wLbls, wBoxes, prevWH, prevWL, prevWStart, dwmHLWeeklyColor, dwmHLWeeklyW, dwmHLWeeklyShow, "Week", dwmLblWCol, dwmLblWSz, hlLinesOn, quartsOn, zonesOn)
    f_fade(wLines, dwmHLWeeklyColor)
if rangesOn and dwmHLMonthly and newM
    f_spawn(mLines, mLbls, mBoxes, prevMH, prevML, prevMStart, dwmHLMonthlyColor, dwmHLMonthlyW, dwmHLMonthlyShow, "Month", dwmLblMCol, dwmLblMSz, hlLinesOn, quartsOn, zonesOn)
    f_fade(mLines, dwmHLMonthlyColor)
if rangesOn
    f_extend(dLines, dLbls, dBoxes)
    f_extend(wLines, wLbls, wBoxes)
    f_extend(mLines, mLbls, mBoxes)

// // ── Display box engine — every read here is chosen to lead, not confirm ────
float vaWidthNow = (na(ptVahNow) or na(ptValNow)) ? na : ptVahNow - ptValNow
float vaWidthRank = na(vaWidthNow) ? 50.0 : ta.percentrank(vaWidthNow, boxSqueezeLook)
bool squeezeOn = not na(vaWidthNow) and vaWidthRank <= 20
bool absorbOn = fuelVal >= boxAbsorbFuel and math.abs(close - open) <= atrV * boxAbsorbAtr and math.abs(barDelta) > 0
// release: the first VA break WITH agreeing delta after a coil (squeeze or
// absorption) — the compression actually resolving, one-shot per episode.
var int coilBar = na
var bool releaseFired = false
if squeezeOn or absorbOn
    if na(coilBar) or (bar_index - coilBar) > releaseWindow
        releaseFired := false
    coilBar := bar_index
bool coiledRecently = not na(coilBar) and (bar_index - coilBar) <= releaseWindow
bool releaseUpNow = coiledRecently and not releaseFired and not na(ptVahNow) and close > ptVahNow and barDelta > 0
bool releaseDnNow = coiledRecently and not releaseFired and not na(ptValNow) and close < ptValNow and barDelta < 0
var int releaseBar = na
var int releaseDir = 0
if releaseUpNow
    releaseFired := true
    releaseBar := bar_index
    releaseDir := 1
if releaseDnNow
    releaseFired := true
    releaseBar := bar_index
    releaseDir := -1
bool releaseShow = not na(releaseBar) and (bar_index - releaseBar) <= releaseHoldBars
// ── Print path — are the prints themselves climbing, falling, or going nowhere
// Splits the last N prints in half and compares the newer half's average level
// against the older half's, in ATR. Size trading higher and higher is a
// different statement from one print in a rising market: it says every fresh
// commitment is happening at a better price for the side that keeps showing up.
float mdPathDelta = 0.0
int mdPathTot = array.size(mdPathPx)
int mdPathUse = math.min(mdPathN, mdPathTot)
if mdPathUse >= 4
    int half = mdPathUse / 2
    float newSum = 0.0
    float oldSum = 0.0
    for i = 0 to half - 1
        newSum += array.get(mdPathPx, mdPathTot - 1 - i)
        oldSum += array.get(mdPathPx, mdPathTot - mdPathUse + i)
    mdPathDelta := (newSum - oldSum) / half / math.max(syminfo.mintick, nz(atrV, syminfo.mintick))
int mdvPath = mdPathUse < 4 ? 0 : mdPathDelta >= mdPathMin ? 1 : mdPathDelta <= -mdPathMin ? -1 : 0

// ── MDP read — five inputs, one score, three states ─────────────────────────
// Reads every bar instead of waiting for price to leave value, so it moves as
// soon as the drivers do. Four votes, each -1 / 0 / +1:
//   ACCEPTANCE  which way the POC is migrating — hardest to fake, weighted most
//   STRUCTURE   the latched pivot state
//   LOCATION    above value / inside / below value
//   FLOW        the live delta of the forming HTF candle
//   PATH        whether the prints themselves are landing higher or lower
// Sponsorship does not vote. It SCALES: a move with thin participation and
// unpaid fuel keeps its direction but loses conviction, which is how an
// unsponsored push ends up FLAT without pretending it is balanced.
int mdvAcc = ptDir
int mdvStr = structDir
int mdvLoc = valocState == 2 ? 1 : valocState == -2 ? -1 : 0
int mdvFlow = nz(liveDelta) > 0 ? 1 : nz(liveDelta) < 0 ? -1 : 0
float mdRawScore = mdvAcc * mdReadWAcc + mdvStr * mdReadWStr + mdvLoc * mdReadWLoc + mdvFlow * mdReadWFlow + mdvPath * mdReadWPath
// sponsorship scalar: full weight when the crowd is present and paying,
// down to the damp floor when the move is running on nobody
float mdSpon = math.max(0.0, math.min(1.0, (part / 100.0 + math.min(1.0, fuelVal)) / 2.0))
float mdReadScore = mdRawScore * (mdReadDamp + (1.0 - mdReadDamp) * mdSpon)
string mdReadTxt = mdReadScore >= mdReadTh ? "BULL" : mdReadScore <= -mdReadTh ? "BEAR" : "FLAT"
int mdReadDir = mdReadScore >= mdReadTh ? 1 : mdReadScore <= -mdReadTh ? -1 : 0
f_vg(int v) =>
    v == 1 ? "▲" : v == -1 ? "▼" : "▶"
string mdReadWhy = "A" + f_vg(mdvAcc) + " S" + f_vg(mdvStr) + " V" + f_vg(mdvLoc) + " F" + f_vg(mdvFlow) + " P" + f_vg(mdvPath)

string partLbl = part >= bandClimax ? "Climax" : part <= 40 ? "Thin" : "Building"
string fuelLbl = fuelVal >= 0.6 ? "Paid" : fuelVal >= 0.3 ? "Partial" : "Unpaid"
string ptLbl = ptDir == 1 ? "Rising" : ptDir == -1 ? "Falling" : "Flat"
string structLbl = structDir == 1 ? "Bull" : structDir == -1 ? "Bear" : "Neutral"
color partColBox = part >= bandClimax ? volOscGreen : part <= 40 ? volOscRed : colNeut
color fuelColBox = fuelVal >= 0.6 ? colBull : fuelVal >= 0.3 ? colNeut : colBear
color ptColBox = ptDir == 1 ? colBull : ptDir == -1 ? colBear : colNeut
color structColBox = structDir == 1 ? colBull : structDir == -1 ? colBear : colNeut

// ── Bias engine — acceptance · structure · order flow, scored ───────────────
// Chart timeframe: acceptance = the POC trend row's direction, structure = the
// latched Market-structure state, flow = recency-weighted chart-bar delta.
// HTF: the same three computed on the selected timeframe's own bars inside one
// request.security call. Agreement is the signal; disagreement reads as
// CONSOLIDATION rather than being forced into a side.
f_flowVote(float sc, float mixTh) =>
    sc > mixTh ? 1 : sc < -mixTh ? -1 : 0
f_biasScore(int a, int st, int fl) =>
    float sc = a * biasWAcc + st * biasWStr + fl * biasWFlow
    string lbl = sc >= biasThresh ? "BULL" : sc <= -biasThresh ? "BEAR" : "CONSOLIDATION"
    [lbl, sc]
f_voteGlyph(int v) =>
    v == 1 ? "▲" : v == -1 ? "▼" : "▶"
// chart-TF flow score: recency-weighted true delta, normalised by average |Δ|
int biasN = array.size(biasDeltaHist)
float bfWSum = 0.0
float bfWTot = 0.0
float bfAbs = 0.0
if biasN > 0
    for i = 0 to biasN - 1
        float d = array.get(biasDeltaHist, i)
        float w = i + 1.0                     // oldest = weight 1 … newest = weight N
        bfWSum += d * w
        bfWTot += w
        bfAbs += math.abs(d)
    bfAbs := bfAbs / biasN
float bfScore = bfAbs > 0 ? (bfWSum / bfWTot) / bfAbs : 0.0
float biasPocOldest = biasN > 0 ? array.get(biasPocHist, 0) : na
float biasMig = na(barPocNow) or na(biasPocOldest) ? 0.0 : (barPocNow - biasPocOldest) / math.max(syminfo.mintick, atrV)
int biasAccV = biasMig > 0.1 ? 1 : biasMig < -0.1 ? -1 : 0
int biasStrV = structDir
int biasFlowV = f_flowVote(bfScore, biasMixTh)
[biasLbl, biasSc] = f_biasScore(biasAccV, biasStrV, biasFlowV)
string biasVotes = "A" + f_voteGlyph(biasAccV) + " S" + f_voteGlyph(biasStrV) + " F" + f_voteGlyph(biasFlowV)
color biasCol = biasLbl == "BULL" ? colBull : biasLbl == "BEAR" ? colBear : colNeut

// HTF votes, computed on the selected timeframe's own bars
htfBiasVotes(simple int n, simple int migK, simple float mixTh, simple int pl) =>
    // flow: recency-weighted bar-polarity delta on this context
    float sv = close > open ? nz(volume) : close < open ? -nz(volume) : 0.0
    float wSum = 0.0
    float wTot = 0.0
    float aAbs = 0.0
    // n = 0 must do nothing: `for i = 0 to -1` counts DOWN in Pine
    if n > 0
        for i = 0 to n - 1
            float d = nz(sv[i])
            float w = n - i
            wSum += d * w
            wTot += w
            aAbs += math.abs(d)
        aAbs := aAbs / n
    float sc = aAbs > 0 ? (wSum / wTot) / aAbs : 0.0
    int flowV = sc > mixTh ? 1 : sc < -mixTh ? -1 : 0
    // acceptance: POC over the last n bars (each bar's volume spread across its
    // range, capped bins), compared against the same POC migK bars ago
    map<int, float> prof = map.new<int, float>()
    f_binProfile(prof, 0, n)
    float bestV = 0.0
    int bestB = na
    array<int> pks = map.keys(prof)
    for k in pks
        float v = map.get(prof, k)
        if v > bestV
            bestV := v
            bestB := k
    float pocPx = na(bestB) ? na : bestB * pocBinSize
    float pocPrev = pocPx[migK]
    float atrH = ta.atr(14)
    float mig = na(pocPx) or na(pocPrev) ? 0.0 : (pocPx - pocPrev) / math.max(syminfo.mintick, atrH)
    int accV = mig > 0.1 ? 1 : mig < -0.1 ? -1 : 0
    // structure: latched pivot state on this context
    float ph = ta.pivothigh(pl, pl)
    float plo = ta.pivotlow(pl, pl)
    var float lph = na
    var float lpl = na
    var int sd = 0
    if not na(ph)
        lph := ph
    if not na(plo)
        lpl := plo
    if not na(lph) and close > lph
        sd := 1
    if not na(lpl) and close < lpl
        sd := -1
    [accV, sd, flowV]
string biasTfRaw = biasHtf == "1 hour" ? "60" : biasHtf == "2 hours" ? "120" : biasHtf == "4 hours" ? "240" : biasHtf == "1 day" ? "D" : biasHtf == "1 week" ? "W" : "M"
string biasTfEff = memSaver or timeframe.in_seconds(biasTfRaw) < chartSec ? timeframe.period : biasTfRaw
[hbAccV, hbStrV, hbFlowV] = request.security(syminfo.tickerid, biasTfEff, htfBiasVotes(memSaver or not bxHtf ? 0 : htfBiasLook, biasMigK, biasMixTh, pivLen), lookahead = barmerge.lookahead_off)
int hbAcc = nz(hbAccV, 0)
int hbStr = nz(hbStrV, 0)
int hbFlow = nz(hbFlowV, 0)
[hbLbl, hbSc] = f_biasScore(hbAcc, hbStr, hbFlow)
string hbVotes = "A" + f_voteGlyph(hbAcc) + " S" + f_voteGlyph(hbStr) + " F" + f_voteGlyph(hbFlow)
color hbCol = hbLbl == "BULL" ? colBull : hbLbl == "BEAR" ? colBear : colNeut
string hbTfLbl = biasHtf == "1 hour" ? "1H" : biasHtf == "2 hours" ? "2H" : biasHtf == "4 hours" ? "4H" : biasHtf == "1 day" ? "1D" : biasHtf == "1 week" ? "1W" : "1M"

// rows are collected into arrays, then rendered by the chosen layout — the
// same smart-wrap pattern as the ΔC info box. Table is rebuilt on the last bar.
var table boxT = na
// box colours: the three shared states map onto the box's own palette
f_bx(color c) =>
    c == colBull ? bxBullC : c == colBear ? bxBearC : c == colNeut ? bxNeutC : c
// label colour by what the row says, not its position (rows can be hidden)
f_lc(string l, color valC, color baseC) =>
    str.startswith(l, "⚡") ? bxWarnC : str.startswith(l, "⚠") ? bxAccC : str.startswith(l, "▲") or str.startswith(l, "▼") ? valC : baseC
if mBox and barstate.islast and not memSaver
    var array<string> bLbl = array.new_string()
    var array<string> bSh  = array.new_string()
    var array<string> bVal = array.new_string()
    var array<color>  bCol = array.new_color()
    array.clear(bLbl), array.clear(bSh), array.clear(bVal), array.clear(bCol)
    color volBgColBox = volOsc >= volBgHigh ? volOscGreen : volOsc <= volBgLow ? volOscRed : colNeut
    string relTxt = releaseShow ? (releaseDir == 1 ? "▲ RELEASE" : "▼ RELEASE") : "Release"
    color relCol = releaseShow ? (releaseDir == 1 ? colBull : colBear) : color.gray
    if bxDelta
        array.push(bLbl, "Δ (live)"),      array.push(bSh, "Δ"),      array.push(bVal, str.tostring(math.round(liveDelta))),                   array.push(bCol, f_bx(liveDelta > 0 ? colBull : liveDelta < 0 ? colBear : colNeut))
    if bxPart
        array.push(bLbl, "Participation"), array.push(bSh, "Part"),   array.push(bVal, partLbl + "  " + str.tostring(math.round(part)) + "%"), array.push(bCol, f_bx(partColBox))
    if bxVolBg
        array.push(bLbl, "Vol BG"),        array.push(bSh, "VolBG"),  array.push(bVal, str.tostring(math.round(volOsc)) + "%"),               array.push(bCol, f_bx(volBgColBox))
    if bxFuel
        array.push(bLbl, "Fuel"),          array.push(bSh, "Fuel"),   array.push(bVal, fuelLbl),                                              array.push(bCol, f_bx(fuelColBox))
    if bxPocTrend
        array.push(bLbl, "POC trend"),     array.push(bSh, "PoC"),    array.push(bVal, ptLbl),                                                array.push(bCol, f_bx(ptColBox))
    if bxStruct
        array.push(bLbl, "Structure"),     array.push(bSh, "Struct"), array.push(bVal, structLbl),                                            array.push(bCol, f_bx(structColBox))
    if bxVaWidth
        array.push(bLbl, squeezeOn ? "⚡ SQUEEZE" : "VA width"), array.push(bSh, squeezeOn ? "⚡SQZ" : "VA"), array.push(bVal, squeezeOn ? "coiled" : str.tostring(math.round(vaWidthRank)) + "%ile"), array.push(bCol, f_bx(squeezeOn ? bxWarnC : colNeut))
    if bxAbsorb
        array.push(bLbl, absorbOn ? "⚠ ABSORPTION" : "Absorption"), array.push(bSh, absorbOn ? "⚠ABS" : "Abs"), array.push(bVal, absorbOn ? "active" : " "), array.push(bCol, bxAccC)
    if bxRelease
        array.push(bLbl, relTxt),          array.push(bSh, releaseShow ? (releaseDir == 1 ? "▲Rel" : "▼Rel") : "Rel"), array.push(bVal, releaseShow ? (releaseDir == 1 ? "up" : "down") : " "), array.push(bCol, f_bx(relCol))
    if bxBias
        array.push(bLbl, "Bias"),          array.push(bSh, "Bias"),   array.push(bVal, biasLbl + "  " + biasVotes),                          array.push(bCol, f_bx(biasCol))
    if bxHtf
        array.push(bLbl, "HTF bias (" + hbTfLbl + ")"), array.push(bSh, "HTF " + hbTfLbl), array.push(bVal, hbLbl + "  " + hbVotes),         array.push(bCol, f_bx(hbCol))
    if bxVaLoc
        array.push(bLbl, "VA Location (" + valocTf + ")"), array.push(bSh, "VAloc"), array.push(bVal, valocLbl), array.push(bCol, f_bx(valocCol))
    if bxPocLoc
        array.push(bLbl, "POC Location (" + valocTf + ")"), array.push(bSh, "POCloc"), array.push(bVal, pocLocLbl), array.push(bCol, bxAccC)
    if bxMdpRead
        color scC = mdReadDir > 0 ? bxBullC : mdReadDir < 0 ? bxBearC : bxNeutC
        string readVal = mdReadTxt + "  " + str.tostring(mdReadScore, "#.#") + "  " + mdReadWhy
        array.push(bLbl, "MDP read"), array.push(bSh, "Read"), array.push(bVal, readVal), array.push(bCol, scC)
    if bxLdr
        color ldrC = not mdLdrReady ? color.gray : mdLdrNet >= mdLdrTh ? bxBullC : mdLdrNet <= -mdLdrTh ? bxBearC : bxNeutC
        string ldrVal = mdLdrTxt + "  " + str.tostring(mdLdrNet, "#.#") + "  F" + str.tostring(mdLdrFuel) + " O" + str.tostring(mdLdrOne) + " A" + str.tostring(mdLdrAbsN)
        array.push(bLbl, "MDP-LDR"), array.push(bSh, "LDR"), array.push(bVal, ldrVal), array.push(bCol, ldrC)

    int nB = array.size(bLbl)
    bool mobile = boxLayout == "Mobile"
    bool horiz = boxLayout == "Horizontal"
    string tsz = mobile ? size.tiny : boxSz == "Tiny" ? size.tiny : boxSz == "Normal" ? size.normal : size.small
    color lblC = bxLblC
    color headBg = bxHeadC
    color frameC = bxFrameC
    string posS = boxPos == "Top right" ? position.top_right : boxPos == "Top left" ? position.top_left : boxPos == "Bottom right" ? position.bottom_right : position.bottom_left
    if not na(boxT)
        table.delete(boxT)
        boxT := na
    if horiz
        // HORIZONTAL — header strip, then labels across row 1, values across row 2
        boxT := table.new(posS, nB, 3, border_width = 1, border_color = frameC, frame_color = frameC, frame_width = 1, bgcolor = bxBgC)
        table.cell(boxT, 0, 0, "STRYK:M", text_color = color.white, bgcolor = headBg, text_size = tsz)
        if nB > 1
            table.merge_cells(boxT, 0, 0, nB - 1, 0)
        for i = 0 to nB - 1
            table.cell(boxT, i, 1, array.get(bLbl, i), text_color = f_lc(array.get(bLbl, i), array.get(bCol, i), lblC), text_size = tsz)
            table.cell(boxT, i, 2, array.get(bVal, i), text_color = array.get(bCol, i), text_size = tsz)
    else if mobile
        // MOBILE — short labels, Tiny, smart wrap: fill down each column, spill right
        int wrapN = boxWrap > 0 ? math.min(boxWrap, nB) : nB
        int nCols = (nB + wrapN - 1) / wrapN
        boxT := table.new(posS, 2 * nCols, wrapN + 1, border_width = 1, border_color = frameC, frame_color = frameC, frame_width = 1, bgcolor = bxBgC)
        table.cell(boxT, 0, 0, "STRYK:M", text_color = color.white, bgcolor = headBg, text_size = tsz)
        if nCols > 1
            table.merge_cells(boxT, 0, 0, 2 * nCols - 1, 0)
        for i = 0 to nB - 1
            int cCol = (i / wrapN) * 2
            int cRow = (i % wrapN) + 1
            table.cell(boxT, cCol, cRow, array.get(bSh, i), text_color = f_lc(array.get(bSh, i), array.get(bCol, i), lblC), text_size = tsz)
            table.cell(boxT, cCol + 1, cRow, array.get(bVal, i), text_color = array.get(bCol, i), text_size = tsz)
    else
        // VERTICAL — classic label | value column
        boxT := table.new(posS, 2, nB + 1, border_width = 1, border_color = frameC, frame_color = frameC, frame_width = 1, bgcolor = bxBgC)
        table.cell(boxT, 0, 0, "STRYK:M", text_color = color.white, bgcolor = headBg, text_size = tsz)
        table.cell(boxT, 1, 0, "", bgcolor = headBg)
        for i = 0 to nB - 1
            table.cell(boxT, 0, i + 1, array.get(bLbl, i), text_color = f_lc(array.get(bLbl, i), array.get(bCol, i), lblC), text_size = tsz)
            table.cell(boxT, 1, i + 1, array.get(bVal, i), text_color = array.get(bCol, i), text_size = tsz)

// panel helpers — declared at top level, Pine allows no local function scope
f_ravg(array<float> a, array<int> n, int kd) =>
    int c = array.get(n, kd)
    c > 0 ? array.get(a, kd) / c : na
f_rtxt(float v) =>
    na(v) ? "—" : str.tostring(v, "#.##")
f_rpct(array<int> a, array<int> n, int kd) =>
    int c = array.get(n, kd)
    c > 0 ? str.tostring(array.get(a, kd) * 100.0 / c, "#.0") + "%" : "—"

// ── MDP research panel — prints vs an ordinary-bar control ───────────────────
// Every number is shown against the control, because MFE of 0.6R means nothing
// until you know what an ordinary bar does over the same window.
var table mdRT = na
if mdResearch and mdShowPanel and barstate.islast and not memSaver
    string rpos = mdRPos == "Top right" ? position.top_right : mdRPos == "Top left" ? position.top_left :
         mdRPos == "Bottom right" ? position.bottom_right : mdRPos == "Bottom left" ? position.bottom_left : position.middle_right
    if not na(mdRT)
        table.delete(mdRT)
        mdRT := na
    mdRT := table.new(rpos, 4, 8, border_width = 1, border_color = bxFrameC, frame_color = bxFrameC, frame_width = 1)
    table.cell(mdRT, 0, 0, "MDP RESEARCH " + str.tostring(mdFwdBars) + "b · " + (mdRUnit == "ATR" ? "ATR" : "R"), text_color = color.white, bgcolor = bxHeadC, text_size = size.tiny)
    table.cell(mdRT, 1, 0, "AGG", text_color = mdColAgg, bgcolor = bxHeadC, text_size = size.tiny)
    table.cell(mdRT, 2, 0, "ABS", text_color = mdColAbs, bgcolor = bxHeadC, text_size = size.tiny)
    table.cell(mdRT, 3, 0, "control", text_color = bxLblC, bgcolor = bxHeadC, text_size = size.tiny)
    array<string> rlab = array.from("", "Completed", "Avg MFE", "Avg MAE", "Avg final", "Final > 0", "Hit high", "Hit low")
    for r = 1 to 7
        table.cell(mdRT, 0, r, array.get(rlab, r), text_color = bxLblC, text_size = size.tiny)
    for kd = 0 to 2
        int col = kd == 1 ? 1 : kd == 2 ? 2 : 3
        color cc = kd == 1 ? mdColAgg : kd == 2 ? mdColAbs : bxLblC
        float fin = f_ravg(mdRFin, mdRN, kd)
        color fc = na(fin) ? cc : fin > 0 ? bxBullC : fin < 0 ? bxBearC : cc
        table.cell(mdRT, col, 1, str.tostring(array.get(mdRN, kd)), text_color = cc, text_size = size.tiny)
        table.cell(mdRT, col, 2, f_rtxt(f_ravg(mdRMfe, mdRN, kd)), text_color = cc, text_size = size.tiny)
        table.cell(mdRT, col, 3, f_rtxt(f_ravg(mdRMae, mdRN, kd)), text_color = cc, text_size = size.tiny)
        table.cell(mdRT, col, 4, f_rtxt(fin), text_color = fc, text_size = size.tiny)
        table.cell(mdRT, col, 5, f_rpct(mdRWin, mdRN, kd), text_color = cc, text_size = size.tiny)
        table.cell(mdRT, col, 6, f_rpct(mdRHitHi, mdRN, kd), text_color = cc, text_size = size.tiny)
        table.cell(mdRT, col, 7, f_rpct(mdRHitLo, mdRN, kd), text_color = cc, text_size = size.tiny)

// ── Alerts — one per display-box row, on CONFIRMED bars, on state CHANGE ──
// Each row's state is compared to its own previous bar so an alert fires once
// when the read changes, not on every bar it holds. Release fires on the bar it
// triggered. alert() carries live values; alertcondition() gives each its own
// named entry in the alert dialog (constant text, TradingView placeholders).
bool alertOk = mAlerts and barstate.isconfirmed and not memSaver
// row 1 · Δ (live): sign flip of the forming delta-TF candle's delta
int dSignNow = liveDelta > 0 ? 1 : liveDelta < 0 ? -1 : 0
bool aDeltaPos = dSignNow == 1 and nz(dSignNow[1], 0) != 1
bool aDeltaNeg = dSignNow == -1 and nz(dSignNow[1], 0) != -1
// row 2 · Participation: enters Climax / enters Thin
bool aPartClimax = partLbl == "Climax" and partLbl[1] != "Climax"
bool aPartThin = partLbl == "Thin" and partLbl[1] != "Thin"
// row 3 · Vol BG: crosses into the high / low tint zone
bool aVolBgHigh = volOsc >= volBgHigh and volOsc[1] < volBgHigh
bool aVolBgLow = volOsc <= volBgLow and volOsc[1] > volBgLow
bool aVolBgHighExit = volOsc < volBgHigh and volOsc[1] >= volBgHigh
bool aVolBgLowExit = volOsc > volBgLow and volOsc[1] <= volBgLow
// participation exits too — leaving climax / recovering from thin
bool aPartClimaxExit = partLbl != "Climax" and partLbl[1] == "Climax"
bool aPartThinExit = partLbl != "Thin" and partLbl[1] == "Thin"
// row 4 · Fuel: becomes Paid / becomes Unpaid
bool aFuelPaid = fuelLbl == "Paid" and fuelLbl[1] != "Paid"
bool aFuelUnpaid = fuelLbl == "Unpaid" and fuelLbl[1] != "Unpaid"
// row 5 · POC trend: migration direction changes
bool aPocRising = ptDir == 1 and ptDir[1] != 1
bool aPocFalling = ptDir == -1 and ptDir[1] != -1
// row 6 · Structure: latched state flips
bool aStructBull = structDir == 1 and structDir[1] != 1
bool aStructBear = structDir == -1 and structDir[1] != -1
// row 7 · Squeeze: flag turns on
bool aSqueeze = squeezeOn and not squeezeOn[1]
// row 8 · Absorption: flag turns on
bool aAbsorb = absorbOn and not absorbOn[1]
// row 9 · Release: fired on this bar
bool aRelUp = not na(releaseBar) and releaseBar == bar_index and releaseDir == 1
bool aRelDn = not na(releaseBar) and releaseBar == bar_index and releaseDir == -1
// rows 10-11 · Bias / HTF bias: read changes
bool aBiasBull = biasLbl == "BULL" and biasLbl[1] != "BULL"
bool aBiasBear = biasLbl == "BEAR" and biasLbl[1] != "BEAR"
bool aBiasCons = biasLbl == "CONSOLIDATION" and biasLbl[1] != "CONSOLIDATION"
bool aHbBull = hbLbl == "BULL" and hbLbl[1] != "BULL"
bool aHbBear = hbLbl == "BEAR" and hbLbl[1] != "BEAR"
bool aHbCons = hbLbl == "CONSOLIDATION" and hbLbl[1] != "CONSOLIDATION"
// row 12 · VA Location: crossing zone
bool aValocAbove = valocState == 2 and valocState[1] != 2
bool aValocBelow = valocState == -2 and valocState[1] != -2
bool aValocInside = (valocState == 0 or valocState == 1 or valocState == -1 or valocState == 3) and (valocState[1] == 2 or valocState[1] == -2)
bool aValocPoc = valocState == 3 and valocState[1] != 3
bool aValocVah = valocState == 1 and valocState[1] != 1
bool aValocVal = valocState == -1 and valocState[1] != -1

if alertOk
    if aDeltaPos and bxDelta
        alert("STRYK:M [" + dTf + "] Δ flipped POSITIVE (" + str.tostring(math.round(liveDelta)) + ").", alert.freq_once_per_bar)
    if aDeltaNeg and bxDelta
        alert("STRYK:M [" + dTf + "] Δ flipped NEGATIVE (" + str.tostring(math.round(liveDelta)) + ").", alert.freq_once_per_bar)
    if aPartClimax and bxPart
        alert("STRYK:M participation CLIMAX (" + str.tostring(math.round(part)) + "%).", alert.freq_once_per_bar)
    if aPartThin and bxPart
        alert("STRYK:M participation THIN (" + str.tostring(math.round(part)) + "%).", alert.freq_once_per_bar)
    if aVolBgHigh and bxVolBg
        alert("STRYK:M volume BG HIGH (" + str.tostring(math.round(volOsc)) + "%).", alert.freq_once_per_bar)
    if aVolBgLow and bxVolBg
        alert("STRYK:M volume BG LOW (" + str.tostring(math.round(volOsc)) + "%).", alert.freq_once_per_bar)
    if aVolBgHighExit and bxVolBg
        alert("STRYK:M volume BG left the HIGH zone (" + str.tostring(math.round(volOsc)) + "%).", alert.freq_once_per_bar)
    if aVolBgLowExit and bxVolBg
        alert("STRYK:M volume BG left the LOW zone (" + str.tostring(math.round(volOsc)) + "%).", alert.freq_once_per_bar)
    if aPartClimaxExit and bxPart
        alert("STRYK:M participation left CLIMAX (" + str.tostring(math.round(part)) + "%).", alert.freq_once_per_bar)
    if aPartThinExit and bxPart
        alert("STRYK:M participation recovered from THIN (" + str.tostring(math.round(part)) + "%).", alert.freq_once_per_bar)
    if aFuelPaid and bxFuel
        alert("STRYK:M fuel PAID — participation behind the move.", alert.freq_once_per_bar)
    if aFuelUnpaid and bxFuel
        alert("STRYK:M fuel UNPAID — move without participation.", alert.freq_once_per_bar)
    if aPocRising and bxPocTrend
        alert("STRYK:M [" + dTf + "] POC trend RISING — acceptance migrating up.", alert.freq_once_per_bar)
    if aPocFalling and bxPocTrend
        alert("STRYK:M [" + dTf + "] POC trend FALLING — acceptance migrating down.", alert.freq_once_per_bar)
    if aStructBull and bxStruct
        alert("STRYK:M structure flipped BULL.", alert.freq_once_per_bar)
    if aStructBear and bxStruct
        alert("STRYK:M structure flipped BEAR.", alert.freq_once_per_bar)
    if aSqueeze and bxVaWidth
        alert("STRYK:M ⚡ SQUEEZE — value area coiled (" + str.tostring(math.round(vaWidthRank)) + "%ile).", alert.freq_once_per_bar)
    if aAbsorb and bxAbsorb
        alert("STRYK:M ⚠ ABSORPTION — participation without price result.", alert.freq_once_per_bar)
    if aRelUp and bxRelease
        alert("STRYK:M ▲ RELEASE UP — closed above value with buying delta.", alert.freq_once_per_bar)
    if aRelDn and bxRelease
        alert("STRYK:M ▼ RELEASE DOWN — closed below value with selling delta.", alert.freq_once_per_bar)
    if aBiasBull and bxBias
        alert("STRYK:M bias BULL (" + biasVotes + ").", alert.freq_once_per_bar)
    if aBiasBear and bxBias
        alert("STRYK:M bias BEAR (" + biasVotes + ").", alert.freq_once_per_bar)
    if aBiasCons and bxBias
        alert("STRYK:M bias CONSOLIDATION (" + biasVotes + ").", alert.freq_once_per_bar)
    if aHbBull and bxHtf
        alert("STRYK:M HTF bias (" + hbTfLbl + ") BULL (" + hbVotes + ").", alert.freq_once_per_bar)
    if aHbBear and bxHtf
        alert("STRYK:M HTF bias (" + hbTfLbl + ") BEAR (" + hbVotes + ").", alert.freq_once_per_bar)
    if aHbCons and bxHtf
        alert("STRYK:M HTF bias (" + hbTfLbl + ") CONSOLIDATION (" + hbVotes + ").", alert.freq_once_per_bar)
    if aValocAbove and bxVaLoc
        alert("STRYK:M VA Location (" + valocTf + ") moved ABOVE the value area.", alert.freq_once_per_bar)
    if aValocBelow and bxVaLoc
        alert("STRYK:M VA Location (" + valocTf + ") moved BELOW the value area.", alert.freq_once_per_bar)
    if aValocInside and bxVaLoc
        alert("STRYK:M VA Location (" + valocTf + ") moved INSIDE the value area.", alert.freq_once_per_bar)
    if aValocPoc and bxPocLoc
        alert("STRYK:M POC Location (" + valocTf + ") price reached the POC.", alert.freq_once_per_bar)
    if aValocVah and bxVaLoc
        alert("STRYK:M VA Location (" + valocTf + ") touched VAH (" + valocLbl + ").", alert.freq_once_per_bar)
    if aValocVal and bxVaLoc
        alert("STRYK:M VA Location (" + valocTf + ") touched VAL (" + valocLbl + ").", alert.freq_once_per_bar)

// one named condition per row, firing on EITHER side — the alert() route above
// carries the exact side and live values. Kept to 14 because TradingView counts
// every alertcondition() toward the 64-plot limit.
alertcondition((aDeltaPos or aDeltaNeg) and bxDelta and mAlerts, "Δ — sign flip", "STRYK:M {{ticker}} {{interval}} — Δ flipped sign at {{close}}.")
alertcondition((aPartClimax or aPartThin or aPartClimaxExit or aPartThinExit) and bxPart and mAlerts, "Participation — zone change", "STRYK:M {{ticker}} {{interval}} — participation entered or left climax/thin at {{close}}.")
alertcondition((aVolBgHigh or aVolBgLow or aVolBgHighExit or aVolBgLowExit) and bxVolBg and mAlerts, "Vol BG — zone change", "STRYK:M {{ticker}} {{interval}} — volume BG entered or left its high/low zone at {{close}}.")
alertcondition((aFuelPaid or aFuelUnpaid) and bxFuel and mAlerts, "Fuel — paid / unpaid", "STRYK:M {{ticker}} {{interval}} — fuel turned paid or unpaid at {{close}}.")
alertcondition((aPocRising or aPocFalling) and bxPocTrend and mAlerts, "POC trend — turned", "STRYK:M {{ticker}} {{interval}} — POC trend turned rising or falling at {{close}}.")
alertcondition((aStructBull or aStructBear) and bxStruct and mAlerts, "Structure — flip", "STRYK:M {{ticker}} {{interval}} — structure flipped at {{close}}.")
alertcondition(aSqueeze and bxVaWidth and mAlerts, "⚡ Squeeze", "STRYK:M {{ticker}} {{interval}} — squeeze: value area coiled at {{close}}.")
alertcondition(aAbsorb and bxAbsorb and mAlerts, "⚠ Absorption", "STRYK:M {{ticker}} {{interval}} — absorption at {{close}}.")
alertcondition((aRelUp or aRelDn) and bxRelease and mAlerts, "Release — either side", "STRYK:M {{ticker}} {{interval}} — release at {{close}}.")
alertcondition((aBiasBull or aBiasBear or aBiasCons) and bxBias and mAlerts, "Bias — changed", "STRYK:M {{ticker}} {{interval}} — bias changed at {{close}}.")
alertcondition((aHbBull or aHbBear or aHbCons) and bxHtf and mAlerts, "HTF bias — changed", "STRYK:M {{ticker}} {{interval}} — HTF bias changed at {{close}}.")
alertcondition((aValocAbove or aValocBelow or aValocInside) and bxVaLoc and mAlerts, "VA Location — changed", "STRYK:M {{ticker}} {{interval}} — price moved above, below or back inside the value area at {{close}}.")
alertcondition((aValocVah or aValocVal) and bxVaLoc and mAlerts, "VA Location — edge touch", "STRYK:M {{ticker}} {{interval}} — price touched VAH or VAL at {{close}}.")
alertcondition(aValocPoc and bxPocLoc and mAlerts, "POC Location — at POC", "STRYK:M {{ticker}} {{interval}} — price reached the POC at {{close}}.")

// ── Plots ────────────────────────────────────────────────────────────────────
plot(mVwap and showB3 ? rvwapS + multB3 * rsdS : na, "VWAP +3σ", color = bandCol3, linewidth = bandWidth)
plot(mVwap and showB2 ? rvwapS + multB2 * rsdS : na, "VWAP +2σ", color = bandCol2, linewidth = bandWidth)
pU1 = plot(mVwap and showB1 ? rvwapS + multB1 * rsdS : na, "VWAP +1σ", color = bandCol1, linewidth = bandWidth)
plot(mVwap ? rvwapS : na, "Rolling VWAP", color = vwapCol, linewidth = vwapWidth)
pD1 = plot(mVwap and showB1 ? rvwapS - multB1 * rsdS : na, "VWAP −1σ", color = bandCol1, linewidth = bandWidth)
plot(mVwap and showB2 ? rvwapS - multB2 * rsdS : na, "VWAP −2σ", color = bandCol2, linewidth = bandWidth)
plot(mVwap and showB3 ? rvwapS - multB3 * rsdS : na, "VWAP −3σ", color = bandCol3, linewidth = bandWidth)
fill(pU1, pD1, color = mVwap and showB1 and bandFill ? bandFillCol : na, title = "±1σ fill")

plot(mEma ? emaOut : na, "EMA", color = emaCol, linewidth = emaWidth, offset = emaOffset)
plot(mEma ? smoothingMA : na, "EMA-based MA", color = maCol, display = enableMA ? display.all : display.none, editable = enableMA)
bbUpperBand = plot(mEma ? smoothingMA + smoothingStDev : na, "Upper Bollinger Band", color = bbCol, display = isBB ? display.all : display.none, editable = isBB)
bbLowerBand = plot(mEma ? smoothingMA - smoothingStDev : na, "Lower Bollinger Band", color = bbCol, display = isBB ? display.all : display.none, editable = isBB)
fill(bbUpperBand, bbLowerBand, color = isBB and mEma ? color.new(bbCol, 90) : na, title = "Bollinger Bands Background Fill", display = isBB ? display.all : display.none, editable = isBB)
````


