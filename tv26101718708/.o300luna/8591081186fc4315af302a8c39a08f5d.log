var array<label> lLevelDispLabel = array.new_label()

// Leftmost visible bar index of this run (preload filter reference; tracked at
// global scope every bar, right next to the visibleRight tracking below).
var int visibleLeftBarIndex = na

// ---------------------------------------------------------------------------
// CORE SERIES (all ta.* evaluated every bar for correct rolling state)
// ---------------------------------------------------------------------------
atr = ta.atr(atrLength)
// Windowed extremes over the pivotRight bars strictly after a pivot bar.
// Hoisted to global scope so the rolling buffers advance on every bar.
reactHiWin = ta.highest(high, pivotRight)
reactLoWin = ta.lowest(low, pivotRight)

// ---------------------------------------------------------------------------
// DASHBOARD POSITION (const-ish helper; resolved once at global scope)
// ---------------------------------------------------------------------------
f_dashPosition() =>
    string p = position.top_right
    if dashboardPosition == "Top Right"
        p := position.top_right
    else if dashboardPosition == "Bottom Right"
        p := position.bottom_right
    else if dashboardPosition == "Top Left"
        p := position.top_left
    else if dashboardPosition == "Bottom Left"
        p := position.bottom_left
    else if dashboardPosition == "Middle Right"
        p := position.middle_right
    else if dashboardPosition == "Middle Left"
        p := position.middle_left
    else if dashboardPosition == "Top Center"
        p := position.top_center
    else if dashboardPosition == "Bottom Center"
        p := position.bottom_center
    else
        p := position.bottom_left
    p

// Dashboard table (created once at global scope; only cells are updated later).
// columns=3: label / value / right spacer (see dashboard helpers below).
var table dashTable = table.new(position=f_dashPosition(), columns=3, rows=8, bgcolor=color.new(color.black, dashboardBgTransparency), border_color=color.new(color.gray, dashboardBorderTransparency), border_width=dashboardFrameWidth)

// ---------------------------------------------------------------------------
// HELPER FUNCTIONS
// ---------------------------------------------------------------------------

// Clamp a value into [lo, hi].
f_clamp(float v, float lo, float hi) =>
    float r = v
    r := r < lo ? lo : r
    r := r > hi ? hi : r
    r

// Safe candle body size (never zero).
f_safeBody(float o, float c) =>
    float b = math.abs(c - o)
    b <= 0 ? syminfo.mintick : b

// Compute clamped half width of a zone from the selected width mode.
f_zoneHalfWidth(float pivotPrice, float atrAtPivot) =>
    float hw = na
    if zoneWidthMode == "ATR"
        hw := (not na(atrAtPivot) ? atrAtPivot : 0.0) * zoneAtrMult
    else if zoneWidthMode == "Percent"
        hw := pivotPrice * zonePercent / 100.0
    else
        hw := syminfo.mintick * zoneTicks
    // Fallback if invalid.
    if na(hw) or hw <= 0
        hw := syminfo.mintick * minZoneTicks
    // Clamp: not below min ticks, not above ATR-based max.
    float lo = syminfo.mintick * minZoneTicks
    float hi = (not na(atrAtPivot) and atrAtPivot > 0 ? atrAtPivot : syminfo.mintick) * maxZoneWidthAtr
    if hi < lo
        hi := lo
    f_clamp(hw, lo, hi)

// ATR-normalized reaction strength for a confirmed pivot.
// isSupport = true -> support-like event; false -> resistance-like event.
// hiWin / loWin are the windowed extremes computed at global scope every bar.
// Additive: detectionEngine / reactionStrengthMode read as globals inside the
// UDF. Classic reproduces the original Post-Pivot Range behavior EXACTLY;
// Quality Weighted can blend an ATR-normalized close-away component. closeNow is
// the confirmation-bar close (no future data on either Live or Research path).
f_reactionStrengthAtr(bool isSupport, float pivotPrice, float atrAtPivot, float hiWin, float loWin, float closeNow) =>
    float strength = na
    if not na(atrAtPivot) and atrAtPivot > 0
        // Original Post-Pivot Range component (verbatim behavior).
        float rangeStrength = isSupport ? (hiWin - pivotPrice) / atrAtPivot : (pivotPrice - loWin) / atrAtPivot
        float closeAway = math.max(0.0, (isSupport ? (closeNow - pivotPrice) : (pivotPrice - closeNow)) / atrAtPivot)
        if na(closeAway)
            closeAway := 0.0
        if detectionEngine == "Classic"
            strength := rangeStrength
        else if reactionStrengthMode == "Close Away"
            strength := closeAway
        else if reactionStrengthMode == "Hybrid"
            strength := 0.65 * rangeStrength + 0.35 * closeAway
        else
            strength := rangeStrength
    strength

// Wick / body filter at the pivot candle (index pivotRight).
f_passWickFilter(bool isSupport) =>
    bool pass = true
    float o = open[pivotRight]
    float c = close[pivotRight]
    float h = high[pivotRight]
    float l = low[pivotRight]
    if not na(o) and not na(c) and not na(h) and not na(l)
        float safeBody = f_safeBody(o, c)
        float upperWick = h - math.max(o, c)
        float lowerWick = math.min(o, c) - l
        if useWickFilter
            if isSupport
                pass := (lowerWick / safeBody) >= minWickToBodyRatio
            else
                pass := (upperWick / safeBody) >= minWickToBodyRatio
        if pass and useBodyDirectionFilter
            if isSupport
                pass := c > o
            else
                pass := c < o
    else
        pass := false
    pass

// Rejection-wick-to-body ratio at the pivot candle (index pivotRight). Upper
// wick for a resistance-like event (pivot high), lower wick for a support-like
// event (pivot low). A near-zero body yields a large ratio so a doji rejection
// is treated as a strong wick rather than divided by ~0. Local layer only.
f_localWickToBody(bool isSupport) =>
    float o = open[pivotRight]
    float c = close[pivotRight]
    float h = high[pivotRight]
    float l = low[pivotRight]
    float ratio = 0.0
    if not na(o) and not na(c) and not na(h) and not na(l)
        float body = math.abs(c - o)
        float wick = isSupport ? (math.min(o, c) - l) : (h - math.max(o, c))
        float w = na(wick) ? 0.0 : math.max(0.0, wick)
        if body <= syminfo.mintick
            // Near-zero body: any real wick reads as a very strong rejection.
            ratio := w > 0 ? 1000000.0 : 0.0
        else
            ratio := w / body
    ratio

// Simple ATR-normalized local pivot prominence (confirmed offsets only).
// pivotRight>=1 so both pivotRight+1 and pivotRight-1 are valid confirmed bars.
f_pivotProminenceAtr(bool isSupport, float pivotPrice, float atrAtPivot) =>
    float a = (not na(atrAtPivot) and atrAtPivot > 0) ? atrAtPivot : syminfo.mintick
    float prom = 0.0
    if isSupport
        float lo = math.min(low[pivotRight + 1], low[pivotRight - 1])
        prom := na(lo) ? 0.0 : (lo - pivotPrice) / a
    else
        float hi = math.max(high[pivotRight + 1], high[pivotRight - 1])
        prom := na(hi) ? 0.0 : (pivotPrice - hi) / a
    prom < 0 ? 0.0 : prom

// Additive event-quality score (0..100) for a confirmed reaction. Purely a
// visual filtering/scoring component; not a probability or performance measure.
f_eventQuality(bool isSupport, float pivotPrice, float atrAtPivot, float strengthAtr, float closeNow) =>
    float a = (not na(atrAtPivot) and atrAtPivot > 0) ? atrAtPivot : syminfo.mintick
    float reactionScore = math.min(1.0, (na(strengthAtr) ? 0.0 : strengthAtr) / 1.5)
    float wickScore = 1.0
    if useWickFilter
        float o = open[pivotRight]
        float c = close[pivotRight]
        float h = high[pivotRight]
        float l = low[pivotRight]
        if not na(o) and not na(c) and not na(h) and not na(l)
            float wick = isSupport ? (math.min(o, c) - l) : (h - math.max(o, c))
            float w = na(wick) ? 0.0 : math.max(0.0, wick)
            wickScore := math.min(1.0, (w / f_safeBody(o, c)) / 2.0)
        else
            wickScore := 0.0
    float closeAwayRaw = math.max(0.0, isSupport ? (closeNow - pivotPrice) : (pivotPrice - closeNow)) / a
    if na(closeAwayRaw)
        closeAwayRaw := 0.0
    float closeAwayScore = math.min(1.0, closeAwayRaw / 1.5)
    float prominenceScore = math.min(1.0, f_pivotProminenceAtr(isSupport, pivotPrice, atrAtPivot) / 1.0)
    float quality = 100.0 * (0.45 * reactionScore + 0.20 * wickScore + 0.20 * closeAwayScore + 0.15 * prominenceScore)
    f_clamp(quality, 0.0, 100.0)

// Find an existing zone index to merge a candidate event into.
// Returns -1 when no merge target is found.
f_findMergeIndex(float candCenter, float candHalfWidth, int candType, float atrNow) =>
    int foundIdx = -1
    int foundSameRole = -1
    int n = array.size(zoneCenter)
    float candLow = candCenter - candHalfWidth
    float candHigh = candCenter + candHalfWidth
    if n > 0
        for i = 0 to n - 1
            // When reactivation is disabled, an invalidated zone must not
            // absorb a fresh confirmed reaction; skip it so a new active zone
            // is created instead.
            bool skip = array.get(zoneInvalidated, i) and not allowReactivation
            if not skip
                float zc = array.get(zoneCenter, i)
                float zhw = array.get(zoneHalfWidth, i)
                float zLow = zc - zhw
                float zHigh = zc + zhw
                bool matches = false
                if mergeMode == "Overlap"
                    bool overlap = candLow <= zHigh and candHigh >= zLow
                    float gap = candCenter > zc ? (candLow - zHigh) : (zLow - candHigh)
                    if gap < 0
                        gap := 0.0
                    matches := overlap or (gap <= mergeAtrMult * atrNow)
                else
                    matches := math.abs(candCenter - zc) <= mergeAtrMult * atrNow
                if matches
                    // Determine dominant role of this zone.
                    int st = array.get(zoneSupportTouches, i)
                    int rt = array.get(zoneResistanceTouches, i)
                    bool sameRoleDominant = (candType == 1 and st >= rt) or (candType == -1 and rt >= st)
                    bool mixedOk = allowMixedZones or (candType == 1 and rt == 0) or (candType == -1 and st == 0)
                    if mixedOk
                        if foundIdx == -1
                            foundIdx := i
                        if sameRoleDominant and foundSameRole == -1
                            foundSameRole := i
    // Prefer same-role zone when requested and available.
    int result = foundIdx
    if preferSameRoleMerge and foundSameRole != -1
        result := foundSameRole
    result

// Create a new zone from a confirmed event.
// eventBar is the actual pivot bar (bar_index - pivotRight); the zone is anchored
// there so its drawn origin and age reflect where the reaction really happened.
f_createZone(float center, float halfWidth, int typ, float strength, int eventBar, float eq) =>
    array.push(zoneCenter, center)
    array.push(zoneHalfWidth, halfWidth)
    array.push(zoneFirstBar, eventBar)
    array.push(zoneLastTouchBar, eventBar)
    array.push(zoneTouchCount, 1)
    array.push(zoneSupportTouches, typ == 1 ? 1 : 0)
    array.push(zoneResistanceTouches, typ == -1 ? 1 : 0)
    array.push(zoneAvgReactionAtr, strength)
    array.push(zoneMaxReactionAtr, strength)
    array.push(zoneInvalidated, false)
    array.push(zoneInvalidatedBar, na)
    array.push(zoneBreakCount, 0)
    array.push(zoneLastReactionType, typ)
    array.push(zoneAvgEventQuality, eq)
    array.push(zoneMaxEventQuality, eq)
    // Start the touch-alert cooldown at the creation bar so a freshly created
    // zone cannot raise a touch alert on its own creation bar.
    array.push(zoneLastTouchAlertBar, bar_index)
    array.push(zoneBoxId, na)
    array.push(zoneCenterLineId, na)
    array.push(zoneUpperLineId, na)
    array.push(zoneLowerLineId, na)
    array.push(zoneLabelId, na)

// Update an existing zone on merge with a new confirmed event.
// Returns true when the merge reactivated a previously invalidated zone so the
// caller (global scope) can raise the reactivation alert flag.
// countTouch=false updates geometry/stats/quality but does NOT increment
// touch/support/resistance counts (same-swing / event-separation handling).
f_updateZone(int i, float pivotPrice, float halfWidth, int typ, float strength, float atrNow, int eventBar, float eq, bool countTouch) =>
    bool reactivated = false
    int n = array.size(zoneCenter)
    if i >= 0 and i < n
        int oldTouch = array.get(zoneTouchCount, i)
        float oldCenter = array.get(zoneCenter, i)
        float newCenter = (oldCenter * oldTouch + pivotPrice) / (oldTouch + 1)
        array.set(zoneCenter, i, newCenter)
        // Half width: max of old/new, clamped by ATR-based max.
        float oldHw = array.get(zoneHalfWidth, i)
        float newHw = math.max(oldHw, halfWidth)
        float hiCap = (not na(atrNow) and atrNow > 0 ? atrNow : syminfo.mintick) * maxZoneWidthAtr
        float loCap = syminfo.mintick * minZoneTicks
        if hiCap < loCap
            hiCap := loCap
        newHw := f_clamp(newHw, loCap, hiCap)
        array.set(zoneHalfWidth, i, newHw)
        if countTouch
            array.set(zoneTouchCount, i, oldTouch + 1)
            if typ == 1
                array.set(zoneSupportTouches, i, array.get(zoneSupportTouches, i) + 1)
            else
                array.set(zoneResistanceTouches, i, array.get(zoneResistanceTouches, i) + 1)
        array.set(zoneLastTouchBar, i, eventBar)
        // A merge/reactivation restarts the touch-alert cooldown for this zone.
        array.set(zoneLastTouchAlertBar, i, bar_index)
        // Update reaction strength stats.
        float oldAvg = array.get(zoneAvgReactionAtr, i)
        float newAvg = (oldAvg * oldTouch + strength) / (oldTouch + 1)
        array.set(zoneAvgReactionAtr, i, newAvg)
        array.set(zoneMaxReactionAtr, i, math.max(array.get(zoneMaxReactionAtr, i), strength))
        // Update event-quality stats (running avg like reaction; max via math.max).
        float oldQ = array.get(zoneAvgEventQuality, i)
        float newQ = (oldQ * oldTouch + eq) / (oldTouch + 1)
        array.set(zoneAvgEventQuality, i, newQ)
        array.set(zoneMaxEventQuality, i, math.max(array.get(zoneMaxEventQuality, i), eq))
        array.set(zoneLastReactionType, i, typ)
        // Reactivation if previously invalidated.
        if array.get(zoneInvalidated, i) and allowReactivation
            array.set(zoneInvalidated, i, false)
            array.set(zoneInvalidatedBar, i, na)
            array.set(zoneBreakCount, i, 0)
            reactivated := true
    reactivated

// Compute a 0..100 score for the zone at index i on the current bar.
f_zoneScore(int i, float atrNow) =>
    float sc = 0.0
    int n = array.size(zoneCenter)
    if i >= 0 and i < n
        int touchCount = array.get(zoneTouchCount, i)
        int lastTouch = array.get(zoneLastTouchBar, i)
        int barsSince = bar_index - lastTouch
        if barsSince < 0
            barsSince := 0
        float avgReact = array.get(zoneAvgReactionAtr, i)
        float hw = array.get(zoneHalfWidth, i)
        float touchScore = math.min(1.0, touchCount / 5.0)
        float freshnessScore = math.exp(-barsSince / math.max(1.0, float(freshnessHalfLifeBars)))
        float rejectionScore = math.min(1.0, (na(avgReact) ? 0.0 : avgReact) / 1.5)
        float capHw = (not na(atrNow) and atrNow > 0 ? atrNow : syminfo.mintick) * maxZoneWidthAtr
        float widthPenalty = capHw > 0 ? math.min(1.0, hw / capHw) : 0.0
        float raw = touchWeight * touchScore + freshnessWeight * freshnessScore + rejectionWeight * rejectionScore - widthPenaltyWeight * widthPenalty
        // Additive visual-only event-quality contribution.
        float avgEq = array.get(zoneAvgEventQuality, i)
        raw := raw + qualityWeight * math.min(1.0, (na(avgEq) ? 0.0 : avgEq) / 100.0)
        if array.get(zoneInvalidated, i)
            raw := raw * invalidatedScoreMult
        sc := f_clamp(raw, 0.0, 100.0)
    sc

// Determine the role code of a zone.
// 1 = Support-like, -1 = Resistance-like, 0 = Mixed, 2 = Inactive
f_zoneRole(int i) =>
    int role = 0
    int n = array.size(zoneCenter)
    if i >= 0 and i < n
        int lastTouch = array.get(zoneLastTouchBar, i)
        bool tooOld = (bar_index - lastTouch) > reactionLookbackBars
        if array.get(zoneInvalidated, i) or tooOld
            // Invalidated OR aged beyond the recent lookback -> Inactive.
            role := 2
        else
            int st = array.get(zoneSupportTouches, i)
            int rt = array.get(zoneResistanceTouches, i)
            int lastType = array.get(zoneLastReactionType, i)
            if st > rt and lastType == 1
                role := 1
            else if rt > st and lastType == -1
                role := -1
            else if st > rt
                role := 1
            else if rt > st
                role := -1
            else
                role := 0
    role

// Neutral role text (letter or full form).
f_roleText(int role, bool compact) =>
    string t = ""
    if role == 1
        t := compact ? "S" : "Support-like"
    else if role == -1
        t := compact ? "R" : "Resistance-like"
    else if role == 0
        t := compact ? "M" : "Mixed"
    else
        t := compact ? "Old" : "Inactive"
    t

// Color for a zone role (invalidated / inactive overrides to muted gray).
f_roleColor(int role, bool invalidated) =>
    color c = mixedColor
    if invalidated or role == 2
        c := invalidatedColor
    else if role == 1
        c := supportColor
    else if role == -1
        c := resistanceColor
    else
        c := mixedColor
    c

// Delete all drawing objects associated with a zone index.
f_deleteZoneObjects(int i) =>
    int n = array.size(zoneBoxId)
    if i >= 0 and i < n
        box bx = array.get(zoneBoxId, i)
        if not na(bx)
            box.delete(bx)
            array.set(zoneBoxId, i, na)
        line cl = array.get(zoneCenterLineId, i)
        if not na(cl)
            line.delete(cl)
            array.set(zoneCenterLineId, i, na)
        line ul = array.get(zoneUpperLineId, i)
        if not na(ul)
            line.delete(ul)
            array.set(zoneUpperLineId, i, na)
        line ll = array.get(zoneLowerLineId, i)
        if not na(ll)
            line.delete(ll)
            array.set(zoneLowerLineId, i, na)
        label lb = array.get(zoneLabelId, i)
        if not na(lb)
            label.delete(lb)
            array.set(zoneLabelId, i, na)

// Remove a zone entirely at index i (drawings first, then all parallel arrays).
f_removeZoneAt(int i) =>
    int n = array.size(zoneCenter)
    if i >= 0 and i < n
        f_deleteZoneObjects(i)
        array.remove(zoneCenter, i)
        array.remove(zoneHalfWidth, i)
        array.remove(zoneFirstBar, i)
        array.remove(zoneLastTouchBar, i)
        array.remove(zoneTouchCount, i)
        array.remove(zoneSupportTouches, i)
        array.remove(zoneResistanceTouches, i)
        array.remove(zoneAvgReactionAtr, i)
        array.remove(zoneMaxReactionAtr, i)
        array.remove(zoneInvalidated, i)
        array.remove(zoneInvalidatedBar, i)
        array.remove(zoneBreakCount, i)
        array.remove(zoneLastReactionType, i)
        array.remove(zoneAvgEventQuality, i)
        array.remove(zoneMaxEventQuality, i)
        array.remove(zoneLastTouchAlertBar, i)
        array.remove(zoneBoxId, i)
        array.remove(zoneCenterLineId, i)
        array.remove(zoneUpperLineId, i)
        array.remove(zoneLowerLineId, i)
        array.remove(zoneLabelId, i)

// Prune stored zones down to the cap by removing the weakest (lowest score,
// oldest as tiebreaker).
f_pruneZones(float atrNow) =>
    while array.size(zoneCenter) > maxStoredZones
        int n = array.size(zoneCenter)
        int worstIdx = 0
        float worstScore = f_zoneScore(0, atrNow)
        int worstLastTouch = array.get(zoneLastTouchBar, 0)
        for i = 1 to n - 1
            float s = f_zoneScore(i, atrNow)
            int lt = array.get(zoneLastTouchBar, i)
            if s < worstScore or (s == worstScore and lt < worstLastTouch)
                worstScore := s
                worstIdx := i
                worstLastTouch := lt
        f_removeZoneAt(worstIdx)

// Remove ACTIVE zones whose last reaction is older than the recent lookback
// window. Invalidated zones are intentionally skipped here so their lifetime is
// governed solely by the invalidation age-out logic (keepInvalidatedZones /
// invalidatedZoneAgeBars); otherwise this stale-prune would silently override
// the user's keep-invalidated settings.
f_pruneStaleZones() =>
    if array.size(zoneCenter) > 0
        for i = array.size(zoneCenter) - 1 to 0
            if i >= 0 and i < array.size(zoneCenter)
                if not array.get(zoneInvalidated, i)
                    int lt = array.get(zoneLastTouchBar, i)
                    if (bar_index - lt) > reactionLookbackBars
                        f_removeZoneAt(i)

// Is a zone within nearbyAtrRange*atr of the current close.
f_isNearby(int i, float atrNow) =>
    bool near = true
    int n = array.size(zoneCenter)
    if i >= 0 and i < n and not na(atrNow) and atrNow > 0
        float zc = array.get(zoneCenter, i)
        near := math.abs(close - zc) <= nearbyAtrRange * atrNow
    near

// Evaluate invalidation of a zone on a confirmed close. Returns true if the
// zone transitions to invalidated on this bar. This function solely owns the
// zoneBreakCount consecutive-break counter (for Two Closes Beyond and for the
// conservative two-close Mixed/Inactive rule); the caller must not touch it.
f_isInvalidated(int i, float atrNow) =>
    bool becameInvalid = false
    int n = array.size(zoneCenter)
    if i >= 0 and i < n and not array.get(zoneInvalidated, i)
        float zc = array.get(zoneCenter, i)
        float zhw = array.get(zoneHalfWidth, i)
        float zLow = zc - zhw
        float zHigh = zc + zhw
        int role = f_zoneRole(i)
        float atrBand = (na(atrNow) ? 0.0 : atrNow) * invalidationAtrMult
        bool directional = role == 1 or role == -1
        // Effective band, per role/mode:
        //  - directional in "Close Beyond": a single close strictly past (band 0);
        //  - directional in other modes: the full ATR band;
        //  - Mixed (role 0) / Inactive (role 2): ALWAYS the ATR band (never 0).
        // Mixed zones straddle price with two-sided reactions, so a marginal
        // close just past one edge is normal, not a structural break. Giving
        // them a non-zero band (and requiring two closes below) makes their
        // invalidation deliberately more conservative than directional zones.
        float band = directional and invalidationMode == "Close Beyond" ? 0.0 : atrBand
        bool beyond = false
        if role == 1
            beyond := close < zLow - band
        else if role == -1
            beyond := close > zHigh + band
        else
            // Mixed / inactive: clearly away on either side by the ATR band.
            beyond := close < zLow - band or close > zHigh + band
        // Maintain the consecutive-break counter once, for every mode/role.
        if beyond
            array.set(zoneBreakCount, i, array.get(zoneBreakCount, i) + 1)
        else
            array.set(zoneBreakCount, i, 0)
        if not directional
            // Mixed / inactive: require two consecutive confirmed closes beyond
            // the ATR band regardless of the selected mode.
            becameInvalid := array.get(zoneBreakCount, i) >= 2
        else if invalidationMode == "Two Closes Beyond"
            becameInvalid := array.get(zoneBreakCount, i) >= 2
        else
            // Directional "Close Beyond" / "ATR Beyond": a single confirmed
            // close beyond the effective band.
            becameInvalid := beyond
    becameInvalid

// ---------------------------------------------------------------------------
// LIFECYCLE TRAIL FUNCTIONS (Research-only; visual only; no alert flags).
// Push/remove operate on exactly the twelve trail* data arrays in declared
// order. Defined BEFORE the research functions because f_rRemoveZoneAt closes
// a removed zone's trail. Array mutation from a function is legal in Pine v6;
// only outer-scope SCALARS may not be reassigned here (nextResearchZoneId is
// therefore only ever incremented at global scope).
// ---------------------------------------------------------------------------
f_trailCreate(int zoneId, float center, float halfWidth, int startBar, int startTime, int roleType, float score, float quality) =>
    array.push(trailZoneId, zoneId)
    array.push(trailCenter, center)
    array.push(trailHalfWidth, halfWidth)
    array.push(trailStartBar, startBar)
    array.push(trailEndBar, bar_index)
    array.push(trailStartTime, startTime)
    array.push(trailEndTime, time)
    array.push(trailRoleType, roleType)
    array.push(trailScore, score)
    array.push(trailQuality, quality)
    array.push(trailActive, true)
    array.push(trailInvalidated, false)

f_trailRemoveAt(int i) =>
    int n = array.size(trailZoneId)
    if i >= 0 and i < n
        array.remove(trailZoneId, i)
        array.remove(trailCenter, i)
        array.remove(trailHalfWidth, i)
        array.remove(trailStartBar, i)
        array.remove(trailEndBar, i)
        array.remove(trailStartTime, i)
        array.remove(trailEndTime, i)
        array.remove(trailRoleType, i)
        array.remove(trailScore, i)
        array.remove(trailQuality, i)
        array.remove(trailActive, i)
        array.remove(trailInvalidated, i)

// Index of the ACTIVE trail carrying this zone id (-1 = none). Linear scan;
// bounds-safe and empty-safe.
f_trailOpenIndexByZoneId(int id) =>
    int found = -1
    int n = array.size(trailZoneId)
    if n > 0
        for i = 0 to n - 1
            if found == -1 and array.get(trailActive, i) and array.get(trailZoneId, i) == id
                found := i
    found

// Close every ACTIVE trail carrying this zone id (optionally marking it as
// ended by invalidation). Already-closed trails are left untouched.
f_trailCloseByZoneId(int id, bool markInvalidated) =>
    int n = array.size(trailZoneId)
    if n > 0
        for i = 0 to n - 1
            if array.get(trailActive, i) and array.get(trailZoneId, i) == id
                array.set(trailActive, i, false)
                if markInvalidated
                    array.set(trailInvalidated, i, true)

// Delete + clear the trail display pool (na-guarded; no leak).
f_clearTrailObjects() =>
    if array.size(trailDispLine) > 0
        for i = 0 to array.size(trailDispLine) - 1
            line ln = array.get(trailDispLine, i)
            if not na(ln)
                line.delete(ln)
    if array.size(trailDispLabel) > 0
        for i = 0 to array.size(trailDispLabel) - 1
            label lb = array.get(trailDispLabel, i)
            if not na(lb)
                label.delete(lb)
    array.clear(trailDispLine)
    array.clear(trailDispLabel)

// ---------------------------------------------------------------------------
// RESEARCH FUNCTIONS (visual-only; operate on r* arrays; mirror Live logic).
// f_rZoneScore / f_rZoneRole take an explicit refBarIndex so the same code can
// be used both while building (current processing bar) and at render time
// (the visible right edge bar), instead of reading bar_index.
// ---------------------------------------------------------------------------

// Find an existing research zone to merge a candidate event into (-1 = none).
f_rFindMergeIndex(float candCenter, float candHalfWidth, int candType, float atrNow) =>
    int foundIdx = -1
    int foundSameRole = -1
    int n = array.size(rZoneCenter)
    float candLow = candCenter - candHalfWidth
    float candHigh = candCenter + candHalfWidth
    if n > 0
        for i = 0 to n - 1
            bool skip = array.get(rZoneInvalidated, i) and not allowReactivation
            if not skip
                float zc = array.get(rZoneCenter, i)
                float zhw = array.get(rZoneHalfWidth, i)
                float zLow = zc - zhw
                float zHigh = zc + zhw
                bool matches = false
                if mergeMode == "Overlap"
                    bool overlap = candLow <= zHigh and candHigh >= zLow
                    float gap = candCenter > zc ? (candLow - zHigh) : (zLow - candHigh)
                    if gap < 0
                        gap := 0.0
                    matches := overlap or (gap <= mergeAtrMult * atrNow)
                else
                    matches := math.abs(candCenter - zc) <= mergeAtrMult * atrNow
                if matches
                    int st = array.get(rZoneSupportTouches, i)
                    int rt = array.get(rZoneResistanceTouches, i)
                    bool sameRoleDominant = (candType == 1 and st >= rt) or (candType == -1 and rt >= st)
                    bool mixedOk = allowMixedZones or (candType == 1 and rt == 0) or (candType == -1 and st == 0)
                    if mixedOk
                        if foundIdx == -1
                            foundIdx := i
                        if sameRoleDominant and foundSameRole == -1
                            foundSameRole := i
    int result = foundIdx
    if preferSameRoleMerge and foundSameRole != -1
        result := foundSameRole
    result

// Create a new research zone (stores both bar index and time). zoneId is the
// caller-provided stable id (allocated from nextResearchZoneId at GLOBAL scope;
// this function never touches that counter).
f_rCreateZone(float center, float halfWidth, int typ, float strength, int eventBar, int eventTime, float eq, int zoneId) =>
    array.push(rZoneCenter, center)
    array.push(rZoneHalfWidth, halfWidth)
    array.push(rZoneFirstBar, eventBar)
    array.push(rZoneLastTouchBar, eventBar)
    array.push(rZoneFirstTime, eventTime)
    array.push(rZoneLastTouchTime, eventTime)
    array.push(rZoneTouchCount, 1)
    array.push(rZoneSupportTouches, typ == 1 ? 1 : 0)
    array.push(rZoneResistanceTouches, typ == -1 ? 1 : 0)
    array.push(rZoneAvgReactionAtr, strength)
    array.push(rZoneMaxReactionAtr, strength)
    array.push(rZoneInvalidated, false)
    array.push(rZoneInvalidatedBar, na)
    array.push(rZoneInvalidatedTime, na)
    array.push(rZoneBreakCount, 0)
    array.push(rZoneLastReactionType, typ)
    array.push(rZoneAvgEventQuality, eq)
    array.push(rZoneMaxEventQuality, eq)
    array.push(rZoneId, zoneId)

// Update an existing research zone on merge.
f_rUpdateZone(int i, float pivotPrice, float halfWidth, int typ, float strength, float atrNow, int eventBar, int eventTime, float eq, bool countTouch) =>
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n
        int oldTouch = array.get(rZoneTouchCount, i)
        float oldCenter = array.get(rZoneCenter, i)
        float newCenter = (oldCenter * oldTouch + pivotPrice) / (oldTouch + 1)
        array.set(rZoneCenter, i, newCenter)
        float oldHw = array.get(rZoneHalfWidth, i)
        float newHw = math.max(oldHw, halfWidth)
        float hiCap = (not na(atrNow) and atrNow > 0 ? atrNow : syminfo.mintick) * maxZoneWidthAtr
        float loCap = syminfo.mintick * minZoneTicks
        if hiCap < loCap
            hiCap := loCap
        newHw := f_clamp(newHw, loCap, hiCap)
        array.set(rZoneHalfWidth, i, newHw)
        if countTouch
            array.set(rZoneTouchCount, i, oldTouch + 1)
            if typ == 1
                array.set(rZoneSupportTouches, i, array.get(rZoneSupportTouches, i) + 1)
            else
                array.set(rZoneResistanceTouches, i, array.get(rZoneResistanceTouches, i) + 1)
        array.set(rZoneLastTouchBar, i, eventBar)
        array.set(rZoneLastTouchTime, i, eventTime)
        float oldAvg = array.get(rZoneAvgReactionAtr, i)
        float newAvg = (oldAvg * oldTouch + strength) / (oldTouch + 1)
        array.set(rZoneAvgReactionAtr, i, newAvg)
        array.set(rZoneMaxReactionAtr, i, math.max(array.get(rZoneMaxReactionAtr, i), strength))
        float oldQ = array.get(rZoneAvgEventQuality, i)
        float newQ = (oldQ * oldTouch + eq) / (oldTouch + 1)
        array.set(rZoneAvgEventQuality, i, newQ)
        array.set(rZoneMaxEventQuality, i, math.max(array.get(rZoneMaxEventQuality, i), eq))
        array.set(rZoneLastReactionType, i, typ)
        if array.get(rZoneInvalidated, i) and allowReactivation
            array.set(rZoneInvalidated, i, false)
            array.set(rZoneInvalidatedBar, i, na)
            array.set(rZoneInvalidatedTime, i, na)
            array.set(rZoneBreakCount, i, 0)

// Research score 0..100 (uses refBarIndex instead of bar_index).
f_rZoneScore(int i, float atrNow, int refBarIndex) =>
    float sc = 0.0
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n
        int touchCount = array.get(rZoneTouchCount, i)
        int lastTouch = array.get(rZoneLastTouchBar, i)
        int barsSince = refBarIndex - lastTouch
        if barsSince < 0
            barsSince := 0
        float avgReact = array.get(rZoneAvgReactionAtr, i)
        float hw = array.get(rZoneHalfWidth, i)
        float touchScore = math.min(1.0, touchCount / 5.0)
        float freshnessScore = math.exp(-barsSince / math.max(1.0, float(freshnessHalfLifeBars)))
        float rejectionScore = math.min(1.0, (na(avgReact) ? 0.0 : avgReact) / 1.5)
        float capHw = (not na(atrNow) and atrNow > 0 ? atrNow : syminfo.mintick) * maxZoneWidthAtr
        float widthPenalty = capHw > 0 ? math.min(1.0, hw / capHw) : 0.0
        float raw = touchWeight * touchScore + freshnessWeight * freshnessScore + rejectionWeight * rejectionScore - widthPenaltyWeight * widthPenalty
        // Additive visual-only event-quality contribution.
        float avgEq = array.get(rZoneAvgEventQuality, i)
        raw := raw + qualityWeight * math.min(1.0, (na(avgEq) ? 0.0 : avgEq) / 100.0)
        if array.get(rZoneInvalidated, i)
            raw := raw * invalidatedScoreMult
        sc := f_clamp(raw, 0.0, 100.0)
    sc

// Research role code (uses refBarIndex instead of bar_index).
f_rZoneRole(int i, int refBarIndex) =>
    int role = 0
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n
        int lastTouch = array.get(rZoneLastTouchBar, i)
        bool tooOld = (refBarIndex - lastTouch) > researchLookbackBars
        if array.get(rZoneInvalidated, i) or tooOld
            role := 2
        else
            int st = array.get(rZoneSupportTouches, i)
            int rt = array.get(rZoneResistanceTouches, i)
            int lastType = array.get(rZoneLastReactionType, i)
            if st > rt and lastType == 1
                role := 1
            else if rt > st and lastType == -1
                role := -1
            else if st > rt
                role := 1
            else if rt > st
                role := -1
            else
                role := 0
    role

// Remove a research zone entirely (all r arrays in lock-step; no drawings here).
f_rRemoveZoneAt(int i) =>
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n
        // Any zone removal first closes its lifecycle trail (visual only), so a
        // pruned or aged-out zone never leaves a dangling ACTIVE trail behind.
        f_trailCloseByZoneId(array.get(rZoneId, i), false)
        array.remove(rZoneCenter, i)
        array.remove(rZoneHalfWidth, i)
        array.remove(rZoneFirstBar, i)
        array.remove(rZoneLastTouchBar, i)
        array.remove(rZoneFirstTime, i)
        array.remove(rZoneLastTouchTime, i)
        array.remove(rZoneTouchCount, i)
        array.remove(rZoneSupportTouches, i)
        array.remove(rZoneResistanceTouches, i)
        array.remove(rZoneAvgReactionAtr, i)
        array.remove(rZoneMaxReactionAtr, i)
        array.remove(rZoneInvalidated, i)
        array.remove(rZoneInvalidatedBar, i)
        array.remove(rZoneInvalidatedTime, i)
        array.remove(rZoneBreakCount, i)
        array.remove(rZoneLastReactionType, i)
        array.remove(rZoneAvgEventQuality, i)
        array.remove(rZoneMaxEventQuality, i)
        array.remove(rZoneId, i)

// Archive-friendly prune score (freshness-independent; internal only, never
// shown on chart/dashboard). Favors well-touched, strong, high-quality zones so
// deep historical zones survive even when their freshness score has decayed.
f_rArchivePruneScore(int i) =>
    float s = 0.0
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n
        float tc = array.get(rZoneTouchCount, i)
        float avgReact = array.get(rZoneAvgReactionAtr, i)
        float avgEq = array.get(rZoneAvgEventQuality, i)
        s := 45.0 * math.min(1.0, tc / 5.0) + 35.0 * math.min(1.0, (na(avgReact) ? 0.0 : avgReact) / 1.5) + 20.0 * math.min(1.0, (na(avgEq) ? 0.0 : avgEq) / 100.0)
        if array.get(rZoneInvalidated, i)
            s := s * 0.5
    s

// Prune research zones down to the research stored cap. In "Archive Friendly"
// mode the weakest archivePruneScore is removed first (freshness-independent);
// in "Score Freshness" mode the current f_rZoneScore-based removal is kept.
f_rPruneZones(float atrNow, int refBarIndex) =>
    while array.size(rZoneCenter) > researchMaxStoredZones
        int n = array.size(rZoneCenter)
        int worstIdx = 0
        bool archiveFriendly = researchArchivePruneMode == "Archive Friendly"
        float worstScore = archiveFriendly ? f_rArchivePruneScore(0) : f_rZoneScore(0, atrNow, refBarIndex)
        int worstLastTouch = array.get(rZoneLastTouchBar, 0)
        for i = 1 to n - 1
            float s = archiveFriendly ? f_rArchivePruneScore(i) : f_rZoneScore(i, atrNow, refBarIndex)
            int lt = array.get(rZoneLastTouchBar, i)
            if s < worstScore or (s == worstScore and lt < worstLastTouch)
                worstScore := s
                worstIdx := i
                worstLastTouch := lt
        f_rRemoveZoneAt(worstIdx)

// Remove stale ACTIVE research zones (invalidated ones skipped, as in Live).
// When preserveHistoricalResearchZones is true, old active research zones are
// NOT removed here (f_rZoneRole marks them Inactive via researchLookbackBars);
// the only cap enforcement is f_rPruneZones(researchMaxStoredZones).
f_rPruneStaleZones(int refBarIndex) =>
    if not preserveHistoricalResearchZones and array.size(rZoneCenter) > 0
        for i = array.size(rZoneCenter) - 1 to 0
            if i >= 0 and i < array.size(rZoneCenter)
                if not array.get(rZoneInvalidated, i)
                    int lt = array.get(rZoneLastTouchBar, i)
                    if (refBarIndex - lt) > researchLookbackBars
                        f_rRemoveZoneAt(i)

// Research invalidation on a confirmed close (mirrors Live; refBarIndex for role).
f_rIsInvalidated(int i, float atrNow, int refBarIndex) =>
    bool becameInvalid = false
    int n = array.size(rZoneCenter)
    if i >= 0 and i < n and not array.get(rZoneInvalidated, i)
        float zc = array.get(rZoneCenter, i)
        float zhw = array.get(rZoneHalfWidth, i)
        float zLow = zc - zhw
        float zHigh = zc + zhw
        int role = f_rZoneRole(i, refBarIndex)
        float atrBand = (na(atrNow) ? 0.0 : atrNow) * invalidationAtrMult
        bool directional = role == 1 or role == -1
        float band = directional and invalidationMode == "Close Beyond" ? 0.0 : atrBand
        bool beyond = false
        if role == 1
            beyond := close < zLow - band
        else if role == -1
            beyond := close > zHigh + band
        else
            beyond := close < zLow - band or close > zHigh + band
        if beyond
            array.set(rZoneBreakCount, i, array.get(rZoneBreakCount, i) + 1)
        else
            array.set(rZoneBreakCount, i, 0)
        if not directional
            becameInvalid := array.get(rZoneBreakCount, i) >= 2
        else if invalidationMode == "Two Closes Beyond"
            becameInvalid := array.get(rZoneBreakCount, i) >= 2
        else
            becameInvalid := beyond
    becameInvalid

// ---------------------------------------------------------------------------
// IN-WINDOW DETAIL SEGMENT FUNCTIONS (Research-only; visual only).
// Push/remove operate on exactly the eight seg* data arrays in declared order.
// f_clearSegmentObjects deletes + clears the separate segment display pool.
// ---------------------------------------------------------------------------
f_segCreate(float center, float halfWidth, int startBar, int startTime, int endTime, int roleType, float score, float quality) =>
    array.push(segCenter, center)
    array.push(segHalfWidth, halfWidth)
    array.push(segStartBar, startBar)
    array.push(segStartTime, startTime)
    array.push(segEndTime, endTime)
    array.push(segRoleType, roleType)
    array.push(segScore, score)
    array.push(segQuality, quality)

f_segRemoveAt(int i) =>
    int n = array.size(segCenter)
    if i >= 0 and i < n
        array.remove(segCenter, i)
        array.remove(segHalfWidth, i)
        array.remove(segStartBar, i)
        array.remove(segStartTime, i)
        array.remove(segEndTime, i)
        array.remove(segRoleType, i)
        array.remove(segScore, i)
        array.remove(segQuality, i)

f_clearSegmentObjects() =>
    if array.size(segDispLine) > 0
        for i = 0 to array.size(segDispLine) - 1
            line ln = array.get(segDispLine, i)
            if not na(ln)
                line.delete(ln)
    if array.size(segDispBox) > 0
        for i = 0 to array.size(segDispBox) - 1
            box bx = array.get(segDispBox, i)
            if not na(bx)
                box.delete(bx)
    if array.size(segDispLabel) > 0
        for i = 0 to array.size(segDispLabel) - 1
            label lb = array.get(segDispLabel, i)
            if not na(lb)
                label.delete(lb)
    array.clear(segDispLine)
    array.clear(segDispBox)
    array.clear(segDispLabel)

// ---------------------------------------------------------------------------
// LOCAL WINDOW LEVEL FUNCTIONS (Research-only; visual only; no alert flags).
// The Local Window Levels engine is built DIRECTLY from confirmed pivot
// reaction events and is fully INDEPENDENT of the rZone research model: it
// never reads rZoneId/rZoneCenter/any rZone state and never depends on
// f_rFindMergeIndex results. Push/remove operate on exactly the fifteen
// lLevel* data arrays in declared order. Array mutation from a function is
// legal in Pine v6; no outer-scope scalar is reassigned here.
// ---------------------------------------------------------------------------
f_lLevelCreate(float center, float halfWidth, int startBar, int startTime, int roleType, float score, float quality, bool confirmed) =>
    array.push(lLevelCenter, center)
    array.push(lLevelHalfWidth, halfWidth)
    array.push(lLevelStartBar, startBar)
    array.push(lLevelEndBar, bar_index)
    array.push(lLevelStartTime, startTime)
    array.push(lLevelEndTime, time)
    array.push(lLevelRoleType, roleType)
    array.push(lLevelReactionCount, 1)
    array.push(lLevelScore, score)
    array.push(lLevelQuality, quality)
    array.push(lLevelActive, true)
    array.push(lLevelInvalidated, false)
    array.push(lLevelLastEventBar, startBar)
    array.push(lLevelLastEventTime, startTime)
    array.push(lLevelConfirmed, confirmed)

f_lLevelRemoveAt(int i) =>
    int n = array.size(lLevelCenter)
    if i >= 0 and i < n
        array.remove(lLevelCenter, i)
        array.remove(lLevelHalfWidth, i)
        array.remove(lLevelStartBar, i)
        array.remove(lLevelEndBar, i)
        array.remove(lLevelStartTime, i)
        array.remove(lLevelEndTime, i)
        array.remove(lLevelRoleType, i)
        array.remove(lLevelReactionCount, i)
        array.remove(lLevelScore, i)
        array.remove(lLevelQuality, i)
        array.remove(lLevelActive, i)
        array.remove(lLevelInvalidated, i)
        array.remove(lLevelLastEventBar, i)
        array.remove(lLevelLastEventTime, i)
        array.remove(lLevelConfirmed, i)

// Delete + clear the local-level display pool (na-guarded; no leak).
f_clearLocalLevelObjects() =>
    if array.size(lLevelDispLine) > 0
        for i = 0 to array.size(lLevelDispLine) - 1
            line ln = array.get(lLevelDispLine, i)
            if not na(ln)
                line.delete(ln)
    if array.size(lLevelDispLabel) > 0
        for i = 0 to array.size(lLevelDispLabel) - 1
            label lb = array.get(lLevelDispLabel, i)
            if not na(lb)
                label.delete(lb)
    array.clear(lLevelDispLine)
    array.clear(lLevelDispLabel)

// Local event score 0..100 (visual ranking only): ATR-normalized reaction
// strength + event quality + a small repeat-reaction bonus.
f_localEventScore(float strengthAtr, float eq, int count) =>
    f_clamp(40.0 * math.min(1.0, (na(strengthAtr) ? 0.0 : strengthAtr) / 1.5) + 40.0 * (na(eq) ? 0.0 : eq) / 100.0 + 20.0 * math.min(1.0, count / 3.0), 0.0, 100.0)

// Micro-cluster match: index of an ACTIVE same-role local level close enough
// in price (ATR distance) and recent enough in bars (-1 = none). na/size
// guarded; linear scan.
f_lLevelFindMicroCluster(float center, int typ, float atrNow, int eventBar) =>
    int found = -1
    int n = array.size(lLevelCenter)
    if n > 0 and not na(center) and not na(atrNow) and atrNow > 0
        for i = 0 to n - 1
            if found == -1 and array.get(lLevelActive, i) and array.get(lLevelRoleType, i) == typ
                float lc = array.get(lLevelCenter, i)
                int leb = array.get(lLevelLastEventBar, i)
                if not na(lc) and not na(leb) and math.abs(center - lc) <= localMergeAtrMult * atrNow and (eventBar - leb) <= localMergeBars
                    found := i
    found

// Re-evaluate the CONFIRMED flag from the (updated) reaction count and best
// quality of a level under the effective cluster-confirm mode. Never demotes a
// level that is already confirmed. This is a DETECTION STATE, computed in the
// build only.
f_lLevelConfirmEval(string effClusterConfirm, int reactionCount, float bestQuality, int minClusterReactions, int strongSingleQuality) =>
    bool conf = false
    if effClusterConfirm == "Any Accepted Event"
        conf := true
    else if effClusterConfirm == "Cluster Only"
        conf := reactionCount >= minClusterReactions
    else
        // "Cluster Or Strong Single"
        conf := reactionCount >= minClusterReactions or bestQuality >= strongSingleQuality
    conf

// Process one qualifying confirmed pivot reaction into the local-level model.
// "Micro Cluster" merges into a nearby recent ACTIVE same-role level — the
// level CENTER STAYS FIXED (the past band is never rewritten; the distance
// gate guarantees proximity). effEveryReaction=true ALWAYS creates its own
// level (acceptance-test / Exploratory: every qualifying pivot yields its own
// candidate, no clustering).
//
// SAME-SWING SUPPRESSION: when a near level's last event is fewer than
// minSepBars bars ago, sameSwingPolicy decides what happens — "Ignore Same
// Swing" drops the event entirely (no new line, no touch), "Merge Same Swing"
// force-merges into that near level without moving its center, "Allow All"
// falls through to the normal micro-cluster behavior.
//
// CONFIRMED MODEL: create pushes the confirmed flag; merge/update re-evaluates
// it (promotion only, never demotion) from the updated reaction count and max
// quality. No long-horizon rZone-style absorption; center is never rewritten.
f_lLevelProcessEvent(float center, float hw, int typ, float strengthAtr, float eq, int eventBar, int eventTime, float atrNow, bool effEveryReaction, int minSepBars, string sameSwingPolicy, string effClusterConfirm, int minClusterReactions, int strongSingleQuality) =>
    // Locate a near same-role ACTIVE level (micro-cluster distance/recency gate).
    int mi = effEveryReaction ? -1 : f_lLevelFindMicroCluster(center, typ, atrNow, eventBar)
    // Same-swing detection: the near level's last event is within minSepBars.
    bool wasSameSwing = false
    if mi >= 0 and mi < array.size(lLevelCenter)
        int leb = array.get(lLevelLastEventBar, mi)
        if not na(leb) and (eventBar - leb) < minSepBars
            wasSameSwing := true
    // "Ignore Same Swing": drop entirely (no create, no update, no touch).
    // Every other case either merges into the near level or creates a candidate.
    bool dropEvent = wasSameSwing and sameSwingPolicy == "Ignore Same Swing"
    if not dropEvent
        if mi >= 0 and mi < array.size(lLevelCenter)
            // MERGE / UPDATE into the near level. Under "Merge Same Swing" a
            // same-swing event is force-merged here too. Center stays FIXED.
            int newCount = array.get(lLevelReactionCount, mi) + 1
            array.set(lLevelReactionCount, mi, newCount)
            array.set(lLevelLastEventBar, mi, eventBar)
            array.set(lLevelLastEventTime, mi, eventTime)
            // End advances only to the CURRENT processing bar (no future leak).
            array.set(lLevelEndBar, mi, bar_index)
            array.set(lLevelEndTime, mi, time)
            array.set(lLevelScore, mi, math.max(array.get(lLevelScore, mi), f_localEventScore(strengthAtr, eq, newCount)))
            float bestQ = math.max(array.get(lLevelQuality, mi), eq)
            array.set(lLevelQuality, mi, bestQ)
            // Re-evaluate confirmation (promotion only; never demote).
            if not array.get(lLevelConfirmed, mi)
                array.set(lLevelConfirmed, mi, f_lLevelConfirmEval(effClusterConfirm, newCount, bestQ, minClusterReactions, strongSingleQuality))
        else
            // CREATE a new candidate (reactionCount starts at 1). Confirmed only
            // if the mode auto-confirms (Any) or this single event is strong.
            bool createConfirmed = effClusterConfirm == "Any Accepted Event" or (effClusterConfirm == "Cluster Or Strong Single" and eq >= strongSingleQuality)
            f_lLevelCreate(center, hw, eventBar, eventTime, typ, f_localEventScore(strengthAtr, eq, 1), eq, createConfirmed)

// ---------------------------------------------------------------------------
// WARM-UP GUARD
// ---------------------------------------------------------------------------
bool warmedUp = bar_index > (pivotLeft + pivotRight) and not na(atr) and atr > 0

// ---------------------------------------------------------------------------
// VISIBLE-RANGE RESEARCH: defensive reset + per-bar right-edge tracking
// ---------------------------------------------------------------------------
// A scroll/zoom recalc restarts from bar 0, so clear all research state on the
// first bar of the run. This keeps the research model exact for the new range.
if barstate.isfirst
    array.clear(rZoneCenter)
    array.clear(rZoneHalfWidth)
    array.clear(rZoneFirstBar)
    array.clear(rZoneLastTouchBar)
    array.clear(rZoneFirstTime)
    array.clear(rZoneLastTouchTime)
    array.clear(rZoneTouchCount)
    array.clear(rZoneSupportTouches)
    array.clear(rZoneResistanceTouches)
    array.clear(rZoneAvgReactionAtr)
    array.clear(rZoneMaxReactionAtr)
    array.clear(rZoneInvalidated)
    array.clear(rZoneInvalidatedBar)
    array.clear(rZoneInvalidatedTime)
    array.clear(rZoneBreakCount)
    array.clear(rZoneLastReactionType)
    array.clear(rZoneAvgEventQuality)
    array.clear(rZoneMaxEventQuality)
    array.clear(rZoneId)
    array.clear(segCenter)
    array.clear(segHalfWidth)
    array.clear(segStartBar)
    array.clear(segStartTime)
    array.clear(segEndTime)
    array.clear(segRoleType)
    array.clear(segScore)
    array.clear(segQuality)
    array.clear(trailZoneId)
    array.clear(trailCenter)
    array.clear(trailHalfWidth)
    array.clear(trailStartBar)
    array.clear(trailEndBar)
    array.clear(trailStartTime)
    array.clear(trailEndTime)
    array.clear(trailRoleType)
    array.clear(trailScore)
    array.clear(trailQuality)
    array.clear(trailActive)
    array.clear(trailInvalidated)
    array.clear(lLevelCenter)
    array.clear(lLevelHalfWidth)
    array.clear(lLevelStartBar)
    array.clear(lLevelEndBar)
    array.clear(lLevelStartTime)
    array.clear(lLevelEndTime)
    array.clear(lLevelRoleType)
    array.clear(lLevelReactionCount)
    array.clear(lLevelScore)
    array.clear(lLevelQuality)
    array.clear(lLevelActive)
    array.clear(lLevelInvalidated)
    array.clear(lLevelLastEventBar)
    array.clear(lLevelLastEventTime)
    array.clear(lLevelConfirmed)
    visibleLeftBarIndex := na
    nextResearchZoneId := 1
    visibleRightBarIndex := na
    visibleRightClose := na
    visibleRightAtr := na
    visibleRightTimeTracked := na
    researchLastReactionBar := na

// Track the right visible edge: the LAST bar whose time is <= the viewport's
// right edge time is the "as-of" bar for the research context. The built-in is
// constant across the run, so this converges to the correct edge bar.
int rightVisTime = chart.right_visible_bar_time
if not na(rightVisTime) and time <= rightVisTime
    visibleRightBarIndex := bar_index
    visibleRightClose := close
    visibleRightAtr := atr
    visibleRightTimeTracked := time

// Track the left visible edge bar index (used only by the local-window level
// preload filter). The LAST bar whose time is <= the left edge time converges
// to the leftmost visible bar of this run.
int leftVisTime = chart.left_visible_bar_time
if not na(leftVisTime) and time <= leftVisTime
    visibleLeftBarIndex := bar_index

// ---------------------------------------------------------------------------
// DATA MODEL UPDATE (every bar)
// ---------------------------------------------------------------------------
// Reset per-bar alert event flags.
evNewZone := false
evUpdatedZone := false
evTouchedZone := false
evInactiveZone := false
evReactivated := false

// Confirmed pivots. A non-na value means a pivot confirmed pivotRight bars ago.
float ph = ta.pivothigh(high, pivotLeft, pivotRight)
float pl = ta.pivotlow(low, pivotLeft, pivotRight)

float atrAtPivot = atr[pivotRight]
// The actual pivot bar this confirmed event refers to. Detection only runs when
// the pivot is confirmed (pivotRight bars later), so this uses confirmed past
// data only and does not repaint.
int eventBar = bar_index - pivotRight

if warmedUp
    // -- Resistance-like event (pivot high) --
    if not na(ph)
        float pivotPrice = high[pivotRight]
        if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
            float cNow = close
            float strength = f_reactionStrengthAtr(false, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
            bool strongEnough = not na(strength) and strength >= minReactionAtr
            bool wickOk = f_passWickFilter(false)
            // Additive event-quality gate (Classic => qualityOk always true).
            float eq = f_eventQuality(false, pivotPrice, atrAtPivot, strength, cNow)
            float closeAwayAtr = math.max(0.0, (pivotPrice - cNow) / atrAtPivot)
            bool qualityOk = detectionEngine != "Quality Weighted" or (eq >= minEventQualityScore and (not usePivotProminenceFilter or f_pivotProminenceAtr(false, pivotPrice, atrAtPivot) >= minPivotProminenceAtr) and (not useCloseAwayFilter or closeAwayAtr >= minCloseAwayAtr))
            if strongEnough and wickOk and qualityOk
                float hw = f_zoneHalfWidth(pivotPrice, atrAtPivot)
                int mi = f_findMergeIndex(pivotPrice, hw, -1, atr)
                if mi == -1
                    f_createZone(pivotPrice, hw, -1, strength, eventBar, eq)
                    evNewZone := true
                    lastReactionBar := eventBar
                else
                    // Same-swing / event-separation handling.
                    int barsSince = eventBar - array.get(zoneLastTouchBar, mi)
                    bool within = barsSince < minEventSeparationBars
                    if not (within and sameSwingHandling == "Ignore")
                        bool countTouch = not (within and sameSwingHandling == "Update Only")
                        bool r = f_updateZone(mi, pivotPrice, hw, -1, strength, atr, eventBar, eq, countTouch)
                        evUpdatedZone := true
                        if r
                            evReactivated := true
                        lastReactionBar := eventBar

    // -- Support-like event (pivot low) --
    if not na(pl)
        float pivotPrice = low[pivotRight]
        if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
            float cNow = close
            float strength = f_reactionStrengthAtr(true, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
            bool strongEnough = not na(strength) and strength >= minReactionAtr
            bool wickOk = f_passWickFilter(true)
            float eq = f_eventQuality(true, pivotPrice, atrAtPivot, strength, cNow)
            float closeAwayAtr = math.max(0.0, (cNow - pivotPrice) / atrAtPivot)
            bool qualityOk = detectionEngine != "Quality Weighted" or (eq >= minEventQualityScore and (not usePivotProminenceFilter or f_pivotProminenceAtr(true, pivotPrice, atrAtPivot) >= minPivotProminenceAtr) and (not useCloseAwayFilter or closeAwayAtr >= minCloseAwayAtr))
            if strongEnough and wickOk and qualityOk
                float hw = f_zoneHalfWidth(pivotPrice, atrAtPivot)
                int mi = f_findMergeIndex(pivotPrice, hw, 1, atr)
                if mi == -1
                    f_createZone(pivotPrice, hw, 1, strength, eventBar, eq)
                    evNewZone := true
                    lastReactionBar := eventBar
                else
                    int barsSince = eventBar - array.get(zoneLastTouchBar, mi)
                    bool within = barsSince < minEventSeparationBars
                    if not (within and sameSwingHandling == "Ignore")
                        bool countTouch = not (within and sameSwingHandling == "Update Only")
                        bool r = f_updateZone(mi, pivotPrice, hw, 1, strength, atr, eventBar, eq, countTouch)
                        evUpdatedZone := true
                        if r
                            evReactivated := true
                        lastReactionBar := eventBar

    // Drop zones whose last reaction is older than the recent lookback window,
    // then prune to the stored cap.
    f_pruneStaleZones()
    f_pruneZones(atr)

// ---------------------------------------------------------------------------
// RESEARCH DATA MODEL UPDATE (visual-only; gated to the visible right edge).
// Runs AFTER the Live update and NEVER sets any alert flag. Processes the same
// confirmed ph/pl events into the r* arrays, using the CURRENT processing bar
// index as the score/role reference so the reconstruction matches Live logic.
// ---------------------------------------------------------------------------
// Decide whether the research model needs rebuilding at all this run:
//  - "Visible Range Research": always;
//  - "Auto Hybrid": only when the latest bar is NOT already on screen (otherwise
//    Live is used and the research model is never rendered or read);
//  - "Live": never.
// This avoids the O(n) research rebuild while the user watches the latest bars.
bool latestBarVisible = not na(chart.right_visible_bar_time) and chart.right_visible_bar_time >= last_bar_time
// Build the research model (Local Window Levels) whenever the context is NOT
// explicitly Live. Auto Hybrid always builds so the local arrays are never empty
// when the render later selects Research; whether anything is actually DRAWN is
// still decided by useResearch at render time, so Live behavior is unchanged.
bool shouldBuildResearch = contextMode != "Live"
bool researchShouldUpdate = shouldBuildResearch and warmedUp and not na(chart.right_visible_bar_time) and time <= chart.right_visible_bar_time
// Local Detection Profile derived booleans (GLOBAL scope so both the build
// section below and the local-level render can read them). Visual only.
bool exploratory = localDetectionProfile == "Exploratory"
bool strictP     = localDetectionProfile == "Strict Quality"
bool veryStrictP = localDetectionProfile == "Very Strict Quality"
// Exploratory ALWAYS creates 1 pivot = 1 candidate (no clustering) and runs
// levels to the fixed localLevelMaxBars cap (no broken check).
bool effEveryReactionLocal = exploratory or localMergeMode == "Every Reaction"
bool effFixedBarsLocal = exploratory or localLevelEndMode == "Fixed Bars"
// Profile-derived EFFECTIVE thresholds. The profile escalates the user's
// Balanced-tuned floors; Exploratory relaxes them to nothing.
float effReactionAtr    = exploratory ? 0.0 : veryStrictP ? math.max(localMinReactionAtr, 0.40) : strictP ? math.max(localMinReactionAtr, 0.25) : localMinReactionAtr
float effEventQuality   = exploratory ? 0.0 : veryStrictP ? math.max(localMinEventQuality, 65.0) : strictP ? math.max(localMinEventQuality, 50.0) : localMinEventQuality
string effValidation    = exploratory ? "Reaction Only" : veryStrictP ? "Wick And Close-Away" : localValidationMode
bool  effUseProminence  = exploratory ? false : localUseProminenceFilter
float effProminenceAtr  = veryStrictP ? math.max(localMinProminenceAtr, 0.30) : strictP ? math.max(localMinProminenceAtr, 0.18) : localMinProminenceAtr
string effClusterConfirm = exploratory ? "Any Accepted Event" : localClusterConfirmMode
if researchShouldUpdate
    int rEventTime = time[pivotRight]
    // In-window segment build gate (additive; sets NO alert flags). Segments are
    // built from the same qualifying confirmed reactions as the research zones.
    bool buildSeg = showInWindowDetail and inWindowDetailMode != "Off"
    // Lifecycle trail build gate (additive; sets NO alert flags either). Gated
    // by the legacy master switch too, so the demoted trail engine costs
    // nothing at the shipped defaults (inWindowDetailMode = "Off").
    bool buildTrail = showInWindowDetail and inWindowDetailMode != "Off" and (inWindowDetailEngine == "Lifecycle Trails" or inWindowDetailEngine == "Both")
    // -- Resistance-like event (pivot high) --
    if not na(ph)
        float pivotPrice = high[pivotRight]
        if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
            float cNow = close
            float strength = f_reactionStrengthAtr(false, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
            bool strongEnough = not na(strength) and strength >= minReactionAtr
            bool wickOk = f_passWickFilter(false)
            float eq = f_eventQuality(false, pivotPrice, atrAtPivot, strength, cNow)
            float closeAwayAtr = math.max(0.0, (pivotPrice - cNow) / atrAtPivot)
            bool qualityOk = detectionEngine != "Quality Weighted" or (eq >= minEventQualityScore and (not usePivotProminenceFilter or f_pivotProminenceAtr(false, pivotPrice, atrAtPivot) >= minPivotProminenceAtr) and (not useCloseAwayFilter or closeAwayAtr >= minCloseAwayAtr))
            if strongEnough and wickOk and qualityOk
                float hw = f_zoneHalfWidth(pivotPrice, atrAtPivot)
                int mi = f_rFindMergeIndex(pivotPrice, hw, -1, atr)
                // segOk mirrors the same-swing "Ignore" skip: an ignored same-swing
                // reaction creates neither a research-zone touch nor a segment.
                bool segOk = true
                // Trail event score (same family as the segment score).
                float trailSc = f_clamp(0.5 * eq + 50 * math.min(1.0, (na(strength) ? 0.0 : strength) / 1.5), 0.0, 100.0)
                if mi == -1
                    f_rCreateZone(pivotPrice, hw, -1, strength, eventBar, rEventTime, eq, nextResearchZoneId)
                    if buildTrail
                        f_trailCreate(nextResearchZoneId, pivotPrice, hw, eventBar, rEventTime, -1, trailSc, eq)
                    // Allocate ids at GLOBAL scope only (never inside a function),
                    // and regardless of buildTrail so ids stay stable.
                    nextResearchZoneId += 1
                    researchLastReactionBar := eventBar
                else
                    int barsSince = eventBar - array.get(rZoneLastTouchBar, mi)
                    bool within = barsSince < minEventSeparationBars
                    if not (within and sameSwingHandling == "Ignore")
                        bool countTouch = not (within and sameSwingHandling == "Update Only")
                        // Captured BEFORE f_rUpdateZone (which clears the flag).
                        bool wasReactivated = array.get(rZoneInvalidated, mi) and allowReactivation
                        f_rUpdateZone(mi, pivotPrice, hw, -1, strength, atr, eventBar, rEventTime, eq, countTouch)
                        researchLastReactionBar := eventBar
                        if buildTrail
                            int zid = array.get(rZoneId, mi)
                            int ti = f_trailOpenIndexByZoneId(zid)
                            float zNewCenter = array.get(rZoneCenter, mi)
                            // State change: role flip, reactivation, or a large
                            // ATR-normalized center shift -> close the old trail
                            // and start a new one at the new price band.
                            bool stateChange = false
                            if ti >= 0
                                bool roleFlip = array.get(trailRoleType, ti) != -1
                                bool centerShift = not na(atr) and atr > 0 and math.abs(zNewCenter - array.get(trailCenter, ti)) >= lifecycleStateChangeAtr * atr
                                stateChange := roleFlip or wasReactivated or centerShift
                            if ti >= 0 and stateChange
                                array.set(trailActive, ti, false)
                                f_trailCreate(zid, zNewCenter, hw, eventBar, rEventTime, -1, trailSc, eq)
                            else if ti >= 0
                                // Continue the trail; NEVER rewrite its center
                                // (past price bands must never move).
                                array.set(trailEndBar, ti, bar_index)
                                array.set(trailEndTime, ti, time)
                                array.set(trailScore, ti, math.max(array.get(trailScore, ti), trailSc))
                                array.set(trailQuality, ti, math.max(array.get(trailQuality, ti), eq))
                            else
                                f_trailCreate(zid, zNewCenter, hw, eventBar, rEventTime, -1, trailSc, eq)
                    else
                        segOk := false
                // Local in-window segment (visual only; NOT a filter of Live zones).
                if buildSeg and segOk
                    float segSc = f_clamp(0.5 * eq + 50 * math.min(1.0, (na(strength) ? 0.0 : strength) / 1.5), 0.0, 100.0)
                    f_segCreate(pivotPrice, f_zoneHalfWidth(pivotPrice, atrAtPivot), eventBar, rEventTime, time, -1, segSc, eq)
    // -- Support-like event (pivot low) --
    if not na(pl)
        float pivotPrice = low[pivotRight]
        if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
            float cNow = close
            float strength = f_reactionStrengthAtr(true, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
            bool strongEnough = not na(strength) and strength >= minReactionAtr
            bool wickOk = f_passWickFilter(true)
            float eq = f_eventQuality(true, pivotPrice, atrAtPivot, strength, cNow)
            float closeAwayAtr = math.max(0.0, (cNow - pivotPrice) / atrAtPivot)
            bool qualityOk = detectionEngine != "Quality Weighted" or (eq >= minEventQualityScore and (not usePivotProminenceFilter or f_pivotProminenceAtr(true, pivotPrice, atrAtPivot) >= minPivotProminenceAtr) and (not useCloseAwayFilter or closeAwayAtr >= minCloseAwayAtr))
            if strongEnough and wickOk and qualityOk
                float hw = f_zoneHalfWidth(pivotPrice, atrAtPivot)
                int mi = f_rFindMergeIndex(pivotPrice, hw, 1, atr)
                bool segOk = true
                // Trail event score (same family as the segment score).
                float trailSc = f_clamp(0.5 * eq + 50 * math.min(1.0, (na(strength) ? 0.0 : strength) / 1.5), 0.0, 100.0)
                if mi == -1
                    f_rCreateZone(pivotPrice, hw, 1, strength, eventBar, rEventTime, eq, nextResearchZoneId)
                    if buildTrail
                        f_trailCreate(nextResearchZoneId, pivotPrice, hw, eventBar, rEventTime, 1, trailSc, eq)
                    // Allocate ids at GLOBAL scope only (never inside a function),
                    // and regardless of buildTrail so ids stay stable.
                    nextResearchZoneId += 1
                    researchLastReactionBar := eventBar
                else
                    int barsSince = eventBar - array.get(rZoneLastTouchBar, mi)
                    bool within = barsSince < minEventSeparationBars
                    if not (within and sameSwingHandling == "Ignore")
                        bool countTouch = not (within and sameSwingHandling == "Update Only")
                        // Captured BEFORE f_rUpdateZone (which clears the flag).
                        bool wasReactivated = array.get(rZoneInvalidated, mi) and allowReactivation
                        f_rUpdateZone(mi, pivotPrice, hw, 1, strength, atr, eventBar, rEventTime, eq, countTouch)
                        researchLastReactionBar := eventBar
                        if buildTrail
                            int zid = array.get(rZoneId, mi)
                            int ti = f_trailOpenIndexByZoneId(zid)
                            float zNewCenter = array.get(rZoneCenter, mi)
                            bool stateChange = false
                            if ti >= 0
                                bool roleFlip = array.get(trailRoleType, ti) != 1
                                bool centerShift = not na(atr) and atr > 0 and math.abs(zNewCenter - array.get(trailCenter, ti)) >= lifecycleStateChangeAtr * atr
                                stateChange := roleFlip or wasReactivated or centerShift
                            if ti >= 0 and stateChange
                                array.set(trailActive, ti, false)
                                f_trailCreate(zid, zNewCenter, hw, eventBar, rEventTime, 1, trailSc, eq)
                            else if ti >= 0
                                // Continue the trail; NEVER rewrite its center.
                                array.set(trailEndBar, ti, bar_index)
                                array.set(trailEndTime, ti, time)
                                array.set(trailScore, ti, math.max(array.get(trailScore, ti), trailSc))
                                array.set(trailQuality, ti, math.max(array.get(trailQuality, ti), eq))
                            else
                                f_trailCreate(zid, zNewCenter, hw, eventBar, rEventTime, 1, trailSc, eq)
                    else
                        segOk := false
                // Local in-window segment (visual only; NOT a filter of Live zones).
                if buildSeg and segOk
                    float segSc = f_clamp(0.5 * eq + 50 * math.min(1.0, (na(strength) ? 0.0 : strength) / 1.5), 0.0, 100.0)
                    f_segCreate(pivotPrice, f_zoneHalfWidth(pivotPrice, atrAtPivot), eventBar, rEventTime, time, 1, segSc, eq)
    // Extend / retire segments (still gated to <= right edge, so no future leak),
    // then enforce a hard cap by dropping the weakest segments.
    if buildSeg and array.size(segCenter) > 0
        for i = (array.size(segCenter) - 1) to 0
            if i >= 0 and i < array.size(segCenter)
                if (bar_index - array.get(segStartBar, i)) <= inWindowSegmentExtensionBars
                    // Extend the live end to the current processing bar. time is
                    // <= the visible right edge here, so this never leaks future data.
                    array.set(segEndTime, i, time)
                else
                    int segEnd = array.get(segEndTime, i)
                    int leftE = chart.left_visible_bar_time
                    if not na(segEnd) and not na(leftE) and segEnd < leftE
                        f_segRemoveAt(i)
    // Hard cap: drop the lowest-score segment (oldest segStartBar tiebreak).
    if buildSeg
        while array.size(segCenter) > 400
            int sn = array.size(segCenter)
            int worstIdx = 0
            float worstScore = array.get(segScore, 0)
            int worstStart = array.get(segStartBar, 0)
            if sn > 1
                for i = 1 to sn - 1
                    float s = array.get(segScore, i)
                    int sb = array.get(segStartBar, i)
                    if s < worstScore or (s == worstScore and sb < worstStart)
                        worstScore := s
                        worstIdx := i
                        worstStart := sb
            f_segRemoveAt(worstIdx)
    // Extend / prune lifecycle trails. time is <= the visible right edge inside
    // this block, so advancing an active trail's end NEVER leaks future data.
    if buildTrail and array.size(trailZoneId) > 0
        for i = (array.size(trailZoneId) - 1) to 0
            if i >= 0 and i < array.size(trailZoneId)
                if array.get(trailActive, i)
                    int aliveBars = bar_index - array.get(trailStartBar, i)
                    if aliveBars > lifecycleTrailMaxBars
                        // Runaway bar-budget cap (applies under ALL end policies).
                        array.set(trailActive, i, false)
                    else if lifecycleTrailEndPolicy == "Fixed Bars" and aliveBars >= lifecycleTrailMaxBars
                        // "Fixed Bars": stop exactly at the bar budget. The other
                        // policies keep extending: "Until Invalidation Or State
                        // Change" relies on the event-driven closes above, and
                        // "Until Research Right Edge" extends active trails up to
                        // the same cap.
                        array.set(trailActive, i, false)
                    else
                        array.set(trailEndBar, i, bar_index)
                        array.set(trailEndTime, i, time)
                else
                    // Closed AND already scrolled out on the left -> permanently
                    // invisible in this window; prune it.
                    int tEnd = array.get(trailEndTime, i)
                    int leftE = chart.left_visible_bar_time
                    if not na(tEnd) and not na(leftE) and tEnd < leftE
                        f_trailRemoveAt(i)
    // Hard cap: prefer removing inactive trails, then lowest score, then oldest
    // start bar (single manual scan; bounds-safe).
    if buildTrail
        while array.size(trailZoneId) > 500
            int tn = array.size(trailZoneId)
            int worstIdx = 0
            bool worstInactive = not array.get(trailActive, 0)
            float worstScore = array.get(trailScore, 0)
            int worstStart = array.get(trailStartBar, 0)
            if tn > 1
                for i = 1 to tn - 1
                    bool inact = not array.get(trailActive, i)
                    float s = array.get(trailScore, i)
                    int sb = array.get(trailStartBar, i)
                    bool worse = false
                    if inact and not worstInactive
                        worse := true
                    else if inact == worstInactive
                        if s < worstScore or (s == worstScore and sb < worstStart)
                            worse := true
                    if worse
                        worstIdx := i
                        worstInactive := inact
                        worstScore := s
                        worstStart := sb
            f_trailRemoveAt(worstIdx)
    // Research invalidation on confirmed closes (mirrors Live; no alert flags).
    if barstate.isconfirmed and array.size(rZoneCenter) > 0
        for i = (array.size(rZoneCenter) - 1) to 0
            if i >= 0 and i < array.size(rZoneCenter)
                if not array.get(rZoneInvalidated, i)
                    if f_rIsInvalidated(i, atr, bar_index)
                        array.set(rZoneInvalidated, i, true)
                        array.set(rZoneInvalidatedBar, i, bar_index)
                        array.set(rZoneInvalidatedTime, i, time)
                        // Close this zone's lifecycle trail as ended-by-
                        // invalidation BEFORE any removal (visual only).
                        f_trailCloseByZoneId(array.get(rZoneId, i), true)
                        if not keepInvalidatedZones
                            f_rRemoveZoneAt(i)
                else
                    int invBar = array.get(rZoneInvalidatedBar, i)
                    if not na(invBar) and (bar_index - invBar) > invalidatedZoneAgeBars
                        f_rRemoveZoneAt(i)
    // Prune using the CURRENT processing bar index as the reference.
    f_rPruneStaleZones(bar_index)
    f_rPruneZones(atr, bar_index)
    // -----------------------------------------------------------------------
    // LOCAL WINDOW LEVELS BUILD (fully independent of the rZone model above).
    // This standalone section re-derives its own gates from the SAME confirmed
    // ph/pl events and runs REGARDLESS of what the rZone path did with them
    // (merge / same-swing Ignore does NOT apply here), so every qualifying
    // confirmed pivot reaction is represented. Effective gates are driven by the
    // Local Detection Profile: "Exploratory" relaxes every floor (every
    // confirmed pivot accepted, all confirmed); "Balanced Quality" uses the
    // tuned localMin* defaults; "Strict Quality"/"Very Strict Quality"
    // progressively raise the reaction / event-quality / validation / prominence
    // floors. Acceptance here is DETECTION quality only — nothing here touches
    // the render. Sets NO ev* alert flag; time <= the visible right edge inside
    // this block, so level end times never leak future data.
    // -----------------------------------------------------------------------
    // "Muted Context Only" never draws local levels, so skip the whole build in
    // that mode (an input change triggers a full recalc, so no stale data).
    bool buildLocal = showLocalWindowLevels and historicalDetailEngine == "Local Window Levels" and localWindowMode != "Muted Context Only"
    if buildLocal
        // -- Resistance-like event (pivot high) --
        if not na(ph)
            float pivotPrice = high[pivotRight]
            if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
                float cNow = close
                float strength = f_reactionStrengthAtr(false, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
                float eq = f_eventQuality(false, pivotPrice, atrAtPivot, strength, cNow)
                float closeAwayAtr = math.max(0.0, (pivotPrice - cNow) / atrAtPivot)
                bool strongEnoughLocal = not na(strength) and strength >= effReactionAtr
                bool wickValid = f_localWickToBody(false) >= localMinWickToBodyRatio
                bool closeAwayValid = closeAwayAtr >= localMinCloseAwayAtr
                bool validationOk = effValidation == "Reaction Only" ? true : effValidation == "Wick And Close-Away" ? (wickValid and closeAwayValid) : (wickValid or closeAwayValid)
                bool qualityOkLocal = exploratory ? true : (not na(eq) and eq >= effEventQuality)
                bool prominenceOk = not effUseProminence ? true : (f_pivotProminenceAtr(false, pivotPrice, atrAtPivot) >= effProminenceAtr)
                if strongEnoughLocal and validationOk and qualityOkLocal and prominenceOk
                    f_lLevelProcessEvent(pivotPrice, f_zoneHalfWidth(pivotPrice, atrAtPivot), -1, strength, eq, eventBar, rEventTime, atr, effEveryReactionLocal, localMinEventSeparationBars, localSameSwingPolicy, effClusterConfirm, localMinClusterReactions, localStrongSingleQuality)
        // -- Support-like event (pivot low) --
        if not na(pl)
            float pivotPrice = low[pivotRight]
            if not na(pivotPrice) and not na(atrAtPivot) and atrAtPivot > 0
                float cNow = close
                float strength = f_reactionStrengthAtr(true, pivotPrice, atrAtPivot, reactHiWin, reactLoWin, cNow)
                float eq = f_eventQuality(true, pivotPrice, atrAtPivot, strength, cNow)
                float closeAwayAtr = math.max(0.0, (cNow - pivotPrice) / atrAtPivot)
                bool strongEnoughLocal = not na(strength) and strength >= effReactionAtr
                bool wickValid = f_localWickToBody(true) >= localMinWickToBodyRatio
                bool closeAwayValid = closeAwayAtr >= localMinCloseAwayAtr
                bool validationOk = effValidation == "Reaction Only" ? true : effValidation == "Wick And Close-Away" ? (wickValid and closeAwayValid) : (wickValid or closeAwayValid)
                bool qualityOkLocal = exploratory ? true : (not na(eq) and eq >= effEventQuality)
                bool prominenceOk = not effUseProminence ? true : (f_pivotProminenceAtr(true, pivotPrice, atrAtPivot) >= effProminenceAtr)
                if strongEnoughLocal and validationOk and qualityOkLocal and prominenceOk
                    f_lLevelProcessEvent(pivotPrice, f_zoneHalfWidth(pivotPrice, atrAtPivot), 1, strength, eq, eventBar, rEventTime, atr, effEveryReactionLocal, localMinEventSeparationBars, localSameSwingPolicy, effClusterConfirm, localMinClusterReactions, localStrongSingleQuality)
    // Per-bar local-level maintenance: life cap, broken check, optional retouch
    // refresh, end-time advance (time <= right edge here -> no future leak),
    // and pruning of levels that are closed AND scrolled out on the left.
    if buildLocal and array.size(lLevelCenter) > 0
        for i = (array.size(lLevelCenter) - 1) to 0
            if i >= 0 and i < array.size(lLevelCenter)
                if array.get(lLevelActive, i)
                    // Exploratory behaves like "Fixed Bars": life is counted
                    // from the start bar and the broken check is skipped (levels
                    // run to the localLevelMaxBars cap).
                    int lifeBase = (not exploratory and localLevelEndMode == "Until Retouched Or Broken") ? array.get(lLevelLastEventBar, i) : array.get(lLevelStartBar, i)
                    if na(lifeBase)
                        lifeBase := array.get(lLevelStartBar, i)
                    if not na(lifeBase) and bar_index - lifeBase > localLevelMaxBars
                        // Hard life cap (applies under ALL end modes).
                        array.set(lLevelActive, i, false)
                    else
                        float lc = array.get(lLevelCenter, i)
                        float lhw = array.get(lLevelHalfWidth, i)
                        bool stillActive = true
                        if not effFixedBarsLocal and not na(lc) and not na(lhw)
                            // Broken: confirmed close clearly beyond the band on
                            // the level's OWN side (role-aware). A support-like
                            // level (role 1) is broken only by a close BELOW it;
                            // a resistance-like level (role -1) only by a close
                            // ABOVE it. Price moving AWAY from the level (the
                            // reaction itself) must never self-break the level.
                            float band = (na(atr) ? 0.0 : atr) * invalidationAtrMult
                            float lvLo = lc - lhw - band
                            float lvHi = lc + lhw + band
                            int lvRole = array.get(lLevelRoleType, i)
                            bool broken = lvRole == 1 ? close < lvLo : close > lvHi
                            if not na(close) and broken
                                array.set(lLevelActive, i, false)
                                array.set(lLevelInvalidated, i, true)
                                stillActive := false
                        if stillActive
                            if localLevelEndMode == "Until Retouched Or Broken" and not na(lc) and not na(lhw) and not na(high) and not na(low) and high >= lc - lhw and low <= lc + lhw
                                // A retouch refreshes the life clock only (NOT
                                // the reaction count).
                                array.set(lLevelLastEventBar, i, bar_index)
                                array.set(lLevelLastEventTime, i, time)
                            array.set(lLevelEndBar, i, bar_index)
                            array.set(lLevelEndTime, i, time)
                else
                    // Closed and permanently invisible in this window -> prune
                    // (end time is a TIME, directly comparable to the left edge).
                    int lvEnd = array.get(lLevelEndTime, i)
                    int leftEdgeT = chart.left_visible_bar_time
                    if not na(lvEnd) and not na(leftEdgeT) and lvEnd < leftEdgeT
                        f_lLevelRemoveAt(i)
    // Hard data cap: prefer removing inactive levels, then lowest score, then
    // oldest start bar (single manual scan; bounds-safe).
    if buildLocal
        while array.size(lLevelCenter) > 800
            int lvn = array.size(lLevelCenter)
            int worstIdx = 0
            bool worstInactive = not array.get(lLevelActive, 0)
            float worstScore = array.get(lLevelScore, 0)
            int worstStart = array.get(lLevelStartBar, 0)
            if lvn > 1
                for i = 1 to lvn - 1
                    bool inact = not array.get(lLevelActive, i)
                    float s = array.get(lLevelScore, i)
                    int sb = array.get(lLevelStartBar, i)
                    bool worse = false
                    if inact and not worstInactive
                        worse := true
                    else if inact == worstInactive
                        if s < worstScore or (s == worstScore and sb < worstStart)
                            worse := true
                    if worse
                        worstIdx := i
                        worstInactive := inact
                        worstScore := s
                        worstStart := sb
            f_lLevelRemoveAt(worstIdx)

// ---------------------------------------------------------------------------
// TOUCH DETECTION (price entering an active zone range on the current bar)
// ---------------------------------------------------------------------------
if warmedUp and array.size(zoneCenter) > 0
    for i = 0 to array.size(zoneCenter) - 1
        if i >= 0 and i < array.size(zoneCenter) and not array.get(zoneInvalidated, i)
            float zc = array.get(zoneCenter, i)
            float zhw = array.get(zoneHalfWidth, i)
            float zLow = zc - zhw
            float zHigh = zc + zhw
            // Current bar overlaps the zone range.
            bool overlap = high >= zLow and low <= zHigh
            // Prior bar's close was outside the zone (fresh crossing into it).
            bool prevOutside = not na(close[1]) and (close[1] < zLow or close[1] > zHigh)
            // "Any Bar Overlap": fire while inside; "First Touch From Outside":
            // only on an outside->inside transition. A per-zone cooldown then
            // suppresses repeats so the touch alert does not fire every bar.
            bool candidate = touchAlertMode == "Any Bar Overlap" ? overlap : (overlap and prevOutside)
            int last = array.get(zoneLastTouchAlertBar, i)
            if candidate and (na(last) or (bar_index - last) > touchAlertCooldownBars)
                evTouchedZone := true
                array.set(zoneLastTouchAlertBar, i, bar_index)

// ---------------------------------------------------------------------------
// INVALIDATION + AGE MANAGEMENT (confirmed closes)
// ---------------------------------------------------------------------------
if warmedUp and barstate.isconfirmed and array.size(zoneCenter) > 0
    // Iterate downward so removals do not disturb pending indices.
    for i = (array.size(zoneCenter) - 1) to 0
        if i >= 0 and i < array.size(zoneCenter)
            // Check invalidation transition.
            if not array.get(zoneInvalidated, i)
                if f_isInvalidated(i, atr)
                    array.set(zoneInvalidated, i, true)
                    array.set(zoneInvalidatedBar, i, bar_index)
                    // Note: f_isInvalidated solely owns zoneBreakCount (Two
                    // Closes Beyond and the Mixed/Inactive two-close rule); do
                    // not increment it again here.
                    evInactiveZone := true
                    if not keepInvalidatedZones
                        f_removeZoneAt(i)
            else
                // Age-out invalidated zones past their allowed age.
                int invBar = array.get(zoneInvalidatedBar, i)
                if not na(invBar) and (bar_index - invBar) > invalidatedZoneAgeBars
                    f_removeZoneAt(i)

// ---------------------------------------------------------------------------
// RENDER (gated to last bar to avoid object leak)
// ---------------------------------------------------------------------------
f_renderZones() =>
    int n = array.size(zoneCenter)
    // First, delete all previously drawn objects for every stored zone.
    if n > 0
        for i = 0 to n - 1
            f_deleteZoneObjects(i)

    // Build a selection list of eligible zone indices.
    array<int> selIdx = array.new_int()
    array<float> selScore = array.new_float()
    if n > 0
        for i = 0 to n - 1
            bool inv = array.get(zoneInvalidated, i)
            bool eligible = true
            if inv and not showInvalidatedZones
                eligible := false
            if eligible and array.get(zoneTouchCount, i) < minTouchesToShow
                eligible := false
            float sc = f_zoneScore(i, atr)
            if eligible and sc < minScoreToShow
                eligible := false
            if eligible and showOnlyNearbyZones and not f_isNearby(i, atr)
                eligible := false
            if eligible
                array.push(selIdx, i)
                array.push(selScore, sc)

    // Manual top-N selection by score desc, tie -> newer lastTouchBar first.
    array<int> orderedIdx = array.new_int()
    array<float> orderedScore = array.new_float()
    int selCount = array.size(selIdx)
    int limit = math.min(maxDisplayedZones, selCount)
    array<bool> used = array.new_bool(selCount, false)
    if limit > 0
        for pick = 1 to limit
            int bestPos = -1
            float bestScore = -1.0
            int bestLastTouch = -1
            if selCount > 0
                for j = 0 to selCount - 1
                    if not array.get(used, j)
                        float s = array.get(selScore, j)
                        int zi = array.get(selIdx, j)
                        int lt = array.get(zoneLastTouchBar, zi)
                        if s > bestScore or (s == bestScore and lt > bestLastTouch)
                            bestScore := s
                            bestPos := j
                            bestLastTouch := lt
            if bestPos >= 0
                array.set(used, bestPos, true)
                array.push(orderedIdx, array.get(selIdx, bestPos))
                array.push(orderedScore, bestScore)

    // Draw the selected zones.
    int drawCount = array.size(orderedIdx)
    int rightX = extendZonesRight ? bar_index + labelOffsetBars : bar_index
    if drawCount > 0
        for k = 0 to drawCount - 1
            int i = array.get(orderedIdx, k)
            if i >= 0 and i < array.size(zoneCenter)
                float zc = array.get(zoneCenter, i)
                float zhw = array.get(zoneHalfWidth, i)
                float zLow = zc - zhw
                float zHigh = zc + zhw
                bool inv = array.get(zoneInvalidated, i)
                int role = f_zoneRole(i)
                float sc = array.get(orderedScore, k)
                bool strong = sc >= strongScoreThreshold
                color baseCol = f_roleColor(role, inv)
                int transp = inv ? invalidatedTransparency : (strong ? strongZoneTransparency : zoneTransparency)
                int lw = strong ? strongLineWidth : centerLineWidth
                int leftX = math.max(array.get(zoneFirstBar, i), bar_index - 9500)
                int boxRight = extendZonesRight ? bar_index : rightX

                // Zone fill box.
                if showZoneFill
                    box bx = box.new(left=leftX, top=zHigh, right=boxRight, bottom=zLow, xloc=xloc.bar_index, border_color=color.new(baseCol, 100), bgcolor=color.new(baseCol, transp), extend=extendZonesRight ? extend.right : extend.none)
                    array.set(zoneBoxId, i, bx)

                // Center line.
                if showCenterLine
                    line cl = line.new(x1=leftX, y1=zc, x2=rightX, y2=zc, xloc=xloc.bar_index, color=color.new(baseCol, inv ? 40 : 0), style=line.style_solid, width=lw, extend=extendZonesRight ? extend.right : extend.none)
                    array.set(zoneCenterLineId, i, cl)

                // Optional boundary lines.
                if showZoneBoundaries
                    line ul = line.new(x1=leftX, y1=zHigh, x2=rightX, y2=zHigh, xloc=xloc.bar_index, color=color.new(baseCol, 30), style=line.style_dotted, width=1, extend=extendZonesRight ? extend.right : extend.none)
                    array.set(zoneUpperLineId, i, ul)
                    line ll = line.new(x1=leftX, y1=zLow, x2=rightX, y2=zLow, xloc=xloc.bar_index, color=color.new(baseCol, 30), style=line.style_dotted, width=1, extend=extendZonesRight ? extend.right : extend.none)
                    array.set(zoneLowerLineId, i, ll)

                // Label.
                if showLabels and labelMode != "None"
                    string txt = ""
                    int tc = array.get(zoneTouchCount, i)
                    int ageA = bar_index - array.get(zoneLastTouchBar, i)
                    if labelMode == "Compact"
                        txt := f_roleText(role, true) + " " + str.tostring(tc) + "x " + str.tostring(int(math.round(sc)))
                    else
                        txt := f_roleText(role, false) + " | touches " + str.tostring(tc) + " | score " + str.tostring(int(math.round(sc))) + " | age " + str.tostring(ageA)
                    label lb = label.new(x=bar_index + labelOffsetBars, y=zc, text=txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(baseCol, inv ? 40 : 10), textcolor=color.white, size=size.small)
                    array.set(zoneLabelId, i, lb)

// ---------------------------------------------------------------------------
// CONTEXT-SWITCH CLEANUP HELPERS
// ---------------------------------------------------------------------------
// Delete every Live drawing handle stored in the Live zone arrays, so switching
// from Live to Research leaves nothing stale on the chart.
f_clearLiveObjects() =>
    int n = array.size(zoneCenter)
    if n > 0
        for i = 0 to n - 1
            f_deleteZoneObjects(i)

// Delete + clear the research display pool, so switching from Research to Live
// (or re-drawing) leaves nothing stale on the chart.
f_clearResearchObjects() =>
    if array.size(rDispBox) > 0
        for i = 0 to array.size(rDispBox) - 1
            box bx = array.get(rDispBox, i)
            if not na(bx)
                box.delete(bx)
    if array.size(rDispLineC) > 0
        for i = 0 to array.size(rDispLineC) - 1
            line ln = array.get(rDispLineC, i)
            if not na(ln)
                line.delete(ln)
    if array.size(rDispLineU) > 0
        for i = 0 to array.size(rDispLineU) - 1
            line ln = array.get(rDispLineU, i)
            if not na(ln)
                line.delete(ln)
    if array.size(rDispLineL) > 0
        for i = 0 to array.size(rDispLineL) - 1
            line ln = array.get(rDispLineL, i)
            if not na(ln)
                line.delete(ln)
    if array.size(rDispLabel) > 0
        for i = 0 to array.size(rDispLabel) - 1
            label lb = array.get(rDispLabel, i)
            if not na(lb)
                label.delete(lb)
    array.clear(rDispBox)
    array.clear(rDispLineC)
    array.clear(rDispLineU)
    array.clear(rDispLineL)
    array.clear(rDispLabel)

// ---------------------------------------------------------------------------
// RESEARCH RENDER (visual-only; xloc.bar_time; separate display pool).
// Reconstructs the top zones AS OF the visible right edge and draws them from
// the visible window (or zone origin) up to the right edge. Uses extend.none.
// ---------------------------------------------------------------------------
// ctxBoost softens the right-edge context zones (box bg + center line) when the
// lifecycle-trail layer is the primary detail; ctxBoost=0 reproduces the
// previous visuals exactly. Live rendering is untouched by this.
f_renderResearch(int ctxBoost) =>
    // Always clear our own pool first (no double-draw, no leak).
    f_clearResearchObjects()

    int refBar = visibleRightBarIndex
    float refClose = visibleRightClose
    float refAtr = visibleRightAtr
    int refTime = visibleRightTimeTracked
    int leftEdgeTime = chart.left_visible_bar_time
    int rightEdgeTime = chart.right_visible_bar_time

    // Guard the built-ins and the reference state.
    bool canDraw = not na(refBar) and not na(refTime) and not na(rightEdgeTime)
    if canDraw
        int n = array.size(rZoneCenter)
        float atrRef = (not na(refAtr) and refAtr > 0) ? refAtr : atr

        // Selection list of eligible research zone indices.
        array<int> selIdx = array.new_int()
        array<float> selScore = array.new_float()
        bool archiveOn = preserveHistoricalResearchZones and researchShowArchiveZones
        if n > 0
            for i = 0 to n - 1
                bool inv = array.get(rZoneInvalidated, i)
                float sc = f_rZoneScore(i, atrRef, refBar)
                // Normal-zone eligibility (existing behavior).
                bool normalOk = not (inv and not showInvalidatedZones)
                if normalOk and array.get(rZoneTouchCount, i) < minTouchesToShow
                    normalOk := false
                if normalOk and sc < minScoreToShow
                    normalOk := false
                if normalOk and showOnlyNearbyZones and not (not na(atrRef) and atrRef > 0 and not na(refClose) and math.abs(refClose - array.get(rZoneCenter, i)) <= nearbyAtrRange * atrRef)
                    normalOk := false
                if normalOk and researchShowOnlyZonesActiveAtRightEdge
                    if inv and not showInvalidatedZones
                        normalOk := false
                // Archive-zone eligibility (deeper history, lower score floor).
                bool archiveOkZone = false
                if archiveOn
                    archiveOkZone := array.get(rZoneTouchCount, i) >= minTouchesToShow and sc >= researchMinArchiveScore
                    if inv and not showInvalidatedZones
                        archiveOkZone := false
                bool eligible = normalOk or archiveOkZone
                // Require the zone to exist AS OF the right edge (time bounds).
                if eligible and (array.get(rZoneFirstTime, i) > refTime or array.get(rZoneLastTouchTime, i) > refTime)
                    eligible := false
                if eligible
                    array.push(selIdx, i)
                    array.push(selScore, sc)

        // Top-N by research score, tie -> newer last-touch bar.
        array<int> orderedIdx = array.new_int()
        array<float> orderedScore = array.new_float()
        int selCount = array.size(selIdx)
        int limit = math.min(maxDisplayedZones, selCount)
        array<bool> used = array.new_bool(selCount, false)
        if limit > 0
            for pick = 1 to limit
                int bestPos = -1
                float bestScore = -1.0
                int bestLastTouch = -1
                if selCount > 0
                    for j = 0 to selCount - 1
                        if not array.get(used, j)
                            float s = array.get(selScore, j)
                            int zi = array.get(selIdx, j)
                            int lt = array.get(rZoneLastTouchBar, zi)
                            if s > bestScore or (s == bestScore and lt > bestLastTouch)
                                bestScore := s
                                bestPos := j
                                bestLastTouch := lt
                if bestPos >= 0
                    array.set(used, bestPos, true)
                    array.push(orderedIdx, array.get(selIdx, bestPos))
                    array.push(orderedScore, bestScore)

        // Draw with xloc.bar_time; research never extends right.
        int drawCount = array.size(orderedIdx)
        if drawCount > 0
            for k = 0 to drawCount - 1
                int i = array.get(orderedIdx, k)
                if i >= 0 and i < array.size(rZoneCenter)
                    float zc = array.get(rZoneCenter, i)
                    float zhw = array.get(rZoneHalfWidth, i)
                    float zLow = zc - zhw
                    float zHigh = zc + zhw
                    bool inv = array.get(rZoneInvalidated, i)
                    int role = f_rZoneRole(i, refBar)
                    float sc = array.get(orderedScore, k)
                    bool strong = sc >= strongScoreThreshold
                    color baseCol = f_roleColor(role, inv)
                    int transp = inv ? invalidatedTransparency : (strong ? strongZoneTransparency : zoneTransparency)
                    int lw = strong ? strongLineWidth : centerLineWidth
                    // Archive zones (Inactive/Old role or below the normal score
                    // floor) are drawn MUCH fainter. Live render never does this.
                    bool isArchiveZone = preserveHistoricalResearchZones and researchShowArchiveZones and (role == 2 or sc < minScoreToShow)
                    if isArchiveZone
                        transp := researchArchiveTransparency
                    // Context boost (0 = exact legacy visuals).
                    transp := math.min(100, transp + ctxBoost)

                    int zoneFirstT = array.get(rZoneFirstTime, i)
                    int leftTime = researchRenderMode == "Visible Window" ? (na(leftEdgeTime) ? zoneFirstT : math.max(zoneFirstT, leftEdgeTime)) : zoneFirstT
                    int rightTime = rightEdgeTime

                    // Guard time ordering.
                    if not na(leftTime) and not na(rightTime) and leftTime <= rightTime
                        if showZoneFill
                            box bx = box.new(left=leftTime, top=zHigh, right=rightTime, bottom=zLow, xloc=xloc.bar_time, border_color=color.new(baseCol, 100), bgcolor=color.new(baseCol, transp), extend=extend.none)
                            array.push(rDispBox, bx)
                        if showCenterLine
                            // Archive zones get a faint center line; normal zones unchanged.
                            int clTransp = isArchiveZone ? math.max(0, math.min(90, researchArchiveTransparency - 4)) : (inv ? 40 : 0)
                            // Context boost (0 = exact legacy visuals).
                            clTransp := math.min(100, clTransp + ctxBoost)
                            line cl = line.new(x1=leftTime, y1=zc, x2=rightTime, y2=zc, xloc=xloc.bar_time, color=color.new(baseCol, clTransp), style=line.style_solid, width=lw, extend=extend.none)
                            array.push(rDispLineC, cl)
                        if showZoneBoundaries
                            line ul = line.new(x1=leftTime, y1=zHigh, x2=rightTime, y2=zHigh, xloc=xloc.bar_time, color=color.new(baseCol, 30), style=line.style_dotted, width=1, extend=extend.none)
                            array.push(rDispLineU, ul)
                            line ll = line.new(x1=leftTime, y1=zLow, x2=rightTime, y2=zLow, xloc=xloc.bar_time, color=color.new(baseCol, 30), style=line.style_dotted, width=1, extend=extend.none)
                            array.push(rDispLineL, ll)
                        if showLabels and labelMode != "None"
                            string txt = ""
                            int tc = array.get(rZoneTouchCount, i)
                            int ageA = refBar - array.get(rZoneLastTouchBar, i)
                            if ageA < 0
                                ageA := 0
                            if labelMode == "Compact"
                                txt := f_roleText(role, true) + " " + str.tostring(tc) + "x " + str.tostring(int(math.round(sc)))
                            else
                                txt := f_roleText(role, false) + " | touches " + str.tostring(tc) + " | score " + str.tostring(int(math.round(sc))) + " | age " + str.tostring(ageA)
                            label lb = label.new(x=rightTime, y=zc, text=txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(baseCol, inv ? 40 : 10), textcolor=color.white, size=size.small)
                            array.push(rDispLabel, lb)

// ---------------------------------------------------------------------------
// IN-WINDOW DETAIL RENDER (Research-only; visual only; xloc.bar_time).
// Draws local reaction segments across the visible range so smaller reaction
// areas on the left / center / right of the window can be studied. Uses its own
// display pool, extend.none, and never sets an alert flag.
// ---------------------------------------------------------------------------
f_renderInWindowDetail() =>
    // Clear our own pool first (no double-draw, no leak).
    f_clearSegmentObjects()

    int leftEdge  = chart.left_visible_bar_time
    int rightEdge = chart.right_visible_bar_time
    if not na(leftEdge) and not na(rightEdge)
        int n = array.size(segCenter)
        bool qualityGate = detectionEngine == "Quality Weighted"

        // Eligible segment indices.
        array<int> selIdx = array.new_int()
        if n > 0
            for i = 0 to n - 1
                int sStart = array.get(segStartTime, i)
                int sEnd   = array.get(segEndTime, i)
                float sSc  = array.get(segScore, i)
                float sQ   = array.get(segQuality, i)
                bool ok = not na(sStart) and not na(sEnd) and sEnd >= leftEdge and sStart <= rightEdge and sStart <= sEnd and sSc >= inWindowSegmentMinScore
                if ok and qualityGate and sQ < inWindowSegmentMinQuality
                    ok := false
                if ok
                    array.push(selIdx, i)

        int selCount = array.size(selIdx)

        // SELECTION -> bounded ordered list of segment indices (<= maxInWindowSegments).
        array<int> orderedIdx = array.new_int()
        if selCount > 0
            if inWindowSegmentSelection == "Balanced Left Center Right"
                // Bucket by segStartTime, then take top-N per bucket by score,
                // stopping at a running overall total of maxInWindowSegments.
                float visibleSpan = rightEdge - leftEdge
                int leftCut  = int(leftEdge + visibleSpan / 3)
                int rightCut = int(leftEdge + visibleSpan * 2 / 3)
                array<bool> used = array.new_bool(selCount, false)
                // bucket: 0 = Left, 1 = Center, 2 = Right
                for bkt = 0 to 2
                    bool bucketDone = false
                    for pick = 1 to maxSegmentsPerWindowBucket
                        if not bucketDone and array.size(orderedIdx) < maxInWindowSegments
                            int bestPos = -1
                            float bestScore = -1.0
                            int bestStart = -1
                            for j = 0 to selCount - 1
                                if not array.get(used, j)
                                    int zi = array.get(selIdx, j)
                                    int st = array.get(segStartTime, zi)
                                    int b = st < leftCut ? 0 : (st < rightCut ? 1 : 2)
                                    if b == bkt
                                        float s = array.get(segScore, zi)
                                        if s > bestScore or (s == bestScore and st > bestStart)
                                            bestScore := s
                                            bestPos := j
                                            bestStart := st
                            if bestPos >= 0
                                array.set(used, bestPos, true)
                                array.push(orderedIdx, array.get(selIdx, bestPos))
                            else
                                bucketDone := true
            else if inWindowSegmentSelection == "Score Only"
                array<bool> used = array.new_bool(selCount, false)
                int limit = math.min(maxInWindowSegments, selCount)
                if limit > 0
                    for pick = 1 to limit
                        int bestPos = -1
                        float bestScore = -1.0
                        int bestStart = -1
                        for j = 0 to selCount - 1
                            if not array.get(used, j)
                                int zi = array.get(selIdx, j)
                                float s = array.get(segScore, zi)
                                int st = array.get(segStartTime, zi)
                                if s > bestScore or (s == bestScore and st > bestStart)
                                    bestScore := s
                                    bestPos := j
                                    bestStart := st
                        if bestPos >= 0
                            array.set(used, bestPos, true)
                            array.push(orderedIdx, array.get(selIdx, bestPos))
            else
                // "Recent Within View": newest segStartTime first.
                array<bool> used = array.new_bool(selCount, false)
                int limit = math.min(maxInWindowSegments, selCount)
                if limit > 0
                    for pick = 1 to limit
                        int bestPos = -1
                        int bestStart = -1
                        for j = 0 to selCount - 1
                            if not array.get(used, j)
                                int zi = array.get(selIdx, j)
                                int st = array.get(segStartTime, zi)
                                if st > bestStart
                                    bestStart := st
                                    bestPos := j
                        if bestPos >= 0
                            array.set(used, bestPos, true)
                            array.push(orderedIdx, array.get(selIdx, bestPos))

        // DRAW each selected segment (bounded to maxInWindowSegments).
        string segStyle = inWindowSegmentStyle == "Solid" ? line.style_solid : inWindowSegmentStyle == "Dashed" ? line.style_dashed : line.style_dotted
        int drawCount = array.size(orderedIdx)
        if drawCount > 0
            for k = 0 to drawCount - 1
                if array.size(segDispLine) < maxInWindowSegments
                    int i = array.get(orderedIdx, k)
                    if i >= 0 and i < array.size(segCenter)
                        float center = array.get(segCenter, i)
                        float halfW  = array.get(segHalfWidth, i)
                        int role     = array.get(segRoleType, i)
                        float sSc    = array.get(segScore, i)
                        int x1 = math.max(array.get(segStartTime, i), leftEdge)
                        int x2 = math.min(array.get(segEndTime, i), rightEdge)
                        if x1 <= x2
                            color col = color.new(f_roleColor(role, false), inWindowSegmentTransparency)
                            line ln = line.new(x1=x1, y1=center, x2=x2, y2=center, xloc=xloc.bar_time, color=col, style=segStyle, width=inWindowSegmentLineWidth, extend=extend.none)
                            array.push(segDispLine, ln)
                            if inWindowSegmentUseFill
                                box bx = box.new(left=x1, top=center + halfW, right=x2, bottom=center - halfW, xloc=xloc.bar_time, border_color=color.new(f_roleColor(role, false), 100), bgcolor=color.new(f_roleColor(role, false), math.min(100, inWindowSegmentTransparency + 12)), extend=extend.none)
                                array.push(segDispBox, bx)
                            if showInWindowSegmentLabels
                                string segTxt = f_roleText(role, true) + " " + str.tostring(int(math.round(sSc)))
                                label lb = label.new(x=x2, y=center, text=segTxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(f_roleColor(role, false), math.min(100, inWindowSegmentTransparency + 5)), textcolor=color.white, size=(inWindowSegmentLabelMode == "Tiny" ? size.tiny : size.small))
                                array.push(segDispLabel, lb)

// ---------------------------------------------------------------------------
// LIFECYCLE TRAIL RENDER (Research-only; visual only; xloc.bar_time).
// Draws horizontal trails showing WHERE a local reaction zone existed DURING
// the visible window: a trail can start left/center, end mid-window when its
// zone died or changed state, and is never required to reach the right edge.
// A trail that started BEFORE the visible left edge and was still alive there
// is clamped to (drawn from) the left edge — that is visibility of an already-
// existing trail, not future data; trailStartTime is always the confirmed
// reaction origin and earlier starts are never synthesized. Uses its own
// display pool, extend.none, and never sets an alert flag.
// ---------------------------------------------------------------------------
f_renderLifecycleTrails() =>
    // Clear our own pool first (no double-draw, no leak).
    f_clearTrailObjects()

    int leftEdge  = chart.left_visible_bar_time
    int rightEdge = chart.right_visible_bar_time
    if not na(leftEdge) and not na(rightEdge)
        int n = array.size(trailZoneId)
        bool qualityGate = detectionEngine == "Quality Weighted"

        // Eligibility pass; store the CLAMPED draw coordinates per candidate.
        array<int> selIdx = array.new_int()
        array<int> selX1  = array.new_int()
        array<int> selX2  = array.new_int()
        if n > 0
            for i = 0 to n - 1
                int tStart = array.get(trailStartTime, i)
                int tEnd   = array.get(trailEndTime, i)
                bool inact = not array.get(trailActive, i) or array.get(trailInvalidated, i)
                bool ok = not na(tStart) and not na(tEnd) and tEnd >= leftEdge and tStart <= rightEdge and tStart <= tEnd
                if ok and (array.get(trailEndBar, i) - array.get(trailStartBar, i)) < lifecycleMinDurationBars
                    ok := false
                if ok and array.get(trailScore, i) < lifecycleMinScore
                    ok := false
                if ok and qualityGate and array.get(trailQuality, i) < lifecycleMinQuality
                    ok := false
                if ok and inact and not lifecycleShowInactiveTrails
                    ok := false
                if ok
                    int x1 = lifecycleTrailStartPolicy == "Actual Origin" ? tStart : math.max(tStart, leftEdge)
                    int x2 = math.min(tEnd, rightEdge)
                    if x1 <= x2
                        array.push(selIdx, i)
                        array.push(selX1, x1)
                        array.push(selX2, x2)

        int selCount = array.size(selIdx)

        // SELECTION -> bounded ordered list of POSITIONS into selIdx/selX1/selX2
        // (<= maxLifecycleTrails overall).
        array<int> orderedPos = array.new_int()
        if selCount > 0
            if lifecycleTrailSelection == "Balanced Left Center Right"
                // Bucket by the CLAMPED visible trail midpoint, then take the top
                // maxTrailsPerWindowBucket per bucket by score (tie: longer
                // duration, then newer start), stopping at maxLifecycleTrails.
                float visibleSpan = rightEdge - leftEdge
                int leftCut  = int(leftEdge + visibleSpan / 3)
                int rightCut = int(leftEdge + visibleSpan * 2 / 3)
                array<bool> used = array.new_bool(selCount, false)
                // bucket: 0 = Left, 1 = Center, 2 = Right
                for bkt = 0 to 2
                    bool bucketDone = false
                    for pick = 1 to maxTrailsPerWindowBucket
                        if not bucketDone and array.size(orderedPos) < maxLifecycleTrails
                            int bestPos = -1
                            float bestScore = -1.0
                            int bestDur = -1
                            int bestStart = -1
                            for j = 0 to selCount - 1
                                if not array.get(used, j)
                                    int zi = array.get(selIdx, j)
                                    int mid = (array.get(selX1, j) + array.get(selX2, j)) / 2
                                    int b = mid < leftCut ? 0 : (mid < rightCut ? 1 : 2)
                                    if b == bkt
                                        float s = array.get(trailScore, zi)
                                        int dur = array.get(trailEndBar, zi) - array.get(trailStartBar, zi)
                                        int st = array.get(trailStartTime, zi)
                                        if s > bestScore or (s == bestScore and (dur > bestDur or (dur == bestDur and st > bestStart)))
                                            bestScore := s
                                            bestDur := dur
                                            bestStart := st
                                            bestPos := j
                            if bestPos >= 0
                                array.set(used, bestPos, true)
                                array.push(orderedPos, bestPos)
                            else
                                bucketDone := true
            else if lifecycleTrailSelection == "Score Only"
                array<bool> used = array.new_bool(selCount, false)
                int limit = math.min(maxLifecycleTrails, selCount)
                if limit > 0
                    for pick = 1 to limit
                        int bestPos = -1
                        float bestScore = -1.0
                        int bestDur = -1
                        int bestStart = -1
                        for j = 0 to selCount - 1
                            if not array.get(used, j)
                                int zi = array.get(selIdx, j)
                                float s = array.get(trailScore, zi)
                                int dur = array.get(trailEndBar, zi) - array.get(trailStartBar, zi)
                                int st = array.get(trailStartTime, zi)
                                if s > bestScore or (s == bestScore and (dur > bestDur or (dur == bestDur and st > bestStart)))
                                    bestScore := s
                                    bestDur := dur
                                    bestStart := st
                                    bestPos := j
                        if bestPos >= 0
                            array.set(used, bestPos, true)
                            array.push(orderedPos, bestPos)
            else
                // "Duration Then Score": longest first, tie by score, then newer.
                array<bool> used = array.new_bool(selCount, false)
                int limit = math.min(maxLifecycleTrails, selCount)
                if limit > 0
                    for pick = 1 to limit
                        int bestPos = -1
                        int bestDur = -1
                        float bestScore = -1.0
                        int bestStart = -1
                        for j = 0 to selCount - 1
                            if not array.get(used, j)
                                int zi = array.get(selIdx, j)
                                int dur = array.get(trailEndBar, zi) - array.get(trailStartBar, zi)
                                float s = array.get(trailScore, zi)
                                int st = array.get(trailStartTime, zi)
                                if dur > bestDur or (dur == bestDur and (s > bestScore or (s == bestScore and st > bestStart)))
                                    bestDur := dur
                                    bestScore := s
                                    bestStart := st
                                    bestPos := j
                        if bestPos >= 0
                            array.set(used, bestPos, true)
                            array.push(orderedPos, bestPos)

        // DRAW each selected trail (bounded to maxLifecycleTrails; line + optional
        // neutral label only, no boxes).
        string trailLineStyle = lifecycleTrailStyle == "Solid" ? line.style_solid : lifecycleTrailStyle == "Dashed" ? line.style_dashed : line.style_dotted
        int drawCount = array.size(orderedPos)
        if drawCount > 0
            for k = 0 to drawCount - 1
                if array.size(trailDispLine) < maxLifecycleTrails
                    int j = array.get(orderedPos, k)
                    int i = array.get(selIdx, j)
                    if i >= 0 and i < array.size(trailZoneId)
                        bool isInactive = not array.get(trailActive, i) or array.get(trailInvalidated, i)
                        int transp = isInactive ? lifecycleInactiveTransparency : lifecycleTrailTransparency
                        float yC = array.get(trailCenter, i)
                        int role = array.get(trailRoleType, i)
                        color col = color.new(f_roleColor(role, false), transp)
                        line ln = line.new(x1=array.get(selX1, j), y1=yC, x2=array.get(selX2, j), y2=yC, xloc=xloc.bar_time, color=col, style=trailLineStyle, width=lifecycleTrailLineWidth, extend=extend.none)
                        array.push(trailDispLine, ln)
                        if showLifecycleTrailLabels
                            string trailTxt = f_roleText(role, true) + " " + str.tostring(int(math.round(array.get(trailScore, i))))
                            label lb = label.new(x=array.get(selX2, j), y=yC, text=trailTxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(f_roleColor(role, false), math.min(100, transp + 5)), textcolor=color.white, size=(lifecycleTrailLabelMode == "Tiny" ? size.tiny : size.small))
                            array.push(trailDispLabel, lb)

// ---------------------------------------------------------------------------
// LOCAL WINDOW LEVEL RENDER (Research-only; visual only; xloc.bar_time).
// Draws the visible-window local levels built DIRECTLY from confirmed pivot
// reactions. Filtered ONLY by its own local* thresholds — NEVER by
// maxDisplayedZones / minTouchesToShow / minScoreToShow / showOnlyNearbyZones.
// Inactive/invalidated levels stay eligible and simply draw fainter: that is
// the point of historical study. Levels can start left/center and end before
// the right edge. Own display pool, extend.none, no alert flags, no boxes.
//
// RENDER CONTRACT (two paths):
//   PATH A "Draw All Detected In View" (default): DETECTED MEANS DRAWABLE.
//     The ONLY exclusions are HARD constraints: na/invalid coordinates, no
//     time overlap with the visible window, the optional explicit price clip,
//     and the PHYSICAL localHardObjectBudget line cap. Score/quality/
//     reactions/preload/selection NEVER hide a level here — clarity is
//     handled by styling (localVisibilityPolicy) only. maxLocalWindowLevels
//     does NOT apply on this path.
//   PATH B "Balanced Selection": the previous threshold + selection behavior,
//     unchanged (thresholds, preload mode, Strict-LCR/Score-Only buckets,
//     maxLocalWindowLevels).
// ---------------------------------------------------------------------------
// Render-time display-length cap for a local level's x2 (PURE DISPLAY CLAMP
// of an already-valid, non-future end time — the build maintenance is
// untouched and still advances end times only to the bar being processed).
// avgBarMs is an APPROXIMATION of bar spacing averaged across the visible
// window; it ignores session gaps, which is acceptable for display-only
// length capping. Lines therefore scale with the visible window on ANY
// timeframe and never anchor to the right edge.
// The length cap is measured from the DISPLAYED start (x1 = max(storedStart,
// leftEdge)), NOT from the stored origin. A level that began far to the left of
// the visible window is therefore drawn FROM the left edge for a natural
// screen-relative length, instead of having its whole displayed segment pushed
// off-screen (which previously produced x1 > x2 and zero drawn lines). This is
// still a pure display clamp of an already-valid, non-future end time (storedEnd
// is already clamped to the right edge by the caller); the build maintenance is
// untouched. avgBarMs approximates bar spacing across the visible window
// (session gaps ignored — acceptable for display-only length capping).
f_localDisplayX2(int displayStart, int storedEnd, float avgBarMs, int screenRelBars) =>
    int x2 = storedEnd
    if localLengthMode == "Screen Relative" and not na(avgBarMs) and avgBarMs > 0
        x2 := math.min(storedEnd, displayStart + int(math.round(screenRelBars * avgBarMs)))
    else if localLengthMode == "Fixed Bars" and not na(avgBarMs) and avgBarMs > 0
        x2 := math.min(storedEnd, displayStart + int(math.round(localLevelMaxBars * avgBarMs)))
    // "Until Broken" (and any na avgBarMs fallback): stored end time unchanged.
    x2

// ---------------------------------------------------------------------------
// LOCAL WINDOW LEVELS RENDER — INVARIANTS.
//   - The Local Window Levels build is INDEPENDENT of the right-edge context
//     zone (rZone) model; no rZone state is consulted here.
//   - A confirmed local level is drawn if it OVERLAPS the visible window and the
//     physical object budget still allows a line. The render stage must NOT hide
//     a confirmed local level for visual clarity; clarity is expressed through
//     STYLING (transparency / line style), never by suppression.
//   - Detection-quality gating belongs in event/candidate confirmation (the
//     build above), NOT in this render stage.
//   - A local level is drawn only after it is CONFIRMED (cluster or strong
//     single); pending candidates are retained and promoted on re-reaction.
//     Confirmation is a detection state computed in the build, never a
//     visual-clarity filter in the render.
//   - Research draws with xloc.bar_time and extend.none. Alerts stay Live-only.
// ---------------------------------------------------------------------------
f_renderLocalWindowLevels() =>
    // Clear our own pool first (no double-draw, no leak).
    f_clearLocalLevelObjects()

    int leftEdge  = chart.left_visible_bar_time
    int rightEdge = chart.right_visible_bar_time
    if not na(leftEdge) and not na(rightEdge)
        int n = array.size(lLevelCenter)

        // Window-third cuts, shared by BOTH paths (round-robin overflow buckets
        // on PATH A and the Strict-LCR selection buckets on PATH B).
        float visibleSpan = rightEdge - leftEdge
        int leftCut  = int(leftEdge + visibleSpan / 3)
        int rightCut = int(leftEdge + visibleSpan * 2 / 3)

        // CHART-VIEW-DEPENDENT LENGTH pre-compute (na-guarded). avgBarMs is an
        // approximation across session gaps (see f_localDisplayX2).
        int   spanBars = (not na(visibleRightBarIndex) and not na(visibleLeftBarIndex)) ? visibleRightBarIndex - visibleLeftBarIndex : na
        float avgBarMs = (not na(spanBars) and spanBars > 0) ? (rightEdge - leftEdge) * 1.0 / spanBars : na
        int   screenRelBars = (not na(spanBars) and spanBars > 0) ? math.max(1, int(math.round(spanBars * localScreenLengthPct / 100.0))) : 1

        // VISIBILITY PRESET resolution. auditVisible uses a strong, solid, opaque
        // style; otherwise the preset picks how transparent / soft the lines are.
        bool auditVisible = localVisibilityPreset == "Audit Strong"
        string effStyle = auditVisible ? line.style_solid : (localLineStyle == "Solid" ? line.style_solid : localLineStyle == "Dashed" ? line.style_dashed : line.style_dotted)
        int effWidth = auditVisible ? math.max(localLineWidth, 2) : localLineWidth
        int presetActive   = auditVisible ? 15 : (localVisibilityPreset == "Publication Soft" ? math.max(localLineTransparency, 55) : math.min(localLineTransparency, 35))
        int presetInactive = auditVisible ? 35 : (localVisibilityPreset == "Publication Soft" ? math.max(localInactiveTransparency, 80) : math.min(localInactiveTransparency, 55))
        // Shared styling resolution (Exploratory caps 55/70 stay on both paths).
        // effStyle/effWidth and the preset transparencies drive the actual draws
        // on BOTH paths now (the legacy lvlStyle/localLineWidth are superseded).
        int effActiveTransp = exploratory ? math.min(presetActive, 55) : presetActive
        int effInactiveTransp = exploratory ? math.min(presetInactive, 70) : presetInactive

        if localRenderContract == "Draw All Detected In View"
            // ================= PATH A: DETECTED MEANS DRAWABLE ==============
            // Per entry the ONLY exclusions are: (a) na/invalid coordinates,
            // (b) no time overlap with the visible window, (c) the OPTIONAL
            // explicit price clip (user opt-in), and the physical line budget
            // below. No score/quality/reactions/preload/selection exclusions;
            // maxLocalWindowLevels does NOT apply on this path.
            array<int> selIdx = array.new_int()
            array<int> selX1  = array.new_int()
            array<int> selX2  = array.new_int()
            float clipRefClose = visibleRightClose
            float clipRefAtr   = visibleRightAtr
            if n > 0
                for i = 0 to n - 1
                    int lStart = array.get(lLevelStartTime, i)
                    int lEnd   = array.get(lLevelEndTime, i)
                    // (a0) DETECTION-STATE gate: a pending candidate is not yet a
                    // detected local level. This reads the pre-computed CONFIRMED
                    // boolean only — NOT a score/quality/reactionCount/clarity
                    // comparison. Pending candidates stay stored and are drawn
                    // once they promote to confirmed in the build.
                    if array.get(lLevelConfirmed, i)
                        // (a) invalid coordinates: skip silently.
                        if not na(lStart) and not na(lEnd) and lStart <= lEnd
                            // (b) require time overlap with the visible window.
                            if lEnd >= leftEdge and lStart <= rightEdge
                                // (c) optional explicit price clip (default OFF).
                                if not (localClipToVisiblePriceRange and not na(clipRefClose) and not na(clipRefAtr) and clipRefAtr > 0 and math.abs(array.get(lLevelCenter, i) - clipRefClose) > localVisiblePricePaddingAtr * clipRefAtr)
                                    // x1 = displayed start (clamped to the left edge);
                                    // rawEnd = stored end clamped to the right edge; the
                                    // length cap then measures FROM x1, so a level that
                                    // started before the window is drawn from the left
                                    // edge and x1 <= x2 always holds for an overlapping
                                    // level (no more zero-draw from the length cap).
                                    int x1 = math.max(lStart, leftEdge)
                                    int rawEnd = math.min(lEnd, rightEdge)
                                    int x2 = f_localDisplayX2(x1, rawEnd, avgBarMs, screenRelBars)
                                    if x1 <= x2
                                        array.push(selIdx, i)
                                        array.push(selX1, x1)
                                        array.push(selX2, x2)
            int selCount = array.size(selIdx)

            // ORDER candidates per localOverflowPolicy (order only matters if
            // the physical budget is hit — earlier entries draw first).
            array<int> orderedPos = array.new_int()
            if selCount > 0
                if localOverflowPolicy == "Round Robin Left Center Right"
                    // Interleave window-third buckets L,C,R,L,C,R... by the
                    // CLAMPED midpoint so no window region starves first.
                    array<int> bktL = array.new_int()
                    array<int> bktC = array.new_int()
                    array<int> bktR = array.new_int()
                    for j = 0 to selCount - 1
                        int mid = (array.get(selX1, j) + array.get(selX2, j)) / 2
                        int b = mid < leftCut ? 0 : (mid < rightCut ? 1 : 2)
                        if b == 0
                            array.push(bktL, j)
                        else if b == 1
                            array.push(bktC, j)
                        else
                            array.push(bktR, j)
                    int maxBktLen = math.max(array.size(bktL), math.max(array.size(bktC), array.size(bktR)))
                    if maxBktLen > 0
                        for k = 0 to maxBktLen - 1
                            if k < array.size(bktL)
                                array.push(orderedPos, array.get(bktL, k))
                            if k < array.size(bktC)
                                array.push(orderedPos, array.get(bktC, k))
                            if k < array.size(bktR)
                                array.push(orderedPos, array.get(bktR, k))
                else if localOverflowPolicy == "Score Then Time"
                    // Manual selection sort: score desc, tie -> newer start.
                    // Picks are capped at the physical budget (anything beyond
                    // it could never be drawn), bounding the worst case to
                    // budget x candidates instead of candidates^2. The never-
                    // ordered remainder is still counted as budget-hidden below.
                    array<bool> used = array.new_bool(selCount, false)
                    int pickCap = math.min(selCount, localHardObjectBudget)
                    if pickCap > 0
                        for pick = 1 to pickCap
                            int bestPos = -1
                            float bestScore = -1.0
                            int bestStart = -1
                            for j = 0 to selCount - 1
                                if not array.get(used, j)
                                    int zi = array.get(selIdx, j)
                                    float s = array.get(lLevelScore, zi)
                                    int st = array.get(lLevelStartTime, zi)
                                    if s > bestScore or (s == bestScore and st > bestStart)
                                        bestScore := s
                                        bestStart := st
                                        bestPos := j
                            if bestPos >= 0
                                array.set(used, bestPos, true)
                                array.push(orderedPos, bestPos)
                else
                    // "Oldest First Across Window": natural array order — the
                    // lLevel arrays are appended chronologically during the
                    // build, so index order IS oldest-first across the window.
                    for j = 0 to selCount - 1
                        array.push(orderedPos, j)

            // DRAW in order until the PHYSICAL line budget is reached (a Pine
            // max_lines_count safety cap only, never a clarity cap).
            int drawCountA = array.size(orderedPos)
            if drawCountA > 0
                for k = 0 to drawCountA - 1
                    if array.size(lLevelDispLine) < localHardObjectBudget
                        int j = array.get(orderedPos, k)
                        int i = array.get(selIdx, j)
                        if i >= 0 and i < array.size(lLevelCenter)
                            bool fainter = not array.get(lLevelActive, i) or array.get(lLevelInvalidated, i)
                            // STYLING ONLY from score: "Fade Low Priority"
                            // draws below-threshold levels at the inactive
                            // transparency — it never hides them. "Selection
                            // Based" styles normally here (it only implies the
                            // PATH-B behavior when the contract is Balanced).
                            bool fadeLow = localVisibilityPolicy == "Fade Low Priority" and array.get(lLevelScore, i) < localMinScore
                            int transp = math.min(100, math.max(0, (fainter or fadeLow) ? effInactiveTransp : effActiveTransp))
                            float yC = array.get(lLevelCenter, i)
                            int role = array.get(lLevelRoleType, i)
                            color col = color.new(f_roleColor(role, false), transp)
                            line ln = line.new(x1=array.get(selX1, j), y1=yC, x2=array.get(selX2, j), y2=yC, xloc=xloc.bar_time, color=col, style=effStyle, width=effWidth, extend=extend.none)
                            array.push(lLevelDispLine, ln)
                            if showLocalLabels
                                // Label at the level's OWN x2 (never a right-
                                // edge / labelOffsetBars origin in Research).
                                string lvlTxt = f_roleText(role, true) + " " + str.tostring(int(math.round(array.get(lLevelScore, i))))
                                label lb = label.new(x=array.get(selX2, j), y=yC, text=lvlTxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(f_roleColor(role, false), math.min(100, transp + 5)), textcolor=color.white, size=size.tiny)
                                array.push(lLevelDispLabel, lb)
        else
            // ================= PATH B: "Balanced Selection" =================
            // The EXISTING threshold + selection behavior, unchanged.
            // Effective render thresholds (profile aware).
            float effMinScore     = exploratory ? 0.0 : localMinScore
            float effMinQuality   = exploratory ? 0.0 : localMinQuality
            int   effMinReactions = exploratory ? 1 : localMinReactions
            // Preload filter: "Overlap Window" (and Exploratory) skips the
            // start-bar cutoff entirely — the endTime>=leftEdge / startTime<=
            // rightEdge overlap checks below still apply. "Start Within Preload"
            // keeps the legacy start-bar cutoff (na-guarded).
            bool  preloadOverlap  = exploratory or localPreloadFilterMode == "Overlap Window"

            // Eligibility pass; store the CLAMPED draw coordinates per candidate.
            // Checks applied in order: time window -> score -> quality ->
            // reactions -> preload.
            array<int> selIdx = array.new_int()
            array<int> selX1  = array.new_int()
            array<int> selX2  = array.new_int()
            if n > 0
                for i = 0 to n - 1
                    int lStart = array.get(lLevelStartTime, i)
                    int lEnd   = array.get(lLevelEndTime, i)
                    // Hard checks first (CONFIRMED detection state + valid coords
                    // + overlap + clamped coords). The confirmed flag is read as a
                    // pre-computed detection state, NOT a clarity comparison.
                    bool hardOk = false
                    int x1 = na
                    int x2 = na
                    if array.get(lLevelConfirmed, i) and not na(lStart) and not na(lEnd) and lEnd >= leftEdge and lStart <= rightEdge and lStart <= lEnd
                        // Length cap measured from the displayed start (x1), so a
                        // level that began left of the window is drawn from the
                        // left edge (see f_localDisplayX2).
                        x1 := math.max(lStart, leftEdge)
                        int rawEnd = math.min(lEnd, rightEdge)
                        x2 := f_localDisplayX2(x1, rawEnd, avgBarMs, screenRelBars)
                        if x1 <= x2
                            hardOk := true
                    if hardOk
                        if array.get(lLevelScore, i) >= effMinScore and array.get(lLevelQuality, i) >= effMinQuality and array.get(lLevelReactionCount, i) >= effMinReactions
                            int sBar = array.get(lLevelStartBar, i)
                            bool preloadOk = preloadOverlap or na(visibleLeftBarIndex) or (not na(sBar) and sBar >= visibleLeftBarIndex - localPreloadBars)
                            if preloadOk
                                array.push(selIdx, i)
                                array.push(selX1, x1)
                                array.push(selX2, x2)

            int selCount = array.size(selIdx)

            // SELECTION -> bounded ordered list of POSITIONS into selIdx/selX1/selX2
            // (<= maxLocalWindowLevels overall).
            array<int> orderedPos = array.new_int()
            if selCount > 0
                if localBucketBalance == "Strict Left Center Right"
                    // Strict per-bucket independent picks: left/center candidates
                    // are taken whenever they exist, never crowded out by higher
                    // right-side scores. Bucket by the CLAMPED visible midpoint.
                    array<bool> used = array.new_bool(selCount, false)
                    // bucket: 0 = Left, 1 = Center, 2 = Right
                    for bkt = 0 to 2
                        bool bucketDone = false
                        for pick = 1 to maxLocalLevelsPerBucket
                            if not bucketDone and array.size(orderedPos) < maxLocalWindowLevels
                                int bestPos = -1
                                float bestScore = -1.0
                                int bestStart = -1
                                for j = 0 to selCount - 1
                                    if not array.get(used, j)
                                        int zi = array.get(selIdx, j)
                                        int mid = (array.get(selX1, j) + array.get(selX2, j)) / 2
                                        int b = mid < leftCut ? 0 : (mid < rightCut ? 1 : 2)
                                        if b == bkt
                                            float s = array.get(lLevelScore, zi)
                                            int st = array.get(lLevelStartTime, zi)
                                            if s > bestScore or (s == bestScore and st > bestStart)
                                                bestScore := s
                                                bestStart := st
                                                bestPos := j
                                if bestPos >= 0
                                    array.set(used, bestPos, true)
                                    array.push(orderedPos, bestPos)
                                else
                                    bucketDone := true
                else
                    // "Score Only": global top-N by score (tie: newer start time).
                    array<bool> used = array.new_bool(selCount, false)
                    int limit = math.min(maxLocalWindowLevels, selCount)
                    if limit > 0
                        for pick = 1 to limit
                            int bestPos = -1
                            float bestScore = -1.0
                            int bestStart = -1
                            for j = 0 to selCount - 1
                                if not array.get(used, j)
                                    int zi = array.get(selIdx, j)
                                    float s = array.get(lLevelScore, zi)
                                    int st = array.get(lLevelStartTime, zi)
                                    if s > bestScore or (s == bestScore and st > bestStart)
                                        bestScore := s
                                        bestStart := st
                                        bestPos := j
                            if bestPos >= 0
                                array.set(used, bestPos, true)
                                array.push(orderedPos, bestPos)

            // DRAW each selected level (bounded to maxLocalWindowLevels; line +
            // optional tiny neutral label only, NO boxes).
            int drawCount = array.size(orderedPos)
            if drawCount > 0
                for k = 0 to drawCount - 1
                    if array.size(lLevelDispLine) < maxLocalWindowLevels
                        int j = array.get(orderedPos, k)
                        int i = array.get(selIdx, j)
                        if i >= 0 and i < array.size(lLevelCenter)
                            bool fainter = not array.get(lLevelActive, i) or array.get(lLevelInvalidated, i)
                            // Exploratory caps BOTH transparencies (active 55,
                            // inactive 70) so every accepted line stays clearly
                            // visible; levels past the bar budget turn inactive and
                            // would otherwise fade to near-invisible on wide windows.
                            int transp = math.min(100, math.max(0, fainter ? effInactiveTransp : effActiveTransp))
                            float yC = array.get(lLevelCenter, i)
                            int role = array.get(lLevelRoleType, i)
                            color col = color.new(f_roleColor(role, false), transp)
                            line ln = line.new(x1=array.get(selX1, j), y1=yC, x2=array.get(selX2, j), y2=yC, xloc=xloc.bar_time, color=col, style=effStyle, width=effWidth, extend=extend.none)
                            array.push(lLevelDispLine, ln)
                            if showLocalLabels
                                string lvlTxt = f_roleText(role, true) + " " + str.tostring(int(math.round(array.get(lLevelScore, i))))
                                label lb = label.new(x=array.get(selX2, j), y=yC, text=lvlTxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(f_roleColor(role, false), math.min(100, transp + 5)), textcolor=color.white, size=size.tiny)
                                array.push(lLevelDispLabel, lb)

// ---------------------------------------------------------------------------
// DASHBOARD HELPERS
// ---------------------------------------------------------------------------
// Convert the text-size input into a Pine size constant.
f_dashboardTextSize() =>
    dashboardTextSize == "Tiny" ? size.tiny : dashboardTextSize == "Normal" ? size.normal : size.small

// True when the dashboard is anchored on the right side (near the price scale).
f_isRightDashboard() =>
    dashboardPosition == "Top Right" or dashboardPosition == "Bottom Right" or dashboardPosition == "Middle Right"

// Resolve the right-side spacer width (percent of chart width). The gap only
// applies to right-anchored dashboards; left-anchored ones need none.
// NOTE: Pine cannot read the real pixel width of the price-scale High/Low
// labels, so "Auto" is an APPROXIMATION from the price-string length and the
// selected text size, clamped to a sane range. "Manual" is always available.
f_dashboardRightGapPct() =>
    float g = 0.0
    if f_isRightDashboard() and dashboardRightGapMode != "Off"
        if dashboardRightGapMode == "Manual"
            g := dashboardManualRightGapPct
        else
            float priceRef = na(close) ? 0.0 : close
            int priceTextLen = str.length(str.tostring(priceRef, format.mintick))
            float sizeFactor = dashboardTextSize == "Tiny" ? 0.8 : dashboardTextSize == "Normal" ? 1.25 : 1.0
            g := f_clamp((0.8 + priceTextLen * 0.12) * sizeFactor * dashboardAutoGapMult, 0.75, 6.0)
    g

// Unified text-cell writer: consistent size, color and alignment.
f_dashCell(int col, int row, string txt, string halign, color bg) =>
    table.cell(dashTable, col, row, txt, text_halign=halign, text_size=f_dashboardTextSize(), bgcolor=bg, text_color=dashboardTextColor)

// Write one dashboard row (label / value / transparent right spacer) directly,
// avoiding a per-update temporary array.
f_dashRow(int row, string lab, string val, color bg, float gap) =>
    f_dashCell(0, row, lab, text.align_left, bg)
    f_dashCell(1, row, val, text.align_right, bg)
    table.cell(dashTable, 2, row, "", width=gap, text_halign=text.align_center, bgcolor=color.new(color.black, 100), text_color=color.new(color.white, 100))

// ---------------------------------------------------------------------------
// DASHBOARD (table created once at global scope; only cells updated here)
// ---------------------------------------------------------------------------
f_updateDashboard(bool useResearch) =>
    if showDashboard
        // Reference basis: Live uses current bar; Research uses the visible edge.
        float refClose = useResearch ? visibleRightClose : close
        float refAtr = useResearch ? visibleRightAtr : atr
        int refBar = useResearch ? visibleRightBarIndex : bar_index
        if useResearch and (na(refClose) or na(refBar))
            refClose := close
            refBar := bar_index
        if useResearch and (na(refAtr) or refAtr <= 0)
            refAtr := atr

        int n = useResearch ? array.size(rZoneCenter) : array.size(zoneCenter)
        // Active zone count (basis-dependent).
        int activeCount = 0
        if n > 0
            for i = 0 to n - 1
                bool inv = useResearch ? array.get(rZoneInvalidated, i) : array.get(zoneInvalidated, i)
                if not inv
                    activeCount += 1

        // Nearest lower / upper active zone (by center vs reference close).
        float nearLowerDist = na
        float nearLowerCenter = na
        float nearUpperDist = na
        float nearUpperCenter = na
        float bestScore = 0.0
        if n > 0 and not na(refClose)
            for i = 0 to n - 1
                bool inv = useResearch ? array.get(rZoneInvalidated, i) : array.get(zoneInvalidated, i)
                if not inv
                    float zc = useResearch ? array.get(rZoneCenter, i) : array.get(zoneCenter, i)
                    float sc = useResearch ? f_rZoneScore(i, refAtr, refBar) : f_zoneScore(i, atr)
                    if sc > bestScore
                        bestScore := sc
                    if zc <= refClose
                        float d = refClose - zc
                        if na(nearLowerDist) or d < nearLowerDist
                            nearLowerDist := d
                            nearLowerCenter := zc
                    else
                        float d = zc - refClose
                        if na(nearUpperDist) or d < nearUpperDist
                            nearUpperDist := d
                            nearUpperCenter := zc

        // Detection status (neutral wording).
        string status = "Active"
        if useResearch
            if activeCount == 0
                status := "No confirmed zones"
            else if useWickFilter or useBodyDirectionFilter or showOnlyNearbyZones
                status := "Active with filters"
            else
                status := "Research view"
            // Neutral hint when deeper historical archive zones are enabled.
            if dashboardMode == "Detailed" and preserveHistoricalResearchZones and researchShowArchiveZones
                status := status + " / Archive on"
        else
            if not warmedUp
                status := "Warming up"
            else if activeCount == 0
                status := "No confirmed zones"
            else if useWickFilter or useBodyDirectionFilter or showOnlyNearbyZones
                status := "Active with filters"

        // Last confirmed reaction age (basis-dependent).
        int reactBasis = useResearch ? researchLastReactionBar : lastReactionBar
        string ageStr = (na(reactBasis) or na(refBar)) ? "-" : str.tostring(refBar - reactBasis)

        // Context row value.
        string ctxVal = useResearch ? (contextMode == "Auto Hybrid" ? "Auto: Research" : "Research @ visible range") : (contextMode == "Auto Hybrid" ? "Auto: Live" : "Live")

        float atrSafe = not na(refAtr) and refAtr > 0 ? refAtr : na

        // Distance text depending on dashboard mode (distances vs reference close).
        string lowerText = "-"
        if not na(nearLowerCenter)
            if dashboardMode == "Detailed"
                float pct = (not na(refClose) and refClose != 0) ? (nearLowerDist / refClose) * 100.0 : na
                string atrTxt = na(atrSafe) ? "-" : str.tostring(math.round((nearLowerDist / atrSafe) * 100) / 100.0)
                lowerText := str.tostring(math.round_to_mintick(nearLowerCenter)) + " (" + (na(pct) ? "-" : str.tostring(math.round(pct * 100) / 100.0)) + "% / " + atrTxt + " ATR)"
            else
                lowerText := na(atrSafe) ? "-" : str.tostring(math.round((nearLowerDist / atrSafe) * 100) / 100.0) + " ATR"

        string upperText = "-"
        if not na(nearUpperCenter)
            if dashboardMode == "Detailed"
                float pct = (not na(refClose) and refClose != 0) ? (nearUpperDist / refClose) * 100.0 : na
                string atrTxt = na(atrSafe) ? "-" : str.tostring(math.round((nearUpperDist / atrSafe) * 100) / 100.0)
                upperText := str.tostring(math.round_to_mintick(nearUpperCenter)) + " (" + (na(pct) ? "-" : str.tostring(math.round(pct * 100) / 100.0)) + "% / " + atrTxt + " ATR)"
            else
                upperText := na(atrSafe) ? "-" : str.tostring(math.round((nearUpperDist / atrSafe) * 100) / 100.0) + " ATR"

        // Layout: col 0 = label (left), col 1 = value (right), col 2 = a
        // transparent right spacer that pushes the content left, away from the
        // price scale, on right-anchored dashboards. On left-anchored ones the
        // spacer width resolves to 0 (auto/minimal), so no extra gap is added.
        float gapPct = f_dashboardRightGapPct()
        // Effective transparencies from the backdrop mode (readability control).
        // Pine cannot auto-detect candle overlap behind the table, so the user
        // picks how opaque the backdrop should be.
        int effBg = dashboardBgTransparency
        int effHdr = dashboardHeaderTransparency
        if dashboardBackdropMode == "High Contrast"
            effBg := math.min(dashboardBgTransparency, 10)
            effHdr := math.min(dashboardHeaderTransparency, 18)
        else if dashboardBackdropMode == "Transparent"
            effBg := math.max(dashboardBgTransparency, 85)
            effHdr := math.max(dashboardHeaderTransparency, 85)
        color hdrBg  = color.new(color.gray, effHdr)
        color evenBg = color.new(color.black, effBg)
        color oddBg  = color.new(color.black, math.min(100, effBg + dashboardRowStripeStrength))
        color spBg   = color.new(color.black, 100)
        color spTx   = color.new(color.white, 100)

        // Header row.
        f_dashCell(0, 0, "Reaction SR Zones", text.align_left, hdrBg)
        f_dashCell(1, 0, "", text.align_right, hdrBg)
        table.cell(dashTable, 2, 0, "", width=gapPct, text_halign=text.align_center, bgcolor=spBg, text_color=spTx)

        // Data rows written directly (no per-update temp arrays); subtle striping.
        f_dashRow(1, "View context", ctxVal, oddBg, gapPct)
        f_dashRow(2, "Active zones", str.tostring(activeCount), evenBg, gapPct)
        f_dashRow(3, "Nearest lower zone", lowerText, oddBg, gapPct)
        f_dashRow(4, "Nearest upper zone", upperText, evenBg, gapPct)
        f_dashRow(5, "Highest zone score", str.tostring(int(math.round(bestScore))), oddBg, gapPct)
        f_dashRow(6, "Last confirmed reaction age", ageStr, evenBg, gapPct)
        f_dashRow(7, "Detection status", status, oddBg, gapPct)

// ---------------------------------------------------------------------------
// CONTEXT SELECTION + RENDER DISPATCH ON LAST BAR
// ---------------------------------------------------------------------------
// Optional context badge (small label). Created once, updated on the last bar.
var label ctxBadge = na

if barstate.islast
    // How far the visible right edge is from the latest bar.
    // ---- CONTEXT ROUTING: INTENT vs RENDER READINESS (kept SEPARATE) -------
    // useResearch       = which context the user (or Auto Hybrid) SELECTED.
    // canRenderResearch = whether the visible-range values needed to DRAW the
    //                     research context are actually available this run.
    // drawResearch      = useResearch AND canRenderResearch.
    // Explicit "Visible Range Research" is NEVER silently downgraded to Live:
    // if the range is not ready it draws nothing and the badge says
    // "Research unavailable" — a silent Live fallback would HIDE the failure.
    bool explicitResearch = contextMode == "Visible Range Research"
    bool explicitLive     = contextMode == "Live"
    bool autoMode         = contextMode == "Auto Hybrid"
    bool visibleRangeReady = not na(chart.left_visible_bar_time) and not na(chart.right_visible_bar_time) and not na(visibleRightBarIndex)
    int barsFromVisibleRightToLast = na(visibleRightBarIndex) ? na : bar_index - visibleRightBarIndex
    // Auto Hybrid uses the INDEX distance (robust against right-hand chart
    // margin, which can make a time-based "latest visible" test read true even
    // when the newest bars are scrolled off screen).
    bool latestIsVisible = visibleRangeReady and not na(barsFromVisibleRightToLast) and barsFromVisibleRightToLast <= liveVisibleToleranceBars
    // Intent: explicit modes honored verbatim; Auto Hybrid picks Research only
    // when the range is ready AND the latest bars are off screen.
    bool useResearch = explicitResearch ? true : explicitLive ? false : (autoMode and visibleRangeReady and not latestIsVisible)
    // Render readiness is INDEPENDENT of intent (what the render functions need).
    bool canRenderResearch = visibleRangeReady and not na(visibleRightTimeTracked)
    // Draw Research iff selected AND drawable. Explicit Research with an unready
    // range draws NOTHING (no Live fallback); the badge reports why.
    bool drawResearch = useResearch and canRenderResearch

    // Local Window Levels engine gates (the PRIMARY historical-detail layer).
    bool localEngineOn = historicalDetailEngine == "Local Window Levels"
    bool drawLocal = drawResearch and localEngineOn and showLocalWindowLevels and localWindowMode != "Muted Context Only"
    // Legacy comparison layers (demoted; opt-in via inWindowDetailMode).
    bool lifecycleComp = researchCompositionMode == "Lifecycle Detail + Context Zones" or researchCompositionMode == "Lifecycle Detail Only"
    bool eventComp = researchCompositionMode == "Event Detail + Context Zones" or researchCompositionMode == "Event Detail Only"
    // Right-edge context: drawn unless the local engine is on AND the user
    // asked for "Local Levels Only".
    bool drawRightEdge = drawResearch and (not localEngineOn or localWindowMode != "Local Levels Only")
    bool drawTrails = drawResearch and showInWindowDetail and (lifecycleComp or (eventComp and inWindowDetailEngine == "Both"))
    bool drawSeg = drawResearch and showInWindowDetail and (eventComp or (lifecycleComp and inWindowDetailEngine == "Both"))
    // Back-compat: inWindowDetailMode stays as a legacy master switch only.
    // "Off" (now the DEFAULT: legacy layers are opt-in comparison layers) kills
    // BOTH legacy detail layers; its other values defer entirely to
    // researchCompositionMode above (they no longer pick layers themselves).
    if inWindowDetailMode == "Off"
        drawTrails := false
        drawSeg := false
    // Context softening for the right-edge zones: the local engine's muted-
    // context boost applies in BOTH muted modes ("Local Levels + Muted Context"
    // and "Muted Context Only" -- the mode name promises muting even without
    // local lines; full-strength comparison is historicalDetailEngine =
    // "Right-Edge Context Only"). Otherwise the legacy trail boost applies.
    int ctxBoost = localEngineOn and (localWindowMode == "Local Levels + Muted Context" or localWindowMode == "Muted Context Only") ? localContextZoneTransparencyBoost : (drawTrails ? researchContextZoneTransparencyBoost : 0)

    // OBJECT BUDGET (per max_*_count=500):
    //   Defaults (local engine primary, legacy layers off, default
    //   "Local Levels Only" mode -> NO right-edge research objects):
    //     lines  = up to localHardObjectBudget (default 420, max 480) local
    //              level lines; the budget is a PHYSICAL line cap enforced in
    //              the render loop.
    //     labels = 1 context badge (local labels off by default).
    //   With the opt-in muted context also on: + 60 zone lines (20 x center/
    //   upper/lower) — set the budget <= 440 to stay under the 500 line cap.
    //   NOTE: enabling legacy comparison layers (segments/trails) on top of a
    //   high budget can exceed the 500 line cap; Pine then garbage-collects
    //   the OLDEST drawings (not an error). Defaults stay safe.

    // Dispatch: clear the OTHER context's objects first, then draw the selected
    // context. RESEARCH and LIVE are fully separated: the Research branch NEVER
    // calls f_renderZones() (no Live fallback), and the Live branch NEVER draws
    // research/local/segment/trail objects.
    if useResearch
        // ===================== RESEARCH CONTEXT ========================
        // xloc.bar_time, extend.none, no alerts, no Live zones. A silent Live
        // fallback is forbidden here even when the range is not ready.
        f_clearLiveObjects()
        if canRenderResearch
            if drawRightEdge
                f_renderResearch(ctxBoost)
            else
                f_clearResearchObjects()
            if drawLocal
                f_renderLocalWindowLevels()
            else
                f_clearLocalLevelObjects()
            if drawSeg
                f_renderInWindowDetail()
            else
                f_clearSegmentObjects()
            if drawTrails
                f_renderLifecycleTrails()
            else
                f_clearTrailObjects()
        else
            // Research SELECTED but the visible range is not ready. Clear the
            // research pools (nothing can be drawn) and DELIBERATELY do NOT draw
            // Live — the badge reports "Research unavailable: visible range not
            // ready" so the cause is visible, never masked by Live zones.
            f_clearResearchObjects()
            f_clearSegmentObjects()
            f_clearTrailObjects()
            f_clearLocalLevelObjects()
    else
        // ======================= LIVE CONTEXT ==========================
        // The ONLY branch that draws Live zones and extends right; drives alerts.
        f_clearResearchObjects()
        f_clearSegmentObjects()
        f_clearTrailObjects()
        f_clearLocalLevelObjects()
        f_renderZones()

    // Dashboard uses the ACTUALLY-DRAWN context (drawResearch): when Research is
    // selected but not renderable, it shows Live-basis numbers while the badge
    // flags "Research unavailable" — no misleading Research summary.
    f_updateDashboard(drawResearch)

    // Context badge (neutral wording; no trading directives).
    if not na(ctxBadge)
        label.delete(ctxBadge)
        ctxBadge := na
    if showContextBadge
        // Honest badge: an explicit Research mode that cannot render reads
        // "Research unavailable ...", never a misleading Live/Research label.
        string badgeTxt = not useResearch ? (contextMode == "Auto Hybrid" ? "Auto: Live" : "Live") : (not canRenderResearch ? "Research unavailable: visible range not ready" : (contextMode == "Auto Hybrid" ? "Auto: Research (visible range)" : "Research: visible range"))
        color badgeCol = not useResearch ? color.new(#2a3f5f, 20) : (not canRenderResearch ? color.new(#5a4a2a, 20) : color.new(color.gray, 20))
        ctxBadge := label.new(x=bar_index, y=high, text=badgeTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=badgeCol, textcolor=color.white, size=size.small)

// ---------------------------------------------------------------------------
// ALERTS (global scope). Each is ANDed with enableAlerts and the confirmation
// gate. Messages are neutral and contain no trading directives.
// ---------------------------------------------------------------------------
bool confGate = not confirmedAlertsOnly or barstate.isconfirmed
bool alertBase = enableAlerts and confGate

alertcondition(alertBase and evNewZone, title="New reaction zone confirmed", message="New reaction zone confirmed")
alertcondition(alertBase and evUpdatedZone, title="Existing reaction zone updated", message="Existing reaction zone updated")
alertcondition(alertBase and evTouchedZone, title="Price touched an active reaction zone", message="Price touched an active reaction zone")
alertcondition(alertBase and evInactiveZone, title="Reaction zone became inactive", message="Reaction zone became inactive")
alertcondition(alertBase and evReactivated, title="Reaction zone reactivated after a confirmed reaction", message="Reaction zone reactivated after a confirmed reaction")
