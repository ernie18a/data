f_tfTag(string tf) =>
    int tfL = str.length(tf)
    string tfU = str.substring(tf, tfL - 1)
    bool tfA = tfU == "S" or tfU == "D" or tfU == "W" or tfU == "M"
    string tfN = tfA ? str.substring(tf, 0, tfL - 1) : tf
    float tfF = str.length(tfN) == 0 ? 1.0 : str.tonumber(tfN)
    int tfV = na(tfF) ? 0 : int(tfF)
    na(tfF) ? tf : tfA ? (tfU == "M" ? str.tostring(tfV) + "M" : tfU + str.tostring(tfV)) : tfV % 60 == 0 ? "H" + str.tostring(tfV / 60) : "M" + str.tostring(tfV)

