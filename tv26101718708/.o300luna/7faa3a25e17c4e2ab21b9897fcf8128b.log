f_autoMaxPivots(string tf) =>
    float secs = timeframe.in_seconds(tf)
    secs >= 2592000 ? 3000 : secs >= 604800 ? 2500 : secs >= 86400 ? 2000 : secs >= 14400 ? 1500 : secs >= 1800 ? 1000 : 600

f_autoMaxSubPivots(string tf) =>
    float secs = timeframe.in_seconds(tf)
    secs >= 604800 ? 1500 : secs >= 86400 ? 1300 : secs >= 14400 ? 1000 : secs >= 1800 ? 1200 : 400

maxPivots = autoMaxPivots ? f_autoMaxPivots(timeframe.period) : maxPivotsManual
maxSubPivots = autoMaxSubPivots ? f_autoMaxSubPivots(timeframe.period) : maxSubPivotsManual

addPivot(float price, int bar, int ptype, int pivTime) =>
    array.push(pivotPrices, price)
    array.push(pivotBars, bar)
    array.push(pivotTypes, ptype)
    array.push(pivotTimes, pivTime)
    if array.size(pivotPrices) > maxPivots
        array.shift(pivotPrices)
        array.shift(pivotBars)
        array.shift(pivotTypes)
        array.shift(pivotTimes)

if barstate.isconfirmed
    if na(lastPivotPrice)
        if not na(atr)
            lastPivotPrice := close
            lastPivotBar   := bar_index
            extremePrice   := close
            extremeBar     := bar_index
            extremeTime    := time
            pivotDir       := 0
    else
        if pivotDir >= 0
            if na(extremePrice) or high > extremePrice
                extremePrice := high
                extremeBar   := bar_index
                extremeTime  := time
        if pivotDir <= 0
            if na(extremePrice) or low < extremePrice
                extremePrice := low
                extremeBar   := bar_index
                extremeTime  := time

        if pivotDir <= 0 and (high - extremePrice) > pivotThreshold and pivotDir != 1
            addPivot(extremePrice, extremeBar, -1, extremeTime)
            lastPivotPrice := extremePrice
            lastPivotBar   := extremeBar
            pivotDir       := 1
            extremePrice   := high
            extremeBar     := bar_index
            extremeTime    := time
            proxyIsUp      := true
            proxyInvLevel  := lastPivotPrice
            proxyLastTime  := time
        else if pivotDir >= 0 and (extremePrice - low) > pivotThreshold and pivotDir != -1
            addPivot(extremePrice, extremeBar, 1, extremeTime)
            lastPivotPrice := extremePrice
            lastPivotBar   := extremeBar
            pivotDir       := -1
            extremePrice   := low
            extremeBar     := bar_index
            extremeTime    := time
            proxyIsUp      := false
            proxyInvLevel  := lastPivotPrice
            proxyLastTime  := time

