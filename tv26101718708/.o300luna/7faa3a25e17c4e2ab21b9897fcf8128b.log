f_stepAnchor(ewcore.WaveCount st, bool wantHigh) =>
    float res = st.w1s
    array<float> pts = array.from(st.w1e, st.w2e, st.w3e, st.w4e, st.w5e)
    int lim = na(st.numPoints) ? 5 : math.min(math.max(st.numPoints, 1), 5)
    for i = 0 to lim - 1
        float v = array.get(pts, i)
        if not na(v)
            res := wantHigh ? math.max(res, v) : math.min(res, v)
    res


var float[] retracementLevels = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
var float[] extensionLevels   = array.from(1.0, 1.272, 1.618, 2.0, 2.618)
var float[] timeLevels        = array.from(0.382, 0.5, 0.618, 1.0, 1.618, 2.618)
var float[] contractLevels    = array.from(0.5, 0.618, 0.786)
