var float[]  szTab = array.from(0.62, 0.85, 1.0, 1.35, 1.85)
float baseOffT = na(visRange) ? f_offAmt(labelOffsetMultTopEff, atr) : math.max(f_offAmt(labelOffsetMultTopEff, atr), visRange * minClearTop / 100.0)
float baseOffB = na(visRange) ? f_offAmt(labelOffsetMultBottomEff, atr) : math.max(f_offAmt(labelOffsetMultBottomEff, atr), visRange * minClearBottom / 100.0)
