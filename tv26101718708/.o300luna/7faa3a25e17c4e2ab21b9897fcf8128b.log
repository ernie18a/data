getATRMult() =>
    float mult = atrMultH1
    if autoAtrMult
        float tfMinutes = math.max(timeframe.in_seconds() / 60.0, 1.0)
        mult := math.min(math.max(autoAtrBase + autoAtrSlope * math.log(tfMinutes), 0.1), 5.0)
        if subH1NoiseFloor > 0.0 and timeframe.isintraday and timeframe.multiplier < 180
            mult := math.max(mult, subH1NoiseFloor)
    else if timeframe.ismonthly
        mult := atrMultMN
    else if timeframe.isweekly
        mult := atrMultW
    else if timeframe.isdaily
        mult := atrMultD
    else if timeframe.isintraday and timeframe.multiplier >= 180 and timeframe.multiplier < 1440
        mult := atrMultH4
    else if timeframe.isintraday and timeframe.multiplier >= 45 and timeframe.multiplier < 180
        mult := atrMultH1
    else if timeframe.isintraday and timeframe.multiplier < 45
        mult := atrMultM15
    mult

atr        = ta.atr(atrLen)
medTrRaw = ta.percentile_nearest_rank(ta.tr(true), atrLen, 50)
float medTrRatio    = medTrRaw > 0 ? atr / medTrRaw : 1.0
float medTrAutoRaw  = ta.sma(medTrRatio, medTrCalWin) + medTrCalK * ta.stdev(medTrRatio, medTrCalWin)
float medTrScaleEff = (not medTrAutoScale or na(medTrAutoRaw)) ? medTrScale : math.min(math.max(medTrAutoRaw, medTrScaleFloor), medTrScaleCeil)
pivotMult  = getATRMult()
pivotThreshold = (useSpikeRobustBasis ? math.min(atr, medTrRaw * medTrScaleEff) : atr) * pivotMult
rsiMomentumSeries = ta.rsi(close, rsiMomentumLength)
var int maxBarsBackSafe = 1990
float effWMomentum = useMomentumScore ? wMomentum : 0.0
float wSumRaw = wFib + wAlt + wEq + wTime + wMTF + effWMomentum
float wNorm = wSumRaw > 0 ? 1.0 / wSumRaw : 1.0

