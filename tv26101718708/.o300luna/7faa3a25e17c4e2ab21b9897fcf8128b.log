mtfOn5 = input.bool(false, "1.1.28 Target 5 on", group=grpMtfOv, inline="mtf5",
     tooltip="Master switch for target slot 5. Slots 5 and 6 offer daily and higher resolutions only and are skipped whenever the chart itself is at or above the selected level.")
mtfTf5 = input.string("D", "1.1.29 Target timeframe 5", options=["D", "2D", "3D", "W", "2W", "M", "3M", "6M", "12M"], group=grpMtfOv, inline="mtf5",
     tooltip="Fixed list: D, 2D, 3D, W, 2W, M, 3M, 6M, 12M. Unlike slots 1-4 this is not TradingView's own resolution picker, so tick and range resolutions cannot be chosen here.")
mtfOn6 = input.bool(false, "1.1.30 Target 6 on", group=grpMtfOv, inline="mtf6",
     tooltip="Master switch for target slot 6. Same restriction as slot 5.")
mtfTf6 = input.string("W", "1.1.31 Target timeframe 6", options=["D", "2D", "3D", "W", "2W", "M", "3M", "6M", "12M"], group=grpMtfOv, inline="mtf6",
     tooltip="Same fixed list as 1.1.29.")
mtfCol5 = input.color(color.yellow, "1.1.32 Colour target 5", group=grpMtfOv)
mtfCol6 = input.color(color.red, "1.1.33 Colour target 6", group=grpMtfOv)
mtfSize5 = input.string("large", "1.1.34 Label size target 5", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfSize6 = input.string("large", "1.1.35 Label size target 6", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfGuardInclude = input.bool(true, "1.1.26 Include overlay labels in the Label Collision Guard", group=grpMtfOv,
     tooltip="Hands the overlay labels to the Label Collision Guard (group 1.12) together with all native label layers, so they join the hierarchical stack above the chart's own degrees, ordered by target TF. Requires 1.12.1 to be ON. OFF leaves the overlay labels exactly where their points are.")

grpDegree = "1.2 Higher-Degree Detection"
extraCompressionLevels = input.int(3, "1.2.1 Compression levels above primary (0-3)", minval=0, maxval=3, group=grpDegree,
     tooltip="Builds up to N additional, progressively higher-degree pivot series by repeatedly compressing the previous series (zigzag-on-zigzag-on-zigzag...): a swing on level k only survives if its counter-move exceeds the significance filter below, measured against level (k-1)'s own average swing. The pattern search runs on ALL degrees (primary + each compression level). A single compression pass is often NOT enough for a large multi-month move built from hundreds of small primary pivots — that move needs several passes before it collapses into the handful of pivots a human would label by eye. Each level is far cheaper than the one below it (progressively fewer pivots), so raising this mostly costs primary-degree search time, which is unchanged.")
degree2Mult = input.float(8.0, "1.2.2 Compression significance filter (% price deviation)", minval=1.0, maxval=50.0, step=0.5, group=grpDegree,
     tooltip="A reversal on a compressed level is only confirmed once price has moved this many PERCENT away from the running extreme — the same scale-invariant deviation test standard zigzag indicators use, evaluated LOCALLY at each point rather than against a global average. This is the threshold used for the FIRST compression level (level 2); every level above it grows this value by the growth factor below.")
levelGrowthFactor = input.float(1.6, "1.2.3 Level growth factor (x per additional level)", minval=1.0, maxval=3.0, step=0.1, group=grpDegree,
     tooltip="Multiplies the significance filter at every additional compression level (level 2 uses the base %, level 3 uses base x this factor, level 4 uses base x factor^2, ...). REQUIRED for guaranteed progress: reusing the exact same percentage at every level can hit a fixed point — once a level's swings all individually already clear that percentage, compressing again with the identical threshold changes nothing (you may see identical pivot counts across consecutive levels in the 'Pivots/lvl' diagnostic — that is this fixed point, not a bug). A factor of 1.0 disables growth (legacy flat-threshold behavior); 1.4-2.0 is a reasonable range so each level meaningfully coarsens the one below it.")
autoCalibrateEnabled = input.bool(true, "1.2.4 Auto-calibrate one extra level to a target pivot count", group=grpDegree,
     tooltip="A fixed growth ladder can jump straight past the ideal window size — e.g. one level still has too many pivots for a clean 6-point Impulse/Diagonal/Triangle to end at the CURRENT price, while the next level already has too few for any pattern at all (this exact case is diagnosable in 'Pivots/lvl': a big drop with no level landing near 6-9). When enabled, ONE extra level is added above the top of the regular ladder, its significance filter found by bisection (not guessed) so its pivot count lands as close as possible to the target below — giving the search a level tuned to the exact size these patterns need.")
autoTargetPivots = input.int(7, "1.2.5 Target pivot count for auto-calibration", minval=4, maxval=15, group=grpDegree,
     tooltip="6 fits an Impulse/Diagonal/Triangle exactly; 7-9 leaves the window search a little room to also try Zigzag/Flat (4) or a Combination (7 or 9) at the same level. 7 is a reasonable default.")
rankingPriority = input.string("Degree-first (highest degree always wins)", "1.2.6 Leading scenario ranking priority",
     options=["Degree-first (highest degree always wins)", "Recency-first (classic)"], group=grpDegree,
     tooltip="Degree-first (default): a higher-degree candidate ALWAYS outranks a lower-degree one as the leading scenario, no matter how much older it is — a completed, higher-degree structure (e.g. a full multi-month impulse) is never displaced just because a smaller, more recent pattern has since formed. Recency only breaks ties WITHIN the same degree. Recency-first (classic, the original behavior): candidates whose end points differ by more than the recency band below are ordered purely by which ends more recently, regardless of degree — a small recent pattern can outrank a much larger, older, completed one. Change this if you specifically want the classic short-term-focused behavior back.")
degree2Preference = input.bool(true, "1.2.7 Prefer higher degree within recency band", group=grpDegree,
     tooltip="When candidates of different degrees end equally recently (within the recency band), the HIGHER-degree one wins — it explains strictly more of the data. Outside the band, recency still rules regardless of degree. Only used when 'Leading scenario ranking priority' below is set to 'Recency-first (classic)'.")

grpSubWave = "1.3 Sub-Wave Verification"
enableSubWaveCheck = input.bool(true, "1.3.1 Verify internal sub-wave structure", group=grpSubWave,
     tooltip="A motive leg must itself be made of 5 subwaves and a corrective leg of 3. Uses a finer pivot threshold and validates ONE degree deeper structurally: when the finer pass resolves a clean internal count, the actual impulse/corrective rules are checked on those sub-pivots (not just their number); off-count legs are scored via the '9/13/17 = motive, 7/11/15 = corrective' family guideline. Not arbitrary-depth recursion (Pine has no recursive functions).")
strictLegValidation = input.bool(true, "1.3.2 Hard-fail motive legs with contradictory sub-structure", group=grpSubWave,
     tooltip="When the finer pivot pass finds EXACTLY 4 internal turning points inside a motive leg, they are checked against the real impulse rules (sub-wave 2 <100%, sub-wave 3 beyond sub-wave 1 and not the shortest, sub-wave 4 <100%). ON: a contradiction hard-invalidates the candidate, consistent with the hard-gate philosophy. OFF: contradictions only lower the score (fallback if this proves too aggressive on noisy data). Diagonal legs are never hard-gated — diagonals are the explicit exception to the subdivision count rule.")
subWaveAtrMult = input.float(0.4, "1.3.3 Sub-wave threshold (fraction of main ATR threshold)", minval=0.05, maxval=1.0, step=0.05, group=grpSubWave,
     tooltip="Smaller = more sensitive to fine internal swings (catches more sub-structure, but more computation and noise)")
maxSubPivotsManual = input.int(1500, "1.3.4 Max. stored sub-pivots (manual)", minval=50, maxval=1500, group=grpSubWave,
     tooltip="Only used when 'Auto-scale max sub-pivots by TF' below is OFF. Larger = more history for sub-wave checks, but more computation per candidate evaluated.")
autoMaxSubPivots = input.bool(true, "1.3.5 Auto-scale max sub-pivots by timeframe", group=grpSubWave,
     tooltip="Same automatic scaling as 'Auto-scale max pivots' above, applied to the finer sub-pivot series used for leg verification. See that input's tooltip for the full explanation of what this is (and isn't) based on.")
showUnresolvedLabel = input.bool(false, "1.3.6 Mark unresolved legs with a text label", group=grpSubWave,
     tooltip="When even the multi-segment walk above can't fully resolve a leg, this shows the outer wave letter/number plus its degree — and an automatically derived FINER TF as a 'look here' hint, instead of just restating the chart's own TF.")
showUnresolvedLine = input.bool(false, "1.3.7 Show a span line under the unresolved-leg marker", group=grpSubWave,
     tooltip="Draws a plain line between the unresolved leg's own start and end pivot, same idea as the Historical Chain's gap-fallback line — but per LEG (wherever the '!' marker appears), not per whole unclassifiable stretch. Applies everywhere the '!' marker can appear: the leading scenario's own sub-waves AND the Historical Chain's sub-wave decomposition.")
wholeLegDecomp = input.bool(true, "1.3.8 Whole-leg sub-wave decomposition (target compression)", group=grpSubWave,
     tooltip="For each decomposed leg, first compress the leg's OWN pivots down to exactly the point count a single whole-leg structure needs (4 points = one three, 6 points = one five or triangle) and let the full evaluators judge that ONE candidate — so a leg reads as i-ii-iii-iv-v or a-b-c at the correct scale instead of a chain of many small fragments. Only when no whole-leg hypothesis passes does the previous multi-segment chain walk run as a fallback. Applies everywhere legs get decomposed into sub-waves: the leading scenario (all degrees) and the Historical Chain's sub-wave pass. A THIRD hypothesis (WXY combination, tried directly on the raw pivots — no fixed point count, since a combo's leg count genuinely varies) is controlled by the existing 'Check Combination W-X-Y (double three)' toggle in Pattern Detection, not a separate switch here — same global toggle already used everywhere else combos are evaluated.")
wholeLegComboTolerance = input.int(8, "1.3.9 Whole-leg WXY tolerance (legs)", minval=0, maxval=8, group=grpSubWave,
     tooltip="A whole-leg WXY candidate may fall up to this many legs short of the leg's own full requested span and still be accepted (it may never overshoot past the leg's end either way — hard constraint, not relaxed by this setting). Same tolerance philosophy as the Historical Chain's own 'WXY/WXYXZ fill tolerance', but a SEPARATE setting — this one governs the Sub-Wave/Historical/Sequel whole-leg hypothesis, a different feature from the Historical Chain's gap-fill display. A candidate accepted only within tolerance keeps its own honest (shorter) coverage rather than being padded to claim the full leg — the existing unresolved-leg marker/line covers any short remainder.")
depth2Decomp = input.bool(true, "1.3.10 Depth-2 inner-leg decomposition", group=grpSubWave,
     tooltip="After the normal per-leg decomposition, every internal leg of a FOUND sub-wave pattern that lasts at least the minimum leg duration is examined one degree further on the finest sub-pivot detector: a rule-valid pattern is drawn with its own one-degree-lower notation, otherwise the leg gets the honest '!'/'▫' marker. This finally explains long stretches INSIDE found patterns, which previously carried neither structure nor any marking (they are invisible to the DP gap markers by construction).")
showSubWaveLine = input.bool(true, "1.3.11 Show sub-wave connecting lines", group=grpSubWave,
     tooltip="T3: the decomposition connecting lines, now independent of the labels.")
subWaveMaxLegDominance = input.float(0.65, "1.3.12 Sub-wave decomposition — max single-leg time dominance", minval=0.3, maxval=0.95, step=0.05, group=grpSubWave,
     tooltip="Rejects a candidate decomposition whose single longest leg exceeds this fraction of the whole span's time — e.g. 0.65 rejects one leg eating 65%+ of the total, even if the ≥3-pivot minimum is met. Falls through to a finer degree, or the honest '!'/'▫' marker if none qualify. The same fraction also gates the RESULT of the whole-leg pre-attempt: a found single pattern whose own longest internal leg exceeds it is demoted, and the multi-step DP search runs on the finer pivots instead. 0.95 ≈ near-off. Provisional — not yet empirically validated.")
enableExtensionFamily = input.bool(true, "1.3.13 Recognize extension family (9-/13-/17-wave)", group=grpSubWave,
     tooltip="On a motive leg with 8, 12 or 16 internal sub-pivots, tries to confirm a genuine Elliott Wave extension (one actionary sub-wave elongated ~1.618x+ over the other two, structurally verified) rather than assuming it from the point count alone. Turn OFF to isolate this specific check while troubleshooting compile/runtime issues — the rest of sub-wave verification (1.3.1) keeps working independently.")
extScoreMargin = input.float(4.0, "1.3.14 Extension must beat the plain five by (score points)", minval=0.0, maxval=40.0, step=1.0, group=grpSubWave,
     tooltip="Before a wave may be marked as an extension, meaning 9, 13 or 17 waves, its hypothesis must score at least this many points HIGHER than the ordinary five-wave reading of the same leg. Higher = stricter, fewer markers, but the ones you get mean more; 0 = accept any extension that merely ties. CALIBRATION: 9 was tested against annotated H1 charts and judged good there; the default 4 is deliberately looser and stays adjustable, because it is still OPEN whether the best value depends on the TF. Calibrate against your own annotated charts: raise it while extensions appear where you would not count one, lower it if a genuine extension you can see stays unmarked. This affects only the marker; the wave label and count are unchanged either way.")
ruleAwareCompress = input.bool(true, "1.3.15 Rule-aware skeleton selection", group=grpSubWave,
     tooltip="How the engine picks the six turning points that represent a long leg as a five-wave skeleton. OFF is the historical behaviour: repeatedly drop the smallest swing pair until six points remain — a pure size criterion that knows nothing about Elliott rules, which is why the two biggest swings tend to end up as waves 1 and 5 and wave 3 is left as the shortest, the one thing an impulse may not do. ON keeps that cheap thinning while the leg is still large, where it only removes noise, and enumerates the final removals instead, scoring each resulting skeleton against the impulse rules and keeping the best. Roughly 35 skeletons are examined per leg. HONEST LIMITS: this cannot conjure an impulse out of a leg that has none, and a clean result only means a rule-conforming reading EXISTS, not that it is the true count. If it finds nothing usable it falls back to the old method, so it can never make a leg worse. Use diagnostic 1.6.15 to compare: Fr2 codes should become rarer with this on.")
extMinRawPerWave = input.float(4.0, "1.3.16 Extension needs raw sub-pivots per sub-wave", minval=0.0, maxval=20.0, step=0.5, group=grpSubWave,
     tooltip="An extension claims that a leg subdivides into 9, 13 or 17 waves instead of 5. This setting demands that the leg actually carry enough detected turning points underneath to support that claim: at least this many RAW sub-pivots for every sub-wave asserted. At 4, a nine-wave needs 36 raw sub-pivots, a thirteen 52 and a seventeen 68. 0 switches the gate off. WHY IT EXISTS: the deeper the hypothesis, the more points the compression keeps and the more closely it hugs ordinary noise — on the same leg a seventeen discards a third fewer points than a five, so it fits almost too easily on a short leg. SCOPE: this applies only where a leg has to be compressed to fit a hypothesis. Legs whose sub-pivot count already matches a pattern exactly are untouched, because there the sub-pivots ARE the sub-waves. THE DEFAULT IS A CONSERVATIVE GUESS, NOT A VALIDATED NUMBER — calibrate it against your own annotated charts. It gates the marker only, never the wave label or the count.")

grpParent = "1.4 Parent-Timeframe Context Gate"
parentGateMode = input.string("Soft (score malus)", "1.4.1 Enforcement", options=["Off", "Soft (score malus)", "Hard (discard)"], group=grpParent,
     tooltip="Imports this SAME script's own leading-scenario result from a higher (parent) TF via request.security, and checks every candidate found on THIS chart against it: (1) TIME — a candidate's own P0 may not lie materially before the parent's last confirmed turning point (that territory already belongs to the parent's completed structure); (2) DIRECTION — none of a candidate's own key points may sit on the wrong side of the parent's invalidation level (that would contradict the parent's own count by definition). 'Off' disables the check entirely (candidates scored purely on their own merits, as before this feature). 'Soft' subtracts a score penalty from violating candidates but still allows them to win if nothing else clears the score threshold. 'Hard' removes violating candidates from consideration outright — with an automatic, flagged fallback to the unfiltered set for THIS bar only if that would leave zero candidates, so the indicator never silently goes blank.")
autoParentTF = input.bool(true, "1.4.2 Automatic parent timeframe (standard cascade)", group=grpParent,
     tooltip="Walks the standard cascade 1M > 1W > 1D > 4H > 1H > 30m > 15m > 5m > 1m and picks the next-larger step above the CHART's own TF automatically (e.g. chart=15m -> parent=30m, chart=4H -> parent=1D). Turn off to choose the parent TF yourself below.")
parentCascadeShift = input.int(0, "1.4.3 Cascade shift (steps up/down from chart TF)", minval=-4, maxval=3, group=grpParent,
     tooltip="Hybrid mode: keeps the automatic cascade (so it still moves correctly when you change the chart's own TF), but lets you push the result further up OR down the ladder 1M > 1W > 1D > 4H > 1H > 30m > 15m > 5m. POSITIVE (this was the only direction before this request): further up = a COARSER parent context. 0 = one step up (original behavior, e.g. chart=4H -> parent=1D). 1 = two steps up (e.g. chart=4H -> parent=1W). NEGATIVE (this request, feasibility-checked and added): steps DOWN the same cascade instead — turns this into a CHILD-TF context gate (checks the current chart's candidates against a FINER, already-more-detailed structure instead of a coarser one). Exactly how far negative is useful depends on the chart's own TF — the cascade array is bounds-checked at BOTH ends, so any shift landing outside the ladder (below 5m, above 1M, or exactly back at the chart's own bucket) safely disables the gate for that bar (falls back to 'no valid parent/child TF found') rather than erroring. Only used while Automatic parent TF above is on.")
manualParentTF = input.timeframe("60", "1.4.4 Manual parent timeframe (used if automatic is off)", group=grpParent,
     tooltip="Only used when 'Automatic parent TF' above is off. Must be strictly HIGHER than the chart's own TF to mean anything as a parent context.")
parentTimeToleranceBars = input.int(1, "1.4.5 Time-gate tolerance (parent-TF bars)", minval=0, maxval=10, group=grpParent,
     tooltip="Small slack on the TIME check, in units of PARENT-TF bars, to absorb the normal few-bar fuzz between where the parent's compression/detector places its last pivot and where the child's own detector places P0. 0 = no slack (strict). Does not affect the DIRECTION check.")
parentGateMalus = input.float(30.0, "1.4.6 Soft-mode score penalty", minval=0.0, maxval=1000.0, step=10.0, group=grpParent,
     tooltip="Only used in 'Soft' enforcement: subtracted from a violating candidate's score before ranking (never below 0). It stays eligible — a large enough penalty just makes it lose to any parent-consistent alternative that also cleared the minimum score threshold, without disappearing from the alternatives table.")
showParentInfo = input.bool(true, "1.4.7 Show parent-TF state in status table", group=grpParent,
     tooltip="Adds a row to the status table showing the imported parent TF, its leading pattern's direction/degree, and whether the gate is currently active, in fallback, or found no parent candidate.")

grpPerf = "1.5 Performance Safety (Historical Chain)"
autoLimitHistoryChain = input.bool(true, "1.5.1 Auto-limit historical chain range (performance safety)", group=grpPerf,
     tooltip="When ON, the pivot range fed into the historical-chain DP (f_chainBestPath) is automatically capped BEFORE it runs, using the budget below — trading a bit of the OLDEST chain coverage for a guaranteed margin under TradingView's loop-time ceiling, instead of running right up against it until it eventually fails on some future bar. The cap only ever moves the OLDER boundary forward; the most recent history (closest to current price) is never touched. When OFF: no cap, full stored range every time — same risk this fix addresses, useful only to confirm this mechanism is what's limiting your visible history if you want to compare.")
historyChainSafetyBudget = input.int(2400, "1.5.2 Complexity budget (pivots x pattern-type units)", minval=200, maxval=20000, step=100, group=grpPerf,
     tooltip="Only used while auto-limit above is ON. Effective pivot-range cap = this budget / weighted count of the pattern types enabled in the Pattern Detection group (Impulse/Diagonal/Zigzag-Flat/Triangle = 1 unit each, Combination WXY = 2, Combination WXYXZ = 3 — combos scan more legs per position, so they cost proportionally more). Adapts automatically: fewer/cheaper enabled types -> larger safe range; more/costlier types -> smaller range, same margin under the ceiling either way — no manual per-chart retuning needed when you toggle pattern types. CONSERVATIVE STARTING POINT (researched platform limit, not a locally benchmarked one — actual per-call cost varies with server load and instrument): raise this if you have headroom and want deeper historical chain coverage; lower it if 'Loop takes too long' still appears with default settings.")

grpVis = "1.6 Visualization: Wave Labels"
showLabelText = input.bool(true, "1.6.2 Show label text (1-5 / A-E / etc.)", group=grpVis)
showActiveDegreeLabel = input.bool(false, "1.6.3 Show degree label at P0 of active pattern", group=grpVis)
labelOffsetUnit = input.string("x ATR", "1.6.4 Label distance unit", options=["x ATR","ticks","% of price","% of pattern range"], group=grpVis,
     tooltip="Unit for the two distance values below and for every other distance input marked 'unit: 1.6.4'. 'x ATR' scales with the chart's own candle size, so the visible gap between a label and its candle stays comparable across TFs. '% of pattern range' scales with the LEADING pattern's own price span instead: a small TF often carries a far larger leading structure, so the same number can push labels dramatically further from the candles there (the measured cause of the TF-dependent label drift this default change fixes; saved charts keep their stored unit). 'ticks' and '% of price' are absolute alternatives independent of both.")
labelOffsetMultTop = input.float(1.2, "1.6.5 Label distance value — labels ABOVE (high pivots)", minval=0, maxval=500, step=0.05, group=grpVis,
     tooltip="Base distance between a candle's extreme and the innermost label of the stack ABOVE high pivots, in the unit set by 1.6.4. Every label layer measures from this one value; the Label Collision Guard (1.12) stacks the further layers outward from it.")
labelOffsetMultBottom = input.float(1.6, "1.6.6 Label distance value — labels BELOW (low pivots)", minval=0, maxval=500, step=0.05, group=grpVis,
     tooltip="Base distance between a candle's extreme and the innermost label of the stack BELOW low pivots, in the unit set by 1.6.4.")
showSubWaveLabels = input.bool(true, "1.6.7 Label sub-waves inside the leading pattern", group=grpVis,
     tooltip="Sub-wave decomposition labels (and their connecting lines) inside the LEADING pattern's own legs. This switch governs the leading scenario only, exactly as titled — the Historical Chain's own sub-wave decomposition has its separate switch 1.7.10. Previously this one switch silently controlled both, and even changed the Historical Chain's parent-label distances as a side effect.")
subLabelMinHours = input.float(8.0, "1.6.8 Min. leg duration for sub-wave labels (hours)", minval=0.0, maxval=5000.0, step=1.0, group=grpVis)
subDetail = input.string("coarse", "1.6.9 Sub-wave detail level", options=["off","coarse","full"], group=grpVis,
     tooltip="How finely legs are broken down into sub-waves, independent of every duration setting. FULL: when a leg cannot be read as ONE single pattern, it is split into a CHAIN of several patterns, each carrying its own set of labels - which is why one long leg can end up holding a dozen labels of the same degree. COARSE draws only what resolves as a single pattern for the whole leg; where that fails the leg stays unlabelled and, with 1.3.6 on, carries the honest ! marker instead. OFF suppresses sub-wave labels altogether, on the leading scenario and on the historical chain alike - the same effect as switching 1.6.7 and 1.7.10 off together. All three levels apply to both layers. This is the direct lever for label density. The minimum leg duration (1.6.8 while 1.13.1 is off, or 1.13.2 while it is on) cannot do this job: it is an all-or-nothing gate per leg and only decides WHETHER a leg is decomposed, never whether one clean decomposition or a chain of five is drawn.")
showFinalSubWavePoint = input.bool(true, "1.6.10 Show final sub-wave point (stacked on main label)", group=grpVis,
     tooltip="Draws the final turning point of each sub-wave pattern as its own label, stacked on the main label that already sits on that pivot. OFF keeps the pivot clean. Covers both layers: the per-leg sub-waves and the depth-2 inner legs of 1.3.10.")
tagLeadT = input.bool(true, "1.6.11 Leading-scenario tag: show timeframe", group=grpVis,
     tooltip="Puts the TF into the tag of this label type, in the short form M5 / M90 / H1 / H4 / D1 / W1 / 1M - minutes and hours carry the unit in front, calendar months behind it, so M1 is one minute and 1M is one month. That is the chart TF here, identical for every layer of the chart itself - so on its own it does not tell the leading scenario apart from a chain label; the degree does that. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. The size is shared across all types (1.6.19); fading and distance are fixed.")
tagLeadD = input.bool(false, "1.6.12 Leading-scenario tag: show degree", group=grpVis,
     tooltip="Puts the Elliott degree name into the tag of this label type - Subminuette, Minuette, Micro and so on. For the leading scenario that is the degree the current top-level count is drawn at. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. With both on, the two are separated by a middle dot, which is the widest form.")
tagSubT = input.bool(true, "1.6.13 Sub-wave tag: show timeframe", group=grpVis,
     tooltip="Puts the TF into the tag of this label type, in the short form M5 / M90 / H1 / H4 / D1 / W1 / 1M - minutes and hours carry the unit in front, calendar months behind it, so M1 is one minute and 1M is one month. That is the chart TF here. Sub-waves are the layer that produces the most labels, so weigh every extra character twice. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. The size is shared across all types (1.6.19); fading and distance are fixed.")
tagSubD = input.bool(false, "1.6.14 Sub-wave tag: show degree", group=grpVis,
     tooltip="Puts the Elliott degree name into the tag of this label type - Subminuette, Minuette, Micro and so on. For sub-waves that is the degree of the sub-wave level itself, one or more steps below the pattern that contains them - this is the switch that tells a sub-wave apart from the wave above it. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. With both on, the two are separated by a middle dot, which is the widest form.")
tagHistT = input.bool(false, "1.6.15 Historical-chain tag: show timeframe", group=grpVis,
     tooltip="Puts the TF into the tag of this label type, in the short form M5 / M90 / H1 / H4 / D1 / W1 / 1M - minutes and hours carry the unit in front, calendar months behind it, so M1 is one minute and 1M is one month. That is the chart TF here. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. The size is shared across all types (1.6.19); fading and distance are fixed.")
tagHistD = input.bool(false, "1.6.16 Historical-chain tag: show degree", group=grpVis,
     tooltip="Puts the Elliott degree name into the tag of this label type - Subminuette, Minuette, Micro and so on. The Historical Chain always counts at degree 1, so this is what tells a historical label apart from a leading-scenario label carrying the identical notation. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. With both on, the two are separated by a middle dot, which is the widest form.")
tagSeqT = input.bool(true, "1.6.17 Sequel-chain tag: show timeframe", group=grpVis,
     tooltip="Puts the TF into the tag of this label type, in the short form M5 / M90 / H1 / H4 / D1 / W1 / 1M - minutes and hours carry the unit in front, calendar months behind it, so M1 is one minute and 1M is one month. That is the chart TF here. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. The size is shared across all types (1.6.19); fading and distance are fixed.")
tagSeqD = input.bool(false, "1.6.18 Sequel-chain tag: show degree", group=grpVis,
     tooltip="Puts the Elliott degree name into the tag of this label type - Subminuette, Minuette, Micro and so on. The Sequel Chain counts at the degree of the leading scenario it continues, so its labels can read exactly like the leading scenario - this is what separates them. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. With both on, the two are separated by a middle dot, which is the widest form.")
tagSize = input.string("small", "1.6.19 Label tag size", options=["tiny","small","normal","large","huge"], group=grpVis,
     tooltip="The size every tag is drawn at, across all label layers. Absolute, not relative to the label it belongs to: the wave labels themselves differ in size from layer to layer (3.3.3, 3.3.4, 1.1.14 and so on), and a tag that inherited that would come out in three different sizes on one chart. Pine offers five classes, tiny through huge, applied identically to all of them.")
showExtensionMarker = input.bool(true, "1.6.20 Mark extended waves on the label", group=grpVis,
     tooltip="Appends a superscript wave count to a wave's label when it is confirmed as an Elliott extension: 9 for a nine-wave extension, 13 for an extension within an extension, 17 for the third nesting level. The label's tooltip then names which sub-wave carries the elongation. The marker inherits the label's own size and colour (a Pine label carries one size and one colour for its whole text). Applies to the Leading Scenario and to all chain steps. Detection itself is controlled by 1.3.13.")

grpHist = "1.7 Visualization: Historical Chain (Pre)"
showHistoryChain = input.bool(true, "1.7.1 Show historical wave chain", group=grpHist,
     tooltip="Recomputed from scratch on every update using current rules — not a frozen archive, so past segments update if the best interpretation changes")
showHistoryPreChain = input.bool(false, "1.7.2 Show chain BEFORE the leading scenario", group=grpHist,
     tooltip="When OFF, the historical chain's PRE part (everything older than the leading scenario's P0) is hidden — no dimmed labels, no lines, no gap markers or raw counts in that region — while the POST part (after the leading scenario, up to the most recent pivot) stays fully visible. Useful to declutter the chart down to 'leading scenario and everything after it'. When no leading scenario exists at all, this switch is ignored (there is no 'before' without a leading scenario) and the full chain shows as usual. Requires the master toggle above to be ON.")
historyGapMinSpan = input.int(3, "1.7.5 Minimum gap size for the real-fit search (pivots)", minval=2, maxval=20, group=grpHist,
     tooltip="Only a stretch of at least this many consecutive unclassified pivots is handed to the real-fit search (2.8.1 / 2.8.2). Shorter stretches are left alone.")
showHistorySubWaves = input.bool(true, "1.7.10 Label sub-waves inside historical chain patterns", group=grpHist,
     tooltip="Sub-wave decomposition (labels, connecting lines and unresolved markers) inside the Historical Chain's own segments. 1.6.7 covers the leading pattern, this switch the Historical Chain.")

grpSequel = "1.8 Visualization: Sequel Chain (After)"
showSequelChain = input.bool(true, "1.8.1 Show sequel scenario chain (continues leading scenario, same degree)", group=grpSequel,
     tooltip="Continues the count RIGHT AFTER the leading scenario ends, on the SAME degree (unlike the historical chain, which only ever uses degree 1) — chained forward (sequel of the sequel...) until no more valid pattern is found or the most recent pivot at that degree is reached. Rendered with the same full-prominence label style as the leading scenario itself, so it reads as a seamless continuation rather than a dimmed footnote. Only active when the leading scenario is degree 2 or higher.")

grpExplain = "1.9 Visualization: Pattern Explanation"
showExplanation = input.bool(true, "1.9.1 Show explanation for leading scenario", group=grpExplain,
     tooltip="A short plain-text rationale for why this segment was classified as its pattern type")
effShowHistExplBase = input.bool(true, "1.9.2 Show explanation for EACH historical segment", group=grpExplain,
     tooltip="Can add significant visual clutter with many historical segments — turn off if it gets crowded")
showSubWaveExplanation = input.bool(true, "1.9.3 Show explanation for EACH sub-wave segment", group=grpExplain,
     tooltip="Same 'i' marker + hover explanation as the Historical Chain, but for each resolved sub-wave segment inside the active leading pattern's own legs.")
pinExplanationPanel = input.bool(false, "1.9.4 Pin explanation as static panel (no hover needed)", group=grpExplain,
     tooltip="The hover tooltip is a native TradingView UI feature and cannot be forced to stay open by any script. This adds a fixed on-chart panel showing the same leading-scenario explanation text at all times instead — independent of the 'i' marker toggle above, so you can use either, both, or neither.")
pinExplanationPosition = input.string("bottom_center", "1.9.5 Static panel position", options=["top_center","middle_left","middle_center","middle_right","bottom_center"], group=grpExplain,
     tooltip="Deliberately excludes top_left/top_right/bottom_left/bottom_right — those are already used by the Status Box, MTF Table, Score Table and Pivot Table respectively.")
pinExplanationWidth = input.int(28, "1.9.6 Static panel width (% of chart)", minval=10, maxval=60, group=grpExplain,
     tooltip="Outer size cap for the panel table itself. Actual line-wrapping is done manually by the script (see 'Static panel line length' below) — width alone does NOT reliably wrap long real-world sentences in Pine's table cells, which is what caused the left/right cut-off Wick-Sniper reported.")
pinExplanationWrapChars = input.int(48, "1.9.7 Static panel line length (characters)", minval=20, maxval=120, group=grpExplain,
     tooltip="BUGFIX (this request — panel text was running off both chart edges instead of wrapping): table.cell()'s width= parameter turned out to only cap the CELL's outer box, not reliably force-wrap long unbroken paragraphs inside it — TradingView still rendered the full sentence as one over-long line that got clipped by the chart pane's edges on both sides. Fix: the script now inserts its own line breaks at word boundaries, so wrapping no longer depends on that unreliable auto-wrap at all. This value is the target character count per line — lower it for a narrower panel/larger text size, raise it for a wider panel/smaller text size. ~45-55 is a good starting point for 'normal' text size at the default 28% width.")
pinExplanationSource = input.string("Leading scenario", "1.9.8 Static panel source", options=["Leading scenario","Historical segment","Sub-wave segment"], group=grpExplain,
     tooltip="Which explanation the static panel from 1.9.4 shows. 'Leading scenario' is the previous and default behaviour. The other two options let you read the explanation of a Historical Chain segment (1.9.2) or of a sub-wave segment (1.9.3) without hovering that segment's own 'i' marker — pick WHICH segment with 1.9.9 below. Only one text can be pinned at a time: the panel is a single cell, and every segment at once would bury the chart under text. Note this is a setting, not a click on the marker — Pine cannot detect clicks on chart objects at all, so hovering and this panel are the only two ways to surface the text.")
pinExplanationSegmentIdx = input.int(0, "1.9.9 Static panel segment # (0 = newest)", minval=0, maxval=200, group=grpExplain,
     tooltip="Selects WHICH segment the panel shows while 1.9.8 is set to 'Historical segment' or 'Sub-wave segment'. 0 is the most recent one, 1 the one before it, and so on — count up to page backwards through the chart. Ignored when the source is 'Leading scenario'. Set it higher than the number of segments available and the panel clamps to the oldest one; the last line of the panel always states which segment you are looking at and what the valid range is.")

grpLines = "1.10 Visualization: Lines & Zones"
showPrimaryZigzag = input.bool(false, "1.10.1 Show primary zigzag line", group=grpLines,
     tooltip="T1: the base pivot-to-pivot line, incl. the routed fine-path variant.")
showLeadingOverlayLine = input.bool(true, "1.10.2 Show leading-scenario overlay line", group=grpLines,
     tooltip="T2: the emphasized line over the leading scenario's key points.")
showInvalidationLine = input.bool(false, "1.10.3 Show invalidation line and dot", group=grpLines,
     tooltip="T4: invalidation level line and info dot; the LABEL has its own toggle above.")
showDateMarkers = input.bool(false, "1.10.4 Show date-marker lines and labels", group=grpLines,
     tooltip="T5: all vertical date-marker lines and their labels. OFF hides markers only — anchors and window keep working.")
routeLegsThroughSub = input.bool(true, "1.10.5 Route long legs through fine sub-pivots (visual)", group=grpLines,
     tooltip="A long atomic leg (steep one-way move whose interior counter-moves never exceeded the pivot threshold) is drawn as a polyline following the finer sub-detector pivots inside it, instead of one straight line cutting across the visible price path. Applies only to legs long enough for sub-wave treatment (same minimum duration as sub-wave labels); purely visual — detection, counting and labels are completely unaffected. Turn off for the classic straight pivot-to-pivot line.")
invalidationRightOffset = input.int(10, "1.10.6 Invalidation line/marker distance from last bar (bars)", minval=1, maxval=200, group=grpLines,
     tooltip="How far to the right of the last bar the invalidation line's end, its info-dot, and its price label sit. The dot always sits 1 bar past the line's end; the price label 12 bars further right than the dot (kept proportional to whatever you set here) so the three never overlap.")
showInvalidationLabel = input.bool(false, "1.10.7 Show invalidation label (price + reason)", group=grpLines,
     tooltip="A pill label at the invalidation line's right end stating the exact price AND why breaching it negates the current leading scenario (which rule/point it's measured from).")

grpProj = "1.11 Forward Projection"
showProjection = input.bool(false, "1.11.1 Show projected continuation (dashed)", group=grpProj,
     tooltip="Draw a dashed forward projection of where the pattern would likely go next if the leading scenario continues to play out.")
projectedTargetScaleFactor = input.float(1.0, "1.11.2 Projected target distance scale", minval=0.1, maxval=3.0, step=0.1, group=grpProj,
     tooltip="Multiplies the projected Fibonacci distances (retrace depth of the next corrective wave and extension of the final wave). 1.0 keeps the standard projection.")
showProjectionConfluence = input.bool(false, "1.11.3 Show Wave 5 target as a confluence zone (multiple methods)", group=grpProj,
     tooltip="Computes the Wave 5 target 3 independent ways (theory-conditional ratio, simple equality with Wave 1, 1.618x extension) and draws the zone where 2+ of them agree within the tolerance below, instead of a single blended point. When only 1 method applies, the zone shrinks to that single estimate and the label says so explicitly — never overstates agreement that isn't there.")
confluenceBandAtr = input.float(0.5, "1.11.4 Confluence tolerance band (x ATR)", minval=0.05, maxval=5.0, step=0.05, group=grpProj,
     tooltip="How close two independent Wave 5 target methods must land to each other (in ATR) to count as agreeing/confluent.")
enableAutoProjScale = input.bool(true, "1.11.5 Auto-adapt distance scale on overshoot", group=grpProj,
     tooltip="If price on a CLOSED bar already exceeds the projected Wave 4 retracement zone or the Wave 5 target, the effective distance scale (1.11.2) is recalculated so the zone reaches exactly to that price — checked independently for Wave 4 and Wave 5. Only ever increases the effective scale (never below the 1.11.2 value you set), only evaluated once a candle closes (no intrabar flicker), and resets back to your manual 1.11.2 value as soon as a new pivot confirms (new developing structure). Capped at 3.0, same as 1.11.2.")

grpCollision = "1.12 Label Collision Guard"
showCollisionGuard = input.bool(true, "1.12.1 Resolve remaining label overlaps (all layers)", group=grpCollision,
     tooltip="Places every label layer in one hierarchical stack per turning point instead of patching overlaps afterwards: the smallest degree sits closest to the candle (at the base distance 1.6.5/1.6.6), each higher degree one step further out, mirrored below the bars. MTF overlay labels stack above the chart's own degrees, ordered by target TF; info labels (explanations, unresolved markers, degree tag) form the outermost layer. Labels whose points fall within the horizontal window below share one stack, measured from the outermost of the involved pivots, and each label keeps its own time position. Step height is the minimum gap below times the label's line count, scaled by its size class; the air between stacked labels is set by 1.12.4, with per-tier fine-tuning in 1.12.5-1.12.8. Fibonacci target-zone labels keep their price positions; the stack steps over them. The invalidation label slides horizontally along its line instead. Positions are recomputed from scratch on every chart update. Switch this off to place all labels at the base distance without stacking.")
collisionMinGapAtr = input.float(0.9, "1.12.2 Minimum vertical gap between labels (x ATR)", minval=0.1, maxval=5.0, step=0.1, group=grpCollision,
     tooltip="The stack's step height per text line at NORMAL label size. Each label occupies its line count times this value, scaled by its own size class (tiny 0.62, small 0.85, normal 1.0, large 1.35, huge 1.85) - a large or huge label needs visibly more room than a small one, which a Pine script cannot measure directly. Also the clearance kept around the fixed Fibonacci target-zone labels and by the invalidation label. UNIT: deliberately real ATR here and NOT governed by 1.6.4 — the visual height of label text scales with the chart's candle scale, which ATR tracks. Only used while 1.12.1 is ON.")
collisionBars = input.int(1, "1.12.3 Horizontal collision window (bars)", minval=0, maxval=10, group=grpCollision,
     tooltip="Labels within this many bars of each other share one stack. This is a proxy for the rendered text WIDTH, which a Pine script cannot measure (it depends on the user's zoom level and text size). 0 = only labels on the exact same timestamp stack; raise it if side-by-side labels still visually touch on your typical zoom. Only used while 1.12.1 is ON.")
stackClearance = input.float(0.3, "1.12.4 Clearance between stacked labels (x step height)", minval=0.0, maxval=3.0, step=0.05, group=grpCollision,
     tooltip="Air between two labels of the SAME stack, as a multiple of the step height (1.12.2 / 1.13.5). 0 places every label directly on top of the one below it, edge to edge. This value is NOT measured against the candle: the distance between a candle and the innermost label of the stack stays 1.6.5 / 1.6.6. Raising it pushes the whole stack outward without ever changing the order. Only used while 1.12.1 is ON.")
clearanceSub = input.float(0.0, "1.12.5 Extra clearance after the sub-wave tier (x step height)", minval=0.0, maxval=3.0, step=0.05, group=grpCollision,
     tooltip="Added on top of 1.12.4 after the innermost tier - sub-wave labels, combination-interior labels, the historical chain's own sub-waves and the depth-2 decomposition. Use it to separate the fine decomposition from the main wave labels sitting outside it. Fine-tuning only: it can never reorder the stack. Only used while 1.12.1 is ON.")
clearanceMain = input.float(0.0, "1.12.6 Extra clearance after the main chain tier (x step height)", minval=0.0, maxval=3.0, step=0.05, group=grpCollision,
     tooltip="Added on top of 1.12.4 after the main wave labels - leading scenario, sequel chain and historical chain, which all share one tier because they are one degree class. Only used while 1.12.1 is ON.")
clearanceOverlay = input.float(0.0, "1.12.7 Extra clearance after each overlay tier (x step height)", minval=0.0, maxval=3.0, step=0.05, group=grpCollision,
     tooltip="Added on top of 1.12.4 after EACH active MTF overlay slot, so several overlaid TFs can be told apart at a glance. Applies per slot, not once for the whole overlay block. Only used while 1.12.1 is ON.")
clearanceInfo = input.float(0.0, "1.12.8 Extra clearance after the info tier (x step height)", minval=0.0, maxval=3.0, step=0.05, group=grpCollision,
     tooltip="Added on top of 1.12.4 after the outermost tier - explanation markers, unresolved/bridge markers and the degree tag. Since this tier sits outside everything else, raising it mostly adds air above the whole stack. Only used while 1.12.1 is ON.")
minClearTop = input.float(5.0, "1.12.9 Minimum clearance above the candle (% of visible price range)", minval=0.0, maxval=10.0, step=0.05, group=grpCollision,
     tooltip="A floor for the distance between a label and its own pivot, measured as a percent of the price range currently visible on screen - and therefore the same optical distance at every zoom level. It is a MINIMUM, never a reduction: the label is pushed out to whichever is larger, this value or the distance from 1.6.4/1.6.5/1.6.6. Its purpose is to let you turn 1.6.5 and 1.6.6 down to 0 without labels ever touching a wick. That combination is the zoom-stable setup: the ATR-based distance of 1.6.4 is a fixed PRICE amount, so it occupies more and more pixels as you zoom in and collapses onto the candles as you zoom out, while this value keeps the same optical gap throughout. 0 disables the floor. Applies to every label layer, including the MTF overlay, where the effect is largest on high TFs because the ATR distance grows with the candle size.")
minClearBottom = input.float(9.0, "1.12.10 Minimum clearance below the candle (% of visible price range)", minval=0.0, maxval=10.0, step=0.05, group=grpCollision,
     tooltip="The same floor as 1.12.9, applied to labels below their pivot. Kept separate because a chart is rarely symmetric: price axis labels, the status table and the data window crowd the upper half, so the two sides usually want different values. 0 disables the floor on this side.")

grpAuto = "1.13 Automation (Zoom & Density)"
autoSubLegDur = input.bool(true, "1.13.1 Auto minimum leg duration for sub-wave labels (bars)", group=grpAuto,
     tooltip="When ON, the minimum leg duration for sub-wave labels is measured in BARS (value below) instead of the fixed hours of 1.6.8 - the same visual density on every chart TF. Rationale: 1.6.8 is defined in hours although its intent is chart-invariant, so its default of 8 h means 32 bars on M15 (almost everything suppressed) but a third of a bar on D1 (nothing suppressed). Turn OFF to use 1.6.8 unchanged.")
autoSubLegBars = input.int(150, "1.13.2 Auto minimum leg duration — bars", minval=0, maxval=5000, group=grpAuto,
     tooltip="Only used while 1.13.1 is ON. A leg must span at least this many bars of the current chart TF before it gets sub-wave labels. 8 bars reproduces the previous 8-hour default exactly on H1. 0 labels every leg.")
zoomDistUnit = input.bool(false, "1.13.3 Zoom-based label distances (% of visible price range, overrides 1.6.4)", group=grpAuto,
     tooltip="When ON, every label-distance value in this indicator is read as PERCENT OF THE VISIBLE PRICE RANGE (highest high to lowest low of the bars currently on screen) instead of the unit chosen in 1.6.4. This is the first distance basis that actually follows what you see: ATR follows volatility, not your zoom. A distance value of 2.0 then means 2% of the visible range. The manual units of 1.6.4 remain untouched and take over again when this is OFF.")
guardZoomAuto = input.bool(true, "1.13.4 Zoom-based collision-guard gaps (overrides 1.12.2/1.12.3)", group=grpAuto,
     tooltip="When ON, the Label Collision Guard measures its minimum vertical gap as a percent of the visible price range (1.13.5) and its horizontal window as a percent of the visible time span (1.13.6), instead of the ATR- and bar-based values 1.12.2/1.12.3. Rationale: label TEXT HEIGHT on screen scales with your zoom, not with ATR - on a low-TF chart showing many days, the ATR gap collapses below one text line and labels touch although the guard did separate them. NOTE for the whole script: it reads the visible-range variables and therefore RECALCULATES whenever you zoom or pan. If that feels too slow on your setup, report it - the manual values below still work with this switch OFF, but the recalculation itself remains.")
guardZoomGapPct = input.float(2.3, "1.13.5 Auto vertical gap (% of visible price range per text line)", minval=0.1, maxval=10.0, step=0.1, group=grpAuto,
     tooltip="Only used while 1.13.4 is ON. Stack step height per text line at NORMAL label size, as a percent of the visible price range; each label's own size class scales it (tiny 0.62, small 0.85, normal 1.0, large 1.35, huge 1.85). IMPORTANT: changing a default does not change a chart that already stores its own value - reset the indicator settings or set 2.3 by hand to get the new spacing on an existing chart.")
guardZoomWinPct = input.float(1.0, "1.13.6 Auto horizontal window (% of visible time span)", minval=0.0, maxval=10.0, step=0.1, group=grpAuto,
     tooltip="Only used while 1.13.4 is ON. Two labels within this percent of the visible time span of each other count as horizontally colliding - the zoom-fast replacement for the fixed bar window 1.12.3, which underestimates wide pill boxes when many bars are on screen.")
declutterMode = input.string("off", "1.13.7 Auto-declutter (mute layers by density)", options=["off","mild","aggressive"], group=grpAuto,
     tooltip="Mutes the busiest label layers when the view gets crowded, instead of squeezing everything smaller. The density measure is the number of detected pivots (primary + sub) inside the visible window - a proxy for the label count, which is only known after drawing. Muting escalates in stages of the threshold (1.13.8): above 1x, mild mutes the per-segment sub-wave explanations (1.9.3) while aggressive also mutes the sub-wave labels (1.6.7 and 1.7.10); above 2x, both modes additionally mute the gap raw-count digits (2.8.3) and the per-segment history explanations (1.9.2). The switches keep their stored values and take over again below the threshold or at off.")
declutterThresh = input.int(150, "1.13.8 Density threshold (pivots in view)", minval=10, maxval=2000, group=grpAuto,
     tooltip="Only used while 1.13.7 is not 'off'. Muting engages while more than this many pivots are inside the visible window.")
autoSizeStep = input.bool(false, "1.13.9 Auto label size step-down when zoomed out", group=grpAuto,
     tooltip="When ON and more bars than 1.13.10 are visible, every chart-label size set in the 3.3 group is shifted ONE step smaller (huge to large, large to normal, ...). The shift is relative, so the size hierarchy you configured is preserved. Table text sizes are not touched. Pine offers five discrete sizes only, so this is a step, not a smooth scale.")
autoSizeBars = input.int(800, "1.13.10 Step-down when visible bars exceed", minval=50, maxval=20000, group=grpAuto,
     tooltip="Only used while 1.13.9 is ON. Counted from the bars actually inside the visible window, so session gaps do not inflate the count.")
zoomDrawLen = input.bool(false, "1.13.11 Zoom-based drawing lengths (overrides 1.14.3 / 1.10.6)", group=grpAuto,
     tooltip="When ON, the Fibonacci target box length (1.14.3) and the invalidation marker distance (1.10.6) are read as PERCENT OF THE VISIBLE TIME SPAN (values below) instead of fixed bar counts, so they keep their proportion at every zoom level. OFF uses the bar values unchanged. Drawing geometry only - analytic tolerances are never zoom-dependent.")
zoomBoxLenPct = input.float(5.0, "1.13.12 Target box / line length (% of visible time span)", minval=0.5, maxval=50.0, step=0.5, group=grpAuto,
     tooltip="Only used while 1.13.11 is ON. Replaces the fixed bar count of 1.14.3.")
zoomInvDistPct = input.float(15.0, "1.13.13 Invalidation marker distance (% of visible time span)", minval=1.0, maxval=80.0, step=0.5, group=grpAuto,
     tooltip="Only used while 1.13.11 is ON. Replaces the fixed bar count of 1.10.6.")
tfProfile = input.string("off", "1.13.14 Timeframe profile (overrides marked settings at runtime)", options=["off","M15 fine"], group=grpAuto,
     tooltip="When set to M15 fine, the documented low-TF recommendation set overrides these settings at runtime, stored values stay untouched: 1.2.1 to 0, 1.2.4 off, 1.2.6 Recency-first (classic), 1.2.7 off, 1.3.3 to 0.2, 1.7.10 on, label sizes 3.3.3/3.3.4/3.3.13 to tiny, label distances 1.6.5/1.6.6 to 1.0. Auto-declutter still overrides visibility on top. The values follow the advice documented 12.08.2026 - to deviate, turn the profile off and set the originals.")

grpFib = "1.14 Fibonacci Target Zones"
showFibBoxes   = input.bool(false, "1.14.1 Show Fibonacci Target Boxes (leading scenario)", group=grpFib,
     tooltip="Master switch for the whole Post-Correction Target feature — Fibonacci target boxes, their labels, AND the two reference lines (measured-leg line, projection line to the target) all already share this ONE toggle (same code block); their individual color/width/style settings below only affect appearance while this is on. There was never a separate toggle for the lines.")
confluenceTolPct = input.float(0.5, "1.14.2 Confluence Tolerance (%)", minval=0.05, maxval=5.0, step=0.05, group=grpFib,
     tooltip="How close (in %) two or more Fibonacci projections must land to each other to be merged into a single confluence zone/box.")
fibBoxExtendBars = input.int(10, "1.14.3 Target box / line length (bars to the right)", minval=1, maxval=500, group=grpFib,
     tooltip="How far the Fibonacci target boxes (and their measurement lines) extend to the right of the current bar. Was a fixed 30 — now adjustable so the box/line doesn't dominate the chart on lower TFs or fall short on higher ones.")

grpMTF = "1.15 Table Settings"
showSettingsSummary = input.bool(true, "1.15.1 Show active-settings summary row in status table", group=grpMTF,
     tooltip="A single compact line showing which key search/ranking/gate settings are currently active — Anchor mode, Ranking priority, Parent Gate mode — so you don't have to reopen the Inputs tab to remember what's on.")

showStatusBoxTable = input.bool(false, "1.15.2 Show status as a compact table instead/also", group=grpMTF,
     tooltip="Draws the leading-scenario status as a compact table anchored to the chart pane, as an alternative or addition to the floating status label. Because it is pinned to the pane rather than to a price, it never overlaps the wave labels. Moved here from the wave-label section in EWCore-2_91 so it sits with the other table settings.")

grpPivot = "2.1 Pivot Detection (ATR-adaptive)"
atrLen      = input.int(14, "2.1.1 ATR Period", minval=1, maxval=100, group=grpPivot,
     tooltip="Number of bars used to calculate the ATR (Average True Range) that drives pivot detection. Higher = smoother, fewer false pivots but slower to react; lower = more responsive but noisier.")
autoAtrMult = input.bool(true, "2.1.2 Auto-adapt ATR multiplier to chart timeframe", group=grpPivot,
     tooltip="Derives the pivot-detection ATR multiplier directly from the chart TF via a logarithmic law (base + slope × ln(TF minutes)) instead of the six fixed manual values below. The default base/slope reproduce the manual scale within ±0.06 (M15 1.30, H1 1.52, H4 1.74, D1 2.03, W 2.34, MN 2.57) and cover every in-between TF as well. Turn OFF to use the manual per-TF values below unchanged.")
autoAtrBase = input.float(0.87, "2.1.3 Auto ATR — base", minval=0.1, maxval=3.0, step=0.01, group=grpPivot,
     tooltip="Only used when auto-adapt is ON. The multiplier at a (theoretical) 1-minute chart. Raise to demand larger swings (fewer pivots) across ALL TFs equally.")
autoAtrSlope = input.float(0.159, "2.1.4 Auto ATR — slope (per ln-minute)", minval=0.0, maxval=1.0, step=0.005, group=grpPivot,
     tooltip="Only used when auto-adapt is ON. How much the multiplier grows per natural-log step of TF minutes. Raise to spread low vs. high TFs further apart; 0 makes all TFs use the base value.")
subH1NoiseFloor = input.float(1.7, "2.1.5 Intraday ATR noise floor — H1 and below (auto mode)", minval=0.0, maxval=3.0, step=0.05, group=grpPivot,
     tooltip="Minimum ATR multiplier enforced on intraday TFs BELOW 180 minutes (H1, M30, M15, ... incl. seconds) while auto-adapt is ON. Rationale: the auto log-law is calibrated for H4 and above; below that it admits sub-degree noise pivots that fragment the wave structure. Measured on XAUUSD — M15: cover 60.7% at 1.3 vs 99.8% at 1.7 (six-week Triangle only readable at 1.7, ground-truth-confirmed); H1 clean A/B: 95.1% at 1.7 vs 93.2% at 1.5. H4 is outside the boundary and its auto value 1.74 already exceeds the floor. Set 0 to disable. Ignored when auto-adapt is OFF. Note for interpretation: M1/M5 counts remain only conditionally meaningful even with the floor — reliable counting starts at M15.")
atrMultD    = input.float(2.0, "2.1.6 ATR Multiplier D1",   minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the Daily chart. A swing must move at least this many ATR units before it counts as a new pivot. Only used while 'Auto-adapt ATR multiplier' below is OFF.")
atrMultW    = input.float(2.3, "2.1.7 ATR Multiplier Weekly",  minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the Weekly chart. Only used while 'Auto-adapt ATR multiplier' below is OFF.")
atrMultMN   = input.float(2.6, "2.1.8 ATR Multiplier Monthly", minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the Monthly chart. Only used while 'Auto-adapt ATR multiplier' below is OFF.")
atrMultH4   = input.float(1.8, "2.1.9 ATR Multiplier H4",   minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the 4-Hour chart. Only used while 'Auto-adapt ATR multiplier' below is OFF.")
atrMultH1   = input.float(1.7, "2.1.10 ATR Multiplier H1",   minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the 1-Hour chart. Only used while 'Auto-adapt ATR multiplier' below is OFF. Default raised 1.5 -> 1.7 in EWCore-2_21 after the clean same-moment H1 A/B retest (Chain cover 95.1% at 1.7 vs 93.2% at 1.5) — same finding the auto-mode noise floor above encodes.")
atrMultM15  = input.float(1.7, "2.1.11 ATR Multiplier M15",  minval=0.1, step=0.1, group=grpPivot,
     tooltip="ATR multiplier for the 15-Minute chart. Only used while 'Auto-adapt ATR multiplier' below is OFF. Default raised 1.3 -> 1.7 in EWCore-2_19 after the P1 A/B test (Chain cover 60.7% at 1.3 vs 99.8% at 1.7 on XAUUSD M15, six-week Triangle ground-truth-confirmed) — same finding the auto-mode noise floor above encodes.")
useSpikeRobustBasis = input.bool(true, "2.1.12 Spike-robust threshold basis (median-TR clamp)", group=grpPivot,
     tooltip="Protects pivot detection from single news candles (CPI, NFP, ...): the classic ATR is a linear average, so ONE huge candle inflates the pivot threshold for the next 14 bars and swallows exactly the pivots of the waves that follow the spike. When ON, the threshold basis is clamped to min(ATR, median true range x scale below), so that a spike cannot run the threshold away. How often the clamp actually engages is set by 2.1.13 and 2.1.14 below; at their defaults it is about the most extreme 10% of bars. The spike candle itself still registers as a wave — it just no longer distorts the yardstick for everything after it.")
medTrScale = input.float(1.45, "2.1.13 Median-TR clamp scale", minval=1.0, maxval=3.0, step=0.05, group=grpPivot,
     tooltip="Multiplier on the median true range that forms the clamp ceiling. Lower = clamp engages earlier/more aggressively after volatility spikes (more post-spike pivots survive); higher = closer to pure-ATR behavior. Default raised 1.3 -> 1.45 in EWCore-2_93 after measuring the actual ATR/median ratio on XAUUSD (Pepperstone, 2026-07-23, five TFs): at 1.3 the clamp engaged on 26-31% of all bars on M15 through H4 and lowered the threshold by about 2.5-3% on average across every bar, which is a permanent shift rather than the rare spike correction it was designed to be. At 1.45 that falls to 10-12% engagement and 0.8-1.0% average lowering. While 2.1.14 below is ON this value only serves as the fallback until the calibration window has filled.")
medTrAutoScale = input.bool(true, "2.1.14 Auto-calibrate the clamp scale to this chart", group=grpPivot,
     tooltip="When ON, the clamp scale above is MEASURED from this chart's own recent history instead of being taken as a fixed number, and the value above is used only as a fallback until the window in 2.1.16 has filled. Why: the ratio between ATR and the median true range differs systematically from chart to chart. Measured on XAUUSD (Pepperstone, 2026-07-23), a fixed 1.3 made the clamp engage on roughly a quarter of all bars on M15 through H4 but only a tenth on Daily — the same number therefore means something different on every TF. A measured scale means the same thing everywhere: the clamp engages on roughly the most extreme 10% of bars, whichever chart you are on. Turn this OFF to go back to the fixed value above; nothing else changes.")
medTrCalK = input.float(1.2816, "2.1.15 Auto-calibration target rate (k)", minval=0.5, maxval=3.0, step=0.0001, group=grpPivot,
     tooltip="Controls how OFTEN the auto-calibrated clamp engages. 1.2816 targets the most extreme 10% of bars, 1.6449 targets 5%, 0.8416 targets 20%. Higher = engages less often, but then only on genuinely extreme volatility; lower = engages more often and more gently. Only used while 2.1.14 is ON.")
medTrCalWin = input.int(500, "2.1.16 Auto-calibration window (bars)", minval=50, maxval=1000, group=grpPivot,
     tooltip="How many bars of this chart's own history the auto-calibration measures. Longer = a steadier scale that reacts slowly when the market changes character; shorter = faster adaptation but a noisier value. Until this many bars are loaded the fixed value in 2.1.13 is used instead, so a freshly opened chart always has a working threshold. Capped at 1000 because the script's history buffer has to serve every other calculation as well. Only used while 2.1.14 is ON.")
medTrScaleFloor = input.float(1.20, "2.1.17 Auto-calibration lower bound", minval=1.0, maxval=2.0, step=0.05, group=grpPivot,
     tooltip="Safety rail: the auto-calibrated scale is never allowed BELOW this. Guards against the clamp turning hyperactive in an unusually uniform stretch, where it would hold the pivot threshold down permanently and start reporting pivots that are not really there. Measured scales on XAUUSD ranged from 1.29 (Daily) to 1.47 (H1), so this bound normally never binds — if it does, read it as a sign that something is wrong with the data rather than as a setting to tune. Only used while 2.1.14 is ON.")
medTrScaleCeil = input.float(1.60, "2.1.18 Auto-calibration upper bound", minval=1.0, maxval=3.0, step=0.05, group=grpPivot,
     tooltip="Safety rail: the auto-calibrated scale is never allowed ABOVE this. Guards against the opposite failure — in a chaotic stretch the measured scale could run so high that the clamp effectively switches itself off, at exactly the moment protection against news candles matters most. Like the lower bound it normally never binds. If this is ever set below the lower bound, the upper bound wins and the scale is pinned to it. Only used while 2.1.14 is ON.")
maxPivotsManual = input.int(1500, "2.1.19 Max. Stored Pivots (manual)", minval=8, maxval=3000, group=grpPivot,
     tooltip="Only used when 'Auto-scale max pivots by TF' below is OFF. Controls how far back the historical wave chain can reach. Larger = more history visible, but more computation per update.")
autoMaxPivots = input.bool(true, "2.1.20 Auto-scale max pivots by timeframe", group=grpPivot,
     tooltip="This request: automatically picks a pivot cap based on the chart's own TF, so switching TFs just works without hand-tuning. IMPORTANT — this is a REASONABLE DEFAULT HEURISTIC, not a TradingView-mandated number: the platform itself does not prescribe any 'correct' pivot count per TF (researched — the real technical limits are a 100,000-element array ceiling and an overall ~10MB memory/execution-time budget, both TF-agnostic; pivots are stored via bar_index arithmetic, not the [] history operator, so they are NOT bounded by max_bars_back). The scaling logic here targets a roughly sensible CALENDAR-TIME lookback per TF (less on M1, more on Daily+) within the same tested-safe range [8, 3000] the manual slider uses. Turn this off and use the manual value above for full control.")
recentSearchLimit = input.int(20, "2.1.21 Leading scenario search window (pivots)", minval=6, maxval=200, group=grpPivot,
             tooltip="The leading scenario is only searched for within this many of the MOST RECENT stored pivots, so it always reflects current price action. The historical chain still uses the full Max. Stored Pivots range.")
recencyBandPivots = input.int(3, "2.1.22 Recency band (pivots)", minval=0, maxval=20, group=grpPivot,
             tooltip="Candidates whose end points are within this many pivots of each other are treated as 'equally recent' — score decides among them. Outside this band, whichever candidate ends MORE RECENTLY always wins, regardless of score (it has already cleared the minimum score threshold). This keeps the leading scenario anchored to current price action rather than a stale-but-cleaner older pattern.")

grpPattern = "2.2 Pattern Detection"
enableImpulse  = input.bool(true, "2.2.1 Check Impulse (5-3-5-3-5)", group=grpPattern,
     tooltip="Include 5-wave Impulse patterns in the search. Disable to speed up scanning if you only care about corrective structures.")
enableImpulseRecovery = input.bool(true, "2.2.2 Recover swallowed impulse pivots (from finer series)", group=grpPattern,
     tooltip="For every 4-pivot window in the search range, additionally checks whether the stretch is really a 5-wave IMPULSE whose one internal correction never cleared the pivot threshold ('swallowed wave': e.g. a shallow wave 4 after a strong wave 3, merged into a single long leg). The missing interior high/low pair is recovered from the finer, non-repainting series one level below (the sub-pivot detector on the primary degree, the level below on compressed degrees) and the completed 6-point set must pass every hard Elliott rule via the exact same Impulse evaluator used everywhere else. Recovered candidates compete in the normal ranking, carry an 'RI' marker in their ID, and receive the score penalty below.")
recoveredPivotMalus = input.float(8.0, "2.2.3 Recovered-pivot score penalty", minval=0.0, maxval=30.0, step=1.0, group=grpPattern,
     tooltip="Subtracted from a recovered candidate's score (0-100 scale) before it competes in the ranking. Rationale: a count whose pivots ALL cleared the regular threshold is inherently better evidenced than one needing recovery — the penalty keeps a fully-regular alternative preferred when both exist, without hiding the recovered count when it is the only valid impulse reading. 0 = compete on equal terms.")
enableDiagonal = input.bool(true, "2.2.4 Check Diagonal (3-3-3-3-3, Leading/Ending)", group=grpPattern,
     tooltip="Include Leading and Ending Diagonal patterns (5-wave structures built from overlapping threes) in the search.")
enableZigzag   = input.bool(true, "2.2.5 Check Zigzag/Flat (5-3-5 / 3-3-5)", group=grpPattern,
     tooltip="Include simple 3-wave Zigzag and Flat corrections in the search.")
enableTriangle = input.bool(true, "2.2.6 Check Triangle (3-3-3-3-3, A-B-C-D-E)", group=grpPattern,
     tooltip="Include 5-legged contracting/expanding Triangle corrections (A-B-C-D-E) in the search.")
enableCombo3   = input.bool(true, "2.2.7 Check Combination W-X-Y (double three)", group=grpPattern,
     tooltip="Include W-X-Y combinations (a 'double three' — two corrective patterns joined by an X-wave) in the search.")
enableCombo5   = input.bool(true, "2.2.8 Check Combination W-X-Y-X-Z (triple three)", group=grpPattern,
     tooltip="Per EW_NEW.pdf this pattern 'may exist only in theory'; window is 12 pivots (14 if Z is a Triangle) — noticeably larger than WXY's 8/10, so re-test the compiled token count after enabling.")

grpDisc = "2.3 Detection: Window Discriminator (Chain)"
enableWindowDisc = input.bool(true, "2.3.1 Arbitrate same-window Impulse/Diagonal/Triangle", group=grpDisc,
     tooltip="When two or more of the trio pass their hard rules on the same 6-pivot window, they compete on type-separating features and only the best fit enters the chain walks. OFF restores the old parallel behavior (every hard-rule survivor competes in the DP).")
discFloorFit = input.float(0, "2.3.2 Discriminator abstain floor (0 = off)", minval=0, maxval=100, step=1, group=grpDisc,
     tooltip="If even the best-fitting of the three types scores below this on the type-separating features, the window emits NO candidate at all. DEFAULT 0 = OFF, and that default is the result of a measurement, not caution. This gate was tested by Monte Carlo over 400,000 random windows: among those that pass the impulse hard rules, the best fit falls below 46 in only 1% of cases, so the old default of 40 rejected 0.06% of valid patterns and caught nothing. No higher value rescues it either — genuine textbook impulses and rule-valid noise both sit around 74, and the best separating value anywhere on the scale would still discard about a third of all valid patterns. The reason is structural: the features are complementary, so whenever one type fits badly another fits well, and the best of the three is high for almost any input. This discriminator decides WHICH of the three types a window is, not WHETHER it is a pattern — that question is already answered by the hard rules and by the minimum score. Leave at 0 unless you are experimenting.")
discMargin = input.float(10, "2.3.3 Ambiguity margin (fit points)", minval=0, maxval=100, step=1, group=grpDisc,
     tooltip="Types within this many fit points of the window's best are treated as genuine near-ties and ALSO enter the chain walks (the DP decides). 0 = strict winner-take-window; large values approach the old parallel behavior.")
discUseSubCount = input.bool(true, "2.3.4 Use sub-structure counting (M3)", group=grpDisc,
     tooltip="Counts fine sub-pivots per leg and matches them against the 5-3-5-3-5 (Impulse) vs 3-3-3-3-3 (Diagonal/Triangle) templates — the only feature that separates the two numeral-labeled types directly. Costs extra computation; OFF redistributes its weight onto the geometric features.")

grpAnchor = "2.4 Count Anchoring"
anchorMode = input.string("prefer", "2.4.1 Require count to START at a turning point", options=["off","prefer","hard"], group=grpAnchor,
     tooltip="A wave count should BEGIN at a meaningful turning point of the preceding structure, not in the middle of a move. 'prefer': among candidates of similar recency, one whose P0 is a verified local turning point outranks one that isn't. 'hard': an anchored candidate always outranks a non-anchored one as the LEADING scenario, regardless of recency — non-anchored candidates are never deleted from the underlying search (they stay available for the alternatives table, history chain and sub-wave labels), they are just never chosen as the top pick while a genuinely anchored one exists anywhere in the search range. 'off': anchoring plays no role.")
useManualAnchor = input.bool(false, "2.4.2 MANUAL count start (reference point)", group=grpAnchor,
     tooltip="YOU pick the meaningful turning point the count should be measured from — e.g. the ATH or a major low — and the leading-scenario search only considers counts whose P0 lies AT or AFTER that moment, on both degrees. The recency search window is bypassed while active. The historical chain still covers the full stored history for context. Note: indicator settings are saved per chart, so different TFs/layouts can each keep their own anchor.")
anchorTime = input.time(timestamp("01 Jan 2026 00:00 +0000"), "2.4.3 Manual start time", group=grpAnchor, confirm=false,
     tooltip="Set via the calendar here, or remove & re-add the indicator to place it by clicking on the chart. A vertical marker shows the active anchor.")
anchorLookback = input.int(2, "2.4.4 Anchor lookback (pivots before P0)", minval=1, maxval=6, group=grpAnchor,
     tooltip="SHORT-RANGE check only: catches a count starting one pivot too late, i.e. an even more extreme point sits immediately adjacent to P0 and should have been chosen instead. NOT a trend-validity check — in a sustained trend, EVERY later wave's start is naturally less extreme than the trend's ultimate origin, so a large lookback would wrongly disqualify genuine wave 3/5/C starts (only the very first leg of a trend would ever pass). Capped at 6 for this reason; 2-3 is the sane range.")
useChainStartAnchor = input.bool(false, "2.4.5 FIXED CHAIN START (ignore older history)", group=grpAnchor,
     tooltip="Everything before the chain start time below is completely ignored by the Historical Chain: no pattern search, no gap fill, no primary zigzag line, and the Chain-cover percentage counts only from this point. Use it to cut a years-long stored history down to the range that matters for the current count. Independent of the MANUAL count start above (which steers the leading scenario, not the chain).")
chainStartAnchorTime = input.time(timestamp("01 Jan 2026 00:00 +0000"), "2.4.6 Chain start time", group=grpAnchor, confirm=false,
     tooltip="Only used while the fixed chain start above is ON. The first stored pivot at or after this moment becomes the chain's index zero. Set via the calendar; indicator settings are saved per chart, so each TF/layout can keep its own chain start.")
useChainEndAnchor = input.bool(false, "2.4.7 FIXED CHAIN END (ignore newer history)", group=grpAnchor,
     tooltip="Everything after the chain end time below is out of the Historical Chain's scope, mirror-image of the fixed chain start: no pattern search, no gap fill, no primary zigzag line, and the Chain-cover percentage counts only up to this point. Combine with the fixed chain start to measure coverage over exactly one chosen stretch (e.g. one month). If start and end are set the wrong way around, they are silently swapped (flagged '[range swapped]' in the Chain-cover row). NOTE: the Leading Scenario and Sequel Chain searches are deliberately NOT clipped by this — only the Historical Chain machinery.")
chainEndAnchorTime = input.time(timestamp("01 Jan 2026 00:00 +0000"), "2.4.8 Chain end time", group=grpAnchor, confirm=false,
     tooltip="Only used while the fixed chain end above is ON. The first stored pivot at or after this moment becomes the chain's last point.")

grpDisplayWindow = "2.5 Display Window (Focus View for Testing)"
showDisplayWindow = input.bool(false, "2.5.1 Limit display to a time window", group=grpDisplayWindow,
     tooltip="When ON, every label and line from any chain (Leading Scenario, Sub-Wave, Historical, Sequel, Fibonacci) whose own time falls outside [Window start, Window end] is deleted for this bar. The underlying detection/scoring is completely unaffected — turning this on/off never changes what the algorithm found, only what's currently visible. The primary zigzag line always stays fully visible regardless (spatial orientation); Fibonacci/projection boxes are not filtered by this toggle.")
displayWindowStart = input.time(timestamp("01 Jan 2026 00:00 +0000"), "2.5.2 Window start", group=grpDisplayWindow, confirm=false,
     tooltip="Only used while 2.5.1 is ON. Lower bound of the visible window. The two bounds are read as a pair and sorted, so entering them in the wrong order does no harm.")
displayWindowEnd = input.time(timestamp("01 Jan 2026 00:00 +0000"), "2.5.3 Window end", group=grpDisplayWindow, confirm=false,
     tooltip="Only used while 2.5.1 is ON. Upper bound of the visible window. Labels and lines outside the window are deleted for the current bar; the detection behind them is untouched.")

grpScore = "2.6 Scoring Module"
maxAlternatives  = input.int(5, "2.6.1 Max Alternative Counts", minval=1, maxval=50, group=grpScore,
     tooltip="No hard technical ceiling — the table only ever shows as many candidates as actually pass the score threshold within the search window. Above ~15-20 it becomes a full data dump rather than a quick-glance table.")
minScoreThreshold = input.float(0.0, "2.6.2 Minimum Score (optional display filter)", minval=0, maxval=100, group=grpScore,
     tooltip="This request: NO LONGER excludes candidates from the search itself — a structurally valid pattern (hardRulesPassed) is always found and shown, with its confidence Tier color (green/orange/gray) telling you how strong it is. Raise this only if you specifically want weak (gray, low-tier) candidates hidden entirely instead of shown with a warning color — default 0 shows everything that passes the hard rules, which is the right default for anyone not manually tuning this.")
enableChainGrammar = input.bool(true, "2.6.3 Chain grammar: prefer motive/corrective alternation", group=grpScore,
     tooltip="Elliott Wave theory: markets alternate between motive and corrective phases at every degree. When ON, the chain path-finder rewards transitions that ALTERNATE pattern class (motive->corrective or corrective->motive get the bonus below) and penalizes same-class transitions (corrective->corrective or motive->motive get the malus below). Effect: long runs of standalone a-b-c fragments lose against a path that expresses the same stretch as impulse+correction — or as a proper WXY/WXYXZ Combination, which exists exactly for legitimate corrective sequences and is NOT penalized internally (it is one pattern). Path preference only: the scores shown in tables/tooltips are never modified by this.")
chainGrammarBonus = input.float(6.0, "2.6.4 Grammar: alternation bonus", minval=0.0, maxval=30.0, step=1.0, group=grpScore,
     tooltip="Added to a candidate's effective score (0-100 scale, edge weight only) when its class ALTERNATES with the preceding chain segment's class. Applied before the quality-x-coverage edge weight is computed.")
chainGrammarMalus = input.float(8.0, "2.6.5 Grammar: same-class malus", minval=0.0, maxval=30.0, step=1.0, group=grpScore,
     tooltip="Subtracted from a candidate's effective score (edge weight only) when its class REPEATS the preceding chain segment's class (e.g. zigzag directly after zigzag). Does not forbid such chains — a genuinely corrective stretch can still be expressed, ideally as a Combination; this only makes the DP prefer the theory-conformant reading when a real alternative exists.")
enableComboBonus = input.bool(true, "2.6.6 WXY | WXYXZ Boni", group=grpScore,
     tooltip="A Combination (WXY/WXYXZ) trades price depth for time — low net progress per leg vs. other pattern types, so score x legsConsumed alone undervalues it. Live 2026 XAUUSD analysis shows this is COMMON in Gold, not rare. When ON, adds the bonus below to a Combination's edge weight only (never the displayed score).")
comboConsolidationBonus = input.float(10.0, "2.6.7 Combo bonus (WXY/WXYXZ)", minval=0.0, maxval=30.0, step=1.0, group=grpScore,
     tooltip="Points added to a Combination's effective score before x legsConsumed (same mechanism as the Chain Grammar bonus above) — scales with the pattern's own leg count.")
wFib   = input.float(0.30, "2.6.8 Weight: Fibonacci Conformity", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Relative weight of Fibonacci-ratio conformity in the final score. Higher = candidates with textbook Fibonacci relationships between waves are favored more strongly.")
wAlt   = input.float(0.18, "2.6.9 Weight: Structure/Alternation", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Relative weight of structural/alternation quality (e.g. Wave 2 vs Wave 4 taking different corrective forms) in the final score.")
wEq    = input.float(0.13, "2.6.10 Weight: Equality/Symmetry", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Relative weight of wave equality/symmetry (e.g. Wave 5 approximating Wave 1 in an extended move) in the final score.")
wTime  = input.float(0.13, "2.6.11 Weight: Time Consistency", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Relative weight of time-based consistency between waves in the final score.")
wMTF   = input.float(0.13, "2.6.12 Weight: MTF Coherence", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Relative weight of MTF coherence (agreement with the Parent-TF Context Gate) in the final score.")
wMomentum = input.float(0.13, "2.6.13 Weight: RSI Momentum Dominance", minval=0, maxval=1, step=0.05, group=grpScore,
     tooltip="Soft score, never gates: rewards a candidate whose Wave 3 (motive) or Wave C (corrective) carries the LARGEST RSI swing of its own structure — the standard guideline that wave 3/C is where momentum runs strongest (RSI holding an extended overbought/oversold read; C often matching or exceeding A). Neutral (50) for Triangle and Combinations, where this heuristic doesn't cleanly apply, and wherever RSI history for the relevant pivots isn't available. Defaults rebalanced with the other five weights so they still sum to ~1.0.")
useMomentumScore = input.bool(true, "2.6.14 Use RSI momentum score", group=grpScore,
     tooltip="RSI is computed INTERNALLY by this script (ta.rsi on the chart's own close price) — there is nothing to add or configure on the chart itself, no separate RSI oscillator needed. Turn this off to exclude the momentum dimension from scoring entirely (its weight is set to 0 for that bar; the other five dimensions are unaffected and simply carry the full weight).")
rsiMomentumLength = input.int(14, "2.6.15 RSI length (for momentum score)", minval=2, maxval=100, group=grpScore,
     tooltip="RSI period used for the optional momentum-dominance score component above.")

grpTolerance = "2.7 Hard-Rule Tolerance (soft-fail zone)"
tolWave2Pct = input.float(0.0, "2.7.1 Wave 2 beyond-P0 tolerance (% of Wave 1)", minval=0.0, maxval=100.0, step=0.5, group=grpTolerance,
     tooltip="Classic hard rule: Wave 2 may not retrace beyond the start of Wave 1. Default 0 = exact original boolean behavior (any breach hard-fails, unchanged). Raise this to let a breach WITHIN this % of Wave 1's length survive as valid instead of being discarded outright — it still loses a score malus (see below) proportional to how much of the tolerance band it used, so a candidate that violates by a hair only loses to a cleaner alternative rather than disappearing entirely. A breach LARGER than this tolerance still hard-fails exactly as before.")
tolWave3Pct = input.float(0.0, "2.7.2 Wave 3 strength tolerance (% of the shorter reference wave)", minval=0.0, maxval=100.0, step=0.5, group=grpTolerance,
     tooltip="Covers BOTH classic Wave-3 rules together: 'Wave 3 is never the shortest of 1/3/5' and 'Wave 3 must travel beyond the end of Wave 1'. Default 0 = exact original behavior. Raised: a shortfall within this % of Wave 1's length survives with a proportional malus instead of hard-failing.")
tolWave4Pct = input.float(0.0, "2.7.3 Wave 4 overlap-into-Wave-1 tolerance (% of Wave 1)", minval=0.0, maxval=100.0, step=0.5, group=grpTolerance,
     tooltip="Classic hard rule: Wave 4 may not enter Wave 1's price territory (impulses only — diagonals allow this by definition and are unaffected). Default 0 = exact original behavior. Raised: an overlap within this % of Wave 1's length survives with a proportional malus.")
tolCorrectiveBPct = input.float(0.0, "2.7.4 Corrective B-wave ratio ceiling tolerance (fraction above 1.5x)", minval=0.0, maxval=0.5, step=0.05, group=grpTolerance,
     tooltip="Shared ceiling used by Zigzag/Flat: Wave B may not retrace more than 1.5x of the leg it corrects. Default 0 = exact original behavior. Raised: a ratio up to (1.5 + this fraction) survives with a proportional malus instead of hard-failing. It affects Zigzag/Flat only.")
tolMaxMalus = input.float(40.0, "2.7.5 Max score malus at full tolerance", minval=0.0, maxval=100.0, step=5.0, group=grpTolerance,
     tooltip="A rule that just barely uses the tolerance band above gets almost no malus; one that uses the FULL band gets this much subtracted from scoreTotal. Only applies to candidates that would otherwise have hard-failed — a candidate that cleanly passes every rule is never penalized. Scoped to the three classic Impulse rules and the corrective B-ratio ceiling (Zigzag/Flat). The Chain-cover figure in the status table reports how much of the history remains unexplained.")

grpGapCount = "2.8 Real Gap Fill (Historical Chain)"
showGapWXYFill = input.bool(true, "2.8.1 Try real WXY/WXYXZ fit for unclassifiable stretches first", group=grpGapCount,
     tooltip="Allows the REAL Gap Fill pass (runs before any drawing) to try the Combination (WXY/WXYXZ) evaluators on every remaining gap — the same evaluators used everywhere else, swept over every start position inside the gap. A find becomes a REAL chain step (tagged -GF), drawn/ranked/scored by the same pipeline as every other segment. Since EWCore-2_20 this is engine-level, no longer a display-only fill: the old display-only version could show candidates that quality revalidation had rejected, and was removed.")
showGapImpulseFill = input.bool(true, "2.8.2 Try real Impulse fit for unclassifiable stretches", group=grpGapCount,
     tooltip="Motive-side counterpart to the WXY/WXYXZ toggle above: allows the REAL Gap Fill pass to try the Impulse evaluator (including the swallowed-wave recovery path, which reconstructs a missing interior high/low pair from the finer sub-pivot series) on every remaining gap. A find becomes a REAL chain step (tagged -GF) in the normal pipeline. Respects the global 'Check Impulse' toggle. Since EWCore-2_20 this is engine-level, no longer a display-only fill.")
gapFillMaxSpan = input.int(40, "2.8.4 Max. stretch length for the real-fit search (pivots)", minval=4, maxval=400, group=grpGapCount,
     tooltip="An unclassifiable stretch is searched for a real Elliott fit position by position, and the expensive combination evaluators only switch on once the stretch is long enough. A very long stretch therefore costs the most and yields the least, and it is what makes TradingView abort a chart with the message that a loop takes longer than 500 ms. This is the ceiling: stretches longer than this many pivots are left out of the real-fit search of 2.8.1 and 2.8.2. They keep their gap markers and their raw count - only the search for a genuine pattern is skipped. Lower this if you hit the 500 ms abort, raise it if you have headroom and want long stretches searched too.")

grpColors    = "3.1 Colors (All Features)"
