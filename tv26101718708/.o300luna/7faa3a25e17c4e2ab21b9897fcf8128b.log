f_filterLabelsToWindow(array<label> labels) =>
    int dwLo = math.min(displayWindowStart, displayWindowEnd)
    int dwHi = math.max(displayWindowStart, displayWindowEnd)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            lb = array.get(labels, i)
            int lx = label.get_x(lb)
            if lx < dwLo or lx > dwHi
                label.delete(lb)

f_filterLinesToWindow(array<line> lines) =>
    int dwLo = math.min(displayWindowStart, displayWindowEnd)
    int dwHi = math.max(displayWindowStart, displayWindowEnd)
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            ln = array.get(lines, i)
            int lx1 = line.get_x1(ln)
            if lx1 < dwLo or lx1 > dwHi
                line.delete(ln)

f_wrapParagraph(string p, int maxChars) =>
    array<string> words = str.split(p, " ")
    string result = ""
    string line = ""
    if array.size(words) > 0
        for i = 0 to array.size(words) - 1
            string w = array.get(words, i)
            string candidate = line == "" ? w : line + " " + w
            if str.length(candidate) > maxChars and line != ""
                result := result == "" ? line : result + "\n" + line
                line := w
            else
                line := candidate
        result := result == "" ? line : result + "\n" + line
    result
f_wrapText(string txt, int maxChars) =>
    array<string> paras = str.split(txt, "\n")
    string out = ""
    if array.size(paras) > 0
        for i = 0 to array.size(paras) - 1
            string p = array.get(paras, i)
            string wrapped = str.length(p) > 0 ? f_wrapParagraph(p, maxChars) : ""
            out := i == 0 ? wrapped : out + "\n" + wrapped
    out

