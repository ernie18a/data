var label[] mtfLabels = array.new_label(0)
var int[]   mtfMSide   = array.new_int(0)
var int[]   mtfMRank   = array.new_int(0)
var float[] mtfMAnchor = array.new_float(0)
var line[]  mtfLines  = array.new_line(0)

if barstate.islast
    if array.size(mtfLabels) > 0
        for mi = 0 to array.size(mtfLabels) - 1
            label.delete(array.get(mtfLabels, mi))
    array.clear(mtfLabels)
    array.clear(mtfMSide)
    array.clear(mtfMRank)
    array.clear(mtfMAnchor)
    if array.size(mtfLines) > 0
        for mi = 0 to array.size(mtfLines) - 1
            line.delete(array.get(mtfLines, mi))
    array.clear(mtfLines)
    if array.size(tagLbls) > 0
        for mi = 0 to array.size(tagLbls) - 1
            label.delete(array.get(tagLbls, mi))
    array.clear(tagLbls)
    array.clear(tagHosts)
    array.clear(tagHostLn)
    array.clear(tagDegs)
    array.clear(tagTfs)
    array.clear(tagMode)
    array.clear(tagSzs)
    if showMtfOverlay
        array<string> mtfPacks = array.from(mtfPack1, mtfPack2, mtfPack3, mtfPack4, mtfPack5, mtfPack6)
        array<string> mtfTfs   = array.from(mtfTf1, mtfTf2, mtfTf3, mtfTf4, mtfTf5, mtfTf6)
        array<color>  mtfCols  = array.from(mtfCol1, mtfCol2, mtfCol3, mtfCol4, mtfCol5, mtfCol6)
        array<string> mtfSzs   = array.from(mtfLabelSize, mtfSize2, mtfSize3, mtfSize4, mtfSize5, mtfSize6)
        array<bool>   mtfActs  = array.from(mtfAct1, mtfAct2, mtfAct3, mtfAct4, mtfAct5, mtfAct6)
        array<string> mtfLnSt  = array.from(mtfLineStyle1, mtfLineStyle2, mtfLineStyle3, mtfLineStyle4, mtfLineStyle5, mtfLineStyle6)
        array<int>    mtfLnWd  = array.from(mtfLineWidth1, mtfLineWidth2, mtfLineWidth3, mtfLineWidth4, mtfLineWidth5, mtfLineWidth6)
        for mk = 0 to 5
            string mtfTfK = array.get(mtfTfs, mk)
            string packed = array.get(mtfPacks, mk)
            if array.get(mtfActs, mk) and not na(packed) and str.length(packed) > 0
                array<string> mtfParts = str.split(packed, "|")
                if array.size(mtfParts) >= 6
                    color  mtfColK = array.get(mtfCols, mk)
                    string mtfType = array.get(mtfParts, 0)
                    int    mtfDeg  = int(str.tonumber(array.get(mtfParts, 1)))
                    float  mtfPPrev = str.tonumber(array.get(mtfParts, 3))
                    int    mtfTPrev = int(str.tonumber(array.get(mtfParts, 4)))
                    array<string> mtfTexts = ewcore.f_notatedLabelTextArray(mtfType, math.max(mtfDeg, 1), mtfTfK)
                    float  mtfSec = timeframe.in_seconds(mtfTfK)
                    int mtfRk = 3
                    for rq = 0 to 5
                        if array.get(mtfActs, rq) and timeframe.in_seconds(array.get(mtfTfs, rq)) < timeframe.in_seconds(mtfTfK)
                            mtfRk += 1
                    for mp = 5 to array.size(mtfParts) - 1
                        array<string> mtfTp = str.split(array.get(mtfParts, mp), ":")
                        if array.size(mtfTp) == 2
                            int   mtfT = int(str.tonumber(array.get(mtfTp, 0)))
                            float mtfP = str.tonumber(array.get(mtfTp, 1))
                            if not na(mtfT) and not na(mtfP)
                                bool mtfUp = na(mtfPPrev) or mtfP > mtfPPrev
                                if mp == 5 and not na(mtfTPrev) and not na(mtfPPrev)
                                    mtfTPrev := f_mtfBarTime(mtfTPrev, mtfPPrev, mtfSec)
                                mtfT := f_mtfBarTime(mtfT, mtfP, mtfSec)
                                if mtfShowLine and not na(mtfTPrev) and not na(mtfPPrev)
                                    array.push(mtfLines, line.new(mtfTPrev, mtfPPrev, mtfT, mtfP, xloc=xloc.bar_time, color=mtfColK, width=array.get(mtfLnWd, mk), style=ewcore.f_lineStyle(array.get(mtfLnSt, mk))))
                                int  mtfTi = mp - 5
                                if mtfShowText
                                    string mtfTxt = mtfTi < array.size(mtfTexts) ? array.get(mtfTexts, mtfTi) : str.tostring(mtfTi + 1)
                                    float mtfY = mtfP + (mtfUp ? baseOffT : -baseOffB)
                                    label mtfLb = label.new(mtfT, mtfY, mtfTxt, xloc=xloc.bar_time,
                                         style=label.style_none, textcolor=color.new(mtfColK, 0), size=ewcore.getLabelSize(array.get(mtfSzs, mk)),
                                         tooltip="MTF overlay: leading scenario of the " + mtfTfK + " timeframe (" + mtfType + ").")
                                    array.push(mtfLabels, mtfLb)
                                    ewcore.f_tagReg(mtfLb, str.length(mtfTxt), mtfTagT, mtfTagD, math.max(mtfDeg, 1), mtfTfK, array.get(mtfSzs, mk), tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
                                    array.push(mtfMSide, mtfUp ? 1 : -1)
                                    array.push(mtfMRank, mtfRk * 10 + math.max(0, array.indexof(szNam, array.get(mtfSzs, mk))))
                                    array.push(mtfMAnchor, mtfP)
                                mtfPPrev := mtfP
                                mtfTPrev := mtfT


f_chainBestPath(array<float> pP, array<int> pB, array<float> vP, array<int> vB, int degree, int rangeStart, int rangeEnd) =>
    int evalDeg = math.max(degree, 1)
    array<ewcore.WaveCount> steps = array.new<ewcore.WaveCount>(0)
    int nPiv = array.size(pP)
    int rEnd = math.min(rangeEnd, nPiv - 1)
    int evalWeight = (enableImpulse ? 1 : 0) + (enableDiagonal ? 1 : 0) + (enableZigzag ? 1 : 0) +
         (enableTriangle ? 1 : 0) + (enableCombo3 ? 2 : 0) + (enableCombo5 ? 3 : 0)
    int safeCap = math.max(30, int(historyChainSafetyBudget / math.max(1, evalWeight)))
    int rStart = (autoLimitHistoryChain and ((rEnd - rangeStart) > safeCap)) ? math.max(rangeStart, rEnd - safeCap) : rangeStart
    bool wasCapped = rStart > rangeStart
    int rangeLen = rEnd - rStart
    if rangeLen >= 3
        array<float> dpScore = array.new_float(rangeLen + 1, -1.0)
        array<int>   dpPrev  = array.new_int(rangeLen + 1, -1)
        array<int>   dpCandIdx = array.new_int(rangeLen + 1, -1)
        array<ewcore.WaveCount> candPool = array.new<ewcore.WaveCount>(0)
        array.set(dpScore, 0, 0.0)
        for k = 0 to rangeLen - 1
            float base = array.get(dpScore, k)
            if base >= 0.0
                int pos = rStart + k
                int posGateTime = degree <= 0 ? array.get(subPivotTimes, pos) : array.get(pivotTimes, f_resolveToPrimaryIdx(degree, pos))
                if base > array.get(dpScore, k + 1)
                    array.set(dpScore, k + 1, base)
                    array.set(dpPrev, k + 1, k)
                    array.set(dpCandIdx, k + 1, -1)
                if pos <= nPiv - 6
                    [cImpE, cDiagE, cTriE, wdKImp, wdKDiag, wdKTri] = ewcore.f_evalWindowTrio(pP, pB, vP, vB, evalDeg, pos, cfg, rsiMomentumSeries, enableImpulse, enableDiagonal, enableTriangle, enableWindowDisc, discFloorFit, discMargin, discUseSubCount)
                    if wdKImp
                        ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cImpE, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
                    if wdKDiag
                        ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cDiagE, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
                    if wdKTri
                        ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cTriE, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
                if pos <= nPiv - 4 and enableZigzag
                    cZfE = ewcore.evaluateZigzagFlatWindow(pP, pB, vP, vB, evalDeg, pos, cfg, rsiMomentumSeries)
                    ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cZfE, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
                if pos <= nPiv - 8 and enableCombo3
                    cC3E = ewcore.evaluateComboWXYWindow(pP, pB, vP, vB, evalDeg, pos, cfg, rsiMomentumSeries)
                    ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cC3E, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
                if pos <= nPiv - 12 and enableCombo5
                    cC5E = ewcore.evaluateComboWXYXZWindow(pP, pB, vP, vB, evalDeg, pos, cfg, rsiMomentumSeries)
                    ewcore.f_dpRelax(dpScore, dpPrev, dpCandIdx, candPool, k, rangeLen, base, cC5E, posGateTime, parentGateMode, hasValidParentTF, parentProxyFound, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars, parentGateMalus, recoveredPivotMalus, minScoreThreshold, enableChainGrammar, chainGrammarBonus, chainGrammarMalus, enableComboBonus, comboConsolidationBonus)
        int cur = rangeLen
        int btIter = 0
        array<ewcore.WaveCount> revSteps = array.new<ewcore.WaveCount>(0)
        while cur > 0 and btIter <= rangeLen + 5
            btIter := btIter + 1
            int prv = array.get(dpPrev, cur)
            if prv < 0 or prv >= cur
                break
            int ci = array.get(dpCandIdx, cur)
            if ci >= 0 and ci < array.size(candPool)
                array.push(revSteps, array.get(candPool, ci))
            cur := prv
        int rn = array.size(revSteps)
        if rn > 0
            for r = rn - 1 to 0
                array.push(steps, array.get(revSteps, r))
    if array.size(steps) > 0
        array<ewcore.WaveCount> revalidatedSteps = array.new<ewcore.WaveCount>(0)
        for rvi = 0 to array.size(steps) - 1
            ewcore.WaveCount revalStep = array.size(vB) == 0 ? array.get(steps, rvi) : ewcore.revalidateCandidate(array.get(steps, rvi), pP, pB, vP, vB, cfg, rsiMomentumSeries)
            if revalStep.hardRulesPassed and revalStep.scoreTotal >= minScoreThreshold
                array.push(revalidatedSteps, revalStep)
        steps := revalidatedSteps
    [steps, wasCapped]

f_subWaveLevelPrices(int deg) => deg <= 0 ? subPivotPrices : levelPrices(deg)
f_subWaveLevelBars(int deg)   => deg <= 0 ? subPivotBars   : levelBars(deg)

f_subWaveWindow(int decompDeg, int startIdx, int endIdx, int swRole) =>
    array<float> swP  = f_subWaveLevelPrices(decompDeg)
    array<int>   swB  = f_subWaveLevelBars(decompDeg)
    array<float> swV  = f_subWaveLevelPrices(decompDeg - 1)
    array<int>   swVB = f_subWaveLevelBars(decompDeg - 1)
    array<ewcore.WaveCount> swSteps = array.new<ewcore.WaveCount>(0)
    bool swCapped = false
    ewcore.WaveCount wlc = na
    if wholeLegDecomp
        wlc := ewcore.evaluateLegWhole(swP, swB, swV, swVB, decompDeg, startIdx, endIdx, cfg, rsiMomentumSeries, enableZigzag and swRole != 1, enableImpulse and swRole != 2, enableDiagonal and swRole != 2, enableTriangle and swRole != 1, enableCombo3 and swRole != 1, minScoreThreshold, wholeLegComboTolerance)
    if ewcore.f_legWholeDominance(wlc, swB) > subWaveMaxLegDominance
        wlc := na
    if not na(wlc)
        array.push(swSteps, wlc)
    else if subDetail == "full"
        [dpSteps, dpCapped] = f_chainBestPath(swP, swB, swV, swVB, decompDeg, startIdx, endIdx)
        swSteps := dpSteps
        swCapped := dpCapped
    [swSteps, swCapped]

f_subWaveTime(int decompDeg, int idx) =>
    decompDeg <= 0 ? array.get(subPivotTimes, idx) : array.get(pivotTimes, f_resolveToPrimaryIdx(decompDeg, idx))

f_anchorNear(int tMs) =>
    array<int>   anT = array.size(subPivotTimes) > 0 ? subPivotTimes : pivotTimes
    array<float> anP = array.size(subPivotTimes) > 0 ? subPivotPrices : pivotPrices
    float anBest = close
    if array.size(anT) > 0
        int anIx = math.min(array.binary_search_leftmost(anT, tMs), array.size(anT) - 1)
        anBest := array.get(anP, anIx)
        if anIx > 0 and math.abs(array.get(anT, anIx - 1) - tMs) < math.abs(array.get(anT, anIx) - tMs)
            anBest := array.get(anP, anIx - 1)
    anBest

f_drawSubWaveSteps(array<label> targetLabels, array<line> targetLines, array<ewcore.WaveCount> steps, int decompDeg, int rangeStart, int rangeEnd, int notationDeg, float offTop, float offBottom, bool showFinal, string fallbackTag, string fallbackContext, array<int> mSide, array<int> mRank, array<float> mAnchor, int stackRank, int mSzInfo) =>
    int covered = rangeStart
    int lastBarKey = na
    array<float> swPrices = f_subWaveLevelPrices(decompDeg)
    int   swMaxIdx = array.size(swPrices) - 1
    if array.size(steps) > 0 and swMaxIdx >= 0
        for si = 0 to array.size(steps) - 1
            ewcore.WaveCount step = array.get(steps, si)
            if step.startIdx > covered
                float gp0 = array.get(swPrices, math.min(covered, swMaxIdx))
                float gp1 = array.get(swPrices, math.min(step.startIdx, swMaxIdx))
                int   gt0 = f_subWaveTime(decompDeg, covered)
                int   gt1 = f_subWaveTime(decompDeg, step.startIdx)
                if showUnresolvedLabel and (na(lastBarKey) or covered != lastBarKey)
                    int agN1 = step.startIdx - covered + 1
                    bool agAtomic1 = agN1 < 4
                    string agDiag1 = ewcore.f_atomicDiagText(agN1)
                    float gMidPr = (gp0 + gp1) / 2.0 - offBottom
                    gLbl = label.new(int((gt0 + gt1) / 2), gMidPr, agAtomic1 ? "▫" : "!", xloc=xloc.bar_time, style=label.style_label_up,
                         color=unresolvedLabelBgColor, textcolor=color.new(unresolvedLabelColor, 0), size=ewcore.getLabelSize(unresolvedLabelSize_e),
                         tooltip=fallbackTag + "  " + fallbackContext + " — no valid pattern resolved for this stretch." + agDiag1)
                    array.push(targetLabels, gLbl)
                    array.push(mSide, -1)
                    array.push(mRank, 90 + mSzInfo)
                    array.push(mAnchor, (gp0 + gp1) / 2.0)
                    lastBarKey := covered
                    if showUnresolvedLine
                        gLine = line.new(gt0, gp0, gt1, gp1, xloc=xloc.bar_time, color=unresLineCol, width=unresolvedLineWidth, style=ewcore.f_lineStyle(unresolvedLineStyle))
                        array.push(targetLines, gLine)
            array<string> stepTexts = ewcore.f_notatedLabelTextArray(step.patternType, notationDeg, timeframe.period)
            array<float>  stepPr = array.from(step.w1e, step.w2e, step.w3e, step.w4e, step.w5e)
            array<int>    stepBr = array.from(step.w1eBar, step.w2eBar, step.w3eBar, step.w4eBar, step.w5eBar)
            float prevP = step.w1s
            int   prevT = f_subWaveTime(decompDeg, step.startIdx)
            bool  isLastStep = step.startIdx + step.legsConsumed >= rangeEnd
            int   loopEnd = (isLastStep and not showFinal) ? step.numPoints - 2 : step.numPoints - 1
            for j = 0 to loopEnd
                float pr = array.get(stepPr, j)
                bool  isHigh = pr > prevP
                int   ptIdx = step.startIdx + 1 + j
                int   tPt = ewcore.f_recPointTime(array.get(stepBr, j), pivotBars, pivotTimes, subPivotBars, subPivotTimes)
                if showSubWaveLine
                    subLn = line.new(prevT, prevP, tPt, pr, xloc=xloc.bar_time,
                         color = f_subLineCol(),
                         width = subWaveLineWidth, style = ewcore.f_lineStyle(subWaveLineStyle))
                    array.push(targetLines, subLn)
                if na(lastBarKey) or ptIdx != lastBarKey
                    float y = isHigh ? pr + offTop : pr - offBottom
                    string sExtG = showExtensionMarker ? ewcore.f_extGlyph(step.extInfo, j + 1) : ""
                    string sExtT = showExtensionMarker ? ewcore.f_extTooltip(step.extInfo, j + 1) : ""
                    color  sTgC = f_subLabelColor(isHigh)
                    string sTxt = array.get(stepTexts, j) + sExtG
                    lbl = label.new(tPt, y, sTxt, xloc=xloc.bar_time, style=label.style_none,
                         textcolor=sTgC, size=ewcore.getLabelSize(subLabelSize_e),
                         tooltip = str.length(sExtT) > 0 ? str.substring(sExtT, 1) : "")
                    array.push(targetLabels, lbl)
                    ewcore.f_tagReg(lbl, str.length(sTxt), tagSubT, tagSubD, notationDeg, timeframe.period, subLabelSize_e, tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
                    array.push(mSide, isHigh ? 1 : -1)
                    array.push(mRank, stackRank)
                    array.push(mAnchor, pr)
                    lastBarKey := ptIdx
                prevP := pr
                prevT := tPt
            covered := step.startIdx + step.legsConsumed
    if covered < rangeEnd and swMaxIdx >= 0 and showUnresolvedLabel and (na(lastBarKey) or covered != lastBarKey)
        float tp0 = array.get(swPrices, math.min(covered, swMaxIdx))
        float tp1 = array.get(swPrices, math.min(rangeEnd, swMaxIdx))
        int   tt0 = f_subWaveTime(decompDeg, covered)
        int   tt1 = f_subWaveTime(decompDeg, rangeEnd)
        float tMidPr = (tp0 + tp1) / 2.0 - offBottom
        int agN2 = rangeEnd - covered + 1
        bool agAtomic2 = agN2 < 4
        string agDiag2 = ewcore.f_atomicDiagText(agN2)
        tLbl = label.new(int((tt0 + tt1) / 2), tMidPr, agAtomic2 ? "▫" : "!", xloc=xloc.bar_time, style=label.style_label_up,
             color=unresolvedLabelBgColor, textcolor=color.new(unresolvedLabelColor, 0), size=ewcore.getLabelSize(unresolvedLabelSize_e),
             tooltip=fallbackTag + "  " + fallbackContext + " — no valid pattern resolved for this stretch." + agDiag2)
        array.push(targetLabels, tLbl)
        array.push(mSide, -1)
        array.push(mRank, 90 + mSzInfo)
        array.push(mAnchor, (tp0 + tp1) / 2.0)
        if showUnresolvedLine
            tLine = line.new(tt0, tp0, tt1, tp1, xloc=xloc.bar_time, color=unresLineCol, width=unresolvedLineWidth, style=ewcore.f_lineStyle(unresolvedLineStyle))
            array.push(targetLines, tLine)

var sequelSteps = array.new<ewcore.WaveCount>(0)
var bool historyChainCapActive = false
var int drawnSubDegLo = na
var int drawnSubDegHi = na
var bool postChainHasCoverage = false

if barstate.islast
    array.clear(sequelSteps)
    historyChainCapActive := false
    drawnSubDegLo := na
    drawnSubDegHi := na
    postChainHasCoverage := false
    if showSequelChain and not na(topDegree) and topDegree >= 1 and topDegree <= maxActiveDegree() and not na(topStartIdx) and not na(topLegsConsumed)
        array<float> seqP = levelPrices(topDegree)
        array<int>   seqB = levelBars(topDegree)
        array<float> seqValP = topDegree > 1 ? levelPrices(topDegree - 1) : subPivotPrices
        array<int>   seqValB = topDegree > 1 ? levelBars(topDegree - 1) : subPivotBars
        int seqN = array.size(seqP)
        int seqStart = topStartIdx + topLegsConsumed
        [seqFound, seqCapped] = f_chainBestPath(seqP, seqB, seqValP, seqValB, topDegree, seqStart, seqN - 1)
        historyChainCapActive := historyChainCapActive or seqCapped
        if array.size(seqFound) > 0
            for sqI = 0 to array.size(seqFound) - 1
                array.push(sequelSteps, array.get(seqFound, sqI))

var chainSteps = array.new<ewcore.WaveCount>(0)
var bool[]      segCovered = array.new_bool(0)
var bool[]      gfMask     = array.new_bool(0)
var int         topStartD1 = na
var int         topEndD1   = na
var int         seqEndD1   = na
var int         preHideStartD1 = na
var int         chainAnchorD1 = 0
var int         chainAnchorEndD1 = na
var bool        chainRangeSwapped = false

if barstate.islast
    array.clear(chainSteps)
    array.clear(segCovered)
    int n2c = array.size(pivotPrices)
    for fillI = 0 to math.max(n2c - 1, 0)
        array.push(segCovered, false)
    chainAnchorD1 := 0
    chainAnchorEndD1 := na
    chainRangeSwapped := false
    int caStartT = chainStartAnchorTime
    int caEndT   = chainEndAnchorTime
    if useChainStartAnchor and useChainEndAnchor and chainEndAnchorTime < chainStartAnchorTime
        caStartT := chainEndAnchorTime
        caEndT   := chainStartAnchorTime
        chainRangeSwapped := true
    if useChainStartAnchor and n2c > 0
        chainAnchorD1 := math.min(ewcore.subLowerBound(pivotTimes, caStartT), n2c - 1)
        if chainAnchorD1 > 0
            for caI = 0 to chainAnchorD1 - 1
                array.set(segCovered, caI, true)
    if useChainEndAnchor and n2c > 0
        int caEndIdx = math.min(ewcore.subLowerBound(pivotTimes, caEndT), n2c - 1)
        chainAnchorEndD1 := caEndIdx
        for caJ = caEndIdx to n2c - 1
            array.set(segCovered, caJ, true)

    topStartD1 := topStartIdx
    topEndD1   := na(topStartIdx) or na(topLegsConsumed) ? na : topStartIdx + topLegsConsumed
    seqEndD1   := na
    if not na(topDegree) and topDegree > 1 and not na(topStartIdx) and topDegree <= maxActiveDegree()
        int seqEndCompressed = na
        if array.size(sequelSteps) > 0
            ewcore.WaveCount lastSeqStep = array.get(sequelSteps, array.size(sequelSteps) - 1)
            seqEndCompressed := lastSeqStep.startIdx + lastSeqStep.legsConsumed
        seqEndD1 := seqEndCompressed
        for deg = topDegree to 2
            array<int> sIdxCov = levelSrcIdx(deg)
            if array.size(sIdxCov) > 0
                topStartD1 := array.get(sIdxCov, math.min(topStartD1, array.size(sIdxCov) - 1))
                if not na(topEndD1)
                    topEndD1 := array.get(sIdxCov, math.min(topEndD1, array.size(sIdxCov) - 1))
                if not na(seqEndD1)
                    seqEndD1 := array.get(sIdxCov, math.min(seqEndD1, array.size(sIdxCov) - 1))
    else if not na(topDegree) and topDegree == 1 and array.size(sequelSteps) > 0
        ewcore.WaveCount lastSeqStepD1 = array.get(sequelSteps, array.size(sequelSteps) - 1)
        seqEndD1 := lastSeqStepD1.startIdx + lastSeqStepD1.legsConsumed

    if showHistoryChain
        bool preChainActive = showHistoryPreChain or na(topStartD1)
        if preChainActive
            int histEnd1 = na(topStartD1) ? n2c - 1 : topStartD1
            histEnd1 := na(chainAnchorEndD1) ? histEnd1 : math.min(histEnd1, chainAnchorEndD1)
            [chainPre, chainPreCapped] = f_chainBestPath(pivotPrices, pivotBars, subPivotPrices, subPivotBars, 1, chainAnchorD1, histEnd1)
            historyChainCapActive := historyChainCapActive or chainPreCapped
            if array.size(chainPre) > 0
                for cpI = 0 to array.size(chainPre) - 1
                    ewcore.WaveCount stepBest = array.get(chainPre, cpI)
                    array.push(chainSteps, stepBest)
                    for segI = stepBest.startIdx to math.min(stepBest.startIdx + stepBest.legsConsumed, array.size(segCovered)) - 1
                        array.set(segCovered, segI, true)

        int postStart = na(topEndD1) ? n2c : math.max(topEndD1, na(seqEndD1) ? topEndD1 : seqEndD1)
        int postEnd = na(chainAnchorEndD1) ? n2c - 1 : math.min(n2c - 1, chainAnchorEndD1)
        [chainPost, chainPostCapped] = f_chainBestPath(pivotPrices, pivotBars, subPivotPrices, subPivotBars, 1, postStart, postEnd)
        historyChainCapActive := historyChainCapActive or chainPostCapped
        postChainHasCoverage := array.size(chainPost) > 0
        if array.size(chainPost) > 0
            for cqI = 0 to array.size(chainPost) - 1
                ewcore.WaveCount stepBestA = array.get(chainPost, cqI)
                array.push(chainSteps, stepBestA)
                for segIA = stepBestA.startIdx to math.min(stepBestA.startIdx + stepBestA.legsConsumed, array.size(segCovered)) - 1
                    array.set(segCovered, segIA, true)

    preHideStartD1 := na
    if showHistoryChain and not showHistoryPreChain and not na(topStartD1)
        preHideStartD1 := topStartD1
        for segIP = 0 to math.min(topStartD1, array.size(segCovered)) - 1
            array.set(segCovered, segIP, true)

    if not na(topStartD1) and not na(topEndD1)
        for segIB = topStartD1 to math.min(topEndD1, array.size(segCovered)) - 1
            array.set(segCovered, segIB, true)

    if not na(topEndD1) and not na(seqEndD1) and seqEndD1 > topEndD1
        for segIC = topEndD1 to math.min(seqEndD1, array.size(segCovered)) - 1
            array.set(segCovered, segIC, true)

    array.clear(gfMask)
    if array.size(segCovered) > 0
        int gfSt = na
        for gfI = 0 to array.size(segCovered) - 1
            array.push(gfMask, false)
        for gfP = 0 to array.size(segCovered)
            bool gfC = gfP < array.size(segCovered) ? array.get(segCovered, gfP) : true
            if not gfC and na(gfSt)
                gfSt := gfP
            if gfC and not na(gfSt)
                if gfP - gfSt > gapFillMaxSpan
                    for gfJ = gfSt to gfP - 1
                        array.set(segCovered, gfJ, true)
                        array.set(gfMask, gfJ, true)
                gfSt := na
    ewcore.f_realGapFill(pivotPrices, pivotBars, subPivotPrices, subPivotBars, cfg, rsiMomentumSeries, segCovered, chainSteps, historyGapMinSpan, showGapWXYFill and enableCombo3, showGapWXYFill and enableCombo5, showGapImpulseFill and enableImpulse, enableDiagonal, enableTriangle, enableZigzag, minScoreThreshold)
    if array.size(gfMask) > 0
        for gfK = 0 to array.size(gfMask) - 1
            if array.get(gfMask, gfK)
                array.set(segCovered, gfK, false)

var line[] zzLines = array.new_line(0)
var line anchorLine = na
var line chainStartMarker = na
var line chainEndMarker = na
var line dwStartMarker = na
var line dwEndMarker = na
float markerTopY = ta.highest(high, 500)
float markerBotY = ta.lowest(low, 500)
var label anchorMarkerLbl = na
var label chainStartMarkerLbl = na
var label chainEndMarkerLbl = na
var label dwStartMarkerLbl = na
var label dwEndMarkerLbl = na

if barstate.islast
    if not na(anchorLine)
        line.delete(anchorLine)
    if not na(anchorMarkerLbl)
        label.delete(anchorMarkerLbl)
    [amLn, amLb] = ewcore.f_drawDateMarker(useManualAnchor and showDateMarkers, anchorTime, close * 0.99, close * 1.01, close, anchorMarkerColor, "Count start (Leading)", syminfo.timezone, 2)
    anchorLine := amLn
    anchorMarkerLbl := amLb
    if not na(chainStartMarker)
        line.delete(chainStartMarker)
    if not na(chainEndMarker)
        line.delete(chainEndMarker)
    if not na(dwStartMarker)
        line.delete(dwStartMarker)
    if not na(dwEndMarker)
        line.delete(dwEndMarker)
    if not na(chainStartMarkerLbl)
        label.delete(chainStartMarkerLbl)
    if not na(chainEndMarkerLbl)
        label.delete(chainEndMarkerLbl)
    if not na(dwStartMarkerLbl)
        label.delete(dwStartMarkerLbl)
    if not na(dwEndMarkerLbl)
        label.delete(dwEndMarkerLbl)
    int camLo = math.min(chainStartAnchorTime, chainEndAnchorTime)
    int camHi = math.max(chainStartAnchorTime, chainEndAnchorTime)
    int camStartT = useChainStartAnchor and useChainEndAnchor ? camLo : chainStartAnchorTime
    int camEndT   = useChainStartAnchor and useChainEndAnchor ? camHi : chainEndAnchorTime
    [csLn, csLb] = ewcore.f_drawDateMarker(useChainStartAnchor and showDateMarkers, camStartT, close * 0.99, close * 1.01, markerTopY, chainStartMarkerColor, "Chain start", syminfo.timezone, 1)
    chainStartMarker := csLn
    chainStartMarkerLbl := csLb
    [ceLn, ceLb] = ewcore.f_drawDateMarker(useChainEndAnchor and showDateMarkers, camEndT, close * 0.99, close * 1.01, markerTopY, chainEndMarkerColor, "Chain end", syminfo.timezone, 1)
    chainEndMarker := ceLn
    chainEndMarkerLbl := ceLb
    int dwmLo = math.min(displayWindowStart, displayWindowEnd)
    int dwmHi = math.max(displayWindowStart, displayWindowEnd)
    [dsLn, dsLb] = ewcore.f_drawDateMarker(showDisplayWindow and showDateMarkers, dwmLo, close * 0.99, close * 1.01, markerBotY, dwMarkerColor, "Window start", syminfo.timezone, 1)
    dwStartMarker := dsLn
    dwStartMarkerLbl := dsLb
    [deLn, deLb] = ewcore.f_drawDateMarker(showDisplayWindow and showDateMarkers, dwmHi, close * 0.99, close * 1.01, markerBotY, dwMarkerColor, "Window end", syminfo.timezone, 1)
    dwEndMarker := deLn
    dwEndMarkerLbl := deLb

if barstate.islast and array.size(pivotPrices) >= 2
    if array.size(zzLines) > 0
        for i = 0 to array.size(zzLines) - 1
            line.delete(array.get(zzLines, i))
    array.clear(zzLines)

    for i = 0 to array.size(pivotPrices) - 2
        if showPrimaryZigzag and array.size(segCovered) > i and array.get(segCovered, i) and i >= chainAnchorD1 and (na(chainAnchorEndD1) or i < chainAnchorEndD1) and (na(preHideStartD1) or i >= preHideStartD1) and (showLeadingRawPath or na(topStartD1) or na(topEndD1) or i < topStartD1 or i >= topEndD1)
            int   t1 = array.get(pivotTimes, i)
            int   t2 = array.get(pivotTimes, i + 1)
            v1 = array.get(pivotPrices, i)
            v2 = array.get(pivotPrices, i + 1)
            color col = histLineCol
            int   segWidth = historyLineWidth
            string segStyle = historyLineStyle
            bool rlRouted = false
            if routeLegsThroughSub
                int  rlB0 = array.get(pivotBars, i)
                int  rlB1 = array.get(pivotBars, i + 1)
                bool rlLongEnough = (rlB1 - rlB0) * timeframe.in_seconds() >= subLabelMinHoursEff * 3600
                rlRouted := ewcore.f_drawRoutedLeg(zzLines, subPivotBars, subPivotTimes, subPivotPrices, t1, v1, t2, v2, rlB0, rlB1, rlLongEnough, col, segWidth, segStyle)
            if not rlRouted
                ln = line.new(t1, v1, t2, v2, xloc=xloc.bar_time, color=col, width=segWidth, style=ewcore.f_lineStyle(segStyle))
                array.push(zzLines, ln)

    if not na(topDegree) and topDegree > 1 and not na(topStartIdx) and not na(topLegsConsumed) and topDegree <= maxActiveDegree()
        array<float> topP = levelPrices(topDegree)
        if array.size(topP) > topStartIdx + topLegsConsumed and not topIsRecovered
            for k = topStartIdx to topStartIdx + topLegsConsumed - 1
                int   qt1 = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, k))
                int   qt2 = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, k + 1))
                float u1 = array.get(topP, k)
                float u2 = array.get(topP, k + 1)
                if showLeadingOverlayLine
                    ln2 = line.new(qt1, u1, qt2, u2, xloc=xloc.bar_time, color=hardRulesValid ? leadLabelColor : color.new(color.gray, 50), width=activeLineWidth + 1, style=ewcore.f_lineStyle(activeLineStyle))
                    array.push(zzLines, ln2)
        if showSequelChain and array.size(sequelSteps) > 0
            for si2 = 0 to array.size(sequelSteps) - 1
                ewcore.WaveCount seg2 = array.get(sequelSteps, si2)
                if array.size(topP) > seg2.startIdx + seg2.legsConsumed
                    for k2 = seg2.startIdx to seg2.startIdx + seg2.legsConsumed - 1
                        int   qqt1 = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, k2))
                        int   qqt2 = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, k2 + 1))
                        float uu1 = array.get(topP, k2)
                        float uu2 = array.get(topP, k2 + 1)
                        ln3 = line.new(qqt1, uu1, qqt2, uu2, xloc=xloc.bar_time, color=seqLineCol, width=sequelLineWidth, style=ewcore.f_lineStyle(sequelLineStyle))
                        array.push(zzLines, ln3)

    if not na(topDegree) and topDegree == 1 and showSequelChain and array.size(sequelSteps) > 0
        for si2b = 0 to array.size(sequelSteps) - 1
            ewcore.WaveCount seg2b = array.get(sequelSteps, si2b)
            if array.size(pivotPrices) > seg2b.startIdx + seg2b.legsConsumed
                for k2b = seg2b.startIdx to seg2b.startIdx + seg2b.legsConsumed - 1
                    int   qbt1 = array.get(pivotTimes, k2b)
                    int   qbt2 = array.get(pivotTimes, k2b + 1)
                    float ub1 = array.get(pivotPrices, k2b)
                    float ub2 = array.get(pivotPrices, k2b + 1)
                    ln3b = line.new(qbt1, ub1, qbt2, ub2, xloc=xloc.bar_time, color=seqLineCol, width=sequelLineWidth, style=ewcore.f_lineStyle(sequelLineStyle))
                    array.push(zzLines, ln3b)

    if topIsRecovered and not na(topStartIdx) and not na(w1eBar) and (topDegree == 1 or topDegree <= maxActiveDegree())
        int   rpPrevT = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, topStartIdx))
        float rpPrevP = array.get(levelPrices(topDegree), topStartIdx)
        array<int>   rpBars   = array.from(w1eBar, w2eBar, w3eBar, w4eBar, w5eBar)
        array<float> rpPrices = array.from(w1e, w2e, w3e, w4e, w5e)
        for rpI = 0 to 4
            int   rpT = ewcore.f_recPointTime(array.get(rpBars, rpI), pivotBars, pivotTimes, subPivotBars, subPivotTimes)
            float rpV = array.get(rpPrices, rpI)
            if not na(rpT) and not na(rpPrevT) and not na(rpV) and not na(rpPrevP)
                lnR = line.new(rpPrevT, rpPrevP, rpT, rpV, xloc=xloc.bar_time, color=hardRulesValid ? leadLabelColor : color.new(color.gray, 50), width=activeLineWidth + 1, style=ewcore.f_lineStyle(activeLineStyle))
                array.push(zzLines, lnR)
            rpPrevT := rpT
            rpPrevP := rpV

var label[] sequelLabels = array.new_label(0)
var int[]   seqMSide     = array.new_int(0)
var int[]   seqMRank     = array.new_int(0)
var float[] seqMAnchor   = array.new_float(0)

var label[] historyLabels = array.new_label(0)
var int[]   histMSide     = array.new_int(0)
var int[]   histMRank     = array.new_int(0)
var float[] histMAnchor   = array.new_float(0)
f_regH(int rSd, int rRk, float rAn) =>
    array.push(histMSide, rSd)
    array.push(histMRank, rRk)
    array.push(histMAnchor, rAn)
var line[]  historyGapLines = array.new_line(0)
var line[]  historyUnresolvedLines = array.new_line(0)

var bool effShowSubExpl   = true
var bool effShowSubLabels = true
var bool effShowHistSub   = true
var bool effShowHistExpl  = true
if barstate.islast
    int dcCount = 0
    if declutterMode != "off"
        if array.size(pivotTimes) > 0
            for dcI = 0 to array.size(pivotTimes) - 1
                int dcT = array.get(pivotTimes, dcI)
                if dcT >= chart.left_visible_bar_time and dcT <= chart.right_visible_bar_time
                    dcCount += 1
        if array.size(subPivotTimes) > 0
            for dcI = 0 to array.size(subPivotTimes) - 1
                int dcT = array.get(subPivotTimes, dcI)
                if dcT >= chart.left_visible_bar_time and dcT <= chart.right_visible_bar_time
                    dcCount += 1
    bool dcOn = declutterMode != "off"
    bool dcHit1 = dcOn and dcCount > declutterThresh
    bool dcHit2 = dcOn and dcCount > 2 * declutterThresh
    effShowSubExpl   := showSubWaveExplanation and not dcHit1
    effShowSubLabels := showSubWaveLabels and subDetail != "off" and not (dcHit1 and declutterMode == "aggressive")
    effShowHistSub   := (showHistorySubWaves or profM15) and subDetail != "off" and not (dcHit1 and declutterMode == "aggressive")
    effShowHistExpl  := effShowHistExplBase and not dcHit2

var label[] waveLabels  = array.new_label(0)
var int[]   waveMSide   = array.new_int(0)
var int[]   waveMRank   = array.new_int(0)
var float[] waveMAnchor = array.new_float(0)
f_regW(int rSd, int rRk, float rAn) =>
    array.push(waveMSide, rSd)
    array.push(waveMRank, rRk)
    array.push(waveMAnchor, rAn)
f_regLibW(int fromN, int rlDeg) =>
    if array.size(waveLabels) > fromN
        for rlI = fromN to array.size(waveLabels) - 1
            label rlL = array.get(waveLabels, rlI)
            string rlT = label.get_text(rlL)
            float rlA = f_anchorNear(label.get_x(rlL))
            bool rlIsInfo = rlT == "!" or rlT == "▫" or rlT == "i"
            f_regW(label.get_y(rlL) >= rlA ? 1 : -1, rlIsInfo ? 90 + szInfo : szSub, rlA)
            if not rlIsInfo
                ewcore.f_tagReg(rlL, str.length(rlT), tagSubT, tagSubD, rlDeg, timeframe.period, subLabelSize_e, tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
var line[]  waveUnresolvedLines = array.new_line(0)

if barstate.islast and not na(w1s) and not na(topStartIdx)
    if array.size(waveLabels) > 0
        for i = 0 to array.size(waveLabels) - 1
            label.delete(array.get(waveLabels, i))
    array.clear(waveLabels)
    array.clear(waveMSide)
    array.clear(waveMRank)
    array.clear(waveMAnchor)
    if array.size(waveUnresolvedLines) > 0
        for i = 0 to array.size(waveUnresolvedLines) - 1
            line.delete(array.get(waveUnresolvedLines, i))
    array.clear(waveUnresolvedLines)
    array.clear(pinSubExpl)

    array<float> dispPrices = levelPrices(topDegree)
    array<int>   dispBars   = levelBars(topDegree)
    array<int>   dispTypes  = levelTypes(topDegree)
    labelTexts  = ewcore.f_notatedLabelTextArray(topPatternType, topDegree, timeframe.period)
    labelPrices = array.from(w1e, w2e, w3e, w4e, w5e)
    array<int> labelPointBars = array.from(w1eBar, w2eBar, w3eBar, w4eBar, w5eBar)
    int pointCount = na(topNumPoints) ? 5 : topNumPoints

    float rangeHigh = array.get(labelPrices, 0)
    float rangeLow  = array.get(labelPrices, 0)
    for rgI = 1 to pointCount - 1
        float rgV = array.get(labelPrices, rgI)
        if rgV > rangeHigh
            rangeHigh := rgV
        if rgV < rangeLow
            rangeLow := rgV
    topPatternRangeForOffset := rangeHigh - rangeLow

    if pointCount > 0 and showLabelText
        for i = 0 to pointCount - 1
            lt = ewcore.f_recPointTime(array.get(labelPointBars, i), pivotBars, pivotTimes, subPivotBars, subPivotTimes)
            pr = array.get(labelPrices, i)
            string extG = showExtensionMarker ? ewcore.f_extGlyph(topExtInfo, i + 1) : ""
            string extT = showExtensionMarker ? ewcore.f_extTooltip(topExtInfo, i + 1) : ""
            txt = array.get(labelTexts, i) + extG
            isHighPivot = topIsRecovered ? (topIsUp ? i % 2 == 0 : i % 2 == 1) : array.get(dispTypes, topStartIdx + 1 + i) == 1
            float labelOffset = (isHighPivot ? baseOffT : baseOffB)
            float py = isHighPivot ? pr + labelOffset : pr - labelOffset
            lbl = label.new(lt, py, txt, xloc=xloc.bar_time,
                 style = label.style_none,
                 textcolor = hardRulesValid ? color.new(leadLabelColor, 0) : color.gray,
                 size = lblSize,
                 tooltip = str.length(extT) > 0 ? str.substring(extT, 1) : "")
            array.push(waveLabels, lbl)
            ewcore.f_tagReg(lbl, str.length(txt), tagLeadT, tagLeadD, topDegree, timeframe.period, labelSize_e, tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
            f_regW(isHighPivot ? 1 : -1, 20 + szMain, pr)

    if showActiveDegreeLabel and pointCount > 0
        string p0Degree = ewcore.getDegreeLabel(timeframe.period)
        if topDegree > 1
            for sD = 1 to topDegree - 1
                p0Degree := ewcore.shiftDegreeUp(p0Degree)
        float p0Price = array.get(dispPrices, topStartIdx)
        int   p0Time  = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, topStartIdx))
        bool  p0High  = array.get(dispTypes, topStartIdx) == 1
        float p0Offset = (p0High ? baseOffT : baseOffB)
        float p0Y = p0High ? p0Price + p0Offset : p0Price - p0Offset
        degLbl = label.new(p0Time, p0Y, p0Degree + " degree", xloc=xloc.bar_time,
             style = p0High ? label.style_label_down : label.style_label_up,
             color=explanationBgColor, textcolor=explanationTextColor, size=ewcore.getLabelSize(explanationSize_e),
             tooltip="Elliott degree of this leading scenario's own count, starting at P0. Chart TF: " + timeframe.period + ". This is a DEGREE (compression level on this one chart), not a separate real timeframe — see the Higher-Degree Detection settings group.")
        array.push(waveLabels, degLbl)
        f_regW(p0High ? 1 : -1, 90 + szMain, p0Price)

    bool isWXY   = topPatternType == "Combination (WXY)"
    bool isWXYXZ = topPatternType == "Combination (WXYXZ)"
    if topComboStructure != "" and (isWXY or isWXYXZ) and not na(topLegsConsumed) and showLabelText
        int finalPointAdj = showFinalSubWavePoint ? 0 : -1
        bool xIsMultiLeg = isWXY and str.contains(topComboStructure, "X:zigzag:3")
        int xLegsActual = xIsMultiLeg ? 3 : 1
        int yLegsActual = isWXY ? topLegsConsumed - 3 - xLegsActual : 3
        array<int> relOffsets = array.new_int(0)
        array<int> groupSizes = array.new_int(0)
        array.push(relOffsets, 1)
        array.push(groupSizes, 3 + finalPointAdj)
        if xIsMultiLeg
            array.push(relOffsets, 4)
            array.push(groupSizes, 3 + finalPointAdj)
        int yOff = 3 + xLegsActual + 1
        array.push(relOffsets, yOff)
        if isWXY
            array.push(groupSizes, (yLegsActual == 5 ? 5 : 3) + finalPointAdj)
        else
            array.push(groupSizes, 3 + finalPointAdj)
            array.push(relOffsets, 9)
            array.push(groupSizes, (topLegsConsumed == 13 ? 5 : 3) + finalPointAdj)
        array<string> subLetters = array.from("a", "b", "c", "d", "e")
        int lastComboBar = na
        for g = 0 to array.size(relOffsets) - 1
            int gOff = array.get(relOffsets, g)
            int gSize = array.get(groupSizes, g)
            for k = 0 to gSize - 1
                int pIdx = topStartIdx + gOff + k
                int subBar = array.get(dispBars, pIdx)
                int subTime = array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, pIdx))
                if na(lastComboBar) or subBar != lastComboBar
                    string subTxt = array.get(subLetters, k)
                    float subPr = array.get(dispPrices, pIdx)
                    bool  subIsHigh = array.get(dispTypes, pIdx) == 1
                    float subY = subIsHigh ? subPr + baseOffT : subPr - baseOffB
                    subLbl = label.new(subTime, subY, subTxt, xloc=xloc.bar_time, style=label.style_none,
                         textcolor = hardRulesValid ? chart.fg_color : color.new(color.gray, 25),
                         size = ewcore.getLabelSize(comboInteriorLabelSize_e))
                    array.push(waveLabels, subLbl)
                    f_regW(subIsHigh ? 1 : -1, 10 + szSub, subPr)
                    lastComboBar := subBar

    if effShowSubLabels and not na(topLegsConsumed) and showLabelText
        string baseDeg = ewcore.getDegreeLabel(timeframe.period)
        bool degPath = topDegree > 1 and topDegree <= maxActiveDegree() and array.size(levelSrcIdx(topDegree)) > topStartIdx + topLegsConsumed
        string floorDeg = ewcore.f_degreeNameFor(0, timeframe.period)
        if degPath or (topDegree == 1 and topComboStructure == "")
            for leg = 0 to topLegsConsumed - 1
                int lgB0 = array.get(dispBars, topStartIdx + leg)
                int lgB1 = array.get(dispBars, topStartIdx + leg + 1)
                bool legLongEnough = (lgB1 - lgB0) * timeframe.in_seconds() >= subLabelMinHoursEff * 3600
                string legLetter = leg < array.size(labelTexts) ? array.get(labelTexts, leg) : str.tostring(leg + 1)
                int chosenDeg = -1
                int chS = na
                int chE = na
                int diagCandS = na
                int diagCandE = na
                bool haveWin = false
                if degPath
                    if legLongEnough
                        for candDeg = topDegree - 1 to 1
                            array<int> candBars = levelBars(candDeg)
                            [candS, candE, candPassed] = ewcore.f_evalCandDegStep(candBars, lgB0, lgB1, subWaveMaxLegDominance)
                            diagCandS := candS
                            diagCandE := candE
                            if candPassed
                                chosenDeg := candDeg
                                chS := candS
                                chE := candE
                                break
                    haveWin := chosenDeg > 0
                else
                    [flS, flE, flPassed] = ewcore.f_evalFloorLeg(subPivotBars, lgB0, lgB1, subWaveMaxLegDominance)
                    chS := flS
                    chE := flE
                    diagCandS := flS
                    diagCandE := flE
                    if legLongEnough and flPassed
                        chosenDeg := 0
                        haveWin := true
                bool needsFallback = false
                if haveWin
                    [legSteps, legCapped] = f_subWaveWindow(chosenDeg, chS, chE, ewcore.f_legRole(topPatternType, leg + 1))
                    historyChainCapActive := historyChainCapActive or legCapped
                    if array.size(legSteps) > 0
                        drawnSubDegLo := na(drawnSubDegLo) ? chosenDeg : math.min(drawnSubDegLo, chosenDeg)
                        drawnSubDegHi := na(drawnSubDegHi) ? chosenDeg : math.max(drawnSubDegHi, chosenDeg)
                        string chosenDegText = chosenDeg > 1 ? baseDeg + " (Deg+" + str.tostring(chosenDeg - 1) + ")" : chosenDeg == 0 ? floorDeg : baseDeg
                        f_drawSubWaveSteps(waveLabels, waveUnresolvedLines, legSteps, chosenDeg, chS, chE, chosenDeg,
                             baseOffT, baseOffB, showFinalSubWavePoint, legLetter,
                             chosenDegText + ". For a closer look, try timeframe: " + effNestedTF1, waveMSide, waveMRank, waveMAnchor, 10 + szSub, szInfo)
                        f_pinPushSubAll(legSteps, legLetter)
                        if effShowSubExpl
                            for esi = 0 to array.size(legSteps) - 1
                                ewcore.WaveCount eStep = array.get(legSteps, esi)
                                int eMidIdx = int(eStep.numPoints / 2)
                                array<float> eStepPr = array.from(eStep.w1e, eStep.w2e, eStep.w3e, eStep.w4e, eStep.w5e)
                                float eExplPr = array.get(eStepPr, eMidIdx)
                                int eExplTime = f_subWaveTime(chosenDeg, eStep.startIdx + 1 + eMidIdx)
                                bool eExplHigh = eMidIdx == 0 ? eExplPr > eStep.w1s : eExplPr > array.get(eStepPr, eMidIdx - 1)
                                float eExplOffset = (eExplHigh ? baseOffT : baseOffB)
                                float eAnchor = f_stepAnchor(eStep, eExplHigh)
                                ewcore.f_drawExplanationLabel(waveLabels, eExplTime, eExplHigh ? eAnchor + eExplOffset : eAnchor - eExplOffset, eExplHigh,
                                     subWaveExplanationBgColor, subWaveExplanationTextColor, subWaveExplanationSize_e,
                                     ewcore.f_patternExplanation(eStep.patternType, "", eStep.w1s, eStep.w1e, eStep.w2e, eStep.w3e, eStep.w4e, eStep.w5e))
                                f_regW(eExplHigh ? 1 : -1, 90 + szInfo, eAnchor)
                        if depth2Decomp
                            int dReg = array.size(waveLabels)
                            ewcore.f_depth2InnerLegs(waveLabels, waveUnresolvedLines, legSteps, f_subWaveLevelBars(chosenDeg), subPivotPrices, subPivotBars, subPivotTimes, pivotBars, pivotTimes, timeframe.period, chosenDeg - 1, cfg, rsiMomentumSeries, enableZigzag, enableImpulse, enableDiagonal, enableTriangle, enableCombo3, minScoreThreshold, wholeLegComboTolerance, subWaveMaxLegDominance, subLabelMinHoursEff * 3600.0 / timeframe.in_seconds(), f_subLabelColor(true), subLabelSize_e, baseOffT, baseOffB, showSubWaveLine, f_subLineCol(), f_subLineCol(), subWaveLineWidth, subWaveLineStyle, showUnresolvedLabel, showUnresolvedLine, baseOffB, unresolvedLabelBgColor, color.new(unresolvedLabelColor, 0), unresolvedLabelSize, unresLineCol, unresolvedLineWidth, unresolvedLineStyle, showFinalSubWavePoint)
                            f_regLibW(dReg, math.max(chosenDeg - 1, 0))
                    else
                        diagCandS := chS
                        diagCandE := chE
                        needsFallback := true
                else if legLongEnough
                    needsFallback := true
                if needsFallback
                    int fbN = na(diagCandE) or na(diagCandS) ? 0 : diagCandE - diagCandS + (degPath ? 1 : 0)
                    string fbDegText = topDegree > 1 ? baseDeg + " (Deg+" + str.tostring(topDegree - 1) + ")" : baseDeg
                    int fbReg = array.size(waveLabels)
                    ewcore.f_drawWholeLegFallbackFromArrays(waveLabels, waveUnresolvedLines, pivotTimes, dispPrices,
                         f_resolveToPrimaryIdx(topDegree, topStartIdx + leg), f_resolveToPrimaryIdx(topDegree, topStartIdx + leg + 1),
                         topStartIdx + leg, topStartIdx + leg + 1, fbN, legLetter, fbDegText,
                         showUnresolvedLabel, showUnresolvedLine, baseOffB,
                         unresolvedLabelBgColor, color.new(unresolvedLabelColor, 0), unresolvedLabelSize, unresLineCol, unresolvedLineWidth, unresolvedLineStyle)
                    if array.size(waveLabels) > fbReg
                        f_regW(-1, 90 + szInfo, label.get_y(array.get(waveLabels, fbReg)) + baseOffB)

    if pointCount > 0
        string explText = ewcore.f_patternExplanation(topPatternType, topComboStructure, w1s, w1e, w2e, w3e, w4e, w5e) +
             (topAnchoredStart ? "\n\nStart anchored: P0 is the verified extreme of the preceding structure (proper turning-point start)."
              : "\n\nCAUTION — count starts MID-MOVE: P0 is not the extreme of the preceding pivots. A count should begin at a meaningful turning point; treat this scenario as lower confidence.")
        if showExplanation
            int   midIdx = int(pointCount / 2)
            int   explTime = ewcore.f_recPointTime(array.get(labelPointBars, midIdx), pivotBars, pivotTimes, subPivotBars, subPivotTimes)
            float explPrice = array.get(labelPrices, midIdx)
            bool  explIsHigh = topIsRecovered ? (topIsUp ? midIdx % 2 == 0 : midIdx % 2 == 1) : array.get(dispTypes, topStartIdx + 1 + midIdx) == 1
            float explOffset = (explIsHigh ? baseOffT : baseOffB)
            float explY = explIsHigh ? explPrice + explOffset : explPrice - explOffset
            explLbl = label.new(explTime, explY, "i",
                 xloc = xloc.bar_time,
                 style = explIsHigh ? label.style_label_down : label.style_label_up,
                 color=explanationBgColor, textcolor=explanationTextColor, size=ewcore.getLabelSize(explanationSize_e),
                 tooltip=explText)
            array.push(waveLabels, explLbl)
            f_regW(explIsHigh ? 1 : -1, 90 + szExpl, explPrice)
        if pinExplanationPanel
            table.cell(pinExplTable, 0, 0, f_pinPanelText(topPatternType, explText), text_color=chart.fg_color, text_size=ewcore.getLabelSize(pinExplanationTextSize),
                 bgcolor=explanationBgColor, width=pinExplanationWidth)

    if showStatusBoxTable
        string baseDegree = ewcore.getDegreeLabel(timeframe.period)
        string currentDegree = baseDegree
        if topDegree > 1
            for s = 1 to topDegree - 1
                currentDegree := ewcore.shiftDegreeUp(currentDegree)
        string patternNote = topPatternType + (topDegree > 1 ? "  [" + currentDegree + "]" : "")
        statusTxt = noCandidatesFound ?
             "NO VALID PATTERN in current search range\n(no structurally valid pattern found — or a raised Minimum Score / anchor setting filtered everything out)" :
             (hardRulesValid ? "OK: " : "VIOLATION: ") + patternNote + "\n(latest COMPLETED structure — not a live wave)" + (useManualAnchor ? "\nAnchor: MANUAL" : "")
        if wave4Overlap and str.startswith(topPatternType, "Impulse")
            statusTxt := statusTxt + "\n(W4 overlap -> check Diagonal)"
        scoreOfTop = array.size(topCandidates) > 0 ? array.get(topCandidates, 0).scoreTotal : 0.0
        statusTxt := statusTxt + "\nScore: " + str.tostring(scoreOfTop, "#.#")

        tsSz = ewcore.getLabelSize(statusBoxSize)
        table.cell(statusTable, 0, 0, "", bgcolor=chart.bg_color)
        table.cell(statusTable, 1, 0, "", bgcolor=chart.bg_color)
        table.cell(statusTable, 0, 1, "Status", bgcolor=na, text_color=chart.fg_color, text_size=tsSz)
        table.cell(statusTable, 1, 1, hardRulesValid ? "OK" : "VIOLATION", bgcolor=na,
             text_color=hardRulesValid ? statusOkColor : statusFailColor, text_size=tsSz)
        table.cell(statusTable, 0, 2, "Pattern", text_color=chart.fg_color, text_size=tsSz)
        table.cell(statusTable, 1, 2, topPatternType, text_color=chart.fg_color, text_size=tsSz)
        table.cell(statusTable, 0, 3, "Score", text_color=chart.fg_color, text_size=tsSz)
        string cdDigest = ""
        int cdN = math.min(array.size(topCandidates), 8)
        if cdN > 0
            for cdI = 0 to cdN - 1
                ewcore.WaveCount cdC = array.get(topCandidates, cdI)
                cdDigest := cdDigest + str.tostring(cdI + 1) + ". " + cdC.patternType + "  " + str.tostring(cdC.scoreTotal, "#.#") + (cdC.isUp ? "  UP" : "  DOWN") + "  deg " + str.tostring(cdC.degree) + "\n"
        table.cell(statusTable, 1, 3, str.tostring(scoreOfTop, "#.#") + " (" + str.tostring(array.size(topCandidates)) + ")", text_color=chart.fg_color, text_size=tsSz,
             tooltip=cdDigest == "" ? "no candidates" : "Ranked candidates (score after all penalties, incl. 1.4.6 gate malus):\n" + cdDigest)
        table.cell(statusTable, 0, 4, "Degree", text_color=chart.fg_color, text_size=tsSz)
        table.cell(statusTable, 1, 4, currentDegree + (topDegree > 1 ? " (Deg+" + str.tostring(topDegree - 1) + ")" : ""), text_color=chart.fg_color, text_size=tsSz)
        string levelCounts = "1:" + str.tostring(array.size(pivotPrices))
        if array.size(levels) >= 1
            for lc = 1 to array.size(levels)
                levelCounts := levelCounts + "  " + str.tostring(lc + 1) + ":" + str.tostring(array.size(array.get(levels, lc - 1).prices))
        table.cell(statusTable, 0, 5, "Pivots/lvl", text_color=chart.fg_color, text_size=tsSz)
        table.cell(statusTable, 1, 5, levelCounts, text_color=chart.fg_color, text_size=tsSz,
             tooltip="Number of pivots stored per degree level, from the primary detection upward. READ THIS BEFORE TRUSTING A HIGH-DEGREE COUNT: a wave pattern needs six consecutive pivots on its level, so a level holding N pivots offers only N minus 5 possible windows. At 30 pivots that is 25 genuine alternatives to choose between; at 6 pivots it is exactly ONE, and the count on that level is not the best of several readings but the only arrangement the arithmetic permits. Verification is limited the same way: confirming a leg as a five needs at least six pivots of the level BELOW inside that one leg, and where the level is too thin the leg is honestly marked as unverifiable rather than confirmed on thin evidence. HOW MUCH HISTORY YOUR DATA SOURCE LOADS THEREFORE DECIDES WHICH DEGREES ARE MEANINGFUL AT ALL. Measured on XAUUSD daily, 2026-07-21: a source reaching back to 2012 produced levels of 414 / 49 / 26 / 6, while one reaching back to 1976 produced 1792 / 260 / 101 / 30 / 7 on the same symbol and TF. Only the second can support a Super Cycle reading. If the top levels here show single digits, drop to a lower degree or use a longer-history source.")
        if effShowSubLabels
            string subDegreeTxt = na(drawnSubDegLo) ? "none drawn" :
                 drawnSubDegLo == drawnSubDegHi ? ewcore.f_degreeNameFor(drawnSubDegLo, timeframe.period) :
                 ewcore.f_degreeNameFor(drawnSubDegLo, timeframe.period) + " … " + ewcore.f_degreeNameFor(drawnSubDegHi, timeframe.period)
            table.cell(statusTable, 0, 6, "Sub-Degree", text_color=chart.fg_color, text_size=tsSz)
            table.cell(statusTable, 1, 6, subDegreeTxt, text_color=chart.fg_color, text_size=tsSz,
                 tooltip="The Elliott degree the sub-waves of the leading scenario were ACTUALLY drawn at on this bar, read back from the decomposition instead of assumed. Up to v0.3.5.7 this cell showed one degree below the leading pattern, which was a guess: the engine searches downward per leg for the first compression level that carries enough pivots, so different legs can end up on different levels, and where the leading pattern sits on the base level the decomposition falls through to the finest sub-pivot series - a degree this cell could not express at all. Two names separated by an ellipsis mean the legs were not all decomposed on the same level. Shows none drawn when the duration gate or 1.6.9 suppressed every leg.")
        if showParentInfo and parentGateMode != "Off"
            string parentTxt = not parentHasValidParent ? "top of cascade" :
                 not parentStateFound ? parentTFUsed + ": no swing yet" :
                 parentTFUsed + " " + (parentStateIsUp ? "UP" : "DOWN") + " (proxy, inv " + str.tostring(parentStateInvLevel, format.mintick) + ")" +
                 (parentGateMode == "Off" ? " [off]" : parentGateFellBack ? " [FALLBACK: 0 passed]" : parentGateIsActive ? " [" + str.tostring(parentGateDiscardedCount) + " gated]" : "")
            color parentTxtColor = parentGateFellBack ? statusFailColor : chart.fg_color
            table.cell(statusTable, 0, 7, "Parent", text_color=chart.fg_color, text_size=tsSz)
            table.cell(statusTable, 1, 7, parentTxt, text_color=parentTxtColor, text_size=tsSz)
        if showSettingsSummary
            string anchorTxt = useManualAnchor ? "Manual" : anchorMode
            string rankTxt = rankingPriorityEff == "Degree-first (highest degree always wins)" ? "Degree-first" : "Recency-first"
            string settingsTxt = "Anchor: " + anchorTxt + "\nRank: " + rankTxt + "\nParentGate: " + parentGateMode
            table.cell(statusTable, 0, 10, "ATR mult (eff.)", text_color=chart.fg_color, text_size=tsSz)
            table.cell(statusTable, 1, 10, str.tostring(getATRMult(), "#.##"), text_color=chart.fg_color, text_size=tsSz)
            table.cell(statusTable, 0, 8, "Settings", text_color=chart.fg_color, text_size=tsSz)
            table.cell(statusTable, 1, 8, settingsTxt, text_color=chart.fg_color, text_size=tsSz)
        if showHistoryChain
            int covStart = math.min(chainAnchorD1, array.size(segCovered))
            int covEnd = na(chainAnchorEndD1) ? array.size(segCovered) : math.min(chainAnchorEndD1, array.size(segCovered))
            int covCount = 0
            int covTotal = covEnd - covStart
            if covTotal > 0
                for cvI = covStart to covEnd - 1
                    if array.get(segCovered, cvI)
                        covCount += 1
            string covTxt = covTotal > 0 ?
                 str.tostring(100.0 * covCount / covTotal, "#.#") + "% (" + str.tostring(covCount) + "/" + str.tostring(covTotal) + " legs)" : "n/a"
            string covLabelTxt = "Chain cover" + (historyChainCapActive ? " [capped]" : "") + ((useChainStartAnchor and chainAnchorD1 > 0) or (useChainEndAnchor and not na(chainAnchorEndD1)) ? " [anchored]" : "") + (chainRangeSwapped ? " [range swapped]" : "")
            string covTooltip = historyChainCapActive ?
                 "Performance safety cap (grpPerf) clipped the OLDEST end of the historical-chain range this bar to stay under TradingView's ~500ms loop-time ceiling — current budget: " + str.tostring(historyChainSafetyBudget) + ". The most recent history is never affected. Raise the budget in Settings if you want deeper coverage and have execution headroom; see that input's tooltip for details." :
                 "% of stored primary pivot legs the historical chain segmentation actually explained."
            table.cell(statusTable, 0, 9, covLabelTxt, text_color=historyChainCapActive ? statusFailColor : chart.fg_color, text_size=tsSz, tooltip=covTooltip)
            table.cell(statusTable, 1, 9, covTxt, text_color=chart.fg_color, text_size=tsSz)

if barstate.islast
    if array.size(sequelLabels) > 0
        for i = 0 to array.size(sequelLabels) - 1
            label.delete(array.get(sequelLabels, i))
    array.clear(sequelLabels)
    array.clear(seqMSide)
    array.clear(seqMRank)
    array.clear(seqMAnchor)

    if showSequelChain and showLabelText and array.size(sequelSteps) > 0
        for si3 = 0 to array.size(sequelSteps) - 1
            ewcore.WaveCount seg3 = array.get(sequelSteps, si3)
            array<string> seg3Texts = ewcore.f_notatedLabelTextArray(seg3.patternType, seg3.degree, timeframe.period)
            array<float>  seg3Pr = array.from(seg3.w1e, seg3.w2e, seg3.w3e, seg3.w4e, seg3.w5e)
            array<int>    seg3Br = array.from(seg3.w1eBar, seg3.w2eBar, seg3.w3eBar, seg3.w4eBar, seg3.w5eBar)
            float seg3Prev = seg3.w1s
            for pk = 0 to seg3.numPoints - 1
                float pr3 = array.get(seg3Pr, pk)
                int   br3 = array.get(seg3Br, pk)
                int   bt3 = ewcore.f_barValToTime(pivotBars, pivotTimes, br3)
                bool  high3 = pr3 > seg3Prev
                float off3 = (high3 ? baseOffT : baseOffB)
                float py3 = high3 ? pr3 + off3 : pr3 - off3
                sLbl3 = label.new(bt3, py3, array.get(seg3Texts, pk),
                     xloc = xloc.bar_time,
                     style = label.style_none,
                     textcolor = color.new(sequelLabelColor, 0),
                     size = lblSize)
                array.push(sequelLabels, sLbl3)
                ewcore.f_tagReg(sLbl3, str.length(array.get(seg3Texts, pk)), tagSeqT, tagSeqD, topDegree, timeframe.period, labelSize_e, tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
                array.push(seqMSide, high3 ? 1 : -1)
                array.push(seqMRank, 20 + szMain)
                array.push(seqMAnchor, pr3)
                seg3Prev := pr3

if barstate.islast
    if array.size(historyLabels) > 0
        for i = 0 to array.size(historyLabels) - 1
            label.delete(array.get(historyLabels, i))
    array.clear(historyLabels)
    array.clear(histMSide)
    array.clear(histMRank)
    array.clear(histMAnchor)
    if array.size(historyGapLines) > 0
        for i = 0 to array.size(historyGapLines) - 1
            line.delete(array.get(historyGapLines, i))
    array.clear(historyGapLines)
    if array.size(historyUnresolvedLines) > 0
        for i = 0 to array.size(historyUnresolvedLines) - 1
            line.delete(array.get(historyUnresolvedLines, i))
    array.clear(historyUnresolvedLines)
    array.clear(pinHistExpl)

    if showHistoryChain
        int segIndex = 0
        for stepI = 0 to array.size(chainSteps) - 1
            if stepI >= array.size(chainSteps) or stepI < 0
                continue
            ewcore.WaveCount stepBest = array.get(chainSteps, stepI)
            int stepPos = stepBest.startIdx
            segIndex := segIndex + 1
            hTexts  = ewcore.f_notatedLabelTextArray(stepBest.patternType, 1, timeframe.period)
            hPrices = array.from(stepBest.w1e, stepBest.w2e, stepBest.w3e, stepBest.w4e, stepBest.w5e)
            hBarsV  = array.from(stepBest.w1eBar, stepBest.w2eBar, stepBest.w3eBar, stepBest.w4eBar, stepBest.w5eBar)
            if stepBest.numPoints > 0
                for i = 0 to stepBest.numPoints - 1
                    hIsHigh = array.get(pivotTypes, stepPos + 1 + i) == 1
                    float hy = hIsHigh ? array.get(hPrices, i) + baseOffT : array.get(hPrices, i) - baseOffB
                    int hTimeV = ewcore.f_barValToTime(pivotBars, pivotTimes, array.get(hBarsV, i))
                    hLbl = label.new(hTimeV, hy, array.get(hTexts, i),
                         xloc=xloc.bar_time, style=label.style_none, textcolor=color.new(historyColor, 35), size=ewcore.getLabelSize(historyLabelSize_e))
                    array.push(historyLabels, hLbl)
                    ewcore.f_tagReg(hLbl, str.length(array.get(hTexts, i)), tagHistT, tagHistD, 1, timeframe.period, historyLabelSize_e, tagHosts, tagHostLn, tagDegs, tagTfs, tagMode, tagSzs)
                    f_regH(hIsHigh ? 1 : -1, 20 + szHist, array.get(hPrices, i))
                f_pinPushHist(stepBest, segIndex)
                if effShowHistExpl
                    int   midIdxH = int(stepBest.numPoints / 2)
                    hExplTime = ewcore.f_barValToTime(pivotBars, pivotTimes, array.get(hBarsV, midIdxH))
                    hExplIsHigh = array.get(pivotTypes, stepPos + 1 + midIdxH) == 1
                    float hExplY = hExplIsHigh ? array.get(hPrices, midIdxH) + baseOffT : array.get(hPrices, midIdxH) - baseOffB
                    hExplLbl = label.new(hExplTime, hExplY, "i",
                         xloc = xloc.bar_time,
                         style = hExplIsHigh ? label.style_label_down : label.style_label_up,
                         color=historyExplanationBgColor, textcolor=historyExplanationTextColor,
                         size=ewcore.getLabelSize(historyExplanationSize_e),
                         tooltip=ewcore.f_patternExplanation(stepBest.patternType, stepBest.comboStructure, stepBest.w1s, stepBest.w1e, stepBest.w2e, stepBest.w3e, stepBest.w4e, stepBest.w5e))
                    array.push(historyLabels, hExplLbl)
                    f_regH(hExplIsHigh ? 1 : -1, 90 + szInfo, array.get(hPrices, midIdxH))
                if effShowHistSub
                    string hSubDegName = ewcore.f_degreeNameFor(0, timeframe.period)
                    for hLeg = 0 to stepBest.legsConsumed - 1
                        int   hLb0 = array.get(pivotBars, stepPos + hLeg)
                        int   hLb1 = array.get(pivotBars, stepPos + hLeg + 1)
                        bool  hLegLongEnough = (hLb1 - hLb0) * timeframe.in_seconds() >= subLabelMinHoursEff * 3600
                        string hLegText = "leg " + str.tostring(hLeg + 1)
                        string hDegText = hSubDegName + " (Historical Chain)"
                        [hSi0, hSi1, hPassed] = ewcore.f_evalFloorLeg(subPivotBars, hLb0, hLb1, subWaveMaxLegDominance)
                        bool hNeedsFallback = false
                        if hLegLongEnough and hPassed
                            [hSteps, hStepsCapped] = f_subWaveWindow(0, hSi0, hSi1, ewcore.f_legRole(stepBest.patternType, hLeg + 1))
                            historyChainCapActive := historyChainCapActive or hStepsCapped
                            if array.size(hSteps) > 0
                                f_drawSubWaveSteps(historyLabels, historyUnresolvedLines, hSteps, 0, hSi0, hSi1, 0,
                                     baseOffT, baseOffB, showFinalSubWavePoint, hLegText, hDegText, histMSide, histMRank, histMAnchor, 10 + szSub, szInfo)
                            else
                                hNeedsFallback := true
                        else if hLegLongEnough
                            hNeedsFallback := true
                        if hNeedsFallback
                            int hFbReg = array.size(historyLabels)
                            ewcore.f_drawWholeLegFallbackFromPivots(historyLabels, historyUnresolvedLines, pivotTimes, pivotPrices, stepPos + hLeg, stepPos + hLeg + 1, hSi1 - hSi0, hLegText, hDegText,
                                 showUnresolvedLabel, showUnresolvedLine, baseOffB,
                                 unresolvedLabelBgColor, color.new(unresolvedLabelColor, 0), unresolvedLabelSize, unresLineCol, unresolvedLineWidth, unresolvedLineStyle)
                            if array.size(historyLabels) > hFbReg
                                f_regH(-1, 90 + szInfo, label.get_y(array.get(historyLabels, hFbReg)) + baseOffB)


var label[] fibZoneLabels = array.new_label(0)
var label[] invGuardLabels = array.new_label(0)
var float[] fibZoneOut = array.new_float(4, na)

f_fibDrawPass() =>
    array.clear(invGuardLabels)
    float fibQPrice = na
    int   fibQTime = na
    int   fibP0Time = na
    if not na(topStartIdx) and topStartIdx >= 1
        fibQPrice := array.get(levelPrices(topDegree), topStartIdx - 1)
        fibQTime := array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, topStartIdx - 1))
        fibP0Time := array.get(pivotTimes, f_resolveToPrimaryIdx(topDegree, topStartIdx))
    int fibW4eTime = na
    if not na(w4eBar)
        fibW4eTime := ewcore.f_recPointTime(w4eBar, pivotBars, pivotTimes, subPivotBars, subPivotTimes)
    int   fibLastPtBar = na
    float fibLastPtPrice = na
    if not na(topNumPoints)
        fibLastPtBar := topNumPoints >= 5 ? w5eBar : w3eBar
        fibLastPtPrice := topNumPoints >= 5 ? w5e : w3e
    int fibLastPtTime = na
    if not na(fibLastPtBar)
        fibLastPtTime := ewcore.f_barValToTime(pivotBars, pivotTimes, fibLastPtBar)
    int fibW5eTime = na
    if not na(w5eBar)
        fibW5eTime := ewcore.f_barValToTime(pivotBars, pivotTimes, w5eBar)
    ewcore.f_fibTargetsDraw(fibZoneLabels, fibZoneOut, w1s, w1e, w2e, w3e, w4e, w5e, topPatternType, topStartIdx, topInvalidationLevel, hardRulesValid, fibW4eTime, fibQPrice, fibQTime, fibP0Time, fibLastPtTime, fibLastPtPrice, fibW5eTime, showFibBoxes, showInvalidationLine, showInvalidationLabel, fibBoxExtendBarsEff, fibBoxColorNear, fibBoxColorFar, confluenceTolPct, confluenceZoneBorderColor, confluenceZoneBorderWidth, confluenceZoneBorderStyle, confluenceZoneBgColor, confluenceZoneTextColor, confluenceZoneTextSize_e, invalidationColor, invalidationLineStyle, invalidationLineWidth, invalidationRightOffsetEff, invalidationDotColor, measRefLineColor, measRefLineStyle, measRefLineWidth, measProjLineColor, measProjLineStyle, measProjLineWidth, fibTextSize_e, invalidationLabelSize_e, invalidationDotSize_e, invGuardLabels)
    ewcore.f_waveProjection(pivotPrices, pivotBars, pivotTimes, showProjection, projectedTargetScaleFactor, enableAutoProjScale, showProjectionConfluence, confluenceBandAtr, atr, projectionColor, targetProjectedBgColor, projectionLabelSize_e, hardRulesValid, topPatternType)

if barstate.islast
    f_fibDrawPass()

var label[] cgAll   = array.new_label(0)
var int[]   cgLines = array.new_int(0)
var int[]   cgSideA = array.new_int(0)
var int[]   cgRankA = array.new_int(0)
var float[] cgAnchA = array.new_float(0)
var bool[]  cgFixA  = array.new_bool(0)
var float[] cgXs    = array.new_float(0)

f_collisionGuard() =>
    array.clear(cgAll)
    array.clear(cgLines)
    array.clear(cgSideA)
    array.clear(cgRankA)
    array.clear(cgAnchA)
    array.clear(cgFixA)
    array.clear(cgXs)
    for cgLy = 0 to 3
        array<label> cgSrc = cgLy == 0 ? mtfLabels : cgLy == 1 ? waveLabels : cgLy == 2 ? sequelLabels : historyLabels
        array<int>   cgSdS = cgLy == 0 ? mtfMSide : cgLy == 1 ? waveMSide : cgLy == 2 ? seqMSide : histMSide
        array<int>   cgRkS = cgLy == 0 ? mtfMRank : cgLy == 1 ? waveMRank : cgLy == 2 ? seqMRank : histMRank
        array<float> cgAnS = cgLy == 0 ? mtfMAnchor : cgLy == 1 ? waveMAnchor : cgLy == 2 ? seqMAnchor : histMAnchor
        if (cgLy > 0 or mtfGuardInclude) and array.size(cgSrc) > 0
            for cgK = 0 to array.size(cgSrc) - 1
                label cgLb = array.get(cgSrc, cgK)
                array.push(cgAll, cgLb)
                array.push(cgSideA, array.get(cgSdS, cgK))
                array.push(cgRankA, array.get(cgRkS, cgK))
                array.push(cgAnchA, array.get(cgAnS, cgK))
                array.push(cgFixA, false)
                array.push(cgLines, math.max(1, array.size(str.split(label.get_text(cgLb), "\n"))))
                array.push(cgXs, label.get_x(cgLb))
    if array.size(fibZoneLabels) > 0
        for cgK = 0 to array.size(fibZoneLabels) - 1
            label cgFl = array.get(fibZoneLabels, cgK)
            if not na(cgFl)
                array.push(cgAll, cgFl)
                array.push(cgSideA, 0)
                array.push(cgRankA, 990 + math.max(0, array.indexof(szNam, fibTextSize)))
                array.push(cgAnchA, label.get_y(cgFl))
                array.push(cgFixA, true)
                array.push(cgLines, math.max(1, array.size(str.split(label.get_text(cgFl), "\n"))))
                array.push(cgXs, label.get_x(cgFl))
    float cgMinDy = guardZoomAuto and not na(visRange) ? visRange * guardZoomGapPct / 100.0 : collisionMinGapAtr * atr
    float cgMaxDt = guardZoomAuto ? visSpanMs * guardZoomWinPct / 100.0 : collisionBars * timeframe.in_seconds() * 1000
    int   cgN = array.size(cgAll)
    if cgN > 1 and cgMinDy > 0
        int[] cgOrd = array.sort_indices(cgXs, order.ascending)
        int cS = 0
        while cS < cgN
            int cE = cS
            float cX0 = array.get(cgXs, array.get(cgOrd, cS))
            while cE + 1 < cgN and array.get(cgXs, array.get(cgOrd, cE + 1)) - cX0 <= cgMaxDt
                cE += 1
            for cSd = 0 to 1
                int sdV = cSd == 0 ? 1 : -1
                int[] mIdx = array.new_int(0)
                for cM = cS to cE
                    int rI = array.get(cgOrd, cM)
                    if not array.get(cgFixA, rI) and array.get(cgSideA, rI) == sdV
                        int iP = array.size(mIdx)
                        while iP > 0 and array.get(cgRankA, array.get(mIdx, iP - 1)) > array.get(cgRankA, rI)
                            iP -= 1
                        array.insert(mIdx, iP, rI)
                int mN = array.size(mIdx)
                if mN > 0
                    float ext = array.get(cgAnchA, array.get(mIdx, 0))
                    if mN > 1
                        for eM = 1 to mN - 1
                            float eA = array.get(cgAnchA, array.get(mIdx, eM))
                            ext := sdV == 1 ? math.max(ext, eA) : math.min(ext, eA)
                    float cum = (sdV == 1 ? baseOffT : baseOffB)
                    float clrB = cgMinDy * stackClearance
                    for mM = 0 to mN - 1
                        int rgI = array.get(mIdx, mM)
                        float mH = array.get(cgLines, rgI) * cgMinDy * array.get(szTab, array.get(cgRankA, rgI) % 10)
                        float yTry = sdV == 1 ? ext + cum : ext - cum
                        for fF = cS to cE
                            int fI = array.get(cgOrd, fF)
                            if array.get(cgFixA, fI)
                                float fY = label.get_y(array.get(cgAll, fI))
                                float fH = array.get(cgLines, fI) * cgMinDy
                                if math.abs(yTry - fY) < (mH + fH) / 2.0
                                    cum += (mH + fH) / 2.0 - math.abs(yTry - fY) + cgMinDy * 0.25
                                    yTry := sdV == 1 ? ext + cum : ext - cum
                        label.set_y(array.get(cgAll, rgI), sdV == 1 ? ext + cum : ext - cum)
                        int tI = array.get(cgRankA, rgI) / 10
                        cum += mH + clrB + cgMinDy * (tI <= 1 ? clearanceSub : tI == 2 ? clearanceMain : tI == 9 ? clearanceInfo : clearanceOverlay)
            cS := cE + 1
    if array.size(invGuardLabels) > 0 and array.size(cgAll) > 0
        for ivI = 0 to array.size(invGuardLabels) - 1
            label ivL = array.get(invGuardLabels, ivI)
            if not na(ivL)
                float ivY = label.get_y(ivL)
                int   ivX = label.get_x(ivL)
                int   ivShift = ivX
                for cgJ = 0 to array.size(cgAll) - 1
                    label cgC = array.get(cgAll, cgJ)
                    if not na(cgC) and cgC != ivL and math.abs(label.get_y(cgC) - ivY) < cgMinDy * 2 and label.get_x(cgC) + math.round(cgMaxDt) > ivShift
                        ivShift := label.get_x(cgC) + math.round(cgMaxDt)
                if ivShift > ivX
                    label.set_x(ivL, ivShift)

if barstate.islast and showCollisionGuard
    f_collisionGuard()

if barstate.islast and array.size(tagHosts) > 0
    int   tgTz = math.max(0, array.indexof(szNam, tagSize))
    float tgTs = array.get(szTab, tgTz)
    for tgI = 0 to array.size(tagHosts) - 1
        label tgH   = array.get(tagHosts, tgI)
        string tgTf = array.get(tagTfs, tgI)
        int tgM = array.get(tagMode, tgI)
        string tgT  = (tgM != 2 ? f_tfTag(tgTf) : "") + (tgM == 3 ? "·" : "") +
             (tgM > 1 ? ewcore.f_degreeNameFor(array.get(tagDegs, tgI), tgTf) : "")
        float tgW = array.get(tagHostLn, tgI) * array.get(szTab, math.max(0, array.indexof(szNam, array.get(tagSzs, tgI)))) + str.length(tgT) * tgTs
        int tgPad = 3 + math.max(1, int(math.round(tgW / (tgTs * 0.64))))
        array.push(tagLbls, label.new(label.get_x(tgH), label.get_y(tgH), str.repeat(" ", tgPad) + tgT,
             xloc=xloc.bar_time, style=label.style_none, textcolor=color.new(chart.fg_color, 40),
             size=ewcore.getLabelSize(tagSize)))

bool waveCompletionSignal = barstate.isconfirmed and hardRulesValid and not na(topLastBar) and
     (array.size(pivotPrices) >= 4) and (array.get(pivotBars, array.size(pivotBars) - 1) == bar_index)

bool invalidationSignal = barstate.isconfirmed and not na(topInvalidationLevel) and hardRulesValid and
     ((topIsUp and close < topInvalidationLevel) or (not topIsUp and close > topInvalidationLevel))

bool targetZoneReached = barstate.isconfirmed and (
     (not na(array.get(fibZoneOut, 0)) and high >= array.get(fibZoneOut, 0) and low <= array.get(fibZoneOut, 1)) or
     (not na(array.get(fibZoneOut, 2)) and high >= array.get(fibZoneOut, 2) and low <= array.get(fibZoneOut, 3)))

bool scenarioChangeSignal = barstate.isconfirmed and topScenarioChanged

alertcondition(waveCompletionSignal, title="Wave Completion",
     message="{{ticker}} EW: Pattern confirmed at {{close}} ({{time}})")

alertcondition(invalidationSignal, title="Wave Invalidation",
     message="{{ticker}} EW: Invalidation level breached at {{close}} ({{time}})")

alertcondition(targetZoneReached, title="Fibonacci Target Reached",
     message="{{ticker}} EW: Fibonacci target zone reached at {{close}} ({{time}})")

alertcondition(scenarioChangeSignal, title="Leading Scenario Changed",
     message="{{ticker}} EW: Leading scenario has changed at {{close}} ({{time}})")

msgCompletion = '{"event":"wave_completion","ticker":"{{ticker}}","pattern":"' + topPatternType +
     '","direction":"' + (topIsUp ? "up" : "down") + '","score":' + str.tostring(topScore, "#.#") +
     ',"invalidation":' + str.tostring(topInvalidationLevel, "#.##") + ',"price":{{close}},"time":"{{time}}"}'

msgInvalidation = '{"event":"invalidation","ticker":"{{ticker}}","pattern":"' + topPatternType +
     '","invalidation_level":' + str.tostring(topInvalidationLevel, "#.##") +
     ',"price":{{close}},"time":"{{time}}"}'

msgTarget = '{"event":"target_reached","ticker":"{{ticker}}","pattern":"' + topPatternType +
     '","score":' + str.tostring(topScore, "#.#") + ',"price":{{close}},"time":"{{time}}"}'

msgScenario = '{"event":"scenario_change","ticker":"{{ticker}}","new_id":"' + lastTopId +
     '","pattern":"' + topPatternType + '","direction":"' + (topIsUp ? "up" : "down") +
     '","score":' + str.tostring(topScore, "#.#") + ',"invalidation":' +
     str.tostring(topInvalidationLevel, "#.##") + ',"price":{{close}},"time":"{{time}}"}'

if waveCompletionSignal
    alert(msgCompletion, alert.freq_once_per_bar)
if invalidationSignal
    alert(msgInvalidation, alert.freq_once_per_bar)
if targetZoneReached
    alert(msgTarget, alert.freq_once_per_bar)
if scenarioChangeSignal
    alert(msgScenario, alert.freq_once_per_bar)

plot(topInvalidationLevel, "Invalidation Reference", display=display.data_window, color=color.new(color.red,100))
plot(pivotThreshold, "ATR Pivot Threshold", display=display.data_window, color=color.new(color.blue,100))
plot(pivotMult, "ATR Multiplier (effective)", display=display.data_window, color=color.new(color.blue,100))

if barstate.islast and showDisplayWindow
    f_filterLabelsToWindow(waveLabels)
    f_filterLinesToWindow(waveUnresolvedLines)
    f_filterLabelsToWindow(historyLabels)
    f_filterLinesToWindow(historyGapLines)
    f_filterLinesToWindow(historyUnresolvedLines)
    f_filterLabelsToWindow(sequelLabels)
    f_filterLabelsToWindow(tagLbls)
