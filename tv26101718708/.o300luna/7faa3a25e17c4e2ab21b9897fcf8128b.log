    showMtfOverlay and on and timeframe.in_seconds(tf) > timeframe.in_seconds(timeframe.period)
mtfAct5 = f_mtfSlotHigher(mtfOn5, mtfTf5)
mtfAct6 = f_mtfSlotHigher(mtfOn6, mtfTf6)
mtfTf1Eff = mtfAct1 ? mtfTf1 : "1M"
mtfTf2Eff = mtfAct2 ? mtfTf2 : "1M"
mtfTf3Eff = mtfAct3 ? mtfTf3 : "1M"
mtfTf4Eff = mtfAct4 ? mtfTf4 : "1M"
mtfTf5Eff = mtfAct5 ? mtfTf5 : "1M"
mtfTf6Eff = mtfAct6 ? mtfTf6 : "1M"
mtfPack1 = request.security(syminfo.tickerid, mtfTf1Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)
mtfPack2 = request.security(syminfo.tickerid, mtfTf2Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)
mtfPack3 = request.security(syminfo.tickerid, mtfTf3Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)
mtfPack4 = request.security(syminfo.tickerid, mtfTf4Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)
mtfPack5 = request.security(syminfo.tickerid, mtfTf5Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)
mtfPack6 = request.security(syminfo.tickerid, mtfTf6Eff, f_mtfPack(), lookahead=barmerge.lookahead_off)


f_mbD(int mdK, float mdP) =>
    math.min(math.abs(high[mdK] - mdP), math.abs(low[mdK] - mdP))

f_mtfBarTime(int mbT, float mbP, float mbSec) =>
    int mbRes = mbT
    int mbNb  = math.min(bar_index, 1900)
    if not na(mbT) and not na(mbP) and mbNb > 1 and time[mbNb] <= mbT
        int mbLo = 0
        int mbHi = mbNb
        for mbIt = 1 to 12
            if mbLo >= mbHi
                break
            int mbMid = int((mbLo + mbHi) / 2)
            if time[mbMid] > mbT
                mbLo := mbMid + 1
            else
                mbHi := mbMid
        int   mbBest = mbLo
        float mbDist = f_mbD(mbLo, mbP)
        int   mbEnd  = mbT + int(mbSec * 1000)
        for mbS = 1 to 250
            int mbJ = mbLo - mbS
            if mbJ < 0
                break
            if time[mbJ] >= mbEnd
                break
            float mbD = f_mbD(mbJ, mbP)
            if mbD < mbDist
                mbDist := mbD
                mbBest := mbJ
        mbRes := time[mbBest]
    mbRes

