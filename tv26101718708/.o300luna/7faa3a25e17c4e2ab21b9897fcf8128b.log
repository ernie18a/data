f_pinPushHist(ewcore.WaveCount st, int segIdx) =>
    if pinExplanationPanel and pinExplanationSource == "Historical segment"
        array.push(pinHistExpl, "Historical segment #" + str.tostring(segIdx) + " — " + st.patternType + "\n\n" + ewcore.f_patternExplanation(st.patternType, st.comboStructure, st.w1s, st.w1e, st.w2e, st.w3e, st.w4e, st.w5e))
    array.size(pinHistExpl)

f_pinPushSubAll(array<ewcore.WaveCount> steps, string legTxt) =>
    if pinExplanationPanel and pinExplanationSource == "Sub-wave segment" and array.size(steps) > 0
        for i = 0 to array.size(steps) - 1
            ewcore.WaveCount st = array.get(steps, i)
            array.push(pinSubExpl, "Sub-wave segment #" + str.tostring(array.size(pinSubExpl) + 1) + " — " + st.patternType + " (inside leg " + legTxt + ")\n\n" + ewcore.f_patternExplanation(st.patternType, "", st.w1s, st.w1e, st.w2e, st.w3e, st.w4e, st.w5e))
    array.size(pinSubExpl)

f_pinPanelText(string leadType, string leadTxt) =>
    int nH = array.size(pinHistExpl)
    int nS = array.size(pinSubExpl)
    string res = "Leading scenario — " + leadType + "\n\n" + leadTxt
    if pinExplanationSource == "Historical segment"
        int selH = math.min(pinExplanationSegmentIdx, math.max(nH - 1, 0))
        res := nH == 0 ? "Historical segment — nothing to pin.\n\nNo explained historical segment exists on this chart. Check 1.7.1, or set 1.9.8 back to 'Leading scenario'." : array.get(pinHistExpl, nH - 1 - selH) + "\n\nShowing segment " + str.tostring(selH) + " of 0.." + str.tostring(nH - 1) + " (0 = newest, choose with 1.9.9)"
    else if pinExplanationSource == "Sub-wave segment"
        int selS = math.min(pinExplanationSegmentIdx, math.max(nS - 1, 0))
        res := nS == 0 ? "Sub-wave segment — nothing to pin.\n\nNo sub-wave segment was resolved on this chart. Check 1.6.7, or set 1.9.8 back to 'Leading scenario'." : array.get(pinSubExpl, nS - 1 - selS) + "\n\nShowing segment " + str.tostring(selS) + " of 0.." + str.tostring(nS - 1) + " (0 = newest, choose with 1.9.9)"
    f_wrapText(res, pinExplanationWrapChars)

