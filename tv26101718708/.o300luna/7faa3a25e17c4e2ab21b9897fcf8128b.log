levelPrices(int deg) =>
    deg <= 1 ? pivotPrices : array.get(levels, deg - 2).prices
levelBars(int deg) =>
    deg <= 1 ? pivotBars : array.get(levels, deg - 2).bars
levelTypes(int deg) =>
    deg <= 1 ? pivotTypes : array.get(levels, deg - 2).types
levelSrcIdx(int deg) =>
    array.get(levels, deg - 2).srcIdx
maxActiveDegree() =>
    1 + array.size(levels)

f_revalidateCandidate(ewcore.WaveCount c, ewcore.EngineConfig rvCfg, float rsiSeries) =>
    array<float> rvP = levelPrices(c.degree)
    array<int>   rvB = levelBars(c.degree)
    array<float> rvValP = c.degree == 1 ? subPivotPrices : levelPrices(c.degree - 1)
    array<int>   rvValB = c.degree == 1 ? subPivotBars   : levelBars(c.degree - 1)
    array.size(rvValB) == 0 ? c : ewcore.revalidateCandidate(c, rvP, rvB, rvValP, rvValB, rvCfg, rsiSeries)

f_resolveToPrimaryIdx(int deg, int idx) =>
    int cur = idx
    if deg > 1
        for d = deg to 2
            cur := array.get(levelSrcIdx(d), cur)
    cur

bisectToTargetCount(array<float> srcP, array<int> srcB, int target) =>
    float lo = 0.5
    float hi = 60.0
    array<float> bestP = array.new_float(0)
    array<int>   bestB = array.new_int(0)
    array<int>   bestT = array.new_int(0)
    array<int>   bestS = array.new_int(0)
    int   bestDiff = 999999
    for iter = 1 to 25
        float mid = (lo + hi) / 2.0
        [cp, cb, ct, cs] = ewcore.compressPivotLevel(srcP, srcB, mid)
        int cnt = array.size(cp)
        int diffN = math.abs(cnt - target)
        if diffN < bestDiff
            bestDiff := diffN
            bestP := cp
            bestB := cb
            bestT := ct
            bestS := cs
        if cnt > target
            lo := mid
        else if cnt < target
            hi := mid
        else
            break
    [bestP, bestB, bestT, bestS]

firstIdxAtOrAfter(array<int> arr, int target) =>
    int n = array.size(arr)
    int result = n
    if n > 0
        for i = 0 to n - 1
            if array.get(arr, i) >= target
                result := i
                break
    result

