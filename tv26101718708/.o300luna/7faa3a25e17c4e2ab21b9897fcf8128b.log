// =====================================================================================
//@version=6
indicator("EWCore v0.3.8.7", shorttitle="EWCore", overlay=true,
          max_bars_back=2000, max_lines_count=500, max_labels_count=500,
          max_boxes_count=100)

import Wick-Sniper/EWCoreLib/9 as ewcore

grpMtfOv = "1.1 Multi-Timeframe Wave Overlay"
showMtfOverlay = input.bool(true, "1.1.1 Show multi-timeframe wave overlay", group=grpMtfOv,
     tooltip="Draws the leading scenario of one to four OTHER TFs on top of this chart. Each target level is analysed on its own real bars, so its ATR, threshold and multiplier are the ones that level would use on its own chart - nothing has to be measured or entered by hand. Cost rule of thumb: a target level costs roughly CHART MINUTES divided by TARGET MINUTES in extra computation. Levels ABOVE the chart are nearly free; levels BELOW multiply the load (60m chart with a 15m target = about 4x). A slot whose TF EQUALS the chart TF is skipped automatically - the native count already shows that level. NOTE: the overlaid structure may lie far in the past - zoom out to see it. If drawings ever float off the candles, re-pin the indicator to the symbol scale (chart legend > three dots > pin to scale); Pine cannot set this from code.")
mtfOn1 = input.bool(true, "1.1.2 Target 1 on", group=grpMtfOv, inline="mtf1",
     tooltip="Master switch for target slot 1. OFF leaves the TF next to it untouched but draws nothing and runs no analysis pass for this slot, so you can park a TF here and switch it in and out without retyping it.")
mtfTf1 = input.timeframe("5", "1.1.3 Target timeframe 1", group=grpMtfOv, inline="mtf1",
     tooltip="First foreign TF to overlay. Any resolution the chart supports may be entered, not just the common ones: 7, 45 and 90 minutes are as valid as 5, 15 or 240. A slot whose TF equals the chart TF is skipped automatically, because the native count already shows that level. Seconds-based resolutions are accepted by the picker but are not intended here - they multiply the computation and the tag would round to M0. THE DROPDOWN IS TRADINGVIEW'S OWN RESOLUTION PICKER, not a list this indicator defines: its entries, including ticks and range bars, come from TradingView and vary by symbol and plan. Tick and range resolutions are not time-based; EWCore has not been tested on them and cannot guarantee that the overlay or its tag is correct there. If a resolution cannot be read as a number, the tag falls back to printing the raw resolution string unchanged.")
mtfOn2 = input.bool(true, "1.1.4 Target 2 on", group=grpMtfOv, inline="mtf2",
     tooltip="Master switch for target slot 2.")
mtfTf2 = input.timeframe("15", "1.1.5 Target timeframe 2", group=grpMtfOv, inline="mtf2",
     tooltip="Second foreign TF to overlay. Free choice of resolution, same rules as 1.1.3.")
mtfOn3 = input.bool(true, "1.1.6 Target 3 on", group=grpMtfOv, inline="mtf3",
     tooltip="Master switch for target slot 3.")
mtfTf3 = input.timeframe("30", "1.1.7 Target timeframe 3", group=grpMtfOv, inline="mtf3",
     tooltip="Third foreign TF to overlay. Free choice of resolution, same rules as 1.1.3. Each ACTIVE slot adds one full analysis pass on that level.")
mtfOn4 = input.bool(true, "1.1.8 Target 4 on", group=grpMtfOv, inline="mtf4",
     tooltip="Master switch for target slot 4.")
mtfTf4 = input.timeframe("60", "1.1.9 Target timeframe 4", group=grpMtfOv, inline="mtf4",
     tooltip="Fourth foreign TF to overlay. Free choice of resolution, same rules as 1.1.3.")
mtfCol1 = input.color(color.aqua, "1.1.10 Colour target 1", group=grpMtfOv,
     tooltip="Colour for this slot's label text and connecting line. The transparency slider inside the colour picker affects the LINE only; the label text always draws fully opaque. Same for the three slots below.")
mtfCol2 = input.color(color.orange, "1.1.11 Colour target 2", group=grpMtfOv)
mtfCol3 = input.color(color.fuchsia, "1.1.12 Colour target 3", group=grpMtfOv)
mtfCol4 = input.color(color.lime, "1.1.13 Colour target 4", group=grpMtfOv)
mtfLabelSize = input.string("large", "1.1.14 Label size target 1", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfSize2 = input.string("large", "1.1.15 Label size target 2", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfSize3 = input.string("huge", "1.1.16 Label size target 3", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfSize4 = input.string("huge", "1.1.17 Label size target 4", options=["tiny", "small", "normal", "large", "huge"], group=grpMtfOv)
mtfShowText = input.bool(true, "1.1.19 Show label text", group=grpMtfOv,
     tooltip="The wave notation itself, drawn as bare text in the slot's own colour from 1.1.10-1.1.13. The text always draws fully opaque; the line's transparency comes from the slider inside the slot's colour field. OFF leaves only the connecting line.")
mtfTagT = input.bool(true, "1.1.21 Overlay tag: show timeframe", group=grpMtfOv,
     tooltip="Puts the TF into the tag of this label type, in the short form M5 / M90 / H1 / H4 / D1 / W1 / 1M - minutes and hours carry the unit in front, calendar months behind it, so M1 is one minute and 1M is one month. For the overlay this is the TF of the TARGET level, not of the chart, and it is what tells two overlay slots apart when both carry the same notation. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. The size is shared across all types (1.6.19); fading and distance are fixed.")
mtfTagD = input.bool(false, "1.1.22 Overlay tag: show degree", group=grpMtfOv,
     tooltip="Puts the Elliott degree name into the tag of this label type - Subminuette, Minuette, Micro and so on. For the overlay that is the degree the target level counts at - a scenario read on M30 sits above the same scenario read on M15, and this is where you see it. Independent of every other tag switch: each label type decides for itself whether it shows the TF, the degree, both or neither - and with both off that type draws no tag at all. With both on, the two are separated by a middle dot, which is the widest form.")
mtfShowLine = input.bool(true, "1.1.23 Show connecting line per target level", group=grpMtfOv,
     tooltip="Connects the points of each overlaid count with a line, so the foreign structure is readable without reading the labels.")
mtfLineStyle1 = input.string("Dotted", "1.1.36 Line style target 1", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv,
     tooltip="Style of the connecting line for this target level. Set separately per slot, like colour and label size.")
mtfLineStyle2 = input.string("Dotted", "1.1.37 Line style target 2", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv)
mtfLineStyle3 = input.string("Dotted", "1.1.38 Line style target 3", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv)
mtfLineStyle4 = input.string("Dotted", "1.1.39 Line style target 4", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv)
mtfLineStyle5 = input.string("Dotted", "1.1.40 Line style target 5", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv)
mtfLineStyle6 = input.string("Dotted", "1.1.41 Line style target 6", options=["Solid", "Dashed", "Dotted"], group=grpMtfOv)
mtfLineWidth1 = input.int(1, "1.1.42 Line width target 1", minval=1, maxval=4, group=grpMtfOv,
