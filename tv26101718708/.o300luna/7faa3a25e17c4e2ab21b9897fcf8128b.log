f_autoParentTF(string chartTF, int shift) =>
    array<int>    csArr = array.from(300, 900, 1800, 3600, 14400, 86400, 604800, 2592000)
    array<string> tfArr = array.from("5", "15", "30", "60", "240", "1D", "1W", "1M")
    int cs = timeframe.in_seconds(chartTF)
    string p = na
    if not na(cs)
        int baseIdx = -1
        for i = 0 to array.size(csArr) - 1
            if cs < array.get(csArr, i)
                baseIdx := i
                break
        if baseIdx >= 0
            int shiftedIdx = baseIdx + shift
            if shiftedIdx >= 0 and shiftedIdx < array.size(tfArr)
                p := array.get(tfArr, shiftedIdx)
    p

f_exportParentProxy() =>
    [proxyIsUp, proxyInvLevel, proxyLastTime]

resolvedParentTFRaw = autoParentTF ? f_autoParentTF(timeframe.period, parentCascadeShift) : manualParentTF
hasValidParentTF    = not na(resolvedParentTFRaw) and str.length(resolvedParentTFRaw) > 0 and resolvedParentTFRaw != timeframe.period
resolvedParentTF    = hasValidParentTF ? resolvedParentTFRaw : timeframe.period

[parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime] =
     request.security(syminfo.tickerid, resolvedParentTF, f_exportParentProxy(), lookahead=barmerge.lookahead_off)
parentProxyFound = not na(parentProxyLastTime)

searchPatterns(array<float> pP, array<int> pB, array<float> vP, array<int> vB, int degree, array<ewcore.WaveCount> acc, int forceStart) =>
    int n = array.size(pP)
    int s6  = forceStart >= 0 ? forceStart : math.max(0, math.min(n - 6, n - recentSearchLimit))
    int s4  = forceStart >= 0 ? forceStart : math.max(0, math.min(n - 4, n - recentSearchLimit))
    int s8  = forceStart >= 0 ? forceStart : math.max(0, math.min(n - 8, n - recentSearchLimit))
    int s12 = forceStart >= 0 ? forceStart : math.max(0, math.min(n - 12, n - recentSearchLimit))
    if n >= 6 and s6 <= n - 6
        for startIdx = s6 to n - 6
            if enableImpulse
                impCand = ewcore.evaluateImpulseWindow(pP, pB, vP, vB, degree, startIdx, cfg, rsiMomentumSeries)
                if impCand.hardRulesPassed
                    array.push(acc, impCand)
            if enableDiagonal
                diagCand = ewcore.evaluateDiagonalWindow(pP, pB, vP, vB, degree, startIdx, cfg, rsiMomentumSeries)
                if diagCand.hardRulesPassed
                    array.push(acc, diagCand)
            if enableTriangle
                triCand = ewcore.evaluateTriangleWindow(pP, pB, vP, vB, degree, startIdx, cfg, rsiMomentumSeries)
                if triCand.hardRulesPassed
                    array.push(acc, triCand)
    if n >= 4 and enableZigzag and s4 <= n - 4
        for startIdx2 = s4 to n - 4
            zfCand = ewcore.evaluateZigzagFlatWindow(pP, pB, vP, vB, degree, startIdx2, cfg, rsiMomentumSeries)
            if zfCand.hardRulesPassed
                array.push(acc, zfCand)
    if n >= 4 and enableImpulse and enableImpulseRecovery and s4 <= n - 4
        for startIdxR = s4 to n - 4
            recCand = ewcore.evaluateImpulseRecoveredWindow(pP, pB, vP, vB, degree, startIdxR, cfg, rsiMomentumSeries)
            if recCand.hardRulesPassed
                recCand.scoreTotal := math.max(0.0, recCand.scoreTotal - recoveredPivotMalus)
                recCand.confidenceTier := recCand.scoreTotal > 80 ? "high" : recCand.scoreTotal >= 60 ? "moderate" : "low"
                array.push(acc, recCand)
    if n >= 8 and enableCombo3 and s8 <= n - 8
        for startIdx3 = s8 to n - 8
            comboCand = ewcore.evaluateComboWXYWindow(pP, pB, vP, vB, degree, startIdx3, cfg, rsiMomentumSeries)
            if comboCand.hardRulesPassed
                array.push(acc, comboCand)
    if n >= 12 and enableCombo5 and s12 <= n - 12
        for startIdx4 = s12 to n - 12
            combo5Cand = ewcore.evaluateComboWXYXZWindow(pP, pB, vP, vB, degree, startIdx4, cfg, rsiMomentumSeries)
            if combo5Cand.hardRulesPassed
                array.push(acc, combo5Cand)
    true

f_fillRankStages(array<ewcore.WaveCount> cands, array<int> out, int bandB, array<int> degBand, int maxDeg, int rows, string aMode, string rPrio, bool d2Pref) =>
    array.clear(out)
    for r = 0 to math.max(rows, 1) - 1
        int st = 0
        if r + 1 < array.size(cands)
            [s2, w2] = ewcore.f_rankStage(array.get(cands, r), array.get(cands, r + 1), bandB, degBand, maxDeg, aMode, rPrio, d2Pref)
            st := s2
        array.push(out, st)
    true

if barstate.islast
    n = array.size(pivotPrices)

    array.clear(levels)
    if extraCompressionLevelsEff > 0 and n >= 8
        array<float> srcP = pivotPrices
        array<int>   srcB = pivotBars
        float effMult = degree2Mult
        for lvl = 1 to extraCompressionLevelsEff
            [cp, cb, ct, cs] = ewcore.compressPivotLevel(srcP, srcB, effMult)
            array.push(levels, PivotLevel.new(cp, cb, ct, cs))
            if array.size(cp) < 4
                break
            srcP := cp
            srcB := cb
            effMult := effMult * levelGrowthFactor

        if autoCalibrateEnabledEff
            array<float> calSrcP = pivotPrices
            array<int>   calSrcB = pivotBars
            int calSrcPos = 0
            if array.size(levels) >= 1
                for lvl = 1 to array.size(levels)
                    pl2 = array.get(levels, lvl - 1)
                    if array.size(pl2.prices) > autoTargetPivots
                        calSrcP := pl2.prices
                        calSrcB := pl2.bars
                        calSrcPos := lvl
            if array.size(calSrcP) > autoTargetPivots
                [acp, acb, act, acs] = bisectToTargetCount(calSrcP, calSrcB, autoTargetPivots)
                if array.size(acp) >= 4
                    while array.size(levels) > calSrcPos
                        array.pop(levels)
                    array.push(levels, PivotLevel.new(acp, acb, act, acs))

    int anchorD1 = -1
    array<int> anchorPerLevel = array.new_int(0)
    if useManualAnchor and n > 0
        anchorD1 := n
        for ai = 0 to n - 1
            if array.get(pivotTimes, ai) >= anchorTime
                anchorD1 := ai
                break
        int prevAnchor = anchorD1
        if array.size(levels) >= 1
            for lvl = 1 to array.size(levels)
                array<int> sIdx = array.get(levels, lvl - 1).srcIdx
                int a = firstIdxAtOrAfter(sIdx, prevAnchor)
                array.push(anchorPerLevel, a)
                prevAnchor := a

    allCandidates = array.new<ewcore.WaveCount>(0)
    searchPatterns(pivotPrices, pivotBars, subPivotPrices, subPivotBars, 1, allCandidates, anchorD1)
    if array.size(levels) >= 1
        for lvl = 1 to array.size(levels)
            pl = array.get(levels, lvl - 1)
            int deg = lvl + 1
            if array.size(pl.prices) >= 4
                array<float> belowP = deg == 2 ? pivotPrices : array.get(levels, lvl - 2).prices
                array<int>   belowB = deg == 2 ? pivotBars   : array.get(levels, lvl - 2).bars
                int aVal = useManualAnchor ? array.get(anchorPerLevel, lvl - 1) : -1
                searchPatterns(pl.prices, pl.bars, belowP, belowB, deg, allCandidates, aVal)

    bool parentGateActive = parentGateMode != "Off" and hasValidParentTF and parentProxyFound
    parentHasValidParent := hasValidParentTF
    parentGateIsActive   := parentGateActive
    parentStateFound     := parentProxyFound
    parentStateIsUp      := parentProxyIsUp
    parentStateInvLevel  := parentProxyInvLevel
    parentTFUsed         := resolvedParentTF

    if parentGateActive
        int gateDiscarded = 0
        if parentGateMode == "Hard (discard)"
            gatedCandidates = array.new<ewcore.WaveCount>(0)
            if array.size(allCandidates) > 0
                for gi = 0 to array.size(allCandidates) - 1
                    c = array.get(allCandidates, gi)
                    int cP0TimeH = array.get(pivotTimes, f_resolveToPrimaryIdx(c.degree, c.startIdx))
                    [gateOk, timeOk, dirOk] = ewcore.f_parentGateCheck(c, cP0TimeH, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars)
                    if gateOk
                        array.push(gatedCandidates, c)
                    else
                        gateDiscarded += 1
            if array.size(gatedCandidates) > 0
                array.clear(allCandidates)
                for gi = 0 to array.size(gatedCandidates) - 1
                    array.push(allCandidates, array.get(gatedCandidates, gi))
                parentGateFellBack := false
            else
                parentGateFellBack := true
        else if parentGateMode == "Soft (score malus)"
            if array.size(allCandidates) > 0
                for gi = 0 to array.size(allCandidates) - 1
                    c = array.get(allCandidates, gi)
                    int cP0TimeS = array.get(pivotTimes, f_resolveToPrimaryIdx(c.degree, c.startIdx))
                    [gateOk, timeOk, dirOk] = ewcore.f_parentGateCheck(c, cP0TimeS, parentProxyIsUp, parentProxyInvLevel, parentProxyLastTime, resolvedParentTF, parentTimeToleranceBars)
                    if not gateOk
                        float effGateMalus = str.contains(c.countId, "RI") ? math.max(0.0, parentGateMalus - recoveredPivotMalus) : parentGateMalus
                        c.scoreTotal := math.max(0.0, c.scoreTotal - effGateMalus)
                        gateDiscarded += 1
            parentGateFellBack := false
        parentGateDiscardedCount := gateDiscarded
    else
        parentGateFellBack := false
        parentGateDiscardedCount := 0

    int bandBars = n >= 2 ? recencyBandPivots * math.max(1, (array.get(pivotBars, n - 1) - array.get(pivotBars, 0)) / (n - 1)) : recencyBandPivots

    int maxDegHere = maxActiveDegree()
    array<int> degreeBandBars = array.new_int(maxDegHere + 1, bandBars)
    for dgb = 1 to maxDegHere
        array<int> dgbBars = levelBars(dgb)
        int dgbN = array.size(dgbBars)
        if dgbN >= 2
            array.set(degreeBandBars, dgb, recencyBandPivots * math.max(1, (array.get(dgbBars, dgbN - 1) - array.get(dgbBars, 0)) / (dgbN - 1)))

    csize = array.size(allCandidates)
    if csize >= 2
        for i = 0 to csize - 2
            bestIdx = i
            for j = i + 1 to csize - 1
                cJ = array.get(allCandidates, j)
                cBest = array.get(allCandidates, bestIdx)
                [stJ, jWins] = ewcore.f_rankStage(cJ, cBest, bandBars, degreeBandBars, maxDegHere, anchorMode, rankingPriorityEff, degree2PreferenceEff)
                if jWins
                    bestIdx := j
            if bestIdx != i
                tmp = array.get(allCandidates, i)
                array.set(allCandidates, i, array.get(allCandidates, bestIdx))
                array.set(allCandidates, bestIdx, tmp)

    array.clear(topCandidates)
    topN = math.min(maxAlternatives, csize)
    if topN > 0
        for i = 0 to topN - 1
            array.push(topCandidates, array.get(allCandidates, i))

    var int revalStatTotalChecks   = 0
    var int revalStatAnyFlipped    = 0
    var int revalStatLeadingFlipped = 0
    if array.size(topCandidates) > 0
        for i = 0 to array.size(topCandidates) - 1
            preC = array.get(topCandidates, i)
            bool preOk = preC.hardRulesPassed
            revalidated = f_revalidateCandidate(preC, cfg, rsiMomentumSeries)
            array.set(topCandidates, i, revalidated)
            revalStatTotalChecks := revalStatTotalChecks + 1
            if revalidated.hardRulesPassed != preOk
                revalStatAnyFlipped := revalStatAnyFlipped + 1
                if i == 0
                    revalStatLeadingFlipped := revalStatLeadingFlipped + 1

    int revalPreFilterCount = array.size(topCandidates)
    array<ewcore.WaveCount> revalKept = array.new<ewcore.WaveCount>(0)
    if array.size(topCandidates) > 0
        for i = 0 to array.size(topCandidates) - 1
            cKeep = array.get(topCandidates, i)
            if cKeep.hardRulesPassed and cKeep.scoreTotal >= minScoreThreshold
                array.push(revalKept, cKeep)
    array.clear(topCandidates)
    if array.size(revalKept) > 0
        for i = 0 to array.size(revalKept) - 1
            array.push(topCandidates, array.get(revalKept, i))

    f_fillRankStages(topCandidates, rankStages, bandBars, degreeBandBars, maxDegHere, maxAlternatives, anchorMode, rankingPriorityEff, degree2PreferenceEff)

    if barstate.islast
        log.info("Revalidate stats (cumulative): checks={0} anyFlipped={1} leadingFlipped={2} | this bar: before filter={3} after filter={4}",
             revalStatTotalChecks, revalStatAnyFlipped, revalStatLeadingFlipped, revalPreFilterCount, array.size(topCandidates))

    if array.size(topCandidates) > 0
        noCandidatesFound := false
        top = array.get(topCandidates, 0)
        bool scenarioIsChanging = top.countId != lastTopId

        hardRulesValid := top.hardRulesPassed
        wave4Overlap   := top.wave4Overlap
        w1s := top.w1s
        w1e := top.w1e
        w2e := top.w2e
        w3e := top.w3e
        w4e := top.w4e
        w5e := top.w5e
        w1eBar := top.w1eBar
        w2eBar := top.w2eBar
        w3eBar := top.w3eBar
        w4eBar := top.w4eBar
        w5eBar := top.w5eBar
        topStartIdx := top.startIdx
        topIsRecovered := str.contains(top.countId, "RI")
        topNumPoints := top.numPoints
        topDegree := top.degree
        topAnchoredStart := top.anchoredStart
        topLegsConsumed := top.legsConsumed
        topComboStructure := top.comboStructure
        topPatternType := top.patternType
        topExtInfo := top.extInfo
        topInvalidationLevel := top.invalidationLevel
        topIsUp := top.isUp
        topLastBar := top.numPoints >= 5 ? top.w5eBar : top.w3eBar
        topStartTime := array.get(pivotTimes, f_resolveToPrimaryIdx(top.degree, top.startIdx))
        int topEndIdxOwnDeg = top.startIdx + top.legsConsumed
        topLastTime := array.get(pivotTimes, f_resolveToPrimaryIdx(top.degree, topEndIdxOwnDeg))
        topScore := top.scoreTotal
        topScenarioChanged := scenarioIsChanging
        lastTopId := top.countId
    else
        noCandidatesFound := true
        topScenarioChanged := false

f_mtfPack() =>
    string s = ""
    if not na(topStartIdx) and not na(w1e) and not na(topStartTime)
        int np = na(topNumPoints) ? 5 : math.min(topNumPoints, 5)
        array<float> packPr = array.from(w1e, w2e, w3e, w4e, w5e)
        array<int>   packBr = array.from(w1eBar, w2eBar, w3eBar, w4eBar, w5eBar)
        s := topPatternType + "|" + str.tostring(topDegree) + "|" + str.tostring(topIsUp ? 1 : 0) + "|" + str.tostring(w1s) + "|" + str.tostring(topStartTime)
        if np > 0
            for pi = 0 to np - 1
                float packP = array.get(packPr, pi)
                int   packT = ewcore.f_recPointTime(array.get(packBr, pi), pivotBars, pivotTimes, subPivotBars, subPivotTimes)
                if not na(packP) and not na(packT)
                    s := s + "|" + str.tostring(packT) + ":" + str.tostring(packP)
    s

