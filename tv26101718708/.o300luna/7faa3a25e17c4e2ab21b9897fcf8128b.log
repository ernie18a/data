    showMtfOverlay and on and timeframe.in_seconds(tf) != timeframe.in_seconds(timeframe.period)
mtfAct1 = f_mtfSlotActive(mtfOn1, mtfTf1)
mtfAct2 = f_mtfSlotActive(mtfOn2, mtfTf2)
mtfAct3 = f_mtfSlotActive(mtfOn3, mtfTf3)
mtfAct4 = f_mtfSlotActive(mtfOn4, mtfTf4)
