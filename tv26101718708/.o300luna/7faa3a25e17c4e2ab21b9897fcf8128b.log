chainStartMarkerColor = input.color(color.new(color.teal, 50), "3.1.2 Chain-start marker color", group=grpColors)
chainEndMarkerColor = input.color(color.new(color.blue, 50), "3.1.3 Chain-end marker color", group=grpColors)
dwMarkerColor = input.color(color.new(color.gray, 50), "3.1.4 Display-window marker color (start+end)", group=grpColors)
unresolvedLabelColor = input.color(color.new(#ff9800, 0), "3.1.5 Unresolved-leg label text color", group=grpColors,
     tooltip="Colour for the unresolved-leg labels and their line. The transparency slider affects the LINE only; the label always draws fully opaque.")
unresolvedLabelBgColor = input.color(color.new(color.black, 100), "3.1.6 Unresolved-leg label background color", group=grpColors)
statusOkColor = input.color(color.lime, "3.1.10 Status box text color (hard rules OK)", group=grpColors)
statusFailColor = input.color(#FF0014, "3.1.11 Status box text color (violation)", group=grpColors)
invalidationColor = input.color(#ff0014, "3.1.14 Invalidation line color", group=grpColors)
invalidationDotColor = input.color(color.new(#ff0014, 100), "3.1.15 Invalidation info-dot color", group=grpColors)
fibBoxColorNear = input.color(color.new(#dbdbdb, 0), "3.1.16 Fibonacci target box color (near)", group=grpColors)
fibBoxColorFar = input.color(color.new(#dbdbdb, 0), "3.1.17 Fibonacci target box color (far)", group=grpColors)
measProjLineColor = input.color(color.new(#dbdbdb, 75), "3.1.18 Post-Correction Target line color", group=grpColors)
measRefLineColor = input.color(color.new(#dbdbdb, 75), "3.1.19 Measured-leg reference line color", group=grpColors)
explanationTextColor = input.color(color.new(#00ff0a, 0), "3.1.20 Explanation text color", group=grpColors)
explanationBgColor = input.color(color.new(color.black, 100), "3.1.21 Explanation background color", group=grpColors)
historyExplanationTextColor = input.color(color.new(#2962ff, 0), "3.1.22 Historical explanation text color", group=grpColors)
historyExplanationBgColor = input.color(color.new(color.black, 100), "3.1.23 Historical explanation background color", group=grpColors)
subWaveExplanationTextColor = input.color(color.new(#00bcd4, 0), "3.1.24 Sub-wave explanation text color", group=grpColors)
subWaveExplanationBgColor = input.color(color.new(color.black, 100), "3.1.25 Sub-wave explanation background color", group=grpColors)

historyColor = input.color(color.new(#dbdbdb, 60), "3.1.26 Historical chain label color", group=grpColors,
