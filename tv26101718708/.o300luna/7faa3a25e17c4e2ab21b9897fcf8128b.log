var int[]   subPivotTimes   = array.new_int(0)

float subPivotThreshold = pivotThreshold * subWaveAtrMultEff

addSubPivot(float price, int bar, int pivTime) =>
    array.push(subPivotPrices, price)
    array.push(subPivotBars, bar)
    array.push(subPivotTimes, pivTime)
    if array.size(subPivotBars) > maxSubPivots
        array.shift(subPivotPrices)
        array.shift(subPivotBars)
        array.shift(subPivotTimes)

if barstate.isconfirmed and enableSubWaveCheck
    if na(subLastPivotPrice)
        if not na(atr)
            subLastPivotPrice := close
            subExtremePrice   := close
            subExtremeBar     := bar_index
            subExtremeTime    := time
            subPivotDir       := 0
    else
        if subPivotDir >= 0
            if na(subExtremePrice) or high > subExtremePrice
                subExtremePrice := high
                subExtremeBar   := bar_index
                subExtremeTime  := time
        if subPivotDir <= 0
            if na(subExtremePrice) or low < subExtremePrice
                subExtremePrice := low
                subExtremeBar   := bar_index
                subExtremeTime  := time

        if subPivotDir <= 0 and (high - subExtremePrice) > subPivotThreshold and subPivotDir != 1
            addSubPivot(subExtremePrice, subExtremeBar, subExtremeTime)
            subLastPivotPrice := subExtremePrice
            subPivotDir       := 1
            subExtremePrice   := high
            subExtremeBar     := bar_index
            subExtremeTime    := time
        else if subPivotDir >= 0 and (subExtremePrice - low) > subPivotThreshold and subPivotDir != -1
            addSubPivot(subExtremePrice, subExtremeBar, subExtremeTime)
            subLastPivotPrice := subExtremePrice
            subPivotDir       := -1
            subExtremePrice   := low
            subExtremeBar     := bar_index
            subExtremeTime    := time

