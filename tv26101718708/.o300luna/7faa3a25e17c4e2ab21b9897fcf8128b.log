projectionColor = input.color(color.new(#f1ff0a, 0), "3.1.36 Projection color", group=grpColors)
targetProjectedBgColor = input.color(color.new(color.black, 85), "3.1.37 Target Projected box background color", group=grpColors)
confluenceZoneBorderColor = input.color(color.yellow, "3.1.38 Confluence zone border color", group=grpColors)
confluenceZoneBgColor = input.color(color.new(#00bcd4, 92), "3.1.39 Confluence zone background color", group=grpColors)
confluenceZoneTextColor = input.color(color.new(#00bcd4, 0), "3.1.40 Confluence zone label text color", group=grpColors)
leadLabelColor = input.color(color.new(#dbdbdb, 50), "3.1.41 Leading-scenario label color", group=grpColors,
