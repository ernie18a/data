mtfLineWidth2 = input.int(1, "1.1.43 Line width target 2", minval=1, maxval=4, group=grpMtfOv)
mtfLineWidth3 = input.int(1, "1.1.44 Line width target 3", minval=1, maxval=4, group=grpMtfOv)
mtfLineWidth4 = input.int(1, "1.1.45 Line width target 4", minval=1, maxval=4, group=grpMtfOv)
