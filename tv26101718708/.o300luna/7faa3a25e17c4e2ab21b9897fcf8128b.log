subLabelColor = input.color(color.new(#dbdbdb, 50), "3.1.42 Sub-wave label color", group=grpColors,
     tooltip="Colour for the sub-wave labels and their line. The transparency slider affects the LINE only; the labels always draw fully opaque. Both grey out when a hard rule is violated.")
sequelLabelColor = input.color(color.new(#dbdbdb, 50), "3.1.43 Sequel-chain label color", group=grpColors,
