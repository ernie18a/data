// ══════════════════════════════════════════
// v24 FIXED-TIMEFRAME CORE — 5m SIGNAL / 15m CONFIRM / 30m REGIME
// ══════════════════════════════════════════

const string INTERNALS_TF = "1"
const int FIVE_MIN_MS = 300000

isNewDay        = ta.change(time("D")) != 0
inNYSE          = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
nyseSessionStart = inNYSE and (not inNYSE[1] or isNewDay)
nyseSessionEnd   = not inNYSE and inNYSE[1]

var int currentRthStartBar = na
if nyseSessionStart
    currentRthStartBar := bar_index

// Detect the first ET-dated bar even on symbols that publish only RTH bars
// (TICK/A-D often have no overnight bar to make `not inRth[1]` turn true).
f_newEtDate() =>
    year(time, "America/New_York") != year(time[1], "America/New_York") or
     month(time, "America/New_York") != month(time[1], "America/New_York") or
     dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")

// Two honest VWAP choices:
// 1) TradingView Session VWAP on fixed 5m bars. This mirrors the standard
//    TradingView VWAP used on the 5-minute chart (Session anchor + HLC3).
// 2) Custom 9:30-16:00 ET RTH VWAP on fixed one-minute bars.
f_rthVwapPack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    var float pv = 0.0
    var float vv = 0.0
    var float pv2 = 0.0
    if rthStart
        pv  := 0.0
        vv  := 0.0
        pv2 := 0.0
    if inRth
        pv  += hlc3 * volume
        vv  += volume
        pv2 += hlc3 * hlc3 * volume
    float vw = vv > 0 ? pv / vv : na
    float variance = vv > 0 and not na(vw) ? math.max(pv2 / vv - vw * vw, 0.0) : na
    float sd = not na(variance) ? math.sqrt(variance) : na
    [vw, not na(vw) and not na(sd) ? vw + sd : na, not na(vw) and not na(sd) ? vw - sd : na]

f_tvSessionVwapPack() =>
    bool newSession = timeframe.change("1D")
    ta.vwap(hlc3, newSession, 1.0)

[tvSessionVwap, tvSessionUpper, tvSessionLower] = request.security(
     syminfo.tickerid, SIGNAL_TF, f_tvSessionVwapPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
[rthVwap, rthVwapUpper, rthVwapLower] = request.security(
     syminfo.tickerid, "1", f_rthVwapPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)

useTvSessionVwap = i_vwapMode == "TradingView Session (fixed 5m)"
vwap = useTvSessionVwap ? tvSessionVwap : rthVwap
vwapUpper = useTvSessionVwap ? tvSessionUpper : rthVwapUpper
vwapLower = useTvSessionVwap ? tvSessionLower : rthVwapLower
vwapModeShort = useTvSessionVwap ? "TV Session" : "RTH"
alternateVwap = useTvSessionVwap ? rthVwap : tvSessionVwap
alternateVwapModeShort = useTvSessionVwap ? "RTH" : "TV Session"
vwapComparisonGap = not na(tvSessionVwap) and not na(rthVwap) ? tvSessionVwap - rthVwap : na

f_signalPack() =>
    int momBars = math.max(1, int(math.round(i_momLookbackMin / 5.0)))
    float f = ta.ema(close, i_fastLen)
    float s = ta.ema(close, i_slowLen)
    float t = ta.ema(close, i_trendLen)
    float a = ta.atr(14)
    float r = ta.rsi(close, 14)
    float m = close - close[momBars]
    int sinceNotUp = ta.barssince(close <= close[4])
    int sinceNotDn = ta.barssince(close >= close[4])
    int upCount = close > close[4] ? nz(sinceNotUp, 0) + 1 : 0
    int dnCount = close < close[4] ? nz(sinceNotDn, 0) + 1 : 0

    // Build the target reference inside the same fixed 5m requested context as
    // the signal engine, rather than indexing a chart-timeframe series. During RTH,
    // the returned level is the session extreme that existed before this 5m bar
    // began. Outside RTH, it remains the most recently completed RTH extreme.
    bool inRth5 = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart5 = inRth5 and (not inRth5[1] or f_newEtDate())
    var float runningRthHigh5 = na
    var float runningRthLow5 = na
    float priorBarRthHigh5 = inRth5 and not rthStart5 ? runningRthHigh5[1] : na
    float priorBarRthLow5 = inRth5 and not rthStart5 ? runningRthLow5[1] : na
    if rthStart5
        runningRthHigh5 := high
        runningRthLow5 := low
    else if inRth5
        runningRthHigh5 := na(runningRthHigh5) ? high : math.max(runningRthHigh5, high)
        runningRthLow5 := na(runningRthLow5) ? low : math.min(runningRthLow5, low)
    float confirmedRthHighTarget5 = inRth5 ? priorBarRthHigh5 : runningRthHigh5
    float confirmedRthLowTarget5 = inRth5 ? priorBarRthLow5 : runningRthLow5

    [open, high, low, close, f, s, t, a, r, m, m[3], ta.highest(high, 20), ta.lowest(low, 20), upCount, dnCount, time,
     confirmedRthHighTarget5, confirmedRthLowTarget5]

[signalOpen, signalHigh, signalLow, signalClose, fastEMA, slowEMA, trendEMA, atr, rsi,
 momentum, momentumPrev3, signalHigh20, signalLow20, consecutiveUp, consecutiveDown, signalTime,
 confirmedRthHighTarget5, confirmedRthLowTarget5] =
 request.security(syminfo.tickerid, SIGNAL_TF, f_signalPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)

f_trendPack() =>
    float f = ta.ema(close, i_fastLen)
    float s = ta.ema(close, i_slowLen)
    float t = ta.ema(close, i_trendLen)
    [close, f, s, t]

[htfClose, htfFast, htfSlow, htfTrend] = request.security(
     syminfo.tickerid, CONFIRM_TF, f_trendPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
[regimeClose, regimeFast, regimeSlow, regimeTrend] = request.security(
     syminfo.tickerid, REGIME_TF, f_trendPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
bullTrend5 = signalClose > trendEMA and fastEMA > slowEMA
bearTrend5 = signalClose < trendEMA and fastEMA < slowEMA
htfBull = htfClose > htfTrend and htfFast > htfSlow
htfBear = htfClose < htfTrend and htfFast < htfSlow
regimeBull = regimeClose > regimeTrend and regimeFast > regimeSlow
regimeBear = regimeClose < regimeTrend and regimeFast < regimeSlow

aboveVWAP = not na(vwap) and signalClose > vwap
belowVWAP = not na(vwap) and signalClose < vwap
momStrong = not na(momentum) and not na(atr) and math.abs(momentum) > atr * i_momATR
bullMomentum = momStrong and momentum > 0
bearMomentum = momStrong and momentum < 0
vwapDist = not na(vwap) ? signalClose - vwap : na
nearUpper = not na(vwapUpper) and not na(atr) and signalClose >= vwapUpper - atr * 0.10
nearLower = not na(vwapLower) and not na(atr) and signalClose <= vwapLower + atr * 0.10

// One lower-timeframe request feeds both the one-minute Volume Profile and the
// completed-minute RVOL pacing engine. It avoids two expensive intrabar scans.
const int ONE_MIN_MS = 60000
[oneMinHighs, oneMinLows, oneMinVolumes, oneMinTimes] = request.security_lower_tf(
     syminfo.tickerid, "1", [high, low, volume, time],
     ignore_invalid_timeframe=true, calc_bars_count=20000)
chartTfSeconds = timeframe.in_seconds()
oneMinChartEligible = not na(chartTfSeconds) and chartTfSeconds > 60
int oneMinArrayCount = math.min(math.min(array.size(oneMinHighs), array.size(oneMinLows)),
     math.min(array.size(oneMinVolumes), array.size(oneMinTimes)))

// ══════════════════════════════════════════
// v24 TRUE 1-MINUTE INTERNALS
// ══════════════════════════════════════════

f_oneMinValuePack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    int sessionBars = ta.barssince(rthStart)
    float currentValue = inRth ? close : na
    float previousValue = inRth and not na(sessionBars) and sessionBars >= 1 ? close[1] : na
    float pastValue = inRth and not na(sessionBars) and sessionBars >= i_internalVelocityMin ? close[i_internalVelocityMin] : na
    [currentValue, previousValue, pastValue]

f_oneMinTickPack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    int sessionBars = ta.barssince(rthStart)
    float currentValue = inRth ? close : na
    float previousValue = inRth and not na(sessionBars) and sessionBars >= 1 ? close[1] : na
    float smoothValue = inRth and not na(sessionBars) and sessionBars >= i_tickSmoothLen - 1 ? ta.sma(close, i_tickSmoothLen) : na
    [currentValue, previousValue, smoothValue]

f_oneMinVixPack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    int sessionBars = ta.barssince(rthStart)
    float currentValue = inRth ? close : na
    float past5 = inRth and not na(sessionBars) and sessionBars >= 5 ? close[5] : na
    float pastVelocity = inRth and not na(sessionBars) and sessionBars >= i_internalVelocityMin ? close[i_internalVelocityMin] : na
    [currentValue, past5, pastVelocity]

f_trueCumTickPack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    var float c = 0.0
    var int sessionBars = 0
    if rthStart
        c := nz(close, 0.0)
        sessionBars := 1
    else if inRth
        c := nz(c[1], 0.0) + nz(close, 0.0)
        sessionBars := nz(sessionBars[1], 0) + 1
    else
        sessionBars := 0
    float prev = inRth and sessionBars > 1 ? c[1] : na
    float ago15 = inRth and sessionBars > 15 ? c[15] : na
    float ago30 = inRth and sessionBars > 30 ? c[30] : na
    [inRth ? c : na, prev, ago15, ago30]

[addValue, addPrev1, addPastVelocity] = request.security(i_addSym, INTERNALS_TF,
     f_oneMinValuePack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)
[tickValue, tickPrev1, tickSmooth] = request.security(i_tickSym, INTERNALS_TF,
     f_oneMinTickPack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)
[uvolValue, uvolPrev1, uvolPastVelocity] = request.security(i_uvolSym, INTERNALS_TF,
     f_oneMinValuePack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)
[dvolValue, dvolPrev1, dvolPastVelocity] = request.security(i_dvolSym, INTERNALS_TF,
     f_oneMinValuePack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)
[vixValue, vixPast5, vixPastVelocity] = request.security(i_vixSym, INTERNALS_TF,
     f_oneMinVixPack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)
[cumTick, cumTickPrev1, cumTick15Ago, cumTick30Ago] = request.security(i_tickSym, INTERNALS_TF,
     f_trueCumTickPack(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true, calc_bars_count=5000)

voldValue = na(uvolValue) or na(dvolValue) ? na : uvolValue - dvolValue
voldPrev1 = na(uvolPrev1) or na(dvolPrev1) ? na : uvolPrev1 - dvolPrev1
voldPastVelocity = na(uvolPastVelocity) or na(dvolPastVelocity) ? na : uvolPastVelocity - dvolPastVelocity
voldTotal = na(uvolValue) or na(dvolValue) ? na : uvolValue + dvolValue
voldPastTotal = na(uvolPastVelocity) or na(dvolPastVelocity) ? na : uvolPastVelocity + dvolPastVelocity
voldPct = not na(voldTotal) and voldTotal != 0.0 ? voldValue / voldTotal * 100.0 : na
voldPctPast = not na(voldPastTotal) and voldPastTotal != 0.0 ? voldPastVelocity / voldPastTotal * 100.0 : na

addDelta = not na(addValue) and not na(addPrev1) ? addValue - addPrev1 : na
tickDelta = not na(tickValue) and not na(tickPrev1) ? tickValue - tickPrev1 : na
voldDelta = not na(voldValue) and not na(voldPrev1) ? voldValue - voldPrev1 : na
cumTickDelta = not na(cumTick) and not na(cumTickPrev1) ? cumTick - cumTickPrev1 : na
addVelocity = not na(addValue) and not na(addPastVelocity) ? addValue - addPastVelocity : na
voldVelocity = not na(voldValue) and not na(voldPastVelocity) ? voldValue - voldPastVelocity : na
voldPctVelocity = not na(voldPct) and not na(voldPctPast) ? voldPct - voldPctPast : na
cumVelocity15 = not na(cumTick) and not na(cumTick15Ago) ? cumTick - cumTick15Ago : na
cumVelocity = not na(cumTick) and not na(cumTick30Ago) ? cumTick - cumTick30Ago : na
vixDeltaPct = not na(vixValue) and not na(vixPast5) and vixPast5 != 0.0 ? (vixValue - vixPast5) / vixPast5 * 100.0 : na
vixVelocity = not na(vixValue) and not na(vixPastVelocity) and vixPastVelocity != 0.0 ? (vixValue - vixPastVelocity) / vixPastVelocity * 100.0 : na

// ══════════════════════════════════════════
// VOLUME PROFILE (v24 fixed 1m approximation) — POC / VALUE AREA
// ══════════════════════════════════════════
// Pine does not expose exchange-native historical volume-at-price to ordinary
// scripts. v24 therefore profiles fixed one-minute candles on every chart and
// distributes each minute's volume evenly across the price bins its range
// touches. This preserves total volume and gives the 5m and 30m dashboards the
// same underlying profile data. RTH and prior-RTH windows hold up to 390 minutes;
// Rolling uses the most recent requested one-minute bars, including Globex.

var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
var array<float> vpCurrentHighs = array.new_float()
var array<float> vpCurrentLows = array.new_float()
var array<float> vpCurrentVols = array.new_float()
var array<float> vpPriorHighs = array.new_float()
var array<float> vpPriorLows = array.new_float()
var array<float> vpPriorVols = array.new_float()
var array<float> vpRollingHighs = array.new_float()
var array<float> vpRollingLows = array.new_float()
var array<float> vpRollingVols = array.new_float()
var int vpCurrentSessionKey = na
var int vpLastProcessedTs = na
const int VP_MAX_ROLLING_1M = 2000

f_etDateKey(int ts) =>
    year(ts, "America/New_York") * 10000 + month(ts, "America/New_York") * 100 + dayofmonth(ts, "America/New_York")

f_rthMinuteSlot(int ts) =>
    int h = hour(ts, "America/New_York")
    int m = minute(ts, "America/New_York")
    int slot = h * 60 + m - 570
    slot >= 0 and slot < 390 ? slot : na

f_trimProfileArrays(array<float> highs, array<float> lows, array<float> vols, int maxSize) =>
    while array.size(highs) > maxSize
        array.shift(highs)
        array.shift(lows)
        array.shift(vols)

if oneMinChartEligible and oneMinArrayCount > 0
    for i = 0 to oneMinArrayCount - 1
        int ts = array.get(oneMinTimes, i)
        float hi1 = array.get(oneMinHighs, i)
        float lo1 = array.get(oneMinLows, i)
        float vol1 = array.get(oneMinVolumes, i)
        bool stillOpen = barstate.isrealtime and ts + ONE_MIN_MS > timenow
        bool newMinute = na(vpLastProcessedTs) or ts > vpLastProcessedTs
        if newMinute and not stillOpen and not na(hi1) and not na(lo1) and not na(vol1)
            array.push(vpRollingHighs, hi1)
            array.push(vpRollingLows, lo1)
            array.push(vpRollingVols, vol1)
            f_trimProfileArrays(vpRollingHighs, vpRollingLows, vpRollingVols, VP_MAX_ROLLING_1M)

            int rthSlot = f_rthMinuteSlot(ts)
            if not na(rthSlot)
                int sessionKey = f_etDateKey(ts)
                if na(vpCurrentSessionKey)
                    vpCurrentSessionKey := sessionKey
                if sessionKey != vpCurrentSessionKey
                    vpPriorHighs := array.copy(vpCurrentHighs)
                    vpPriorLows := array.copy(vpCurrentLows)
                    vpPriorVols := array.copy(vpCurrentVols)
                    array.clear(vpCurrentHighs)
                    array.clear(vpCurrentLows)
                    array.clear(vpCurrentVols)
                    vpCurrentSessionKey := sessionKey
                array.push(vpCurrentHighs, hi1)
                array.push(vpCurrentLows, lo1)
                array.push(vpCurrentVols, vol1)
            vpLastProcessedTs := ts

f_vpProfileArrays(array<float> highs, array<float> lows, array<float> vols, int startIdx, int count, int rows, int vaPct) =>
    float poc = na
    float vah = na
    float val = na
    int available = math.min(math.min(array.size(highs), array.size(lows)), array.size(vols))
    int safeStart = math.max(0, startIdx)
    int safeCount = math.min(count, available - safeStart)
    if safeCount >= 2 and rows >= 2
        float hi = na
        float lo = na
        for k = safeStart to safeStart + safeCount - 1
            float h = array.get(highs, k)
            float l = array.get(lows, k)
            hi := na(hi) ? h : math.max(hi, h)
            lo := na(lo) ? l : math.min(lo, l)
        if not na(hi) and not na(lo) and hi > lo
            float interval = (hi - lo) / (rows - 1)
            array<float> bins = array.new_float(rows, 0.0)
            if interval > 0
                for k = safeStart to safeStart + safeCount - 1
                    float h = array.get(highs, k)
                    float l = array.get(lows, k)
                    float v = array.get(vols, k)
                    int jLo = math.max(0, int(math.floor((l - lo) / interval)))
                    int jHi = math.min(rows - 1, int(math.ceil((h - lo) / interval)))
                    int touched = math.max(1, jHi - jLo + 1)
                    float perBin = v / touched
                    for j = jLo to jHi
                        array.set(bins, j, array.get(bins, j) + perBin)
                float maxVol = array.max(bins)
                int maxIdx = array.indexof(bins, maxVol)
                poc := lo + interval * maxIdx
                float total = array.sum(bins)
                float vaVol = total * vaPct / 100.0
                int up = maxIdx
                int dn = maxIdx
                float acc = maxVol
                while acc < vaVol
                    float vUp = up < rows - 1 ? array.get(bins, up + 1) : 0.0
                    float vDn = dn > 0 ? array.get(bins, dn - 1) : 0.0
                    if vUp == 0.0 and vDn == 0.0
                        break
                    if vUp >= vDn
                        acc += vUp
                        up += 1
                    else
                        acc += vDn
                        dn -= 1
                vah := lo + interval * up
                val := lo + interval * dn
    [poc, vah, val]

if i_showVolProfile and barstate.islast
    array<float> selectedHighs = i_vpWindow == "Prior day RTH" ? vpPriorHighs : i_vpWindow == "Rolling" ? vpRollingHighs : vpCurrentHighs
    array<float> selectedLows = i_vpWindow == "Prior day RTH" ? vpPriorLows : i_vpWindow == "Rolling" ? vpRollingLows : vpCurrentLows
    array<float> selectedVols = i_vpWindow == "Prior day RTH" ? vpPriorVols : i_vpWindow == "Rolling" ? vpRollingVols : vpCurrentVols
    int selectedSize = math.min(math.min(array.size(selectedHighs), array.size(selectedLows)), array.size(selectedVols))
    int selectedCount = i_vpWindow == "Rolling" ? math.min(i_vpRollingBars, selectedSize) : selectedSize
    int selectedStart = math.max(0, selectedSize - selectedCount)
    [p, vah, val] = f_vpProfileArrays(selectedHighs, selectedLows, selectedVols, selectedStart, selectedCount, i_vpRows, i_vpVAPct)
    vpPOC := p
    vpVAH := vah
    vpVAL := val

// ── CHART LINES ──
var line vpPocLine = na
var line vpVahLine = na
var line vpValLine = na
var label vpPocLbl = na
var label vpVahLbl = na
var label vpValLbl = na
if i_showVolProfile and i_vpDrawLines and barstate.islast
    int x1 = bar_index - 50
    int x2 = bar_index + 10
    color vpPocCol = #FF9800
    color vpVaCol  = color.new(#2196F3, 0)
    if not na(vpPocLine)
        line.delete(vpPocLine)
    if not na(vpVahLine)
        line.delete(vpVahLine)
    if not na(vpValLine)
        line.delete(vpValLine)
    if not na(vpPocLbl)
        label.delete(vpPocLbl)
    if not na(vpVahLbl)
        label.delete(vpVahLbl)
    if not na(vpValLbl)
        label.delete(vpValLbl)
    if not na(vpPOC)
        vpPocLine := line.new(x1, vpPOC, x2, vpPOC, color=vpPocCol, width=2, style=line.style_solid)
        vpPocLbl  := label.new(x2, vpPOC, "POC", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(vpPocCol, 80), textcolor=vpPocCol, size=size.small)
    if not na(vpVAH)
        vpVahLine := line.new(x1, vpVAH, x2, vpVAH, color=vpVaCol, width=2, style=line.style_solid)
        vpVahLbl  := label.new(x2, vpVAH, "VAH", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(vpVaCol, 80), textcolor=vpVaCol, size=size.small)
    if not na(vpVAL)
        vpValLine := line.new(x1, vpVAL, x2, vpVAL, color=vpVaCol, width=2, style=line.style_solid)
        vpValLbl  := label.new(x2, vpVAL, "VAL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(vpVaCol, 80), textcolor=vpVaCol, size=size.small)


// ══════════════════════════════════════════
// INTERNALS MEMORY — FIXED 1m SESSION RANGE + VELOCITY
// ══════════════════════════════════════════

var float addSessHigh = na
var float addSessLow  = na
var float cumSessHigh = na
var float cumSessLow  = na
var float voldSessHigh = na
var float voldSessLow  = na
var float voldPctSessHigh = na
var float voldPctSessLow  = na
var float vixSessHigh = na
var float vixSessLow  = na

if nyseSessionStart
    addSessHigh  := addValue
    addSessLow   := addValue
    cumSessHigh  := cumTick
    cumSessLow   := cumTick
    voldSessHigh := voldValue
    voldSessLow  := voldValue
    voldPctSessHigh := voldPct
    voldPctSessLow  := voldPct
    vixSessHigh  := vixValue
    vixSessLow   := vixValue
else if inNYSE
    if not na(addValue)
        addSessHigh := na(addSessHigh) ? addValue : math.max(addSessHigh, addValue)
        addSessLow  := na(addSessLow)  ? addValue : math.min(addSessLow, addValue)
    if not na(cumTick)
        cumSessHigh := na(cumSessHigh) ? cumTick : math.max(cumSessHigh, cumTick)
        cumSessLow  := na(cumSessLow)  ? cumTick : math.min(cumSessLow, cumTick)
    if not na(voldValue)
        voldSessHigh := na(voldSessHigh) ? voldValue : math.max(voldSessHigh, voldValue)
        voldSessLow  := na(voldSessLow)  ? voldValue : math.min(voldSessLow, voldValue)
    if not na(voldPct)
        voldPctSessHigh := na(voldPctSessHigh) ? voldPct : math.max(voldPctSessHigh, voldPct)
        voldPctSessLow  := na(voldPctSessLow)  ? voldPct : math.min(voldPctSessLow, voldPct)
    if not na(vixValue)
        vixSessHigh := na(vixSessHigh) ? vixValue : math.max(vixSessHigh, vixValue)
        vixSessLow  := na(vixSessLow)  ? vixValue : math.min(vixSessLow, vixValue)

// ══════════════════════════════════════════
// BREADTH SLOPE — FIXED 30-MINUTE CHANGE
// ══════════════════════════════════════════

adFallingHard   = not na(addVelocity) and addVelocity <= -i_adSlopeMin
adRisingHard    = not na(addVelocity) and addVelocity >=  i_adSlopeMin
voldFallingHard = not na(voldPctVelocity) and voldPctVelocity <= -i_voldSlopeMin
voldRisingHard  = not na(voldPctVelocity) and voldPctVelocity >=  i_voldSlopeMin

priceBearLean = bearTrend5 and belowVWAP
priceBullLean = bullTrend5 and aboveVWAP
breadthSlopeShortRaw = priceBearLean and adFallingHard and voldFallingHard
breadthSlopeLongRaw  = priceBullLean and adRisingHard and voldRisingHard
breadthConfirmsShort = i_useBreadthSlopeOverride and breadthSlopeShortRaw
breadthConfirmsLong  = i_useBreadthSlopeOverride and breadthSlopeLongRaw
breadthSlopeConfirms = breadthConfirmsShort or breadthConfirmsLong

// ══════════════════════════════════════════
// INTERMARKET CONTEXT — FIXED 1m RTH ANCHOR + 30m SLOPE
// ══════════════════════════════════════════

f_rthPricePack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    int sessionBars = ta.barssince(rthStart)
    var float anchor = na
    if rthStart
        anchor := open
    float currentValue = inRth ? close : na
    float pastValue = inRth and not na(sessionBars) and sessionBars >= i_internalVelocityMin ? close[i_internalVelocityMin] : na
    [currentValue, pastValue, anchor]

[nqValue, nqPastValue, nqAnchorFixed] = request.security(syminfo.tickerid, "1",
     f_rthPricePack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
[esValue, esPastValue, esAnchorFixed] = request.security(i_esSym, "1",
     f_rthPricePack(), lookahead=barmerge.lookahead_off,
     ignore_invalid_symbol=true, calc_bars_count=5000)

nqSessRef = nqAnchorFixed
esSessRef = esAnchorFixed
nqPctChg = not na(nqSessRef) and nqSessRef != 0.0 and not na(nqValue) ? (nqValue - nqSessRef) / nqSessRef * 100.0 : na
esPctChg = not na(esSessRef) and esSessRef != 0.0 and not na(esValue) ? (esValue - esSessRef) / esSessRef * 100.0 : na
nqPctPast = not na(nqSessRef) and nqSessRef != 0.0 and not na(nqPastValue) ? (nqPastValue - nqSessRef) / nqSessRef * 100.0 : na
esPctPast = not na(esSessRef) and esSessRef != 0.0 and not na(esPastValue) ? (esPastValue - esSessRef) / esSessRef * 100.0 : na
relStrength = not na(nqPctChg) and not na(esPctChg) ? nqPctChg - esPctChg : na
relStrengthPast = not na(nqPctPast) and not na(esPctPast) ? nqPctPast - esPctPast : na
relVelocity = not na(relStrength) and not na(relStrengthPast) ? relStrength - relStrengthPast : na

nqLeadingLevel = not na(relStrength) and relStrength >  i_relStrengthMin
nqLaggingLevel = not na(relStrength) and relStrength < -i_relStrengthMin
relSlopeUp   = i_useRelSlope and not na(relVelocity) and relVelocity >=  i_relSlopeMin
relSlopeDown = i_useRelSlope and not na(relVelocity) and relVelocity <= -i_relSlopeMin
nqLeading = (nqLeadingLevel and not relSlopeDown) or (relSlopeUp and not nqLaggingLevel)
nqLagging = (nqLaggingLevel and not relSlopeUp) or (relSlopeDown and not nqLeadingLevel)
exceptionalNqLong = not na(relStrength) and relStrength >= i_relExceptionalMin and not relSlopeDown
exceptionalNqShort = not na(relStrength) and relStrength <= -i_relExceptionalMin and not relSlopeUp

// ══════════════════════════════════════════
// v24 SEPARATE INTERNALS VOTES + VIX FILTER
// ══════════════════════════════════════════

internalsAvailable = inNYSE and not na(addValue) and not na(tickSmooth) and not na(cumTick) and not na(voldPct)

// A decisive counter-slope removes the sign point instead of awarding both
// directions simultaneously. If the slope has not crossed into outright
// opposition yet, the component becomes neutral rather than double-counted.
bullAdSupport = internalsAvailable and ((addValue > 0 and not adFallingHard) or (i_useBreadthSlopeInScore and adRisingHard))
bearAdSupport = internalsAvailable and ((addValue < 0 and not adRisingHard) or (i_useBreadthSlopeInScore and adFallingHard))
bullAdOppose = internalsAvailable and (addValue <= -i_adModerateTh or (adFallingHard and addValue < i_adModerateTh)) and not adRisingHard
bearAdOppose = internalsAvailable and (addValue >=  i_adModerateTh or (adRisingHard and addValue > -i_adModerateTh)) and not adFallingHard

bullVoldSupport = internalsAvailable and ((voldPct >= i_voldPctMin and not voldFallingHard) or (i_useBreadthSlopeInScore and voldRisingHard))
bearVoldSupport = internalsAvailable and ((voldPct <= -i_voldPctMin and not voldRisingHard) or (i_useBreadthSlopeInScore and voldFallingHard))
bullVoldOppose = internalsAvailable and (voldPct <= -i_voldPctMin or (voldFallingHard and voldPct < i_voldPctMin)) and not voldRisingHard
bearVoldOppose = internalsAvailable and (voldPct >=  i_voldPctMin or (voldRisingHard and voldPct > -i_voldPctMin)) and not voldFallingHard

bullTickSupport = internalsAvailable and tickSmooth > 0 and cumVelocity15 > 0 and cumVelocity > 0
bearTickSupport = internalsAvailable and tickSmooth < 0 and cumVelocity15 < 0 and cumVelocity < 0
bullTickOppose = internalsAvailable and tickSmooth <= -i_tickDim and cumVelocity15 < 0
bearTickOppose = internalsAvailable and tickSmooth >=  i_tickDim and cumVelocity15 > 0

bullInternalSupportCount = (bullAdSupport ? 1 : 0) + (bullVoldSupport ? 1 : 0) + (bullTickSupport ? 1 : 0)
bearInternalSupportCount = (bearAdSupport ? 1 : 0) + (bearVoldSupport ? 1 : 0) + (bearTickSupport ? 1 : 0)
bullOpposingInternals = (bullAdOppose ? 1 : 0) + (bullVoldOppose ? 1 : 0) + (bullTickOppose ? 1 : 0)
bearOpposingInternals = (bearAdOppose ? 1 : 0) + (bearVoldOppose ? 1 : 0) + (bearTickOppose ? 1 : 0)

bullInternalsSignOK = bullAdSupport and bullVoldSupport and bullTickSupport
bearInternalsSignOK = bearAdSupport and bearVoldSupport and bearTickSupport
bullInternalsSlopeOK = breadthSlopeLongRaw and cumVelocity15 > 0 and tickSmooth > -i_tickDim
bearInternalsSlopeOK = breadthSlopeShortRaw and cumVelocity15 < 0 and tickSmooth <  i_tickDim
bullInternalsConfirm = internalsAvailable and bullInternalSupportCount >= 2
bearInternalsConfirm = internalsAvailable and bearInternalSupportCount >= 2

vixAvailable = not na(vixDeltaPct)
bullVixConfirm = vixAvailable and vixDeltaPct <= -i_vixSupportMin
bearVixConfirm = vixAvailable and vixDeltaPct >=  i_vixSupportMin
vixConflictLong = vixAvailable and vixDeltaPct >=  i_vixConflictMin
vixConflictShort = vixAvailable and vixDeltaPct <= -i_vixConflictMin
vixSupportsBull = not vixConflictLong
vixSupportsBear = not vixConflictShort

// ══════════════════════════════════════════
// STRUCTURE — FIXED 5m PIVOTS
// ══════════════════════════════════════════

f_fixedPivotPack() =>
    float ph = ta.pivothigh(high, i_srLen, i_srLen)
    float pl = ta.pivotlow(low, i_srLen, i_srLen)
    var float lastH = na
    var float lastL = na
    if not na(ph)
        lastH := ph
    if not na(pl)
        lastL := pl
    [lastH, lastL]

[lastSwingH, lastSwingL] = request.security(syminfo.tickerid, SIGNAL_TF,
     f_fixedPivotPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
swingH = not na(lastSwingH) and (na(lastSwingH[1]) or lastSwingH != lastSwingH[1]) ? lastSwingH : na
swingL = not na(lastSwingL) and (na(lastSwingL[1]) or lastSwingL != lastSwingL[1]) ? lastSwingL : na

distToRes = not na(lastSwingH) ? math.round(lastSwingH - signalClose, 1) : na
distToSup = not na(lastSwingL) ? math.round(signalClose - lastSwingL, 1) : na
nearResistance = not na(distToRes) and distToRes >= 0 and distToRes < atr * 0.50
nearSupport = not na(distToSup) and distToSup >= 0 and distToSup < atr * 0.50

// ══════════════════════════════════════════
// v24.2 MANUAL HISTORICAL S/R — PARSE + NEAREST EDGES
// ══════════════════════════════════════════

var array<float> manualZoneLows = array.new_float()
var array<float> manualZoneHighs = array.new_float()
var int manualParsedCount = 0

if barstate.isfirst
    array.clear(manualZoneLows)
    array.clear(manualZoneHighs)
    manualParsedCount := 0
    string manualNormalized = str.replace_all(i_manualSrBank, "\r", "")
    manualNormalized := str.replace_all(manualNormalized, ",", "\n")
    manualNormalized := str.replace_all(manualNormalized, ";", "\n")
    manualNormalized := str.replace_all(manualNormalized, "–", "-")
    manualNormalized := str.replace_all(manualNormalized, "—", "-")
    array<string> manualRows = str.split(manualNormalized, "\n")
    if array.size(manualRows) > 0
        for manualRowIdx = 0 to array.size(manualRows) - 1
            string token = str.replace_all(array.get(manualRows, manualRowIdx), " ", "")
            if str.length(token) > 0
                array<string> zoneParts = str.split(token, "-")
                float zoneA = na
                float zoneB = na
                if array.size(zoneParts) >= 2
                    zoneA := str.tonumber(array.get(zoneParts, 0))
                    zoneB := str.tonumber(array.get(zoneParts, 1))
                else
                    zoneA := str.tonumber(token)
                    zoneB := zoneA
                if not na(zoneA) and not na(zoneB)
                    manualParsedCount += 1
                    float zoneLo = math.min(zoneA, zoneB)
                    float zoneHi = math.max(zoneA, zoneB)
                    if zoneHi == zoneLo and i_manualSingleHalfWidth > 0
                        zoneLo -= i_manualSingleHalfWidth
                        zoneHi += i_manualSingleHalfWidth

                    // Merge exact duplicates, overlaps, and near-duplicates. Re-scan after
                    // each union so one new item can bridge two older entries safely.
                    float mergedLo = zoneLo
                    float mergedHi = zoneHi
                    bool scanAgain = true
                    while scanAgain
                        scanAgain := false
                        int mergeIdx = 0
                        while mergeIdx < array.size(manualZoneLows)
                            float existingLo = array.get(manualZoneLows, mergeIdx)
                            float existingHi = array.get(manualZoneHighs, mergeIdx)
                            bool touches = mergedLo <= existingHi + i_manualMergeTolerance and mergedHi >= existingLo - i_manualMergeTolerance
                            if touches
                                mergedLo := math.min(mergedLo, existingLo)
                                mergedHi := math.max(mergedHi, existingHi)
                                array.remove(manualZoneLows, mergeIdx)
                                array.remove(manualZoneHighs, mergeIdx)
                                scanAgain := true
                            else
                                mergeIdx += 1
                    array.push(manualZoneLows, mergedLo)
                    array.push(manualZoneHighs, mergedHi)

float manualAboveNear = na
float manualAboveFar = na
float manualBelowNear = na
float manualBelowFar = na
float manualInsideLow = na
float manualInsideHigh = na
int manualAboveIndex = na
int manualBelowIndex = na
int manualInsideIndex = na

if i_useManualSR and array.size(manualZoneLows) > 0
    for manualIdx = 0 to array.size(manualZoneLows) - 1
        float mLo = array.get(manualZoneLows, manualIdx)
        float mHi = array.get(manualZoneHighs, manualIdx)
        if signalClose < mLo
            if na(manualAboveNear) or mLo < manualAboveNear
                manualAboveNear := mLo
                manualAboveFar := mHi
                manualAboveIndex := manualIdx
        else if signalClose > mHi
            if na(manualBelowNear) or mHi > manualBelowNear
                manualBelowNear := mHi
                manualBelowFar := mLo
                manualBelowIndex := manualIdx
        else
            float insideWidth = mHi - mLo
            float bestInsideWidth = not na(manualInsideHigh) and not na(manualInsideLow) ? manualInsideHigh - manualInsideLow : na
            if na(manualInsideIndex) or insideWidth < bestInsideWidth
                manualInsideLow := mLo
                manualInsideHigh := mHi
                manualInsideIndex := manualIdx

manualInsideZone = not na(manualInsideIndex)
manualResistanceEdge = manualInsideZone ? manualInsideHigh : manualAboveNear
manualSupportEdge = manualInsideZone ? manualInsideLow : manualBelowNear
manualResistanceFar = manualInsideZone ? manualInsideHigh : manualAboveFar
manualSupportFar = manualInsideZone ? manualInsideLow : manualBelowFar
manualResDist = not na(manualResistanceEdge) ? math.max(manualResistanceEdge - signalClose, 0.0) : na
manualSupDist = not na(manualSupportEdge) ? math.max(signalClose - manualSupportEdge, 0.0) : na
manualInteractionDist = not na(atr) ? atr * i_manualInteractionATR : na
nearManualResistance = manualInsideZone or (not na(manualResDist) and not na(manualInteractionDist) and manualResDist <= manualInteractionDist)
nearManualSupport = manualInsideZone or (not na(manualSupDist) and not na(manualInteractionDist) and manualSupDist <= manualInteractionDist)

// Manual candidates use the first edge encountered for targets, and the far edge
// of the level/zone for invalidation stops.
manualLongTargetCandidate = i_useManualSR and i_manualUseTargets ? manualResistanceEdge : na
manualShortTargetCandidate = i_useManualSR and i_manualUseTargets ? manualSupportEdge : na
manualLongInvalidationCandidate = i_useManualSR and i_manualUseStops ? manualSupportFar : na
manualShortInvalidationCandidate = i_useManualSR and i_manualUseStops ? manualResistanceFar : na

// ══════════════════════════════════════════
// SESSION
// ══════════════════════════════════════════

inMorning   = not na(time(timeframe.period, "0830-1100:23456", "America/New_York"))
inLunch     = not na(time(timeframe.period, "1100-1330:23456", "America/New_York"))
inAfternoon = not na(time(timeframe.period, "1330-1500:23456", "America/New_York"))
inPowerHour = not na(time(timeframe.period, "1500-1600:23456", "America/New_York"))

// ══════════════════════════════════════════
// DIVERGENCE — FIXED 5m PRICE + TRUE CUMULATIVE TICK
// ══════════════════════════════════════════

priceAtHH = not na(signalHigh20) and signalHigh >= signalHigh20
priceAtLL = not na(signalLow20) and signalLow <= signalLow20
cumTickFalling = inNYSE and not na(cumVelocity15) and not na(cumVelocity) and cumVelocity15 < 0 and cumVelocity < 0
cumTickRising = inNYSE and not na(cumVelocity15) and not na(cumVelocity) and cumVelocity15 > 0 and cumVelocity > 0
bearishDivergence = i_showDivergence and priceAtHH and cumTickFalling
bullishDivergence = i_showDivergence and priceAtLL and cumTickRising

// ══════════════════════════════════════════
// DAY TYPE — IB VS AVERAGE COMPLETED RTH RANGE
// ══════════════════════════════════════════

f_rthSessionPack() =>
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    bool inIb = not na(time(timeframe.period, "0930-1030:23456", "America/New_York"))
    bool rthStart = inRth and (not inRth[1] or f_newEtDate())
    var float ibH = na
    var float ibL = na
    var bool ibDone = false
    var float dH = na
    var float dL = na
    var float priorH = na
    var float priorL = na
    var array<float> completedRanges = array.new_float()
    if rthStart
        if not na(dH) and not na(dL) and dH > dL
            priorH := dH
            priorL := dL
            array.push(completedRanges, dH - dL)
            if array.size(completedRanges) > i_dailyATRLen
                array.shift(completedRanges)
        ibH := na
        ibL := na
        ibDone := false
        dH := high
        dL := low
    else if inRth
        dH := na(dH) ? high : math.max(dH, high)
        dL := na(dL) ? low : math.min(dL, low)
    if inIb
        ibH := na(ibH) ? high : math.max(ibH, high)
        ibL := na(ibL) ? low : math.min(ibL, low)
    else if inRth and not na(ibH) and not na(ibL)
        ibDone := true
    int completedRangeSessions = array.size(completedRanges)
    float avgRthRange = completedRangeSessions > 0 ? array.avg(completedRanges) : na
    [ibH, ibL, ibDone, dH, dL, priorH, priorL, avgRthRange, completedRangeSessions]

[ibHigh, ibLow, ibLocked, dayHigh, dayLow, priorDayHigh, priorDayLow, rthAvgRange, rthRangeSessions] = request.security(
     syminfo.tickerid, "1", f_rthSessionPack(), lookahead=barmerge.lookahead_off, calc_bars_count=30000)

ibRange = not na(ibHigh) and not na(ibLow) ? ibHigh - ibLow : na
ibPctATR = not na(ibRange) and not na(rthAvgRange) and rthAvgRange > 0 ? ibRange / rthAvgRange * 100.0 : na
ibWide = ibLocked and not na(ibPctATR) and ibPctATR >= i_ibWidePct
ibNarrow = ibLocked and not na(ibPctATR) and ibPctATR <= i_ibNarrowPct
ibNormal = ibLocked and not ibWide and not ibNarrow

dayRange = not na(dayHigh) and not na(dayLow) ? dayHigh - dayLow : na
rangeExtMult = ibLocked and not na(ibRange) and not na(dayRange) and ibRange > 0 ? dayRange / ibRange : na
strongExtension = ibLocked and not na(rangeExtMult) and rangeExtMult >= i_trendExtMult
weakExtension = ibLocked and not na(rangeExtMult) and rangeExtMult < 1.25

adStrong = internalsAvailable and math.abs(addValue) >= i_adStrongTh
adModerate = internalsAvailable and math.abs(addValue) >= i_adModerateTh and math.abs(addValue) < i_adStrongTh
adFlat = internalsAvailable and math.abs(addValue) < i_adModerateTh
internalsAligned = internalsAvailable and ((addValue > 0 and voldPct > 0) or (addValue < 0 and voldPct < 0))
internalsConflict = internalsAvailable and not breadthSlopeConfirms and
     ((addValue > i_adModerateTh and voldPct <= -i_voldPctMin) or
      (addValue < -i_adModerateTh and voldPct >= i_voldPctMin))
strongDirectional = adStrong and internalsAligned
moderateDirectional = adModerate and internalsAligned

dayRangePctATR = not na(dayRange) and not na(rthAvgRange) and rthAvgRange > 0 ? dayRange / rthAvgRange * 100.0 : na
nyHourET = hour(time, "America/New_York")
beforeLiveCut = nyHourET < i_liveTrendCutoffHour
bullLiveBias = bullTrend5 and htfBull and aboveVWAP and not na(vwapUpper) and signalClose >= vwapUpper - atr * 0.25
bearLiveBias = bearTrend5 and htfBear and belowVWAP and not na(vwapLower) and signalClose <= vwapLower + atr * 0.25
liveDirectionalBias = bullLiveBias or bearLiveBias
liveAtrExpansion = ibLocked and not na(dayRangePctATR) and dayRangePctATR >= i_liveTrendAtrPct
liveIbExtension = ibLocked and not na(rangeExtMult) and rangeExtMult >= i_liveTrendExtMult
liveAtrExpansionSoft = ibLocked and not na(dayRangePctATR) and dayRangePctATR >= i_liveTrendSoftAtrPct
internalsLeaning = internalsAligned and not internalsConflict and
     ((bullLiveBias and bullInternalSupportCount >= 2) or (bearLiveBias and bearInternalSupportCount >= 2))
liveTrendHardPath = (strongDirectional or moderateDirectional) and
     ((beforeLiveCut and liveAtrExpansion) or (liveAtrExpansion and liveIbExtension) or (liveIbExtension and strongDirectional))
liveTrendSoftPath = i_useSoftInternalsTrend and internalsLeaning and liveAtrExpansionSoft and (beforeLiveCut or liveIbExtension)
liveTrendOverride = i_useLiveTrendOverride and ibLocked and not internalsConflict and liveDirectionalBias and
     (liveTrendHardPath or liveTrendSoftPath)

dayType = not ibLocked ? "⏳ FORMING" :
          internalsConflict ? "🌀 CHOP (mixed internals)" :
          ibNarrow and strongExtension and strongDirectional ? "🚀 TREND DAY" :
          liveTrendOverride ? "🚀 TREND DAY ⚡ LIVE" :
          ibNarrow and weakExtension and not strongDirectional ? "🌀 NON-TREND" :
          ibWide and weakExtension ? "📊 NORMAL (range)" :
          ibNormal ? "📈 NORM VARIATION" :
          ibNarrow ? "👀 WATCHING (narrow IB)" :
          ibWide ? "📊 NORMAL (range)" : "──"

dayTypeMode = not ibLocked ? "Wait for 10:30 ET" :
              internalsConflict ? "Stand aside / tiny size" :
              liveTrendOverride ? "Trend override: hold runners" :
              str.contains(dayType, "TREND DAY") ? "Hold runners, trail stops" :
              str.contains(dayType, "NON-TREND") ? "Scalp only, tight stops" :
              str.contains(dayType, "NORMAL (range)") ? "Range day: scalp swings" :
              str.contains(dayType, "NORM VARIATION") ? "Swing 40-60pt moves" :
              str.contains(dayType, "WATCHING") ? "Wait for ext. confirmation" : "Standard mode"

dayTypeColor = not ibLocked ? color.new(#666666, 30) :
               internalsConflict ? #FF1744 :
               str.contains(dayType, "TREND DAY") ? #00E676 :
               str.contains(dayType, "NON-TREND") ? #FF6D00 :
               str.contains(dayType, "NORMAL (range)") ? #2196F3 :
               str.contains(dayType, "NORM VARIATION") ? #00E676 :
               str.contains(dayType, "WATCHING") ? #FFD700 : color.new(#888888, 0)

// ══════════════════════════════════════════
// v24 HONEST 10-POINT SCORE
// ══════════════════════════════════════════

bullRsiPoint = rsi >= 52 and rsi <= 72
bearRsiPoint = rsi >= 28 and rsi <= 48

bullScore = 0
bullScore += bullTrend5 ? 2 : 0
bullScore += htfBull ? 1 : 0
bullScore += aboveVWAP ? 1 : 0
bullScore += bullMomentum ? 1 : 0
bullScore += bullRsiPoint ? 1 : 0

bearScore = 0
bearScore += bearTrend5 ? 2 : 0
bearScore += htfBear ? 1 : 0
bearScore += belowVWAP ? 1 : 0
bearScore += bearMomentum ? 1 : 0
bearScore += bearRsiPoint ? 1 : 0

maxScore = 6
if i_useInternalsInScore
    maxScore += 3
    bullScore += bullAdSupport ? 1 : 0
    bullScore += bullVoldSupport ? 1 : 0
    bullScore += bullTickSupport ? 1 : 0
    bearScore += bearAdSupport ? 1 : 0
    bearScore += bearVoldSupport ? 1 : 0
    bearScore += bearTickSupport ? 1 : 0
if i_useRelStrengthInScore
    maxScore += 1
    bullScore += nqLeading ? 1 : 0
    bearScore += nqLagging ? 1 : 0

topScore = math.max(bullScore, bearScore)
direction = bullScore > bearScore ? 1 : bearScore > bullScore ? -1 : 0
scoreMargin = math.abs(bullScore - bearScore)
scoreDataReady = (not i_useInternalsInScore or internalsAvailable) and (not i_useRelStrengthInScore or not na(relStrength))
scoreReady = inNYSE and scoreDataReady
scaledGoScore = maxScore == 10 ? i_goScore : math.max(5, int(math.ceil(maxScore * 0.80)))
scaledCautionScore = maxScore == 10 ? i_cautionScore : math.max(4, int(math.ceil(maxScore * 0.70)))

// v24.5.2 attention-only score watches. These do not imply an actionable GO:
// core gates, opposing internals, VIX, BLOCKED, GO EXTENDED, risk, and room
// still decide whether a trade is actually attractive.
activeDirectionalScore = direction == 1 ? bullScore : direction == -1 ? bearScore : 0
scoreDirectionChanged = direction != 0 and direction != nz(direction[1], 0)
scoreWatch8 = scoreReady and direction != 0 and activeDirectionalScore >= 8 and
     (nz(activeDirectionalScore[1], 0) < 8 or scoreDirectionChanged)
scoreWatch9 = scoreReady and direction != 0 and activeDirectionalScore >= 9 and
     (nz(activeDirectionalScore[1], 0) < 9 or scoreDirectionChanged)
scoreWatch10 = scoreReady and direction != 0 and activeDirectionalScore >= 10 and
     (nz(activeDirectionalScore[1], 0) < 10 or scoreDirectionChanged)

bullCoreGate = not i_requireCoreGate or (bullTrend5 and aboveVWAP)
bearCoreGate = not i_requireCoreGate or (bearTrend5 and belowVWAP)
bullCoreFailReason = not i_requireCoreGate or bullCoreGate ? "" :
     not bullTrend5 and not aboveVWAP ? "5m trend + below VWAP" :
     not bullTrend5 ? "5m trend not bullish" : "Below VWAP"
bearCoreFailReason = not i_requireCoreGate or bearCoreGate ? "" :
     not bearTrend5 and not belowVWAP ? "5m trend + above VWAP" :
     not bearTrend5 ? "5m trend not bearish" : "Above VWAP"
bullEffectiveOpposing = bullOpposingInternals == 2 and exceptionalNqLong ? 1 : bullOpposingInternals
bearEffectiveOpposing = bearOpposingInternals == 2 and exceptionalNqShort ? 1 : bearOpposingInternals
bullAllThreeOppose = bullOpposingInternals >= 3
bearAllThreeOppose = bearOpposingInternals >= 3
bullTwoOppose = bullEffectiveOpposing >= 2
bearTwoOppose = bearEffectiveOpposing >= 2

rawGoLong = scoreReady and direction == 1 and bullScore >= scaledGoScore and scoreMargin >= i_minScoreMargin and bullCoreGate
rawGoShort = scoreReady and direction == -1 and bearScore >= scaledGoScore and scoreMargin >= i_minScoreMargin and bearCoreGate

liveGoLong = rawGoLong and not vixConflictLong and not (i_downgradeTwoOpposing and bullTwoOppose) and not (i_blockAllThreeOpposing and bullAllThreeOppose)
liveGoShort = rawGoShort and not vixConflictShort and not (i_downgradeTwoOpposing and bearTwoOppose) and not (i_blockAllThreeOpposing and bearAllThreeOppose)

// Optional completed-5m activation state.
// On a 5m chart, historical/Replay bars and the final realtime update represent
// the same completed candle, so GO can confirm on that close without a one-bar
// timing mismatch. The armed state then survives into the next live bar only
// while the underlying live GO remains valid. A live 30m chart can observe each
// new fixed-5m timestamp and arm from the just-finished 5m segment, but historical
// 30m bars cannot reconstruct all six unseen 5m states; those bars are therefore
// explicitly unsupported in close-confirmed mode instead of being fabricated.
useCompletedGoClose = i_goActivationMode == "Completed 5m close"
goCloseIs5mChart = chartTfSeconds == 300
goCloseHistoricalUnsupported = useCompletedGoClose and not barstate.isrealtime and not goCloseIs5mChart

varip int closeGoTrackedSignalTime = na
varip bool closeGoPendingLong = false
varip bool closeGoPendingShort = false
varip bool closeGoConfirmedLong = false
varip bool closeGoConfirmedShort = false

if goCloseIs5mChart
    if not barstate.isrealtime
        // Historical/Replay bars are completed 5m candles.
        closeGoConfirmedLong := liveGoLong
        closeGoConfirmedShort := liveGoShort
        closeGoPendingLong := false
        closeGoPendingShort := false
        closeGoTrackedSignalTime := signalTime
    else
        // Preserve a prior close-confirmed setup into the new live candle, but
        // clear it immediately if the underlying live GO deteriorates.
        if closeGoConfirmedLong and not liveGoLong
            closeGoConfirmedLong := false
        if closeGoConfirmedShort and not liveGoShort
            closeGoConfirmedShort := false
        closeGoPendingLong := liveGoLong and not closeGoConfirmedLong
        closeGoPendingShort := liveGoShort and not closeGoConfirmedShort
        if barstate.isconfirmed
            closeGoConfirmedLong := liveGoLong
            closeGoConfirmedShort := liveGoShort
            closeGoPendingLong := false
            closeGoPendingShort := false
            closeGoTrackedSignalTime := signalTime
else if barstate.isrealtime
    // Higher-timeframe live chart: signalTime advances when another fixed 5m
    // segment begins, which means the prior pending 5m state has completed.
    if na(closeGoTrackedSignalTime)
        closeGoTrackedSignalTime := signalTime
        closeGoPendingLong := liveGoLong
        closeGoPendingShort := liveGoShort
    else if signalTime != closeGoTrackedSignalTime
        closeGoConfirmedLong := closeGoPendingLong
        closeGoConfirmedShort := closeGoPendingShort
        closeGoTrackedSignalTime := signalTime
        // The prior 5m close arms the setup, but the new live 5m state must not
        // already have invalidated it. Once invalidated, a fresh close is required.
        if closeGoConfirmedLong and not liveGoLong
            closeGoConfirmedLong := false
        if closeGoConfirmedShort and not liveGoShort
            closeGoConfirmedShort := false
        closeGoPendingLong := liveGoLong and not closeGoConfirmedLong
        closeGoPendingShort := liveGoShort and not closeGoConfirmedShort
    else
        if closeGoConfirmedLong and not liveGoLong
            closeGoConfirmedLong := false
        if closeGoConfirmedShort and not liveGoShort
            closeGoConfirmedShort := false
        closeGoPendingLong := liveGoLong and not closeGoConfirmedLong
        closeGoPendingShort := liveGoShort and not closeGoConfirmedShort
else
    closeGoTrackedSignalTime := signalTime
    closeGoPendingLong := false
    closeGoPendingShort := false
    closeGoConfirmedLong := false
    closeGoConfirmedShort := false

// Close confirmation gates only initial activation. Once armed, current live
// conditions must remain valid so a stale signal cannot linger.
goLong = useCompletedGoClose ? (not goCloseHistoricalUnsupported and closeGoConfirmedLong and liveGoLong) : liveGoLong
goShort = useCompletedGoClose ? (not goCloseHistoricalUnsupported and closeGoConfirmedShort and liveGoShort) : liveGoShort
goPendingLong = useCompletedGoClose and not goCloseHistoricalUnsupported and liveGoLong and not closeGoConfirmedLong
goPendingShort = useCompletedGoClose and not goCloseHistoricalUnsupported and liveGoShort and not closeGoConfirmedShort
goPending = goPendingLong or goPendingShort
cautionLong = scoreReady and direction == 1 and not goLong and bullScore >= scaledCautionScore and scoreMargin >= 1
cautionShort = scoreReady and direction == -1 and not goShort and bearScore >= scaledCautionScore and scoreMargin >= 1

scorePenaltyReason = direction == 1 ?
     bullAllThreeOppose ? "3 internals opposing" :
     bullTwoOppose ? "2 internals opposing" :
     vixConflictLong ? "VIX opposing" :
     not bullCoreGate ? bullCoreFailReason :
     scoreMargin < i_minScoreMargin ? "Score margin thin" : "" :
     direction == -1 ?
     bearAllThreeOppose ? "3 internals opposing" :
     bearTwoOppose ? "2 internals opposing" :
     vixConflictShort ? "VIX opposing" :
     not bearCoreGate ? bearCoreFailReason :
     scoreMargin < i_minScoreMargin ? "Score margin thin" : "" : ""

// ══════════════════════════════════════════
// LEVEL ENGAGEMENT — FIXED 5m FRESHNESS / TESTING / CLIMAX
// ══════════════════════════════════════════

newDayHighBar = inNYSE and not na(dayHigh) and signalHigh >= dayHigh
newDayLowBar = inNYSE and not na(dayLow) and signalLow <= dayLow
var int lastNewDayHighTime = na
var int lastNewDayLowTime = na
if nyseSessionStart
    lastNewDayHighTime := na
    lastNewDayLowTime := na
if newDayHighBar
    lastNewDayHighTime := signalTime
if newDayLowBar
    lastNewDayLowTime := signalTime
freshDayHigh = not na(lastNewDayHighTime) and signalTime - lastNewDayHighTime <= i_freshPrintBars * FIVE_MIN_MS
freshDayLow = not na(lastNewDayLowTime) and signalTime - lastNewDayLowTime <= i_freshPrintBars * FIVE_MIN_MS

barRange = signalHigh - signalLow
closeLoc = barRange > 0 ? (signalClose - signalLow) / barRange : 0.5
closeStrongUp = closeLoc >= i_closeLocPct
closeStrongDown = closeLoc <= 1.0 - i_closeLocPct
bullInternalsNotDiverging = not bearishDivergence and not cumTickFalling
bearInternalsNotDiverging = not bullishDivergence and not cumTickRising
bullMomentumWeakening = bullMomentum and not na(momentumPrev3) and math.abs(momentum) < math.abs(momentumPrev3)
bearMomentumWeakening = bearMomentum and not na(momentumPrev3) and math.abs(momentum) < math.abs(momentumPrev3)
bullClimaxLate = consecutiveUp >= i_climaxBars and (bearishDivergence or bullMomentumWeakening)
bearClimaxLate = consecutiveDown >= i_climaxBars and (bullishDivergence or bearMomentumWeakening)

longExpanding = i_useLevelEngagement and direction == 1 and freshDayHigh and closeStrongUp and bullInternalsNotDiverging and not bullClimaxLate
shortExpanding = i_useLevelEngagement and direction == -1 and freshDayLow and closeStrongDown and bearInternalsNotDiverging and not bearClimaxLate
expanding = longExpanding or shortExpanding
longClimaxState = i_useLevelEngagement and direction == 1 and bullClimaxLate
shortClimaxState = i_useLevelEngagement and direction == -1 and bearClimaxLate
climaxState = longClimaxState or shortClimaxState
atDayExtremeLong = direction == 1 and not na(dayHigh) and signalClose >= dayHigh - atr * 0.50
atDayExtremeShort = direction == -1 and not na(dayLow) and signalClose <= dayLow + atr * 0.50
testingState = i_useLevelEngagement and ((atDayExtremeLong and not longExpanding and not longClimaxState) or
     (atDayExtremeShort and not shortExpanding and not shortClimaxState))
engagementState = not i_useLevelEngagement ? "" : expanding ? "Expanding" : climaxState ? "Climax" : testingState ? "Testing" : ""

// v24.5.7.3 separates two questions that were still coupled in v24.5.7.2:
// 1) ROOM CONTEXT: Is price structure behaving like a continuation so a nearby
//    locally generated level is a checkpoint rather than the final destination?
//    This uses the pre-veto raw GO core and price regime only. It does not grant a GO.
// 2) TRADE CONTEXT: Are internals/VIX strong enough to soften divergence and print
//    CONTINUATION LONG/SHORT? This remains strict and still uses liveGoLong/liveGoShort.
// Result: two opposing internals can produce CAUTION with honest 50p/next-destination
// room instead of a false NO ROOM reading, without weakening any GO threshold or veto.
bullRoomContext = i_useRegimeAwareRoom and rawGoLong and bullTrend5 and htfBull and regimeBull and aboveVWAP and bullMomentum
bearRoomContext = i_useRegimeAwareRoom and rawGoShort and bearTrend5 and htfBear and regimeBear and belowVWAP and bearMomentum

// Strict trade-quality continuation context. With bearish TICK divergence, two bullish
// internal votes necessarily mean A/D and VOLD are independently supporting the move.
bullContinuationContext = bullRoomContext and liveGoLong and bullInternalSupportCount >= 2 and
     bullOpposingInternals <= 1 and not internalsConflict and vixSupportsBull
bearContinuationContext = bearRoomContext and liveGoShort and bearInternalSupportCount >= 2 and
     bearOpposingInternals <= 1 and not internalsConflict and vixSupportsBear

// ══════════════════════════════════════════
// v24.5.7 RISK — CHECKPOINT + REAL DESTINATION + STRUCTURE INVALIDATION
// ══════════════════════════════════════════

f_nearestAbove(float px, float best, string bestSrc, float candidate, string candidateSrc) =>
    bool useCandidate = not na(candidate) and candidate > px and (na(best) or candidate < best)
    [useCandidate ? candidate : best, useCandidate ? candidateSrc : bestSrc]

f_nearestBelow(float px, float best, string bestSrc, float candidate, string candidateSrc) =>
    bool useCandidate = not na(candidate) and candidate < px and (na(best) or candidate > best)
    [useCandidate ? candidate : best, useCandidate ? candidateSrc : bestSrc]

f_nearestAboveFloor(float px, float minDist, float best, string bestSrc, float candidate, string candidateSrc) =>
    bool useCandidate = not na(candidate) and candidate >= px + minDist and (na(best) or candidate < best)
    [useCandidate ? candidate : best, useCandidate ? candidateSrc : bestSrc]

f_nearestBelowFloor(float px, float minDist, float best, string bestSrc, float candidate, string candidateSrc) =>
    bool useCandidate = not na(candidate) and candidate <= px - minDist and (na(best) or candidate > best)
    [useCandidate ? candidate : best, useCandidate ? candidateSrc : bestSrc]

f_continuationCheckpoint(string src) =>
    src == "RTH High" or src == "RTH Low" or src == "Swing" or src == "IBH" or src == "IBL"

longSwingCandidate = i_useSwingTarget ? lastSwingH : na
shortSwingCandidate = i_useSwingTarget ? lastSwingL : na
longPDCandidate = i_usePrevDayTarget ? priorDayHigh : na
shortPDCandidate = i_usePrevDayTarget ? priorDayLow : na
longIBCandidate = i_useIBTarget and ibLocked ? ibHigh : na
shortIBCandidate = i_useIBTarget and ibLocked ? ibLow : na

// Risk uses a fixed 5m RTH reference; the live dayHigh/dayLow remain untouched
// for chart lines, engagement, day type, and extension calculations. The normal
// nearest-obstacle test decides whether the fixed level is ahead of or behind price.
targetDayHigh = i_skipDayExtremeOnExpansion ? confirmedRthHighTarget5 : dayHigh
targetDayLow = i_skipDayExtremeOnExpansion ? confirmedRthLowTarget5 : dayLow
longDayCandidate = i_useDayExtremeTarget ? targetDayHigh : na
shortDayCandidate = i_useDayExtremeTarget ? targetDayLow : na
longVpCandidate = i_showVolProfile ? vpVAH : na
shortVpCandidate = i_showVolProfile ? vpVAL : na

[l1, l1s] = f_nearestAbove(signalClose, na, "None", longSwingCandidate, "Swing")
[l2, l2s] = f_nearestAbove(signalClose, l1, l1s, longPDCandidate, "PDH")
[l3, l3s] = f_nearestAbove(signalClose, l2, l2s, longIBCandidate, "IBH")
[l4, l4s] = f_nearestAbove(signalClose, l3, l3s, longDayCandidate, "RTH High")
[l5, l5s] = f_nearestAbove(signalClose, l4, l4s, longVpCandidate, "VAH")
[longNearestObstacle, longObstacleSource] = f_nearestAbove(signalClose, l5, l5s, manualLongTargetCandidate, "Manual S/R")
[s1, s1s] = f_nearestBelow(signalClose, na, "None", shortSwingCandidate, "Swing")
[s2, s2s] = f_nearestBelow(signalClose, s1, s1s, shortPDCandidate, "PDL")
[s3, s3s] = f_nearestBelow(signalClose, s2, s2s, shortIBCandidate, "IBL")
[s4, s4s] = f_nearestBelow(signalClose, s3, s3s, shortDayCandidate, "RTH Low")
[s5, s5s] = f_nearestBelow(signalClose, s4, s4s, shortVpCandidate, "VAL")
[shortNearestObstacle, shortObstacleSource] = f_nearestBelow(signalClose, s5, s5s, manualShortTargetCandidate, "Manual S/R")

// Second ladder: nearest real destination at or beyond the user's minimum-room
// requirement. It is used only when the closest level is a breakable checkpoint
// inside a separately proven continuation context. PDH/PDL, VAH/VAL, and Manual S/R remain terminal.
[ld1, ld1s] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, na, "None", longSwingCandidate, "Swing")
[ld2, ld2s] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, ld1, ld1s, longPDCandidate, "PDH")
[ld3, ld3s] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, ld2, ld2s, longIBCandidate, "IBH")
[ld4, ld4s] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, ld3, ld3s, longDayCandidate, "RTH High")
[ld5, ld5s] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, ld4, ld4s, longVpCandidate, "VAH")
[longContinuationDestination, longContinuationDestinationSource] = f_nearestAboveFloor(signalClose, i_minScalpRoomPts, ld5, ld5s, manualLongTargetCandidate, "Manual S/R")
[sd1, sd1s] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, na, "None", shortSwingCandidate, "Swing")
[sd2, sd2s] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, sd1, sd1s, shortPDCandidate, "PDL")
[sd3, sd3s] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, sd2, sd2s, shortIBCandidate, "IBL")
[sd4, sd4s] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, sd3, sd3s, shortDayCandidate, "RTH Low")
[sd5, sd5s] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, sd4, sd4s, shortVpCandidate, "VAL")
[shortContinuationDestination, shortContinuationDestinationSource] = f_nearestBelowFloor(signalClose, i_minScalpRoomPts, sd5, sd5s, manualShortTargetCandidate, "Manual S/R")

longStructureDist = not na(longNearestObstacle) ? longNearestObstacle - signalClose : na
shortStructureDist = not na(shortNearestObstacle) ? signalClose - shortNearestObstacle : na
structureTargetPrice = direction == 1 ? longNearestObstacle : direction == -1 ? shortNearestObstacle : na
structureTargetBaseSource = direction == 1 ? longObstacleSource : direction == -1 ? shortObstacleSource : "None"
structureDistToTarget = direction == 1 ? longStructureDist : direction == -1 ? shortStructureDist : na
longTerminalClose = (not na(longPDCandidate) and longPDCandidate > signalClose and longPDCandidate - signalClose < i_minScalpRoomPts) or
     (not na(longVpCandidate) and longVpCandidate > signalClose and longVpCandidate - signalClose < i_minScalpRoomPts) or
     (not na(manualLongTargetCandidate) and manualLongTargetCandidate > signalClose and manualLongTargetCandidate - signalClose < i_minScalpRoomPts)
shortTerminalClose = (not na(shortPDCandidate) and shortPDCandidate < signalClose and signalClose - shortPDCandidate < i_minScalpRoomPts) or
     (not na(shortVpCandidate) and shortVpCandidate < signalClose and signalClose - shortVpCandidate < i_minScalpRoomPts) or
     (not na(manualShortTargetCandidate) and manualShortTargetCandidate < signalClose and signalClose - manualShortTargetCandidate < i_minScalpRoomPts)
longCheckpointClose = bullRoomContext and not longTerminalClose and not na(longStructureDist) and longStructureDist < i_minScalpRoomPts and f_continuationCheckpoint(longObstacleSource)
shortCheckpointClose = bearRoomContext and not shortTerminalClose and not na(shortStructureDist) and shortStructureDist < i_minScalpRoomPts and f_continuationCheckpoint(shortObstacleSource)
continuationRoomActive = direction == 1 ? longCheckpointClose : direction == -1 ? shortCheckpointClose : false
checkpointPrice = direction == 1 and longCheckpointClose ? longNearestObstacle : direction == -1 and shortCheckpointClose ? shortNearestObstacle : na
checkpointSource = direction == 1 and longCheckpointClose ? longObstacleSource : direction == -1 and shortCheckpointClose ? shortObstacleSource : "None"
checkpointDist = direction == 1 and longCheckpointClose ? longStructureDist : direction == -1 and shortCheckpointClose ? shortStructureDist : na

longAtrFallback = i_useATRTarget ? signalClose + atr * i_targetATRMult : na
shortAtrFallback = i_useATRTarget ? signalClose - atr * i_targetATRMult : na
float targetPrice = na
string targetBaseSource = "None"
if direction == 1
    if i_useScalpRiskMode
        if longCheckpointClose
            float continuationDistLong = not na(longContinuationDestination) ? longContinuationDestination - signalClose : na
            bool continuationCapsLong = not na(continuationDistLong) and continuationDistLong < i_scalpTargetPts
            targetPrice := continuationCapsLong ? longContinuationDestination : signalClose + i_scalpTargetPts
            targetBaseSource := continuationCapsLong ? longContinuationDestinationSource : "Scalp " + str.tostring(i_scalpTargetPts, "#") + "p"
        else
            bool structuralCapsLong = not na(longStructureDist) and longStructureDist < i_scalpTargetPts
            targetPrice := structuralCapsLong ? longNearestObstacle : signalClose + i_scalpTargetPts
            targetBaseSource := structuralCapsLong ? longObstacleSource : "Scalp " + str.tostring(i_scalpTargetPts, "#") + "p"
    else
        targetPrice := not na(longNearestObstacle) ? longNearestObstacle : longAtrFallback
        targetBaseSource := not na(longNearestObstacle) ? longObstacleSource : not na(longAtrFallback) ? str.tostring(i_targetATRMult, "#.##") + "x ATR" : "None"
else if direction == -1
    if i_useScalpRiskMode
        if shortCheckpointClose
            float continuationDistShort = not na(shortContinuationDestination) ? signalClose - shortContinuationDestination : na
            bool continuationCapsShort = not na(continuationDistShort) and continuationDistShort < i_scalpTargetPts
            targetPrice := continuationCapsShort ? shortContinuationDestination : signalClose - i_scalpTargetPts
            targetBaseSource := continuationCapsShort ? shortContinuationDestinationSource : "Scalp " + str.tostring(i_scalpTargetPts, "#") + "p"
        else
            bool structuralCapsShort = not na(shortStructureDist) and shortStructureDist < i_scalpTargetPts
            targetPrice := structuralCapsShort ? shortNearestObstacle : signalClose - i_scalpTargetPts
            targetBaseSource := structuralCapsShort ? shortObstacleSource : "Scalp " + str.tostring(i_scalpTargetPts, "#") + "p"
    else
        targetPrice := not na(shortNearestObstacle) ? shortNearestObstacle : shortAtrFallback
        targetBaseSource := not na(shortNearestObstacle) ? shortObstacleSource : not na(shortAtrFallback) ? str.tostring(i_targetATRMult, "#.##") + "x ATR" : "None"

// Nearest meaningful invalidation below/above entry. The required stop is not
// silently squeezed inside the user's max; if it needs more room, the trade is blocked.
[li1, li1s] = f_nearestBelow(signalClose, na, "None", lastSwingL, "Swing L")
[li2, li2s] = f_nearestBelow(signalClose, li1, li1s, slowEMA, "EMA21")
[li3, li3s] = f_nearestBelow(signalClose, li2, li2s, vwap, "VWAP")
[longInvalidationLevel, longInvalidationSource] = f_nearestBelow(signalClose, li3, li3s, manualLongInvalidationCandidate, "Manual S/R")
[si1, si1s] = f_nearestAbove(signalClose, na, "None", lastSwingH, "Swing H")
[si2, si2s] = f_nearestAbove(signalClose, si1, si1s, slowEMA, "EMA21")
[si3, si3s] = f_nearestAbove(signalClose, si2, si2s, vwap, "VWAP")
[shortInvalidationLevel, shortInvalidationSource] = f_nearestAbove(signalClose, si3, si3s, manualShortInvalidationCandidate, "Manual S/R")

// Structure-first stop engine. VWAP/EMA21/swing + buffer is the actual stop.
// ATR is a fallback only when no valid structure exists, not a mandatory floor.
atrFallbackStopDist = atr * i_stopATR
minNoiseStopDist = atr * i_minStructureStopATR
longStructureStop = not na(longInvalidationLevel) ? longInvalidationLevel - atr * i_stopStructureBufferATR : na
shortStructureStop = not na(shortInvalidationLevel) ? shortInvalidationLevel + atr * i_stopStructureBufferATR : na
longStructureStopDist = not na(longStructureStop) ? signalClose - longStructureStop : na
shortStructureStopDist = not na(shortStructureStop) ? shortStructureStop - signalClose : na
longHasStructure = not na(longStructureStopDist) and longStructureStopDist > 0
shortHasStructure = not na(shortStructureStopDist) and shortStructureStopDist > 0
longRawStopDist = longHasStructure ? longStructureStopDist : atrFallbackStopDist
shortRawStopDist = shortHasStructure ? shortStructureStopDist : atrFallbackStopDist
longNoiseFloorUsed = longHasStructure and minNoiseStopDist > longStructureStopDist
shortNoiseFloorUsed = shortHasStructure and minNoiseStopDist > shortStructureStopDist
longRequiredStopDist = not na(longRawStopDist) ? math.max(longRawStopDist, minNoiseStopDist) : na
shortRequiredStopDist = not na(shortRawStopDist) ? math.max(shortRawStopDist, minNoiseStopDist) : na
stopDistance = direction == 1 ? longRequiredStopDist : direction == -1 ? shortRequiredStopDist : na
scalpMaxStop = i_scalpStopMode == "Conservative (30)" ? 30.0 :
     i_scalpStopMode == "Loose (50)" ? 50.0 :
     i_scalpStopMode == "Wide (75)" ? 75.0 :
     i_scalpStopMode == "Custom" ? i_scalpMaxStopPts : 40.0
stopTooWide = i_useScalpRiskMode and not na(stopDistance) and stopDistance > scalpMaxStop
suggestedStop = direction == 1 and not na(stopDistance) ? signalClose - stopDistance : direction == -1 and not na(stopDistance) ? signalClose + stopDistance : na
longStopSource = not longHasStructure ? "ATR fallback" : longNoiseFloorUsed ? "Noise floor over " + longInvalidationSource : longInvalidationSource + "+buf"
shortStopSource = not shortHasStructure ? "ATR fallback" : shortNoiseFloorUsed ? "Noise floor over " + shortInvalidationSource : shortInvalidationSource + "+buf"
stopSource = direction == 1 ? longStopSource : direction == -1 ? shortStopSource : "None"

targetStars = targetBaseSource == "Swing" or targetBaseSource == "PDH" or targetBaseSource == "PDL" ? "★★★" :
     targetBaseSource == "IBH" or targetBaseSource == "IBL" or targetBaseSource == "RTH High" or targetBaseSource == "RTH Low" or targetBaseSource == "VAH" or targetBaseSource == "VAL" or targetBaseSource == "Manual S/R" ? "★★" :
     str.contains(targetBaseSource, "ATR") ? "★" : ""
targetSource = i_showTargetQuality and targetStars != "" ? targetBaseSource + " " + targetStars : targetBaseSource
distToTarget = not na(targetPrice) ? math.abs(targetPrice - signalClose) : na
riskReward = not na(distToTarget) and not na(stopDistance) and stopDistance > 0 ? distToTarget / stopDistance : na
roomDist = continuationRoomActive ? distToTarget : structureDistToTarget
scalpRoomBlocked = i_useScalpRiskMode and not na(roomDist) and roomDist < i_minScalpRoomPts
roomLabel = direction == 0 or not i_useScalpRiskMode ? "" : na(roomDist) ? "Room open" : roomDist < i_minScalpRoomPts ? "No room" : roomDist < 60.0 ? "Scalp OK" : "Room open"

// ══════════════════════════════════════════
// SMART VWAP BAND CONTEXT
// ══════════════════════════════════════════

ridingUpperBand = i_smartBands and nearUpper and goLong  and bullTrend5 and htfBull and aboveVWAP and bullInternalsConfirm and vixSupportsBull
ridingLowerBand = i_smartBands and nearLower and goShort and bearTrend5 and htfBear and belowVWAP and bearInternalsConfirm and vixSupportsBear

// ══════════════════════════════════════════
// SMART VOLUME — RVOL AT TIME OF DAY (TOD-only)
// ══════════════════════════════════════════
// v22 TOD update: replaces the plain rolling 20-bar volume average with a
// same-time-of-day baseline. On a 5m chart, the 9:30 bar compares to prior
// 9:30 bars, lunch compares to prior lunch bars, etc. Uses 10 completed RTH
// sessions, matching TradingView's official RVOL-at-Time screener method.

const int RVOL_TOD_DAYS = 10
const int RVOL_TOD_MAX_SLOTS = 1000

var array<float> rvolTodCur  = array.new_float(RVOL_TOD_MAX_SLOTS, na)
var array<float> rvolTodHist = array.new_float(RVOL_TOD_MAX_SLOTS * RVOL_TOD_DAYS, na)
var int  rvolTodWrite    = 0
var int  rvolTodSessions = 0
var int  rvolTodSlot     = na
var bool rvolTodRolled   = true

f_rvolTodClear(array<float> cur) =>
    for s = 0 to RVOL_TOD_MAX_SLOTS - 1
        array.set(cur, s, na)

f_rvolTodCommit(array<float> cur, array<float> hist, int writeIdx, int sessions) =>
    for s = 0 to RVOL_TOD_MAX_SLOTS - 1
        array.set(hist, s * RVOL_TOD_DAYS + writeIdx, array.get(cur, s))
    [(writeIdx + 1) % RVOL_TOD_DAYS, math.min(sessions + 1, RVOL_TOD_DAYS)]

prevInNYSEForTod = inNYSE[1] == true
rvolTodNewSession = inNYSE and (not prevInNYSEForTod or isNewDay)
rvolTodEndSession = not inNYSE and prevInNYSEForTod

if (rvolTodNewSession or rvolTodEndSession) and not rvolTodRolled
    [rvolTodWriteNext, rvolTodSessionsNext] = f_rvolTodCommit(rvolTodCur, rvolTodHist, rvolTodWrite, rvolTodSessions)
    rvolTodWrite    := rvolTodWriteNext
    rvolTodSessions := rvolTodSessionsNext
    rvolTodRolled   := true

if rvolTodNewSession
    f_rvolTodClear(rvolTodCur)
    rvolTodSlot   := 0
    rvolTodRolled := false
else if inNYSE
    rvolTodSlot := prevInNYSEForTod ? nz(rvolTodSlot[1]) + 1 : 0
else
    rvolTodSlot := na

float volAvg = na
if inNYSE and not na(rvolTodSlot) and rvolTodSlot >= 0 and rvolTodSlot < RVOL_TOD_MAX_SLOTS and rvolTodSessions > 0
    float todSum = 0.0
    int todCount = 0
    for d = 0 to RVOL_TOD_DAYS - 1
        float todVol = array.get(rvolTodHist, rvolTodSlot * RVOL_TOD_DAYS + d)
        if not na(todVol)
            todSum   += todVol
            todCount += 1
    volAvg := todCount > 0 ? todSum / todCount : na

if inNYSE and not na(rvolTodSlot) and rvolTodSlot >= 0 and rvolTodSlot < RVOL_TOD_MAX_SLOTS
    array.set(rvolTodCur, rvolTodSlot, volume)

// ──────────────────────────────────────────
// v23: COMPLETED 1-MINUTE PACING ENGINE
// ──────────────────────────────────────────
// request.security_lower_tf() returns every available 1-minute intrabar in
// the current chart candle. On a live candle, the still-open final minute is
// deliberately excluded using its timestamp, so the read advances in firm
// one-minute steps instead of fluctuating tick by tick.
//
// The history is stored by absolute RTH minute:
// slot 0 = 09:30 ET ... slot 389 = 15:59 ET.
// Current pace is compared only with the exact matching completed slots.

const int RVOL_1M_DAYS = 10
const int RVOL_1M_SLOTS = 390
var array<float> rvol1mCur  = array.new_float(RVOL_1M_SLOTS, na)
var array<float> rvol1mHist = array.new_float(RVOL_1M_SLOTS * RVOL_1M_DAYS, na)
var int  rvol1mWrite    = 0
var int  rvol1mSessions = 0
var bool rvol1mRolled   = true

f_rvol1mClear(array<float> cur) =>
    for s = 0 to RVOL_1M_SLOTS - 1
        array.set(cur, s, na)

f_rvol1mCommit(array<float> cur, array<float> hist, int writeIdx, int sessions) =>
    for s = 0 to RVOL_1M_SLOTS - 1
        array.set(hist, s * RVOL_1M_DAYS + writeIdx, array.get(cur, s))
    [(writeIdx + 1) % RVOL_1M_DAYS, math.min(sessions + 1, RVOL_1M_DAYS)]

f_rvol1mAvg(array<float> hist, int slot) =>
    float slotSum = 0.0
    int slotCount = 0
    if slot >= 0 and slot < RVOL_1M_SLOTS
        for d = 0 to RVOL_1M_DAYS - 1
            float histVol = array.get(hist, slot * RVOL_1M_DAYS + d)
            if not na(histVol)
                slotSum   += histVol
                slotCount += 1
    slotCount > 0 ? slotSum / slotCount : na

prevInNYSEFor1m = inNYSE[1] == true
rvol1mNewSession = inNYSE and (not prevInNYSEFor1m or isNewDay)
rvol1mEndSession = not inNYSE and prevInNYSEFor1m

if (rvol1mNewSession or rvol1mEndSession) and not rvol1mRolled
    [rvol1mWriteNext, rvol1mSessionsNext] = f_rvol1mCommit(rvol1mCur, rvol1mHist, rvol1mWrite, rvol1mSessions)
    rvol1mWrite    := rvol1mWriteNext
    rvol1mSessions := rvol1mSessionsNext
    rvol1mRolled   := true

if rvol1mNewSession
    f_rvol1mClear(rvol1mCur)
    rvol1mRolled := false

// The shared one-minute arrays were requested above and also feed the profile.
useOneMinPacing = i_use1mVolPacing and oneMinChartEligible

int oneMinCompletedCount = 0
int oneMinComparedCount  = 0
float oneMinObservedSum  = 0.0
float oneMinExpectedSum  = 0.0

if oneMinChartEligible and oneMinArrayCount > 0
    for i = 0 to oneMinArrayCount - 1
        int oneMinTs = array.get(oneMinTimes, i)
        float oneMinVol = array.get(oneMinVolumes, i)
        int oneMinSlot = f_rthMinuteSlot(oneMinTs)

        // Historical intrabars are confirmed. On the live chart candle,
        // exclude only the minute whose scheduled close is still in the future.
        bool oneMinStillOpen = barstate.isrealtime and oneMinTs + ONE_MIN_MS > timenow

        if not na(oneMinSlot) and not na(oneMinVol) and not oneMinStillOpen
            // Store every completed RTH minute for the rolling history, but only
            // compare minutes belonging to the current fixed five-minute signal bar.
            array.set(rvol1mCur, oneMinSlot, oneMinVol)
            bool inCurrentSignalBar = not na(signalTime) and oneMinTs >= signalTime and oneMinTs < signalTime + FIVE_MIN_MS
            if inCurrentSignalBar
                oneMinCompletedCount += 1
                float oneMinSlotAvg = rvol1mSessions > 0 ? f_rvol1mAvg(rvol1mHist, oneMinSlot) : na
                if not na(oneMinSlotAvg) and oneMinSlotAvg > 0
                    oneMinObservedSum += oneMinVol
                    oneMinExpectedSum += oneMinSlotAvg
                    oneMinComparedCount += 1

float oneMinPaceVol = oneMinComparedCount > 0 ? oneMinObservedSum : na
float oneMinPaceAvg = oneMinComparedCount > 0 ? oneMinExpectedSum : na

// Selected engine. In pacing mode there is intentionally no silent fallback:
// before the first completed minute, or while history is still building, the
// dashboard says WAIT/BUILDING rather than pretending the full chart bar is valid.
float smartVolObserved = useOneMinPacing ? oneMinPaceVol : volume
float smartVolExpected = useOneMinPacing ? oneMinPaceAvg : volAvg

// ══════════════════════════════════════════
// TREND EXHAUSTION / CLIMAX — FIXED 5m CONTEXT
// ══════════════════════════════════════════

volRatio = not na(smartVolObserved) and not na(smartVolExpected) and smartVolExpected > 0 ? smartVolObserved / smartVolExpected : na
vwapStretch = atr > 0 and not na(vwap) ? math.abs(signalClose - vwap) / atr : na
volDelta = useOneMinPacing ? (not na(smartVolObserved) and not na(smartVolExpected) ? smartVolObserved - smartVolExpected : na) :
     (na(volume[1]) ? na : volume - volume[1])
volHot = not na(volRatio) and volRatio >= i_volHotMult
volDead = not na(volRatio) and volRatio <= i_volDeadMult
volumeClimax = not na(volRatio) and volRatio >= i_exhaustVolMult and
     (not useOneMinPacing or oneMinComparedCount >= i_exhaustMinMinutes) and
     not na(barRange) and not na(atr) and barRange >= atr * i_exhaustRangeATR

buyExhaustScore = 0
buyExhaustScore += aboveVWAP and not na(vwapStretch) and vwapStretch >= i_exhaustVwapATR ? 2 : 0
buyExhaustScore += aboveVWAP and not na(vwapStretch) and vwapStretch >= i_climaxVwapATR ? 1 : 0
buyExhaustScore += rsi >= 72 ? 1 : 0
buyExhaustScore += consecutiveUp >= i_exhaustBars ? 1 : 0
buyExhaustScore += volumeClimax and signalClose > signalOpen ? 1 : 0
buyExhaustScore += bearishDivergence ? 2 : 0
buyExhaustScore += bullMomentumWeakening ? 1 : 0

sellExhaustScore = 0
sellExhaustScore += belowVWAP and not na(vwapStretch) and vwapStretch >= i_exhaustVwapATR ? 2 : 0
sellExhaustScore += belowVWAP and not na(vwapStretch) and vwapStretch >= i_climaxVwapATR ? 1 : 0
sellExhaustScore += rsi <= 28 ? 1 : 0
sellExhaustScore += consecutiveDown >= i_exhaustBars ? 1 : 0
sellExhaustScore += volumeClimax and signalClose < signalOpen ? 1 : 0
sellExhaustScore += bullishDivergence ? 2 : 0
sellExhaustScore += bearMomentumWeakening ? 1 : 0

exhaustSide = direction == 1 ? 1 : direction == -1 ? -1 : buyExhaustScore > sellExhaustScore ? 1 : sellExhaustScore > buyExhaustScore ? -1 : 0
exhaustScore = exhaustSide == 1 ? buyExhaustScore : exhaustSide == -1 ? sellExhaustScore : math.max(buyExhaustScore, sellExhaustScore)
exhaustClimax = i_showExhaustion and exhaustScore >= i_exhaustClimaxScore
exhaustRisk = i_showExhaustion and exhaustScore >= i_exhaustRiskScore and not exhaustClimax
exhaustActive = exhaustRisk or exhaustClimax

// ══════════════════════════════════════════
// SMART ENTRY BLOCK — RISK / ROOM / INVALIDATION / EXHAUSTION
// ══════════════════════════════════════════

rrBlocked = not na(riskReward) and riskReward < i_blockMinRR
strongBullContinuation = direction == 1 and bullTrend5 and htfBull and aboveVWAP and bullMomentum and bullInternalsConfirm and vixSupportsBull
strongBearContinuation = direction == -1 and bearTrend5 and htfBear and belowVWAP and bearMomentum and bearInternalsConfirm and vixSupportsBear

// Divergence is still fully displayed and still adds exhaustion pressure. It is
// downgraded from hard veto to context warning only when A/D + VOLD, all three
// trend frames, momentum, VWAP and the ordinary GO gate independently agree.
bearDivergenceWarning = bearishDivergence and bullContinuationContext and not bullMomentumWeakening and not longClimaxState and not exhaustClimax
bullDivergenceWarning = bullishDivergence and bearContinuationContext and not bearMomentumWeakening and not shortClimaxState and not exhaustClimax
bearDivergenceHard = bearishDivergence and not bearDivergenceWarning
bullDivergenceHard = bullishDivergence and not bullDivergenceWarning

longExhaustionBlock = direction == 1 and nearResistance and nearUpper and (bearDivergenceHard or bullMomentumWeakening or exhaustRisk or exhaustClimax)
shortExhaustionBlock = direction == -1 and nearSupport and nearLower and (bullDivergenceHard or bearMomentumWeakening or exhaustRisk or exhaustClimax)
longLevelBlocked = direction == 1 and (bearDivergenceHard or (longExhaustionBlock and not strongBullContinuation and not longExpanding))
shortLevelBlocked = direction == -1 and (bullDivergenceHard or (shortExhaustionBlock and not strongBearContinuation and not shortExpanding))

blockedLong = i_showBlockedState and (goLong or cautionLong) and direction == 1 and (stopTooWide or rrBlocked or scalpRoomBlocked or longLevelBlocked)
blockedShort = i_showBlockedState and (goShort or cautionShort) and direction == -1 and (stopTooWide or rrBlocked or scalpRoomBlocked or shortLevelBlocked)
blockedReason = blockedLong or blockedShort ?
     stopTooWide ? "Stop too wide" :
     scalpRoomBlocked ? "No scalp room" :
     rrBlocked ? "Poor R:R" :
     climaxState ? "Climax — no chase" :
     direction == 1 and longExhaustionBlock ? "Exhaustion at level" :
     direction == -1 and shortExhaustionBlock ? "Exhaustion at level" :
     direction == 1 and bearDivergenceHard ? "Bear divergence" :
     direction == -1 and bullDivergenceHard ? "Bull divergence" : "Entry blocked" : ""

// ══════════════════════════════════════════
// v24 GO EXTENDED — TREND DAYS STILL RESPECT SERIOUS WARNINGS
// ══════════════════════════════════════════

trueTrendDay = liveTrendOverride or str.contains(dayType, "TREND DAY")
longContinuationRegime = trueTrendDay or bullContinuationContext
shortContinuationRegime = trueTrendDay or bearContinuationContext
longLowExtensionPct = not na(dayRange) and dayRange > 0 and not na(dayLow) ? (signalClose - dayLow) / dayRange * 100.0 : na
shortHighExtensionPct = not na(dayRange) and dayRange > 0 and not na(dayHigh) ? (dayHigh - signalClose) / dayRange * 100.0 : na
longLowExtended = not longContinuationRegime and not na(longLowExtensionPct) and longLowExtensionPct >= i_extVetoLowExtPct
shortHighExtended = not shortContinuationRegime and not na(shortHighExtensionPct) and shortHighExtensionPct >= i_extVetoLowExtPct
longActiveVwapVetoATR = longContinuationRegime ? i_trendVetoVwapATR : i_extVetoVwapATR
shortActiveVwapVetoATR = shortContinuationRegime ? i_trendVetoVwapATR : i_extVetoVwapATR
longVwapExtended = aboveVWAP and not na(vwapStretch) and vwapStretch >= longActiveVwapVetoATR
shortVwapExtended = belowVWAP and not na(vwapStretch) and vwapStretch >= shortActiveVwapVetoATR
longVpEdge = i_showVolProfile and not na(vpVAH) and not na(atr) and atr > 0 and math.abs(signalClose - vpVAH) <= atr * i_extVetoVpEdgeATR
shortVpEdge = i_showVolProfile and not na(vpVAL) and not na(atr) and atr > 0 and math.abs(signalClose - vpVAL) <= atr * i_extVetoVpEdgeATR
longManualEdge = i_useManualSR and not na(manualResDist) and not na(atr) and atr > 0 and manualResDist <= atr * i_manualInteractionATR
shortManualEdge = i_useManualSR and not na(manualSupDist) and not na(atr) and atr > 0 and manualSupDist <= atr * i_manualInteractionATR
longSeriousFlag = longClimaxState or (exhaustClimax and direction == 1) or bearDivergenceHard or longVwapExtended
shortSeriousFlag = shortClimaxState or (exhaustClimax and direction == -1) or bullDivergenceHard or shortVwapExtended
longExtendedFlags = (longLowExtended ? 1 : 0) + ((longClimaxState or (exhaustClimax and direction == 1)) ? 1 : 0) +
     (longVwapExtended ? 1 : 0) + (longVpEdge ? 1 : 0) + (longManualEdge ? 1 : 0) + (bearDivergenceHard ? 1 : 0)
shortExtendedFlags = (shortHighExtended ? 1 : 0) + ((shortClimaxState or (exhaustClimax and direction == -1)) ? 1 : 0) +
     (shortVwapExtended ? 1 : 0) + (shortVpEdge ? 1 : 0) + (shortManualEdge ? 1 : 0) + (bullDivergenceHard ? 1 : 0)

f_appendExtendedFlag(string current, bool active, string flag) =>
    active ? (current == "" ? flag : current + " + " + flag) : current

string longExtendedFlagTxt = ""
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, longLowExtended, "RTH range edge")
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, longClimaxState or (exhaustClimax and direction == 1), "Climax")
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, longVwapExtended, "VWAP stretch")
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, longVpEdge, "VAH edge")
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, longManualEdge, "Manual S/R")
longExtendedFlagTxt := f_appendExtendedFlag(longExtendedFlagTxt, bearDivergenceHard, "Bear divergence")
string shortExtendedFlagTxt = ""
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, shortHighExtended, "RTH range edge")
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, shortClimaxState or (exhaustClimax and direction == -1), "Climax")
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, shortVwapExtended, "VWAP stretch")
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, shortVpEdge, "VAL edge")
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, shortManualEdge, "Manual S/R")
shortExtendedFlagTxt := f_appendExtendedFlag(shortExtendedFlagTxt, bullDivergenceHard, "Bull divergence")

goExtendedLong = i_useExtendedVeto and goLong and direction == 1 and not blockedLong and longExtendedFlags >= i_extVetoMinFlags and (not longContinuationRegime or longSeriousFlag)
goExtendedShort = i_useExtendedVeto and goShort and direction == -1 and not blockedShort and shortExtendedFlags >= i_extVetoMinFlags and (not shortContinuationRegime or shortSeriousFlag)
goExtended = goExtendedLong or goExtendedShort
extendedReason = goExtendedLong ? str.tostring(longExtendedFlags) + " flags: " + longExtendedFlagTxt :
     goExtendedShort ? str.tostring(shortExtendedFlags) + " flags: " + shortExtendedFlagTxt : ""
continuationLong = goLong and direction == 1 and (continuationRoomActive or bearDivergenceWarning) and not blockedLong and not goExtendedLong
continuationShort = goShort and direction == -1 and (continuationRoomActive or bullDivergenceWarning) and not blockedShort and not goExtendedShort
continuationTrade = continuationLong or continuationShort

// ── Optional first-GO outcome diagnostic (5-minute charts only) ──
diagIs5m = timeframe.in_seconds(timeframe.period) == 300
longActionable = goLong and not blockedLong and not goExtendedLong
shortActionable = goShort and not blockedShort and not goExtendedShort
newDiagLong = i_diagMode and diagIs5m and longActionable and not longActionable[1]
newDiagShort = i_diagMode and diagIs5m and shortActionable and not shortActionable[1]
var int diagDir = 0
var float diagEntry = na
var int diagStartBar = na
var int diagWins = 0
var int diagLosses = 0
var int diagTimeouts = 0
var int diagAmbiguous = 0
diagSessionExpired = diagDir != 0 and (nyseSessionEnd or (nyseSessionStart and bar_index > nz(diagStartBar)))
if i_diagMode and diagIs5m and diagSessionExpired
    diagTimeouts += 1
    diagDir := 0
    diagEntry := na
    diagStartBar := na

if diagDir == 0 and (newDiagLong or newDiagShort)
    diagDir := newDiagLong ? 1 : -1
    diagEntry := signalClose
    diagStartBar := bar_index
if i_diagMode and diagIs5m and diagDir != 0 and bar_index > nz(diagStartBar)
    bool hitTarget = diagDir == 1 ? high >= diagEntry + i_diagTargetPts : low <= diagEntry - i_diagTargetPts
    bool hitStop = diagDir == 1 ? low <= diagEntry - i_diagStopPts : high >= diagEntry + i_diagStopPts
    bool timedOut = bar_index - diagStartBar >= i_diagHorizonBars
    if hitTarget and hitStop
        diagLosses += 1
        diagAmbiguous += 1
        diagDir := 0
    else if hitTarget
        diagWins += 1
        diagDir := 0
    else if hitStop
        diagLosses += 1
        diagDir := 0
    else if timedOut
        diagTimeouts += 1
        diagDir := 0
    if diagDir == 0
        diagEntry := na
        diagStartBar := na

// ══════════════════════════════════════════
// v24 STRUCTURAL REVERSAL + CONFIRMATION — ENTIRELY FIXED 5m
// ══════════════════════════════════════════

f_reversalPack() =>
    float f = ta.ema(close, i_fastLen)
    float s = ta.ema(close, i_slowLen)
    float t = ta.ema(close, i_trendLen)
    float a = ta.atr(14)
    int revLookbackBars = math.max(2, int(math.round(i_revLookbackMin / 5.0)))
    int b1 = ta.barssince(ta.crossover(close, f))
    int b2 = ta.barssince(ta.crossover(f, s))
    int b3 = ta.barssince(ta.crossover(f, t))
    int b4 = ta.barssince(ta.crossover(close, t))
    int s1 = ta.barssince(ta.crossunder(close, f))
    int s2 = ta.barssince(ta.crossunder(f, s))
    int s3 = ta.barssince(ta.crossunder(f, t))
    int s4 = ta.barssince(ta.crossunder(close, t))
    int bullCount = ((not na(b1) and b1 <= revLookbackBars) ? 1 : 0) + ((not na(b2) and b2 <= revLookbackBars) ? 1 : 0) +
         ((not na(b3) and b3 <= revLookbackBars) ? 1 : 0) + ((not na(b4) and b4 <= revLookbackBars) ? 1 : 0)
    int bearCount = ((not na(s1) and s1 <= revLookbackBars) ? 1 : 0) + ((not na(s2) and s2 <= revLookbackBars) ? 1 : 0) +
         ((not na(s3) and s3 <= revLookbackBars) ? 1 : 0) + ((not na(s4) and s4 <= revLookbackBars) ? 1 : 0)
    int bullLatest = math.min(math.min(nz(b1, 100000), nz(b2, 100000)), math.min(nz(b3, 100000), nz(b4, 100000)))
    int bearLatest = math.min(math.min(nz(s1, 100000), nz(s2, 100000)), math.min(nz(s3, 100000), nz(s4, 100000)))
    bool bullRaw = i_showReversal and bullCount >= i_revMinSignals
    bool bearRaw = i_showReversal and bearCount >= i_revMinSignals
    bool bullForm = bullRaw and (not bearRaw or bullLatest <= bearLatest)
    bool bearForm = bearRaw and (not bullRaw or bearLatest < bullLatest)
    bool bullFired = bullForm and not bullForm[1]
    bool bearFired = bearForm and not bearForm[1]
    var int bullHeld = 0
    var int bearHeld = 0
    var bool bullLatch = false
    var bool bearLatch = false
    if bullFired
        bullHeld := 0
        bullLatch := false
    if bearFired
        bearHeld := 0
        bearLatch := false
    bullHeld := bullForm and close > s ? bullHeld + 1 : bullForm ? 0 : 0
    bearHeld := bearForm and close < s ? bearHeld + 1 : bearForm ? 0 : 0
    bool bullTest = bullForm and low <= s + a * 0.15 and close > s
    bool bearTest = bearForm and high >= s - a * 0.15 and close < s
    int bullTestAgo = ta.barssince(bullTest)
    int bearTestAgo = ta.barssince(bearTest)
    int bullFiredAgo = ta.barssince(bullFired)
    int bearFiredAgo = ta.barssince(bearFired)
    bool bullPullback = i_confirmPullback and bullForm and not na(bullTestAgo) and not na(bullFiredAgo) and bullFiredAgo > 0 and bullTestAgo <= bullFiredAgo and bullTestAgo <= i_confirmPullbackLook and close > s
    bool bearPullback = i_confirmPullback and bearForm and not na(bearTestAgo) and not na(bearFiredAgo) and bearFiredAgo > 0 and bearTestAgo <= bearFiredAgo and bearTestAgo <= i_confirmPullbackLook and close < s
    if i_showConfirmation and bullForm and (bullHeld >= i_confirmBars or bullPullback)
        bullLatch := true
    if i_showConfirmation and bearForm and (bearHeld >= i_confirmBars or bearPullback)
        bearLatch := true
    if not bullForm
        bullLatch := false
    if not bearForm
        bearLatch := false
    bool bullJust = bullLatch and not bullLatch[1]
    bool bearJust = bearLatch and not bearLatch[1]
    int bullConfirmedAgo = ta.barssince(bullJust)
    int bearConfirmedAgo = ta.barssince(bearJust)
    bool showBull = i_showConfirmation and not na(bullConfirmedAgo) and bullConfirmedAgo < i_confirmBannerBars
    bool showBear = i_showConfirmation and not na(bearConfirmedAgo) and bearConfirmedAgo < i_confirmBannerBars
    [bullForm, bearForm, bullLatch, bearLatch, bullJust, bearJust, showBull, showBear]

[bullReversalForming, bearReversalForming, bullConfirmedLatch, bearConfirmedLatch,
 bullJustConfirmed, bearJustConfirmed, showBullConfirmed, showBearConfirmed] = request.security(
     syminfo.tickerid, SIGNAL_TF, f_reversalPack(), lookahead=barmerge.lookahead_off, calc_bars_count=5000)
reversalActive = bullReversalForming or bearReversalForming
bullStillForming = bullReversalForming and not bullConfirmedLatch
bearStillForming = bearReversalForming and not bearConfirmedLatch

currentBullSide = exhaustSide == 1
currentBearSide = exhaustSide == -1
fatigueSignal = (currentBullSide and (bearDivergenceHard or bullMomentumWeakening)) or
     (currentBearSide and (bullDivergenceHard or bearMomentumWeakening))
trendExpansion = i_showExhaustion and not exhaustRisk and not exhaustClimax and liveTrendOverride and
     ((currentBullSide and bullLiveBias and nearUpper) or (currentBearSide and bearLiveBias and nearLower))
healthyTrend = i_showExhaustion and not trendExpansion and not fatigueSignal and not exhaustRisk and not exhaustClimax

exhaustLabel = not i_showExhaustion ? "Hidden" :
               showBullConfirmed ? "✅ Bull Reversal Confirmed" :
               showBearConfirmed ? "✅ Bear Reversal Confirmed" :
               bullStillForming ? "🔄 Bull Reversal Forming" :
               bearStillForming ? "🔄 Bear Reversal Forming" :
               direction == 0 ? "⏸ No active signal" :
               exhaustClimax and currentBullSide ? "🔥 Buy Climax Risk" :
               exhaustClimax and currentBearSide ? "🔥 Sell Climax Risk" :
               fatigueSignal and currentBullSide and exhaustScore >= 3 ? "🧊 Buyer Fatigue" :
               fatigueSignal and currentBearSide and exhaustScore >= 3 ? "🧊 Seller Fatigue" :
               exhaustRisk ? "⚠ Late Trend" :
               trendExpansion ? "🚀 Trend Expansion" :
               healthyTrend ? "🟢 Healthy Trend" : "🟢 Trend OK"

exhaustPlaybook = not i_showExhaustion ? "Hidden" :
                  showBullConfirmed ? "Trend established — entries OK" :
                  showBearConfirmed ? "Trend established — entries OK" :
                  bullStillForming ? "Bear→bull shift, wait for confirmation" :
                  bearStillForming ? "Bull→bear shift, wait for confirmation" :
                  direction == 0 ? "Wait for setup" :
                  exhaustClimax ? "Manage only / avoid chase" :
                  fatigueSignal and exhaustScore >= 3 ? "Wait for pullback" :
                  exhaustRisk ? "Avoid fresh chase" :
                  trendExpansion ? "Hold runners" :
                  healthyTrend ? "Entries OK" : "Standard rules"

exhaustColor = not i_showExhaustion ? color.new(#888888, 0) :
               showBullConfirmed ? #00E676 :
               showBearConfirmed ? #00E676 :
               bullStillForming ? #00BFFF :
               bearStillForming ? #00BFFF :
               direction == 0 ? color.new(#8A92A6, 0) :
               exhaustClimax ? #FF1744 :
               fatigueSignal and exhaustScore >= 3 ? #FF6D00 :
               exhaustRisk ? #FFD700 :
               trendExpansion ? #00BFFF : color.new(#00E676, 0)

exhaustTxt = not i_showExhaustion ? "Hidden" : exhaustLabel + " — " + exhaustPlaybook

// ══════════════════════════════════════════
// v24.2 DRAW NEARBY MANUAL LEVELS / ZONES
// ══════════════════════════════════════════

var array<line> manualDrawnLines = array.new<line>()
var array<box> manualDrawnBoxes = array.new<box>()

if barstate.islast
    while array.size(manualDrawnLines) > 0
        line.delete(array.pop(manualDrawnLines))
    while array.size(manualDrawnBoxes) > 0
        box.delete(array.pop(manualDrawnBoxes))

    if i_useManualSR and i_manualDraw and array.size(manualZoneLows) > 0
        array<int> selectedManualIdx = array.new_int()
        array<float> selectedManualDist = array.new_float()

        for drawScanIdx = 0 to array.size(manualZoneLows) - 1
            float drawLo = array.get(manualZoneLows, drawScanIdx)
            float drawHi = array.get(manualZoneHighs, drawScanIdx)
            float drawDist = signalClose < drawLo ? drawLo - signalClose : signalClose > drawHi ? signalClose - drawHi : 0.0
            if drawDist <= i_manualDrawDistance
                int insertAt = 0
                while insertAt < array.size(selectedManualDist) and array.get(selectedManualDist, insertAt) <= drawDist
                    insertAt += 1
                array.insert(selectedManualDist, insertAt, drawDist)
                array.insert(selectedManualIdx, insertAt, drawScanIdx)
                if array.size(selectedManualIdx) > i_manualMaxVisible
                    array.pop(selectedManualIdx)
                    array.pop(selectedManualDist)

        int manualX1 = math.max(0, bar_index - i_manualDrawBars)
        int manualX2 = bar_index + 30
        if array.size(selectedManualIdx) > 0
            for drawRank = 0 to array.size(selectedManualIdx) - 1
                int zoneIdx = array.get(selectedManualIdx, drawRank)
                float zoneLo = array.get(manualZoneLows, zoneIdx)
                float zoneHi = array.get(manualZoneHighs, zoneIdx)
                bool exactLevel = math.abs(zoneHi - zoneLo) <= syminfo.mintick * 0.5
                if exactLevel
                    line ml = line.new(manualX1, zoneLo, manualX2, zoneLo, xloc=xloc.bar_index,
                         color=color.new(#FFD700, 0), width=2, style=line.style_solid)
                    array.push(manualDrawnLines, ml)
                else
                    box mb = box.new(manualX1, zoneHi, manualX2, zoneLo, xloc=xloc.bar_index,
                         border_color=color.new(#FFD700, 0), border_width=2,
                         bgcolor=color.new(#FFD700, 82))
                    array.push(manualDrawnBoxes, mb)

// ══════════════════════════════════════════
// v24.5.1 CURRENT RTH HIGH / LOW — DISPLAY ONLY
// ══════════════════════════════════════════

var line rthHighLine = na
var line rthLowLine = na
var label rthHighLabel = na
var label rthLowLabel = na

if barstate.islast
    if i_showRthHighLow and not na(currentRthStartBar) and not na(dayHigh) and not na(dayLow)
        int rthLineX2 = bar_index + 20
        if na(rthHighLine)
            rthHighLine := line.new(currentRthStartBar, dayHigh, rthLineX2, dayHigh, xloc=xloc.bar_index,
                 color=#FFFFFF, width=2, style=line.style_dashed)
        else
            line.set_xy1(rthHighLine, currentRthStartBar, dayHigh)
            line.set_xy2(rthHighLine, rthLineX2, dayHigh)
            line.set_color(rthHighLine, #FFFFFF)
            line.set_width(rthHighLine, 2)
            line.set_style(rthHighLine, line.style_dashed)
        if na(rthLowLine)
            rthLowLine := line.new(currentRthStartBar, dayLow, rthLineX2, dayLow, xloc=xloc.bar_index,
                 color=#8300FF, width=2, style=line.style_dashed)
        else
            line.set_xy1(rthLowLine, currentRthStartBar, dayLow)
            line.set_xy2(rthLowLine, rthLineX2, dayLow)
            line.set_color(rthLowLine, #8300FF)
            line.set_width(rthLowLine, 2)
            line.set_style(rthLowLine, line.style_dashed)

        if not na(rthHighLabel)
            label.delete(rthHighLabel)
        if not na(rthLowLabel)
            label.delete(rthLowLabel)
        int rthLabelX = int(math.round((currentRthStartBar + rthLineX2) * 0.5))
        float rthLabelOffset = not na(atr) ? math.max(atr * 0.08, syminfo.mintick * 8.0) : syminfo.mintick * 8.0
        rthHighLabel := label.new(rthLabelX, dayHigh + rthLabelOffset, "RTH High", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_none, color=color.new(#FFFFFF, 100), textcolor=#FFFFFF, size=size.small, textalign=text.align_center)
        rthLowLabel := label.new(rthLabelX, dayLow + rthLabelOffset, "RTH Low", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_none, color=color.new(#8300FF, 100), textcolor=#8300FF, size=size.small, textalign=text.align_center)
    else
        if not na(rthHighLine)
            line.delete(rthHighLine)
            rthHighLine := na
        if not na(rthLowLine)
            line.delete(rthLowLine)
            rthLowLine := na
        if not na(rthHighLabel)
            label.delete(rthHighLabel)
            rthHighLabel := na
        if not na(rthLowLabel)
            label.delete(rthLowLabel)
            rthLowLabel := na

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════

plot(i_showEMAs ? fastEMA  : na, title="Fast EMA (9)",   color=color.new(#00E676, 0), linewidth=2)
plot(i_showEMAs ? slowEMA  : na, title="Slow EMA (21)",  color=color.new(#FF1744, 0), linewidth=2)
plot(i_showEMAs ? trendEMA : na, title="Trend EMA (50)", color=color.new(#FFD700, 0), linewidth=2)

plot(i_showVWAP  ? vwap      : na, title="Selected VWAP",      color=color.new(#0D47A1, 0),  linewidth=2)
plot(i_vwapBands ? vwapUpper : na, title="Selected VWAP +1SD", color=color.new(#0D47A1, 55), linewidth=1)
plot(i_vwapBands ? vwapLower : na, title="Selected VWAP -1SD", color=color.new(#0D47A1, 55), linewidth=1)
plot(i_showVWAP and i_compareVwaps ? alternateVwap : na, title="Comparison VWAP (not scored)", color=color.new(#FF9800, 10), linewidth=1)

plotshape(i_showSR and not na(swingH), title="Resistance", location=location.abovebar,
     style=shape.triangledown, size=size.tiny, color=color.new(#FF4444, 10))
plotshape(i_showSR and not na(swingL), title="Support", location=location.belowbar,
     style=shape.triangleup, size=size.tiny, color=color.new(#44FF88, 10))

plotshape(bearishDivergence, title="Bearish Divergence", location=location.abovebar,
     style=shape.labeldown, size=size.tiny, color=color.new(#FF1744, 0), text="÷", textcolor=color.white)
plotshape(bullishDivergence, title="Bullish Divergence", location=location.belowbar,
     style=shape.labelup, size=size.tiny, color=color.new(#00E676, 0), text="÷", textcolor=color.white)

// ══════════════════════════════════════════
// S/R LINES
// ══════════════════════════════════════════

var array<line> resLines = array.new<line>()
var array<line> supLines = array.new<line>()

if i_showSR and not na(swingH)
    if array.size(resLines) >= i_keepSR
        line.delete(array.shift(resLines))
    array.push(resLines, line.new(bar_index, swingH, bar_index, swingH,
         color=color.new(#FF4444, 55), style=line.style_dashed, width=1))

if i_showSR and not na(swingL)
    if array.size(supLines) >= i_keepSR
        line.delete(array.shift(supLines))
    array.push(supLines, line.new(bar_index, swingL, bar_index, swingL,
         color=color.new(#44FF88, 55), style=line.style_dashed, width=1))

if barstate.islast and i_showSR
    if array.size(resLines) > 0
        for i = 0 to array.size(resLines) - 1
            line.set_x2(array.get(resLines, i), bar_index)
    if array.size(supLines) > 0
        for i = 0 to array.size(supLines) - 1
            line.set_x2(array.get(supLines, i), bar_index)

// ══════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════

formatVold(float v) =>
    string sign = v > 0 ? "+" : ""
    na(v) ? "── (no data)" :
         math.abs(v) >= 1000000000 ? sign + str.tostring(v / 1000000000.0, "#.#") + "B" :
         math.abs(v) >= 1000000    ? sign + str.tostring(v / 1000000.0, "#") + "M" :
                                     sign + str.tostring(math.round(v))

formatSigned(float v) =>
    string sign = v > 0 ? "+" : ""
    na(v) ? "──" : sign + str.tostring(math.round(v, 0))

formatSignedCompact(float v) =>
    string sign = v > 0 ? "+" : ""
    na(v) ? "──" :
         math.abs(v) >= 1000000 ? sign + str.tostring(v / 1000000.0, "#.#") + "M" :
         math.abs(v) >= 1000    ? sign + str.tostring(v / 1000.0, "#.#") + "K" :
                                  sign + str.tostring(math.round(v, 0))

f_volFmt(float v) =>
    na(v) ? "──" :
         math.abs(v) >= 1000000 ? str.tostring(v / 1000000.0, "#.#") + "M" :
         math.abs(v) >= 1000    ? str.tostring(v / 1000.0, "#.#") + "K" :
                                  str.tostring(math.round(v, 0))

formatVixVal(float v) =>
    na(v) ? "──" : str.tostring(v, "#.##")

rangeTxt(float hi, float lo, bool compact, bool isVold, bool isVix) =>
    not i_showInternalMemory ? "" : compact ? isVix ? " [H " + formatVixVal(hi) + " L " + formatVixVal(lo) + "]" :       isVold ? " [H " + formatVold(hi) + " L " + formatVold(lo) + "]" :       " [H " + formatSignedCompact(hi) + " L " + formatSignedCompact(lo) + "]" :
     isVix ? " [Hi " + formatVixVal(hi) + " / Lo " + formatVixVal(lo) + "]" :
     isVold ? " [Hi " + formatVold(hi) + " / Lo " + formatVold(lo) + "]" :
     " [Hi " + formatSigned(hi) + " / Lo " + formatSigned(lo) + "]"

velocityTxt(float v, bool compact, bool isVold, bool isVix) =>
    not i_showInternalVelocity ? "" : compact ? isVix ? " Δ" + formatVixVal(v) : isVold ? " Δ" + formatVold(v) :        " Δ" + formatSignedCompact(v) :
     isVix ? " | " + str.tostring(i_internalVelocityMin) + "m Δ" + formatVixVal(v) :
     isVold ? " | " + str.tostring(i_internalVelocityMin) + "m Δ" + formatVold(v) :
     " | " + str.tostring(i_internalVelocityMin) + "m Δ" + formatSigned(v)

dirArrow(float delta, float minMove) =>
    na(delta) ? "" :
     delta >  minMove ? "↑" :
     delta < -minMove ? "↓" : "→"

dashPosition = i_dashPos == "top_right"    ? position.top_right :
               i_dashPos == "top_left"     ? position.top_left  :
               i_dashPos == "middle_right" ? position.middle_right :
               i_dashPos == "middle_left"  ? position.middle_left  :
               i_dashPos == "bottom_right" ? position.bottom_right :
                                             position.bottom_left

// ══════════════════════════════════════════
// DASHBOARD — v24 FIXED-TIMEFRAME PRO LAYOUT
// ══════════════════════════════════════════

scoreMeter(int score, int maxVal) =>
    pct = maxVal > 0 ? score / maxVal : 0.0
    pct >= 0.875 ? "████" : pct >= 0.750 ? "███░" : pct >= 0.500 ? "██░░" : pct >= 0.250 ? "█░░░" : "░░░░"

dashRow(table t, int r, string label, string valueText, string signalText, color valueColor, color bg, int txtSize) =>
    table.cell(t, 0, r, label, text_color=color.new(#8A92A6, 0), text_size=txtSize, bgcolor=bg, text_halign=text.align_left)
    table.cell(t, 1, r, valueText, text_color=valueColor, text_size=txtSize, bgcolor=bg, text_halign=text.align_left)
    table.cell(t, 2, r, signalText, text_color=valueColor, text_size=txtSize, bgcolor=bg, text_halign=text.align_center)

if i_showDash and barstate.islast
    var table dash = table.new(dashPosition, 3, 19,
         bgcolor=color.new(#060811, 0), border_color=color.new(#24304A, 0), border_width=1,
         frame_color=color.new(#415A99, 0), frame_width=2)

    baseBG = color.new(#060811, 0)
    headerBG = color.new(#101A33, 0)
    verdictBull = color.new(#00E676, 82)
    verdictBear = color.new(#FF1744, 82)
    verdictWarn = color.new(#FFD700, 84)
    verdictWait = color.new(#252A36, 20)
    mutedTxt = color.new(#8A92A6, 0)
    dimTxt = color.new(#5D6578, 0)
    rowBG = color.new(#0B1020, 0)
    rowAltBG = color.new(#0F172A, 0)
    dashTextSize = i_dashTextSize

    activeScore = direction == 1 ? bullScore : direction == -1 ? bearScore : topScore
    meterTxt = scoreMeter(activeScore, maxScore)
    verdictTxt = goCloseHistoricalUnsupported ? "⚠ USE 5m FOR CLOSE REPLAY" :
         inNYSE and not scoreDataReady ? "⏳ BUILDING DATA" :
         blockedLong ? "⛔ LONG BLOCKED" : blockedShort ? "⛔ SHORT BLOCKED" :
         goExtendedLong or goExtendedShort ? "🟡 GO EXTENDED" :
         continuationLong ? "🟡 CONTINUATION LONG" : continuationShort ? "🟡 CONTINUATION SHORT" :
         goLong ? "🟢 GO LONG" : goShort ? "🔴 GO SHORT" :
         goPendingLong ? "⏳ LONG PENDING 5m CLOSE" : goPendingShort ? "⏳ SHORT PENDING 5m CLOSE" :
         cautionLong ? "🟡 CAUTION LONG" : cautionShort ? "🟡 CAUTION SHORT" : "⚪ WAIT"
    verdictColor = goCloseHistoricalUnsupported ? #FFD700 : inNYSE and not scoreDataReady ? #FFD700 : blockedLong or blockedShort ? #FF6D00 : goExtended or continuationTrade ? #FFD700 : goLong ? #00E676 : goShort ? #FF1744 :
         goPending or cautionLong or cautionShort ? #FFD700 : color.new(#C7CAD1, 0)
    verdictBG = goCloseHistoricalUnsupported ? verdictWarn : inNYSE and not scoreDataReady ? verdictWarn : blockedLong or blockedShort ? color.new(#FF6D00, 82) : goExtended or continuationTrade ? verdictWarn : goLong ? verdictBull : goShort ? verdictBear :
         goPending or cautionLong or cautionShort ? verdictWarn : verdictWait
    dirGlyph = direction == 1 ? "▲" : direction == -1 ? "▼" : "•"
    scoreTxt = str.tostring(activeScore) + "/" + str.tostring(maxScore) + "  " + meterTxt + "  " + dirGlyph + "  M" + str.tostring(scoreMargin)
    penaltyTxt = scorePenaltyReason != "" and (cautionLong or cautionShort or rawGoLong or rawGoShort) ? " · " + scorePenaltyReason : ""

    table.cell(dash, 0, 0, i_compactDash ? "🚀 MNQ" : "🚀 MNQ MISSION CONTROL", text_color=#FFD700, text_size=dashTextSize, bgcolor=headerBG, text_halign=text.align_center)
    table.cell(dash, 1, 0, i_compactDash ? "v24.5.7.3" : "v24.5.7.3 FIXED 5/15/30", text_color=color.new(#8AA4FF, 0), text_size=dashTextSize, bgcolor=headerBG, text_halign=text.align_center)
    table.cell(dash, 2, 0, "SIG", text_color=color.new(#8AA4FF, 0), text_size=dashTextSize, bgcolor=headerBG, text_halign=text.align_center)
    table.merge_cells(dash, 0, 1, 2, 1)
    table.cell(dash, 0, 1, verdictTxt + "   " + scoreTxt + penaltyTxt, text_color=verdictColor, text_size=size.normal, bgcolor=verdictBG, text_halign=text.align_center)

    rrTxt = na(riskReward) ? "R:?" : str.tostring(riskReward, "#.##") + "R"
    riskColor = direction == 0 ? dimTxt : blockedLong or blockedShort ? #FF6D00 : na(riskReward) ? #FFD700 : riskReward >= 1.50 ? #00E676 : riskReward >= i_blockMinRR ? #FFD700 : #FF6D00
    riskStateTxt = direction == 0 ? "NO ACTIVE TRADE" :
         blockedLong or blockedShort ?
              stopTooWide ? "STOP TOO WIDE" :
              scalpRoomBlocked ? "NO SCALP ROOM" :
              rrBlocked ? "POOR R:R" :
              climaxState ? "CLIMAX — NO CHASE" :
              direction == 1 and longExhaustionBlock ? "EXHAUSTION AT LEVEL" :
              direction == -1 and shortExhaustionBlock ? "EXHAUSTION AT LEVEL" :
              direction == 1 and bearDivergenceHard ? "BEAR DIVERGENCE" :
              direction == -1 and bullDivergenceHard ? "BULL DIVERGENCE" : "ENTRY BLOCKED" :
         direction == 1 and bearDivergenceWarning ? "CONTINUATION · DIV WARN" :
         direction == -1 and bullDivergenceWarning ? "CONTINUATION · DIV WARN" :
         continuationRoomActive ? "CONTINUATION ROOM" :
         na(riskReward) ? "RISK BUILDING" :
         not i_useScalpRiskMode ? riskReward >= 1.50 ? "GOOD RISK" : "RISK OK" :
         not na(roomDist) and roomDist < 60.0 ? "SCALP ROOM OK" : "ROOM OPEN"
    engageTag = i_engagementOnRisk and not (blockedLong or blockedShort) and engagementState != "" ? engagementState : ""
    riskStatusTxt = riskStateTxt + (direction != 0 and not na(riskReward) ? " · " + rrTxt : "") + (engageTag != "" ? " · " + engageTag : "")
    stopDistShort = direction == 0 or na(stopDistance) ? "?p" : str.tostring(math.round(stopDistance, 1)) + "p"
    stopPxShort = direction == 0 or na(suggestedStop) ? "──" : str.tostring(math.round(suggestedStop, 2))
    targetDistShort = direction == 0 or na(distToTarget) ? "?p" : str.tostring(math.round(distToTarget, 1)) + "p"
    targetPxShort = direction == 0 or na(targetPrice) ? "──" : str.tostring(math.round(targetPrice, 2))
    riskStopSourceShort = str.contains(stopSource, "Manual S/R") ? (str.contains(stopSource, "Noise floor") ? "Noise/M-SR" : "Manual S/R") :
         str.contains(stopSource, "EMA21") ? (str.contains(stopSource, "Noise floor") ? "Noise/EMA21" : "EMA21") :
         str.contains(stopSource, "VWAP") ? (str.contains(stopSource, "Noise floor") ? "Noise/VWAP" : "VWAP") :
         str.contains(stopSource, "Swing") ? (str.contains(stopSource, "Noise floor") ? "Noise/Swing" : "Swing") :
         str.contains(stopSource, "ATR") ? "ATR" : stopSource
    riskTargetSourceShort = targetBaseSource == "Manual S/R" ? "Manual S/R" : targetBaseSource
    checkpointShort = checkpointSource == "RTH High" ? "HOD" : checkpointSource == "RTH Low" ? "LOD" : checkpointSource
    checkpointTag = continuationRoomActive and checkpointShort != "None" and not na(checkpointDist) ? " · via " + checkpointShort + " " + str.tostring(math.round(checkpointDist, 1)) + "p" : ""
    riskSourceRoute = direction == 0 ? "" : (riskStopSourceShort != "None" ? riskStopSourceShort : "Stop ?") + " → " + (riskTargetSourceShort != "None" ? riskTargetSourceShort : "Target ?") + checkpointTag
    riskNumbersTxt = "S " + stopDistShort + " @" + stopPxShort + " | T " + targetDistShort + " @" + targetPxShort
    riskCompactTxt = riskStatusTxt + " | S " + stopDistShort + " → T " + targetDistShort
    riskTxt = not i_showRisk ? "Hidden" : direction == 0 ? riskStateTxt : i_stackLongRows ? riskStatusTxt + "\n" + riskNumbersTxt + (riskSourceRoute != "" ? "\n" + riskSourceRoute : "") : riskCompactTxt
    riskSig = direction == 0 or not i_showRisk ? "" : blockedLong or blockedShort ? "⛔" : na(riskReward) ? "?" : riskReward >= i_blockMinRR ? "✅" : "❌"
    dashRow(dash, 2, "🎯 Risk", riskTxt, riskSig, riskColor, rowBG, dashTextSize)

    t5 = bullTrend5 ? "5▲" : bearTrend5 ? "5▼" : "5•"
    t15 = htfBull ? "15▲" : htfBear ? "15▼" : "15•"
    t30 = regimeBull ? "30▲" : regimeBear ? "30▼" : "30•"
    trendTxt = t5 + "  " + t15 + (i_showRegime30 ? "  " + t30 : "")
    trendColor = bullTrend5 and htfBull ? #00E676 : bearTrend5 and htfBear ? #FF1744 : #FF6D00
    trendSig = direction == 0 ? "➖" : direction == 1 and bullTrend5 and htfBull ? "✅" : direction == -1 and bearTrend5 and htfBear ? "✅" : "❌"
    dashRow(dash, 3, "🧭 Trend 5/15/30", trendTxt, trendSig, trendColor, rowAltBG, dashTextSize)

    vwapDistPts = not na(vwapDist) ? math.round(math.abs(vwapDist), 1) : na
    bandTxt = ridingUpperBand ? "🚀 Riding Upper" : ridingLowerBand ? "🚀 Riding Lower" : nearUpper ? "⚠ Upper Band" : nearLower ? "⚠ Lower Band" : "Mid-band"
    vwapBaseTxt = na(vwapDistPts) ? vwapModeShort + " VWAP building" : (aboveVWAP ? "+" : "-") + str.tostring(vwapDistPts) + "p | " + bandTxt
    vwapGapTxt = na(vwapComparisonGap) ? "VWAP comparison building" : "TV-RTH " + (vwapComparisonGap > 0 ? "+" : "") + str.tostring(vwapComparisonGap, "#.##") + "p | alt " + alternateVwapModeShort
    vwapCombo = i_compareVwaps ? (i_stackLongRows ? vwapBaseTxt + "\n" + vwapGapTxt : vwapBaseTxt + " | " + vwapGapTxt) : vwapBaseTxt
    vwapColor2 = ridingUpperBand ? #00E676 : ridingLowerBand ? #FF1744 : nearUpper or nearLower ? #FF6D00 : aboveVWAP ? #00E676 : #FF1744
    vwapSig = direction == 0 ? "➖" : direction == 1 and aboveVWAP or direction == -1 and belowVWAP ? "✅" : "❌"
    dashRow(dash, 4, "⚓ " + vwapModeShort + " VWAP", vwapCombo, vwapSig, vwapColor2, rowBG, dashTextSize)

    resTxt = not na(distToRes) ? str.tostring(math.round(distToRes, 0)) + "↑" : "──"
    supTxt = not na(distToSup) ? str.tostring(math.round(distToSup, 0)) + "↓" : "──"
    manualResTxt = not na(manualResDist) ? str.tostring(math.round(manualResDist, 0)) + "↑" : "──"
    manualSupTxt = not na(manualSupDist) ? str.tostring(math.round(manualSupDist, 0)) + "↓" : "──"
    autoLevelTxt = "Auto R " + resTxt + " / S " + supTxt
    manualBankCountTxt = " [" + str.tostring(manualParsedCount) + "→" + str.tostring(array.size(manualZoneLows)) + "]"
    manualLevelTxt = not i_useManualSR ? "Manual hidden" : manualInsideZone ?
         "Manual IN " + str.tostring(manualInsideLow, "#.##") + "-" + str.tostring(manualInsideHigh, "#.##") + manualBankCountTxt :
         "Manual R " + manualResTxt + " / S " + manualSupTxt + manualBankCountTxt
    levelsCombo = i_stackLongRows ? autoLevelTxt + "\n" + manualLevelTxt : autoLevelTxt + " | " + manualLevelTxt
    levelsColor = manualInsideZone ? #FFD700 : nearResistance or nearSupport or nearManualResistance or nearManualSupport ? #FF6D00 : mutedTxt
    levelsSig = direction == 1 and (nearResistance or nearManualResistance) or direction == -1 and (nearSupport or nearManualSupport) ? "⚠" : ""
    dashRow(dash, 5, "🏛 Auto / Manual S/R", levelsCombo, levelsSig, levelsColor, rowAltBG, dashTextSize)

    rsiOK = direction == 1 and bullRsiPoint or direction == -1 and bearRsiPoint
    rsiColor = rsi > 72 ? #FF1744 : rsi < 28 ? #FF6D00 : rsi >= 52 ? #00E676 : rsi <= 48 ? #FF1744 : mutedTxt
    momTxt = bullMomentum ? "Mom ↑" : bearMomentum ? "Mom ↓" : "Mom →"
    sessTxt = inMorning ? "Morning" : inPowerHour ? "Power Hr" : inAfternoon ? "Afternoon" : inLunch ? "Lunch" : "Off-hours"
    marketTxt = "RSI " + str.tostring(math.round(rsi, 0)) + " | ATR5 " + str.tostring(math.round(atr, 0)) + (i_stackLongRows ? "\n" : " | ") + momTxt + " | " + sessTxt
    marketSig = direction == 0 ? "➖" : rsiOK ? "✅" : "❌"
    dashRow(dash, 6, "📊 Market", marketTxt, marketSig, rsiColor, rowBG, dashTextSize)

    // v24.5 display-only internals translation. The support/opposition booleans
    // below are the existing v24.4 scoring outputs; this section only explains
    // those conditions in plain English and retains the raw values underneath.
    addBiasTxt = na(addValue) ? "NO DATA" : addValue >= i_adModerateTh ? "BULLISH" : addValue <= -i_adModerateTh ? "BEARISH" : addValue > 0 ? "LEAN BULLISH" : addValue < 0 ? "LEAN BEARISH" : "BALANCED"
    addStateTxt = na(addValue) or na(addVelocity) ? "" : adRisingHard ? (addValue < 0 ? "IMPROVING" : "STRENGTHENING") : adFallingHard ? (addValue > 0 ? "FADING" : "WORSENING") : "STEADY"
    addHeadline = not inNYSE ? "OFF-HOURS" : na(addValue) ? "NO DATA" : addBiasTxt + (addStateTxt != "" ? " · " + addStateTxt : "")
    addRawTxt = na(addValue) ? "A/D ── | " + str.tostring(i_internalVelocityMin) + "m ──" : "A/D " + formatSigned(addValue) + " " + dirArrow(addDelta, i_addDirMin) + " | " + str.tostring(i_internalVelocityMin) + "m " + formatSigned(addVelocity)
    addTxt = i_stackLongRows ? addHeadline + "\n" + addRawTxt : addHeadline + " | " + addRawTxt
    addColor = not inNYSE ? dimTxt : na(addValue) ? mutedTxt : addValue >= i_adModerateTh ? #00E676 : addValue <= -i_adModerateTh ? #FF1744 : #FFD700
    addSig = not inNYSE or na(addValue) or direction == 0 ? "➖" : direction == 1 ? bullAdSupport ? "✅" : bullAdOppose ? "❌" : "➖" : bearAdSupport ? "✅" : bearAdOppose ? "❌" : "➖"
    dashRow(dash, 7, "🌐 Breadth (A/D)", addTxt, addSig, addColor, rowAltBG, dashTextSize)

    tickDataReady = not na(tickValue) and not na(tickSmooth) and not na(cumTick)
    tickBiasTxt = not tickDataReady ? "NO DATA" : bullTickSupport ? "BUY PRESSURE" : bearTickSupport ? "SELL PRESSURE" : "MIXED"
    tickStateTxt = not tickDataReady ? "" : bullTickSupport ? (cumTick < 0 ? "RECOVERING" : "PERSISTENT") : bearTickSupport ? (cumTick > 0 ? "ROLLING OVER" : "PERSISTENT") : not na(cumVelocity15) and not na(cumVelocity) and cumVelocity15 > 0 and cumVelocity > 0 ? "BUYERS IMPROVING" : not na(cumVelocity15) and not na(cumVelocity) and cumVelocity15 < 0 and cumVelocity < 0 ? "SELLERS GAINING" : tickSmooth > 0 ? "BUYERS TRYING" : tickSmooth < 0 ? "SELLERS TRYING" : "CONFLICTED"
    tickHeadline = not inNYSE ? "OFF-HOURS" : not tickDataReady ? "NO DATA" : tickBiasTxt + (tickStateTxt != "" ? " · " + tickStateTxt : "")
    tickBase = not tickDataReady ? "T ── | S" + str.tostring(i_tickSmoothLen) + " ──" : "T " + formatSigned(tickValue) + " | S" + str.tostring(i_tickSmoothLen) + " " + formatSigned(tickSmooth)
    tickDetail = not tickDataReady ? "Cum ── | 15m ── / 30m ──" : "Cum " + formatSignedCompact(cumTick) + " | 15m " + formatSignedCompact(cumVelocity15) + " / 30m " + formatSignedCompact(cumVelocity)
    tickRowTxt = i_stackLongRows ? tickHeadline + "\n" + tickBase + "\n" + tickDetail : tickHeadline + " | " + tickBase + " | " + tickDetail
    tickColor = not inNYSE ? dimTxt : not tickDataReady ? mutedTxt : bullTickSupport ? #00E676 : bearTickSupport ? #FF1744 : #FFD700
    tickSig = not inNYSE or na(tickSmooth) or direction == 0 ? "➖" : direction == 1 ? bullTickSupport ? "✅" : bullTickOppose ? "❌" : "➖" : bearTickSupport ? "✅" : bearTickOppose ? "❌" : "➖"
    dashRow(dash, 8, "⚡ Pressure (TICK)", tickRowTxt, tickSig, tickColor, rowBG, dashTextSize)

    voldBiasTxt = na(voldPct) ? "NO DATA" : voldPct >= i_voldPctMin ? "BULLISH" : voldPct <= -i_voldPctMin ? "BEARISH" : "BALANCED"
    voldStateTxt = na(voldPctVelocity) ? "" : voldRisingHard ? (voldPct < -i_voldPctMin ? "IMPROVING" : voldPct >= i_voldPctMin ? "STRENGTHENING" : "TILTING BULLISH") : voldFallingHard ? (voldPct > i_voldPctMin ? "FADING" : voldPct <= -i_voldPctMin ? "WORSENING" : "TILTING BEARISH") : voldPctVelocity > 0 ? "LEANING BULLISH" : voldPctVelocity < 0 ? "LEANING BEARISH" : "STEADY"
    voldHeadline = not inNYSE ? "OFF-HOURS" : na(voldPct) ? "NO DATA" : voldBiasTxt + (voldStateTxt != "" ? " · " + voldStateTxt : "")
    voldBaseTxt = na(voldPct) ? "VOLD ──" : "VOLD " + (voldPct > 0 ? "+" : "") + str.tostring(voldPct, "#.#") + "% | " + formatVold(voldValue)
    voldDetail = na(voldPctVelocity) ? str.tostring(i_internalVelocityMin) + "m ──" : str.tostring(i_internalVelocityMin) + "m " + (voldPctVelocity > 0 ? "+" : "") + str.tostring(voldPctVelocity, "#.#") + "%"
    voldTxt = i_stackLongRows ? voldHeadline + "\n" + voldBaseTxt + " | " + voldDetail : voldHeadline + " | " + voldBaseTxt + " | " + voldDetail
    voldColor = not inNYSE ? dimTxt : na(voldPct) ? mutedTxt : voldPct >= i_voldPctMin ? #00E676 : voldPct <= -i_voldPctMin ? #FF1744 : #FFD700
    voldSig = not inNYSE or na(voldPct) or direction == 0 ? "➖" : direction == 1 ? bullVoldSupport ? "✅" : bullVoldOppose ? "❌" : "➖" : bearVoldSupport ? "✅" : bearVoldOppose ? "❌" : "➖"
    dashRow(dash, 9, "🌊 Flow (VOLD%)", voldTxt, voldSig, voldColor, rowAltBG, dashTextSize)

    vixDir = not inNYSE ? "" : " " + dirArrow(vixDeltaPct, i_vixDirMin)
    vixSpike = not na(vixDeltaPct) and math.abs(vixDeltaPct) >= i_vixSpikeMin
    vixColor = not inNYSE or na(vixDeltaPct) ? mutedTxt : vixDeltaPct <= -i_vixSupportMin ? #00E676 : vixDeltaPct >= i_vixSupportMin ? #FF1744 : mutedTxt
    divShort = bearishDivergence ? "Bear Div" : bullishDivergence ? "Bull Div" : "Div OK"
    vixBaseTxt = na(vixValue) ? "──" : "VIX " + str.tostring(vixValue, "#.##") + " | 5m " + (vixDeltaPct > 0 ? "+" : "") + str.tostring(vixDeltaPct, "#.##") + "%" + vixDir + (vixSpike ? " ⚠" : "")
    vixDivTxt = i_stackLongRows ? vixBaseTxt + "\n" + divShort : vixBaseTxt + " | " + divShort
    vixSig = not inNYSE or na(vixDeltaPct) or direction == 0 ? "➖" : direction == 1 ? vixConflictLong ? "❌" : bullVixConfirm ? "✅" : "➖" : vixConflictShort ? "❌" : bearVixConfirm ? "✅" : "➖"
    dashRow(dash, 10, "🧨 VIX/Div", vixDivTxt, vixSig, bearishDivergence ? #FF1744 : bullishDivergence ? #00E676 : vixColor, rowBG, dashTextSize)

    volHistorySessions = useOneMinPacing ? rvol1mSessions : rvolTodSessions
    volHistoryGoal = useOneMinPacing ? RVOL_1M_DAYS : RVOL_TOD_DAYS
    volHistoryBuilding = volHistorySessions < volHistoryGoal
    volState = na(volRatio) ?
         volHistoryBuilding ? "BUILDING HISTORY" :
         useOneMinPacing and oneMinCompletedCount == 0 ? "WAITING FOR 1m CLOSE" : "BUILDING PACE" :
         volHot ? "HOT" : volDead ? "DEAD" : "NORMAL"
    volColor = na(volRatio) ? mutedTxt : volHot ? #00E676 : volDead ? dimTxt : mutedTxt
    volSig = na(volRatio) ? "⏳" : volHot ? "🔥" : volDead ? "💤" : "➖"
    volHeadline = na(volRatio) ? volState : "PACE " + str.tostring(volRatio, "#.#") + "x · " + volState
    volProgressTxt = useOneMinPacing ? str.tostring(oneMinComparedCount) + "/5 min complete" : "Chart-bar mode"
    volHistoryBuildTxt = volHistoryBuilding ? " · History " + str.tostring(volHistorySessions) + "/" + str.tostring(volHistoryGoal) : ""
    volDetailTxt = volProgressTxt + volHistoryBuildTxt
    volTxt = i_stackLongRows ? volHeadline + "\n" + volDetailTxt : volHeadline + " | " + volDetailTxt
    dashRow(dash, 11, "📊 Volume Pace", volTxt, volSig, volColor, rowAltBG, dashTextSize)

    relLabel = na(relStrength) ? "──" : nqLeading ? "NQ leading" : nqLagging ? "NQ lagging" : nqLeadingLevel or nqLaggingLevel ? "Mixed" : "In line"
    relVal = na(relStrength) ? "" : " " + (relStrength > 0 ? "+" : "") + str.tostring(relStrength, "#.##") + "%"
    relVelTxt = na(relVelocity) ? "" : " | " + str.tostring(i_internalVelocityMin) + "m Δ" + (relVelocity > 0 ? "+" : "") + str.tostring(relVelocity, "#.##") + "%"
    relDetail = na(nqPctChg) or na(esPctChg) ? "" : "NQ " + (nqPctChg > 0 ? "+" : "") + str.tostring(nqPctChg, "#.##") + "% | ES " + (esPctChg > 0 ? "+" : "") + str.tostring(esPctChg, "#.##") + "%"
    relFull = i_stackLongRows and relDetail != "" ? relLabel + relVal + relVelTxt + "\n" + relDetail : relLabel + relVal + relVelTxt + (relDetail == "" ? "" : " | " + relDetail)
    relSig = na(relStrength) or not inNYSE or direction == 0 ? "➖" : direction == 1 and nqLeading or direction == -1 and nqLagging ? "✅" : direction == 1 and nqLagging or direction == -1 and nqLeading ? "❌" : "➖"
    relColor = not inNYSE or na(relStrength) ? mutedTxt : nqLeading ? #00E676 : nqLagging ? #FF1744 : mutedTxt
    dashRow(dash, 12, "🧮 NQ vs ES", i_showIntermarket ? relFull : "Hidden", i_showIntermarket ? relSig : "", relColor, rowBG, dashTextSize)

    dashRow(dash, 13, "🧠 Quality", i_compactDash ? exhaustLabel : exhaustTxt, "", exhaustColor, rowAltBG, dashTextSize)
    dashRow(dash, 14, "📅 Day Type", i_showDayType ? dayType : "Hidden", "", i_showDayType ? dayTypeColor : dimTxt, rowBG, dashTextSize)
    playbookBaseTxt = goCloseHistoricalUnsupported ? "Close-confirmed Replay requires the 5m chart" :
         goExtended ? "GO EXTENDED: wait pullback" + (extendedReason != "" ? " · " + extendedReason : "") :
         goPending ? "GO pending: wait for completed 5m close" :
         (cautionLong or cautionShort) and scorePenaltyReason != "" ? "CAUTION: " + scorePenaltyReason : dayTypeMode
    dashRow(dash, 15, "🎮 Playbook", i_compactDash ? str.replace_all(playbookBaseTxt, ", ", "/") : playbookBaseTxt, "", goCloseHistoricalUnsupported or goExtended or goPending or scorePenaltyReason != "" ? #FFD700 : dayTypeColor, rowAltBG, dashTextSize)

    // v24.5.5 display-only row compaction. Optional rows are omitted rather
    // than left behind as "Details hidden" or "Off" placeholders.
    table.clear(dash, 0, 16, 2, 18)
    int detailRow = 16

    if i_showDayTypeDetails
        ibInfoTxt = na(ibRange) ? "──" : not ibLocked ? "Building " + str.tostring(math.round(ibRange, 0)) + "p (" + str.tostring(math.round(nz(ibPctATR), 0)) + "% RTHavg)" :
             str.tostring(math.round(ibRange, 0)) + "p (" + str.tostring(math.round(nz(ibPctATR), 0)) + "% RTHavg)" +
             (not na(rangeExtMult) ? (i_stackLongRows ? "\n" : " | ") + "Ext " + str.tostring(rangeExtMult, "#.#") + "x" : "") +
             (not na(dayRangePctATR) ? (i_stackLongRows ? "\n" : " | ") + "Day " + str.tostring(math.round(dayRangePctATR, 0)) + "% RTHavg" : "") +
             (i_stackLongRows ? "\n" : " | ") + "RTH hist " + str.tostring(rthRangeSessions) + "/" + str.tostring(i_dailyATRLen) + (liveTrendOverride ? " ⚡LIVE" : "")
        ibRowBG = detailRow % 2 == 0 ? rowBG : rowAltBG
        dashRow(dash, detailRow, "📏 IB/Ext", ibInfoTxt, "", mutedTxt, ibRowBG, dashTextSize)
        detailRow += 1

    vpWinTag = i_vpWindow == "RTH reset" ? "RTH" : i_vpWindow == "Prior day RTH" ? "PD" : "Roll"
    vpHasData = i_showVolProfile and not na(vpPOC)
    vpZone = not vpHasData ? "──" : not na(vpVAH) and signalClose > vpVAH ? "Above VA" : not na(vpVAL) and signalClose < vpVAL ? "Below VA" : "In VA"
    vpPocDist = vpHasData ? math.round(signalClose - vpPOC, 1) : na
    vpBase = not vpHasData ? "Hidden / building" : "POC " + str.tostring(math.round(vpPOC, 2)) + " (" + (vpPocDist > 0 ? "+" : "") + str.tostring(vpPocDist) + "p) · " + vpZone + " [" + vpWinTag + "]"
    vpLine2 = vpHasData and not na(vpVAH) and not na(vpVAL) ? "VAH " + str.tostring(math.round(vpVAH, 1)) + " / VAL " + str.tostring(math.round(vpVAL, 1)) : ""
    vpTxt = i_stackLongRows and vpLine2 != "" ? vpBase + "\n" + vpLine2 : vpBase + (vpLine2 != "" ? " | " + vpLine2 : "")
    vpSig = not vpHasData or direction == 0 ? "➖" : direction == 1 and signalClose > vpPOC or direction == -1 and signalClose < vpPOC ? "✅" : "❌"
    vpColor = not vpHasData ? dimTxt : vpZone == "Above VA" ? #00E676 : vpZone == "Below VA" ? #FF1744 : mutedTxt
    vpRowBG = detailRow % 2 == 0 ? rowBG : rowAltBG
    dashRow(dash, detailRow, "📐 Vol Profile", vpTxt, vpSig, vpColor, vpRowBG, dashTextSize)
    detailRow += 1

    if i_diagMode
        diagDecided = diagWins + diagLosses
        diagTotal = diagDecided + diagTimeouts
        diagWinRate = diagDecided > 0 ? diagWins * 100.0 / diagDecided : na
        diagState = diagDir == 1 ? "Tracking LONG" : diagDir == -1 ? "Tracking SHORT" : "Idle"
        diagTxt = not diagIs5m ? "Open indicator on 5m to collect" :
             diagState + " | RTH-flat | W " + str.tostring(diagWins) + " L " + str.tostring(diagLosses) + " T " + str.tostring(diagTimeouts) + " A " + str.tostring(diagAmbiguous) +
             (not na(diagWinRate) ? " | " + str.tostring(diagWinRate, "#.#") + "%" : "")
        diagSig = diagDir != 0 ? "⏱" : diagTotal > 0 ? "📈" : "⏳"
        diagRowBG = detailRow % 2 == 0 ? rowBG : rowAltBG
        dashRow(dash, detailRow, "🧪 GO Study", diagTxt, diagSig, mutedTxt, diagRowBG, dashTextSize)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════

alertcondition(scoreWatch8,  "MNQ 🔔 Score 8+ Watch",  "MNQ Mission Control: The active directional score reached 8 or higher. Attention alert only—check verdict, BLOCKED, GO EXTENDED, risk, and room before acting.")
alertcondition(scoreWatch9,  "MNQ 🔔 Score 9+ Watch",  "MNQ Mission Control: The active directional score reached 9 or higher. Attention alert only—check verdict, BLOCKED, GO EXTENDED, risk, and room before acting.")
alertcondition(scoreWatch10, "MNQ 🔔 Score 10/10 Watch", "MNQ Mission Control: The active directional score reached 10/10. Attention alert only—check verdict, BLOCKED, GO EXTENDED, risk, and room before acting.")

alertcondition(goLong and not blockedLong and not goExtendedLong and not continuationLong,  "MNQ 🟢 GO LONG",            "MNQ Mission Control: GO LONG signal active")
alertcondition(goShort and not blockedShort and not goExtendedShort and not continuationShort, "MNQ 🔴 GO SHORT",           "MNQ Mission Control: GO SHORT signal active")
alertcondition(continuationLong,  "MNQ 🟡 CONTINUATION LONG",  "MNQ Mission Control v24.5.7.3: Full GO-quality trend context is active. Nearby breakable structure is a checkpoint; Risk is measuring to the next real destination. Divergence may remain a warning.")
alertcondition(continuationShort, "MNQ 🟡 CONTINUATION SHORT", "MNQ Mission Control v24.5.7.3: Full GO-quality trend context is active. Nearby breakable structure is a checkpoint; Risk is measuring to the next real destination. Divergence may remain a warning.")
alertcondition(goPendingLong and not blockedLong,     "MNQ ⏳ LONG PENDING 5m",     "MNQ Mission Control v24.5.7.3: Live GO LONG conditions are present but completed-5m confirmation is still pending.")
alertcondition(goPendingShort and not blockedShort,    "MNQ ⏳ SHORT PENDING 5m",    "MNQ Mission Control v24.5.7.3: Live GO SHORT conditions are present but completed-5m confirmation is still pending.")
alertcondition(goExtended,        "MNQ 🟡 GO EXTENDED",        "MNQ Mission Control v24.5.7.3: GO is live but price is extended into structure. Wait for a pullback rather than chasing.")
alertcondition(blockedLong,        "MNQ ⛔ LONG BLOCKED",        "MNQ Mission Control: Long setup is blocked by stop too wide, poor R:R, no scalp room, exhaustion at a level, or divergence.")
alertcondition(blockedShort,       "MNQ ⛔ SHORT BLOCKED",       "MNQ Mission Control: Short setup is blocked by stop too wide, poor R:R, no scalp room, exhaustion at a level, or divergence.")
alertcondition(cautionLong,       "MNQ 🟡 CAUTION LONG",       "MNQ Mission Control: Caution Long")
alertcondition(cautionShort,      "MNQ 🟡 CAUTION SHORT",      "MNQ Mission Control: Caution Short")
alertcondition(bearishDivergence, "MNQ ⚠ Bearish Divergence", "Price extending up while cumulative TICK fails to confirm")
alertcondition(bullishDivergence, "MNQ ⚠ Bullish Divergence", "Price extending down while cumulative TICK fails to confirm")
alertcondition(liveTrendOverride, "MNQ 🚀 Live Trend Override", "MNQ Mission Control: Day Type upgraded to Live Trend Day")
alertcondition(exhaustRisk, "MNQ ⚠ Late Trend", "MNQ Mission Control: Late trend. Avoid fresh chase entries and wait for pullbacks.")
alertcondition(fatigueSignal and exhaustScore >= 3, "MNQ 🧊 Buyer/Seller Fatigue", "MNQ Mission Control: Momentum fatigue detected. Wait for pullback or manage runners.")
alertcondition(exhaustClimax, "MNQ 🔥 Climax Risk", "MNQ Mission Control: Climax risk. Manage positions and avoid blind chase entries.")
alertcondition(bullReversalForming and not bullReversalForming[1], "MNQ 🔄 Bull Reversal Forming", "MNQ Mission Control: Bear→bull structural reversal forming. Recent EMA crosses + price reclaim. Wait for confirmation before entering long.")
alertcondition(bearReversalForming and not bearReversalForming[1], "MNQ 🔄 Bear Reversal Forming", "MNQ Mission Control: Bull→bear structural reversal forming. Recent EMA crosses + price loss. Wait for confirmation before entering short.")
alertcondition(bullJustConfirmed, "MNQ ✅ Bull Reversal Confirmed", "MNQ Mission Control: Bull reversal confirmed by price action. Trend established, normal entry rules apply.")
alertcondition(bearJustConfirmed, "MNQ ✅ Bear Reversal Confirmed", "MNQ Mission Control: Bear reversal confirmed by price action. Trend established, normal entry rules apply.")
alertcondition(longExpanding or shortExpanding, "MNQ 🚀 Level Expansion", "MNQ Mission Control: Price is MAKING a fresh day extreme on a strong close with clean internals — live expansion, not resistance. The exhaustion-at-level block is suppressed; Risk uses the RTH extreme that existed before the current fixed 5m signal bar rather than the live print.")
alertcondition(climaxState, "MNQ 🔥 Level Climax", "MNQ Mission Control: Fresh extremes this late in a long run with internals rolling over — treat as climax, do not chase.")
alertcondition(breadthSlopeConfirms, "MNQ 📐 Breadth Slope Confirms", "MNQ Mission Control: Both A/D and VOLD are moving with the price trend past their velocity floors — falling breadth is confirming the move, so internals-conflict CHOP is excused.")
alertcondition(bullInternalsSlopeOK or bearInternalsSlopeOK, "MNQ 📐 Score Slope Rescue", "MNQ Mission Control v24.5.7.3: One or more breadth components are being confirmed by decisive slope while cumulative signs are still catching up.")
