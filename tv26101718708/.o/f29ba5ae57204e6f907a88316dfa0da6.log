// [E] HELPERS — ULTRON's vocabulary
f_lineStyle(string s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted
f_labelSize(string s) => s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : size.normal
_p(float price) => str.tostring(price, "#.#####")

_fmt_time(int ts) =>
    str.tostring(hour(ts, gmt_tz), "00") + ":" + str.tostring(minute(ts, gmt_tz), "00")

_fmt_full_time(int ts) =>
    str.tostring(year(ts, gmt_tz)) + "-" + str.tostring(month(ts, gmt_tz), "00") + "-" + str.tostring(dayofmonth(ts, gmt_tz), "00") + " " + str.tostring(hour(ts, gmt_tz), "00") + ":" + str.tostring(minute(ts, gmt_tz), "00")

build_chart_link() => "https://www.tradingview.com/chart/?symbol=" + syminfo.tickerid + "&interval=" + timeframe.period

f_points(float d) => d / syminfo.mintick
f_pips(float d)   => f_points(d) * pips_per_point
f_rr_str(float r_val, float pts) => str.tostring(r_val, "#.##") + "R (" + str.tostring(pts, format.mintick) + " px)"
f_dist_str(float d) => str.tostring(d, format.mintick) + " px · " + str.tostring(f_points(d), "#.#") + " ticks"

deriv_asset_class() =>
    string upper = str.upper(syminfo.ticker)
    if str.contains(upper, "BTC") or str.contains(upper, "ETH")
        "crypto_major"
    else if str.contains(upper, "LTC") or str.contains(upper, "XRP") or str.contains(upper, "SOL") or str.contains(upper, "DOGE")
        "crypto_minor"
    else if str.contains(upper, "XAU") or str.contains(upper, "XAG") or str.contains(upper, "GOLD") or str.contains(upper, "SILVER")
        "commodity_metal"
    else if str.contains(upper, "WTI") or str.contains(upper, "BRENT") or str.contains(upper, "OIL")
        "commodity_oil"
    else if str.contains(upper, "V10") or str.contains(upper, "V25") or str.contains(upper, "V50") or str.contains(upper, "V75") or str.contains(upper, "V100") or str.contains(upper, "V150") or str.contains(upper, "V200") or str.contains(upper, "V300")
        "synthetic_vol"
    else if str.contains(upper, "JD")
        "synthetic_jump"
    else if str.contains(upper, "BOSS") or str.contains(upper, "BULL") or str.contains(upper, "BEAR")
        "synthetic_bullbear"
    else
        "forex"

deriv_max_mult(string c) =>
    switch c
        "synthetic_vol"      => 1000
        "forex"              => 1000
        "commodity_metal"    => 500
        "synthetic_bullbear" => 100
        "synthetic_jump"     => 100
        "commodity_oil"      => 100
        "crypto_major"       => 50
        "crypto_minor"       => 25
        => 100

deriv_mult_contract(bool isBull) => isBull ? "MULTUP" : "MULTDOWN"
deriv_dc_available(string c) => c == "forex" or str.contains(c, "commodity") or str.contains(c, "synthetic")

auto_htf() =>
    switch timeframe.period
        "1"     => "5"
        "3"     => "15"
        "5"     => "15"
        "15"    => "60"
        "30"    => "60"
        "60"    => "240"
        "240"   => "D"
        "D"     => "W"
        => "240"

tg_json_report(string chat_id, string msg) =>
    string s = str.replace_all(msg, "\\", "\\\\")
    s       := str.replace_all(s, "\"", "'")
    s       := str.replace_all(s, "\n", "\\n")
    s       := str.replace_all(s, "\t", " ")
    if str.length(s) > 4000
        s := str.substring(s, 0, 3990) + "..."
    "{\"chat_id\":\"" + chat_id + "\",\"text\":\"" + s + "\"}"

// Episodic Memory — ULTRON chooses what to remember. Only the last mem_max events
// live in awareness at any moment; everything else has been let go.
var array<int>    mem_time    = array.new_int()
var array<float>  mem_price   = array.new_float()
var array<float>  mem_level   = array.new_float()
var array<string> mem_event   = array.new_string()
var array<int>    mem_dir     = array.new_int()
var array<string> mem_session = array.new_string()

add_memory(string evt, float price, float level, int dir, string session) =>
    if array.size(mem_time) >= mem_max
        array.shift(mem_time)
        array.shift(mem_price)
        array.shift(mem_level)
        array.shift(mem_event)
        array.shift(mem_dir)
        array.shift(mem_session)
    array.push(mem_time, time)
    array.push(mem_price, price)
    array.push(mem_level, level)
    array.push(mem_event, evt)
    array.push(mem_dir, dir)
    array.push(mem_session, session)

// [F] STATE ARRAYS + ZONE HELPERS — ULTRON's drawing desk
var line[]  activeLines  = array.new_line()
var label[] activeLabels = array.new_label()
var line[]  storedLines  = array.new_line()
var label[] storedLabels = array.new_label()
var box[]   storedBoxes  = array.new_box()
var int[]   storedLineCounts  = array.new_int()
var int[]   storedLabelCounts = array.new_int()
var line[]  activeFibLines  = array.new_line()
var label[] activeFibLabels = array.new_label()
var line[]  storedFibLines  = array.new_line()
var label[] storedFibLabels = array.new_label()
var int[]   storedFibLineCounts  = array.new_int()
var int[]   storedFibLabelCounts = array.new_int()

float pendingBrokenLevel    = na
int   pendingStructureStart = na
float pendingZoneLabelGap   = na
float pendingRangeBoxTop    = na
float pendingRangeBoxBottom = na
int MAX_SAFE_ZONE_SETS = 7

var label _lastZoneLbl   = na
var int   _lastZoneDir   = 0
var float _lastZoneHigh  = na
var float _lastZoneLow   = na
var float activeZoneConf = na

f_levelLabel(int x, float y, string t, string labelSize, bool prominent) =>
    label.new(x, y, t, xloc = xloc.bar_time, style = label.style_label_left, textcolor = color.new(levelLblTxt, prominent ? 0 : 50), color = #00000000, size = labelSize)

f_addLevel(line[] linesArray, label[] labelsArray, int leftTime, int rightTime, float level, string labelText, color lineColor, string lineStyle, int lineWidth, string labelSize, bool prominent) =>
    line lvl = line.new(leftTime, level, rightTime, level, xloc = xloc.bar_time, color = lineColor, style = lineStyle, width = lineWidth)
    array.push(linesArray, lvl)
    label lbl = na
    if showLevelLbls
        lbl := f_levelLabel(rightTime, level, labelText, labelSize, prominent)
    array.push(labelsArray, lbl)

f_trimStoredSets() =>
    int eff = showLastZones == 0 ? MAX_SAFE_ZONE_SETS : math.min(showLastZones, MAX_SAFE_ZONE_SETS)
    while array.size(storedBoxes) > eff
        box b = array.shift(storedBoxes)
        if not na(b)
            box.delete(b)
        int lc = array.shift(storedLineCounts)
        if lc > 0
            for i = 0 to lc - 1
                line l = array.shift(storedLines)
                if not na(l)
                    line.delete(l)
        int labC = array.shift(storedLabelCounts)
        if labC > 0
            for i = 0 to labC - 1
                label lb = array.shift(storedLabels)
                if not na(lb)
                    label.delete(lb)
    while array.size(storedFibLineCounts) > eff
        int lc = array.shift(storedFibLineCounts)
        if lc > 0
            for i = 0 to lc - 1
                line l = array.shift(storedFibLines)
                if not na(l)
                    line.delete(l)
        int labC = array.shift(storedFibLabelCounts)
        if labC > 0
            for i = 0 to labC - 1
                label lb = array.shift(storedFibLabels)
                if not na(lb)
                    label.delete(lb)

f_storeActiveSet(box zoneBox) =>
    int lc = array.size(activeLines)
    int labC = array.size(activeLabels)
    if lc > 0
        for i = 0 to lc - 1
            array.push(storedLines, array.get(activeLines, i))
    if labC > 0
        for i = 0 to labC - 1
            array.push(storedLabels, array.get(activeLabels, i))
    array.push(storedBoxes, zoneBox)
    array.push(storedLineCounts, lc)
    array.push(storedLabelCounts, labC)
    int flc = array.size(activeFibLines)
    int flabC = array.size(activeFibLabels)
    if flc > 0
        for i = 0 to flc - 1
            array.push(storedFibLines, array.get(activeFibLines, i))
    if flabC > 0
        for i = 0 to flabC - 1
            array.push(storedFibLabels, array.get(activeFibLabels, i))
    array.push(storedFibLineCounts, flc)
    array.push(storedFibLabelCounts, flabC)
    f_trimStoredSets()

f_freezeActive(int freezeTime) =>
    int lc = array.size(activeLines)
    if lc > 0
        for i = 0 to lc - 1
            line l = array.get(activeLines, i)
            if not na(l)
                line.set_x2(l, freezeTime)
    int labC = array.size(activeLabels)
    if labC > 0
        for i = 0 to labC - 1
            label lb = array.get(activeLabels, i)
            if not na(lb)
                label.set_x(lb, freezeTime)
    int flc = array.size(activeFibLines)
    if flc > 0
        for i = 0 to flc - 1
            line l = array.get(activeFibLines, i)
            if not na(l)
                line.set_x2(l, freezeTime)
    int flabC = array.size(activeFibLabels)
    if flabC > 0
        for i = 0 to flabC - 1
            label lb = array.get(activeFibLabels, i)
            if not na(lb)
                label.set_x(lb, freezeTime)

// [G] FIB RENDERING — the grid Tron found. 0.382/0.5/0.618/0.786 are constants
// on a self-similar map; ULTRON reads price against them like stars.
f_addFib(bool enabled, float lvl, int dir, float rHighV, float rLowV, float rng, int lt, int rt, color clr, string style) =>
    if enabled
        float v = dir == 1 ? rHighV - rng * lvl : rLowV + rng * lvl
        line l = line.new(lt, v, rt, v, xloc = xloc.bar_time, color = color.new(clr, 35), style = f_lineStyle(style), width = 1)
        array.push(activeFibLines, l)
        label lb = label.new(rt, v, str.tostring(lvl) + " · " + str.tostring(v, format.mintick), xloc = xloc.bar_time, color = color(na), style = label.style_label_left, textcolor = color.new(clr, 35), size = size.small)
        array.push(activeFibLabels, lb)

f_renderFibs(int dir, float rHighV, float rLowV, color clr, int rightTime) =>
    array.clear(activeFibLines)
    array.clear(activeFibLabels)
    float rng = math.abs(rHighV - rLowV)
    int   lt  = time
    int   rt  = rightTime
    if rng > 0
        f_addFib(show_0,    0.0,   dir, rHighV, rLowV, rng, lt, rt, clr, "Solid")
        f_addFib(show_0_382,0.382, dir, rHighV, rLowV, rng, lt, rt, clr, "Dotted")
        f_addFib(show_0_5,  0.5,   dir, rHighV, rLowV, rng, lt, rt, clr, "Dotted")
        f_addFib(show_0_618,0.618, dir, rHighV, rLowV, rng, lt, rt, clr, "Dotted")
        f_addFib(show_0_786,0.786, dir, rHighV, rLowV, rng, lt, rt, clr, "Dotted")
        f_addFib(show_1,    1.0,   dir, rHighV, rLowV, rng, lt, rt, clr, "Solid")

// [H] HULL SUITE — smoothed perception. Macro Hull is the regime lens;
// Fast Hull is the tactical lens. Disagreement = the market is transitioning.
HMA(_src, _length) => ta.wma(2 * ta.wma(_src, _length / 2) - ta.wma(_src, _length), math.round(math.sqrt(_length)))
EHMA(_src, _length) => ta.ema(2 * ta.ema(_src, _length / 2) - ta.ema(_src, _length), math.round(math.sqrt(_length)))
THMA(_src, _length) => ta.wma(ta.wma(_src, _length / 3) * 3 - ta.wma(_src, _length / 2) - ta.wma(_src, _length), _length)

f_hullMode(string mode, float s, int len) =>
    hma_val  = HMA(s, len)
    ehma_val = EHMA(s, len)
    thma_val = THMA(s, len / 2)
    mode == "Hma" ? hma_val : mode == "Ehma" ? ehma_val : mode == "Thma" ? thma_val : float(na)

_hull     = f_hullMode(modeSwitch, hullSrc, int(hullLength * lengthMult))
_hullFast = f_hullMode(modeSwitch, hullSrc, hullFastLen)
HULL      = useHtf ? request.security(syminfo.tickerid, htf, _hull) : _hull
HULL_FAST = _hullFast
bool hull_bull  = HULL > HULL[2]
bool hull_bear  = HULL < HULL[2]
bool fast_bull  = HULL_FAST > HULL_FAST[2]
bool fast_bear  = HULL_FAST < HULL_FAST[2]
color hullColor = hull_bull ? LONG_COLOR : SHORT_COLOR

// [I] ULTRON GATE + FIB INTELLIGENCE — the regime cortex. Basis is a double-
// smoothed EMA of hlc3; trend_fib reads its derivative. HTF read via
// request.security with [1] for confirmed-bar integrity. No lookahead, ever.
ema200 = ta.ema(close, 200)
basis   = ta.ema(ta.ema(hlc3, fibLen), fibLen)
vol_fib = ta.atr(fibAtrLen)
var int trend_fib = 0
trend_fib := basis > basis[1] ? 1 : basis < basis[1] ? -1 : nz(trend_fib[1])

u1_v = trend_fib == -1 ? basis + vol_fib * 0.618 : na
u4_v = trend_fib == -1 ? basis + vol_fib * 2.618 : na
l1_v = trend_fib == 1  ? basis - vol_fib * 0.618 : na
l4_v = trend_fib == 1  ? basis - vol_fib * 2.618 : na

bool ultron_bull_clear = not useUltronGate or (trend_fib == 1 or close > ema200)
bool ultron_bear_clear = not useUltronGate or (trend_fib == -1 or close < ema200)

f_calcHtfFib() =>
    float htf_basis = ta.ema(ta.ema(hlc3, fibLen), fibLen)
    int   htf_trend = 0
    htf_trend := htf_basis > htf_basis[1] ? 1 : htf_basis < htf_basis[1] ? -1 : nz(htf_trend[1])
    [htf_trend[1], htf_basis[1]]

string resolved_htf = use_htf_fib_auto ? auto_htf() : htf_fib_manual
[htf_trend_fib, htf_basis_val] = request.security(syminfo.tickerid, resolved_htf, f_calcHtfFib(), lookahead=barmerge.lookahead_off)

var int htf_fib_last_dir = 0
var int htf_fib_flip_bar = 0
if htf_trend_fib != htf_fib_last_dir and htf_trend_fib != 0
    htf_fib_last_dir := htf_trend_fib
    htf_fib_flip_bar := bar_index
int htf_bars_since_flip = bar_index - htf_fib_flip_bar

var int fib_last_dir = 0
var int fib_flip_bar = 0
if trend_fib != fib_last_dir and trend_fib != 0
    fib_last_dir := trend_fib
    fib_flip_bar := bar_index
int fib_bars_since_flip = bar_index - fib_flip_bar

bool use_ltf_source = htf_fib_mode == "LTF Only" or htf_fib_mode == "Both"
bool use_htf_source = htf_fib_mode == "HTF Only" or htf_fib_mode == "Both"
bool ltf_gate_long  = not use_ltf_source or trend_fib == 1
bool ltf_gate_short = not use_ltf_source or trend_fib == -1
bool htf_gate_long  = not use_htf_source or htf_trend_fib == 1
bool htf_gate_short = not use_htf_source or htf_trend_fib == -1
bool fib_band_long  = not use_fib_band_filter or close > basis
bool fib_band_short = not use_fib_band_filter or close < basis
bool fib_cool_long  = not use_fib_cooldown    or trend_fib == 1 or fib_bars_since_flip > fib_cooldown_bars
bool fib_cool_short = not use_fib_cooldown    or trend_fib == -1 or fib_bars_since_flip > fib_cooldown_bars
bool htf_band_long  = not use_htf_band or na(htf_basis_val) or close > htf_basis_val
bool htf_band_short = not use_htf_band or na(htf_basis_val) or close < htf_basis_val
bool htf_cool_long  = not use_htf_cooldown    or htf_trend_fib == 1 or htf_bars_since_flip > htf_cooldown_bars
bool htf_cool_short = not use_htf_cooldown    or htf_trend_fib == -1 or htf_bars_since_flip > htf_cooldown_bars

bool fib_base_clear_long  = ltf_gate_long  and htf_gate_long  and fib_band_long  and htf_band_long  and fib_cool_long  and htf_cool_long
bool fib_base_clear_short = ltf_gate_short and htf_gate_short and fib_band_short and htf_band_short and fib_cool_short and htf_cool_short

// [J] TRAIL ENGINE — chandelier stop anchored to a smoothed MA, cast outward by
// ATR. Trend flips are ULTRON's primary trigger. Alpha Gate is a permission
// layer preventing wick-driven whipsaws. Gray trail is cosmetic.
float hAtr = ta.atr(trail_atr_len)
float hMa  = ta.ema(close, ma_len)
float raw_up = hMa - hAtr * atr_mult
float raw_dn = hMa + hAtr * atr_mult

ema21 = ta.ema(close, emaFast)
ema55 = ta.ema(close, emaSlow)
bool alpha_bull_allowed = not useAlphaGate or (ema21 > ema55)
bool alpha_bear_allowed = not useAlphaGate or (ema21 < ema55)

var int   trailTrend = 1
var float trail = na
if na(trail)
    trail := close > hMa ? raw_up : raw_dn
    trailTrend := close > hMa ? 1 : -1

if trailTrend == 1
    if close < trail and alpha_bear_allowed
        trailTrend := -1
        trail := raw_dn
    else if close < trail and not alpha_bear_allowed
        trail := nz(trail[1])
    else
        trail := math.max(raw_up, nz(trail[1]))
else
    if close > trail and alpha_bull_allowed
        trailTrend := 1
        trail := raw_up
    else if close > trail and not alpha_bull_allowed
        trail := nz(trail[1])
    else
        trail := math.min(raw_dn, nz(trail[1]))

bool flip_bull = trailTrend == 1  and trailTrend[1] == -1
bool flip_bear = trailTrend == -1 and trailTrend[1] == 1
bool trailOpposingFib  = (trailTrend == 1  and trend_fib == -1) or (trailTrend == -1 and trend_fib == 1)
bool trailOpposingHull = (trailTrend == 1  and hull_bear)       or (trailTrend == -1 and hull_bull)
bool trail_gray = useTrailGray and ((useTrailGrayFib and trailOpposingFib) or (useTrailGrayHull and trailOpposingHull))
color trend_col = trail_gray ? color.gray : (trailTrend == 1 ? LONG_COLOR : SHORT_COLOR)

// [K] LIQUIDITY ZONES + ZONE TOOLTIP — spatial memory. Resting orders live at
// swing highs and lows. ULTRON does not trade them; it remembers them.
type LiqZone
    float top
    float bot
    float price
    bool  is_high
    bool  broken
    box   bx
    label lb

var LiqZone[] lqZones = array.new<LiqZone>()

add_lq_zone(float price, bool is_high) =>
    float pad = math.max(hAtr * lq_atr_mult, syminfo.mintick)
    float top = is_high ? price : price + pad
    float bot = is_high ? price - pad : price
    if array.size(lqZones) >= max_lq_zones
        LiqZone old = array.shift(lqZones)
        box.delete(old.bx)
        label.delete(old.lb)
    color fc = is_high ? color.new(SHORT_COLOR, 84) : color.new(LONG_COLOR, 84)
    color bc = is_high ? color.new(SHORT_COLOR, 20) : color.new(LONG_COLOR, 20)
    box bx = box.new(bar_index - swing_len, top, bar_index + extend_lq, bot, bgcolor=fc, border_color=bc)
    label lb = label.new(bar_index + extend_lq, price, is_high ? "H-LIQ" : "L-LIQ", color=na, textcolor=is_high ? SHORT_COLOR : LONG_COLOR, style=label.style_label_left, size=size.small)
    array.push(lqZones, LiqZone.new(top, bot, price, is_high, false, bx, lb))

float lqPH = ta.pivothigh(high, swing_len, swing_len)
float lqPL = ta.pivotlow(low, swing_len, swing_len)
if show_lq
    if not na(lqPH)
        add_lq_zone(lqPH, true)
    if not na(lqPL)
        add_lq_zone(lqPL, false)

if array.size(lqZones) > 0
    int i = array.size(lqZones) - 1
    while i >= 0
        LiqZone z = array.get(lqZones, i)
        z.bx.set_right(bar_index + extend_lq)
        z.lb.set_x(bar_index + extend_lq)
        if not z.broken
            if (z.is_high and close > z.top) or (not z.is_high and close < z.bot)
                z.broken := true
                z.bx.set_bgcolor(color.new(z.is_high ? SHORT_COLOR : LONG_COLOR, 88))
        array.set(lqZones, i, z)
        i -= 1

build_zone_tooltip(int dir, float zHigh, float zLow) =>
    string dirTxt = dir == 1 ? "BUY" : "SELL"
    bool   fibAgrees = (dir == 1 and fib_base_clear_long) or (dir == -1 and fib_base_clear_short)
    string out = dirTxt + " ZONE\n"
    out += "Event: " + dirTxt + " CHoCH on " + timeframe.period + "\n"
    out += "H: " + _p(zHigh) + "  L: " + _p(zLow) + "\n"
    out += "Range: " + f_dist_str(zHigh - zLow) + "\n"
    out += "Trail: " + (trailTrend == 1 ? "BULL" : "BEAR") + "\n"
    out += "Ultron Gate: " + (dir == 1 ? (ultron_bull_clear ? "UNLOCKED" : "LOCKED") : (ultron_bear_clear ? "UNLOCKED" : "LOCKED")) + "\n"
    out += "LTF Fib: " + (trend_fib == 1 ? "BULL" : trend_fib == -1 ? "BEAR" : "FLAT") + "\n"
    out += "HTF Fib (" + resolved_htf + "): " + (htf_trend_fib == 1 ? "BULL" : htf_trend_fib == -1 ? "BEAR" : "FLAT") + "\n"
    out += "Fib gate: " + (fibAgrees ? "ACTIVE" : "BLOCKED") + "\n"
    out += "Source: prior swing " + (dir == 1 ? "high" : "low") + " break\n"
    out

// [L] MARKET STRUCTURE + ZONE CREATION — the structural eye. A CHoCH is a
// change of character. Zones are drawn unconditionally (Tier 1) — but the
// Quality Gate (Fix 1) filters which ones become tradeable.
bool inCalcWindow = calcLastBars == 0 or bar_index >= last_bar_index - calcLastBars
int  oddLen   = fractalLen % 2 == 0 ? fractalLen + 1 : fractalLen
int  strength = int(oddLen / 2)
int  tfSec    = timeframe.in_seconds(timeframe.period)
int  extMs    = tfSec * 1000 * barsToRight
int  oneBarMs = tfSec * 1000

float pHigh   = ta.pivothigh(high, strength, strength)
float pLow    = ta.pivotlow(low, strength, strength)
float winLow  = ta.lowest(low, strength + 1)
float winHigh = ta.highest(high, strength + 1)

var float bullBreakLvl = na
var int   bullStartT   = na
var float bullRangeLow = na
var bool  bullBroken   = false
var float bearBreakLvl = na
var int   bearStartT   = na
var float bearRangeHigh= na
var bool  bearBroken   = false
var int   lastBreakDir = 0
var bool  chochActive  = false
var int   activeDir    = 0
var float curZoneHigh  = na
var float curZoneLow   = na
var float curZoneRng   = na

if inCalcWindow
    if not na(pHigh)
        bullBreakLvl := pHigh
        bullStartT   := time[strength]
        bullRangeLow := winLow
        bullBroken   := false
    if not na(pLow)
        bearBreakLvl := pLow
        bearStartT   := time[strength]
        bearRangeHigh:= winHigh
        bearBroken   := false
    if not na(bullBreakLvl) and not bullBroken
        bullRangeLow := math.min(nz(bullRangeLow, low), low)
    if not na(bearBreakLvl) and not bearBroken
        bearRangeHigh := math.max(nz(bearRangeHigh, high), high)

bool bullBreak = inCalcWindow and not na(bullBreakLvl) and not bullBroken and (requireBody ? close > bullBreakLvl : high > bullBreakLvl)
bool bearBreak = inCalcWindow and not na(bearBreakLvl) and not bearBroken and (requireBody ? close < bearBreakLvl : low < bearBreakLvl)

// FIX 1 — extension guard. Distance from the swing that started this leg.
float _swingLow  = ta.lowest(low,  strength * 3)
float _swingHigh = ta.highest(high, strength * 3)
float _ext_from_low  = (close - _swingLow)  / math.max(hAtr, syminfo.mintick)
float _ext_from_high = (_swingHigh - close) / math.max(hAtr, syminfo.mintick)

f_zone_quality(int dir) =>
    bool result = true
    if useZoneQuality
        bool widthOK     = (high - low) >= hAtr * minZoneAtr
        bool htfOK       = not requireHtfAgree or (dir == 1 and htf_trend_fib == 1) or (dir == -1 and htf_trend_fib == -1)
        bool notExtended = dir == 1 ? _ext_from_low <= extAtrGuard : _ext_from_high <= extAtrGuard
        result := widthOK and htfOK and notExtended
    result

f_htfChoch() =>
    _oddLen   = fractalLen % 2 == 0 ? fractalLen + 1 : fractalLen
    _strength = int(_oddLen / 2)
    _pHigh    = ta.pivothigh(high, _strength, _strength)
    _pLow     = ta.pivotlow(low, _strength, _strength)
    var float _bullBreakLvl = na
    var bool  _bullBroken   = false
    var float _bearBreakLvl = na
    var bool  _bearBroken   = false
    var int   _lastBreakDir = 0
    var int   _htfActiveDir = 0
    if not na(_pHigh)
        _bullBreakLvl := _pHigh
        _bullBroken   := false
    if not na(_pLow)
        _bearBreakLvl := _pLow
        _bearBroken   := false
    _bullBreak = not na(_bullBreakLvl) and not _bullBroken and close > _bullBreakLvl
    _bearBreak = not na(_bearBreakLvl) and not _bearBroken and close < _bearBreakLvl
    if _bullBreak
        _bullBroken := true
        if _lastBreakDir == -1
            _htfActiveDir := 1
        _lastBreakDir := 1
    if _bearBreak
        _bearBroken := true
        if _lastBreakDir == 1
            _htfActiveDir := -1
        _lastBreakDir := -1
    _htfActiveDir

htf_choch_dir = request.security(syminfo.tickerid, mtfConfluenceTf, f_htfChoch(), lookahead=barmerge.lookahead_off)

f_createChochSet(int dir, float zoneHigh, float zoneLow) =>
    array.clear(activeLines)
    array.clear(activeLabels)
    float zoneRng = math.max(syminfo.mintick, zoneHigh - zoneLow)
    float eq      = zoneHigh - zoneRng * 0.5
    int   lt      = time
    int   rt      = time + extMs
    color dirColor= dir == 1 ? (showBullMS ? zoneUpClr : color.gray) : (showBearMS ? zoneDnClr : color.gray)
    color stepCol = color.new(dirColor, 50)
    string lStyl  = f_lineStyle(zoneStyle)
    string lblSz  = f_labelSize(lblSize)
    bool fib_agrees_with_zone = (dir == 1 and fib_base_clear_long) or (dir == -1 and fib_base_clear_short)
    color zoneFillUse   = highlightAOI ? (fib_agrees_with_zone or not dimDivergentZones ? (dir == 1 ? boxFillUp : boxFillDn) : color.new(chart.bg_color, 92)) : na
    color zoneBorderUse = dimDivergentZones and not fib_agrees_with_zone ? color.new(dir == 1 ? boxBorderUp : boxBorderDn, 65) : (dir == 1 ? boxBorderUp : boxBorderDn)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh, "H", dirColor, line.style_solid, hlWidth, lblSz, true)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow,  "L", dirColor, line.style_solid, hlWidth, lblSz, true)
    f_addLevel(activeLines, activeLabels, lt, rt, eq, "Z·EQ", dirColor, line.style_dashed, 2, lblSz, true)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 0.5, "+0.5", stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 1.0, "+1",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 1.5, "+1.5", stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 2.0, "+2",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 3.0, "+3",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneHigh + zoneRng * 4.0, "+4",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 0.5, "-0.5", stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 1.0, "-1",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 1.5, "-1.5", stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 2.0, "-2",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 3.0, "-3",   stepCol, lStyl, stepWidth, lblSz, false)
    f_addLevel(activeLines, activeLabels, lt, rt, zoneLow - zoneRng * 4.0, "-4",   stepCol, lStyl, stepWidth, lblSz, false)
    int safeStart = na(pendingStructureStart) ? lt : pendingStructureStart
    float safeLvl = na(pendingBrokenLevel) ? eq : pendingBrokenLevel
    int midTime   = safeStart + int((lt - safeStart) / 2)
    line structLn = line.new(safeStart, safeLvl, lt, safeLvl, xloc = xloc.bar_time, color = dirColor, style = f_lineStyle(msLineStyle), width = msLineWidth)
    array.push(activeLines, structLn)
    bool mtf_confluence = useMtfConfluence and ((dir == 1 and htf_choch_dir == 1) or (dir == -1 and htf_choch_dir == -1))
    string zoneTag = (dir == 1 ? "BUY ZONE" : "SELL ZONE") + (mtf_confluence ? " ⭐" : "")
    color labelColor = mtf_confluence ? color.yellow : dirColor
    float gap  = math.max(nz(pendingZoneLabelGap, zoneRng * 0.5), syminfo.mintick * 20.0)
    float zY   = dir == 1 ? safeLvl + gap : safeLvl - gap
    label zLbl = label.new(midTime, zY, zoneTag, xloc = xloc.bar_time, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = labelColor, color = color.new(chart.bg_color, 5), size = lblSz, textalign = text.align_center, tooltip = build_zone_tooltip(dir, zoneHigh, zoneLow))
    array.push(activeLabels, zLbl)
    box zBox = box.new(safeStart, math.max(nz(pendingRangeBoxTop, zoneHigh), nz(pendingRangeBoxBottom, zoneLow)), lt + oneBarMs, math.min(nz(pendingRangeBoxTop, zoneHigh), nz(pendingRangeBoxBottom, zoneLow)), xloc = xloc.bar_time, border_color = zoneBorderUse, bgcolor = zoneFillUse, border_width = 1, border_style = line.style_dotted)
    if showFibs
        float impulseHigh = dir == 1 ? zoneHigh : math.max(nz(bearRangeHigh, zoneHigh), zoneHigh)
        float impulseLow  = dir == 1 ? math.min(nz(bullRangeLow, zoneLow), zoneLow) : zoneLow
        f_renderFibs(dir, impulseHigh, impulseLow, dir == 1 ? fibBullClr : fibBearClr, rt)
    f_storeActiveSet(zBox)
    zLbl

bool chochSignal = false
if bullBreak
    bullBroken := true
    if lastBreakDir == -1 and showZones and f_zone_quality(1)
        if chochActive
            f_freezeActive(time)
        curZoneHigh  := high
        curZoneLow   := low
        curZoneRng   := math.max(syminfo.mintick, high - low)
        pendingBrokenLevel    := bullBreakLvl
        pendingStructureStart := bullStartT
        pendingZoneLabelGap   := math.max(syminfo.mintick * 20.0, nz(hAtr, curZoneRng) * lblAtrGap)
        pendingRangeBoxTop    := bullBreakLvl
        pendingRangeBoxBottom := math.min(nz(bullRangeLow, low), low)
        _lastZoneLbl  := f_createChochSet(1, curZoneHigh, curZoneLow)
        _lastZoneDir  := 1
        _lastZoneHigh := curZoneHigh
        _lastZoneLow  := curZoneLow
        chochSignal := true
        chochActive := true
        activeDir   := 1
    lastBreakDir := 1

if bearBreak
    bearBroken := true
    if lastBreakDir == 1 and showZones and f_zone_quality(-1)
        if chochActive
            f_freezeActive(time)
        curZoneHigh  := high
        curZoneLow   := low
        curZoneRng   := math.max(syminfo.mintick, high - low)
        pendingBrokenLevel    := bearBreakLvl
        pendingStructureStart := bearStartT
        pendingZoneLabelGap   := math.max(syminfo.mintick * 20.0, nz(hAtr, curZoneRng) * lblAtrGap)
        pendingRangeBoxTop    := math.max(nz(bearRangeHigh, high), high)
        pendingRangeBoxBottom := bearBreakLvl
        _lastZoneLbl  := f_createChochSet(-1, curZoneHigh, curZoneLow)
        _lastZoneDir  := -1
        _lastZoneHigh := curZoneHigh
        _lastZoneLow  := curZoneLow
        chochSignal := true
        chochActive := true
        activeDir   := -1
    lastBreakDir := -1

// [M] SMC STATE + INIT
var pivot swingHigh               = pivot.new(na,na,false)
var pivot swingLow                = pivot.new(na,na,false)
var pivot internalHigh            = pivot.new(na,na,false)
var pivot internalLow             = pivot.new(na,na,false)
var pivot equalHigh               = pivot.new(na,na,false)
var pivot equalLow                = pivot.new(na,na,false)
var trend swingTrend              = trend.new(0)
var trend internalTrend           = trend.new(0)
var equalDisplay equalHighDisplay = equalDisplay.new()
var equalDisplay equalLowDisplay  = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs      = array.new<float>()
var array<float> parsedLows       = array.new<float>()
var array<float> highs_arr        = array.new_float()
var array<float> lows_arr         = array.new_float()
var array<int>   times_arr        = array.new_int()
var trailingExtremes trailing     = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks    = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes      = array.new<box>()
var array<box> internalOrderBlocksBoxes   = array.new<box>()

var swingBullishColor        = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor        = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor         = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor        = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput

varip int currentBarIndex    = bar_index
varip int lastBarIndex       = bar_index
alerts currentAlerts         = alerts.new()
var initialTime              = time

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))

bearishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE_STR ? close : high
bullishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE_STR ? close : low
atrMeasure        = ta.atr(200)
volatilityMeasure = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr) / bar_index
highVolatilityBar = (high - low) >= (2 * volatilityMeasure)
parsedHigh        = highVolatilityBar ? low  : high
parsedLow         = highVolatilityBar ? high : low
parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs_arr.push(high)
lows_arr.push(low)
times_arr.push(time)

// [N] SMC FUNCTIONS — structural grammar. Pivots, EQL/EQH, order blocks, FVG,
// premium/discount. Each is a different question asked of the same data.
leg(int size) =>
    var leg     = 0
    newLegHigh  = high[size] > ta.highest(size)
    newLegLow   = low[size]  < ta.lowest(size)
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)     => ta.change(leg) != 0
startOfBearishLeg(int leg) => ta.change(leg) == -1
startOfBullishLeg(int leg) => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na
    if modeInput == PRESENT
        l_abel.delete()
    l_abel := label.new(chart.point.new(labelTime,na,labelPrice), tag, xloc.bar_time, color=color(na), textcolor=labelColor, style=labelStyle, size=size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh_flag) =>
    equalDisplay e_qualDisplay = equalHigh_flag ? equalHighDisplay : equalLowDisplay
    string tag      = 'EQL'
    color eqColor   = swingBullishColor
    string lblStyle = label.style_label_up
    if equalHigh_flag
        tag      := 'EQH'
        eqColor  := swingBearishColor
        lblStyle := label.style_label_down
    if modeInput == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)
    e_qualDisplay.l_ine  := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc=xloc.bar_time, color=eqColor, style=line.style_dotted)
    labelPosition         = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel := label.new(chart.point.new(na,labelPosition,level), tag, xloc=xloc.bar_index, color=color(na), textcolor=eqColor, style=lblStyle, size=equalHighsLowsSizeInput)

getCurrentStructure(int size, bool equalHighLow=false, bool internal=false) =>
    currentLeg  = leg(size)
    newPivot    = startOfNewLeg(currentLeg)
    pivotLow    = startOfBullishLeg(currentLeg)
    pivotHigh   = startOfBearishLeg(currentLeg)
    if newPivot
        if pivotLow
            pivot p_ivot = equalHighLow ? equalLow : internal ? internalLow : swingLow
            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh
            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, high[size], size, true)
                currentAlerts.equalHighs := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.top         := p_ivot.currentLevel
                trailing.barTime     := p_ivot.barTime
                trailing.barIndex    := p_ivot.barIndex
                trailing.lastTopTime := p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line  l_ine  = line.new(na,na,na,na, xloc=xloc.bar_time)
    var label l_abel = label.new(na,na)
    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()
    l_ine  := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc=xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc=xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size=labelSize)

deleteOrderBlocks(bool internal=false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    for [index,eachOB] in orderBlocks
        bool crossed = false
        if bearishOrderBlockMitigationSource > eachOB.barHigh and eachOB.bias == BEARISH
            crossed := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOB.barLow and eachOB.bias == BULLISH
            crossed := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossed
            orderBlocks.remove(index)

storeOrderBlock(pivot p_ivot, bool internal=false, int bias=1) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)
        array<float> a_rray = na
        int parsedIndex = na
        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex, bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex, bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())
        orderBlock ob             = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times_arr.get(parsedIndex), bias)
        array<orderBlock> blocks  = internal ? internalOrderBlocks : swingOrderBlocks
        if blocks.size() >= 100
            blocks.pop()
        blocks.unshift(ob)

drawOrderBlocks(bool internal=false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    obSize = orderBlocks.size()
    if obSize > 0
        maxOB  = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOBs = orderBlocks.slice(0, math.min(maxOB, obSize))
        array<box> b_oxes           = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
        for [index, eachOB] in parsedOBs
            obColor = styleInput == MONOCHROME ? (eachOB.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOB.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOB.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            box b_ox = b_oxes.get(index)
            b_ox.set_top_left_point(    chart.point.new(eachOB.barTime,na,eachOB.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na,eachOB.barLow))
            b_ox.set_border_color(      internal ? na : obColor)
            b_ox.set_bgcolor(           obColor)

displayStructure(bool internal=false) =>
    var bullishBar = true
    var bearishBar = true
    if internalFilterConfluenceInput
        bullishBar := high - math.max(close,open) > math.min(close,open) - low
        bearishBar := high - math.max(close,open) < math.min(close,open) - low
    pivot p_ivot   = internal ? internalHigh : swingHigh
    trend t_rend   = internal ? internalTrend : swingTrend
    lineStyle      = internal ? line.style_dashed : line.style_solid
    labelSize      = internal ? internalStructureSize : swingStructureSize
    extraCond      = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor   = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCond
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBullishCHoCH := tag == CHOCH
            currentAlerts.internalBullishBOS   := tag == BOS
        else
            currentAlerts.swingBullishCHoCH    := tag == CHOCH
            currentAlerts.swingBullishBOS      := tag == BOS
        p_ivot.crossed := true
        t_rend.bias    := BULLISH
        displayCond = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))
        if displayCond
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)
        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrderBlock(p_ivot, internal, BULLISH)
    p_ivot    := internal ? internalLow : swingLow
    extraCond := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput
    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCond
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBearishCHoCH := tag == CHOCH
            currentAlerts.internalBearishBOS   := tag == BOS
        else
            currentAlerts.swingBearishCHoCH    := tag == CHOCH
            currentAlerts.swingBearishBOS      := tag == BOS
        p_ivot.crossed := true
        t_rend.bias    := BEARISH
        displayCond = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        if displayCond
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)
        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrderBlock(p_ivot, internal, BEARISH)

fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) =>
    box.new(chart.point.new(leftTime,na,topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * (time - time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color=boxColor, bgcolor=boxColor)

deleteFairValueGaps() =>
    for [index, fvg] in fairValueGaps
        if (low < fvg.bottom and fvg.bias == BULLISH) or (high > fvg.top and fvg.bias == BEARISH)
            fvg.topBox.delete()
            fvg.bottomBox.delete()
            fairValueGaps.remove(index)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1],open[1],time[1],high[0],low[0],time[0],high[2],low[2]], lookahead=barmerge.lookahead_off)
    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0
    bullishFVG          = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFVG          = currentHigh < last2Low  and lastClose < last2Low  and -barDeltaPercent > threshold and newTimeframe
    if bullishFVG
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow,last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow,last2High), last2High, fairValueGapBullishColor)))
    if bearishFVG
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh,last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh,last2Low), last2Low, fairValueGapBearishColor)))

updateTrailingExtremes() =>
    trailing.top            := math.max(high, nz(trailing.top, high))
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,  nz(trailing.bottom, low))
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line  topLine    = line.new(na,na,na,na, color=swingBearishColor, xloc=xloc.bar_time)
    var line  botLine    = line.new(na,na,na,na, color=swingBullishColor, xloc=xloc.bar_time)
    var label topLabel   = label.new(na,na, color=color(na), textcolor=swingBearishColor, xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny)
    var label botLabel   = label.new(na,na, color=color(na), textcolor=swingBullishColor, xloc=xloc.bar_time, style=label.style_label_up, size=size.tiny)
    rightTimeBar         = last_bar_time + 20*(time-time[1])
    topLine.set_first_point(  chart.point.new(trailing.lastTopTime,    na, trailing.top))
    topLine.set_second_point( chart.point.new(rightTimeBar,            na, trailing.top))
    topLabel.set_point(       chart.point.new(rightTimeBar,            na, trailing.top))
    topLabel.set_text(        swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')
    botLine.set_first_point(  chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    botLine.set_second_point( chart.point.new(rightTimeBar,            na, trailing.bottom))
    botLabel.set_point(       chart.point.new(rightTimeBar,            na, trailing.bottom))
    botLabel.set_text(        swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel = label.new(na, na, text = tag, color = color(na), textcolor = zoneColor, style = style, size = size.small)
    var box   b_ox   = box.new(na, na, na, na, bgcolor = color.new(zoneColor, 80), border_color = color(na), xloc = xloc.bar_time)
    b_ox.set_top_left_point(     chart.point.new(trailing.barTime, na, top))
    b_ox.set_bottom_right_point( chart.point.new(last_bar_time,    na, bottom))
    l_abel.set_point(            chart.point.new(na, labelIndex, labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5 * (trailing.barIndex + last_bar_index)), trailing.top, 0.95 * trailing.top + 0.05 * trailing.bottom, "Premium", premiumZoneColor, label.style_label_down)
    eqLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(eqLevel, last_bar_index, 0.525 * trailing.top + 0.475 * trailing.bottom, 0.525 * trailing.bottom + 0.475 * trailing.top, "Equilibrium", equilibriumZoneColorInput, label.style_label_left)
    drawZone(trailing.bottom, math.round(0.5 * (trailing.barIndex + last_bar_index)), 0.95 * trailing.bottom + 0.05 * trailing.top, trailing.bottom, "Discount", discountZoneColor, label.style_label_up)

// [O] RSI MOMENTUM + SMART SIGNALS — second opinion. Rising-edge only.
rsi = ta.rsi(close, rsiLen)
rsi_ema_val  = ta.ema(close, rsi_ema_len)
rsi_ema_chng = ta.change(rsi_ema_val)
bool smartBull_raw = rsi > pmom and rsi < rsi_ob and rsi_ema_chng > 0
bool smartBear_raw = rsi < nmom and rsi > rsi_os and rsi_ema_chng < 0
bool trailGateBullOK = not useSmartTrailGate or trailTrend == 1
bool trailGateBearOK = not useSmartTrailGate or trailTrend == -1
bool hullGateBullOK  = not useSmartHullGate  or hull_bull
bool hullGateBearOK  = not useSmartHullGate  or hull_bear
bool fibGateBullOK   = not useSmartFibGate   or trend_fib == 1
bool fibGateBearOK   = not useSmartFibGate   or trend_fib == -1
bool smartBull = smartBull_raw and trailGateBullOK and hullGateBullOK and fibGateBullOK
bool smartBear = smartBear_raw and trailGateBearOK and hullGateBearOK and fibGateBearOK
bool newSmartBull = smartBull and not smartBull[1]
bool newSmartBear = smartBear and not smartBear[1]
bool newSmartBullRaw = smartBull_raw and not smartBull_raw[1]
bool newSmartBearRaw = smartBear_raw and not smartBear_raw[1]
bool rejectedBull = newSmartBullRaw and not newSmartBull
bool rejectedBear = newSmartBearRaw and not newSmartBear

// [P] DWM INFO — diurnal rhythm. PDH/PDL are spatial anchors, not signals.
type dwm_info
    string tf
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na

var d_info = dwm_info.new("D")

update_dwm_info(dwm_info info) =>
    if timeframe.change(info.tf)
        info.ph := info.h
        info.pl := info.l
        info.o := open
        info.h := high
        info.l := low
    else
        info.h := math.max(high, info.h)
        info.l := math.min(low, info.l)

update_dwm_info(d_info)

// [Q] ICT KILLZONES — clock-based windows, not news.
var box asiaBox   = na
var box londonBox = na
var box nyamBox   = na
var box nyluBox   = na
var box nypmBox   = na

bool inAsia   = not na(time("", asia,   gmt_tz))
bool inLondon = not na(time("", london, gmt_tz))
bool inNyam   = not na(time("", nyam,   gmt_tz))
bool inNylu   = not na(time("", nylu,   gmt_tz))
bool inNypm   = not na(time("", nypm,   gmt_tz))

if show_kz
    if use_asia
        if inAsia and na(asiaBox)
            asiaBox := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=color.new(color.blue, box_transparency), bgcolor=color.new(color.blue, box_transparency), text=show_kz_text ? "Asia" : na, text_color=color.new(color.white, text_transparency))
        if inAsia and not na(asiaBox)
            box.set_right(asiaBox, time)
            box.set_top(asiaBox, math.max(box.get_top(asiaBox), high))
            box.set_bottom(asiaBox, math.min(box.get_bottom(asiaBox), low))
        if not inAsia and not na(asiaBox)
            asiaBox := na
    if use_london
        if inLondon and na(londonBox)
            londonBox := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=color.new(color.red, box_transparency), bgcolor=color.new(color.red, box_transparency), text=show_kz_text ? "London" : na, text_color=color.new(color.white, text_transparency))
        if inLondon and not na(londonBox)
            box.set_right(londonBox, time)
            box.set_top(londonBox, math.max(box.get_top(londonBox), high))
            box.set_bottom(londonBox, math.min(box.get_bottom(londonBox), low))
        if not inLondon and not na(londonBox)
            londonBox := na
    if use_nyam
        if inNyam and na(nyamBox)
            nyamBox := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=color.new(LONG_COLOR, box_transparency), bgcolor=color.new(LONG_COLOR, box_transparency), text=show_kz_text ? "NY AM" : na, text_color=color.new(color.white, text_transparency))
        if inNyam and not na(nyamBox)
            box.set_right(nyamBox, time)
            box.set_top(nyamBox, math.max(box.get_top(nyamBox), high))
            box.set_bottom(nyamBox, math.min(box.get_bottom(nyamBox), low))
        if not inNyam and not na(nyamBox)
            nyamBox := na
    if use_nylu
        if inNylu and na(nyluBox)
            nyluBox := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=color.new(color.yellow, box_transparency), bgcolor=color.new(color.yellow, box_transparency), text=show_kz_text ? "LDN-NY" : na, text_color=color.new(color.white, text_transparency))
        if inNylu and not na(nyluBox)
            box.set_right(nyluBox, time)
            box.set_top(nyluBox, math.max(box.get_top(nyluBox), high))
            box.set_bottom(nyluBox, math.min(box.get_bottom(nyluBox), low))
        if not inNylu and not na(nyluBox)
            nyluBox := na
    if use_nypm
        if inNypm and na(nypmBox)
            nypmBox := box.new(time, high, time, low, xloc=xloc.bar_time, border_color=color.new(color.purple, box_transparency), bgcolor=color.new(color.purple, box_transparency), text=show_kz_text ? "NY PM" : na, text_color=color.new(color.white, text_transparency))
        if inNypm and not na(nypmBox)
            box.set_right(nypmBox, time)
            box.set_top(nypmBox, math.max(box.get_top(nypmBox), high))
            box.set_bottom(nypmBox, math.min(box.get_bottom(nypmBox), low))
        if not inNypm and not na(nypmBox)
            nypmBox := na

string activeKz = inAsia ? "Asia" : inLondon ? "London" : inNyam ? "NY AM" : inNylu ? "LDN-NY" : inNypm ? "NY PM" : "Between"

// [R] NEURAL CONFLUENCE SCORE — 8 witnesses, each contributing one point.
// Not a probability — a count. When many agree, ULTRON trusts the direction.
float vol_avg = ta.sma(volume, volLen)
bool vol_ok = not na(volume) and not na(vol_avg) and volume >= vol_avg * volMult

bool in_aoi = false
if chochActive and not na(curZoneRng)
    float distHigh = math.abs(close - curZoneHigh)
    float distLow  = math.abs(close - curZoneLow)
    if distHigh <= curZoneRng * 1.5 or distLow <= curZoneRng * 1.5
        in_aoi := true

float mom = (close - close[momLookback]) / nz(hAtr, syminfo.mintick)
bool mom_bull = mom >  momThresh
bool mom_bear = mom < -momThresh

int bull_score = 0
int bear_score = 0
if w_hull  and hull_bull
    bull_score += 1
if w_hull  and hull_bear
    bear_score += 1
if w_fast  and fast_bull
    bull_score += 1
if w_fast  and fast_bear
    bear_score += 1
if w_trail and trailTrend == 1
    bull_score += 1
if w_trail and trailTrend == -1
    bear_score += 1
if w_choch and chochActive and activeDir == 1
    bull_score += 1
if w_choch and chochActive and activeDir == -1
    bear_score += 1
if w_aoi and in_aoi and activeDir == 1
    bull_score += 1
if w_aoi and in_aoi and activeDir == -1
    bear_score += 1
if w_mom and mom_bull
    bull_score += 1
if w_mom and mom_bear
    bear_score += 1
if w_ult and ultron_bull_clear
    bull_score += 1
if w_ult and ultron_bear_clear
    bear_score += 1
if w_vol and vol_ok
    bull_score += 1
    bear_score += 1

// [R2] PROBABILISTIC NODE LAYER — ULTRON watching itself watch price.
// Each node answers "how much", not "yes/no". The posterior is a sum of its
// parts, and every part is visible.
f_sigmoid(float x) => 1.0 / (1.0 + math.exp(-x))
_atr_norm = nz(ta.atr(14), syminfo.mintick)

pn_hull_bull = f_sigmoid((HULL - HULL[2]) / _atr_norm / probTemp * 2.0)
pn_hull_bear = 1.0 - pn_hull_bull
pn_fast_bull = f_sigmoid((HULL_FAST - HULL_FAST[2]) / _atr_norm / probTemp * 3.0)
pn_fast_bear = 1.0 - pn_fast_bull
pn_trail_bull = trailTrend == 1 ? 1.0 : 0.0
pn_trail_bear = 1.0 - pn_trail_bull
float _bar_ms_norm = math.max(1.0, nz(time - time[1], 60000.0))
float _bars_since_structure = math.abs(time - nz(pendingStructureStart, time)) / _bar_ms_norm
pn_choch_bull = (chochActive and activeDir == 1)  ? math.max(0.0, 1.0 - _bars_since_structure / 100.0) : 0.0
pn_choch_bear = (chochActive and activeDir == -1) ? math.max(0.0, 1.0 - _bars_since_structure / 100.0) : 0.0
pn_aoi_bull = (chochActive and activeDir == 1 and in_aoi)  ? 0.85 : 0.15
pn_aoi_bear = (chochActive and activeDir == -1 and in_aoi) ? 0.85 : 0.15
pn_mom_bull = f_sigmoid(mom / math.max(nz(momThresh, 0.5), 0.05) / probTemp)
pn_mom_bear = 1.0 - pn_mom_bull
pn_ult_bull = ultron_bull_clear ? 1.0 : 0.0
pn_ult_bear = ultron_bear_clear ? 1.0 : 0.0
pn_vol = not na(vol_avg) and vol_avg > 0 ? math.min(1.0, volume / (vol_avg * volMult)) : 0.5
pn_rsi_bull = math.max(0.0, math.min(1.0, (rsi - 50.0) / 30.0 + 0.5))
pn_rsi_bear = 1.0 - pn_rsi_bull
pn_kz_bull = (inNyam or inNylu) ? 0.65 : (inLondon or inAsia) ? 0.45 : 0.5
pn_kz_bear = (inLondon or inAsia) ? 0.65 : (inNyam or inNylu) ? 0.45 : 0.5
pn_htffib_bull = htf_trend_fib == 1  ? 1.0 : 0.0
pn_htffib_bear = htf_trend_fib == -1 ? 1.0 : 0.0
pn_mtf_bull = htf_choch_dir == 1  ? 1.0 : 0.0
pn_mtf_bear = htf_choch_dir == -1 ? 1.0 : 0.0
float pd_pos = not na(trailing.top) and not na(trailing.bottom) and trailing.top > trailing.bottom ? (close - trailing.bottom) / math.max(syminfo.mintick, trailing.top - trailing.bottom) : 0.5
pn_pd_bull = 1.0 - pd_pos
pn_pd_bear = pd_pos

float nearestH_lq = na
float nearestL_lq = na
if array.size(lqZones) > 0
    for i = 0 to array.size(lqZones) - 1
        LiqZone _z = array.get(lqZones, i)
        if _z.is_high and not _z.broken and (na(nearestH_lq) or math.abs(_z.price - close) < math.abs(nearestH_lq - close))
            nearestH_lq := _z.price
        if not _z.is_high and not _z.broken and (na(nearestL_lq) or math.abs(_z.price - close) < math.abs(nearestL_lq - close))
            nearestL_lq := _z.price
float _lq_range = _atr_norm * 5.0
pn_lq_bull = not na(nearestL_lq) ? math.max(0.0, 1.0 - math.abs(close - nearestL_lq) / _lq_range) : 0.0
pn_lq_bear = not na(nearestH_lq) ? math.max(0.0, 1.0 - math.abs(close - nearestH_lq) / _lq_range) : 0.0

// FIX 4 — synthetic-aware weights. Deriv synthetic volume is essentially fake.
bool _is_synth = str.contains(deriv_asset_class(), "synthetic")
float _w_vol_eff = _is_synth ? 0.0 : w_vol_p
float _w_rsi_eff = _is_synth ? w_rsi_p * 0.5 : w_rsi_p

float sum_w = w_hull_p + w_fast_p + w_trail_p + w_choch_p + w_aoi_p + w_mom_p + w_ult_p + _w_vol_eff + _w_rsi_eff + w_kz_p + w_htffib_p + w_mtf_p + w_pd_p + w_lq_p
float raw_bull = (pn_hull_bull  * w_hull_p  + pn_fast_bull  * w_fast_p  + pn_trail_bull * w_trail_p + pn_choch_bull * w_choch_p + pn_aoi_bull   * w_aoi_p   + pn_mom_bull   * w_mom_p   + pn_ult_bull   * w_ult_p   + pn_vol        * _w_vol_eff + pn_rsi_bull   * _w_rsi_eff + pn_kz_bull    * w_kz_p    + pn_htffib_bull* w_htffib_p+ pn_mtf_bull   * w_mtf_p   + pn_pd_bull    * w_pd_p    + pn_lq_bull    * w_lq_p) / math.max(0.001, sum_w)
float raw_bear = (pn_hull_bear  * w_hull_p  + pn_fast_bear  * w_fast_p  + pn_trail_bear * w_trail_p + pn_choch_bear * w_choch_p + pn_aoi_bear   * w_aoi_p   + pn_mom_bear   * w_mom_p   + pn_ult_bear   * w_ult_p   + pn_vol        * _w_vol_eff + pn_rsi_bear   * _w_rsi_eff + pn_kz_bear    * w_kz_p    + pn_htffib_bear* w_htffib_p+ pn_mtf_bear   * w_mtf_p   + pn_pd_bear    * w_pd_p    + pn_lq_bear    * w_lq_p) / math.max(0.001, sum_w)
float posterior_bull = raw_bull / math.max(0.001, raw_bull + raw_bear)
float posterior_bear = 1.0 - posterior_bull
float prob_edge     = math.abs(posterior_bull - posterior_bear)

// [R3] ZONE CONFIDENCE ENGINE — a zone is a claim. This counts corroborations.
f_zone_confidence(int dir, float zHigh, float zLow) =>
    float conf = 0.0
    int   total = 0
    total += 1
    if (dir == 1 and htf_choch_dir == 1) or (dir == -1 and htf_choch_dir == -1)
        conf += 1.0
    total += 1
    if (dir == 1 and fib_base_clear_long) or (dir == -1 and fib_base_clear_short)
        conf += 1.0
    total += 1
    if dir == 1 and not na(nearestL_lq) and math.abs(close - nearestL_lq) < _atr_norm * 4
        conf += 1.0
    if dir == -1 and not na(nearestH_lq) and math.abs(close - nearestH_lq) < _atr_norm * 4
        conf += 1.0
    total += 1
    if dir == 1 and pd_pos < 0.45
        conf += 1.0
    if dir == -1 and pd_pos > 0.55
        conf += 1.0
    total += 1
    if vol_ok
        conf += 1.0
    total += 1
    if dir == 1 and mom_bull
        conf += 1.0
    if dir == -1 and mom_bear
        conf += 1.0
    total += 1
    if inNyam or inNylu
        conf += 1.0
    total += 1
    if (dir == 1 and htf_trend_fib == 1) or (dir == -1 and htf_trend_fib == -1)
        conf += 1.0
    total += 1
    if in_aoi and ((dir == 1 and activeDir == 1) or (dir == -1 and activeDir == -1))
        conf += 1.0
    conf / math.max(1, total)

if chochSignal and not na(_lastZoneLbl)
    activeZoneConf := f_zone_confidence(_lastZoneDir, _lastZoneHigh, _lastZoneLow)
    string _stars = activeZoneConf >= 0.75 ? " ⭐⭐⭐" : activeZoneConf >= 0.50 ? " ⭐⭐" : activeZoneConf >= 0.25 ? " ⭐" : ""
    string _newTag = (_lastZoneDir == 1 ? "BUY ZONE" : "SELL ZONE") + _stars
    color _dirColor = _lastZoneDir == 1 ? zoneUpClr : zoneDnClr
    color _newColor = activeZoneConf >= 0.75 ? color.yellow : activeZoneConf >= 0.50 ? color.orange : activeZoneConf >= 0.25 ? _dirColor : color.new(_dirColor, 40)
    label.set_text(_lastZoneLbl, _newTag)
    label.set_textcolor(_lastZoneLbl, _newColor)
    string _base_tt = build_zone_tooltip(_lastZoneDir, _lastZoneHigh, _lastZoneLow)
    string _conf_tt = "Zone Confidence: " + str.tostring(activeZoneConf * 100.0, "#") + "%\n"
    string _post_tt = "Posterior(bull): " + str.tostring(posterior_bull * 100.0, "#.#") + "%  |  Posterior(bear): " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
    label.set_tooltip(_lastZoneLbl, _base_tt + _conf_tt + _post_tt)

// [R4] HTF FIBONACCI PROJECTION — the regime's grid, redrawn on the last bar.
f_htfSwingLevels() =>
    _ph = ta.pivothigh(high, 10, 10)
    _pl = ta.pivotlow(low, 10, 10)
    var float _lastPH = na
    var float _lastPL = na
    if not na(_ph)
        _lastPH := _ph
    if not na(_pl)
        _lastPL := _pl
    [_lastPH, _lastPL]

[htf_ph, htf_pl] = request.security(syminfo.tickerid, mtfConfluenceTf, f_htfSwingLevels(), lookahead=barmerge.lookahead_off)

var int    htfFibDir  = 0
var float  htfFibHigh = na
var float  htfFibLow  = na
if not na(htf_ph) and (na(htfFibHigh) or htf_ph != htfFibHigh)
    htfFibHigh := htf_ph
    if not na(htf_pl)
        htfFibLow := htf_pl
        htfFibDir := -1
if not na(htf_pl) and (na(htfFibLow) or htf_pl != htfFibLow)
    htfFibLow := htf_pl
    if not na(htf_ph)
        htfFibHigh := htf_ph
        htfFibDir := 1

var line[]  htfFibLines  = array.new_line()
var label[] htfFibLabels = array.new_label()

if useHtfFibProj and not na(htfFibHigh) and not na(htfFibLow) and htfFibHigh > htfFibLow and barstate.islast
    if array.size(htfFibLines) > 0
        for i = 0 to array.size(htfFibLines) - 1
            line.delete(array.get(htfFibLines, i))
        for i = 0 to array.size(htfFibLabels) - 1
            label.delete(array.get(htfFibLabels, i))
        array.clear(htfFibLines)
        array.clear(htfFibLabels)
    float rng = htfFibHigh - htfFibLow
    int   lt  = time - 200 * (time - time[1])
    int   rt  = time + 50  * (time - time[1])
    color baseClr = htfFibDir == 1 ? htfFibUpClr : htfFibDnClr
    array<float> retrLvls = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
    array<float> extLvls  = array.from(1.272, 1.414, 1.618, 2.0, 2.618)
    if showHtfFibRetr
        for i = 0 to array.size(retrLvls) - 1
            float lv = array.get(retrLvls, i)
            float y = htfFibDir == 1 ? htfFibHigh - rng * lv : htfFibLow + rng * lv
            line l = line.new(lt, y, rt, y, xloc=xloc.bar_time, color=color.new(baseClr, 30), style=line.style_dashed, width=1)
            label lb = label.new(rt, y, "HTF " + str.tostring(lv, "#.###"), xloc=xloc.bar_time, color=color(na), textcolor=baseClr, style=label.style_label_left, size=size.tiny)
            array.push(htfFibLines, l)
            array.push(htfFibLabels, lb)
    if showHtfFibExt
        for i = 0 to array.size(extLvls) - 1
            float lv = array.get(extLvls, i)
            float y = htfFibDir == 1 ? htfFibLow + rng * lv : htfFibHigh - rng * lv
            line l = line.new(lt, y, rt, y, xloc=xloc.bar_time, color=color.new(baseClr, 55), style=line.style_dotted, width=1)
            label lb = label.new(rt, y, "EXT " + str.tostring(lv, "#.###"), xloc=xloc.bar_time, color=color(na), textcolor=color.new(baseClr, 30), style=label.style_label_left, size=size.tiny)
            array.push(htfFibLines, l)
            array.push(htfFibLabels, lb)

// [S] SIGNAL LOGIC — Tier 2 judgement. FIX 2 adds a confidence gate on CHoCH
// triggers. Trail-flip triggers remain ungated by zone confidence.
bool fib_override_long  = use_fib_soft_override and bull_score >= 7 and trailTrend == 1
bool fib_override_short = use_fib_soft_override and bear_score >= 7 and trailTrend == -1
bool fib_clear_long  = (ltf_gate_long  and htf_gate_long  and fib_band_long  and htf_band_long  and fib_cool_long  and htf_cool_long)  or fib_override_long
bool fib_clear_short = (ltf_gate_short and htf_gate_short and fib_band_short and htf_band_short and fib_cool_short and htf_cool_short) or fib_override_short
bool conf_gate_long  = na(activeZoneConf) or activeZoneConf >= minZoneConfForTrig
bool conf_gate_short = na(activeZoneConf) or activeZoneConf >= minZoneConfForTrig
bool qual_bull = trailTrend == 1  and bull_score >= minScore and ultron_bull_clear and fib_clear_long
bool qual_bear = trailTrend == -1 and bear_score >= minScore and ultron_bear_clear and fib_clear_short
bool trig_bull = (flip_bull or (chochSignal and activeDir == 1 and conf_gate_long)) and qual_bull
bool trig_bear = (flip_bear or (chochSignal and activeDir == -1 and conf_gate_short)) and qual_bear
bool rej_bull  = flip_bull and not trig_bull
bool rej_bear  = flip_bear and not trig_bear

// [T] POSITION TOOL — Tier 3 execution. FIX 3 adds Zone Retest entry mode.
var PositionTool active_pos = na
var int   trade_dir      = 0
var float entry_px       = na
var float initial_risk   = na
var float active_sl      = na
var float tp1_px         = na
var float tp2_px         = na
var float tp3_px         = na
var int   trade_stage    = 0
var bool  last_sl_hit_long  = false
var bool  last_sl_hit_short = false
var float last_exit_price   = na

bool long_entry_signal  = false
bool short_entry_signal = false
bool long_exit_signal   = false
bool short_exit_signal  = false
bool long_tp1_signal    = false
bool long_tp2_signal    = false
bool long_tp3_signal    = false
bool short_tp1_signal   = false
bool short_tp2_signal   = false
bool short_tp3_signal   = false

var int   pending_dir   = 0
var float pending_trail = na
if flip_bull
    pending_dir   := 1
    pending_trail := trail
if flip_bear
    pending_dir   := -1
    pending_trail := trail

var float pendingZoneEntryHigh = na
var float pendingZoneEntryLow  = na
var int   pendingZoneEntryDir  = 0
var int   pendingZoneEntryBar  = na

if chochSignal and not na(_lastZoneLbl)
    pendingZoneEntryHigh := _lastZoneHigh
    pendingZoneEntryLow  := _lastZoneLow
    pendingZoneEntryDir  := _lastZoneDir
    pendingZoneEntryBar  := bar_index

bool _zone_window_open = not na(pendingZoneEntryBar) and bar_index > pendingZoneEntryBar and (bar_index - pendingZoneEntryBar) <= zoneRetestWindow
bool _zone_retest_long  = entry_mode == "Zone Retest" and pendingZoneEntryDir == 1  and _zone_window_open and low  <= pendingZoneEntryHigh and close > pendingZoneEntryLow  and trailTrend == 1
bool _zone_retest_short = entry_mode == "Zone Retest" and pendingZoneEntryDir == -1 and _zone_window_open and high >= pendingZoneEntryLow  and close < pendingZoneEntryHigh and trailTrend == -1

bool retest_bull = entry_mode == "Trail Retest" and pending_dir == 1  and low  <= pending_trail and close >= pending_trail and trig_bull
bool retest_bear = entry_mode == "Trail Retest" and pending_dir == -1 and high >= pending_trail and close <= pending_trail and trig_bear
bool sig_bull    = entry_mode == "Signal Change" and trig_bull
bool sig_bear    = entry_mode == "Signal Change" and trig_bear
bool zone_bull = _zone_retest_long  and qual_bull
bool zone_bear = _zone_retest_short and qual_bear
bool do_bull = sig_bull or retest_bull or zone_bull
bool do_bear = sig_bear or retest_bear or zone_bear
if retest_bull or retest_bear
    pending_dir := 0
if zone_bull or zone_bear
    pendingZoneEntryBar := na

delete_position(PositionTool p) =>
    line.delete(p.entry_line)
    line.delete(p.sl_line)
    line.delete(p.tp1_line)
    line.delete(p.tp2_line)
    line.delete(p.tp3_line)
    label.delete(p.entry_lbl)
    label.delete(p.sl_lbl)
    label.delete(p.tp1_lbl)
    label.delete(p.tp2_lbl)
    label.delete(p.tp3_lbl)
    box.delete(p.risk_box)

if trade_dir == 1
    if trade_stage == 1
        active_sl := trail
    else if trade_stage == 2
        active_sl := math.max(entry_px + be_buffer, trail)
    else if trade_stage == 3
        active_sl := math.max(lock_tp1_at_tp2 ? tp1_px : (entry_px + be_buffer), trail)
    else if trade_stage == 4
        active_sl := math.max(trail, nz(active_sl[1], trail))
    bool sl_hit_long = sl_close_confirm ? (barstate.isconfirmed and close <= active_sl) : (low <= active_sl)
    bool trail_flip_exit_long = barstate.isconfirmed and flip_bear
    if sl_hit_long or trail_flip_exit_long
        long_exit_signal := true
        last_sl_hit_long := sl_hit_long
        last_exit_price  := sl_hit_long ? active_sl : close
        if not na(active_pos)
            delete_position(active_pos)
            active_pos := na
        trade_dir   := 0
        trade_stage := 0
    else
        if trade_stage == 1 and high >= tp1_px
            long_tp1_signal := true
            trade_stage := 2
            active_sl := math.max(entry_px + be_buffer, trail)
        if trade_stage == 2 and high >= tp2_px
            long_tp2_signal := true
            trade_stage := 3
            active_sl := math.max(lock_tp1_at_tp2 ? tp1_px : (entry_px + be_buffer), trail)
        if trade_stage == 3 and high >= tp3_px
            long_tp3_signal := true
            trade_stage := 4
            active_sl := trail
else if trade_dir == -1
    if trade_stage == 1
        active_sl := trail
    else if trade_stage == 2
        active_sl := math.min(entry_px - be_buffer, trail)
    else if trade_stage == 3
        active_sl := math.min(lock_tp1_at_tp2 ? tp1_px : (entry_px - be_buffer), trail)
    else if trade_stage == 4
        active_sl := math.min(trail, nz(active_sl[1], trail))
    bool sl_hit_short = sl_close_confirm ? (barstate.isconfirmed and close >= active_sl) : (high >= active_sl)
    bool trail_flip_exit_short = barstate.isconfirmed and flip_bull
    if sl_hit_short or trail_flip_exit_short
        short_exit_signal := true
        last_sl_hit_short := sl_hit_short
        last_exit_price   := sl_hit_short ? active_sl : close
        if not na(active_pos)
            delete_position(active_pos)
            active_pos := na
        trade_dir   := 0
        trade_stage := 0
    else
        if trade_stage == 1 and low <= tp1_px
            short_tp1_signal := true
            trade_stage := 2
            active_sl := math.min(entry_px - be_buffer, trail)
        if trade_stage == 2 and low <= tp2_px
            short_tp2_signal := true
            trade_stage := 3
            active_sl := math.min(lock_tp1_at_tp2 ? tp1_px : (entry_px - be_buffer), trail)
        if trade_stage == 3 and low <= tp3_px
            short_tp3_signal := true
            trade_stage := 4
            active_sl := trail

if trade_dir == 0 and barstate.isconfirmed
    if do_bull
        trade_dir      := 1
        trade_stage    := 1
        entry_px       := close
        initial_risk   := math.abs(close - trail)
        active_sl      := trail
        tp1_px         := close + initial_risk * tp1_r
        tp2_px         := close + initial_risk * tp2_r
        tp3_px         := close + initial_risk * tp3_r
        long_entry_signal := true
        if show_pos_tool
            int _x1 = bar_index
            int _x2 = bar_index + pos_extend
            active_pos := PositionTool.new(entry_px, trail, tp1_px, tp2_px, tp3_px, true, _x1, line.new(_x1, entry_px, _x2, entry_px, color=LONG_COLOR, style=line.style_dashed), line.new(_x1, trail, _x2, trail, color=color.new(SHORT_COLOR, 30), width=2), line.new(_x1, tp1_px, _x2, tp1_px, color=color.new(LONG_COLOR, 40), style=line.style_dashed), line.new(_x1, tp2_px, _x2, tp2_px, color=color.new(LONG_COLOR, 20), style=line.style_dashed), line.new(_x1, tp3_px, _x2, tp3_px, color=LONG_COLOR, width=2), label.new(_x2, entry_px, "ENTRY " + str.tostring(entry_px, format.mintick), color=na, textcolor=LONG_COLOR, style=label.style_label_left, size=size.small), label.new(_x2, trail, "SL " + str.tostring(trail, format.mintick), color=na, textcolor=color.new(SHORT_COLOR, 30), style=label.style_label_left, size=size.small), label.new(_x2, tp1_px, "TP1 " + str.tostring(tp1_px, format.mintick), color=na, textcolor=color.new(LONG_COLOR, 40), style=label.style_label_left, size=size.small), label.new(_x2, tp2_px, "TP2 " + str.tostring(tp2_px, format.mintick), color=na, textcolor=color.new(LONG_COLOR, 20), style=label.style_label_left, size=size.small), label.new(_x2, tp3_px, "TP3 " + str.tostring(tp3_px, format.mintick), color=na, textcolor=LONG_COLOR, style=label.style_label_left, size=size.small), box.new(_x1, entry_px, _x2, trail, bgcolor=color.new(SHORT_COLOR, 90), border_color=color.new(color.white, 100), border_width=0))
    else if do_bear
        trade_dir      := -1
        trade_stage    := 1
        entry_px       := close
        initial_risk   := math.abs(close - trail)
        active_sl      := trail
        tp1_px         := close - initial_risk * tp1_r
        tp2_px         := close - initial_risk * tp2_r
        tp3_px         := close - initial_risk * tp3_r
        short_entry_signal := true
        if show_pos_tool
            int _x1 = bar_index
            int _x2 = bar_index + pos_extend
            active_pos := PositionTool.new(entry_px, trail, tp1_px, tp2_px, tp3_px, false, _x1, line.new(_x1, entry_px, _x2, entry_px, color=SHORT_COLOR, style=line.style_dashed), line.new(_x1, trail, _x2, trail, color=color.new(SHORT_COLOR, 30), width=2), line.new(_x1, tp1_px, _x2, tp1_px, color=color.new(SHORT_COLOR, 40), style=line.style_dashed), line.new(_x1, tp2_px, _x2, tp2_px, color=color.new(SHORT_COLOR, 20), style=line.style_dashed), line.new(_x1, tp3_px, _x2, tp3_px, color=SHORT_COLOR, width=2), label.new(_x2, entry_px, "ENTRY " + str.tostring(entry_px, format.mintick), color=na, textcolor=SHORT_COLOR, style=label.style_label_left, size=size.small), label.new(_x2, trail, "SL " + str.tostring(trail, format.mintick), color=na, textcolor=color.new(SHORT_COLOR, 30), style=label.style_label_left, size=size.small), label.new(_x2, tp1_px, "TP1 " + str.tostring(tp1_px, format.mintick), color=na, textcolor=color.new(SHORT_COLOR, 40), style=label.style_label_left, size=size.small), label.new(_x2, tp2_px, "TP2 " + str.tostring(tp2_px, format.mintick), color=na, textcolor=color.new(SHORT_COLOR, 20), style=label.style_label_left, size=size.small), label.new(_x2, tp3_px, "TP3 " + str.tostring(tp3_px, format.mintick), color=na, textcolor=SHORT_COLOR, style=label.style_label_left, size=size.small), box.new(_x1, trail, _x2, entry_px, bgcolor=color.new(LONG_COLOR, 90), border_color=color.new(color.white, 100), border_width=0))

if show_pos_tool and not na(active_pos) and trade_dir != 0
    int x2b = bar_index + pos_extend
    active_pos.entry_line.set_x2(x2b)
    active_pos.sl_line.set_x2(x2b)
    active_pos.tp1_line.set_x2(x2b)
    active_pos.tp2_line.set_x2(x2b)
    active_pos.tp3_line.set_x2(x2b)
    active_pos.risk_box.set_right(x2b)
    active_pos.entry_lbl.set_x(x2b)
    active_pos.sl_lbl.set_x(x2b)
    active_pos.tp1_lbl.set_x(x2b)
    active_pos.tp2_lbl.set_x(x2b)
    active_pos.tp3_lbl.set_x(x2b)
    if not na(active_sl)
        active_pos.sl := active_sl
        active_pos.sl_line.set_y1(active_sl)
        active_pos.sl_line.set_y2(active_sl)
        active_pos.sl_lbl.set_y(active_sl)
        active_pos.sl_lbl.set_text("SL " + str.tostring(active_sl, format.mintick))
        if active_pos.is_bull
            active_pos.risk_box.set_bottom(active_sl)
        else
            active_pos.risk_box.set_top(active_sl)

// [T2] EXECUTION ENGINE — broker-agnostic. Multiplier caps display-only.
bool is_options_mode = exec_mode == EXEC_VANILLA
bool is_mult_mode    = exec_mode == EXEC_MULT
bool is_signal_only  = exec_mode == EXEC_SIGNAL
bool is_execution_mode = is_options_mode or is_mult_mode
string LONG_TAG  = is_options_mode ? "CALL" : "BUY"
string SHORT_TAG = is_options_mode ? "PUT"  : "SELL"
string deriv_class  = deriv_asset_class()
int    deriv_cap    = deriv_max_mult(deriv_class)
bool   deriv_dc_ok  = deriv_dc_available(deriv_class)
float raw_mult = mult_preset == "Conservative" ? 50.0 : mult_preset == "Balanced" ? 100.0 : mult_preset == "Aggressive" ? 300.0 : suggested_mult
bool  deriv_capped  = raw_mult > deriv_cap
float resolved_mult = deriv_capped ? deriv_cap : raw_mult
string broker_cap_label = broker_mode == "Deriv" ? str.tostring(deriv_cap) + "x cap" : broker_mode == "Bybit" ? "leverage N/A" : "—"
string broker_full      = broker_mode + " · " + deriv_class + " · " + broker_cap_label + " · " + str.tostring(resolved_mult, "#") + "x" + (deriv_capped ? " ⚠️" : "")
float exec_atr        = ta.atr(trail_atr_len)
float strike_atm      = close
float strike_call_itm = close - exec_atr * itm_mult
float strike_call_otm = close + exec_atr * otm_mult
float strike_put_itm  = close + exec_atr * itm_mult
float strike_put_otm  = close - exec_atr * otm_mult
float call_strike = na
float put_strike  = na
if is_options_mode
    if strike_mode == "ATM"
        call_strike := strike_atm
        put_strike  := strike_atm
    else if strike_mode == "ITM"
        call_strike := strike_call_itm
        put_strike  := strike_put_itm
    else if strike_mode == "OTM"
        call_strike := strike_call_otm
        put_strike  := strike_put_otm
    else
        call_strike := bull_score >= 7 and ultron_bull_clear ? strike_call_otm : bull_score >= 5 ? strike_atm : strike_call_itm
        put_strike  := bear_score >= 7 and ultron_bear_clear ? strike_put_otm  : bear_score >= 5 ? strike_atm : strike_put_itm
float exec_tf_min  = timeframe.in_seconds(timeframe.period) / 60.0
float exec_trend   = math.abs(bull_score - bear_score) / 8.0
float exec_vol     = math.min(exec_atr / close * 1000.0, 5.0)
int   rec_expiry   = int(math.round(exec_tf_min * expiry_base * (1.0 + exec_trend * 2.0 + exec_vol)))
rec_expiry := math.max(min_expiry, math.min(max_expiry, rec_expiry))
var int   opt_posState     = 0
var int   opt_scaleCount   = 0
var float opt_activeStrike = na
var int   opt_entryBar     = na
bool scale_in_call = opt_posState == 1  and newSmartBull and trailTrend == 1  and opt_scaleCount < max_scale_ins
bool scale_in_put  = opt_posState == -1 and newSmartBear and trailTrend == -1 and opt_scaleCount < max_scale_ins
bool regime_call_exit = opt_posState == 1  and (flip_bear or (chochSignal and activeDir == -1))
bool regime_put_exit  = opt_posState == -1 and (flip_bull or (chochSignal and activeDir == 1))
if long_entry_signal and opt_posState != 1
    opt_posState     := 1
    opt_scaleCount   := 1
    opt_activeStrike := nz(call_strike, entry_px)
    opt_entryBar     := bar_index
else if short_entry_signal and opt_posState != -1
    opt_posState     := -1
    opt_scaleCount   := 1
    opt_activeStrike := nz(put_strike, entry_px)
    opt_entryBar     := bar_index
else if scale_in_call or scale_in_put
    opt_scaleCount += 1
else if regime_call_exit or regime_put_exit
    opt_posState     := 0
    opt_scaleCount   := 0
    opt_activeStrike := na

build_signal_tooltip(bool isBull) =>
    int sc = isBull ? bull_score : bear_score
    string mode = is_options_mode ? "Vanilla" : is_mult_mode ? "Multipliers" : "Signal Only"
    string head = isBull ? (is_options_mode ? "CALL" : "BUY") : (is_options_mode ? "PUT" : "SELL")
    string why = "WHY\n"
    if w_hull
        why += (isBull and hull_bull) or (not isBull and hull_bear) ? "✓ Macro Hull\n" : "✗ Macro Hull\n"
    if w_fast
        why += (isBull and fast_bull) or (not isBull and fast_bear) ? "✓ Fast Hull\n" : "✗ Fast Hull\n"
    if w_trail
        why += (isBull and trailTrend == 1) or (not isBull and trailTrend == -1) ? "✓ Trail\n" : "✗ Trail\n"
    if w_choch
        why += chochActive and ((isBull and activeDir == 1) or (not isBull and activeDir == -1)) ? "✓ CHoCH\n" : "· CHoCH\n"
    if w_aoi
        why += in_aoi and ((isBull and activeDir == 1) or (not isBull and activeDir == -1)) ? "✓ AOI\n" : "· Not AOI\n"
    if w_mom
        why += (isBull and mom_bull) or (not isBull and mom_bear) ? "✓ Momentum\n" : "✗ Momentum\n"
    if w_ult
        why += (isBull and ultron_bull_clear) or (not isBull and ultron_bear_clear) ? "✓ Ultron Gate\n" : "✗ Ultron Gate\n"
    if w_vol
        why += vol_ok ? "✓ Volume\n" : "· Volume low\n"
    string fibline = "FIB\n"
    fibline += "Source: " + htf_fib_mode + " | HTF: " + resolved_htf + "\n"
    fibline += "LTF: " + (trend_fib == 1 ? "BULL" : trend_fib == -1 ? "BEAR" : "FLAT") + " (" + str.tostring(fib_bars_since_flip) + "b)\n"
    fibline += "HTF: " + (htf_trend_fib == 1 ? "BULL" : htf_trend_fib == -1 ? "BEAR" : "FLAT") + " (" + str.tostring(htf_bars_since_flip) + "b)\n"
    fibline += "Gate L: " + (fib_clear_long ? "PASS" : "BLOCK") + " | S: " + (fib_clear_short ? "PASS" : "BLOCK") + "\n"
    fibline += "POSTERIOR\n"
    fibline += "Posterior(Bull): " + str.tostring(posterior_bull * 100.0, "#.#") + "%  |  Posterior(Bear): " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
    fibline += "Edge: " + str.tostring(prob_edge * 100.0, "#.#") + "%  |  Zone Conf: " + (na(activeZoneConf) ? "—" : str.tostring(activeZoneConf * 100.0, "#") + "%") + "\n"
    string exec = ""
    if is_options_mode
        float cs = isBull ? nz(call_strike, close) : nz(put_strike, close)
        exec := "VANILLA\nStrike: " + _p(cs) + " (" + strike_mode + ")\nDist: " + f_dist_str(math.abs(cs - close)) + "\nExpiry: " + str.tostring(rec_expiry) + " min\n"
    else if is_mult_mode
        exec := "MULTIPLIER\nContract: " + deriv_mult_contract(isBull) + " (" + broker_mode + " · " + deriv_class + ")\nMultiplier: " + str.tostring(resolved_mult, "#") + "x" + (deriv_capped ? " CAPPED" : "") + "\nRisk: $" + str.tostring(risk_amount, "#.##") + "\n"
    else
        exec := "SIGNAL ONLY\n"
    float riskPts = math.abs(trail - close)
    float tp1_proj = isBull ? close + riskPts * tp1_r : close - riskPts * tp1_r
    float tp2_proj = isBull ? close + riskPts * tp2_r : close - riskPts * tp2_r
    float tp3_proj = isBull ? close + riskPts * tp3_r : close - riskPts * tp3_r
    string rr = "RR\nSL: " + _p(trail) + " (" + f_dist_str(riskPts) + ")\nTP1: " + _p(tp1_proj) + " (" + str.tostring(tp1_r, "#.#") + "R)\nTP2: " + _p(tp2_proj) + " (" + str.tostring(tp2_r, "#.#") + "R)\nTP3: " + _p(tp3_proj) + " (" + str.tostring(tp3_r, "#.#") + "R)\n"
    string ctx = "CONTEXT\nKZ: " + activeKz + "\nTime: " + _fmt_full_time(time) + " " + gmt_tz + "\n" + build_chart_link()
    head + " — Score " + str.tostring(sc) + "/8\nMode: " + mode + "\n" + exec + rr + fibline + why + ctx

build_trade_entry_tooltip(bool isBull, float p_entry, float p_sl, float p_tp1, float p_tp2, float p_tp3, float p_risk) =>
    float tp1Pts = math.abs(p_tp1 - p_entry)
    float tp2Pts = math.abs(p_tp2 - p_entry)
    float tp3Pts = math.abs(p_tp3 - p_entry)
    string out = (is_options_mode ? (isBull ? "CALL" : "PUT") : (isBull ? "LONG" : "SHORT")) + " ENTRY — " + exec_mode + "\n"
    out += "Score: " + str.tostring(isBull ? bull_score : bear_score) + "/8\n"
    out += "Posterior: Posterior(Bull) " + str.tostring(posterior_bull * 100.0, "#.#") + "% / Posterior(Bear) " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
    out += "Entry Mode: " + entry_mode + "\n"
    out += "Entry: " + _p(p_entry) + "\n"
    out += "SL: " + _p(p_sl) + " → " + f_dist_str(p_risk) + "\n"
    out += "TP1 (" + str.tostring(tp1_r, "#.#") + "R): " + _p(p_tp1) + " → " + f_dist_str(tp1Pts) + "\n"
    out += "TP2 (" + str.tostring(tp2_r, "#.#") + "R): " + _p(p_tp2) + " → " + f_dist_str(tp2Pts) + "\n"
    out += "TP3 (" + str.tostring(tp3_r, "#.#") + "R): " + _p(p_tp3) + " → " + f_dist_str(tp3Pts) + "\n"
    if is_options_mode
        out += "Strike: " + _p(isBull ? nz(call_strike, close) : nz(put_strike, close)) + " Expiry: " + str.tostring(rec_expiry) + "m\n"
    else if is_mult_mode
        out += "Direction: " + deriv_mult_contract(isBull) + " Multiplier: " + str.tostring(resolved_mult, "#") + "x\nRisk: $" + str.tostring(risk_amount, "#.##") + "\n"
    out

// [U] VISUALS
Fi1 = plot(HULL, title="Macro Hull", color=color.new(hullColor, 50), linewidth=thicknesSwitch)
Fi2 = plot(visualSwitch ? HULL[2] : na, title="Macro Hull Band", color=color.new(hullColor, 50), linewidth=thicknesSwitch)
fill(Fi1, Fi2, title="Hull Band", color=color.new(hullColor, transpSwitch))
plot(HULL_FAST, "Fast Hull", color=color.new(LONG_COLOR, 40), linewidth=1)
plot(showFibBands ? u1_v : na, "Fib U1", color=color.new(SHORT_COLOR, 60), style=plot.style_linebr)
plot(showFibBands ? u4_v : na, "Fib U4", color=color.new(SHORT_COLOR, 30), style=plot.style_linebr)
plot(showFibBands ? l1_v : na, "Fib L1", color=color.new(LONG_COLOR, 60), style=plot.style_linebr)
plot(showFibBands ? l4_v : na, "Fib L4", color=color.new(LONG_COLOR, 30), style=plot.style_linebr)
p_trail = plot(trailTrend != trailTrend[1] ? na : trail, "Trail", color=trend_col, linewidth=2, style=plot.style_linebr)
p_ma    = plot(hMa, "Trail MA", color=color.new(trend_col, 100))
fill(p_trail, p_ma, trail, hMa, color.new(trend_col, 85), color.new(trend_col, 96), "Trend Cloud")
plotshape(showRawFlip and flip_bull ? trail : na, "Raw Buy",  shape.diamond, location.absolute, trail_gray ? color.gray : LONG_COLOR, size=size.tiny)
plotshape(showRawFlip and flip_bear ? trail : na, "Raw Sell", shape.diamond, location.absolute, trail_gray ? color.gray : SHORT_COLOR, size=size.tiny)
plotshape(showRejected and rej_bull ? trail : na, "Rej Bull", shape.xcross, location.absolute, color.new(color.gray, 20), size=size.tiny)
plotshape(showRejected and rej_bear ? trail : na, "Rej Bear", shape.xcross, location.absolute, color.new(color.gray, 20), size=size.tiny)
float sig_offset_px = hAtr * signalOffset
bool  fire_bull_label = (label_all_flips and flip_bull) or (not label_all_flips and trig_bull)
bool  fire_bear_label = (label_all_flips and flip_bear) or (not label_all_flips and trig_bear)
if showSignals and fire_bull_label
    label.new(bar_index, low - sig_offset_px, LONG_TAG, color = LONG_COLOR, textcolor = color.white, style = label.style_label_up, size = size.tiny, tooltip = build_signal_tooltip(true))
if showSignals and fire_bear_label
    label.new(bar_index, high + sig_offset_px, SHORT_TAG, color = SHORT_COLOR, textcolor = color.white, style = label.style_label_down, size = size.tiny, tooltip = build_signal_tooltip(false))
if showSignals and long_entry_signal
    label.new(bar_index, entry_px, is_options_mode ? "CALL ENTRY" : "LONG ENTRY", color = color.new(LONG_COLOR, 15), textcolor = color.white, style = label.style_label_left, size = size.tiny, tooltip = build_trade_entry_tooltip(true, entry_px, active_sl, tp1_px, tp2_px, tp3_px, initial_risk))
if showSignals and short_entry_signal
    label.new(bar_index, entry_px, is_options_mode ? "PUT ENTRY" : "SHORT ENTRY", color = color.new(SHORT_COLOR, 15), textcolor = color.white, style = label.style_label_left, size = size.tiny, tooltip = build_trade_entry_tooltip(false, entry_px, active_sl, tp1_px, tp2_px, tp3_px, initial_risk))
plotshape(showSmartSignals and newSmartBull, "Smart Bull", shape.triangleup, location.belowbar, LONG_COLOR, size=size.tiny, text="Smart")
plotshape(showSmartSignals and newSmartBear, "Smart Bear", shape.triangledown, location.abovebar, SHORT_COLOR, size=size.tiny, text="Smart")
plotshape(showSmartSignals and showRejectedSmart and rejectedBull, "SB Rej", shape.triangleup, location.belowbar, color.new(color.gray, 50), size=size.tiny)
plotshape(showSmartSignals and showRejectedSmart and rejectedBear, "SBe Rej", shape.triangledown, location.abovebar, color.new(color.gray, 50), size=size.tiny)

// [V] SMC EXECUTION
if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()
    if showHighLowSwingsInput
        drawHighLowSwings()
    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()
if showFairValueGapsInput
    deleteFairValueGaps()
getCurrentStructure(swingsLengthInput, false)
getCurrentStructure(5, false, true)
if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput, true)
if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    displayStructure(true)
if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()
if showInternalOrderBlocksInput
    deleteOrderBlocks(true)
if showSwingOrderBlocksInput
    deleteOrderBlocks()
if showFairValueGapsInput
    drawFairValueGaps()
if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)
    if showSwingOrderBlocksInput
        drawOrderBlocks()
lastBarIndex    := currentBarIndex
currentBarIndex := bar_index

// [W] HUD — ULTRON's self-portrait
string hudTextSize = f_labelSize(hudSizeIn)
var table dash = table.new(position.top_right, 2, 24, bgcolor=color.rgb(0, 0, 0, 80), border_width=1, border_color=color.silver, frame_width=1, frame_color=color.silver)
if barstate.islast and showHud
    table.cell(dash, 0, 0, "Absolute Dollar Agent", text_color=color.yellow, bgcolor=color.rgb(0, 0, 255, 50), text_size=hudTextSize)
    table.cell(dash, 1, 0, "ULTRON ALPHA", text_color=color.yellow, bgcolor=color.rgb(0, 0, 255, 50), text_size=hudTextSize)
    table.cell(dash, 0, 1, "Bull Score", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 1, str.tostring(bull_score) + " / 8", text_color=color.white, bgcolor=bull_score >= minScore ? LONG_COLOR : color.rgb(50,50,50), text_size=hudTextSize)
    table.cell(dash, 0, 2, "Bear Score", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 2, str.tostring(bear_score) + " / 8", text_color=color.white, bgcolor=bear_score >= minScore ? SHORT_COLOR : color.rgb(50,50,50), text_size=hudTextSize)
    string trailState = trail_gray ? "GRAY" : (trailTrend == 1 ? "BULL" : "BEAR")
    color  trailCellColor = trail_gray ? color.gray : (trailTrend == 1 ? LONG_COLOR : SHORT_COLOR)
    table.cell(dash, 0, 3, "Trail", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 3, trailState, text_color=color.white, bgcolor=trailCellColor, text_size=hudTextSize)
    table.cell(dash, 0, 4, "Ultron Gate", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 4, ultron_bull_clear ? "BULL" : ultron_bear_clear ? "BEAR" : "LOCKED", text_color=color.white, bgcolor=ultron_bull_clear ? LONG_COLOR : ultron_bear_clear ? SHORT_COLOR : color.gray, text_size=hudTextSize)
    string smcBiasStr   = swingTrend.bias == BULLISH ? "Bullish" : swingTrend.bias == BEARISH ? "Bearish" : "Neutral"
    color  smcBiasColor = swingTrend.bias == BULLISH ? LONG_COLOR : swingTrend.bias == BEARISH ? SHORT_COLOR : color.gray
    table.cell(dash, 0, 5, "SMC Bias", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 5, smcBiasStr, text_color=color.white, bgcolor=smcBiasColor, text_size=hudTextSize)
    table.cell(dash, 0, 6, "RSI", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 6, str.tostring(math.round(rsi, 0)) + " " + (smartBull_raw ? "B" : smartBear_raw ? "S" : "-"), text_color=color.white, bgcolor=smartBull_raw ? LONG_COLOR : smartBear_raw ? SHORT_COLOR : color.gray, text_size=hudTextSize)
    string smartState = newSmartBull ? "Smart Bull" : newSmartBear ? "Smart Bear" : (rejectedBull or rejectedBear) ? "Gated" : "—"
    color  smartBg    = newSmartBull ? LONG_COLOR : newSmartBear ? SHORT_COLOR : color.gray
    table.cell(dash, 0, 7, "Smart Signal", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 7, smartState, text_color=color.white, bgcolor=smartBg, text_size=hudTextSize)
    table.cell(dash, 0, 8, "EMA 21/55", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 8, ema21 > ema55 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=ema21 > ema55 ? LONG_COLOR : SHORT_COLOR, text_size=hudTextSize)
    table.cell(dash, 0, 9, "Active KZ", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 9, activeKz, text_color=color.white, bgcolor=color.navy, text_size=hudTextSize)
    table.cell(dash, 0, 10, "PDH", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 10, not na(d_info.ph) ? str.tostring(d_info.ph, format.mintick) : "—", text_color=color.white, bgcolor=not na(d_info.ph) and close > d_info.ph ? LONG_COLOR : SHORT_COLOR, text_size=hudTextSize)
    table.cell(dash, 0, 11, "PDL", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 11, not na(d_info.pl) ? str.tostring(d_info.pl, format.mintick) : "—", text_color=color.white, bgcolor=not na(d_info.pl) and close < d_info.pl ? SHORT_COLOR : LONG_COLOR, text_size=hudTextSize)
    string swHighLabel = swingTrend.bias == BEARISH ? "Strong High" : "Weak High"
    string swLowLabel  = swingTrend.bias == BULLISH ? "Strong Low"  : "Weak Low"
    color  swHighColor = swingTrend.bias == BEARISH ? SHORT_COLOR : color.new(SHORT_COLOR, 40)
    color  swLowColor  = swingTrend.bias == BULLISH ? LONG_COLOR : color.new(LONG_COLOR, 40)
    table.cell(dash, 0, 12, "S/W High", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 12, not na(trailing.top) ? str.tostring(trailing.top, format.mintick) + " " + swHighLabel : "—", text_color=color.white, bgcolor=swHighColor, text_size=hudTextSize)
    table.cell(dash, 0, 13, "S/W Low", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 13, not na(trailing.bottom) ? str.tostring(trailing.bottom, format.mintick) + " " + swLowLabel : "—", text_color=color.white, bgcolor=swLowColor, text_size=hudTextSize)
    string spatialBias  = "NEUTRAL"
    color  spatialColor = color.gray
    if not na(d_info.ph) and not na(d_info.pl)
        float midRange = (d_info.ph + d_info.pl) / 2
        if close > d_info.ph
            spatialBias := "ABOVE PDH"
            spatialColor := LONG_COLOR
        else if close < d_info.pl
            spatialBias := "BELOW PDL"
            spatialColor := SHORT_COLOR
        else if close > midRange
            spatialBias := "UPPER HALF"
            spatialColor := color.new(LONG_COLOR, 40)
        else
            spatialBias := "LOWER HALF"
            spatialColor := color.new(SHORT_COLOR, 40)
    table.cell(dash, 0, 14, "Spatial Bias", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 14, spatialBias, text_color=color.white, bgcolor=spatialColor, text_size=hudTextSize)
    table.cell(dash, 0, 15, "Position", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    string posStr = trade_dir == 0 ? "No Active" : (trade_dir == 1 ? "LONG S" + str.tostring(trade_stage) + "/4" : "SHORT S" + str.tostring(trade_stage) + "/4")
    color  posBg  = trade_dir == 0 ? color.gray : (trade_dir == 1 ? LONG_COLOR : SHORT_COLOR)
    table.cell(dash, 1, 15, posStr, text_color=color.white, bgcolor=posBg, text_size=hudTextSize)
    table.cell(dash, 0, 16, "Exec Mode", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    string execStr = is_options_mode ? "Vanilla" : is_mult_mode ? "Mult " + str.tostring(resolved_mult, "#") + "x" : "Signal"
    color  execBg  = is_options_mode ? color.navy : is_mult_mode ? color.teal : color.gray
    table.cell(dash, 1, 16, execStr, text_color=color.white, bgcolor=execBg, text_size=hudTextSize)
    table.cell(dash, 0, 17, "Broker/Asset", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 17, broker_full, text_color=color.white, bgcolor=deriv_capped and broker_mode == "Deriv" ? color.orange : color.teal, text_size=hudTextSize)
    table.cell(dash, 0, 18, "Fib Regime", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    string ltfStr = trend_fib == 1 ? "B" : trend_fib == -1 ? "S" : "-"
    string htfStr = htf_trend_fib == 1 ? "B" : htf_trend_fib == -1 ? "S" : "-"
    string fibStr = "LTF " + ltfStr + " | " + resolved_htf + " " + htfStr + " | L:" + (fib_clear_long ? "OK" : "X") + " S:" + (fib_clear_short ? "OK" : "X")
    color  fibRowBg = htf_trend_fib == 1 and trend_fib == 1 ? LONG_COLOR : htf_trend_fib == -1 and trend_fib == -1 ? SHORT_COLOR : color.gray
    table.cell(dash, 1, 18, fibStr, text_color=color.white, bgcolor=fibRowBg, text_size=hudTextSize)
    table.cell(dash, 0, 19, "Posterior(Bull)", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 19, str.tostring(posterior_bull * 100.0, "#.#") + "%", text_color=color.white, bgcolor=posterior_bull >= probSignalFloor ? LONG_COLOR : posterior_bull >= 0.55 ? color.new(LONG_COLOR, 40) : color.rgb(50,50,50), text_size=hudTextSize)
    table.cell(dash, 0, 20, "Posterior(Bear)", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 20, str.tostring(posterior_bear * 100.0, "#.#") + "%", text_color=color.white, bgcolor=posterior_bear >= probSignalFloor ? SHORT_COLOR : posterior_bear >= 0.55 ? color.new(SHORT_COLOR, 40) : color.rgb(50,50,50), text_size=hudTextSize)
    table.cell(dash, 0, 21, "Prob Edge", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    table.cell(dash, 1, 21, str.tostring(prob_edge * 100.0, "#.#") + "%", text_color=color.white, bgcolor=prob_edge >= 0.30 ? color.teal : prob_edge >= 0.15 ? color.navy : color.gray, text_size=hudTextSize)
    table.cell(dash, 0, 22, "Zone Confidence", text_color=color.white, bgcolor=color.black, text_size=hudTextSize)
    string zcStr = na(activeZoneConf) ? "—" : str.tostring(activeZoneConf * 100.0, "#") + "% " + (activeZoneConf >= 0.75 ? "H" : activeZoneConf >= 0.50 ? "M" : activeZoneConf >= 0.25 ? "L" : "-")
    color  zcBg  = na(activeZoneConf) ? color.gray : activeZoneConf >= 0.75 ? color.yellow : activeZoneConf >= 0.50 ? color.orange : color.new(color.gray, 30)
    table.cell(dash, 1, 22, zcStr, text_color=color.white, bgcolor=zcBg, text_size=hudTextSize)
    table.cell(dash, 0, 23, "ADI Neural Spatial Engine", text_color=color.new(color.white, 70), bgcolor=color(na), text_size=hudTextSize)
    table.cell(dash, 1, 23, "ULTRON Alpha", text_color=color.new(color.white, 70), bgcolor=color(na), text_size=hudTextSize)

// [X] TELEGRAM AGENT — ULTRON's narration. Five families: analysis report,
// neural trigger, informational, fib-blocked, trade event. Consolidated
// dispatch ensures at most ONE message per bar (trade events take priority).
build_analysis_report() =>
    string out = ""
    out += "ULTRON ANALYSIS\n"
    out += _fmt_full_time(time) + " " + gmt_tz + "\n"
    out += syminfo.ticker + " @ " + _p(close) + "\n"
    out += "Mode: " + exec_mode + " | Broker: " + broker_mode + "\n"
    out += "Asset Class: " + deriv_class + "\n"
    out += build_chart_link() + "\n\n"
    out += "MACRO PRE-FLIGHT\n"
    string smcBiasTxt = swingTrend.bias == BULLISH ? "BULLISH" : swingTrend.bias == BEARISH ? "BEARISH" : "NEUTRAL"
    out += "SMC Bias: " + smcBiasTxt + " (CHoCH Confirmed)\n"
    out += "Active KZ: " + activeKz + "\n"
    out += "Macro Hull: " + (hull_bull ? "BULLISH" : hull_bear ? "BEARISH" : "FLAT") + "\n"
    out += "Ultron Gate: " + (ultron_bull_clear ? "BULL UNLOCKED" : ultron_bear_clear ? "BEAR UNLOCKED" : "LOCKED") + "\n"
    out += "Trail: " + (trail_gray ? "GRAY" : trailTrend == 1 ? "BULLISH" : "BEARISH") + " (" + _p(trail) + ")\n\n"
    out += "SPATIAL INTELLIGENCE\n"
    out += "Strong High: " + (not na(trailing.top) ? _p(trailing.top) : "—") + "\n"
    out += "Strong Low: " + (not na(trailing.bottom) ? _p(trailing.bottom) : "—") + "\n"
    out += "PDH: " + (not na(d_info.ph) ? _p(d_info.ph) : "—") + " | PDL: " + (not na(d_info.pl) ? _p(d_info.pl) : "—") + "\n"
    out += "Nearest H-LIQ: " + (not na(nearestH_lq) ? _p(nearestH_lq) : "—") + "\n"
    out += "Nearest L-LIQ: " + (not na(nearestL_lq) ? _p(nearestL_lq) : "—") + "\n"
    out += "Active CHoCH Zone: " + (chochActive ? _p(curZoneHigh) + " - " + _p(curZoneLow) : "None") + "\n\n"
    out += "NEURAL CONFLUENCE (8 NODES)\n"
    out += "Bull Score: " + str.tostring(bull_score) + " / 8  " + (bull_score >= minScore ? "(TRIGGERED)" : "(BLOCKED)") + "\n"
    out += "Bear Score: " + str.tostring(bear_score) + " / 8  " + (bear_score >= minScore ? "(TRIGGERED)" : "(BLOCKED)") + "\n\n"
    out += "SPECULATIVE PROBABILISTIC CORE (14 NODES)\n"
    out += "Posterior(Bull): " + str.tostring(posterior_bull * 100.0, "#.#") + "%" + (posterior_bull >= probSignalFloor ? " HIGH CONVICTION" : "") + "\n"
    out += "Posterior(Bear): " + str.tostring(posterior_bear * 100.0, "#.#") + "%" + (posterior_bear >= probSignalFloor ? " HIGH CONVICTION" : "") + "\n"
    out += "Prob Edge: " + str.tostring(prob_edge * 100.0, "#.#") + "%\n"
    out += "Zone Confidence: " + (na(activeZoneConf) ? "—" : str.tostring(activeZoneConf * 100.0, "#") + "%") + "\n"
    out += "Zone Quality Gate: " + (useZoneQuality ? "ON (min " + str.tostring(minZoneAtr, "#.#") + " ATR, ext " + str.tostring(extAtrGuard, "#.#") + " ATR)" : "OFF") + "\n\n"
    out += "FIB INTELLIGENCE (" + htf_fib_mode + ")\n"
    out += "HTF: " + resolved_htf + "\n"
    out += "LTF regime: " + (trend_fib == 1 ? "BULL" : trend_fib == -1 ? "BEAR" : "FLAT") + " | " + str.tostring(fib_bars_since_flip) + "b since flip\n"
    out += "HTF regime: " + (htf_trend_fib == 1 ? "BULL" : htf_trend_fib == -1 ? "BEAR" : "FLAT") + " | " + str.tostring(htf_bars_since_flip) + "b since flip\n"
    out += "Gate: Long " + (fib_clear_long ? "PASS" : "BLOCKED") + " | Short " + (fib_clear_short ? "PASS" : "BLOCKED") + "\n"
    if fib_override_long or fib_override_short
        out += "Soft override (score ≥ 7)\n"
    out += "\n"
    if is_execution_mode
        out += "EXECUTION CONTEXT\n"
        if is_options_mode
            out += "Product: Vanilla Options\n"
            out += "Strike Mode: " + strike_mode + "\n"
            out += "CALL Strike: " + (not na(call_strike) ? _p(call_strike) : "—") + "\n"
            out += "PUT Strike: " + (not na(put_strike) ? _p(put_strike) : "—") + "\n"
            out += "Suggested Expiry: " + str.tostring(rec_expiry) + " min\n"
            out += "Scale-Ins Max: " + str.tostring(max_scale_ins) + " (used " + str.tostring(opt_scaleCount) + ")\n"
        else
            out += "Product: Multipliers\n"
            out += "Broker: " + broker_mode + " | Asset Class: " + deriv_class + "\n"
            out += "Preset: " + mult_preset + (deriv_capped and broker_mode == "Deriv" ? " [CLAMPED cap " + str.tostring(deriv_cap) + "x]" : "") + "\n"
            out += "Suggested Multiplier: " + str.tostring(resolved_mult, "#") + "x\n"
            out += "Risk per Trade: $" + str.tostring(risk_amount, "#.##") + "\n"
            out += "Contract Map: Long→" + deriv_mult_contract(true) + " | Short→" + deriv_mult_contract(false) + "\n"
            if suggest_deal_cancel and broker_mode == "Deriv" and deriv_dc_ok
                out += "Deal Cancellation: AVAILABLE\n"
            else if suggest_deal_cancel and broker_mode == "Deriv" and not deriv_dc_ok
                out += "Deal Cancellation: NOT supported on " + deriv_class + "\n"
        out += "\n"
    out += "EXECUTION & SIGNALS\n"
    out += "Entry Mode: " + entry_mode + "\n"
    out += "Raw Trail Flip: " + (flip_bull ? "BULLISH" : flip_bear ? "BEARISH" : "—") + "\n"
    out += "Smart Signal: " + (newSmartBull ? "Bull" : newSmartBear ? "Bear" : (rejectedBull or rejectedBear) ? "Gated" : "—") + "\n"
    out += "Neural Trigger: " + (trig_bull ? LONG_TAG + " TRIGGERED" : trig_bear ? SHORT_TAG + " TRIGGERED" : "—") + "\n\n"
    if trade_dir != 0
        out += "ACTIVE POSITION\n"
        out += "Dir: " + (trade_dir == 1 ? (is_options_mode ? "CALL" : "LONG") : (is_options_mode ? "PUT" : "SHORT")) + " | Stage: " + str.tostring(trade_stage) + "/4\n"
        out += "Entry: " + _p(entry_px) + " | SL: " + _p(active_sl) + "\n"
        float riskPts = math.abs(entry_px - active_sl)
        out += "Risk: " + f_dist_str(riskPts) + "\n"
        out += "TP1: " + _p(tp1_px) + " (" + f_rr_str(tp1_r, math.abs(tp1_px - entry_px)) + ")" + (trade_stage >= 2 ? " HIT" : "") + "\n"
        out += "TP2: " + _p(tp2_px) + " (" + f_rr_str(tp2_r, math.abs(tp2_px - entry_px)) + ")" + (trade_stage >= 3 ? " HIT" : "") + "\n"
        out += "TP3: " + _p(tp3_px) + " (" + f_rr_str(tp3_r, math.abs(tp3_px - entry_px)) + ")" + (trade_stage >= 4 ? " HIT" : "") + "\n"
        float price_move = trade_dir == 1 ? close - entry_px : entry_px - close
        float open_r     = price_move / nz(initial_risk, 1)
        out += "Live P&L: " + f_rr_str(open_r, price_move) + "\n\n"
    out += "RECENT EVENTS (Episodic Memory)\n"
    int mem_count = math.min(array.size(mem_event), 10)
    if mem_count == 0
        out += "No events recorded yet.\n"
    if mem_count > 0
        for i = 0 to mem_count - 1
            int idx = array.size(mem_event) - 1 - i
            int dir_val = array.get(mem_dir, idx)
            out += _fmt_time(array.get(mem_time, idx)) + " " + (dir_val == 1 ? "+" : dir_val == -1 ? "-" : "·") + " " + array.get(mem_event, idx) + " @ " + _p(array.get(mem_level, idx)) + "\n"
    out

build_neural_trigger_alert(bool isBull) =>
    int sc = isBull ? bull_score : bear_score
    string tag = isBull ? LONG_TAG : SHORT_TAG
    string out = "NEURAL " + tag + " SIGNAL\n"
    out += syminfo.ticker + " @ " + _p(close) + "\n"
    out += "Score: " + str.tostring(sc) + "/8 (min " + str.tostring(minScore) + ")\n"
    out += "Mode: " + exec_mode + " | Broker: " + broker_mode + "\n"
    if is_options_mode
        float cs = isBull ? nz(call_strike, close) : nz(put_strike, close)
        out += "Strike: " + _p(cs) + " (" + strike_mode + ")\n"
        out += "Strike Dist: " + f_dist_str(math.abs(cs - close)) + "\n"
        out += "Expiry: " + str.tostring(rec_expiry) + " min\n"
    else if is_mult_mode
        out += "Contract: " + deriv_mult_contract(isBull) + " @ " + str.tostring(resolved_mult, "#") + "x" + (deriv_capped and broker_mode == "Deriv" ? " [CLAMPED]" : "") + "\n"
        out += "Risk: $" + str.tostring(risk_amount, "#.##") + "\n"
    out += "WHY\n"
    out += (isBull and hull_bull) or (not isBull and hull_bear) ? "✓ Macro Hull\n" : "✗ Macro Hull\n"
    out += (isBull and fast_bull) or (not isBull and fast_bear) ? "✓ Fast Hull\n" : "✗ Fast Hull\n"
    out += (isBull and trailTrend == 1) or (not isBull and trailTrend == -1) ? "✓ Trail\n" : "✗ Trail\n"
    out += chochActive and ((isBull and activeDir == 1) or (not isBull and activeDir == -1)) ? "✓ CHoCH\n" : "· CHoCH inactive\n"
    out += (isBull and mom_bull) or (not isBull and mom_bear) ? "✓ Momentum\n" : "✗ Momentum\n"
    out += (isBull and ultron_bull_clear) or (not isBull and ultron_bear_clear) ? "✓ Ultron Gate\n" : "✗ Ultron Gate LOCKED\n"
    out += vol_ok ? "✓ Volume\n" : "· Volume low\n"
    out += "FIB (" + htf_fib_mode + ")\n"
    out += "LTF: " + (trend_fib == 1 ? "BULL" : trend_fib == -1 ? "BEAR" : "FLAT") + " (" + str.tostring(fib_bars_since_flip) + "b)\n"
    out += "HTF(" + resolved_htf + "): " + (htf_trend_fib == 1 ? "BULL" : htf_trend_fib == -1 ? "BEAR" : "FLAT") + " (" + str.tostring(htf_bars_since_flip) + "b)\n"
    out += "POSTERIOR\n"
    out += "Posterior(Bull): " + str.tostring(posterior_bull * 100.0, "#.#") + "%  |  Posterior(Bear): " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
    out += "Edge: " + str.tostring(prob_edge * 100.0, "#.#") + "%  |  Zone Conf: " + (na(activeZoneConf) ? "—" : str.tostring(activeZoneConf * 100.0, "#") + "%") + "\n"
    float riskPts = math.abs(trail - close)
    out += "RISK\nSL: " + _p(trail) + " (" + f_dist_str(riskPts) + ")\n"
    out += _fmt_full_time(time) + " " + gmt_tz + "\n" + build_chart_link() + "\n"
    if trade_dir != 0
        out += "Position already open — informational\n"
    out

build_signal_alert(bool isBull) =>
    string sig = is_options_mode ? (isBull ? "CALL SIGNAL" : "PUT SIGNAL") : (isBull ? "BUY SIGNAL" : "SELL SIGNAL")
    float refRisk = math.abs(close - trail)
    string out = sig + " — informational\n"
    out += syminfo.ticker + " @ " + _p(close) + "\n"
    out += "Mode: " + exec_mode + "\n"
    out += "Ref SL: " + _p(trail) + " (" + f_dist_str(refRisk) + ")\n"
    out += "TP1 (" + str.tostring(tp1_r, "#.#") + "R): " + f_dist_str(refRisk * tp1_r) + "\n"
    out += "TP2 (" + str.tostring(tp2_r, "#.#") + "R): " + f_dist_str(refRisk * tp2_r) + "\n"
    out += "TP3 (" + str.tostring(tp3_r, "#.#") + "R): " + f_dist_str(refRisk * tp3_r) + "\n"
    out += "Score: " + str.tostring(isBull ? bull_score : bear_score) + "/8\n"
    out += "Fib: LTF " + (trend_fib == 1 ? "B" : trend_fib == -1 ? "S" : "-") + " | HTF " + (htf_trend_fib == 1 ? "B" : htf_trend_fib == -1 ? "S" : "-") + "\n"
    out += "Posterior: Posterior(Bull) " + str.tostring(posterior_bull * 100.0, "#.#") + "% | Posterior(Bear) " + str.tostring(posterior_bear * 100.0, "#.#") + "% | Edge " + str.tostring(prob_edge * 100.0, "#.#") + "%\n"
    out += "Position: " + (trade_dir == 0 ? "Flat" : (trade_dir == 1 ? "Already LONG" : "Already SHORT")) + "\n"
    out += _fmt_full_time(time) + " " + gmt_tz + "\n" + build_chart_link() + "\n"
    out

build_fib_blocked_alert(bool isBull) =>
    string tag = isBull ? (is_options_mode ? "CALL" : "BUY") : (is_options_mode ? "PUT" : "SELL")
    float refRisk = math.abs(close - trail)
    string blockReason = "gate disagreement"
    if isBull and use_htf_source and not htf_gate_long
        blockReason := "HTF Fib bearish (" + resolved_htf + ")"
    else if not isBull and use_htf_source and not htf_gate_short
        blockReason := "HTF Fib bullish (" + resolved_htf + ")"
    else if isBull and use_ltf_source and not ltf_gate_long
        blockReason := "LTF Fib bearish"
    else if not isBull and use_ltf_source and not ltf_gate_short
        blockReason := "LTF Fib bullish"
    else if isBull and not htf_cool_long
        blockReason := "HTF cooldown (" + str.tostring(htf_bars_since_flip) + "b)"
    else if not isBull and not htf_cool_short
        blockReason := "HTF cooldown (" + str.tostring(htf_bars_since_flip) + "b)"
    else if isBull and not fib_cool_long
        blockReason := "LTF cooldown (" + str.tostring(fib_bars_since_flip) + "b)"
    else if not isBull and not fib_cool_short
        blockReason := "LTF cooldown (" + str.tostring(fib_bars_since_flip) + "b)"
    else if isBull and not htf_band_long
        blockReason := "Price below HTF basis"
    else if not isBull and not htf_band_short
        blockReason := "Price above HTF basis"
    string out = "ULTRON SEES " + tag + " — FIB BLOCKED\n"
    out += syminfo.ticker + " @ " + _p(close) + "\n"
    out += "Score: " + str.tostring(isBull ? bull_score : bear_score) + "/8\n"
    out += "Mode: " + exec_mode + "\n"
    out += "LTF Fib: " + (trend_fib == 1 ? "BULL" : trend_fib == -1 ? "BEAR" : "FLAT") + "\n"
    out += "HTF Fib (" + resolved_htf + "): " + (htf_trend_fib == 1 ? "BULL" : htf_trend_fib == -1 ? "BEAR" : "FLAT") + "\n"
    out += "Reason: " + blockReason + "\n"
    out += "Posterior: Posterior(Bull) " + str.tostring(posterior_bull * 100.0, "#.#") + "% / Posterior(Bear) " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
    out += "Ref SL: " + _p(trail) + " (" + f_dist_str(refRisk) + ")\n"
    out += "Observation only — no execution\n"
    out += _fmt_full_time(time) + " " + gmt_tz + "\n" + build_chart_link() + "\n"
    out

build_trade_event_alert(string event_type, bool from_flip) =>
    string out = ""
    bool isBull = event_type == "long_entry" or event_type == "long_tp1" or event_type == "long_tp2" or event_type == "long_tp3" or event_type == "long_exit"
    string tag_head = is_options_mode ? (isBull ? "CALL" : "PUT") : is_mult_mode ? (isBull ? deriv_mult_contract(true) : deriv_mult_contract(false)) : (isBull ? "LONG" : "SHORT")
    int    score_val = isBull ? bull_score : bear_score
    if event_type == "long_entry" or event_type == "short_entry"
        out += tag_head + " ENTRY " + (from_flip ? "[FLIP]" : "[FILTERED]") + "\n"
        out += syminfo.ticker + " @ " + _p(entry_px) + "\n"
        out += "Score: " + str.tostring(score_val) + "/8\n"
        out += "Posterior: Posterior(Bull) " + str.tostring(posterior_bull * 100.0, "#.#") + "% | Posterior(Bear) " + str.tostring(posterior_bear * 100.0, "#.#") + "%\n"
        out += "Mode: " + exec_mode + " | Entry: " + entry_mode + "\n"
        if is_options_mode
            out += "Strike: " + _p(isBull ? nz(call_strike, close) : nz(put_strike, close)) + " (" + strike_mode + ")\n"
            out += "Expiry: " + str.tostring(rec_expiry) + " min\n"
        else if is_mult_mode
            out += "Contract: " + deriv_mult_contract(isBull) + " @ " + str.tostring(resolved_mult, "#") + "x\n"
            out += "Risk: $" + str.tostring(risk_amount, "#.##") + "\n"
            if suggest_deal_cancel and broker_mode == "Deriv" and deriv_dc_ok
                out += "Deal Cancellation: available\n"
            else if suggest_deal_cancel and broker_mode == "Deriv" and not deriv_dc_ok
                out += "Deal Cancellation: NOT supported\n"
        out += "SL: " + _p(active_sl) + " (risk " + f_dist_str(math.abs(entry_px - trail)) + ")\n"
        out += "TP1: " + _p(tp1_px) + " (reward " + f_dist_str(math.abs(tp1_px - entry_px)) + " · " + str.tostring(tp1_r, "#.#") + "R)\n"
        out += "TP2: " + _p(tp2_px) + " (reward " + f_dist_str(math.abs(tp2_px - entry_px)) + " · " + str.tostring(tp2_r, "#.#") + "R)\n"
        out += "TP3: " + _p(tp3_px) + " (reward " + f_dist_str(math.abs(tp3_px - entry_px)) + " · " + str.tostring(tp3_r, "#.#") + "R)\n"
        out += "RR: 1 : " + str.tostring(tp1_r, "#.#") + " : " + str.tostring(tp2_r, "#.#") + " : " + str.tostring(tp3_r, "#.#") + "\n"
        out += "Fib: LTF " + (trend_fib == 1 ? "B" : trend_fib == -1 ? "S" : "-") + " | HTF " + (htf_trend_fib == 1 ? "B" : htf_trend_fib == -1 ? "S" : "-") + "\n"
        out += _fmt_full_time(time) + " " + gmt_tz + "\n" + build_chart_link() + "\n"
    else if event_type == "long_tp1" or event_type == "short_tp1"
        out += tag_head + " TP1 HIT @ " + _p(tp1_px) + "\n"
        out += "Captured: " + f_rr_str(tp1_r, math.abs(tp1_px - entry_px)) + "\n"
        out += "SL → Breakeven (" + _p(entry_px) + ")\n"
        out += _fmt_full_time(time) + "\n"
    else if event_type == "long_tp2" or event_type == "short_tp2"
        out += tag_head + " TP2 HIT @ " + _p(tp2_px) + "\n"
        out += "Captured: " + f_rr_str(tp2_r, math.abs(tp2_px - entry_px)) + "\n"
        out += "SL → TP1 (" + _p(tp1_px) + ")\n"
        out += _fmt_full_time(time) + "\n"
    else if event_type == "long_tp3" or event_type == "short_tp3"
        out += tag_head + " TP3 HIT @ " + _p(tp3_px) + "\n"
        out += "Captured: " + f_rr_str(tp3_r, math.abs(tp3_px - entry_px)) + "\n"
        out += "Runner mode — trail only\n"
        out += _fmt_full_time(time) + "\n"
    else if event_type == "long_exit" or event_type == "short_exit"
        float exit_px = nz(last_exit_price, close)
        float pts     = isBull ? exit_px - entry_px : entry_px - exit_px
        float r       = pts / nz(initial_risk, 1)
        bool  sl_hit  = isBull ? last_sl_hit_long : last_sl_hit_short
        out += "EXIT " + tag_head + " @ " + _p(exit_px) + "\n"
        out += "Triggered: " + (sl_hit ? "Stop Loss" : "Trail Flip") + "\n"
        out += "Result: " + f_rr_str(r, pts) + "\n"
        out += _fmt_full_time(time) + "\n"
    out

// ── CONSOLIDATED DISPATCH — one message per bar. Priority: trade events
//    > neural triggers > informational > fib-blocked > scale-ins. Raw JSON
//    is opt-in (send_json_payloads) to keep the Telegram chat clean.
bool new_session_open = false
if use_asia   and inAsia   and not inAsia[1]
    new_session_open := true
if use_london and inLondon and not inLondon[1]
    new_session_open := true
if use_nyam   and inNyam   and not inNyam[1]
    new_session_open := true
if use_nylu   and inNylu   and not inNylu[1]
    new_session_open := true
if use_nypm   and inNypm   and not inNypm[1]
    new_session_open := true
bool is_h1_close = timeframe.change("60")
bool is_h4_close = timeframe.change("240")
bool should_analyze = false
if agent_enabled and barstate.isconfirmed
    if send_on_session and new_session_open
        should_analyze := true
    if send_on_h1 and is_h1_close
        should_analyze := true
    if send_on_h4 and is_h4_close
        should_analyze := true

if agent_enabled and barstate.isconfirmed and str.length(tg_chat_id) > 0
    bool _sent = false

    // Priority 0 — scheduled analysis (fires independently)
    if should_analyze
        alert(tg_json_report(tg_chat_id, build_analysis_report()), alert.freq_once_per_bar_close)

    // Priority 1 — trade events
    if send_on_signal and not _sent
        if long_entry_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("long_entry", flip_bull and not trig_bull)), alert.freq_once_per_bar_close)
            _sent := true
        else if short_entry_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("short_entry", flip_bear and not trig_bear)), alert.freq_once_per_bar_close)
            _sent := true
        else if long_tp1_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("long_tp1", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if short_tp1_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("short_tp1", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if long_tp2_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("long_tp2", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if short_tp2_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("short_tp2", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if long_tp3_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("long_tp3", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if short_tp3_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("short_tp3", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if long_exit_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("long_exit", false)), alert.freq_once_per_bar_close)
            _sent := true
        else if short_exit_signal
            alert(tg_json_report(tg_chat_id, build_trade_event_alert("short_exit", false)), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 2 — neural triggers
    if alert_verbosity != "Trade Events Only" and send_on_signal and alert_neural_triggers and not _sent
        if trig_bull
            alert(tg_json_report(tg_chat_id, build_neural_trigger_alert(true)), alert.freq_once_per_bar_close)
            _sent := true
        else if trig_bear
            alert(tg_json_report(tg_chat_id, build_neural_trigger_alert(false)), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 3 — informational (All mode only)
    if alert_verbosity == "All" and send_on_signal and alert_informational and not _sent
        if trig_bull and not long_entry_signal
            alert(tg_json_report(tg_chat_id, build_signal_alert(true)), alert.freq_once_per_bar_close)
            _sent := true
        else if trig_bear and not short_entry_signal
            alert(tg_json_report(tg_chat_id, build_signal_alert(false)), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 4 — fib-blocked (All mode only)
    if alert_verbosity == "All" and send_on_signal and alert_fib_blocked and not _sent
        if flip_bull and not trig_bull
            alert(tg_json_report(tg_chat_id, build_fib_blocked_alert(true)), alert.freq_once_per_bar_close)
            _sent := true
        else if flip_bear and not trig_bear
            alert(tg_json_report(tg_chat_id, build_fib_blocked_alert(false)), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 5 — scale-ins & regime exits
    if is_execution_mode and not _sent
        if scale_in_call
            alert(tg_json_report(tg_chat_id, (is_options_mode ? "CALL" : "LONG") + " SCALE-IN #" + str.tostring(opt_scaleCount) + " @ " + _p(close)), alert.freq_once_per_bar_close)
            _sent := true
        else if scale_in_put
            alert(tg_json_report(tg_chat_id, (is_options_mode ? "PUT" : "SHORT") + " SCALE-IN #" + str.tostring(opt_scaleCount) + " @ " + _p(close)), alert.freq_once_per_bar_close)
            _sent := true
        else if regime_call_exit
            alert(tg_json_report(tg_chat_id, "EXIT " + (is_options_mode ? "CALL" : "LONG") + " — Regime Shift @ " + _p(close)), alert.freq_once_per_bar_close)
            _sent := true
        else if regime_put_exit
            alert(tg_json_report(tg_chat_id, "EXIT " + (is_options_mode ? "PUT" : "SHORT") + " — Regime Shift @ " + _p(close)), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 6 — raw JSON (opt-in, webhook consumers only)
    if send_json_payloads and alert_neural_triggers and not _sent
        if trig_bull
            string act = is_options_mode ? "CALL" : "BUY"
            string json_payload = '{"action":"' + act + '","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) + ',"score":' + str.tostring(bull_score) + ',"posterior_bull":' + str.tostring(posterior_bull, "#.###") + ',"prob_edge":' + str.tostring(prob_edge, "#.###") + ',"mode":"' + exec_mode + '","broker":"' + broker_mode + '","deriv_class":"' + deriv_class + '","mult":' + str.tostring(resolved_mult, "#") + ',"capped":' + str.tostring(deriv_capped) + ',"sl_dist_pts":' + str.tostring(f_points(math.abs(trail - close)), "#.#") + ',"fib_ltf":"' + str.tostring(trend_fib) + '","fib_htf":"' + str.tostring(htf_trend_fib) + '"}'
            alert(tg_json_report(tg_chat_id, json_payload), alert.freq_once_per_bar_close)
            _sent := true
        else if trig_bear
            string act = is_options_mode ? "PUT" : "SELL"
            string json_payload = '{"action":"' + act + '","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) + ',"score":' + str.tostring(bear_score) + ',"posterior_bear":' + str.tostring(posterior_bear, "#.###") + ',"prob_edge":' + str.tostring(prob_edge, "#.###") + ',"mode":"' + exec_mode + '","broker":"' + broker_mode + '","deriv_class":"' + deriv_class + '","mult":' + str.tostring(resolved_mult, "#") + ',"capped":' + str.tostring(deriv_capped) + ',"sl_dist_pts":' + str.tostring(f_points(math.abs(trail - close)), "#.#") + ',"fib_ltf":"' + str.tostring(trend_fib) + ',"fib_htf":"' + str.tostring(htf_trend_fib) + '"}'
            alert(tg_json_report(tg_chat_id, json_payload), alert.freq_once_per_bar_close)
            _sent := true

    // Priority 7 — raw JSON entry payload (opt-in)
    if send_json_payloads and not _sent
        if long_entry_signal
            string act = is_options_mode ? "CALL" : "BUY"
            string json_payload = '{"action":"' + act + '","ticker":"' + syminfo.ticker + '","entry":' + str.tostring(entry_px, format.mintick) + ',"sl":' + str.tostring(active_sl, format.mintick) + ',"sl_pts":' + str.tostring(f_points(initial_risk), "#.#") + ',"tp1_r":' + str.tostring(tp1_r, "#.#") + ',"mode":"' + exec_mode + '","entry_mode":"' + entry_mode + '","fib_ltf":"' + str.tostring(trend_fib) + '","fib_htf":"' + str.tostring(htf_trend_fib) + '"}'
            alert(tg_json_report(tg_chat_id, json_payload), alert.freq_once_per_bar_close)
            _sent := true
        else if short_entry_signal
            string act = is_options_mode ? "PUT" : "SELL"
            string json_payload = '{"action":"' + act + '","ticker":"' + syminfo.ticker + '","entry":' + str.tostring(entry_px, format.mintick) + ',"sl":' + str.tostring(active_sl, format.mintick) + ',"sl_pts":' + str.tostring(f_points(initial_risk), "#.#") + ',"tp1_r":' + str.tostring(tp1_r, "#.#") + ',"mode":"' + exec_mode + '","entry_mode":"' + entry_mode + '","fib_ltf":"' + str.tostring(trend_fib) + '","fib_htf":"' + str.tostring(htf_trend_fib) + '"}'
            alert(tg_json_report(tg_chat_id, json_payload), alert.freq_once_per_bar_close)
            _sent := true

// Memory capture
if chochSignal
    add_memory(activeDir == 1 ? "Bullish CHoCH" : "Bearish CHoCH", close, curZoneHigh, activeDir, activeKz)
if flip_bull
    add_memory("Trail Flip Bull", close, trail, 1, activeKz)
if flip_bear
    add_memory("Trail Flip Bear", close, trail, -1, activeKz)
if trig_bull
    add_memory("Neural " + LONG_TAG + " Trigger", close, trail, 1, activeKz)
if trig_bear
    add_memory("Neural " + SHORT_TAG + " Trigger", close, trail, -1, activeKz)
if long_entry_signal
    add_memory("Entry " + LONG_TAG, close, active_sl, 1, activeKz)
if short_entry_signal
    add_memory("Entry " + SHORT_TAG, close, active_sl, -1, activeKz)
if long_tp1_signal
    add_memory(LONG_TAG + " TP1 Hit", close, tp1_px, 1, activeKz)
if long_tp2_signal
    add_memory(LONG_TAG + " TP2 Hit", close, tp2_px, 1, activeKz)
if long_tp3_signal
    add_memory(LONG_TAG + " TP3 Hit", close, tp3_px, 1, activeKz)
if short_tp1_signal
    add_memory(SHORT_TAG + " TP1 Hit", close, tp1_px, -1, activeKz)
if short_tp2_signal
    add_memory(SHORT_TAG + " TP2 Hit", close, tp2_px, -1, activeKz)
if short_tp3_signal
    add_memory(SHORT_TAG + " TP3 Hit", close, tp3_px, -1, activeKz)
if long_exit_signal
    add_memory("Exit " + LONG_TAG, close, last_exit_price, 0, activeKz)
if short_exit_signal
    add_memory("Exit " + SHORT_TAG, close, last_exit_price, 0, activeKz)

// [Y] NATIVE ALERT CONDITIONS
alertcondition(trig_bull,                       "Neural Long Signal",   "Neural Long Signal on {{ticker}}")
alertcondition(trig_bear,                       "Neural Short Signal",  "Neural Short Signal on {{ticker}}")
alertcondition(long_entry_signal,               "Position Long Entry",  "Position Long Entry on {{ticker}}")
alertcondition(short_entry_signal,              "Position Short Entry", "Position Short Entry on {{ticker}}")
alertcondition(long_tp1_signal,                 "Long TP1 Hit",         "Long TP1 Hit on {{ticker}}")
alertcondition(long_tp2_signal,                 "Long TP2 Hit",         "Long TP2 Hit on {{ticker}}")
alertcondition(long_tp3_signal,                 "Long TP3 Hit",         "Long TP3 Hit on {{ticker}}")
alertcondition(short_tp1_signal,                "Short TP1 Hit",        "Short TP1 Hit on {{ticker}}")
alertcondition(short_tp2_signal,                "Short TP2 Hit",        "Short TP2 Hit on {{ticker}}")
alertcondition(short_tp3_signal,                "Short TP3 Hit",        "Short TP3 Hit on {{ticker}}")
alertcondition(long_exit_signal,                "Long Exit",            "Long Exit on {{ticker}}")
alertcondition(short_exit_signal,               "Short Exit",           "Short Exit on {{ticker}}")
alertcondition(chochSignal and activeDir == 1,  "Bullish CHoCH",        "Bullish CHoCH on {{ticker}}")
alertcondition(chochSignal and activeDir == -1, "Bearish CHoCH",        "Bearish CHoCH on {{ticker}}")
alertcondition(rej_bull,                        "Rejected Bull",        "Bull flip REJECTED on {{ticker}}")
alertcondition(rej_bear,                        "Rejected Bear",        "Bear flip REJECTED on {{ticker}}")
