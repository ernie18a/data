// finished IFVGs stay as a faded trace on their 3 formation candles (no extension)
// trace = gap origin → inversion candle, with a dashed CE (50%) line, no extension
var array<box>  ivTrace  = array.new<box>()
var array<line> ivTraceL = array.new<line>()
var array<float>  ivKP = array.new<float>()    // key highs / lows for the IFVG liquidity filters
var array<string> ivKN = array.new<string>()
var array<bool>   ivKH = array.new<bool>()     // true = a high
var array<float>  ivPP = array.new<float>()    // open BSL / SSL pools (TARGET LIQUIDITY)
var array<bool>   ivPH = array.new<bool>()
var float ivDrH = na   // dealing range used by WITH DEALING RANGE
var float ivDrL = na
// joins two level names; two session highs (lows) become one short name: "LDN/AS H"
f_sesOk(string t) =>
    array<string> p = str.split(t, " ")
    bool ok = p.size() == 2 or (p.size() == 3 and p.get(2) == "✓")
    if ok
        ok := p.get(1) == "H" or p.get(1) == "L"
    if ok
        for q in str.split(p.get(0), "/")
            ok := ok and (q == "ASIA" or q == "AS" or q == "LDN" or q == "NY")
    ok
f_join(string a, string b) =>
    string r = a + " + " + b
    if f_sesOk(a) and f_sesOk(b)
        array<string> pa = str.split(a, " ")
        array<string> pb = str.split(b, " ")
        if pa.get(1) == pb.get(1) and pa.size() == pb.size()
            string pre = str.replace_all(pa.get(0), "ASIA", "AS")
            for q in str.split(str.replace_all(pb.get(0), "ASIA", "AS"), "/")
                if not str.contains("/" + pre + "/", "/" + q + "/")
                    pre += "/" + q
            r := pre + " " + pa.get(1) + (pa.size() == 3 ? " ✓" : "")
    r
f_secNm(int s) =>
    s >= 604800 ? "W" : s >= 86400 ? "1D" : s >= 14400 ? "4H" : s >= 3600 ? "1H" : s >= 1800 ? "30m" : "15m"
var array<Sig> srS = array.new<Sig>()   // IFVGs whose source HTF gap is drawn
var array<box> srB = array.new<box>()
// alert text: the zone it reversed from, then the extras (CISD, SMT) when they are there
f_ivSrc(Sig s) =>
    string r = s.src
    if s.cisd
        r := r == "" ? "CISD" : r + " + CISD"
    if s.smt
        r := r == "" ? "SMT" : r + " + SMT"
    r == "" ? "" : " ← " + r
f_ivTxt(Sig s) => s.ivTag + (s.tgHit ? " 🎯" : "")
var array<Sig>   tgS  = array.new<Sig>()     // IFVGs whose target is still open
var array<line>  tgLn = array.new<line>()
var array<label> tgLb = array.new<label>()
var array<int>   tgHB = array.new<int>()       // bar the target was reached (na = still open)
var array<line>  ivLqL = array.new<line>()    // swept liquidity "$$$" of each IFVG (kept in the history)
var array<label> ivLqB = array.new<label>()

// The liquidity the run into the extreme SWEPT: the closest swing high (low) below (above) the
// extreme — a 3-candle pivot within 60 candles before it — that was still untaken when the final
// push started (first taken within the last 15 candles before the extreme).
// Filters (checkboxes): CLOSE BACK SWEEP · KEY LIQUIDITY ONLY · MIN SWING AGE.
// Returns [level, time of the swing, name] (na = none).
f_brk(bool bear, float v, int kFrom, int a) =>
    // first candle (oldest → newest, from kFrom - 1 to a) that traded beyond v (-1 = none)
    int fb = -1
    if kFrom - 1 >= a
        for q = kFrom - 1 to a
            float hq = bear ? f_sb(sbH, q) : f_sb(sbL, q)
            if fb < 0 and (bear ? hq > v : hq < v)
                fb := q
    fb
f_cbOk(bool bear, float v, int fb, int a) =>
    // CLOSE BACK SWEEP: max 1 close beyond v from the sweep to the extreme, back inside within 3 candles
    int nB = 0
    for q = fb to a
        float cq = f_sb(sbC, q)
        nB += (bear ? cq > v : cq < v) ? 1 : 0
    bool back = false
    for q = a to math.max(a - 3, 0)
        float cq = f_sb(sbC, q)
        back := back or (bear ? cq < v : cq > v)
    nB <= 1 and back
f_sweptLiq(bool bear, int xT) =>
    float  lvl = na
    int    lt  = na
    string nm  = "$$$"
    int    n   = sbT.size()
    int    a   = 0
    while a + 1 < n and f_sb(sbT, a) > xT
        a += 1
    float ext = bear ? f_sb(sbH, a) : f_sb(sbL, a)
    float atr = nz(f_sb(sbA, a), smtAtr)
    int kMax = math.min(a + 60, n - 6)
    if not na(ext) and kMax >= a + 2
        for k = a + 2 to kMax
            float v = bear ? f_sb(sbH, k) : f_sb(sbL, k)
            bool piv = true
            bool big = true
            for q = 1 to 5
                float l1 = bear ? f_sb(sbH, k - q) : f_sb(sbL, k - q)
                float l2 = bear ? f_sb(sbH, k + q) : f_sb(sbL, k + q)
                bool beat = bear ? (l1 > v or l2 > v) : (l1 < v or l2 < v)
                if beat
                    big := false
                    if q <= 2
                        piv := false
            if piv and (bear ? v < ext : v > ext) and (na(lvl) or (bear ? v > lvl : v < lvl))
                int fb = f_brk(bear, v, k, a)
                bool ok = fb >= a and fb - a <= 15
                ok := ok and (not i_ivAge or k - fb >= 10)
                ok := ok and (not i_ivCb or f_cbOk(bear, v, fb, a))
                string tag = "$$$"
                if ok and i_ivKl
                    // equal highs / lows: another swing within 0.1 x ATR
                    bool eq = false
                    for k2 = a + 2 to kMax
                        if not eq and k2 != k and math.abs(k2 - k) > 2
                            float v2 = bear ? f_sb(sbH, k2) : f_sb(sbL, k2)
                            bool p2 = true
                            for q = 1 to 2
                                float m1 = bear ? f_sb(sbH, k2 - q) : f_sb(sbL, k2 - q)
                                float m2 = bear ? f_sb(sbH, k2 + q) : f_sb(sbL, k2 + q)
                                if bear ? (m1 > v2 or m2 > v2) : (m1 < v2 or m2 < v2)
                                    p2 := false
                            eq := p2 and math.abs(v2 - v) <= 0.1 * atr
                    ok := eq or big
                    tag := eq ? (bear ? "$$$ EQH" : "$$$ EQL") : (bear ? "$$$ SWING H" : "$$$ SWING L")
                if ok
                    lvl := v
                    lt  := int(f_sb(sbT, k))
                    nm  := tag
        // key levels (session / previous day-week-month highs and lows) swept by the same push
        if i_ivKl and ivKP.size() > 0
            int kTop = math.min(a + 60, n - 1)
            for i = 0 to ivKP.size() - 1
                float v = ivKP.get(i)
                if ivKH.get(i) == bear and not na(v) and (bear ? v < ext : v > ext) and (na(lvl) or (bear ? v > lvl : v < lvl))
                    int fb = f_brk(bear, v, kTop + 1, a)
                    bool ok = fb >= a and fb - a <= 15
                    ok := ok and (not i_ivCb or f_cbOk(bear, v, fb, a))
                    if ok
                        lvl := v
                        lt  := int(f_sb(sbT, math.min(fb + 20, n - 1)))
                        nm  := "$$$ " + ivKN.get(i)
    [lvl, lt, nm]

// TARGET: nearest untaken liquidity beyond the entry in the trade direction (swing high / low in the
// buffer that no candle has taken since, or a key level price has not reached). [level, time]
f_ivTarget(bool bear, int a, float entry) =>
    float tg  = na
    int   tgt = na
    int   n   = sbT.size()
    float run = bear ? f_sb(sbL, 0) : f_sb(sbH, 0)   // extreme of the candles newer than k
    if n > 6
        for k = 1 to n - 3
            float v = bear ? f_sb(sbL, k) : f_sb(sbH, k)
            if k >= 2
                bool piv = true
                for q = 1 to 2
                    float l1 = bear ? f_sb(sbL, k - q) : f_sb(sbH, k - q)
                    float l2 = bear ? f_sb(sbL, k + q) : f_sb(sbH, k + q)
                    if bear ? (l1 < v or l2 < v) : (l1 > v or l2 > v)
                        piv := false
                bool untaken = bear ? v < run : v > run
                if piv and untaken and (bear ? v < entry : v > entry) and (na(tg) or (bear ? v > tg : v < tg))
                    tg  := v
                    tgt := int(f_sb(sbT, k))
            run := bear ? math.min(run, v) : math.max(run, v)
    // key levels price has not traded to since the extreme
    float since = bear ? f_sb(sbL, 0) : f_sb(sbH, 0)
    for q = 0 to math.min(a, n - 1)
        since := bear ? math.min(since, f_sb(sbL, q)) : math.max(since, f_sb(sbH, q))
    if ivKP.size() > 0
        for i = 0 to ivKP.size() - 1
            float v = ivKP.get(i)
            if ivKH.get(i) != bear and not na(v) and (bear ? v < since and v < entry : v > since and v > entry) and (na(tg) or (bear ? v > tg : v < tg))
                tg  := v
                tgt := int(f_sb(sbT, math.min(a + 20, n - 1)))
    [tg, tgt]

// OPPOSING FVG between the entry and 2R: chart FVG of the other direction not closed through yet,
// or an HTF FVG / IFVG box of the other direction. Returns its name ("" = none).
f_ivOpp(bool bear, float p1, float p2) =>
    float lo = math.min(p1, p2)
    float hi = math.max(p1, p2)
    string res = ""
    int   n    = sbT.size()
    float mC   = na   // extreme close of the candles newer than the gap
    if n > 4
        for m = 1 to math.min(n - 2, 250)
            if m - 2 >= 0
                float cq = f_sb(sbC, m - 2)
                mC := na(mC) ? cq : bear ? math.min(mC, cq) : math.max(mC, cq)
            // bull IFVG: opposing = bearish FVG (low c1 > high c3) · bear IFVG: bullish FVG (high c1 < low c3)
            float top = bear ? f_sb(sbL, m - 1) : f_sb(sbL, m + 1)
            float bot = bear ? f_sb(sbH, m + 1) : f_sb(sbH, m - 1)
            if res == "" and not na(top) and not na(bot) and top - bot >= 0.15 * smtAtr
                bool alive = na(mC) or (bear ? mC >= bot : mC <= top)
                if alive and bot < hi and top > lo
                    res := " OPPOSING FVG"
    if res == "" and hfBoxes.size() > 0
        for i = 0 to hfBoxes.size() - 1
            box hb = hfBoxes.get(i)
            if (bear ? hfDirs.get(i) == 1 : hfDirs.get(i) == -1) and hb.get_bottom() < hi and hb.get_top() > lo
                res := " OPPOSING HTF FVG"
    res

f_ifvgFreeze(Sig s) =>
    if not na(s) and not na(s.ivBox)
        if i_ifvg and not na(s.ivR)
            // finished IFVG stays in the history as a SHORT trace: gap → inversion candle (+3),
            // same colour lighter, "IFVG" text, dashed 50% line — no extension
            color cz  = s.bear ? #F23645 : #26C6DA
            int   lft = s.ivBox.get_left()
            int   rgt = s.ivR + 3 * timeframe.in_seconds() * 1000
            float tp  = s.ivBox.get_top()
            float bt  = s.ivBox.get_bottom()
            float ce  = (tp + bt) / 2
            s.ivBox.set_right(rgt)
            s.ivBox.set_bgcolor(color.new(cz, 80))
            s.ivBox.set_border_color(color.new(cz, 100))
            s.ivBox.set_text(f_ivTxt(s))
            s.ivBox.set_text_color(color.new(color.gray, 20))
            s.trB := s.ivBox
            ivTrace.push(s.ivBox)
            ivTraceL.push(line.new(lft, ce, rgt, ce, xloc = xloc.bar_time, color = color.new(cz, 50), style = line.style_dashed, width = 1))
            while ivTrace.size() > 40
                box.delete(ivTrace.shift())
                line.delete(ivTraceL.shift())
        else
            box.delete(s.ivBox)
        s.ivBox := na

f_kill(Sig s) =>
    if not na(s)
        s.gone := true
        f_ifvgFreeze(s)
        line.delete(s.ln)
        label.delete(s.lb)
        line.delete(s.cdl)
        label.delete(s.cdb)

// ─────────── SMT IFVG ───────────
color IV_BU = color.new(#26C6DA, 65)   // light cyan (bullish IFVG)
color IV_BE = color.new(#F23645, 78)   // light red (bearish IFVG)

// IFVG for a CISD: the FVG of the leg into the extreme (formed at or before it) that sits CLOSEST
// TO THE EXTREME (highest gap before a high / lowest gap before a low), closed through after it.
// displacement: the middle candle's body >= 0.7 x ATR (ATR before it), or the gap itself >= 0.35 x ATR
f_disp(int m, float top, float bot) =>
    float at = nz(f_sb(sbA, m + 1), smtAtr)
    math.abs(f_sb(sbC, m) - f_sb(sbO, m)) >= 0.85 * at or (top - bot) >= 0.4 * at
f_dbSet(label l, string t) =>
    if not na(l)
        l.set_text(t)
f_ifvgUpdate(Sig s) =>
    if not na(s)
        // the zone is also tracked (not drawn) when the stats enter on the IFVG retest
        bool ok = s.std and not s.gone and s.cDone and not s.swept and not s.ivEnd
        float bestB = na
        float bestT = na
        float bestL = na
        float bestD = na
        float bestR = na
        int   bestIa = na   // candles since the chosen gap inverted
        string why  = ""
        // LOCKED: once an IFVG is chosen it stays put; it only ends on a close back through it
        if ok and not na(s.ivKey)
            bool failNow = barstate.isconfirmed and (s.bear ? close > s.ivTop : close < s.ivBot)
            if failNow
                s.ivEnd := true
            else
                bestT := s.ivTop
                bestB := s.ivBot
                bestL := s.ivKey
        if ok and na(s.ivKey)
            bool bear = s.bear
            int  n    = sbT.size()
            int  a    = 0
            while a + 1 < n and f_sb(sbT, a) > s.xT
                a += 1
            int mx = math.min(a + 60, n - 2)
            // the leg into the SMT extreme starts at the opposite extreme before it
            // (bull SMT: highest high before the low · bear SMT: lowest low before the high)
            int   ls = a
            float lv = bear ? f_sb(sbL, a) : f_sb(sbH, a)
            for k = a to mx
                float v = bear ? f_sb(sbL, k) : f_sb(sbH, k)
                if bear ? v < lv : v > lv
                    lv := v
                    ls := k
            mx := math.min(mx, ls - 1)   // c1 (= m + 1) must be inside the leg
            float ext  = bear ? f_sb(sbH, a) : f_sb(sbL, a)   // SMT extreme
            float legM = (lv + ext) / 2                       // middle of the leg
            why := "NO GAP"
            float  whyD = na
            if mx >= a + 1
                for m = a + 1 to mx
                    // c3 = m - 1 (newer, at/before the extreme), c1 = m + 1 (older)
                    float top = bear ? f_sb(sbL, m - 1) : f_sb(sbL, m + 1)
                    float bot = bear ? f_sb(sbH, m + 1) : f_sb(sbH, m - 1)
                    // CLEAN: no close beyond the far side between the gap (c3) and the SMT extreme
                    bool used = false
                    if i_ifvgCln and m - 2 >= a + 1
                        for q = a + 1 to m - 2
                            float cq = f_sb(sbC, q)
                            used := used or (bear ? cq < bot : cq > top)
                    if i_ivDbg and not na(top) and not na(bot) and top > bot
                        // reasons for this gap (debug): keep the gap closest to the extreme
                        int  dInv = -1
                        bool dFail = false
                        for j = a to 0
                            float c = f_sb(sbC, j)
                            if dInv < 0
                                if bear ? c < bot : c > top
                                    dInv := j
                            else if bear ? c > top : c < bot
                                dFail := true
                        string w = ""
                        w += used ? " NOT CLEAN" : ""
                        w += dInv < 0 ? " NOT INVERTED" : ""
                        w += dFail ? " CLOSED BACK" : ""
                        if i_ifvgNear
                            w += (bear ? (top + bot) / 2 < legM : (top + bot) / 2 > legM) ? " NOT DISC/PREM" : ""
                            w += top - bot < 0.15 * smtAtr ? " SMALL" : ""
                            w += not f_disp(m, top, bot) ? " WEAK CANDLE" : ""
                            w += dInv >= 0 and a - dInv > 20 ? " SLOW" : ""
                        w += i_ivMin and top - bot < i_ivMinP ? " < " + str.tostring(i_ivMinP) + " PTS" : ""
                        float dd = bear ? -(top + bot) / 2 : (top + bot) / 2
                        if na(whyD) or dd < whyD
                            whyD := dd
                            why := w == "" ? " OK" : w
                    if not na(top) and not na(bot) and top > bot and not used and (not i_ivMin or top - bot >= i_ivMinP)
                        int  inv  = -1
                        bool fail = false
                        for j = a to 0
                            float c = f_sb(sbC, j)
                            if inv < 0
                                if bear ? c < bot : c > top
                                    inv := j
                            else if bear ? c > top : c < bot
                                fail := true
                        bool near = not i_ifvgNear or (inv >= 0 and
                             (bear ? (top + bot) / 2 >= legM : (top + bot) / 2 <= legM) and
                             top - bot >= 0.15 * smtAtr and
                             f_disp(m, top, bot) and
                             a - inv <= 20)
                        if inv >= 0 and not fail and near
                            // pick the gap CLOSEST TO THE EXTREME (deepest premium / discount of the leg),
                            // not the one nearest to the current close
                            float d = bear ? -(top + bot) / 2 : (top + bot) / 2
                            if na(bestD) or d < bestD
                                bestD := d
                                bestT := top
                                bestB := bot
                                bestL := f_sb(sbT, m + 1)
                                bestR := f_sb(sbT, inv)
                                bestIa := inv
        // a NO from the filters is final: the IFVG is judged once, on the candle it inverts —
        // never later (a target / range that only fits many candles later = no IFVG)
        if ok and na(s.ivKey) and s.ivRej
            bestL := na
            bestT := na
            bestB := na
            why := s.ivWhy
        // LIQUIDITY: the high (low) must have swept a swing ($$$) — otherwise IFVG C (CISD) or nothing
        // + the extra filters (checkboxes): WITH DEALING RANGE · TARGET LIQUIDITY · NO OPPOSING FVG
        if ok and na(s.ivKey) and not na(bestL)
            string rej = ""
            // the swept liquidity depends only on candles up to the high / low → computed ONCE per extreme
            if not s.swDone
                [sw0, swt0, swn0] = f_sweptLiq(s.bear, s.xT)
                s.swL    := sw0
                s.swT    := swt0
                s.swN    := swn0
                s.swDone := true
            float  sw_  = s.swL
            int    swt_ = s.swT
            string swn_ = s.swN
            if i_ivLq
                if not na(sw_)
                    s.ivTag := "IFVG"
                else if i_ivCi and s.cisd
                    s.ivTag := "IFVG C"   // no liquidity sweep, but a CISD confirmed the turn
                else
                    rej := i_ivCi ? " NO $$$ (waiting CISD)" : " NO $$$"
            if rej == "" and i_ivDr and not na(ivDrH) and not na(ivDrL) and ivDrH > ivDrL
                float eqD = (ivDrH + ivDrL) / 2
                float mdG = (bestT + bestB) / 2
                if s.bear ? mdG < eqD : mdG > eqD
                    rej := s.bear ? " NOT IN DR PREM" : " NOT IN DR DISC"
            float tg_  = na
            int   tgt_ = na
            if rej == "" and (i_ivTgt or i_ivOpp)
                int a_ = 0
                while a_ + 1 < sbT.size() and f_sb(sbT, a_) > s.xT
                    a_ += 1
                float ext_  = s.bear ? f_sb(sbH, a_) : f_sb(sbL, a_)
                float stop_ = ext_   // stop beyond the high / low
                float ent_  = s.bear ? bestB : bestT
                float r_    = math.abs(ent_ - stop_)
                float r2_   = s.bear ? ent_ - 2 * r_ : ent_ + 2 * r_
                if i_ivTgt
                    [tq, tqt] = f_ivTarget(s.bear, a_, ent_)
                    if na(tq)
                        rej := " NO TARGET"
                    else if math.abs(tq - ent_) < 2 * r_
                        rej := " TARGET < 2R"
                    else
                        tg_  := tq
                        tgt_ := tqt
                        s.tgStop := ext_
                if rej == "" and i_ivOpp
                    rej := f_ivOpp(s.bear, ent_, r2_)
            if rej != ""
                bestL := na
                bestT := na
                bestB := na
                why := rej
            else
                s.swL := sw_
                s.swT := swt_
                s.swN := swn_
                s.tgL := tg_
                s.tgT := tgt_
        if i_ivDbg and ok and na(s.ivKey)
            string hd_ = s.cisd ? "CISD ✓" : "ARM"
            f_dbSet(s.dbl, na(bestL) ? hd_ + "\nIFVG ✗" + why : hd_ + "\nIFVG ✓")
        if na(bestL)
            f_ifvgFreeze(s)
        else
            int tR = time + 10 * timeframe.in_seconds() * 1000
            if not i_ifvg
                box.delete(s.ivBox)
                s.ivBox := na
            else if na(s.ivBox)
                s.ivBox := box.new(int(bestL), bestT, tR, bestB, xloc = xloc.bar_time, bgcolor = s.bear ? IV_BE : IV_BU, border_color = color.new(color.black, 100), text = s.ivTag, text_size = size.tiny, text_color = color.black, text_halign = text.align_right, text_valign = text.align_center)
            else
                s.ivBox.set_lefttop(int(bestL), bestT)
                s.ivBox.set_rightbottom(tR, bestB)
            if na(s.ivKey)
                // ── SOURCE: what price reversed from at the high / low ──
                int ai_ = 0
                while ai_ + 1 < sbT.size() and f_sb(sbT, ai_) > s.xT
                    ai_ += 1
                float ex_  = s.bear ? f_sb(sbH, ai_) : f_sb(sbL, ai_)
                float at_  = nz(smtAtr)
                s.srStop := ex_
                string sr_ = ""
                // 1. HTF gap (support for a bull IFVG / resistance for a bear one) the extreme traded into
                int bestSec = 0
                if hfBoxes.size() > 0
                    for i = 0 to hfBoxes.size() - 1
                        box hb = hfBoxes.get(i)
                        int d  = hfDirs.get(i)
                        bool inG = s.bear ? (d == -1 and ex_ >= hb.get_bottom() and ex_ <= hb.get_top() + 0.5 * at_) : (d == 1 and ex_ <= hb.get_top() and ex_ >= hb.get_bottom() - 0.5 * at_)
                        if inG and hfBorn.get(i) <= bar_index - ai_ and hfSec.get(i) > bestSec
                            bestSec := hfSec.get(i)
                            // only WHERE price turned: the wick of the reversal candle (from its body
                            // to the high / low), not the whole gap
                            float bO = f_sb(sbO, ai_)
                            float bC = f_sb(sbC, ai_)
                            float bE = s.bear ? math.max(bO, bC) : math.min(bO, bC)   // body edge
                            float hP = 0.08 * at_   // minimum thickness so it stays visible
                            s.srTop := s.bear ? ex_ : math.max(bE, ex_ + hP)
                            s.srBot := s.bear ? math.min(bE, ex_ - hP) : ex_
                            s.srNm  := f_secNm(hfSec.get(i)) + (hfInv.get(i) ? " IFVG" : " FVG")
                if bestSec > 0
                    sr_ := s.srNm
                    int fq = math.min(ai_ + 2, sbT.size() - 1)   // starts 2 candles before the high / low
                    s.srL := int(f_sb(sbT, fq))
                // 2. session / previous high-low swept (or tapped) by the extreme
                float  lvHit = na
                string lvNm  = ""
                if ivKP.size() > 0
                    int kTop = math.min(ai_ + 60, sbT.size() - 1)
                    for i = 0 to ivKP.size() - 1
                        float v = ivKP.get(i)
                        if not na(v) and ivKH.get(i) == s.bear
                            int  fb  = f_brk(s.bear, v, kTop + 1, ai_)
                            bool swp = (s.bear ? v < ex_ : v > ex_) and fb >= ai_ and fb - ai_ <= 15
                            bool tap = math.abs(ex_ - v) <= 0.1 * at_
                            if swp or tap
                                lvNm  := lvNm == "" ? ivKN.get(i) : f_join(lvNm, ivKN.get(i))
                                lvHit := v
                if lvNm != ""
                    sr_ := sr_ == "" ? lvNm : sr_ + " + " + lvNm
                // 4. SMT vs the correlated index at the swept swing → the extreme
                if i_ivSmt and not na(s.swL) and not na(s.swT)
                    int kS = -1
                    for q = ai_ + 1 to math.min(ai_ + 70, sbT.size() - 1)
                        if kS < 0 and f_sb(sbT, q) == s.swT
                            kS := q
                    if kS > ai_ and sbH2.size() > kS + 1
                        float c2Ex = na   // correlated extreme around our high / low (±1 candle)
                        float c2Sw = na   // correlated extreme around the swing (±1 candle)
                        for q = math.max(ai_ - 1, 0) to ai_ + 1
                            float v2 = s.bear ? f_sb(sbH2, q) : f_sb(sbL2, q)
                            c2Ex := na(c2Ex) ? v2 : s.bear ? math.max(c2Ex, v2) : math.min(c2Ex, v2)
                        for q = kS - 1 to kS + 1
                            float v2 = s.bear ? f_sb(sbH2, q) : f_sb(sbL2, q)
                            c2Sw := na(c2Sw) ? v2 : s.bear ? math.max(c2Sw, v2) : math.min(c2Sw, v2)
                        // chart took the swing, the correlated index did not
                        if not na(c2Ex) and not na(c2Sw) and (s.bear ? c2Ex < c2Sw : c2Ex > c2Sw)
                            s.smt := true
                            if i_ifvg
                                color cM = s.bear ? i_lBe : i_lBu
                                ivLqL.push(line.new(s.swT, s.swL, s.xT, ex_, xloc = xloc.bar_time, color = cM, style = line.style_solid, width = 2))
                                ivLqB.push(label.new(int((s.swT + s.xT) / 2), (s.swL + ex_) / 2, "SMT", xloc = xloc.bar_time, style = s.bear ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cM, size = size.small))
                s.src := sr_
                if bestSec > 0 and i_ifvg
                    color cS = s.bear ? color.new(#F23645, 85) : color.new(#26A69A, 85)
                    srS.push(s)
                    srB.push(box.new(s.srL, s.srTop, time + 8 * timeframe.in_seconds() * 1000, s.srBot, xloc = xloc.bar_time, bgcolor = cS, border_color = color.new(cS, 40), text = s.srNm, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top, text_color = color.new(color.gray, 0)))
                    while srS.size() > 3
                        srS.shift()
                        box.delete(srB.shift())
                if s.std and i_alCiF
                    alert((s.bear ? "🔴" : "🟢") + " NEW " + s.ivTag + f_ivSrc(s) + " | " + SYM + " | " + TF, ALF)
                s.ivLockBar := bar_index
                // draw the liquidity this IFVG's high (low) swept: "$$$" from the swing to the extreme
                if i_ifvg
                    float swL = s.swL
                    int   swT = s.swT
                    if not na(swL) and not na(swT)
                        int tE = s.xT   // ends AT the candle that swept it
                        color cL = color.new(#2962FF, 0)
                        ivLqL.push(line.new(swT, swL, tE, swL, xloc = xloc.bar_time, color = cL, style = line.style_solid, width = 1))
                        ivLqB.push(label.new(int((swT + tE) / 2), swL, s.swN, xloc = xloc.bar_time, style = s.bear ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = cL, size = size.small))
                    // TARGET LIQUIDITY 🎯: dotted line from the target swing to 10 candles past the IFVG
                    if not na(s.tgL) and not na(s.tgT)
                        int tE2 = time + 10 * timeframe.in_seconds() * 1000
                        color cT = color.new(#FF9800, 0)
                        tgS.push(s)
                        tgHB.push(na)
                        tgLn.push(line.new(s.tgT, s.tgL, tE2, s.tgL, xloc = xloc.bar_time, color = cT, style = line.style_dotted, width = 1))
                        tgLb.push(label.new(tE2, s.tgL, "🎯", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = cT, size = size.small))
                        while tgS.size() > 4
                            tgS.shift()
                            tgHB.shift()
                            line.delete(tgLn.shift())
                            label.delete(tgLb.shift())
                    while ivLqL.size() > 40
                        line.delete(ivLqL.shift())
                        label.delete(ivLqB.shift())
                s.ivR   := int(bestR)
                s.ivKey := bestL
                s.ivTop := bestT
                s.ivBot := bestB
                s.ivBar := bar_index
                s.ivHit := false
            // IFVG ALERT — NEAR: price moved away (more than 1 x ATR from the IFVG edge) and comes back
            // within 1 x ATR of it → once per IFVG, before it touches
            float nD = nz(smtAtr)
            if bar_index > s.ivBar and (s.bear ? low < bestB - nD : high > bestT + nD)
                s.ivArm := true
            if i_ifvg and i_alIfvg and s.ivArm and not s.ivHit and bar_index > s.ivBar and (s.bear ? high >= bestB - nD : low <= bestT + nD)
                s.ivHit := true
                alert((s.bear ? "🔴" : "🟢") + " NEAR " + s.ivTag + f_ivSrc(s) + " | " + SYM + " | " + TF, ALF)
    0

f_vis(Sig s, bool on) =>
    color clr = color.new(color.black, 100)
    color lc  = s.swept ? color.new(s.col, i_brkT)  : s.col
    color tc  = s.swept ? color.new(s.tcol, i_brkT) : s.tcol
    s.ln.set_style(s.swept ? f_style(i_brkSt) : f_style(i_st))
    s.ln.set_color(on ? lc : clr)
    s.lb.set_textcolor(on ? tc : clr)
    s.lb.set_color(on ? i_lbBg : clr)
    if not na(s.cdl)
        color cc = s.swept ? color.new(s.ccol, i_brkT) : s.ccol
        s.cdl.set_color(on ? cc : clr)
        s.cdb.set_textcolor(on ? cc : clr)

// ═══════════════════════════ CYCLE METHODS ═══════════════════════════
method draw(Cyc c, Sig s, bool bear, string txt) =>
    int    x1  = bear ? c.pHt : c.pLt
    float  y1  = bear ? c.pH  : c.pL
    int    x2  = bear ? c.cHt : c.cLt
    float  y2  = bear ? c.cH  : c.cL
    float  lvl = bear ? math.max(y1, y2) : math.min(y1, y2)
    color  lc  = bear ? i_cBe : i_cBu
    color  tc  = color.t(i_lbTx) >= 100 ? (bear ? i_lBe : i_lBu) : i_lbTx
    string t   = i_tag ? txt + " | " + TAG : txt
    int    lx  = i_lbPos == "Start" ? x1 : i_lbPos == "End" ? x2 : int((x1 + x2) / 2)
    float  ly  = i_lbPos == "Start" ? y1 : i_lbPos == "End" ? y2 : (y1 + y2) / 2
    string ls  = i_lbSty == "Up" ? label.style_label_up : i_lbSty == "Down" ? label.style_label_down : bear ? label.style_label_down : label.style_label_up
    float  cl  = bear ? c.cHo  : c.cLo
    int    clT = bear ? c.cHoT : c.cLoT
    Sig r = s
    if na(r)
        line  ln = line.new(x1 = x1, y1 = y1, x2 = x2, y2 = y2, xloc = xloc.bar_time, extend = extend.none, color = lc, style = f_style(i_st), width = i_w)
        label lb = label.new(x = lx, y = ly, text = t, xloc = xloc.bar_time, yloc = yloc.price, color = i_lbBg, style = ls, textcolor = tc, size = f_size(i_lbSz))
        r := Sig.new(ln = ln, lb = lb, lvl = lvl, bear = bear, col = lc, tcol = tc, cl = cl, clT = clT, xT = x2, atrAt = smtAtr)
    else
        r.ln.set_xy1(x1, y1)
        r.ln.set_xy2(x2, y2)
        r.lb.set_xy(lx, ly)
        r.lb.set_text(t)
        r.lvl := lvl
        if r.xT != x2   // new extreme → new CISD setup and a fresh IFVG search
            r.cDone := false
            r.ivKey := na
            r.ivEnd := false
            f_ifvgFreeze(r)
        r.cl  := cl
        r.clT := clT
        r.xT  := x2
    r

// newest valid SSMTs first; broken ones only when "Show Broken SSMTs" is on
method refresh(Cyc c) =>
    int n  = 0
    int sz = c.hist.size()
    if sz > 0
        for i = sz - 1 to 0
            Sig s = c.hist.get(i)
            f_vis(s, s.swept ? (i_showBrk and not s.won) : (i_maxN == 0 or n < i_maxN))
            n += s.swept ? 0 : 1

method confirm(Cyc c, Sig s) =>
    s.ct := time
    c.hist.push(s)
    c.nBe += s.bear ? 1 : 0
    c.nBu += s.bear ? 0 : 1
    c.wBe += s.bear and s.won ? 1 : 0
    c.wBu += not s.bear and s.won ? 1 : 0
    while c.hist.size() > 300
        f_kill(c.hist.shift())
    c.refresh()

method live(Cyc c, Sig s, string txt, bool bear) =>
    Sig r = s
    if txt != ""
        r := c.draw(r, bear, txt)
        if not r.al
            r.al := true
            if i_alert
                alert((bear ? "🔴" : "🟢") + " SMT | " + SYM + " | " + TF, ALF)
    else if not na(r)
        f_kill(r)
        r := na
    r

method divTxt(Cyc c, bool bear) =>
    string t = ""
    if bear
        bool mHH = c.cH > c.pH
        if has1 and not na(c.pH1) and not na(c.cH1) and (c.cH1 > c.pH1) != mHH
            t := n1
        if has2 and not na(c.pH2) and not na(c.cH2) and (c.cH2 > c.pH2) != mHH
            t := t == "" ? n2 : t + ", " + n2
    else
        bool mLL = c.cL < c.pL
        if has1 and not na(c.pL1) and not na(c.cL1) and (c.cL1 < c.pL1) != mLL
            t := n1
        if has2 and not na(c.pL2) and not na(c.cL2) and (c.cL2 < c.pL2) != mLL
            t := t == "" ? n2 : t + ", " + n2
    t

// a live (forming) SMT can already deliver before its quarter closes
f_trackLive(Sig s) =>
    if not na(s) and not s.won and (s.bear ? s.lvl - low : high - s.lvl) >= SMT_WIN_ATR * s.atrAt
        s.won := true

method sweep(Cyc c) =>
    bool changed = false
    for s in c.hist
        if not s.swept and (s.bear ? high > s.lvl : low < s.lvl)
            // broken: counts as a real break only if the SMT never delivered first
            s.swept := true
            f_ifvgFreeze(s)
            c.sBe   += s.bear and not s.won ? 1 : 0
            c.sBu   += not s.bear and not s.won ? 1 : 0
            changed := true
        else if not s.swept and not s.won and (s.bear ? s.lvl - low : high - s.lvl) >= SMT_WIN_ATR * s.atrAt
            c.wBe += s.bear ? 1 : 0
            c.wBu += s.bear ? 0 : 1
            s.won := true
    if changed
        c.refresh()

method step(Cyc c) =>
    if qNew
        if not na(c.bear)
            c.confirm(c.bear)
            c.bear := na
        if not na(c.bull)
            c.confirm(c.bull)
            c.bull := na
        c.pH  := c.cH
        c.pL  := c.cL
        c.pHt := c.cHt
        c.pLt := c.cLt
        c.pH1 := c.cH1
        c.pL1 := c.cL1
        c.pH2 := c.cH2
        c.pL2 := c.cL2
        c.cnt += 1
        c.cH  := high
        c.cL  := low
        c.cHt := time
        c.cLt := time
        c.cHo  := lUpO
        c.cHoT := lUpT
        c.cLo  := lDnO
        c.cLoT := lDnT
        c.cH1 := oh1
        c.cL1 := ol1
        c.cH2 := oh2
        c.cL2 := ol2
        if i_showDiv
            c.divs.push(line.new(x1 = time, y1 = low, x2 = time, y2 = high, xloc = xloc.bar_time, extend = extend.both, color = i_dC, style = f_style(i_dS), width = i_dW))
            while c.divs.size() > i_maxDiv
                line.delete(c.divs.shift())
    else if c.cnt > 0
        if high > c.cH
            c.cH   := high
            c.cHt  := time
            c.cHo  := lUpO
            c.cHoT := lUpT
        if low < c.cL
            c.cL   := low
            c.cLt  := time
            c.cLo  := lDnO
            c.cLoT := lDnT
        c.cH1 := f_mx(c.cH1, oh1)
        c.cL1 := f_mn(c.cL1, ol1)
        c.cH2 := f_mx(c.cH2, oh2)
        c.cL2 := f_mn(c.cL2, ol2)
    if c.cnt >= 3 and not na(c.pH)
        c.bear := c.live(c.bear, c.divTxt(true), true)
        c.bull := c.live(c.bull, c.divTxt(false), false)
    f_trackLive(c.bear)
    f_trackLive(c.bull)
    c.sweep()

