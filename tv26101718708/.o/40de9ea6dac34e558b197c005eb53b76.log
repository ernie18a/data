f_isNear(float top, float bot) => i_showAll or (not na(top) and not na(bot) and (close >= bot - NEARD and close <= top + NEARD))
// NEAR LEVEL ALERT for a single level (one latch per call site)
f_nearAl(float lvl, bool on, string tag) =>
    var bool armed = true
    if not na(lvl)
        float d = math.abs(close - lvl)
        if d > 2 * NEARD
            armed := true
        else if armed and d <= NEARD
            armed := false
            if on and i_alNear
                alert("🔔 NEAR " + tag + " | " + SYM + " | " + TF, alert.freq_once_per_bar)
    0
