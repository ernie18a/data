var array<int>  hfBorn = array.new<int>()
var array<bool> hfNr   = array.new<bool>()   // NEAR alert latch per HTF box
var array<bool> hfPdOk = array.new<bool>()   // gap sits on the right side of its timeframe's dealing range (set by CLEAN CHART)    // bar the box was drawn / inverted on

type Sig
    line   ln
    label  lb
    float  lvl
    bool   bear
    bool   swept = false
    color  col
    color  tcol
    int    ct            // confirm time
    float  cl            // CISD level = open of the series that made the SMT extreme
    int    clT
    int    xT            // time of the SMT extreme
    bool   cDone = false // CISD already drawn for this extreme
    line   cdl           // this SMT's CISD drawing (lives and dies with the SMT)
    label  cdb
    color  ccol
    float  atrAt         // ATR(14) when the SMT formed (win yardstick)
    bool   won = false   // price moved >= SMT_WIN_ATR x ATR in favour before breaking the SMT
    bool   gone = false  // deleted (live SMT vanished / trimmed)
    box    ivBox         // SMT IFVG zone
    float  ivKey         // identity of the drawn zone (left-candle time)
    int    ivBar         // bar the current zone was first drawn
    bool   ivHit = false // IFVG alert sent for this zone
    float  ivTop         // locked zone
    int    ivR           // time of the inversion candle (right edge of the trace)
    float  ivBot
    bool   ivEnd = false // the locked IFVG failed: no new IFVG for this SMT
    bool   al = false    // SMT alert / SMT-only trade already done
    bool   std = false   // standalone IFVG owner (IFVG WITHOUT SMT), not a real SMT
    int    ivLockBar     // bar the IFVG was locked
    label  dbl           // IFVG DEBUG label
    bool   cisd = false  // a CISD has confirmed this extreme
    string ivTag = "IFVG" // "IFVG" = liquidity swept ($$$) · "IFVG C" = no $$$, confirmed by a CISD
    float  swL           // swept liquidity level ($$$) found at lock
    int    swT
    string swN = "$$$"
    float  tgL           // target liquidity (🎯)
    int    tgT
    float  tgStop        // the swept high / low (stop): taken first = target cancelled
    bool   tgHit = false // target reached → 🎯 inside the box
    box    trB           // the box after it was frozen to the history
    string src = ""      // what price reversed from: "15m FVG + ASIA L + $$$"
    float  srStop        // the high / low of the reversal (stop)
    float  srTop         // the HTF gap it reversed from (drawn until target / stop / fail)
    float  srBot
    string srNm = ""
    int    srL           // first candle that traded into that gap
    bool   ivRej = false // the filters said NO at the inversion → final (no late IFVG)
    string ivWhy = ""
    bool   ivArm = false // price moved away from the IFVG (NEAR alert armed)
    int    ciX           // CISD: run open time / level / CISD candle time
    float  ciY
    int    ciT
    bool   ciDone = false
    bool   smt = false
    bool   swDone = false  // swept liquidity of this high / low already computed (it never changes)

