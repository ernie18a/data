// ═══════════════════════════ HELPERS ═══════════════════════════
f_style(string s) => s == ST_DASH ? line.style_dashed : s == ST_DOT ? line.style_dotted : line.style_solid

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_pos(string s) =>
    switch s
        "Bottom Right" => position.bottom_right
        "Top Left"     => position.top_left
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_short(string s) => s == "" ? "" : array.last(str.split(s, ":"))

f_mx(float a, float b) => na(b) ? a : na(a) ? b : math.max(a, b)
f_mn(float a, float b) => na(b) ? a : na(a) ? b : math.min(a, b)

f_tf() =>
    int m = timeframe.multiplier
    timeframe.isseconds ? str.tostring(m) + "S" : timeframe.isminutes ? (m % 60 == 0 ? str.tostring(m / 60) + "H" : str.tostring(m) + "M") : timeframe.isdaily ? str.tostring(m) + "D" : timeframe.isweekly ? str.tostring(m) + "W" : str.tostring(m) + "MO"

string SYM = syminfo.root != "" ? syminfo.root : syminfo.ticker
string TF  = f_tf()
// cycle auto-scales with the chart: 90m quarters up to 45m charts, 6H (daily session) quarters
// up to 3H charts, whole-day quarters (weekly cycle) up to 12H charts
int    CYC_TF = timeframe.in_seconds()
string TAG    = CYC_TF <= 2700 ? "90m" : CYC_TF <= 10800 ? "6H" : "D"

// SMT symbols not used in this script (kept as empty constants for the shared code)
string chartId = syminfo.prefix + ":" + syminfo.ticker
bool   has1 = false
bool   has2 = false
string n1   = ""
string n2   = ""
float  oh1  = na
float  ol1  = na
float  oh2  = na
float  ol2  = na

// ═══════════════════════════ TIME ENGINE ═══════════════════════════
int tfSec    = timeframe.in_seconds(timeframe.period)
int LEN      = CYC_TF <= 2700 ? 5400000 : CYC_TF <= 10800 ? 21600000 : 86400000
int secDay   = hour(time, NY) * 3600 + minute(time, NY) * 60 + second(time, NY)
int offMs    = ((secDay - 64800 + 86400) % 86400) * 1000   // ms since 18:00 NY
int qIdx     = int(math.floor(offMs / LEN))
int qStart   = time - offMs + qIdx * LEN
int qNum     = qIdx % 4 + 1

var int lastQ = na
bool qNew = na(lastQ) or qStart != lastQ
lastQ := qStart

bool active = i_smt and LEN >= 2 * tfSec * 1000

// ═══════════════════════════ CISD ENGINE ═══════════════════════════
bool isBu = close > open
bool isBe = close < open

var float dnO = na   // open of 1st candle of latest bearish series
var int   dnT = na
var float upO = na   // open of 1st candle of latest bullish series
var int   upT = na

bool  cisdBu = isBu and not na(dnO) and close > dnO
bool  cisdBe = isBe and not na(upO) and close < upO
float ciBuY  = dnO
int   ciBuX  = dnT
float ciBeY  = upO
int   ciBeX  = upT

// fresh-extreme tracking of the current series (for CISD / IFVG WITHOUT SMT)
float ll20 = ta.lowest(low, 20)[1]
float hh20 = ta.highest(high, 20)[1]
var float dnLo  = na
var int   dnLoT = na
var bool  dnSw  = false
var float upHi  = na
var int   upHiT = na
var bool  upSw  = false
if not na(dnO) and (na(dnLo) or low < dnLo)
    dnLo  := low
    dnLoT := time
    dnSw  := dnSw or low < ll20
if not na(upO) and (na(upHi) or high > upHi)
    upHi  := high
    upHiT := time
    upSw  := upSw or high > hh20
// standalone CISD events (snapshot before the series reset)
bool  stdBu   = cisdBu and dnSw
bool  stdBe   = cisdBe and upSw
float stdBuLo = dnLo
int   stdBuT  = dnLoT
float stdBeHi = upHi
int   stdBeT  = upHiT

if cisdBu
    dnO := na
if cisdBe
    upO := na
if isBe and not isBe[1]
    dnO := open
    dnT := time
    dnLo  := low
    dnLoT := time
    dnSw  := low < ll20
if isBu and not isBu[1]
    upO := open
    upT := time
    upHi  := high
    upHiT := time
    upSw  := high > hh20

// start of the series that delivered price into each new extreme (never reset)
var float lUpO = na
var int   lUpT = na
var float lDnO = na
var int   lDnT = na
if isBu and not isBu[1]
    lUpO := open
    lUpT := time
if isBe and not isBe[1]
    lDnO := open
    lDnT := time

// CISD drawings
var array<line>  ciL = array.new<line>()
var array<label> ciB = array.new<label>()

// thin solid line from the open of the series to a few candles past the CISD candle, "CISD" at its end
f_cisdDraw(int x0, float y, color col) =>
    int   xR = time + 4 * timeframe.in_seconds() * 1000
    line  l = line.new(x0, y, xR, y, xloc = xloc.bar_time, color = col, style = line.style_solid, width = 1)
    label b = label.new(xR, y, "CISD", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = size.small)
    [l, b]

f_cisd(int x0, float y, color col) =>
    [l, b] = f_cisdDraw(x0, y, col)
    ciL.push(l)
    ciB.push(b)
    while ciL.size() > i_ciMax
        line.delete(ciL.shift())
        label.delete(ciB.shift())

// SMT win measure (chart only: hides SMTs that delivered before breaking)
float SMT_WIN_ATR = 2.0
float smtAtr = ta.atr(14)

string ALF = i_alClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

// bar buffers for the SMT IFVG search (index 0 = current bar), filled every bar
var array<float> sbH = array.new<float>()
var array<float> sbL = array.new<float>()
var array<float> sbC = array.new<float>()
var array<float> sbT = array.new<float>()
sbH.unshift(high)
sbL.unshift(low)
sbC.unshift(close)
sbT.unshift(time)
var array<float> sbO = array.new<float>()
sbO.unshift(open)
var array<float> sbA = array.new<float>()
sbA.unshift(nz(ta.atr(14)))
// correlated index for the IFVG SMT (same timeframe, same bars)
// NQ/MNQ → ES · ES/MES → NQ · YM/MYM → ES · GC/MGC (gold) → SI (silver) · others → ES
string SMT_SYM = str.contains(syminfo.root, "NQ") ? i_s2 : str.contains(syminfo.root, "ES") ? i_s1 : str.contains(syminfo.root, "GC") ? "COMEX:SI1!" : i_s2
[cmpH, cmpL] = request.security(SMT_SYM, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)
var array<float> sbH2 = array.new<float>()
var array<float> sbL2 = array.new<float>()
sbH2.unshift(cmpH)
sbL2.unshift(cmpL)
if sbH2.size() > 300
    sbH2.pop()
    sbL2.pop()
if sbH.size() > 300
    sbH.pop()
    sbL.pop()
    sbC.pop()
    sbT.pop()
    sbO.pop()
    sbA.pop()
f_sb(array<float> a, int i) => i >= 0 and i < a.size() ? a.get(i) : na

// ═══════════════════════════ TYPES ═══════════════════════════
