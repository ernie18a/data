     (tf == "M" or tf == "1M") ? "M" : tf

// Minutes-of-day window check, America/New_York (handles DST)
f_inWin(int s, int e) =>
    m = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    m >= s and m < e

// Session H/L tracker: commits the completed session's extremes (+ the candle time of each)
f_sessLvls(bool inSess) =>
    var float runHi = na
    var float runLo = na
    var float comHi = na
    var float comLo = na
    var int   runHiT = na
    var int   runLoT = na
    var int   comHiT = na
    var int   comLoT = na
    if inSess and not inSess[1]
        runHi  := high
        runLo  := low
        runHiT := time
        runLoT := time
    else if inSess
        if na(runHi) or high > runHi
            runHi  := high
            runHiT := time
        if na(runLo) or low < runLo
            runLo  := low
            runLoT := time
    if not inSess and inSess[1]
        comHi  := runHi
        comLo  := runLo
        comHiT := runHiT
        comLoT := runLoT
    [comHi, comLo, comHiT, comLoT]

// Level state: sweep event + taken latch, one latch per call site (keep calls top-level)
f_lvlState(float lvl, bool isHigh) =>
    var bool taken = false
    if lvl != lvl[1]
        taken := false
    sw = false
    if not taken and not na(lvl)
        if isHigh ? high > lvl : low < lvl
            taken := true
            sw := true
    [sw, taken]

