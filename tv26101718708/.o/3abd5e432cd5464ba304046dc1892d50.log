            t4l_ifvg_top := _t4l_ift
            t4l_ifvg_bot := _t4l_ifb
            t4l_ifvg_left := na(_t4l_ifg) ? bar_index : _t4l_ifg > 0 ? _t4l_ifg : bar_index
            t4l_suppressed := false
