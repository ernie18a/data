// ============================================================
// === T2 EXECUTION - sweep of any prior 90m block H/L ===
// ============================================================
if show_t2 and in_cycle_blks
    if (not use_gates or short_ok) and array.size(t2_hs) > 0
        bool _fired = false
        float _ref = na
        int _refb = 0
        bool _pri_f = false
        bool _s1_f = false
        bool _s2_f = false
        int _idx = -1
        for i = array.size(t2_hs) - 1 to 0 by 1
            if _fired
                break
            if array.get(t2_fired_h_arr, i)
