bool isDailyChart = timeframe.isdaily and timeframe.multiplier == 1
bool isSupportedIntradayChart = timeframe.isintraday and timeframe.in_seconds() >= timeframe.in_seconds("15") and timeframe.in_seconds() < timeframe.in_seconds("1D")
bool isSupportedView = isDailyChart or isSupportedIntradayChart
bool showClassicMode = displayMode == MODE_CLASSIC
bool showRobustMode = displayMode == MODE_ROBUST
bool showTacticalMode = displayMode == MODE_TACTICAL
bool showCombinedMode = displayMode == MODE_COMBINED
bool needsClassicProfile = showClassicMode or showCombinedMode
bool needsRobustProfile = showRobustMode
bool needsCurrentYearProfile = needsClassicProfile or needsRobustProfile
bool needsTacticalProfile = showTacticalMode or showCombinedMode

color panelTextColor = color.new(color.white, 0)
color panelMutedTextColor = color.new(color.white, 25)
color panelHeaderColor = color.new(color.gray, 75)
color panelCellColor = color.new(color.gray, 88)

// Seasonal dates use the same UTC trading-day semantics as the main indicator.
f_seasonalDateTsFromBar(int offset) =>
    int result = na
    if not na(offset) and offset >= 0 and offset <= bar_index
        int tradingDayTs = time_tradingday[offset]
        if not na(tradingDayTs)
            result := tradingDayTs
        else
            int chartTs = time[offset]
            result := timestamp("UTC", year(chartTs, "UTC"), month(chartTs, "UTC"), dayofmonth(chartTs, "UTC"), 0, 0)
    result

f_dailyChartTsFromBar(int offset) =>
    int result = na
    if not na(offset) and offset >= 0 and offset <= bar_index
        result := time[offset]
    result

// Future Tactical geometry uses calendar days for crypto and skips weekends otherwise.
f_projectDailyOffsetTime(int anchorTime, int dailyOffset) =>
    int dayMs = 24 * 60 * 60 * 1000
    int result = anchorTime
    if syminfo.type == "crypto"
        result := anchorTime + dailyOffset * dayMs
    else
        int direction = dailyOffset >= 0 ? 1 : -1
        int remaining = math.abs(dailyOffset)
        while remaining > 0
            result += direction * dayMs
            int projectedDay = dayofweek(result, "UTC")
            if projectedDay != dayofweek.saturday and projectedDay != dayofweek.sunday
                remaining -= 1
    result

f_dailyChartTimeFromOriginOffset(int originBarsBack, int offsetAtOrigin, int originChartTime) =>
    int result = na
    if not na(originBarsBack) and not na(offsetAtOrigin) and not na(originChartTime)
        if isDailyChart
            int targetBarsBack = originBarsBack - offsetAtOrigin
            if targetBarsBack >= 0 and targetBarsBack <= bar_index
                result := f_dailyChartTsFromBar(targetBarsBack)
            else if targetBarsBack < 0
                result := f_projectDailyOffsetTime(originChartTime, offsetAtOrigin)
        else
            result := f_projectDailyOffsetTime(originChartTime, offsetAtOrigin)
    result

f_targetTimestamp(int targetYear, int anchorMonth, int anchorDay) =>
    bool leapYear = targetYear % 4 == 0 and (targetYear % 100 != 0 or targetYear % 400 == 0)
    int monthMaxDay = anchorMonth == 2 ? (leapYear ? 29 : 28) : anchorMonth == 4 or anchorMonth == 6 or anchorMonth == 9 or anchorMonth == 11 ? 30 : 31
    int adjustedDay = math.max(1, math.min(anchorDay, monthMaxDay))
    timestamp("UTC", targetYear, anchorMonth, adjustedDay, 0, 0)

findHistoricalAnchorOffset(int targetYear, int anchorMonth, int anchorDay, int maxBarsBack, int maxAnchorSearchBars) =>
    int targetTs = f_targetTimestamp(targetYear, anchorMonth, anchorDay)
    int maxDistanceMs = maxAnchorSearchBars * 24 * 60 * 60 * 1000
    int safeMaxBarsBack = math.min(maxBarsBack, 4999)
    int bestOffset = na
    int bestDistance = na
    for lookbackOffset = 0 to safeMaxBarsBack
        int candidateTs = f_seasonalDateTsFromBar(lookbackOffset)
        if not na(candidateTs)
            int distance = math.abs(candidateTs - targetTs)
            if distance <= maxDistanceMs and (na(bestDistance) or distance < bestDistance)
                bestDistance := distance
                bestOffset := lookbackOffset
    bestOffset

f_collectHistoricalAnchorOffsets(int anchorYear, int anchorMonth, int anchorDay, int lookbackYears, int maxBarsBack, int maxAnchorSearchBars) =>
    array<int> resultOffsets = array.new_int(lookbackYears, na)
    array<int> bestDistances = array.new_int(lookbackYears, na)
    int maxDistanceMs = maxAnchorSearchBars * 24 * 60 * 60 * 1000
    int safeMaxBarsBack = math.min(maxBarsBack, 4999)
    for lookbackOffset = 0 to safeMaxBarsBack
        int candidateTs = f_seasonalDateTsFromBar(lookbackOffset)
        if not na(candidateTs)
            int candidateYear = year(candidateTs, "UTC")
            int yearBack = anchorYear - candidateYear
            if yearBack >= 1 and yearBack <= lookbackYears
                int targetTs = f_targetTimestamp(candidateYear, anchorMonth, anchorDay)
                int distance = math.abs(candidateTs - targetTs)
                int resultIndex = yearBack - 1
                int bestDistance = array.get(bestDistances, resultIndex)
                if distance <= maxDistanceMs and (na(bestDistance) or distance < bestDistance)
                    array.set(bestDistances, resultIndex, distance)
                    array.set(resultOffsets, resultIndex, lookbackOffset)
    resultOffsets

f_dirThresholdFactor(int strictness) =>
    strictness <= 30 ? 0.55 : strictness <= 60 ? 0.75 : 0.95

f_confidenceMin(int strictness) =>
    strictness <= 30 ? 45.0 : strictness <= 60 ? 55.0 : 65.0

f_stateColor(int state) =>
    state == STATE_LONG ? color.green : state == STATE_SHORT ? color.red : state == STATE_RANGE ? color.blue : color.gray

f_stateText(int state) =>
    state == STATE_LONG ? "Long" : state == STATE_SHORT ? "Short" : state == STATE_RANGE ? "Range" : "None"

f_trendRegimeAtOffset(int offset) =>
    int result = na
    int safeOffset = not na(offset) and offset >= 0 ? offset : 0
    float smaSlowSeries = ta.sma(close, REGIME_SMA_SLOW)
    float smaFastSeries = ta.sma(close, REGIME_SMA_FAST)
    float smaSlow = smaSlowSeries[safeOffset]
    float smaFast = smaFastSeries[safeOffset]
    float smaFastPast = smaFastSeries[safeOffset + REGIME_SMA_SLOPE_LOOKBACK]
    float anchorClose = close[safeOffset]
    if not na(offset) and offset >= 0 and offset <= bar_index and not na(anchorClose)
        if not na(smaSlow) and not na(smaFast) and not na(smaFastPast)
            float smaFastSlope = smaFast - smaFastPast
            result := anchorClose > smaSlow and smaFastSlope > 0 ? REGIME_TREND_BULL : anchorClose < smaSlow and smaFastSlope < 0 ? REGIME_TREND_BEAR : REGIME_TREND_NEUTRAL
        else
            result := REGIME_TREND_NEUTRAL
    result

f_volatilityRegimeAtOffset(int offset) =>
    int result = na
    int safeOffset = not na(offset) and offset >= 0 ? offset : 0
    float atrSeries = ta.atr(REGIME_ATR_LENGTH)
    float currentAtr = atrSeries[safeOffset]
    if not na(offset) and offset >= 0 and offset <= bar_index and not na(currentAtr)
        int validCount = 0
        int countBelowOrEqual = 0
        for percentileIndex = 0 to REGIME_PERCENTILE_LENGTH - 1
            int atrOffset = offset + percentileIndex
            if atrOffset <= bar_index
                float historicalAtr = atrSeries[atrOffset]
                if not na(historicalAtr)
                    validCount += 1
                    countBelowOrEqual += historicalAtr <= currentAtr ? 1 : 0
        if validCount >= REGIME_PERCENTILE_MIN_VALID
            float percentile = countBelowOrEqual * 100.0 / validCount
            result := percentile <= 30.0 ? REGIME_VOL_LOW : percentile < 75.0 ? REGIME_VOL_NORMAL : REGIME_VOL_HIGH
        else if validCount > 0
            result := REGIME_VOL_NORMAL
    result

f_drawdownRegimeAtOffset(int offset) =>
    int result = na
    if not na(offset) and offset >= 0 and offset <= bar_index
        float anchorClose = close[offset]
        float highWatermark = na
        for drawdownIndex = 0 to REGIME_DRAWDOWN_LOOKBACK - 1
            int highOffset = offset + drawdownIndex
            if highOffset <= bar_index
                float historicalHigh = high[highOffset]
                if not na(historicalHigh)
                    highWatermark := na(highWatermark) ? historicalHigh : math.max(highWatermark, historicalHigh)
        if not na(anchorClose) and anchorClose > 0 and not na(highWatermark) and highWatermark > 0
            float drawdown = anchorClose / highWatermark - 1.0
            result := drawdown >= -0.05 ? REGIME_DD_NEAR_HIGH : drawdown >= -0.15 ? REGIME_DD_CORRECTION : REGIME_DD_DEEP
    result

f_currentTrendRegime() =>
    f_trendRegimeAtOffset(0)

f_currentVolatilityRegime() =>
    f_volatilityRegimeAtOffset(0)

f_currentDrawdownRegime() =>
    f_drawdownRegimeAtOffset(0)

f_calendarSlot(int calendarMonth, int calendarDay) =>
    (calendarMonth - 1) * 31 + (calendarDay - 1)

f_daysInMonth(int calendarMonth) =>
    calendarMonth == 2 ? 28 : calendarMonth == 4 or calendarMonth == 6 or calendarMonth == 9 or calendarMonth == 11 ? 30 : 31

f_seasonTs(int seasonYear, int calendarMonth, int calendarDay) =>
    timestamp("UTC", seasonYear, calendarMonth, calendarDay, 0, 0)

f_calendarOrdinal(int calendarMonth, int calendarDay) =>
    int ordinal = calendarDay
    if calendarMonth > 1
        for monthIndex = 1 to calendarMonth - 1
            ordinal += f_daysInMonth(monthIndex)
    ordinal

f_slotFromOrdinal(int ordinal) =>
    int result = na
    if ordinal >= 1 and ordinal <= 365
        int daysBeforeMonth = 0
        for monthIndex = 1 to 12
            int monthDays = f_daysInMonth(monthIndex)
            if na(result) and ordinal <= daysBeforeMonth + monthDays
                int calendarDay = ordinal - daysBeforeMonth
                result := f_calendarSlot(monthIndex, calendarDay)
            daysBeforeMonth += monthDays
    result

f_slotAtCalendarOffset(int calendarMonth, int calendarDay, int dayOffset) =>
    f_slotFromOrdinal(f_calendarOrdinal(calendarMonth, calendarDay) + dayOffset)

f_monthShort(int calendarMonth) =>
    calendarMonth == 1 ? "Jan" : calendarMonth == 2 ? "Feb" : calendarMonth == 3 ? "Mar" : calendarMonth == 4 ? "Apr" : calendarMonth == 5 ? "May" : calendarMonth == 6 ? "Jun" : calendarMonth == 7 ? "Jul" : calendarMonth == 8 ? "Aug" : calendarMonth == 9 ? "Sep" : calendarMonth == 10 ? "Oct" : calendarMonth == 11 ? "Nov" : "Dec"

f_formatDate(int calendarMonth, int calendarDay) =>
    f_monthShort(calendarMonth) + " " + str.tostring(calendarDay)

f_formatSignedPct(float value) =>
    na(value) ? "—" : (value > 0 ? "+" : "") + str.tostring(value, "#.##") + " %"

f_formatRiskPct(float value) =>
    na(value) ? "—" : str.tostring(value, "#.##") + " %"

f_formatRewardRisk(float value) =>
    na(value) ? "—" : str.tostring(value, "#.##") + "x"

f_formatEvidenceLabel(string label) =>
    string result = EVIDENCE_NA
    if label == EVIDENCE_STRONG
        result := EVIDENCE_STRONG
    else if label == EVIDENCE_GOOD
        result := EVIDENCE_GOOD
    else if label == EVIDENCE_MIXED
        result := EVIDENCE_MIXED
    else if label == EVIDENCE_WEAK
        result := EVIDENCE_WEAK
    else if label == EVIDENCE_LOW_SAMPLE
        result := EVIDENCE_LOW_SAMPLE
    result

f_formatRiskContext(string label) =>
    string result = RISK_CONTEXT_NA
    if label == RISK_CONTEXT_MODERATE
        result := RISK_CONTEXT_MODERATE
    else if label == RISK_CONTEXT_ELEVATED
        result := RISK_CONTEXT_ELEVATED
    else if label == RISK_CONTEXT_HIGH
        result := RISK_CONTEXT_HIGH
    result

f_formatRegimeTrend(int regime) =>
    na(regime) ? "—" : regime == REGIME_TREND_BULL ? "Bull" : regime == REGIME_TREND_BEAR ? "Bear" : regime == REGIME_TREND_NEUTRAL ? "Neutral" : "—"

f_formatRegimeVol(int regime) =>
    na(regime) ? "Vol n/a" : regime == REGIME_VOL_LOW ? "Low" : regime == REGIME_VOL_NORMAL ? "Normal" : regime == REGIME_VOL_HIGH ? "High" : "Vol n/a"

f_formatRegimeDrawdown(int regime) =>
    na(regime) ? "—" : regime == REGIME_DD_NEAR_HIGH ? "Near High" : regime == REGIME_DD_CORRECTION ? "Correction" : regime == REGIME_DD_DEEP ? "Deep DD" : "—"

f_formatMatchMode(int mode) =>
    mode == MATCH_MODE_STRICT ? "Strict" : mode == MATCH_MODE_RELAXED ? "Relaxed" : mode == MATCH_MODE_LOW_SAMPLE ? "Low sample" : "n/a"

f_formatSampleCoverage(int actualSamples, int requestedYears) =>
    float coveragePct = requestedYears > 0 ? actualSamples * 100.0 / requestedYears : na
    str.tostring(actualSamples) + "/" + str.tostring(requestedYears) + (na(coveragePct) ? "" : " · " + str.tostring(coveragePct, "#") + "%")

f_median(array<float> values) =>
    float result = na
    int valueCount = array.size(values)
    if valueCount > 0
        array<float> sortedValues = array.copy(values)
        array.sort(sortedValues, order.ascending)
        int middleIndex = int(math.floor(valueCount * 0.5))
        result := valueCount % 2 == 1 ? array.get(sortedValues, middleIndex) : (array.get(sortedValues, middleIndex - 1) + array.get(sortedValues, middleIndex)) * 0.5
    result

f_percentile(array<float> values, float percentile) =>
    float result = na
    int valueCount = array.size(values)
    if valueCount > 0
        array<float> sortedValues = array.copy(values)
        array.sort(sortedValues, order.ascending)
        float boundedPercentile = math.max(0.0, math.min(percentile, 1.0))
        float rawIndex = (valueCount - 1) * boundedPercentile
        int lowerIndex = int(math.floor(rawIndex))
        int upperIndex = int(math.ceil(rawIndex))
        float lowerValue = array.get(sortedValues, lowerIndex)
        float upperValue = array.get(sortedValues, upperIndex)
        result := lowerIndex == upperIndex ? lowerValue : lowerValue + (upperValue - lowerValue) * (rawIndex - lowerIndex)
    result

f_reliabilityLabel(int actualSamples, int expectedSamples) =>
    float coverage = expectedSamples > 0 ? actualSamples * 100.0 / expectedSamples : na
    string result = na(coverage) ? "N/A" : actualSamples < 5 ? "Weak" : actualSamples <= 7 ? (coverage >= 50.0 ? "Limited" : "Weak") : coverage >= 80.0 ? "Good" : coverage >= 50.0 ? "Limited" : "Weak"
    [result, coverage]

f_formatRate(float value) =>
    na(value) ? "—" : str.tostring(value, "#") + " %"

f_formatSamples(int actualSamples, int expectedSamples) =>
    str.tostring(actualSamples) + "/" + str.tostring(expectedSamples)

f_formatConditionalSamples(int actualSamples, int expectedSamples) =>
    f_formatSamples(actualSamples, expectedSamples) + (actualSamples < CONDITIONAL_MIN_MATCHED_SAMPLES ? " Low" : "")

f_formatConditionalSignedPct(float value, int matchedSamples) =>
    matchedSamples < CONDITIONAL_MIN_MATCHED_SAMPLES ? "—" : f_formatSignedPct(value)

f_formatConditionalRate(float value, int matchedSamples) =>
    matchedSamples < CONDITIONAL_MIN_MATCHED_SAMPLES ? "—" : f_formatRate(value)

f_formatConditionalRiskPct(float value, int matchedSamples) =>
    matchedSamples < CONDITIONAL_MIN_MATCHED_SAMPLES ? "—" : f_formatRiskPct(value)

f_reliabilityColor(string reliability) =>
    reliability == "Good" ? color.new(color.green, 45) : reliability == "Limited" ? color.new(color.yellow, 35) : reliability == "Weak" ? color.new(color.red, 45) : panelMutedTextColor

f_evidenceTextColor(string label) =>
    label == EVIDENCE_STRONG ? color.new(color.green, 20) : label == EVIDENCE_GOOD ? color.new(color.green, 35) : label == EVIDENCE_MIXED ? color.new(color.orange, 25) : label == EVIDENCE_WEAK ? color.new(color.red, 35) : label == EVIDENCE_LOW_SAMPLE ? color.new(color.yellow, 35) : panelMutedTextColor

f_riskContextTextColor(string label) =>
    label == RISK_CONTEXT_MODERATE ? color.new(color.green, 40) : label == RISK_CONTEXT_ELEVATED ? color.new(color.orange, 25) : label == RISK_CONTEXT_HIGH ? color.new(color.red, 35) : panelMutedTextColor

f_isNearZeroPct(float value) =>
    na(value) or math.abs(value) < EVIDENCE_NEAR_ZERO_PCT

f_sameDirectionalSign(float a, float b) =>
    not f_isNearZeroPct(a) and not f_isNearZeroPct(b) and ((a > 0 and b > 0) or (a < 0 and b < 0))

f_directionConsistency(float medianDelta, float positiveRate) =>
    float result = na
    if not na(medianDelta) and not na(positiveRate)
        result := medianDelta >= 0 ? positiveRate : 100.0 - positiveRate
    result

f_avgMedianAgreementScore(float avgDelta, float medianDelta) =>
    int result = 0
    if not f_isNearZeroPct(avgDelta) and not f_isNearZeroPct(medianDelta)
        result := f_sameDirectionalSign(avgDelta, medianDelta) ? 2 : -2
    result

f_directionConsistencyScore(float medianDelta, float positiveRate) =>
    int result = 0
    float consistency = f_directionConsistency(medianDelta, positiveRate)
    if not f_isNearZeroPct(medianDelta) and not na(consistency)
        result := consistency >= 65.0 ? 2 : consistency >= 60.0 ? 1 : consistency < 45.0 ? -1 : 0
    result

f_riskContextLabel(float medianDelta, float medianAdverse, float worstAdverse, float medianFavorable, float rewardRisk) =>
    string result = RISK_CONTEXT_NA
    if not na(medianDelta) and not na(medianAdverse) and not na(rewardRisk)
        float medianMagnitude = math.abs(medianDelta)
        float medianAdverseMagnitude = math.abs(medianAdverse)
        float worstAdverseMagnitude = math.abs(worstAdverse)
        if medianMagnitude < EVIDENCE_NEAR_ZERO_PCT
            result := RISK_CONTEXT_ELEVATED
        else if medianAdverseMagnitude > medianMagnitude * 4.0 or rewardRisk < 0.5 or (not na(worstAdverse) and worstAdverseMagnitude > medianMagnitude * 8.0)
            result := RISK_CONTEXT_HIGH
        else if medianAdverseMagnitude > medianMagnitude * 2.5 or rewardRisk < 0.8
            result := RISK_CONTEXT_ELEVATED
        else
            result := RISK_CONTEXT_MODERATE
    result

f_riskContextScore(string riskContext) =>
    riskContext == RISK_CONTEXT_MODERATE ? 1 : riskContext == RISK_CONTEXT_ELEVATED ? -1 : riskContext == RISK_CONTEXT_HIGH ? -2 : 0

f_fullRecentStabilityScore(float fullDelta, float recentDelta) =>
    int result = 0
    if not f_isNearZeroPct(fullDelta) and not f_isNearZeroPct(recentDelta)
        result := f_sameDirectionalSign(fullDelta, recentDelta) ? 2 : -2
    result

f_regimeMatchEvidenceScore(string conditionalView, string matchMode, int matchedSamples) =>
    int result = 0
    if not na(matchedSamples) and matchedSamples >= EVIDENCE_MIN_MATCHED_SAMPLES
        if conditionalView == "Contradicts"
            result := -2
        else if conditionalView == "Stronger" or conditionalView == "Confirms"
            result := matchMode == "Strict" ? 2 : matchMode == "Relaxed" ? 1 : 0
    result

f_sampleCoverageScore(int allSamples, int allExpected, int matchedSamples) =>
    int result = -2
    float coverage = not na(allSamples) and not na(allExpected) and allExpected > 0 ? allSamples * 1.0 / allExpected : na
    if not na(allSamples) and allSamples >= EVIDENCE_MIN_ALL_SAMPLES and not na(coverage)
        result := coverage < 0.40 ? -2 : coverage < 0.60 ? -1 : coverage < 0.75 ? 0 : coverage < 0.85 ? 1 : 2
        result += not na(matchedSamples) and matchedSamples >= 8 ? 1 : 0
    math.max(-2, math.min(2, result))

f_seasonalEvidenceLabel(float allAvg, float allMedian, float allPositiveRate, int allSamples, int allExpectedSamples, float recentDelta, float matchedMedian, float matchedPositiveRate, int matchedSamples, string conditionalView, string matchMode, float medianAdverse, float worstAdverse, float medianFavorable, float rewardRisk) =>
    string result = EVIDENCE_NA
    bool missingSamples = na(allSamples) or na(allExpectedSamples) or allExpectedSamples <= 0
    bool missingCore = na(allAvg) or na(allMedian) or na(allPositiveRate)
    if missingSamples
        result := EVIDENCE_NA
    else if allSamples < EVIDENCE_MIN_ALL_SAMPLES or missingCore
        result := EVIDENCE_LOW_SAMPLE
    else
        string riskContext = f_riskContextLabel(allMedian, medianAdverse, worstAdverse, medianFavorable, rewardRisk)
        int sampleScore = f_sampleCoverageScore(allSamples, allExpectedSamples, matchedSamples)
        int avgMedianScore = f_avgMedianAgreementScore(allAvg, allMedian)
        int directionScore = f_directionConsistencyScore(allMedian, allPositiveRate)
        int fullRecentScore = f_fullRecentStabilityScore(allAvg, recentDelta)
        int regimeScore = f_regimeMatchEvidenceScore(conditionalView, matchMode, matchedSamples)
        int riskScore = f_riskContextScore(riskContext)
        int totalScore = sampleScore + avgMedianScore + directionScore + fullRecentScore + regimeScore + riskScore
        float allCoverage = allSamples * 1.0 / allExpectedSamples
        bool hasMatchedSamples = not na(matchedSamples) and matchedSamples >= EVIDENCE_MIN_MATCHED_SAMPLES
        bool hasMatchedValues = hasMatchedSamples and not na(matchedMedian) and not na(matchedPositiveRate)
        bool strongSampleBase = allSamples >= 10 and not na(matchedSamples) and matchedSamples >= 8
        bool strongCoverage = allCoverage >= 0.75
        bool strictMatch = matchMode == "Strict"
        bool weakCoverage = allCoverage < 0.60
        bool limitedCoverage = allCoverage < 0.75
        bool contradicts = conditionalView == "Contradicts" and hasMatchedSamples
        bool highRisk = riskContext == RISK_CONTEXT_HIGH
        bool relaxedMatch = matchMode == "Relaxed" and hasMatchedSamples
        bool avgMedianConflict = avgMedianScore == -2 and directionScore <= 0
        bool nearZeroMedian = f_isNearZeroPct(allMedian)
        if totalScore >= 7 and not contradicts and not highRisk and not relaxedMatch and not avgMedianConflict and not nearZeroMedian and hasMatchedValues and strongSampleBase and strongCoverage and strictMatch and regimeScore > 0 and fullRecentScore > 0 and riskContext != RISK_CONTEXT_NA
            result := EVIDENCE_STRONG
        else if totalScore >= 4 and not contradicts and not highRisk and not avgMedianConflict and not nearZeroMedian
            result := EVIDENCE_GOOD
        else if totalScore >= 1 or contradicts or highRisk or avgMedianConflict or nearZeroMedian
            result := EVIDENCE_MIXED
        else
            result := EVIDENCE_WEAK
        if relaxedMatch and result == EVIDENCE_STRONG
            result := EVIDENCE_GOOD
        if limitedCoverage and result == EVIDENCE_STRONG
            result := EVIDENCE_GOOD
        if (weakCoverage or contradicts or highRisk or avgMedianConflict or nearZeroMedian) and (result == EVIDENCE_STRONG or result == EVIDENCE_GOOD)
            result := EVIDENCE_MIXED
    result

f_seasonalEvidenceReason(string evidenceLabel, string conditionalView, string matchMode, int allSamples, int allExpectedSamples, int matchedSamples, float allAvg, float allMedian, float recentDelta, string riskContext, float directionConsistency) =>
    string result = EVIDENCE_NA
    bool hasAllSamples = not na(allSamples) and allSamples >= EVIDENCE_MIN_ALL_SAMPLES
    bool hasMatchedSamples = not na(matchedSamples) and matchedSamples >= EVIDENCE_MIN_MATCHED_SAMPLES
    float allCoverage = not na(allSamples) and not na(allExpectedSamples) and allExpectedSamples > 0 ? allSamples * 1.0 / allExpectedSamples : na
    if evidenceLabel == EVIDENCE_LOW_SAMPLE or not hasAllSamples
        result := "Low samples"
    else if not na(allCoverage) and allCoverage < 0.60
        result := "Weak coverage"
    else if conditionalView == "Contradicts" and hasMatchedSamples
        result := "Regime contradicts"
    else if riskContext == RISK_CONTEXT_HIGH
        result := "High path risk"
    else if not f_isNearZeroPct(allAvg) and not f_isNearZeroPct(recentDelta) and not f_sameDirectionalSign(allAvg, recentDelta)
        result := "Recent contradicts"
    else if f_avgMedianAgreementScore(allAvg, allMedian) == -2
        result := "Avg/Median mixed"
    else if matchMode == "Relaxed" and hasMatchedSamples
        result := "Relaxed match only"
    else if (conditionalView == "Confirms" or conditionalView == "Stronger") and hasMatchedSamples
        result := "Regime confirms"
    else if f_avgMedianAgreementScore(allAvg, allMedian) == 2 or (not na(directionConsistency) and directionConsistency >= 60.0)
        result := "Median confirms"
    else if riskContext == RISK_CONTEXT_MODERATE
        result := "Moderate path risk"
    result

f_alignmentStatus(float classic30Delta, int tacticalCurrentState, int tacticalDominantFutureState, float tacticalConfidence, string reliability) =>
    bool reliable = reliability != "Weak" and reliability != "N/A"
    bool confidenceOk = not na(tacticalConfidence) and tacticalConfidence >= 55.0
    bool classicPositive = not na(classic30Delta) and classic30Delta > 0.50
    bool classicNegative = not na(classic30Delta) and classic30Delta < -0.50
    bool tacticalPositive = tacticalCurrentState == STATE_LONG or tacticalDominantFutureState == STATE_LONG
    bool tacticalNegative = tacticalCurrentState == STATE_SHORT or tacticalDominantFutureState == STATE_SHORT
    bool tacticalRange = tacticalCurrentState == STATE_RANGE and tacticalDominantFutureState == STATE_RANGE
    string result = "Mixed"
    if not reliable
        result := "Low Reliability"
    else if (classicPositive and tacticalNegative) or (classicNegative and tacticalPositive)
        result := "Conflict"
    else if tacticalRange and not classicPositive and not classicNegative
        result := "Range / Neutral"
    else if classicPositive and tacticalPositive and confidenceOk
        result := "Aligned Positive"
    else if classicNegative and tacticalNegative and confidenceOk
        result := "Aligned Negative"
    result

f_stabilityStatus(float longDelta, float recentDelta, string longReliability, string recentReliability) =>
    bool longReliable = longReliability != "Weak" and longReliability != "N/A"
    bool recentReliable = recentReliability != "Weak" and recentReliability != "N/A"
    bool longPositive = not na(longDelta) and longDelta > 0.50
    bool longNegative = not na(longDelta) and longDelta < -0.50
    bool recentPositive = not na(recentDelta) and recentDelta > 0.50
    bool recentNegative = not na(recentDelta) and recentDelta < -0.50
    string result = "Neutral"
    if not longReliable or not recentReliable or na(longDelta) or na(recentDelta)
        result := "Low Data"
    else if (longPositive and recentNegative) or (longNegative and recentPositive)
        result := "Unstable"
    else if longPositive and recentPositive
        result := "Stable Positive"
    else if longNegative and recentNegative
        result := "Stable Negative"
    else if (longPositive or longNegative) and not recentPositive and not recentNegative
        result := "Fading"
    else if not longPositive and not longNegative and (recentPositive or recentNegative)
        result := "Emerging"
    result

f_currentYearDeviationStatus(float deviation) =>
    na(deviation) ? "N/A" : math.abs(deviation) < 1.0 ? "Near Classic" : deviation > 0 ? "Above Classic" : "Below Classic"

f_currentYearBandPosition(float currentYearValue, float lowerBand, float upperBand) =>
    na(currentYearValue) or na(lowerBand) or na(upperBand) ? "N/A" : currentYearValue > upperBand ? "Above Band" : currentYearValue < lowerBand ? "Below Band" : "Within Band"

f_turnTypeText(int turnType) =>
    turnType == TURN_PEAK ? "Seasonal Peak" : turnType == TURN_TROUGH ? "Seasonal Trough" : "—"

