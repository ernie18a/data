f_forwardHorizonStatsFromAnchors(array<int> anchorOffsets, int horizon, bool includeRisk) =>
    array<float> returns = array.new_float()
    array<float> adverseMoves = array.new_float()
    array<float> favorableMoves = array.new_float()
    float returnSum = 0.0
    int positiveCount = 0
    int anchorCount = array.size(anchorOffsets)
    if anchorCount > 0
        for anchorIndex = 0 to anchorCount - 1
            int anchorOffset = array.get(anchorOffsets, anchorIndex)
            int forwardOffset = anchorOffset - horizon
            bool validOffsets = not na(anchorOffset) and anchorOffset >= horizon and anchorOffset <= bar_index and forwardOffset >= 0 and forwardOffset <= bar_index and forwardOffset < anchorOffset
            if validOffsets
                float anchorPrice = close[anchorOffset]
                float forwardPrice = close[forwardOffset]
                if not na(anchorPrice) and not na(forwardPrice) and anchorPrice > 0 and forwardPrice > 0
                    float seasonalDelta = (forwardPrice / anchorPrice - 1.0) * 100.0
                    array.push(returns, seasonalDelta)
                    returnSum += seasonalDelta
                    positiveCount += seasonalDelta > 0 ? 1 : 0
    int samples = array.size(returns)
    float averageDelta = samples > 0 ? returnSum / samples : na
    float medianDelta = f_median(returns)
    float positiveRate = samples > 0 ? positiveCount * 100.0 / samples : na
    if includeRisk and not na(medianDelta) and anchorCount > 0
        bool expectedLong = medianDelta >= 0
        for anchorIndex = 0 to anchorCount - 1
            int anchorOffset = array.get(anchorOffsets, anchorIndex)
            int forwardOffset = anchorOffset - horizon
            bool validOffsets = not na(anchorOffset) and anchorOffset >= horizon and anchorOffset <= bar_index and forwardOffset >= 0 and forwardOffset <= bar_index and forwardOffset < anchorOffset
            if validOffsets
                float anchorPrice = close[anchorOffset]
                float forwardPrice = close[forwardOffset]
                if not na(anchorPrice) and not na(forwardPrice) and anchorPrice > 0 and forwardPrice > 0
                    float windowHigh = na
                    float windowLow = na
                    bool validPath = true
                    for pathOffset = forwardOffset to anchorOffset - 1
                        float pathHigh = high[pathOffset]
                        float pathLow = low[pathOffset]
                        if na(pathHigh) or na(pathLow) or pathHigh <= 0 or pathLow <= 0
                            validPath := false
                        else
                            windowHigh := na(windowHigh) ? pathHigh : math.max(windowHigh, pathHigh)
                            windowLow := na(windowLow) ? pathLow : math.min(windowLow, pathLow)
                    if validPath and not na(windowHigh) and not na(windowLow)
                        float adverseMove = expectedLong ? (windowLow / anchorPrice - 1.0) * 100.0 : (1.0 - windowHigh / anchorPrice) * 100.0
                        float favorableMove = expectedLong ? (windowHigh / anchorPrice - 1.0) * 100.0 : (1.0 - windowLow / anchorPrice) * 100.0
                        array.push(adverseMoves, math.min(adverseMove, 0.0))
                        array.push(favorableMoves, math.max(favorableMove, 0.0))
    float medianAdverse = f_median(adverseMoves)
    float worstAdverse = array.size(adverseMoves) > 0 ? array.min(adverseMoves) : na
    float medianFavorable = f_median(favorableMoves)
    float rewardRisk = not na(medianFavorable) and not na(medianAdverse) and medianAdverse < 0 ? math.abs(medianFavorable / medianAdverse) : na
    [averageDelta, medianDelta, positiveRate, samples, medianAdverse, worstAdverse, medianFavorable, rewardRisk]

f_buildForwardHorizonStats(array<int> anchorOffsets, int expectedSamples) =>
    f_clearForwardHorizonStats()
    for horizonIndex = 0 to HORIZON_COUNT - 1
        int horizon = array.get(horizonDays, horizonIndex)
        [averageDelta, medianDelta, positiveRate, samples, medianAdverse, worstAdverse, medianFavorable, rewardRisk] = f_forwardHorizonStatsFromAnchors(anchorOffsets, horizon, true)
        [reliability, coverage] = f_reliabilityLabel(samples, expectedSamples)
        array.push(horizonAvgDelta, averageDelta)
        array.push(horizonMedianDelta, medianDelta)
        array.push(horizonPositiveRate, positiveRate)
        array.push(horizonMedianAdverse, medianAdverse)
        array.push(horizonWorstAdverse, worstAdverse)
        array.push(horizonMedianFavorable, medianFavorable)
        array.push(horizonRewardRisk, rewardRisk)
        array.push(horizonSampleCount, samples)
        array.push(horizonExpectedSamples, expectedSamples)
        array.push(horizonCoverage, coverage)
        array.push(horizonReliability, reliability)

f_copyForwardHorizonStats(array<float> averages, array<float> medians, array<float> positiveRates, array<float> medianAdverses, array<float> worstAdverses, array<float> medianFavorables, array<float> rewardRisks, array<int> samples, array<int> expectedSamples) =>
    f_clearForwardHorizonStats()
    bool collectionsAvailable = not na(averages) and not na(medians) and not na(positiveRates) and not na(medianAdverses) and not na(worstAdverses) and not na(medianFavorables) and not na(rewardRisks) and not na(samples) and not na(expectedSamples)
    int availableReturnResults = collectionsAvailable ? math.min(array.size(averages), math.min(array.size(medians), array.size(positiveRates))) : 0
    int availableRiskResults = collectionsAvailable ? math.min(array.size(medianAdverses), math.min(array.size(worstAdverses), math.min(array.size(medianFavorables), array.size(rewardRisks)))) : 0
    int availableSampleResults = collectionsAvailable ? math.min(array.size(samples), array.size(expectedSamples)) : 0
    int resultCount = math.min(HORIZON_COUNT, math.min(availableReturnResults, math.min(availableRiskResults, availableSampleResults)))
    if resultCount == HORIZON_COUNT
        for horizonIndex = 0 to resultCount - 1
            int actualSamples = array.get(samples, horizonIndex)
            int requestedSamples = array.get(expectedSamples, horizonIndex)
            [reliability, coverage] = f_reliabilityLabel(actualSamples, requestedSamples)
            array.push(horizonAvgDelta, array.get(averages, horizonIndex))
            array.push(horizonMedianDelta, array.get(medians, horizonIndex))
            array.push(horizonPositiveRate, array.get(positiveRates, horizonIndex))
            array.push(horizonMedianAdverse, array.get(medianAdverses, horizonIndex))
            array.push(horizonWorstAdverse, array.get(worstAdverses, horizonIndex))
            array.push(horizonMedianFavorable, array.get(medianFavorables, horizonIndex))
            array.push(horizonRewardRisk, array.get(rewardRisks, horizonIndex))
            array.push(horizonSampleCount, actualSamples)
            array.push(horizonExpectedSamples, requestedSamples)
            array.push(horizonCoverage, coverage)
            array.push(horizonReliability, reliability)

f_hasCompleteHorizonStats() =>
    array.size(horizonAvgDelta) == HORIZON_COUNT and array.size(horizonMedianDelta) == HORIZON_COUNT and array.size(horizonPositiveRate) == HORIZON_COUNT and array.size(horizonMedianAdverse) == HORIZON_COUNT and array.size(horizonWorstAdverse) == HORIZON_COUNT and array.size(horizonMedianFavorable) == HORIZON_COUNT and array.size(horizonRewardRisk) == HORIZON_COUNT and array.size(horizonSampleCount) == HORIZON_COUNT and array.size(horizonExpectedSamples) == HORIZON_COUNT and array.size(horizonCoverage) == HORIZON_COUNT and array.size(horizonReliability) == HORIZON_COUNT

f_regimeMatchScore(int currentTrend, int currentVol, int currentDrawdown, int historicalTrend, int historicalVol, int historicalDrawdown) =>
    int score = 0
    if not na(currentTrend) and not na(historicalTrend)
        score += currentTrend == historicalTrend ? 2 : 0
        if not na(currentVol) and not na(historicalVol)
            score += currentVol == historicalVol ? 1 : 0
        if not na(currentDrawdown) and not na(historicalDrawdown)
            score += currentDrawdown == historicalDrawdown ? 1 : 0
    score

f_isRegimeMatched(int currentTrend, int currentVol, int currentDrawdown, int historicalTrend, int historicalVol, int historicalDrawdown) =>
    bool trendMatched = not na(currentTrend) and not na(historicalTrend) and currentTrend == historicalTrend
    trendMatched and f_regimeMatchScore(currentTrend, currentVol, currentDrawdown, historicalTrend, historicalVol, historicalDrawdown) >= 3

f_filterRegimeMatchedAnchors(array<int> anchorOffsets) =>
    array<int> resultOffsets = array.new_int()
    int currentTrend = f_currentTrendRegime()
    int currentVol = f_currentVolatilityRegime()
    int currentDrawdown = f_currentDrawdownRegime()
    int anchorCount = array.size(anchorOffsets)
    if not na(currentTrend) and anchorCount > 0
        for anchorIndex = 0 to anchorCount - 1
            int anchorOffset = array.get(anchorOffsets, anchorIndex)
            if not na(anchorOffset) and anchorOffset >= 0 and anchorOffset <= bar_index
                int historicalTrend = f_trendRegimeAtOffset(anchorOffset)
                int historicalVol = f_volatilityRegimeAtOffset(anchorOffset)
                int historicalDrawdown = f_drawdownRegimeAtOffset(anchorOffset)
                if f_isRegimeMatched(currentTrend, currentVol, currentDrawdown, historicalTrend, historicalVol, historicalDrawdown)
                    array.push(resultOffsets, anchorOffset)
        if array.size(resultOffsets) < CONDITIONAL_MIN_MATCHED_SAMPLES
            array.clear(resultOffsets)
            for anchorIndex = 0 to anchorCount - 1
                int anchorOffset = array.get(anchorOffsets, anchorIndex)
                if not na(anchorOffset) and anchorOffset >= 0 and anchorOffset <= bar_index
                    int historicalTrend = f_trendRegimeAtOffset(anchorOffset)
                    int historicalVol = f_volatilityRegimeAtOffset(anchorOffset)
                    int historicalDrawdown = f_drawdownRegimeAtOffset(anchorOffset)
                    int score = f_regimeMatchScore(currentTrend, currentVol, currentDrawdown, historicalTrend, historicalVol, historicalDrawdown)
                    bool trendMatched = not na(historicalTrend) and currentTrend == historicalTrend
                    bool relaxedMatch = trendMatched or (currentTrend == REGIME_TREND_NEUTRAL and score >= 1)
                    if relaxedMatch
                        array.push(resultOffsets, anchorOffset)
    resultOffsets

f_strictRegimeMatchedAnchorCount(array<int> anchorOffsets) =>
    int result = 0
    int currentTrend = f_currentTrendRegime()
    int currentVol = f_currentVolatilityRegime()
    int currentDrawdown = f_currentDrawdownRegime()
    int anchorCount = array.size(anchorOffsets)
    if not na(currentTrend) and anchorCount > 0
        for anchorIndex = 0 to anchorCount - 1
            int anchorOffset = array.get(anchorOffsets, anchorIndex)
            if not na(anchorOffset) and anchorOffset >= 0 and anchorOffset <= bar_index
                int historicalTrend = f_trendRegimeAtOffset(anchorOffset)
                int historicalVol = f_volatilityRegimeAtOffset(anchorOffset)
                int historicalDrawdown = f_drawdownRegimeAtOffset(anchorOffset)
                result += f_isRegimeMatched(currentTrend, currentVol, currentDrawdown, historicalTrend, historicalVol, historicalDrawdown) ? 1 : 0
    result

f_regimeMatchModeFromCounts(int strictMatches, int finalMatches) =>
    na(finalMatches) ? MATCH_MODE_NA : finalMatches < CONDITIONAL_MIN_MATCHED_SAMPLES ? MATCH_MODE_LOW_SAMPLE : strictMatches >= CONDITIONAL_MIN_MATCHED_SAMPLES ? MATCH_MODE_STRICT : MATCH_MODE_RELAXED

f_buildConditionalHorizonStats(array<int> anchorOffsets, int expectedSamples) =>
    f_clearConditionalHorizonStats()
    int strictMatchedSamples = f_strictRegimeMatchedAnchorCount(anchorOffsets)
    array<int> matchedAnchorOffsets = f_filterRegimeMatchedAnchors(anchorOffsets)
    int matchedExpectedSamples = array.size(matchedAnchorOffsets)
    int totalExpectedSamples = math.max(expectedSamples, matchedExpectedSamples)
    int matchMode = f_regimeMatchModeFromCounts(strictMatchedSamples, matchedExpectedSamples)
    for horizonIndex = 0 to HORIZON_COUNT - 1
        int horizon = array.get(horizonDays, horizonIndex)
        [averageDelta, medianDelta, positiveRate, samples, medianAdverse, worstAdverse, medianFavorable, rewardRisk] = f_forwardHorizonStatsFromAnchors(matchedAnchorOffsets, horizon, true)
        [reliability, coverage] = f_reliabilityLabel(samples, totalExpectedSamples)
        array.push(conditionalHorizonAvgDelta, averageDelta)
        array.push(conditionalHorizonMedianDelta, medianDelta)
        array.push(conditionalHorizonPositiveRate, positiveRate)
        array.push(conditionalHorizonMedianAdverse, medianAdverse)
        array.push(conditionalHorizonWorstAdverse, worstAdverse)
        array.push(conditionalHorizonMedianFavorable, medianFavorable)
        array.push(conditionalHorizonRewardRisk, rewardRisk)
        array.push(conditionalHorizonSampleCount, samples)
        array.push(conditionalHorizonExpectedSamples, totalExpectedSamples)
        array.push(conditionalHorizonCoverage, coverage)
        array.push(conditionalHorizonReliability, reliability)
    [matchedExpectedSamples, matchMode]

f_hasCompleteConditionalHorizonStats() =>
    array.size(conditionalHorizonAvgDelta) == HORIZON_COUNT and array.size(conditionalHorizonMedianDelta) == HORIZON_COUNT and array.size(conditionalHorizonPositiveRate) == HORIZON_COUNT and array.size(conditionalHorizonMedianAdverse) == HORIZON_COUNT and array.size(conditionalHorizonWorstAdverse) == HORIZON_COUNT and array.size(conditionalHorizonMedianFavorable) == HORIZON_COUNT and array.size(conditionalHorizonRewardRisk) == HORIZON_COUNT and array.size(conditionalHorizonSampleCount) == HORIZON_COUNT and array.size(conditionalHorizonExpectedSamples) == HORIZON_COUNT and array.size(conditionalHorizonCoverage) == HORIZON_COUNT and array.size(conditionalHorizonReliability) == HORIZON_COUNT

f_findHorizonIndex(int targetDays) =>
