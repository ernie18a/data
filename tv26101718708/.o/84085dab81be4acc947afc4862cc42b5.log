            f_statusRow(statusTable, contextRow, "Forward 30D Δ", f_formatSignedPct(forward30Delta), PANEL_TIP_FORWARD_30D)
            contextRow += 1
            f_statusReliabilityRow(statusTable, contextRow, forward30Reliability, forward30Coverage, PANEL_TIP_RELIABILITY)
