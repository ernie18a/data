f_clearLines(array<line> lines) =>
    while array.size(lines) > 0
        line.delete(array.pop(lines))

f_clearBoxes(array<box> boxes) =>
    while array.size(boxes) > 0
        box.delete(array.pop(boxes))

f_clearLabels(array<label> labels) =>
    while array.size(labels) > 0
        label.delete(array.pop(labels))

// Raw Classic sums/counts accumulate bar by bar; rebuilds clear only derived arrays.
f_clearClassicDerivedArrays() =>
    for i = 0 to CLASSIC_SLOT_COUNT - 1
        array.set(classicAvgReturn, i, na)
        array.set(classicCumReturn, i, na)
    array.clear(classicMonth)
    array.clear(classicDay)


f_clearRobustDistribution() =>
    for slot = 0 to CLASSIC_SLOT_COUNT - 1
        array.set(robustMedian, slot, na)
        array.set(robustP25, slot, na)
        array.set(robustP75, slot, na)
        array.set(robustP10, slot, na)
        array.set(robustP90, slot, na)
        array.set(robustSampleCount, slot, 0)
        array.set(robustCoverage, slot, na)
        array.set(robustReliability, slot, "N/A")

f_copyRobustDistribution(array<float> medians, array<float> p25Values, array<float> p75Values, array<float> p10Values, array<float> p90Values, array<int> samples, int expectedSamples) =>
    f_clearRobustDistribution()
    bool collectionsAvailable = not na(medians) and not na(p25Values) and not na(p75Values) and not na(p10Values) and not na(p90Values) and not na(samples)
    int availablePrimary = collectionsAvailable ? math.min(array.size(medians), math.min(array.size(p25Values), array.size(p75Values))) : 0
    int availableWide = collectionsAvailable ? math.min(array.size(p10Values), array.size(p90Values)) : 0
    int resultCount = collectionsAvailable ? math.min(CLASSIC_SLOT_COUNT, math.min(availablePrimary, math.min(availableWide, array.size(samples)))) : 0
    if resultCount > 0
        for slot = 0 to resultCount - 1
            int actualSamples = array.get(samples, slot)
            [reliability, coverage] = f_reliabilityLabel(actualSamples, expectedSamples)
            array.set(robustMedian, slot, array.get(medians, slot))
            array.set(robustP25, slot, array.get(p25Values, slot))
            array.set(robustP75, slot, array.get(p75Values, slot))
            array.set(robustP10, slot, array.get(p10Values, slot))
            array.set(robustP90, slot, array.get(p90Values, slot))
            array.set(robustSampleCount, slot, actualSamples)
            array.set(robustCoverage, slot, coverage)
            array.set(robustReliability, slot, reliability)

f_hasRobustDistributionData() =>
    bool result = false
    for slot = 0 to CLASSIC_SLOT_COUNT - 1
        result := result or array.get(robustSampleCount, slot) > 0
    result

f_clearCurrentYearData() =>
    array.clear(currentYearMonth)
    array.clear(currentYearDay)
    array.clear(currentYearCumReturn)

f_copyCurrentYearData(array<int> months, array<int> days, array<float> returns) =>
    f_clearCurrentYearData()
    bool collectionsAvailable = not na(months) and not na(days) and not na(returns)
    int availableDatePoints = collectionsAvailable ? math.min(array.size(months), array.size(days)) : 0
    int pointCount = collectionsAvailable ? math.min(availableDatePoints, array.size(returns)) : 0
    if pointCount > 0
        for pointIndex = 0 to pointCount - 1
            array.push(currentYearMonth, array.get(months, pointIndex))
            array.push(currentYearDay, array.get(days, pointIndex))
            array.push(currentYearCumReturn, array.get(returns, pointIndex))

f_buildClassicCurve() =>
    f_clearClassicDerivedArrays()
    int minSamples = math.max(3, int(math.floor(classicLookbackYears * 0.25)))
    for slot = 0 to CLASSIC_SLOT_COUNT - 1
        int samples = array.get(classicReturnCount, slot)
        if samples >= minSamples
            array.set(classicAvgReturn, slot, array.get(classicReturnSum, slot) / samples)
    float cumulativeReturn = 0.0
    for calendarMonth = 1 to 12
        int monthDays = f_daysInMonth(calendarMonth)
        for calendarDay = 1 to monthDays
            int slot = f_calendarSlot(calendarMonth, calendarDay)
            float averageReturn = array.get(classicAvgReturn, slot)
            if not na(averageReturn)
                cumulativeReturn := classicCompounding ? (1.0 + cumulativeReturn) * (1.0 + averageReturn) - 1.0 : cumulativeReturn + averageReturn
                array.set(classicCumReturn, slot, cumulativeReturn * 100.0)
                array.push(classicMonth, calendarMonth)
                array.push(classicDay, calendarDay)

f_drawClassicCurve(int seasonYear) =>
    f_clearLines(classicLines)
    float yMin = na
    float yMax = na
    int previousTs = na
    float previousValue = na
    int pointCount = array.size(classicMonth)
    if pointCount > 0
        for pointIndex = 0 to pointCount - 1
            int calendarMonth = array.get(classicMonth, pointIndex)
            int calendarDay = array.get(classicDay, pointIndex)
            float currentValue = array.get(classicCumReturn, f_calendarSlot(calendarMonth, calendarDay))
            int currentTs = f_seasonTs(seasonYear, calendarMonth, calendarDay)
            if not na(currentValue)
                yMin := na(yMin) ? currentValue : math.min(yMin, currentValue)
                yMax := na(yMax) ? currentValue : math.max(yMax, currentValue)
                if not na(previousValue) and array.size(classicLines) < MAX_CLASSIC_LINES
                    line classicLine = line.new(previousTs, previousValue, currentTs, currentValue, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.aqua, 0), width = 2)
                    array.push(classicLines, classicLine)
                previousTs := currentTs
                previousValue := currentValue
    [yMin, yMax]


f_clearTurningPoints() =>
    array.clear(turnMonth)
    array.clear(turnDay)
    array.clear(turnValue)
    array.clear(turnType)

f_buildTurningPointsFromValues(array<float> sourceValues) =>
    f_clearTurningPoints()
    array<int> sourceMonth = array.new_int()
    array<int> sourceDay = array.new_int()
    for calendarMonth = 1 to 12
        for calendarDay = 1 to f_daysInMonth(calendarMonth)
            int slot = f_calendarSlot(calendarMonth, calendarDay)
            if not na(array.get(sourceValues, slot))
                array.push(sourceMonth, calendarMonth)
                array.push(sourceDay, calendarDay)
    int pointCount = array.size(sourceMonth)
    if pointCount >= TURN_PIVOT_RADIUS * 2 + 1
        int lastAcceptedOrdinal = na
        float lastAcceptedValue = na
        for pointIndex = TURN_PIVOT_RADIUS to pointCount - TURN_PIVOT_RADIUS - 1
            int calendarMonth = array.get(sourceMonth, pointIndex)
            int calendarDay = array.get(sourceDay, pointIndex)
            float candidateValue = array.get(sourceValues, f_calendarSlot(calendarMonth, calendarDay))
            bool isPeak = not na(candidateValue)
            bool isTrough = not na(candidateValue)
            for neighborIndex = pointIndex - TURN_PIVOT_RADIUS to pointIndex + TURN_PIVOT_RADIUS
                if neighborIndex != pointIndex
                    int neighborMonth = array.get(sourceMonth, neighborIndex)
                    int neighborDay = array.get(sourceDay, neighborIndex)
                    float neighborValue = array.get(sourceValues, f_calendarSlot(neighborMonth, neighborDay))
                    isPeak := isPeak and not na(neighborValue) and candidateValue > neighborValue
                    isTrough := isTrough and not na(neighborValue) and candidateValue < neighborValue
            if isPeak or isTrough
                int candidateOrdinal = f_calendarOrdinal(calendarMonth, calendarDay)
                bool enoughDistance = na(lastAcceptedOrdinal) or candidateOrdinal - lastAcceptedOrdinal >= TURN_MIN_CALENDAR_DAYS
                bool enoughChange = na(lastAcceptedValue) or math.abs(candidateValue - lastAcceptedValue) >= TURN_MIN_CHANGE
                if enoughDistance and enoughChange
                    array.push(turnMonth, calendarMonth)
                    array.push(turnDay, calendarDay)
                    array.push(turnValue, candidateValue)
                    array.push(turnType, isPeak ? TURN_PEAK : TURN_TROUGH)
                    lastAcceptedOrdinal := candidateOrdinal
                    lastAcceptedValue := candidateValue

f_buildClassicTurningPoints() =>
    f_buildTurningPointsFromValues(classicCumReturn)

f_buildRobustTurningPoints() =>
    f_buildTurningPointsFromValues(robustMedian)

f_nextTurningPoint(int currentMonth, int currentDay) =>
    int nextType = 0
    int daysUntil = na
    float nextValue = na
    int currentOrdinal = f_calendarOrdinal(currentMonth, currentDay)
    int turnCount = array.size(turnType)
    if turnCount > 0
        for turnIndex = 0 to turnCount - 1
            int candidateOrdinal = f_calendarOrdinal(array.get(turnMonth, turnIndex), array.get(turnDay, turnIndex))
            if na(daysUntil) and candidateOrdinal > currentOrdinal
                nextType := array.get(turnType, turnIndex)
                daysUntil := candidateOrdinal - currentOrdinal
                nextValue := array.get(turnValue, turnIndex)
    [nextType, daysUntil, nextValue]

f_drawTurningPoints(int seasonYear, float displayYMin, float displayYMax) =>
    f_clearLines(turnMarkers)
    f_clearLabels(turnLabels)
    if (showClassicMode or showRobustMode) and showTurningPoints
        float markerMin = na(displayYMin) ? -1.0 : math.min(displayYMin, 0.0)
        float markerMax = na(displayYMax) ? 1.0 : math.max(displayYMax, 0.0)
        float markerRange = math.max(markerMax - markerMin, 1.0)
        float markerPadding = markerRange * 0.04
        int turnCount = array.size(turnType)
        if turnCount > 0
            for turnIndex = 0 to turnCount - 1
                int candidateType = array.get(turnType, turnIndex)
                int candidateTs = f_seasonTs(seasonYear, array.get(turnMonth, turnIndex), array.get(turnDay, turnIndex))
                float candidateValue = array.get(turnValue, turnIndex)
                color markerColor = candidateType == TURN_PEAK ? color.new(color.red, 55) : color.new(color.green, 55)
                if array.size(turnMarkers) < MAX_TURN_MARKERS
                    line turnMarker = line.new(candidateTs, markerMin - markerPadding, candidateTs, markerMax + markerPadding, xloc = xloc.bar_time, extend = extend.none, color = markerColor, style = line.style_dotted, width = 1)
                    array.push(turnMarkers, turnMarker)
                if array.size(turnLabels) < MAX_TURN_LABELS
                    string labelText = candidateType == TURN_PEAK ? "Peak" : "Trough"
                    label turnLabel = label.new(candidateTs, candidateValue, labelText, xloc = xloc.bar_time, style = label.style_none, textcolor = markerColor, size = size.small, tooltip = candidateType == TURN_PEAK ? PANEL_TIP_PEAK_LABEL : PANEL_TIP_TROUGH_LABEL)
                    array.push(turnLabels, turnLabel)

f_drawRobustBand(array<float> lowerValues, array<float> upperValues, array<box> bandBoxes, int seasonYear, color bandColor) =>
    f_clearBoxes(bandBoxes)
    array<int> validSlots = array.new_int()
    for calendarMonth = 1 to 12
        for calendarDay = 1 to f_daysInMonth(calendarMonth)
            int slot = f_calendarSlot(calendarMonth, calendarDay)
            if not na(array.get(lowerValues, slot)) and not na(array.get(upperValues, slot))
                array.push(validSlots, slot)
    int pointCount = array.size(validSlots)
    if pointCount > 1
        int stride = math.max(1, int(math.ceil((pointCount - 1) * 1.0 / MAX_ROBUST_BAND_BOXES)))
        int previousIndex = 0
        while previousIndex < pointCount - 1 and array.size(bandBoxes) < MAX_ROBUST_BAND_BOXES
            int currentIndex = math.min(previousIndex + stride, pointCount - 1)
            int previousSlot = array.get(validSlots, previousIndex)
            int currentSlot = array.get(validSlots, currentIndex)
            int previousOrdinal = 1
            int currentOrdinal = 1
            int previousMonth = 1
            int previousDay = 1
            int currentMonth = 1
            int currentDay = 1
            for calendarMonth = 1 to 12
                for calendarDay = 1 to f_daysInMonth(calendarMonth)
                    int slot = f_calendarSlot(calendarMonth, calendarDay)
                    if slot == previousSlot
                        previousMonth := calendarMonth
                        previousDay := calendarDay
                        previousOrdinal := f_calendarOrdinal(calendarMonth, calendarDay)
                    if slot == currentSlot
                        currentMonth := calendarMonth
                        currentDay := calendarDay
                        currentOrdinal := f_calendarOrdinal(calendarMonth, calendarDay)
            int leftTs = f_seasonTs(seasonYear, previousMonth, previousDay)
            int rightTs = f_seasonTs(seasonYear, currentMonth, currentDay)
            float topValue = math.max(array.get(upperValues, previousSlot), array.get(upperValues, currentSlot))
            float bottomValue = math.min(array.get(lowerValues, previousSlot), array.get(lowerValues, currentSlot))
            if currentOrdinal > previousOrdinal
                box bandBox = box.new(left = leftTs, top = topValue, right = rightTs, bottom = bottomValue, xloc = xloc.bar_time, bgcolor = bandColor, border_color = color.new(bandColor, 100))
                array.push(bandBoxes, bandBox)
            previousIndex := currentIndex

f_drawRobustDistribution(int seasonYear) =>
    f_clearLines(robustMedianLines)
    f_clearBoxes(robustBandBoxes)
    f_clearBoxes(robustWideBandBoxes)
    float yMin = na
    float yMax = na
    if f_hasRobustDistributionData()
        if showWideBand
            f_drawRobustBand(robustP10, robustP90, robustWideBandBoxes, seasonYear, color.new(color.gray, 93))
        if showInterquartileBand
            f_drawRobustBand(robustP25, robustP75, robustBandBoxes, seasonYear, color.new(color.gray, 86))
        int previousTs = na
        float previousValue = na
        for calendarMonth = 1 to 12
            for calendarDay = 1 to f_daysInMonth(calendarMonth)
                int slot = f_calendarSlot(calendarMonth, calendarDay)
                float medianValue = array.get(robustMedian, slot)
                if not na(medianValue)
                    int currentTs = f_seasonTs(seasonYear, calendarMonth, calendarDay)
                    if not na(previousValue) and array.size(robustMedianLines) < MAX_ROBUST_MEDIAN_LINES
                        line medianLine = line.new(previousTs, previousValue, currentTs, medianValue, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.aqua, 0), width = 2)
                        array.push(robustMedianLines, medianLine)
                    previousTs := currentTs
                    previousValue := medianValue
                    float lowerValue = showWideBand ? array.get(robustP10, slot) : showInterquartileBand ? array.get(robustP25, slot) : medianValue
                    float upperValue = showWideBand ? array.get(robustP90, slot) : showInterquartileBand ? array.get(robustP75, slot) : medianValue
                    yMin := na(yMin) ? nz(lowerValue, medianValue) : math.min(yMin, nz(lowerValue, medianValue))
                    yMax := na(yMax) ? nz(upperValue, medianValue) : math.max(yMax, nz(upperValue, medianValue))
    [yMin, yMax]

f_drawCurrentYearPath(int seasonYear) =>
    f_clearLines(currentYearLines)
    float yMin = na
    float yMax = na
    int pointCount = math.min(array.size(currentYearMonth), math.min(array.size(currentYearDay), array.size(currentYearCumReturn)))
    if showCurrentYearPath and pointCount > 0
        int stride = math.max(1, int(math.ceil((pointCount - 1) * 1.0 / MAX_CURRENT_YEAR_LINES)))
        int previousTs = na
        float previousValue = na
        for pointIndex = 0 to pointCount - 1
            bool includePoint = pointIndex == 0 or pointIndex == pointCount - 1 or pointIndex % stride == 0
            if includePoint
                int currentTs = f_seasonTs(seasonYear, array.get(currentYearMonth, pointIndex), array.get(currentYearDay, pointIndex))
                float currentValue = array.get(currentYearCumReturn, pointIndex)
                yMin := na(yMin) ? currentValue : math.min(yMin, currentValue)
                yMax := na(yMax) ? currentValue : math.max(yMax, currentValue)
                if not na(previousValue) and array.size(currentYearLines) < MAX_CURRENT_YEAR_LINES
                    line currentYearLine = line.new(previousTs, previousValue, currentTs, currentValue, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.orange, 5), width = 2)
                    array.push(currentYearLines, currentYearLine)
                previousTs := currentTs
                previousValue := currentValue
    [yMin, yMax]

