f_hasUsableAllYearsStats(int index) =>
    bool inRange = not na(index) and index >= 0 and array.size(horizonDays) > index and array.size(horizonAvgDelta) > index and array.size(horizonMedianDelta) > index and array.size(horizonPositiveRate) > index and array.size(horizonMedianAdverse) > index and array.size(horizonWorstAdverse) > index and array.size(horizonMedianFavorable) > index and array.size(horizonRewardRisk) > index and array.size(horizonSampleCount) > index and array.size(horizonExpectedSamples) > index and array.size(horizonCoverage) > index and array.size(horizonReliability) > index
    bool result = false
    if inRange
        float avgDelta = array.get(horizonAvgDelta, index)
        float medianDelta = array.get(horizonMedianDelta, index)
        float positiveRate = array.get(horizonPositiveRate, index)
        int sampleCount = array.get(horizonSampleCount, index)
        int expectedSamples = array.get(horizonExpectedSamples, index)
        result := not na(avgDelta) and not na(medianDelta) and not na(positiveRate) and not na(sampleCount) and sampleCount >= EVIDENCE_MIN_ALL_SAMPLES and not na(expectedSamples) and expectedSamples > 0
    result

f_getEvidenceReferenceIndex() =>
    int result = na
    int candidate30D = f_findHorizonIndex(30)
    int candidate20D = f_findHorizonIndex(20)
