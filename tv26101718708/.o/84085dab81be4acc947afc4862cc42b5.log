                f_statusRow(statusTable, contextRow, "Date Samples", f_formatSamples(currentRobustSamples, classicLookbackYears), PANEL_TIP_DATE_SAMPLES)
                contextRow += 1
            f_statusReliabilityRow(statusTable, contextRow, currentRobustReliability, currentRobustCoverage, PANEL_TIP_RELIABILITY)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Bands", (showInterquartileBand ? "P25-P75" : "Off") + (showWideBand ? " + P10-P90" : ""), PANEL_TIP_BANDS)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Next Turn", nextTurnText, PANEL_TIP_NEXT_TURN)
        else if showTacticalMode
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Lookback", str.tostring(profileLookbackYears) + "Y", PANEL_TIP_LOOKBACK)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Window", "-" + str.tostring(pastProfileDays) + "D / +" + str.tostring(futureProfileDays) + "D", PANEL_TIP_WINDOW)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Current State", f_stateText(currentProfileState), PANEL_TIP_CURRENT_STATE)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Smooth Step", f_formatSignedPct(currentSmoothStep), PANEL_TIP_CURRENT_SMOOTH_STEP)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Confidence", na(currentProfileConfidence) ? "—" : str.tostring(currentProfileConfidence, "#.0") + " %", PANEL_TIP_CONFIDENCE)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Step Samples", f_formatSampleCoverage(currentProfileSamples, profileLookbackYears), PANEL_TIP_STEP_SAMPLES)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Dominant Future State", f_stateText(dominantFutureState), PANEL_TIP_DOMINANT_FUTURE_STATE)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Avg Future Step", f_formatSignedPct(averageFutureStep), PANEL_TIP_AVG_FUTURE_STEP)
            if fullContextMode
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Smooth / Strict", str.tostring(smoothLength) + " / " + str.tostring(profileStrictness), PANEL_TIP_SMOOTH_STRICT)
        else
            f_statusRow(statusTable, contextRow, "Alignment", alignment, PANEL_TIP_ALIGNMENT)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Year", f_formatSignedPct(currentYearYtd), PANEL_TIP_CURRENT_YEAR)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Classic YTD", f_formatSignedPct(currentClassicYtd), PANEL_TIP_CLASSIC_YTD)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Current-Year Deviation", f_formatSignedPct(currentYearDeviation), PANEL_TIP_CURRENT_YEAR_DEVIATION)
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Deviation Context", currentYearDeviationStatus, PANEL_TIP_DEVIATION_CONTEXT)
