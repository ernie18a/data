    result

f_copyConditionalHorizonStats(array<float> averages, array<float> medians, array<float> positiveRates, array<int> samples, array<int> expectedSamples, array<float> medianAdverses, array<float> worstAdverses, array<float> medianFavorables, array<float> rewardRisks) =>
    f_clearConditionalHorizonStats()
    bool collectionsAvailable = not na(averages) and not na(medians) and not na(positiveRates) and not na(samples) and not na(expectedSamples) and not na(medianAdverses) and not na(worstAdverses) and not na(medianFavorables) and not na(rewardRisks)
    int availableReturnResults = collectionsAvailable ? math.min(array.size(averages), math.min(array.size(medians), array.size(positiveRates))) : 0
    int availableSampleResults = collectionsAvailable ? math.min(array.size(samples), array.size(expectedSamples)) : 0
    int availableRiskResults = collectionsAvailable ? math.min(array.size(medianAdverses), math.min(array.size(worstAdverses), math.min(array.size(medianFavorables), array.size(rewardRisks)))) : 0
    int resultCount = math.min(HORIZON_COUNT, math.min(availableReturnResults, math.min(availableSampleResults, availableRiskResults)))
    if resultCount == HORIZON_COUNT
        for horizonIndex = 0 to resultCount - 1
            int actualSamples = array.get(samples, horizonIndex)
            int requestedSamples = array.get(expectedSamples, horizonIndex)
            [reliability, coverage] = f_reliabilityLabel(actualSamples, requestedSamples)
            array.push(conditionalHorizonAvgDelta, array.get(averages, horizonIndex))
            array.push(conditionalHorizonMedianDelta, array.get(medians, horizonIndex))
            array.push(conditionalHorizonPositiveRate, array.get(positiveRates, horizonIndex))
            array.push(conditionalHorizonMedianAdverse, array.get(medianAdverses, horizonIndex))
            array.push(conditionalHorizonWorstAdverse, array.get(worstAdverses, horizonIndex))
            array.push(conditionalHorizonMedianFavorable, array.get(medianFavorables, horizonIndex))
            array.push(conditionalHorizonRewardRisk, array.get(rewardRisks, horizonIndex))
            array.push(conditionalHorizonSampleCount, actualSamples)
            array.push(conditionalHorizonExpectedSamples, requestedSamples)
            array.push(conditionalHorizonCoverage, coverage)
            array.push(conditionalHorizonReliability, reliability)

f_conditionalViewLabel(float allMedian, float matchedMedian, int matchedSamples) =>
    string result = "n/a"
    if not na(allMedian) and not na(matchedMedian)
        if matchedSamples < CONDITIONAL_MIN_MATCHED_SAMPLES
            result := "Low sample"
        else
            bool contradicts = (allMedian > 0 and matchedMedian < 0) or (allMedian < 0 and matchedMedian > 0)
            float allMagnitude = math.abs(allMedian)
            float matchedMagnitude = math.abs(matchedMedian)
            result := contradicts ? "Contradicts" : matchedMagnitude > allMagnitude * 1.25 ? "Stronger" : matchedMagnitude < allMagnitude * 0.75 ? "Weaker" : "Confirms"
    result

f_buildRecentHorizonStats(array<int> longTermAnchors) =>
    f_clearRecentHorizonStats()
    int recentLookbackYears = math.min(RECENT_LOOKBACK_MAX_YEARS, classicLookbackYears)
    array<int> recentAnchors = f_recentAnchorOffsets(longTermAnchors, recentLookbackYears)
    for horizonIndex = 0 to HORIZON_COUNT - 1
        int horizon = array.get(horizonDays, horizonIndex)
        [averageDelta, medianDelta, positiveRate, samples, medianAdverse, worstAdverse, medianFavorable, rewardRisk] = f_forwardHorizonStatsFromAnchors(recentAnchors, horizon, false)
        [reliability, coverage] = f_reliabilityLabel(samples, recentLookbackYears)
        array.push(recentHorizonAvgDelta, averageDelta)
        array.push(recentHorizonSampleCount, samples)
        array.push(recentHorizonExpectedSamples, recentLookbackYears)
        array.push(recentHorizonCoverage, coverage)
        array.push(recentHorizonReliability, reliability)

f_copyRecentHorizonStats(array<float> averages, array<int> samples, array<int> expectedSamples) =>
    f_clearRecentHorizonStats()
    bool collectionsAvailable = not na(averages) and not na(samples) and not na(expectedSamples)
    int resultCount = collectionsAvailable ? math.min(HORIZON_COUNT, math.min(array.size(averages), math.min(array.size(samples), array.size(expectedSamples)))) : 0
    if resultCount > 0
        for horizonIndex = 0 to resultCount - 1
            int actualSamples = array.get(samples, horizonIndex)
            int requestedSamples = array.get(expectedSamples, horizonIndex)
            [reliability, coverage] = f_reliabilityLabel(actualSamples, requestedSamples)
            array.push(recentHorizonAvgDelta, array.get(averages, horizonIndex))
            array.push(recentHorizonSampleCount, actualSamples)
            array.push(recentHorizonExpectedSamples, requestedSamples)
            array.push(recentHorizonCoverage, coverage)
            array.push(recentHorizonReliability, reliability)

f_hasCompleteRecentHorizonStats() =>
    array.size(recentHorizonAvgDelta) == HORIZON_COUNT and array.size(recentHorizonSampleCount) == HORIZON_COUNT and array.size(recentHorizonExpectedSamples) == HORIZON_COUNT and array.size(recentHorizonCoverage) == HORIZON_COUNT and array.size(recentHorizonReliability) == HORIZON_COUNT

f_clearSeasonalProfile() =>
    array.clear(profileOffset)
    array.clear(profileRawStep)
    array.clear(profileSmoothStep)
    array.clear(profileConfidence)
    array.clear(profileSamples)
    array.clear(profileState)

f_profileStepFromAnchors(array<int> anchorOffsets, int offsetFromOrigin) =>
    float stepSum = 0.0
    int samples = 0
    int upCount = 0
    int downCount = 0
    int anchorCount = array.size(anchorOffsets)
    if anchorCount > 0
        for yearIndex = 0 to anchorCount - 1
            int historicalAnchorOffset = array.get(anchorOffsets, yearIndex)
            if not na(historicalAnchorOffset)
                int stepStartOffset = historicalAnchorOffset - offsetFromOrigin
                int stepEndOffset = historicalAnchorOffset - (offsetFromOrigin + 1)
                bool validOffsets = stepStartOffset >= 0 and stepStartOffset <= bar_index and stepEndOffset >= 0 and stepEndOffset <= bar_index and stepEndOffset < stepStartOffset
                if validOffsets
                    float startPrice = close[stepStartOffset]
                    float endPrice = close[stepEndOffset]
                    if not na(startPrice) and not na(endPrice) and startPrice > 0 and endPrice > 0
                        float stepPct = (endPrice / startPrice - 1.0) * 100.0
                        stepSum += stepPct
                        samples += 1
                        upCount += stepPct > 0 ? 1 : 0
                        downCount += stepPct < 0 ? 1 : 0
    float averageStep = samples > 0 ? stepSum / samples : na
    float signConsistency = samples > 0 ? math.max(upCount, downCount) / samples * 100.0 : na
    [averageStep, signConsistency, samples]

f_smoothProfileValue(array<float> source, int sourceIndex, int length) =>
    int halfLength = int(math.floor(length * 0.5))
    float valueSum = 0.0
    int validValues = 0
    for neighborIndex = sourceIndex - halfLength to sourceIndex + halfLength
        if neighborIndex >= 0 and neighborIndex < array.size(source)
            float value = array.get(source, neighborIndex)
            if not na(value)
                valueSum += value
                validValues += 1
    validValues > 0 ? valueSum / validValues : na

f_stepToState(float smoothStep, float confidence, float threshold, float confidenceMinimum) =>
    int result = STATE_NONE
    if not na(smoothStep) and not na(confidence) and confidence >= confidenceMinimum
        result := smoothStep > threshold ? STATE_LONG : smoothStep < -threshold ? STATE_SHORT : STATE_RANGE
    result

f_buildTacticalProfile(array<int> anchorOffsets, int profileStartOffset, int profileEndOffset) =>
    f_clearSeasonalProfile()
    for offsetFromOrigin = profileStartOffset to profileEndOffset
        [averageStep, signConsistency, samples] = f_profileStepFromAnchors(anchorOffsets, offsetFromOrigin)
        array.push(profileOffset, offsetFromOrigin)
        array.push(profileRawStep, averageStep)
        array.push(profileConfidence, signConsistency)
        array.push(profileSamples, samples)
    int profileSize = array.size(profileRawStep)
    if profileSize > 0
        for profileIndex = 0 to profileSize - 1
            array.push(profileSmoothStep, f_smoothProfileValue(profileRawStep, profileIndex, smoothLength))
        float absoluteStepSum = 0.0
        int absoluteStepSamples = 0
        for profileIndex = 0 to profileSize - 1
            float smoothStep = array.get(profileSmoothStep, profileIndex)
            if not na(smoothStep)
                absoluteStepSum += math.abs(smoothStep)
                absoluteStepSamples += 1
        float averageAbsoluteStep = absoluteStepSamples > 0 ? absoluteStepSum / absoluteStepSamples : na
        float directionThreshold = math.max(nz(averageAbsoluteStep, 0.0) * f_dirThresholdFactor(profileStrictness), 0.01)
        float confidenceMinimum = f_confidenceMin(profileStrictness)
        for profileIndex = 0 to profileSize - 1
            array.push(profileState, f_stepToState(array.get(profileSmoothStep, profileIndex), array.get(profileConfidence, profileIndex), directionThreshold, confidenceMinimum))

f_dailyClassicCollections(bool enabled) =>
    array<float> resultCum = na
    array<float> resultAvg = na
    array<int> resultCount = na
    array<int> resultMonth = na
    array<int> resultDay = na
    int resultAnchorTs = na
    int resultAnchorTime = na
    if enabled and barstate.islastconfirmedhistory
        resultCum := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultAvg := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultCount := array.new_int(CLASSIC_SLOT_COUNT, 0)
        resultMonth := array.new_int()
        resultDay := array.new_int()
        array<float> returnSum = array.new_float(CLASSIC_SLOT_COUNT, 0.0)
        resultAnchorTs := f_seasonalDateTsFromBar(0)
        resultAnchorTime := time
        int anchorYear = year(resultAnchorTs, "UTC")
        int maxBarsBack = math.min(bar_index - 1, math.min(classicLookbackYears * 370 + 20, 4998))
        if maxBarsBack >= 1
            for barsBack = 1 to maxBarsBack
                int historicalTs = f_seasonalDateTsFromBar(barsBack)
                int historicalYear = year(historicalTs, "UTC")
                int historicalMonth = month(historicalTs, "UTC")
                int historicalDay = dayofmonth(historicalTs, "UTC")
                bool inLookback = historicalYear >= anchorYear - classicLookbackYears and historicalYear < anchorYear
                bool validReturn = not na(close[barsBack]) and not na(close[barsBack + 1]) and close[barsBack + 1] > 0
                if inLookback and not (historicalMonth == 2 and historicalDay == 29) and validReturn
                    int slot = f_calendarSlot(historicalMonth, historicalDay)
                    array.set(returnSum, slot, array.get(returnSum, slot) + close[barsBack] / close[barsBack + 1] - 1.0)
                    array.set(resultCount, slot, array.get(resultCount, slot) + 1)
        int minSamples = math.max(3, int(math.floor(classicLookbackYears * 0.25)))
        for slot = 0 to CLASSIC_SLOT_COUNT - 1
            int samples = array.get(resultCount, slot)
            if samples >= minSamples
                array.set(resultAvg, slot, array.get(returnSum, slot) / samples)
        float cumulativeReturn = 0.0
        for calendarMonth = 1 to 12
            for calendarDay = 1 to f_daysInMonth(calendarMonth)
                int slot = f_calendarSlot(calendarMonth, calendarDay)
                float averageReturn = array.get(resultAvg, slot)
                if not na(averageReturn)
                    cumulativeReturn := classicCompounding ? (1.0 + cumulativeReturn) * (1.0 + averageReturn) - 1.0 : cumulativeReturn + averageReturn
                    array.set(resultCum, slot, cumulativeReturn * 100.0)
                    array.push(resultMonth, calendarMonth)
                    array.push(resultDay, calendarDay)
    [resultCum, resultAvg, resultCount, resultMonth, resultDay, resultAnchorTs, resultAnchorTime]

f_dailyRobustCollections(bool enabled) =>
    array<float> resultMedian = na
    array<float> resultP25 = na
    array<float> resultP75 = na
    array<float> resultP10 = na
    array<float> resultP90 = na
    array<int> resultSamples = na
    int resultAnchorTs = na
    int resultAnchorTime = na
    if enabled and barstate.islastconfirmedhistory
        resultMedian := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultP25 := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultP75 := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultP10 := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultP90 := array.new_float(CLASSIC_SLOT_COUNT, na)
        resultSamples := array.new_int(CLASSIC_SLOT_COUNT, 0)
        resultAnchorTs := f_seasonalDateTsFromBar(0)
        resultAnchorTime := time
        int anchorYear = year(resultAnchorTs, "UTC")
        int maxRobustBarsBack = math.min(bar_index - 1, math.min((classicLookbackYears + 2) * 370, 4998))
        array<float> yearBaseClose = array.new_float(classicLookbackYears, na)
        array<bool> yearHasStart = array.new_bool(classicLookbackYears, false)
        array<bool> yearHasEnd = array.new_bool(classicLookbackYears, false)
        array<float> yearPathBySlot = array.new_float(classicLookbackYears * CLASSIC_SLOT_COUNT, na)
        if maxRobustBarsBack >= 1
            for barsBack = 1 to maxRobustBarsBack
                int historicalTs = f_seasonalDateTsFromBar(barsBack)
                int historicalYear = year(historicalTs, "UTC")
                int yearBack = anchorYear - historicalYear
                if yearBack >= 1 and yearBack <= classicLookbackYears
                    int yearIndex = yearBack - 1
                    int olderTs = f_seasonalDateTsFromBar(barsBack + 1)
                    int newerTs = f_seasonalDateTsFromBar(barsBack - 1)
                    bool isYearStart = not na(olderTs) and year(olderTs, "UTC") != historicalYear
                    bool isYearEnd = not na(newerTs) and year(newerTs, "UTC") != historicalYear
                    if not na(close[barsBack]) and close[barsBack] > 0
                        // The scan runs newest-to-oldest, so the final assignment is the first valid close of the year.
                        array.set(yearBaseClose, yearIndex, close[barsBack])
                    if isYearStart
                        array.set(yearHasStart, yearIndex, true)
                    if isYearEnd
                        array.set(yearHasEnd, yearIndex, true)
            for barsBack = 1 to maxRobustBarsBack
                int historicalTs = f_seasonalDateTsFromBar(barsBack)
                int historicalYear = year(historicalTs, "UTC")
                int historicalMonth = month(historicalTs, "UTC")
                int historicalDay = dayofmonth(historicalTs, "UTC")
                int yearBack = anchorYear - historicalYear
                bool validYearIndex = yearBack >= 1 and yearBack <= classicLookbackYears
                bool validDate = not (historicalMonth == 2 and historicalDay == 29)
                if validYearIndex and validDate and not na(close[barsBack]) and close[barsBack] > 0
                    int yearIndex = yearBack - 1
                    float baseClose = array.get(yearBaseClose, yearIndex)
                    bool completeYear = array.get(yearHasStart, yearIndex) and array.get(yearHasEnd, yearIndex) and not na(baseClose) and baseClose > 0
                    if completeYear
                        int slot = f_calendarSlot(historicalMonth, historicalDay)
                        int flatIndex = yearIndex * CLASSIC_SLOT_COUNT + slot
                        array.set(yearPathBySlot, flatIndex, (close[barsBack] / baseClose - 1.0) * 100.0)
        for slot = 0 to CLASSIC_SLOT_COUNT - 1
            array<float> slotValues = array.new_float()
            for yearIndex = 0 to classicLookbackYears - 1
                float pathValue = array.get(yearPathBySlot, yearIndex * CLASSIC_SLOT_COUNT + slot)
                if not na(pathValue)
                    array.push(slotValues, pathValue)
            int samples = array.size(slotValues)
            if samples > 0
                array.set(resultP10, slot, f_percentile(slotValues, 0.10))
                array.set(resultP25, slot, f_percentile(slotValues, 0.25))
                array.set(resultMedian, slot, f_percentile(slotValues, 0.50))
                array.set(resultP75, slot, f_percentile(slotValues, 0.75))
                array.set(resultP90, slot, f_percentile(slotValues, 0.90))
                array.set(resultSamples, slot, samples)
    [resultMedian, resultP25, resultP75, resultP10, resultP90, resultSamples, resultAnchorTs, resultAnchorTime]

f_dailyCurrentYearCollections(bool enabled) =>
    array<int> resultMonth = na
    array<int> resultDay = na
    array<float> resultReturn = na
    if enabled and barstate.islastconfirmedhistory
        resultMonth := array.new_int()
        resultDay := array.new_int()
        resultReturn := array.new_float()
        array<float> resultClose = array.new_float()
        int anchorTs = f_seasonalDateTsFromBar(0)
        int anchorYear = year(anchorTs, "UTC")
        int maxCurrentYearBarsBack = math.min(bar_index, 370)
        for barsBack = 0 to maxCurrentYearBarsBack
            int historicalTs = f_seasonalDateTsFromBar(barsBack)
            if not na(historicalTs) and year(historicalTs, "UTC") == anchorYear and not na(close[barsBack]) and close[barsBack] > 0
                int historicalMonth = month(historicalTs, "UTC")
                int historicalDay = dayofmonth(historicalTs, "UTC")
                if not (historicalMonth == 2 and historicalDay == 29)
                    array.unshift(resultMonth, historicalMonth)
                    array.unshift(resultDay, historicalDay)
                    array.unshift(resultClose, close[barsBack])
        int pointCount = array.size(resultClose)
        if pointCount > 0
            float baseClose = array.get(resultClose, 0)
            for pointIndex = 0 to pointCount - 1
                array.push(resultReturn, (array.get(resultClose, pointIndex) / baseClose - 1.0) * 100.0)
    [resultMonth, resultDay, resultReturn]

f_dailyForwardHorizonCollections(bool enabled) =>
    array<float> resultAverage = na
    array<float> resultMedian = na
    array<float> resultPositiveRate = na
    array<int> resultSamples = na
    array<int> resultExpectedSamples = na
    array<float> resultMedianAdverse = na
    array<float> resultWorstAdverse = na
    array<float> resultMedianFavorable = na
    array<float> resultRewardRisk = na
    array<float> resultConditionalAverage = na
    array<float> resultConditionalMedian = na
    array<float> resultConditionalPositiveRate = na
    array<int> resultConditionalSamples = na
    array<int> resultConditionalExpectedSamples = na
    array<float> resultConditionalMedianAdverse = na
    array<float> resultConditionalWorstAdverse = na
    array<float> resultConditionalMedianFavorable = na
    array<float> resultConditionalRewardRisk = na
    int resultCurrentTrendRegime = na
    int resultCurrentVolRegime = na
    int resultCurrentDrawdownRegime = na
    int resultMatchedAnchorCount = na
    int resultMatchMode = MATCH_MODE_NA
    array<float> resultRecentAverage = na
    array<int> resultRecentSamples = na
    array<int> resultRecentExpectedSamples = na
    if enabled and barstate.islastconfirmedhistory
        resultAverage := array.new_float()
        resultMedian := array.new_float()
        resultPositiveRate := array.new_float()
        resultSamples := array.new_int()
        resultExpectedSamples := array.new_int()
        resultMedianAdverse := array.new_float()
        resultWorstAdverse := array.new_float()
        resultMedianFavorable := array.new_float()
        resultRewardRisk := array.new_float()
        resultConditionalAverage := array.new_float()
        resultConditionalMedian := array.new_float()
        resultConditionalPositiveRate := array.new_float()
        resultConditionalSamples := array.new_int()
        resultConditionalExpectedSamples := array.new_int()
        resultConditionalMedianAdverse := array.new_float()
        resultConditionalWorstAdverse := array.new_float()
        resultConditionalMedianFavorable := array.new_float()
        resultConditionalRewardRisk := array.new_float()
        resultRecentAverage := array.new_float()
        resultRecentSamples := array.new_int()
        resultRecentExpectedSamples := array.new_int()
        resultCurrentTrendRegime := f_currentTrendRegime()
        resultCurrentVolRegime := f_currentVolatilityRegime()
        resultCurrentDrawdownRegime := f_currentDrawdownRegime()
        int anchorTs = f_seasonalDateTsFromBar(0)
        int anchorYear = year(anchorTs, "UTC")
        int anchorMonth = month(anchorTs, "UTC")
        int anchorDay = dayofmonth(anchorTs, "UTC")
        int maxForwardBarsBack = math.min(bar_index, math.min(classicLookbackYears * 370 + MAX_ANCHOR_SEARCH_BARS + 60, 4999))
        array<int> anchors = f_collectHistoricalAnchorOffsets(anchorYear, anchorMonth, anchorDay, classicLookbackYears, maxForwardBarsBack, MAX_ANCHOR_SEARCH_BARS)
        int strictMatchedSamples = f_strictRegimeMatchedAnchorCount(anchors)
        array<int> matchedAnchors = f_filterRegimeMatchedAnchors(anchors)
        resultMatchedAnchorCount := array.size(matchedAnchors)
        resultMatchMode := f_regimeMatchModeFromCounts(strictMatchedSamples, resultMatchedAnchorCount)
        int recentLookbackYears = math.min(RECENT_LOOKBACK_MAX_YEARS, classicLookbackYears)
        array<int> recentAnchors = f_recentAnchorOffsets(anchors, recentLookbackYears)
        for horizonIndex = 0 to HORIZON_COUNT - 1
            int horizon = array.get(horizonDays, horizonIndex)
            [averageDelta, medianDelta, positiveRate, samples, medianAdverse, worstAdverse, medianFavorable, rewardRisk] = f_forwardHorizonStatsFromAnchors(anchors, horizon, true)
            [conditionalAverageDelta, conditionalMedianDelta, conditionalPositiveRate, conditionalSamples, conditionalMedianAdverse, conditionalWorstAdverse, conditionalMedianFavorable, conditionalRewardRisk] = f_forwardHorizonStatsFromAnchors(matchedAnchors, horizon, true)
            [recentAverageDelta, recentMedianDelta, recentPositiveRate, recentSamples, recentMedianAdverse, recentWorstAdverse, recentMedianFavorable, recentRewardRisk] = f_forwardHorizonStatsFromAnchors(recentAnchors, horizon, false)
            array.push(resultAverage, averageDelta)
            array.push(resultMedian, medianDelta)
            array.push(resultPositiveRate, positiveRate)
            array.push(resultSamples, samples)
            array.push(resultExpectedSamples, classicLookbackYears)
            array.push(resultMedianAdverse, medianAdverse)
            array.push(resultWorstAdverse, worstAdverse)
            array.push(resultMedianFavorable, medianFavorable)
            array.push(resultRewardRisk, rewardRisk)
            array.push(resultConditionalAverage, conditionalAverageDelta)
            array.push(resultConditionalMedian, conditionalMedianDelta)
            array.push(resultConditionalPositiveRate, conditionalPositiveRate)
            array.push(resultConditionalSamples, conditionalSamples)
            array.push(resultConditionalExpectedSamples, classicLookbackYears)
            array.push(resultConditionalMedianAdverse, conditionalMedianAdverse)
            array.push(resultConditionalWorstAdverse, conditionalWorstAdverse)
            array.push(resultConditionalMedianFavorable, conditionalMedianFavorable)
            array.push(resultConditionalRewardRisk, conditionalRewardRisk)
            array.push(resultRecentAverage, recentAverageDelta)
            array.push(resultRecentSamples, recentSamples)
            array.push(resultRecentExpectedSamples, recentLookbackYears)
    [resultAverage, resultMedian, resultPositiveRate, resultSamples, resultExpectedSamples, resultMedianAdverse, resultWorstAdverse, resultMedianFavorable, resultRewardRisk, resultConditionalAverage, resultConditionalMedian, resultConditionalPositiveRate, resultConditionalSamples, resultConditionalExpectedSamples, resultConditionalMedianAdverse, resultConditionalWorstAdverse, resultConditionalMedianFavorable, resultConditionalRewardRisk, resultCurrentTrendRegime, resultCurrentVolRegime, resultCurrentDrawdownRegime, resultMatchedAnchorCount, resultMatchMode, resultRecentAverage, resultRecentSamples, resultRecentExpectedSamples]

f_dailyTacticalCollections(bool enabled) =>
    array<int> resultOffset = na
    array<float> resultSmooth = na
    array<float> resultConfidence = na
    array<int> resultSamples = na
    array<int> resultState = na
    int resultAnchorTs = na
    int resultAnchorTime = na
    if enabled and barstate.islastconfirmedhistory
        resultOffset := array.new_int()
        resultSmooth := array.new_float()
        resultConfidence := array.new_float()
        resultSamples := array.new_int()
        resultState := array.new_int()
        resultAnchorTs := f_seasonalDateTsFromBar(0)
        resultAnchorTime := time
        int anchorYear = year(resultAnchorTs, "UTC")
        int anchorMonth = month(resultAnchorTs, "UTC")
        int anchorDay = dayofmonth(resultAnchorTs, "UTC")
        int maxProfileBarsBack = math.min(bar_index, profileLookbackYears * 370 + MAX_ANCHOR_SEARCH_BARS + pastProfileDays + futureProfileDays)
        array<int> anchors = array.new_int()
        array<float> rawSteps = array.new_float()
        for yearBack = 1 to profileLookbackYears
            array.push(anchors, findHistoricalAnchorOffset(anchorYear - yearBack, anchorMonth, anchorDay, maxProfileBarsBack, MAX_ANCHOR_SEARCH_BARS))
        for offsetFromOrigin = -pastProfileDays to futureProfileDays
            [averageStep, signConsistency, samples] = f_profileStepFromAnchors(anchors, offsetFromOrigin)
            array.push(resultOffset, offsetFromOrigin)
            array.push(rawSteps, averageStep)
            array.push(resultConfidence, signConsistency)
            array.push(resultSamples, samples)
        int profileSize = array.size(rawSteps)
        if profileSize > 0
            for profileIndex = 0 to profileSize - 1
                array.push(resultSmooth, f_smoothProfileValue(rawSteps, profileIndex, smoothLength))
            float absoluteStepSum = 0.0
            int absoluteStepSamples = 0
            for profileIndex = 0 to profileSize - 1
                float smoothStep = array.get(resultSmooth, profileIndex)
                if not na(smoothStep)
                    absoluteStepSum += math.abs(smoothStep)
                    absoluteStepSamples += 1
            float averageAbsoluteStep = absoluteStepSamples > 0 ? absoluteStepSum / absoluteStepSamples : na
            float directionThreshold = math.max(nz(averageAbsoluteStep, 0.0) * f_dirThresholdFactor(profileStrictness), 0.01)
            float confidenceMinimum = f_confidenceMin(profileStrictness)
            for profileIndex = 0 to profileSize - 1
                array.push(resultState, f_stepToState(array.get(resultSmooth, profileIndex), array.get(resultConfidence, profileIndex), directionThreshold, confidenceMinimum))
    [resultOffset, resultSmooth, resultConfidence, resultSamples, resultState, resultAnchorTs, resultAnchorTime]

f_drawTacticalProfile(int originTime) =>
    f_clearLines(profileLines)
    float yMin = na
    float yMax = na
    int profileSize = array.size(profileOffset)
    if profileSize > 0
        for profileIndex = 0 to profileSize - 1
            float smoothStep = array.get(profileSmoothStep, profileIndex)
            if not na(smoothStep)
                yMin := na(yMin) ? smoothStep : math.min(yMin, smoothStep)
                yMax := na(yMax) ? smoothStep : math.max(yMax, smoothStep)
            if profileIndex > 0
                float previousStep = array.get(profileSmoothStep, profileIndex - 1)
                if not na(previousStep) and not na(smoothStep)
                    int previousTime = f_dailyChartTimeFromOriginOffset(0, array.get(profileOffset, profileIndex - 1), originTime)
                    int currentTime = f_dailyChartTimeFromOriginOffset(0, array.get(profileOffset, profileIndex), originTime)
                    if not na(previousTime) and not na(currentTime) and array.size(profileLines) < MAX_PROFILE_LINES
                        color segmentColor = color.new(f_stateColor(array.get(profileState, profileIndex)), 15)
                        line profileLine = line.new(previousTime, previousStep, currentTime, smoothStep, xloc = xloc.bar_time, extend = extend.none, color = segmentColor, width = 2)
                        array.push(profileLines, profileLine)
    [yMin, yMax]

f_drawStateBackground(int originTime, float displayYMin, float displayYMax) =>
    f_clearBoxes(stateBoxes)
    int profileSize = array.size(profileState)
    if showStateBackground and profileSize > 0
        float rangeMin = na(displayYMin) ? -0.1 : math.min(displayYMin, 0.0)
        float rangeMax = na(displayYMax) ? 0.1 : math.max(displayYMax, 0.0)
        float rangePadding = math.max(rangeMax - rangeMin, 0.1) * 0.12
        float boxBottom = rangeMin - rangePadding
        float boxTop = rangeMax + rangePadding
        int segmentState = array.get(profileState, 0)
        int segmentStartIndex = 0
        for profileIndex = 1 to profileSize
            int nextState = profileIndex < profileSize ? array.get(profileState, profileIndex) : STATE_NONE
            if nextState != segmentState
                int segmentEndIndex = profileIndex - 1
                bool drawableSegment = segmentState != STATE_NONE and segmentEndIndex - segmentStartIndex >= 1
                if drawableSegment
                    int leftTime = f_dailyChartTimeFromOriginOffset(0, array.get(profileOffset, segmentStartIndex), originTime)
                    int rightTime = f_dailyChartTimeFromOriginOffset(0, array.get(profileOffset, segmentEndIndex) + 1, originTime)
                    if not na(leftTime) and not na(rightTime) and array.size(stateBoxes) < MAX_STATE_BOXES
                        color segmentColor = f_stateColor(segmentState)
                        box stateBox = box.new(left = leftTime, top = boxTop, right = rightTime, bottom = boxBottom, xloc = xloc.bar_time, bgcolor = color.new(segmentColor, 88), border_color = color.new(segmentColor, 100))
                        array.push(stateBoxes, stateBox)
                segmentState := nextState
                segmentStartIndex := profileIndex

f_clearStatusTable(table panel) =>
    table.clear(panel, 0, 0, STATUS_TABLE_COLUMNS - 1, STATUS_TABLE_ROWS - 1)

f_clearStatsTable(table panel) =>
    table.clear(panel, 0, 0, STATS_TABLE_COLUMNS - 1, STATS_TABLE_ROWS - 1)

f_statusHeader(table panel, int row, string labelText, string valueText, string tooltipText) =>
    table.cell(panel, 0, row, labelText, text_color = panelTextColor, text_size = size.small, bgcolor = panelHeaderColor, tooltip = tooltipText)
    table.cell(panel, 1, row, valueText, text_color = panelTextColor, text_size = size.small, bgcolor = panelHeaderColor, tooltip = tooltipText)

f_statusRow(table panel, int row, string labelText, string valueText, string tooltipText) =>
    table.cell(panel, 0, row, labelText, text_color = panelMutedTextColor, text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)
    table.cell(panel, 1, row, valueText, text_color = panelTextColor, text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)

f_statusColoredRow(table panel, int row, string labelText, string valueText, color valueColor, string tooltipText) =>
    table.cell(panel, 0, row, labelText, text_color = panelMutedTextColor, text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)
    table.cell(panel, 1, row, valueText, text_color = valueColor, text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)

f_statusReliabilityRow(table panel, int row, string reliability, float coverage, string tooltipText) =>
    string valueText = reliability + (na(coverage) ? "" : " · " + str.tostring(coverage, "#") + "%")
    table.cell(panel, 0, row, "Reliability", text_color = panelMutedTextColor, text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)
    table.cell(panel, 1, row, valueText, text_color = f_reliabilityColor(reliability), text_size = size.small, bgcolor = panelCellColor, tooltip = tooltipText)

f_statsCell(table panel, int column, int row, string valueText, bool header, string tooltipText) =>
    table.cell(panel, column, row, valueText, text_color = header ? panelTextColor : panelMutedTextColor, text_size = size.small, bgcolor = header ? panelHeaderColor : panelCellColor, tooltip = tooltipText)

f_statsColumnTooltip(bool compareStatsView, bool fullStatsMode, int column) =>
    string tooltipText = PANEL_TIP_HORIZON
    if compareStatsView
        if fullStatsMode
            tooltipText := column == 1 ? PANEL_TIP_ALL_MEDIAN : column == 2 ? PANEL_TIP_ALL_MAE : column == 3 ? PANEL_TIP_MATCH_MEDIAN : column == 4 ? PANEL_TIP_MATCH_POS_RATE : column == 5 ? PANEL_TIP_MATCH_MAE : column == 6 ? PANEL_TIP_MATCH_SAMPLES : PANEL_TIP_CONDITIONAL_STATS
        else
            tooltipText := column == 1 ? PANEL_TIP_ALL_MEDIAN : column == 2 ? PANEL_TIP_MATCH_MEDIAN : column == 3 ? PANEL_TIP_MATCH_POS_RATE : column == 4 ? PANEL_TIP_MATCH_MAE : column == 5 ? PANEL_TIP_MATCH_SAMPLES : PANEL_TIP_CONDITIONAL_STATS
    else
        tooltipText := column == 1 ? PANEL_TIP_AVG_DELTA : column == 2 ? PANEL_TIP_MED_DELTA : column == 3 ? PANEL_TIP_POS_RATE : column == 4 ? PANEL_TIP_MEDIAN_ADVERSE : fullStatsMode and column == 5 ? PANEL_TIP_WORST_ADVERSE : fullStatsMode and column == 6 ? PANEL_TIP_MEDIAN_FAVORABLE : fullStatsMode and column == 7 ? PANEL_TIP_REWARD_RISK : (fullStatsMode and column == 8) or (not fullStatsMode and column == 5) ? PANEL_TIP_SAMPLES : PANEL_TIP_FORWARD_HEADER
    tooltipText

f_statsTopSpacer(table panel, int activeColumns, string tooltipText) =>
    for column = 0 to activeColumns - 1
        table.cell(panel, column, 0, " ", text_color = color.new(color.white, 100), text_size = size.small, bgcolor = color.new(color.black, 100), tooltip = tooltipText)

f_drawStatsTable(table panel) =>
    f_clearStatsTable(panel)
    bool showStats = isSupportedView and needsClassicProfile and statsTableMode != PANEL_NONE and f_hasCompleteHorizonStats()
    if showStats
        bool fullStatsMode = statsTableMode == PANEL_FULL
        bool compareStatsView = statsViewMode == STATS_VIEW_REGIME_MATCH_COMPARE
        bool hasConditionalStats = f_hasCompleteConditionalHorizonStats()
        int activeStatsColumns = compareStatsView ? (fullStatsMode ? 7 : 6) : (fullStatsMode ? STATS_TABLE_COLUMNS : 6)
        f_statsTopSpacer(panel, activeStatsColumns, compareStatsView ? PANEL_TIP_CONDITIONAL_STATS : PANEL_TIP_FORWARD_HEADER)
        for column = 0 to activeStatsColumns - 1
            string columnTooltip = column == 0 ? (compareStatsView ? PANEL_TIP_CONDITIONAL_STATS : PANEL_TIP_FORWARD_HEADER) : f_statsColumnTooltip(compareStatsView, fullStatsMode, column)
            f_statsCell(panel, column, 1, column == 0 ? "Stats" : "", true, columnTooltip)
        f_statsCell(panel, 0, 2, "Horizon", true, PANEL_TIP_HORIZON)
        if compareStatsView
            if fullStatsMode
                f_statsCell(panel, 1, 2, "All Med", true, PANEL_TIP_ALL_MEDIAN)
                f_statsCell(panel, 2, 2, "All MAE", true, PANEL_TIP_ALL_MAE)
                f_statsCell(panel, 3, 2, "Match Med", true, PANEL_TIP_MATCH_MEDIAN)
                f_statsCell(panel, 4, 2, "Match Pos", true, PANEL_TIP_MATCH_POS_RATE)
                f_statsCell(panel, 5, 2, "Match MAE", true, PANEL_TIP_MATCH_MAE)
                f_statsCell(panel, 6, 2, "Samples", true, PANEL_TIP_MATCH_SAMPLES)
            else
                f_statsCell(panel, 1, 2, "All Med", true, PANEL_TIP_ALL_MEDIAN)
                f_statsCell(panel, 2, 2, "Match Med", true, PANEL_TIP_MATCH_MEDIAN)
                f_statsCell(panel, 3, 2, "Match Pos", true, PANEL_TIP_MATCH_POS_RATE)
                f_statsCell(panel, 4, 2, "Match MAE", true, PANEL_TIP_MATCH_MAE)
                f_statsCell(panel, 5, 2, "Samples", true, PANEL_TIP_MATCH_SAMPLES)
        else
            f_statsCell(panel, 1, 2, "Avg Δ", true, PANEL_TIP_AVG_DELTA)
            f_statsCell(panel, 2, 2, "Med Δ", true, PANEL_TIP_MED_DELTA)
            f_statsCell(panel, 3, 2, "Pos %", true, PANEL_TIP_POS_RATE)
            f_statsCell(panel, 4, 2, "MAE", true, PANEL_TIP_MEDIAN_ADVERSE)
            if fullStatsMode
                f_statsCell(panel, 5, 2, "Worst", true, PANEL_TIP_WORST_ADVERSE)
                f_statsCell(panel, 6, 2, "MFE", true, PANEL_TIP_MEDIAN_FAVORABLE)
                f_statsCell(panel, 7, 2, "RR", true, PANEL_TIP_REWARD_RISK)
                f_statsCell(panel, 8, 2, "Samples", true, PANEL_TIP_SAMPLES)
            else
                f_statsCell(panel, 5, 2, "Samples", true, PANEL_TIP_SAMPLES)
        int displayRow = 3
        for horizonIndex = 0 to HORIZON_COUNT - 1
            int horizon = array.get(horizonDays, horizonIndex)
            bool includeHorizon = fullStatsMode or horizon == 10 or horizon == 20 or horizon == 30
            if includeHorizon
                int matchedSamples = hasConditionalStats ? array.get(conditionalHorizonSampleCount, horizonIndex) : 0
                int matchedExpectedSamples = hasConditionalStats ? array.get(conditionalHorizonExpectedSamples, horizonIndex) : 0
                f_statsCell(panel, 0, displayRow, str.tostring(horizon) + "D", false, PANEL_TIP_HORIZON)
                if compareStatsView
                    if fullStatsMode
                        f_statsCell(panel, 1, displayRow, f_formatSignedPct(array.get(horizonMedianDelta, horizonIndex)), false, PANEL_TIP_ALL_MEDIAN)
                        f_statsCell(panel, 2, displayRow, f_formatRiskPct(array.get(horizonMedianAdverse, horizonIndex)), false, PANEL_TIP_ALL_MAE)
                        f_statsCell(panel, 3, displayRow, hasConditionalStats ? f_formatConditionalSignedPct(array.get(conditionalHorizonMedianDelta, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_MEDIAN)
                        f_statsCell(panel, 4, displayRow, hasConditionalStats ? f_formatConditionalRate(array.get(conditionalHorizonPositiveRate, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_POS_RATE)
                        f_statsCell(panel, 5, displayRow, hasConditionalStats ? f_formatConditionalRiskPct(array.get(conditionalHorizonMedianAdverse, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_MAE)
                        f_statsCell(panel, 6, displayRow, hasConditionalStats ? f_formatConditionalSamples(matchedSamples, matchedExpectedSamples) : "—", false, PANEL_TIP_MATCH_SAMPLES)
                    else
                        f_statsCell(panel, 1, displayRow, f_formatSignedPct(array.get(horizonMedianDelta, horizonIndex)), false, PANEL_TIP_ALL_MEDIAN)
                        f_statsCell(panel, 2, displayRow, hasConditionalStats ? f_formatConditionalSignedPct(array.get(conditionalHorizonMedianDelta, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_MEDIAN)
                        f_statsCell(panel, 3, displayRow, hasConditionalStats ? f_formatConditionalRate(array.get(conditionalHorizonPositiveRate, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_POS_RATE)
                        f_statsCell(panel, 4, displayRow, hasConditionalStats ? f_formatConditionalRiskPct(array.get(conditionalHorizonMedianAdverse, horizonIndex), matchedSamples) : "—", false, PANEL_TIP_MATCH_MAE)
                        f_statsCell(panel, 5, displayRow, hasConditionalStats ? f_formatConditionalSamples(matchedSamples, matchedExpectedSamples) : "—", false, PANEL_TIP_MATCH_SAMPLES)
                else
                    f_statsCell(panel, 1, displayRow, f_formatSignedPct(array.get(horizonAvgDelta, horizonIndex)), false, PANEL_TIP_AVG_DELTA)
                    f_statsCell(panel, 2, displayRow, f_formatSignedPct(array.get(horizonMedianDelta, horizonIndex)), false, PANEL_TIP_MED_DELTA)
                    f_statsCell(panel, 3, displayRow, f_formatRate(array.get(horizonPositiveRate, horizonIndex)), false, PANEL_TIP_POS_RATE)
                    f_statsCell(panel, 4, displayRow, f_formatRiskPct(array.get(horizonMedianAdverse, horizonIndex)), false, PANEL_TIP_MEDIAN_ADVERSE)
                    if fullStatsMode
                        f_statsCell(panel, 5, displayRow, f_formatRiskPct(array.get(horizonWorstAdverse, horizonIndex)), false, PANEL_TIP_WORST_ADVERSE)
                        f_statsCell(panel, 6, displayRow, f_formatSignedPct(array.get(horizonMedianFavorable, horizonIndex)), false, PANEL_TIP_MEDIAN_FAVORABLE)
                        f_statsCell(panel, 7, displayRow, f_formatRewardRisk(array.get(horizonRewardRisk, horizonIndex)), false, PANEL_TIP_REWARD_RISK)
                        f_statsCell(panel, 8, displayRow, f_formatSamples(array.get(horizonSampleCount, horizonIndex), array.get(horizonExpectedSamples, horizonIndex)), false, PANEL_TIP_SAMPLES)
                    else
                        f_statsCell(panel, 5, displayRow, f_formatSamples(array.get(horizonSampleCount, horizonIndex), array.get(horizonExpectedSamples, horizonIndex)), false, PANEL_TIP_SAMPLES)
                displayRow += 1

f_modeLabel() =>
    showClassicMode ? "Classic" : showRobustMode ? "Robust" : showTacticalMode ? "Tactical" : showCombinedMode ? "Combined" : "—"

var table statusTable = table.new(position.top_right, STATUS_TABLE_COLUMNS, STATUS_TABLE_ROWS, border_width = 1)
var table statsTable = table.new(position.top_left, STATS_TABLE_COLUMNS, STATS_TABLE_ROWS, border_width = 1)

hline(0.0, "Zero", color = color.new(color.gray, 70), linestyle = hline.style_dotted)

// Dynamic Daily requests run only on supported Intraday views and only for the active mode.
array<float> bridgeClassicCum = na
array<float> bridgeClassicAvg = na
array<int> bridgeClassicCount = na
array<int> bridgeClassicMonth = na
array<int> bridgeClassicDay = na
int bridgeClassicAnchorTs = na
int bridgeClassicAnchorTime = na
array<float> bridgeRobustMedian = na
array<float> bridgeRobustP25 = na
array<float> bridgeRobustP75 = na
array<float> bridgeRobustP10 = na
array<float> bridgeRobustP90 = na
array<int> bridgeRobustSamples = na
int bridgeRobustAnchorTs = na
int bridgeRobustAnchorTime = na
array<int> bridgeCurrentYearMonth = na
array<int> bridgeCurrentYearDay = na
array<float> bridgeCurrentYearReturn = na
array<float> bridgeHorizonAverage = na
array<float> bridgeHorizonMedian = na
array<float> bridgeHorizonPositiveRate = na
array<float> bridgeHorizonMedianAdverse = na
array<float> bridgeHorizonWorstAdverse = na
array<float> bridgeHorizonMedianFavorable = na
array<float> bridgeHorizonRewardRisk = na
array<int> bridgeHorizonSamples = na
array<int> bridgeHorizonExpectedSamples = na
array<float> bridgeConditionalHorizonAverage = na
array<float> bridgeConditionalHorizonMedian = na
array<float> bridgeConditionalHorizonPositiveRate = na
array<int> bridgeConditionalHorizonSamples = na
array<int> bridgeConditionalHorizonExpectedSamples = na
array<float> bridgeConditionalHorizonMedianAdverse = na
array<float> bridgeConditionalHorizonWorstAdverse = na
array<float> bridgeConditionalHorizonMedianFavorable = na
array<float> bridgeConditionalHorizonRewardRisk = na
int bridgeCurrentTrendRegime = na
int bridgeCurrentVolRegime = na
int bridgeCurrentDrawdownRegime = na
int bridgeMatchedAnchorCount = na
int bridgeMatchMode = MATCH_MODE_NA
array<float> bridgeRecentHorizonAverage = na
array<int> bridgeRecentHorizonSamples = na
array<int> bridgeRecentHorizonExpectedSamples = na
array<int> bridgeProfileOffset = na
array<float> bridgeProfileSmooth = na
array<float> bridgeProfileConfidence = na
array<int> bridgeProfileSamples = na
array<int> bridgeProfileState = na
int bridgeTacticalAnchorTs = na
int bridgeTacticalAnchorTime = na

if isSupportedIntradayChart and needsClassicProfile
    [requestedClassicCum, requestedClassicAvg, requestedClassicCount, requestedClassicMonth, requestedClassicDay, requestedClassicAnchorTs, requestedClassicAnchorTime] = request.security(syminfo.tickerid, "1D", f_dailyClassicCollections(true), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 5000)
    bridgeClassicCum := requestedClassicCum
    bridgeClassicAvg := requestedClassicAvg
    bridgeClassicCount := requestedClassicCount
    bridgeClassicMonth := requestedClassicMonth
    bridgeClassicDay := requestedClassicDay
    bridgeClassicAnchorTs := requestedClassicAnchorTs
    bridgeClassicAnchorTime := requestedClassicAnchorTime

if isSupportedIntradayChart and needsRobustProfile
    [requestedRobustMedian, requestedRobustP25, requestedRobustP75, requestedRobustP10, requestedRobustP90, requestedRobustSamples, requestedRobustAnchorTs, requestedRobustAnchorTime] = request.security(syminfo.tickerid, "1D", f_dailyRobustCollections(true), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 5000)
    bridgeRobustMedian := requestedRobustMedian
    bridgeRobustP25 := requestedRobustP25
    bridgeRobustP75 := requestedRobustP75
    bridgeRobustP10 := requestedRobustP10
    bridgeRobustP90 := requestedRobustP90
    bridgeRobustSamples := requestedRobustSamples
    bridgeRobustAnchorTs := requestedRobustAnchorTs
    bridgeRobustAnchorTime := requestedRobustAnchorTime

if isSupportedIntradayChart and needsCurrentYearProfile
    [requestedCurrentYearMonth, requestedCurrentYearDay, requestedCurrentYearReturn] = request.security(syminfo.tickerid, "1D", f_dailyCurrentYearCollections(true), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 500)
    bridgeCurrentYearMonth := requestedCurrentYearMonth
    bridgeCurrentYearDay := requestedCurrentYearDay
    bridgeCurrentYearReturn := requestedCurrentYearReturn

if isSupportedIntradayChart and needsClassicProfile
    [requestedHorizonAverage, requestedHorizonMedian, requestedHorizonPositiveRate, requestedHorizonSamples, requestedHorizonExpectedSamples, requestedHorizonMedianAdverse, requestedHorizonWorstAdverse, requestedHorizonMedianFavorable, requestedHorizonRewardRisk, requestedConditionalHorizonAverage, requestedConditionalHorizonMedian, requestedConditionalHorizonPositiveRate, requestedConditionalHorizonSamples, requestedConditionalHorizonExpectedSamples, requestedConditionalHorizonMedianAdverse, requestedConditionalHorizonWorstAdverse, requestedConditionalHorizonMedianFavorable, requestedConditionalHorizonRewardRisk, requestedTrendRegime, requestedVolRegime, requestedDrawdownRegime, requestedMatchedAnchorCount, requestedMatchMode, requestedRecentHorizonAverage, requestedRecentHorizonSamples, requestedRecentHorizonExpectedSamples] = request.security(syminfo.tickerid, "1D", f_dailyForwardHorizonCollections(true), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 5000)
    bridgeHorizonAverage := requestedHorizonAverage
    bridgeHorizonMedian := requestedHorizonMedian
    bridgeHorizonPositiveRate := requestedHorizonPositiveRate
    bridgeHorizonSamples := requestedHorizonSamples
    bridgeHorizonExpectedSamples := requestedHorizonExpectedSamples
    bridgeHorizonMedianAdverse := requestedHorizonMedianAdverse
    bridgeHorizonWorstAdverse := requestedHorizonWorstAdverse
    bridgeHorizonMedianFavorable := requestedHorizonMedianFavorable
    bridgeHorizonRewardRisk := requestedHorizonRewardRisk
    bridgeConditionalHorizonAverage := requestedConditionalHorizonAverage
    bridgeConditionalHorizonMedian := requestedConditionalHorizonMedian
    bridgeConditionalHorizonPositiveRate := requestedConditionalHorizonPositiveRate
    bridgeConditionalHorizonSamples := requestedConditionalHorizonSamples
    bridgeConditionalHorizonExpectedSamples := requestedConditionalHorizonExpectedSamples
    bridgeConditionalHorizonMedianAdverse := requestedConditionalHorizonMedianAdverse
    bridgeConditionalHorizonWorstAdverse := requestedConditionalHorizonWorstAdverse
    bridgeConditionalHorizonMedianFavorable := requestedConditionalHorizonMedianFavorable
    bridgeConditionalHorizonRewardRisk := requestedConditionalHorizonRewardRisk
    bridgeCurrentTrendRegime := requestedTrendRegime
    bridgeCurrentVolRegime := requestedVolRegime
    bridgeCurrentDrawdownRegime := requestedDrawdownRegime
    bridgeMatchedAnchorCount := requestedMatchedAnchorCount
    bridgeMatchMode := requestedMatchMode
    bridgeRecentHorizonAverage := requestedRecentHorizonAverage
    bridgeRecentHorizonSamples := requestedRecentHorizonSamples
    bridgeRecentHorizonExpectedSamples := requestedRecentHorizonExpectedSamples

if isSupportedIntradayChart and needsTacticalProfile
    [requestedProfileOffset, requestedProfileSmooth, requestedProfileConfidence, requestedProfileSamples, requestedProfileState, requestedTacticalAnchorTs, requestedTacticalAnchorTime] = request.security(syminfo.tickerid, "1D", f_dailyTacticalCollections(true), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 5000)
    bridgeProfileOffset := requestedProfileOffset
    bridgeProfileSmooth := requestedProfileSmooth
    bridgeProfileConfidence := requestedProfileConfidence
    bridgeProfileSamples := requestedProfileSamples
    bridgeProfileState := requestedProfileState
    bridgeTacticalAnchorTs := requestedTacticalAnchorTs
    bridgeTacticalAnchorTime := requestedTacticalAnchorTime

// Classic raw returns accumulate during normal Daily history execution. The last loaded year is excluded.
int loadedAnchorYear = year(last_bar_time, "UTC")
if isDailyChart and needsClassicProfile and barstate.isconfirmed and bar_index > 0
    int seasonalTs = f_seasonalDateTsFromBar(0)
    int historicalYear = year(seasonalTs, "UTC")
    int historicalMonth = month(seasonalTs, "UTC")
    int historicalDay = dayofmonth(seasonalTs, "UTC")
    bool withinClassicLookback = historicalYear >= loadedAnchorYear - classicLookbackYears and historicalYear < loadedAnchorYear
    bool ignoreLeapDay = historicalMonth == 2 and historicalDay == 29
    bool validDailyReturn = not na(close) and not na(close[1]) and close[1] > 0
    if withinClassicLookback and not ignoreLeapDay and validDailyReturn
        int slot = f_calendarSlot(historicalMonth, historicalDay)
        float dailyReturn = close / close[1] - 1.0
        array.set(classicReturnSum, slot, array.get(classicReturnSum, slot) + dailyReturn)
        array.set(classicReturnCount, slot, array.get(classicReturnCount, slot) + 1)

if barstate.islastconfirmedhistory
    // Clear every render collection before drawing the selected mode so mode changes cannot leak objects.
    f_clearLines(classicLines)
    f_clearLines(robustMedianLines)
    f_clearBoxes(robustBandBoxes)
    f_clearBoxes(robustWideBandBoxes)
    f_clearLines(currentYearLines)
    f_clearLines(turnMarkers)
    f_clearLabels(turnLabels)
    f_clearLines(profileLines)
    f_clearBoxes(stateBoxes)
    if not na(currentDateMarker)
        line.delete(currentDateMarker)
        currentDateMarker := na

    int anchorTs = isDailyChart ? f_seasonalDateTsFromBar(0) : needsClassicProfile ? bridgeClassicAnchorTs : needsRobustProfile ? bridgeRobustAnchorTs : bridgeTacticalAnchorTs
    int anchorChartTime = isDailyChart ? f_dailyChartTsFromBar(0) : needsClassicProfile ? bridgeClassicAnchorTime : needsRobustProfile ? bridgeRobustAnchorTime : bridgeTacticalAnchorTime
    int anchorYear = not na(anchorTs) ? year(anchorTs, "UTC") : na
    int anchorMonth = not na(anchorTs) ? month(anchorTs, "UTC") : na
    int anchorDay = not na(anchorTs) ? dayofmonth(anchorTs, "UTC") : na
    bool anchorIsLeapDay = anchorMonth == 2 and anchorDay == 29
    int currentSlot = not na(anchorMonth) and not na(anchorDay) ? f_calendarSlot(anchorMonth, anchorDay) : na

    if isDailyChart
        if needsClassicProfile
            f_buildClassicCurve()
            f_buildClassicTurningPoints()
            int maxForwardBarsBack = math.min(bar_index, math.min(classicLookbackYears * 370 + MAX_ANCHOR_SEARCH_BARS + 60, 4999))
            forwardAnchorOffsets := f_collectHistoricalAnchorOffsets(anchorYear, anchorMonth, anchorDay, classicLookbackYears, maxForwardBarsBack, MAX_ANCHOR_SEARCH_BARS)
            f_buildForwardHorizonStats(forwardAnchorOffsets, classicLookbackYears)
            f_buildRecentHorizonStats(forwardAnchorOffsets)
            [builtMatchedAnchorCount, builtMatchMode] = f_buildConditionalHorizonStats(forwardAnchorOffsets, classicLookbackYears)
            currentMatchedAnchorCount := builtMatchedAnchorCount
            currentConditionalExpectedSamples := classicLookbackYears
            currentMatchModeCode := builtMatchMode
            currentTrendRegimeCode := f_currentTrendRegime()
            currentVolRegimeCode := f_currentVolatilityRegime()
            currentDrawdownRegimeCode := f_currentDrawdownRegime()
        else
            f_clearClassicDerivedArrays()
            f_clearTurningPoints()
            array.clear(forwardAnchorOffsets)
            f_clearForwardHorizonStats()
            f_clearRecentHorizonStats()
            f_clearConditionalHorizonStats()
            currentMatchedAnchorCount := na
            currentConditionalExpectedSamples := na
            currentMatchModeCode := MATCH_MODE_NA
            currentTrendRegimeCode := na
            currentVolRegimeCode := na
            currentDrawdownRegimeCode := na
            currentConditionalViewLabel := "n/a"
        if needsRobustProfile
            [dailyRobustMedian, dailyRobustP25, dailyRobustP75, dailyRobustP10, dailyRobustP90, dailyRobustSamples, dailyRobustAnchorTs, dailyRobustAnchorTime] = f_dailyRobustCollections(true)
            f_copyRobustDistribution(dailyRobustMedian, dailyRobustP25, dailyRobustP75, dailyRobustP10, dailyRobustP90, dailyRobustSamples, classicLookbackYears)
            f_buildRobustTurningPoints()
        else
            f_clearRobustDistribution()
        if needsCurrentYearProfile
            [dailyCurrentYearMonth, dailyCurrentYearDay, dailyCurrentYearReturn] = f_dailyCurrentYearCollections(true)
            f_copyCurrentYearData(dailyCurrentYearMonth, dailyCurrentYearDay, dailyCurrentYearReturn)
        else
            f_clearCurrentYearData()
        if needsTacticalProfile
            int maxProfileBarsBack = math.min(bar_index, profileLookbackYears * 370 + MAX_ANCHOR_SEARCH_BARS + pastProfileDays + futureProfileDays)
            array.clear(historicalAnchorOffsets)
            for yearBack = 1 to profileLookbackYears
                int targetYear = anchorYear - yearBack
                int historicalAnchorOffset = findHistoricalAnchorOffset(targetYear, anchorMonth, anchorDay, maxProfileBarsBack, MAX_ANCHOR_SEARCH_BARS)
                array.push(historicalAnchorOffsets, historicalAnchorOffset)
            f_buildTacticalProfile(historicalAnchorOffsets, -pastProfileDays, futureProfileDays)
        else
            array.clear(historicalAnchorOffsets)
            f_clearSeasonalProfile()
    else if isSupportedIntradayChart
        if needsClassicProfile and not na(bridgeClassicAnchorTs)
            classicCumReturn := array.copy(bridgeClassicCum)
            classicAvgReturn := array.copy(bridgeClassicAvg)
            classicReturnCount := array.copy(bridgeClassicCount)
            classicMonth := array.copy(bridgeClassicMonth)
            classicDay := array.copy(bridgeClassicDay)
            f_buildClassicTurningPoints()
            f_copyForwardHorizonStats(bridgeHorizonAverage, bridgeHorizonMedian, bridgeHorizonPositiveRate, bridgeHorizonMedianAdverse, bridgeHorizonWorstAdverse, bridgeHorizonMedianFavorable, bridgeHorizonRewardRisk, bridgeHorizonSamples, bridgeHorizonExpectedSamples)
            f_copyRecentHorizonStats(bridgeRecentHorizonAverage, bridgeRecentHorizonSamples, bridgeRecentHorizonExpectedSamples)
            f_copyConditionalHorizonStats(bridgeConditionalHorizonAverage, bridgeConditionalHorizonMedian, bridgeConditionalHorizonPositiveRate, bridgeConditionalHorizonSamples, bridgeConditionalHorizonExpectedSamples, bridgeConditionalHorizonMedianAdverse, bridgeConditionalHorizonWorstAdverse, bridgeConditionalHorizonMedianFavorable, bridgeConditionalHorizonRewardRisk)
            currentMatchedAnchorCount := bridgeMatchedAnchorCount
            currentConditionalExpectedSamples := classicLookbackYears
            currentMatchModeCode := bridgeMatchMode
            currentTrendRegimeCode := bridgeCurrentTrendRegime
            currentVolRegimeCode := bridgeCurrentVolRegime
            currentDrawdownRegimeCode := bridgeCurrentDrawdownRegime
        else
            f_clearClassicDerivedArrays()
            f_clearTurningPoints()
            f_clearForwardHorizonStats()
            f_clearRecentHorizonStats()
            f_clearConditionalHorizonStats()
            currentMatchedAnchorCount := na
            currentConditionalExpectedSamples := na
            currentMatchModeCode := MATCH_MODE_NA
            currentTrendRegimeCode := na
            currentVolRegimeCode := na
            currentDrawdownRegimeCode := na
            currentConditionalViewLabel := "n/a"
        if needsRobustProfile and not na(bridgeRobustAnchorTs)
            f_copyRobustDistribution(bridgeRobustMedian, bridgeRobustP25, bridgeRobustP75, bridgeRobustP10, bridgeRobustP90, bridgeRobustSamples, classicLookbackYears)
            f_buildRobustTurningPoints()
        else
            f_clearRobustDistribution()
        if needsCurrentYearProfile
            f_copyCurrentYearData(bridgeCurrentYearMonth, bridgeCurrentYearDay, bridgeCurrentYearReturn)
        else
            f_clearCurrentYearData()
        if needsTacticalProfile and not na(bridgeTacticalAnchorTs)
            profileOffset := array.copy(bridgeProfileOffset)
            profileSmoothStep := array.copy(bridgeProfileSmooth)
            profileConfidence := array.copy(bridgeProfileConfidence)
            profileSamples := array.copy(bridgeProfileSamples)
            profileState := array.copy(bridgeProfileState)
        else
            f_clearSeasonalProfile()
    else
        f_clearClassicDerivedArrays()
        f_clearTurningPoints()
        f_clearRobustDistribution()
        f_clearCurrentYearData()
        f_clearForwardHorizonStats()
        f_clearRecentHorizonStats()
        f_clearConditionalHorizonStats()
        currentMatchedAnchorCount := na
        currentConditionalExpectedSamples := na
        currentMatchModeCode := MATCH_MODE_NA
        currentTrendRegimeCode := na
        currentVolRegimeCode := na
        currentDrawdownRegimeCode := na
        currentConditionalViewLabel := "n/a"
        f_clearSeasonalProfile()

    float currentClassicYtd = anchorIsLeapDay or na(currentSlot) or not needsClassicProfile ? na : array.get(classicCumReturn, currentSlot)
    float currentAverageReturn = anchorIsLeapDay or na(currentSlot) or not needsClassicProfile ? na : array.get(classicAvgReturn, currentSlot)
    int currentSamples = anchorIsLeapDay or na(currentSlot) or not needsClassicProfile ? 0 : array.get(classicReturnCount, currentSlot)
    int next30Slot = anchorIsLeapDay or na(anchorMonth) or not needsClassicProfile ? na : f_slotAtCalendarOffset(anchorMonth, anchorDay, 30)
    int next60Slot = anchorIsLeapDay or na(anchorMonth) or not needsClassicProfile ? na : f_slotAtCalendarOffset(anchorMonth, anchorDay, 60)
    float next30Value = not na(next30Slot) ? array.get(classicCumReturn, next30Slot) : na
    float next60Value = not na(next60Slot) ? array.get(classicCumReturn, next60Slot) : na
    float next30Delta = not na(currentClassicYtd) and not na(next30Value) ? next30Value - currentClassicYtd : na
    float next60Delta = not na(currentClassicYtd) and not na(next60Value) ? next60Value - currentClassicYtd : na

    int currentYearPointCount = array.size(currentYearCumReturn)
    float currentYearYtd = currentYearPointCount > 0 ? array.get(currentYearCumReturn, currentYearPointCount - 1) : na
    float currentYearDeviation = not na(currentYearYtd) and not na(currentClassicYtd) ? currentYearYtd - currentClassicYtd : na
    string currentYearDeviationStatus = f_currentYearDeviationStatus(currentYearDeviation)

    bool hasCurrentRobustSlot = needsRobustProfile and not anchorIsLeapDay and not na(currentSlot) and f_hasRobustDistributionData()
    float currentRobustMedian = hasCurrentRobustSlot ? array.get(robustMedian, currentSlot) : na
    float currentRobustP25 = hasCurrentRobustSlot ? array.get(robustP25, currentSlot) : na
    float currentRobustP75 = hasCurrentRobustSlot ? array.get(robustP75, currentSlot) : na
    float currentRobustBandWidth = not na(currentRobustP25) and not na(currentRobustP75) ? currentRobustP75 - currentRobustP25 : na
    int currentRobustSamples = hasCurrentRobustSlot ? array.get(robustSampleCount, currentSlot) : 0
    float currentRobustCoverage = hasCurrentRobustSlot ? array.get(robustCoverage, currentSlot) : na
    string currentRobustReliability = hasCurrentRobustSlot ? array.get(robustReliability, currentSlot) : "N/A"
    string currentYearBandPosition = f_currentYearBandPosition(currentYearYtd, currentRobustP25, currentRobustP75)

    int nextTurnType = 0
    int daysUntilNextTurn = na
    float nextTurnValue = na
    if not anchorIsLeapDay and not na(anchorMonth) and not na(anchorDay)
        [calculatedNextTurnType, calculatedDaysUntilNextTurn, calculatedNextTurnValue] = f_nextTurningPoint(anchorMonth, anchorDay)
        nextTurnType := calculatedNextTurnType
        daysUntilNextTurn := calculatedDaysUntilNextTurn
        nextTurnValue := calculatedNextTurnValue
    string nextTurnText = nextTurnType == 0 or na(daysUntilNextTurn) ? "—" : f_turnTypeText(nextTurnType) + " in " + str.tostring(daysUntilNextTurn) + "D"

    int currentProfileState = STATE_NONE
    float currentSmoothStep = na
    float currentProfileConfidence = na
    int currentProfileSamples = 0
    int futureLongCount = 0
    int futureShortCount = 0
    int futureRangeCount = 0
    float futureStepSum = 0.0
    int futureStepSamples = 0
    int tacticalSize = array.size(profileOffset)
    if tacticalSize > 0
        for profileIndex = 0 to tacticalSize - 1
            int offsetFromOrigin = array.get(profileOffset, profileIndex)
            float smoothStep = array.get(profileSmoothStep, profileIndex)
            int state = array.get(profileState, profileIndex)
            if offsetFromOrigin == 0
                currentProfileState := state
                currentSmoothStep := smoothStep
                currentProfileConfidence := array.get(profileConfidence, profileIndex)
                currentProfileSamples := array.get(profileSamples, profileIndex)
            if offsetFromOrigin > 0
                futureLongCount += state == STATE_LONG ? 1 : 0
                futureShortCount += state == STATE_SHORT ? 1 : 0
                futureRangeCount += state == STATE_RANGE ? 1 : 0
                if not na(smoothStep)
                    futureStepSum += smoothStep
                    futureStepSamples += 1
    int dominantFutureState = STATE_NONE
    int dominantFutureCount = math.max(futureLongCount, math.max(futureShortCount, futureRangeCount))
    if dominantFutureCount > 0
        dominantFutureState := futureLongCount == dominantFutureCount ? STATE_LONG : futureShortCount == dominantFutureCount ? STATE_SHORT : STATE_RANGE
    float averageFutureStep = futureStepSamples > 0 ? futureStepSum / futureStepSamples : na

    bool has30DHorizon = f_hasCompleteHorizonStats()
    float forward30Delta = has30DHorizon ? array.get(horizonAvgDelta, HORIZON_30D_INDEX) : na
    int forward30Samples = has30DHorizon ? array.get(horizonSampleCount, HORIZON_30D_INDEX) : 0
    int forward30ExpectedSamples = has30DHorizon ? array.get(horizonExpectedSamples, HORIZON_30D_INDEX) : classicLookbackYears
    float forward30Coverage = has30DHorizon ? array.get(horizonCoverage, HORIZON_30D_INDEX) : na
    string forward30Reliability = has30DHorizon ? array.get(horizonReliability, HORIZON_30D_INDEX) : "N/A"
    bool hasRecentHorizons = f_hasCompleteRecentHorizonStats()
    float recent30Delta = hasRecentHorizons ? array.get(recentHorizonAvgDelta, HORIZON_30D_INDEX) : na
    int recent30Samples = hasRecentHorizons ? array.get(recentHorizonSampleCount, HORIZON_30D_INDEX) : 0
    int recent30ExpectedSamples = hasRecentHorizons ? array.get(recentHorizonExpectedSamples, HORIZON_30D_INDEX) : math.min(RECENT_LOOKBACK_MAX_YEARS, classicLookbackYears)
    string recent30Reliability = hasRecentHorizons ? array.get(recentHorizonReliability, HORIZON_30D_INDEX) : "N/A"
    bool hasConditionalHorizons = f_hasCompleteConditionalHorizonStats()
    bool hasConditional30D = has30DHorizon and hasConditionalHorizons and not na(array.get(horizonMedianDelta, HORIZON_30D_INDEX)) and not na(array.get(conditionalHorizonMedianDelta, HORIZON_30D_INDEX))
    bool hasConditional20D = has30DHorizon and hasConditionalHorizons and not na(array.get(horizonMedianDelta, HORIZON_20D_INDEX)) and not na(array.get(conditionalHorizonMedianDelta, HORIZON_20D_INDEX))
    int conditionalReferenceIndex = hasConditional30D ? HORIZON_30D_INDEX : hasConditional20D ? HORIZON_20D_INDEX : na
    float conditionalReferenceAllMedian = not na(conditionalReferenceIndex) ? array.get(horizonMedianDelta, conditionalReferenceIndex) : na
    float conditionalReferenceMatchedMedian = not na(conditionalReferenceIndex) ? array.get(conditionalHorizonMedianDelta, conditionalReferenceIndex) : na
    int conditionalReferenceMatchedSamples = not na(conditionalReferenceIndex) ? array.get(conditionalHorizonSampleCount, conditionalReferenceIndex) : 0
    currentConditionalViewLabel := f_conditionalViewLabel(conditionalReferenceAllMedian, conditionalReferenceMatchedMedian, conditionalReferenceMatchedSamples)
    string regimeContextText = f_formatRegimeTrend(currentTrendRegimeCode) + " / " + f_formatRegimeVol(currentVolRegimeCode) + " / " + f_formatRegimeDrawdown(currentDrawdownRegimeCode)
    string matchModeText = f_formatMatchMode(currentMatchModeCode)
    string regimeMatchText = na(currentMatchedAnchorCount) ? "—" : f_formatConditionalSamples(currentMatchedAnchorCount, classicLookbackYears)
    string conditionalViewDisplay = currentConditionalViewLabel == "n/a" and not na(currentMatchedAnchorCount) and currentMatchedAnchorCount < CONDITIONAL_MIN_MATCHED_SAMPLES ? "Low sample" : currentConditionalViewLabel
    string regimeMatchSummary = regimeMatchText + " · " + (currentMatchModeCode == MATCH_MODE_LOW_SAMPLE ? matchModeText : matchModeText + " · " + conditionalViewDisplay)
    string conditionalReferenceHorizonText = not na(conditionalReferenceIndex) ? str.tostring(array.get(horizonDays, conditionalReferenceIndex)) + "D Matched" : "30D Matched"
    string conditionalMatchedSummary = conditionalViewDisplay == "n/a" or conditionalViewDisplay == "Low sample" or na(conditionalReferenceIndex) ? "—" : f_formatSignedPct(conditionalReferenceMatchedMedian) + " / " + f_formatRate(array.get(conditionalHorizonPositiveRate, conditionalReferenceIndex))

    int evidenceReferenceIndex = f_getEvidenceReferenceIndex()
    bool hasEvidenceReference = f_hasUsableAllYearsStats(evidenceReferenceIndex)
    float evidenceAllAvg = na
    float evidenceAllMedian = na
    float evidenceAllPositiveRate = na
    float evidenceMedianAdverse = na
    float evidenceWorstAdverse = na
    float evidenceMedianFavorable = na
    float evidenceRewardRisk = na
    int evidenceAllSamples = na
    int evidenceAllExpectedSamples = na
    float evidenceRecentDelta = na
    float evidenceMatchedMedian = na
    float evidenceMatchedPositiveRate = na
    int evidenceMatchedSamples = na
    string evidenceConditionalView = "n/a"
    if hasEvidenceReference
        evidenceAllAvg := array.get(horizonAvgDelta, evidenceReferenceIndex)
        evidenceAllMedian := array.get(horizonMedianDelta, evidenceReferenceIndex)
        evidenceAllPositiveRate := array.get(horizonPositiveRate, evidenceReferenceIndex)
        evidenceMedianAdverse := array.get(horizonMedianAdverse, evidenceReferenceIndex)
        evidenceWorstAdverse := array.get(horizonWorstAdverse, evidenceReferenceIndex)
        evidenceMedianFavorable := array.get(horizonMedianFavorable, evidenceReferenceIndex)
        evidenceRewardRisk := array.get(horizonRewardRisk, evidenceReferenceIndex)
        evidenceAllSamples := array.get(horizonSampleCount, evidenceReferenceIndex)
        evidenceAllExpectedSamples := array.get(horizonExpectedSamples, evidenceReferenceIndex)
        if array.size(recentHorizonAvgDelta) > evidenceReferenceIndex
            evidenceRecentDelta := array.get(recentHorizonAvgDelta, evidenceReferenceIndex)
        if array.size(conditionalHorizonSampleCount) > evidenceReferenceIndex
            evidenceMatchedSamples := array.get(conditionalHorizonSampleCount, evidenceReferenceIndex)
        if array.size(conditionalHorizonMedianDelta) > evidenceReferenceIndex
            evidenceMatchedMedian := array.get(conditionalHorizonMedianDelta, evidenceReferenceIndex)
        if array.size(conditionalHorizonPositiveRate) > evidenceReferenceIndex
            evidenceMatchedPositiveRate := array.get(conditionalHorizonPositiveRate, evidenceReferenceIndex)
        evidenceConditionalView := f_conditionalViewLabel(evidenceAllMedian, evidenceMatchedMedian, nz(evidenceMatchedSamples, 0))
    string evidenceRiskContext = f_riskContextLabel(evidenceAllMedian, evidenceMedianAdverse, evidenceWorstAdverse, evidenceMedianFavorable, evidenceRewardRisk)
    string evidenceLabel = f_formatEvidenceLabel(f_seasonalEvidenceLabel(evidenceAllAvg, evidenceAllMedian, evidenceAllPositiveRate, evidenceAllSamples, evidenceAllExpectedSamples, evidenceRecentDelta, evidenceMatchedMedian, evidenceMatchedPositiveRate, evidenceMatchedSamples, evidenceConditionalView, matchModeText, evidenceMedianAdverse, evidenceWorstAdverse, evidenceMedianFavorable, evidenceRewardRisk))
    float evidenceDirectionConsistency = f_directionConsistency(evidenceAllMedian, evidenceAllPositiveRate)
    string evidenceReason = f_seasonalEvidenceReason(evidenceLabel, evidenceConditionalView, matchModeText, evidenceAllSamples, evidenceAllExpectedSamples, evidenceMatchedSamples, evidenceAllAvg, evidenceAllMedian, evidenceRecentDelta, evidenceRiskContext, evidenceDirectionConsistency)
    string evidenceRiskContextText = f_formatRiskContext(evidenceRiskContext)
    string evidenceSummaryText = evidenceLabel == EVIDENCE_NA or evidenceReason == EVIDENCE_NA ? evidenceLabel : evidenceLabel + " · " + evidenceReason
    string stability = f_stabilityStatus(forward30Delta, recent30Delta, forward30Reliability, recent30Reliability)
    string alignment = f_alignmentStatus(forward30Delta, currentProfileState, dominantFutureState, currentProfileConfidence, forward30Reliability)

    if isSupportedView and needsClassicProfile
        [classicYMin, classicYMax] = f_drawClassicCurve(anchorYear)
        [currentYearYMin, currentYearYMax] = f_drawCurrentYearPath(anchorYear)
        float contextYMin = na(currentYearYMin) ? classicYMin : na(classicYMin) ? currentYearYMin : math.min(classicYMin, currentYearYMin)
        float contextYMax = na(currentYearYMax) ? classicYMax : na(classicYMax) ? currentYearYMax : math.max(classicYMax, currentYearYMax)
        f_drawTurningPoints(anchorYear, contextYMin, contextYMax)
        if showCurrentDateMarker
            float markerMin = na(contextYMin) ? -1.0 : math.min(contextYMin, 0.0)
            float markerMax = na(contextYMax) ? 1.0 : math.max(contextYMax, 0.0)
            float markerRange = math.max(markerMax - markerMin, 1.0)
            float markerPadding = markerRange * 0.08
            int currentDateTs = f_seasonTs(anchorYear, anchorMonth, anchorDay)
            currentDateMarker := line.new(currentDateTs, markerMin - markerPadding, currentDateTs, markerMax + markerPadding, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.yellow, 25), style = line.style_dashed, width = 1)
        // Combined uses Tactical states only as ribbons on the Classic scale; no Tactical step line is drawn.
        if showCombinedMode
            int combinedOriginTime = anchorChartTime
            f_drawStateBackground(combinedOriginTime, contextYMin, contextYMax)

    if isSupportedView and showRobustMode
        [robustYMin, robustYMax] = f_drawRobustDistribution(anchorYear)
        [robustCurrentYearYMin, robustCurrentYearYMax] = f_drawCurrentYearPath(anchorYear)
        float robustContextYMin = na(robustCurrentYearYMin) ? robustYMin : na(robustYMin) ? robustCurrentYearYMin : math.min(robustYMin, robustCurrentYearYMin)
        float robustContextYMax = na(robustCurrentYearYMax) ? robustYMax : na(robustYMax) ? robustCurrentYearYMax : math.max(robustYMax, robustCurrentYearYMax)
        f_drawTurningPoints(anchorYear, robustContextYMin, robustContextYMax)
        if showCurrentDateMarker
            float markerMin = na(robustContextYMin) ? -1.0 : math.min(robustContextYMin, 0.0)
            float markerMax = na(robustContextYMax) ? 1.0 : math.max(robustContextYMax, 0.0)
            float markerRange = math.max(markerMax - markerMin, 1.0)
            float markerPadding = markerRange * 0.08
            int currentDateTs = f_seasonTs(anchorYear, anchorMonth, anchorDay)
            currentDateMarker := line.new(currentDateTs, markerMin - markerPadding, currentDateTs, markerMax + markerPadding, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.yellow, 25), style = line.style_dashed, width = 1)

    if isSupportedView and showTacticalMode
        int tacticalOriginTime = anchorChartTime
        [profileYMin, profileYMax] = f_drawTacticalProfile(tacticalOriginTime)
        f_drawStateBackground(tacticalOriginTime, profileYMin, profileYMax)

    f_drawStatsTable(statsTable)
    f_clearStatusTable(statusTable)
    if contextPanelMode != PANEL_NONE
        bool fullContextMode = contextPanelMode == PANEL_FULL
        int contextRow = 1
        f_statusHeader(statusTable, 0, "Season Profile", f_modeLabel() + " · " + timeframe.period, PANEL_TIP_HEADER)
        if not isSupportedView
            f_statusRow(statusTable, contextRow, "Notice", "Supported views: 15m to 1D", PANEL_TIP_UNSUPPORTED_NOTICE)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Guidance", "Use 15m, 30m, 1H, 4H, or 1D", PANEL_TIP_UNSUPPORTED_GUIDANCE)
        else if showClassicMode
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Lookback", str.tostring(classicLookbackYears) + "Y", PANEL_TIP_LOOKBACK)
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Compounding", classicCompounding ? "Yes" : "No", PANEL_TIP_COMPOUNDING)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Date", f_formatDate(anchorMonth, anchorDay), PANEL_TIP_CURRENT_DATE)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Year", f_formatSignedPct(currentYearYtd), PANEL_TIP_CURRENT_YEAR)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Classic YTD", f_formatSignedPct(currentClassicYtd), PANEL_TIP_CLASSIC_YTD)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Current-Year Deviation", f_formatSignedPct(currentYearDeviation), PANEL_TIP_CURRENT_YEAR_DEVIATION)
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Deviation Context", currentYearDeviationStatus, PANEL_TIP_DEVIATION_CONTEXT)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Next Turn", nextTurnText, PANEL_TIP_NEXT_TURN)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Stability", stability, PANEL_TIP_STABILITY)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "30D Δ: Full / Recent", f_formatSignedPct(forward30Delta) + " / " + f_formatSignedPct(recent30Delta), PANEL_TIP_NEXT_30D_FULL_RECENT)
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Recent Samples", f_formatSamples(recent30Samples, recent30ExpectedSamples), PANEL_TIP_RECENT_SAMPLES)
                contextRow += 1
            f_statusReliabilityRow(statusTable, contextRow, forward30Reliability, forward30Coverage, PANEL_TIP_RELIABILITY)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Regime", regimeContextText, PANEL_TIP_REGIME_CONTEXT)
                contextRow += 1
                f_statusRow(statusTable, contextRow, "Matched", regimeMatchSummary, PANEL_TIP_MATCHED_STATUS)
                contextRow += 1
                f_statusRow(statusTable, contextRow, conditionalReferenceHorizonText, conditionalMatchedSummary, PANEL_TIP_CONDITIONAL_REFERENCE)
                contextRow += 1
            f_statusColoredRow(statusTable, contextRow, "Evidence", evidenceSummaryText, f_evidenceTextColor(evidenceLabel), PANEL_TIP_SEASONAL_EVIDENCE)
            contextRow += 1
            f_statusColoredRow(statusTable, contextRow, "Risk Context", evidenceRiskContextText, f_riskContextTextColor(evidenceRiskContext), PANEL_TIP_RISK_CONTEXT)
        else if showRobustMode
            if fullContextMode
                f_statusRow(statusTable, contextRow, "Lookback", str.tostring(classicLookbackYears) + "Y", PANEL_TIP_LOOKBACK)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Date", f_formatDate(anchorMonth, anchorDay), PANEL_TIP_CURRENT_DATE)
            contextRow += 1
            f_statusRow(statusTable, contextRow, "Median YTD", f_formatSignedPct(currentRobustMedian), PANEL_TIP_MEDIAN_YTD)
            contextRow += 1
            if fullContextMode
                f_statusRow(statusTable, contextRow, "P25-P75 Width", f_formatSignedPct(currentRobustBandWidth), PANEL_TIP_P25_P75_WIDTH)
                contextRow += 1
            f_statusRow(statusTable, contextRow, "Current Year", f_formatSignedPct(currentYearYtd), PANEL_TIP_CURRENT_YEAR)
