f_hasUsableMatchedStats(int index) =>
    bool inRange = not na(index) and index >= 0 and array.size(conditionalHorizonAvgDelta) > index and array.size(conditionalHorizonMedianDelta) > index and array.size(conditionalHorizonPositiveRate) > index and array.size(conditionalHorizonMedianAdverse) > index and array.size(conditionalHorizonWorstAdverse) > index and array.size(conditionalHorizonMedianFavorable) > index and array.size(conditionalHorizonRewardRisk) > index and array.size(conditionalHorizonSampleCount) > index and array.size(conditionalHorizonExpectedSamples) > index and array.size(conditionalHorizonCoverage) > index and array.size(conditionalHorizonReliability) > index
    bool result = false
    if inRange
        int matchedSamples = array.get(conditionalHorizonSampleCount, index)
