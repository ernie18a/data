        if maxVal > 0
            float zMid = hvbLo + maxIdx * hvbBinSize + hvbBinSize / 2.0
            if rank == 0
                hvbZone2 := zMid
            else
                hvbZone3 := zMid
            array.set(hvbBinCalc, maxIdx, 0.0)
float _chochMinConf   = 2.78
float _smtMinConf     = 2.83
