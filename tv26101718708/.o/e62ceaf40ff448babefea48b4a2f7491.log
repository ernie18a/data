bool showRsiCandlePressureEnvelope =
     rsiCandlePressureActive

color rsiCandlePressureInvisibleColor =
     color.new(color.white, 100)

plotRsiCandlePressureUpper = plot(
     showRsiCandlePressureEnvelope ? rsiCandlePressureUpper : na,
     title="RSI Pressure Envelope Upper",
