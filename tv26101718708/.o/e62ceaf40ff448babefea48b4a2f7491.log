// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Composite Crossover Plots
// ──────────────────────────────────────────────
bool showRsiCompCrossPlot =
     in_showRsiCompCross

plotRsiCompFast = plot(
     showRsiCompCrossPlot ? rsiCompFastLine : na,
