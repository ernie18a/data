// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Pressure Oscillator Plots
// ──────────────────────────────────────────────
bool showRsiPressurePlot =
     in_showRsiPressure

plot(
     showRsiPressurePlot ? wt2_rsi : na,
