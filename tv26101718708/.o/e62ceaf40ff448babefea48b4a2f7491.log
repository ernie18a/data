int in_rsi1Len = input.int(defval=5, minval=1, title="RSI 1 Length", group=G_RSI_SERIES, tooltip=TT_RSI_LEN)
string in_rsi1PlotMode = input.string(defval="Show", title="RSI 1", options=["Show", "Hide"], group=G_RSI_SERIES, tooltip=TT_RSI_PLOT_MODE)
bool in_showRsi1Plot = in_rsi1PlotMode == "Show"

