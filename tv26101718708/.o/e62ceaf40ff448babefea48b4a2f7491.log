// ──────────────────────────────────────────────
bool showRsiSynthCandlePlot =
     in_showRsiSynthCandles

plotcandle(
     showRsiSynthCandlePlot ? rsiSynthOpen : na,
     showRsiSynthCandlePlot ? rsiSynthHigh : na,
     showRsiSynthCandlePlot ? rsiSynthLow : na,
     showRsiSynthCandlePlot ? rsiSynthClose : na,
     title="RSI Synthetic Candles",
     color=rsiSynthBodyColor,
     wickcolor=rsiSynthWickColor,
     bordercolor=rsiSynthBorderColor,
     show_last=in_rsiSynthCandleLastNBars)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Pressure Envelope
