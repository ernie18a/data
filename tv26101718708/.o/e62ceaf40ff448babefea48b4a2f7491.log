// ================================================================================
// 🔴 END REGION: Plot + Chart Rendering
// ================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Lookback High/Low Boxes
// ==============================================================================================
//
// 📌 Purpose:
//     Draws dynamic boxes showing the recent RSI 14 high and low zones.
//
// 🧠 Behavior:
//     • Upper box is built from the highest RSI 14 value over the selected lookback.
//     • Lower box is built from the lowest RSI 14 value over the selected lookback.
//     • The RSI midpoint is treated as 50.
//     • Inner Box Percentage controls how far each box extends back toward 50.
//     • Box Lookback controls the scan window.
//     • Each box begins at the actual RSI high/low bar found inside that window.
//
// 🎨 Visual Notes:
//     • Upper box highlights the recent RSI high zone.
//     • Lower box highlights the recent RSI low zone.
//     • Higher transparency keeps the boxes subtle behind the RSI plots.
//
// ==============================================================================================

float rsiBoxMidpoint = 50.0

float rsiBoxHigh = ta.highest(rsi14, in_rsiBoxLen)
float rsiBoxLow  = ta.lowest(rsi14, in_rsiBoxLen)

float rsiUpperInner = rsiBoxMidpoint + ((rsiBoxHigh - rsiBoxMidpoint) * in_rsiBoxInnerPct)
float rsiLowerInner = rsiBoxMidpoint - ((rsiBoxMidpoint - rsiBoxLow) * in_rsiBoxInnerPct)

int rsiBoxHighOffset = ta.highestbars(rsi14, in_rsiBoxLen)
int rsiBoxLowOffset  = ta.lowestbars(rsi14, in_rsiBoxLen)

int rsiUpperBoxLeft = math.max(bar_index + rsiBoxHighOffset, 0)
int rsiLowerBoxLeft = math.max(bar_index + rsiBoxLowOffset, 0)
int rsiBoxRight     = bar_index

bool showRsiUpperBox = in_showRsiBoxes and rsiBoxHigh > rsiBoxMidpoint
bool showRsiLowerBox = in_showRsiBoxes and rsiBoxLow < rsiBoxMidpoint

color rsiUpperBoxFillColor   = color.new(in_rsiUpperBoxColor, in_rsiBoxTransp)
color rsiUpperBoxBorderColor = color.new(in_rsiUpperBoxColor, in_rsiBoxBorderTransp)

color rsiLowerBoxFillColor   = color.new(in_rsiLowerBoxColor, in_rsiBoxTransp)
color rsiLowerBoxBorderColor = color.new(in_rsiLowerBoxColor, in_rsiBoxBorderTransp)

var box rsiUpperLookbackBox = na
var box rsiLowerLookbackBox = na

if barstate.islast
    rsiUpperLookbackBox := f_syncBox(
         rsiUpperLookbackBox,
         showRsiUpperBox,
         rsiUpperBoxLeft,
         rsiBoxRight,
         rsiBoxHigh,
         rsiUpperInner,
         rsiUpperBoxFillColor,
         rsiUpperBoxBorderColor)

    rsiLowerLookbackBox := f_syncBox(
         rsiLowerLookbackBox,
         showRsiLowerBox,
         rsiLowerBoxLeft,
         rsiBoxRight,
         rsiLowerInner,
         rsiBoxLow,
         rsiLowerBoxFillColor,
         rsiLowerBoxBorderColor)

// ==============================================================================================
// 🔴 END REGION: RSI Lookback High/Low Boxes
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Value Labels
// ==============================================================================================
//
// 📌 Purpose:
//     Draws padded right-side labels for RSI 1 and RSI 2.
//
// 🧠 Behavior:
//     • RSI 1 label follows the current RSI 1 value.
//     • RSI 2 label follows the current RSI 2 value.
//     • First row shows the RSI name.
//     • Second row shows the rounded current RSI value.
//     • Third row shows the rounded one-bar delta.
//     • Label text is calculated on every bar for Pine consistency.
//     • Labels update in place only on the last bar to prevent flicker.
//     • Text uses each RSI plot's current color.
//
// ==============================================================================================

var label rsi1ValueLabel = na
var label rsi2ValueLabel = na

string rsi1ValueLabelText = f_rsiValueLabelText("RSI 1", rsi1, in_rsi1ValueLabelPad)
string rsi2ValueLabelText = f_rsiValueLabelText("RSI 2", rsi2, in_rsi2ValueLabelPad)

bool showRsi1ValueLabel = in_showRsiValueLabels and in_showRsi1Plot
bool showRsi2ValueLabel = in_showRsiValueLabels and in_showRsi2Plot

if barstate.islast
    int rsiValueLabelX = bar_index

    rsi2ValueLabel := f_updateRsiValueLabel(
         rsi2ValueLabel,
         showRsi2ValueLabel,
         rsiValueLabelX,
         rsi2,
         rsi2ValueLabelText,
         rsi2PlotColor,
         in_rsiValueLabelSize)

    rsi1ValueLabel := f_updateRsiValueLabel(
         rsi1ValueLabel,
         showRsi1ValueLabel,
         rsiValueLabelX,
         rsi1,
         rsi1ValueLabelText,
         rsi1PlotColor,
         in_rsiValueLabelSize)

// ==============================================================================================
// 🔴 END REGION: RSI Value Labels
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: SMA 20/50 RSI Value Labels
// ==============================================================================================
//
// 📌 Purpose:
//     Draws padded right-side labels for the RSI 20/50 crossover lines.
//
// 🧠 Behavior:
//     • Fast label follows the current RSI fast crossover line.
//     • Slow label follows the current RSI slow crossover line.
//     • First row shows the line name.
//     • Second row shows the rounded current value.
//     • Third row shows the rounded one-bar delta.
//     • Each label has independent text padding.
//     • Labels update in place only on the last bar to prevent flicker.
//
// ==============================================================================================

var label rsiSmaFastValueLabel = na
var label rsiSmaSlowValueLabel = na

string rsiSmaFastLabelName = in_rsiSmaFastMaType + " " + str.tostring(in_rsiSmaFastLen)
string rsiSmaSlowLabelName = in_rsiSmaSlowMaType + " " + str.tostring(in_rsiSmaSlowLen)

string rsiSmaFastValueLabelText = f_rsiValueLabelText(rsiSmaFastLabelName, rsiSmaFastLine, in_rsiSmaFastLabelPad)
string rsiSmaSlowValueLabelText = f_rsiValueLabelText(rsiSmaSlowLabelName, rsiSmaSlowLine, in_rsiSmaSlowLabelPad)

color rsiSmaLabelColor =
     rsiSmaBullState
     ? color.new(in_rsiSmaCrossBullColor, 0)
     : color.new(in_rsiSmaCrossBearColor, 0)

bool showRsiSmaLabelSet =
     in_showRsiSmaCross and
     in_showRsiValueLabels

if barstate.islast
    int rsiSmaLabelX = bar_index

    rsiSmaFastValueLabel := f_updateRsiValueLabel(
         rsiSmaFastValueLabel,
         showRsiSmaLabelSet,
         rsiSmaLabelX,
         rsiSmaFastLine,
         rsiSmaFastValueLabelText,
         rsiSmaLabelColor,
         in_rsiValueLabelSize)

    rsiSmaSlowValueLabel := f_updateRsiValueLabel(
         rsiSmaSlowValueLabel,
         showRsiSmaLabelSet,
         rsiSmaLabelX,
         rsiSmaSlowLine,
         rsiSmaSlowValueLabelText,
         rsiSmaLabelColor,
         in_rsiValueLabelSize)

// ==============================================================================================
// 🔴 END REGION: SMA 20/50 RSI Value Labels
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Guide Level Labels
// ==============================================================================================
//
// 📌 Purpose:
//     Draws right-side labels for the active RSI guide levels.
//
// 🧠 Behavior:
//     • Labels follow the upper, middle, and lower guide-level inputs.
//     • Text uses the same colors as the guide plots.
//     • Labels update in place only on the last bar to prevent flicker.
//     • Labels automatically hide when RSI Guide Levels are hidden.
//
// ==============================================================================================

var label rsiUpperGuideLabel = na
var label rsiMidGuideLabel   = na
var label rsiLowerGuideLabel = na

bool showRsiGuideLabelSet = in_showRsiGuides and in_showRsiGuideLabels

string rsiGuideLabelPad = f_spacer(in_rsiGuideLabelPad)

string rsiUpperGuideLabelText = rsiGuideLabelPad + f_rsiWholeFmt(in_rsiUpperGuideLevel)
string rsiMidGuideLabelText   = rsiGuideLabelPad + f_rsiWholeFmt(in_rsiMidGuideLevel)
string rsiLowerGuideLabelText = rsiGuideLabelPad + f_rsiWholeFmt(in_rsiLowerGuideLevel)

color rsiUpperGuideLabelColor = color.new(in_rsiUpperGuideColor, 0)
color rsiMidGuideLabelColor   = color.new(in_rsiMidGuideColor, 0)
color rsiLowerGuideLabelColor = color.new(in_rsiLowerGuideColor, 0)

if barstate.islast
    int rsiGuideLabelX = bar_index

    rsiUpperGuideLabel := f_updateRsiGuideLabel(
         rsiUpperGuideLabel,
         showRsiGuideLabelSet,
         rsiGuideLabelX,
         in_rsiUpperGuideLevel,
         rsiUpperGuideLabelText,
         rsiUpperGuideLabelColor,
         in_rsiGuideLabelSize)

    rsiMidGuideLabel := f_updateRsiGuideLabel(
         rsiMidGuideLabel,
         showRsiGuideLabelSet,
         rsiGuideLabelX,
         in_rsiMidGuideLevel,
         rsiMidGuideLabelText,
         rsiMidGuideLabelColor,
         in_rsiGuideLabelSize)

    rsiLowerGuideLabel := f_updateRsiGuideLabel(
         rsiLowerGuideLabel,
         showRsiGuideLabelSet,
         rsiGuideLabelX,
         in_rsiLowerGuideLevel,
         rsiLowerGuideLabelText,
         rsiLowerGuideLabelColor,
         in_rsiGuideLabelSize)

// ==============================================================================================
// 🔴 END REGION: RSI Guide Level Labels
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Follow Lines
// ==============================================================================================
//
// 📌 Purpose:
//     Draws hardcoded horizontal follow lines at the current RSI 1 and RSI 2 values.
//
// 🧠 Behavior:
//     • RSI 1 follow line tracks the live RSI 1 value.
//     • RSI 2 follow line tracks the live RSI 2 value.
//     • Lines update only on the last bar to prevent flicker.
//     • Each line extends slightly left and right from the active candle.
//     • Each line uses its matching RSI plot color for visual consistency.
//     • Each follow line hides when its matching RSI plot is hidden.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Follow Line Helper
// ──────────────────────────────────────────────
f_syncFollowLine(line _line, bool _show, float _y, color _color, int _leftBars, int _rightBars, int _width, string _style) =>
    line _out =
         _line

    if _show and not na(_y)
        int _x1 =
             bar_index - _leftBars

        int _x2 =
             bar_index + _rightBars

        if na(_out)
            _out := line.new(
                 x1=_x1,
                 y1=_y,
                 x2=_x2,
                 y2=_y,
                 xloc=xloc.bar_index,
                 extend=extend.none,
                 color=_color,
                 width=_width,
                 style=_style)
        else
            line.set_xy1(_out, _x1, _y)
            line.set_xy2(_out, _x2, _y)
            line.set_color(_out, _color)
            line.set_width(_out, _width)
            line.set_style(_out, _style)
    else
        if not na(_out)
            line.delete(_out)
            _out := na

    _out

// ──────────────────────────────────────────────
// 🟦 Subregion: Hardcoded Follow Line Settings
// ──────────────────────────────────────────────
bool showRsi1FollowLine = in_showRsi1Plot
bool showRsi2FollowLine = in_showRsi2Plot

int rsiFollowLeftBars = 0
int rsiFollowRightBars = 2
int rsiFollowLineWidth = 2

string rsiFollowLineStyle = line.style_dotted

// ──────────────────────────────────────────────
// 🟦 Subregion: Follow Line Render
// ──────────────────────────────────────────────
var line rsi1FollowLine = na
var line rsi2FollowLine = na

if barstate.islast
    rsi2FollowLine := f_syncFollowLine(
         rsi2FollowLine,
         showRsi2FollowLine,
         rsi2,
         rsi2PlotColor,
         rsiFollowLeftBars,
         rsiFollowRightBars,
         rsiFollowLineWidth,
         rsiFollowLineStyle)

    rsi1FollowLine := f_syncFollowLine(
         rsi1FollowLine,
         showRsi1FollowLine,
         rsi1,
         rsi1PlotColor,
         rsiFollowLeftBars,
         rsiFollowRightBars,
         rsiFollowLineWidth,
         rsiFollowLineStyle)

// ==============================================================================================
// 🔴 END REGION: RSI Follow Lines
// ==============================================================================================
