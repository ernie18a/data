bool in_showRsiOscChartDivLines = in_rsiOscChartDivMode == "Show"

float in_rsiOscDivPivotSize = input.float(defval=12.0, minval=0.1, step=1.0, title="  ↳ Oscillator Pivot Size", group=G_RSI_OSC_DIVERGENCE, tooltip=TT_RSI_OSC_DIV_PIVOT_SIZE, active=activeRsiOscDivInputs)
int in_rsiOscDivLastNBars = input.int(defval=144, minval=1, maxval=1500, title="  ↳ Divergence Last N Bars", group=G_RSI_OSC_DIVERGENCE, tooltip=TT_RSI_OSC_DIV_LAST_N, active=activeRsiOscDivInputs)

string in_rsiOscDivPersistMode = input.string(defval="Persist Until Replaced", title="  ↳ Divergence Persistence", options=["Persist Until Replaced", "Clear If Newest Pair Is Not Divergent"], group=G_RSI_OSC_DIVERGENCE, tooltip=TT_RSI_OSC_DIV_PERSIST, active=activeRsiOscDivInputs)
bool in_clearRsiOscDivWhenNewestPairFails = in_rsiOscDivPersistMode == "Clear If Newest Pair Is Not Divergent"

int in_rsiOscDivLineWidth = input.int(defval=2, minval=1, maxval=5, title="  ↳ Line Width", group=G_RSI_OSC_DIVERGENCE, tooltip=TT_RSI_OSC_DIV_WIDTH, active=activeRsiOscDivInputs)
string in_rsiOscDivLineStyle = input.string(defval="Dotted", title="  ↳ Line Style", options=["Solid", "Dashed", "Dotted"], group=G_RSI_OSC_DIVERGENCE, tooltip=TT_RSI_OSC_DIV_STYLE, active=activeRsiOscDivInputs)

color in_rsiOscBullDivColor = input.color(defval=color.rgb(255, 120, 30), title="Bullish Regular Color", group=G_RSI_OSC_DIVERGENCE, active=in_showRsiOscDivLines)
color in_rsiOscBearDivColor = input.color(defval=color.rgb(141, 1, 235), title="Bearish Regular Color", group=G_RSI_OSC_DIVERGENCE, active=in_showRsiOscDivLines)

color in_rsiOscHiddenBullDivColor = input.color(defval=#a8ff37, title="Hidden Bullish Color", group=G_RSI_OSC_DIVERGENCE, active=in_showRsiOscHiddenDivLines)
color in_rsiOscHiddenBearDivColor = input.color(defval=color.rgb(255, 55, 135), title="Hidden Bearish Color", group=G_RSI_OSC_DIVERGENCE, active=in_showRsiOscHiddenDivLines)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Synthetic Candle Inputs
// ──────────────────────────────────────────────
string in_rsiSynthCandleMode = input.string(defval="Show", title="RSI Synthetic Candles", options=["Show", "Hide"], group=G_RSI_SYNTH_CANDLES, tooltip=TT_RSI_SYNTH_CANDLES)
bool in_showRsiSynthCandles = in_rsiSynthCandleMode == "Show"

int in_rsiSynthCandleLastNBars = input.int(defval=55, minval=1, title="  ↳ Synthetic Candles Last N Bars", group=G_RSI_SYNTH_CANDLES, tooltip=TT_RSI_PLOT_LAST_N, active=in_showRsiSynthCandles)

int in_rsiSynthBodyTransp = input.int(defval=85, minval=0, maxval=100, title="Body Transparency", group=G_RSI_SYNTH_CANDLES, tooltip=TT_CANDLE_BODY_TRANSP, active=in_showRsiSynthCandles)
int in_rsiSynthWickTransp = input.int(defval=20, minval=0, maxval=100, title="Wick Transparency", group=G_RSI_SYNTH_CANDLES, tooltip=TT_CANDLE_WICK_TRANSP, active=in_showRsiSynthCandles)
int in_rsiSynthBorderTransp = input.int(defval=0, minval=0, maxval=100, title="Border Transparency", group=G_RSI_SYNTH_CANDLES, tooltip=TT_CANDLE_BORDER_TRANSP, active=in_showRsiSynthCandles)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Pressure Envelope Inputs
// ──────────────────────────────────────────────
string in_rsiCandlePressureMode = input.string(defval="Show", title="RSI Pressure Envelope", options=["Show", "Hide"], group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_MODE)
bool in_showRsiCandlePressure = in_rsiCandlePressureMode == "Show"

int in_rsiCandlePressureLastNBars = input.int(defval=55, minval=1, title="  ↳ Envelope Last N Bars", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_LAST_N, active=in_showRsiCandlePressure)

float in_rsiCandlePressureUpperTrigger = input.float(defval=68.0, minval=0.0, maxval=100.0, step=0.5, title="Upper Trigger", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_UPPER, active=in_showRsiCandlePressure)
float in_rsiCandlePressureLowerTrigger = input.float(defval=32.0, minval=0.0, maxval=100.0, step=0.5, title="Lower Trigger", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_LOWER, active=in_showRsiCandlePressure)

float in_rsiCandlePressurePad = input.float(defval=5.0, minval=0.0, step=0.25, title="Envelope Padding", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_PAD, active=in_showRsiCandlePressure)
int in_rsiCandlePressureFillTransp = input.int(defval=85, minval=0, maxval=100, title="Fill Transparency", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_FILL_TRANSP, active=in_showRsiCandlePressure)

color in_rsiCandlePressureUpperFill = input.color(defval=#ff5900, title="Upper Envelope Fill", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_UPPER_COLOR, active=in_showRsiCandlePressure)
color in_rsiCandlePressureLowerFill = input.color(defval=#e900ca, title="Lower Envelope Fill", group=G_RSI_CANDLE_PRESSURE, tooltip=TT_RSI_CANDLE_PRESSURE_LOWER_COLOR, active=in_showRsiCandlePressure)

// ──────────────────────────────────────────────
// 🟦 Subregion: Price PlotCandle Overlay Inputs
// ──────────────────────────────────────────────
string in_pricePlotCandleMode = input.string(defval="Show", title="Candles - Chart", options=["Show", "Hide"], group=G_PRICE_PLOTCANDLES, tooltip=TT_PRICE_PLOTCANDLES)
bool in_showPricePlotCandles = in_pricePlotCandleMode == "Show"

int in_pricePlotCandleLastNBars = input.int(defval=144, minval=1, title="  ↳ Candles Last N Bars", group=G_PRICE_PLOTCANDLES, tooltip=TT_PRICE_PLOTCANDLES_LAST_N, active=in_showPricePlotCandles)

int in_pricePlotCandleBodyTransp = input.int(defval=80, minval=0, maxval=100, title="Body Transparency", group=G_PRICE_PLOTCANDLES, tooltip=TT_CANDLE_BODY_TRANSP, active=in_showPricePlotCandles)
int in_pricePlotCandleWickTransp = input.int(defval=25, minval=0, maxval=100, title="Wick Transparency", group=G_PRICE_PLOTCANDLES, tooltip=TT_CANDLE_WICK_TRANSP, active=in_showPricePlotCandles)
int in_pricePlotCandleBorderTransp = input.int(defval=0, minval=0, maxval=100, title="Border Transparency", group=G_PRICE_PLOTCANDLES, tooltip=TT_CANDLE_BORDER_TRANSP, active=in_showPricePlotCandles)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Value Label Inputs
// ──────────────────────────────────────────────
string in_rsiValueLabelsMode = input.string(defval="Show", title="RSI Labels", options=["Show", "Hide"], group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_VALUE_LABELS_MODE)
bool in_showRsiValueLabels = in_rsiValueLabelsMode == "Show"

int in_rsi1ValueLabelPad = input.int(defval=5, minval=0, maxval=30, title="  ↳ RSI 1 Label Padding", group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_VALUE_LABELS_PAD, active=in_showRsiValueLabels)
int in_rsi2ValueLabelPad = input.int(defval=8, minval=0, maxval=30, title="  ↳ RSI 2 Label Padding", group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_VALUE_LABELS_PAD, active=in_showRsiValueLabels)

// Internal compatibility aliases.
int in_rsi5ValueLabelPad = in_rsi1ValueLabelPad
int in_rsi14ValueLabelPad = in_rsi2ValueLabelPad

int in_rsiSmaFastLabelPad = input.int(defval=12, minval=0, maxval=30, title="  ↳ SMA 20 Label Padding", group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_SMA_CROSS_LABEL_PAD, active=in_showRsiSmaCross and in_showRsiValueLabels)
int in_rsiSmaSlowLabelPad = input.int(defval=16, minval=0, maxval=30, title="  ↳ SMA 50 Label Padding", group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_SMA_CROSS_LABEL_PAD, active=in_showRsiSmaCross and in_showRsiValueLabels)
string in_rsiValueLabelSize = input.string(defval="Normal", title="  ↳ Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_VALUE_LABELS_SIZE, active=in_showRsiValueLabels)

string in_rsiGuideLabelMode = input.string(defval="Show", title="Guide Labels", options=["Show", "Hide"], group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_GUIDE_LABEL_MODE, active=in_showRsiGuides)
bool in_showRsiGuideLabels = in_rsiGuideLabelMode == "Show"

int in_rsiGuideLabelPad = input.int(defval=2, minval=0, maxval=20, title="  ↳ Label Padding", group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_GUIDE_LABEL_PAD, active=in_showRsiGuides and in_showRsiGuideLabels)
string in_rsiGuideLabelSize = input.string(defval="Small", title="  ↳ Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_RSI_VALUE_LABELS, tooltip=TT_RSI_GUIDE_LABEL_SIZE, active=in_showRsiGuides and in_showRsiGuideLabels)

// ==============================================================================================
// 🔴 END REGION: Inputs
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Core Series State
// ==============================================================================================
//
// 📌 Purpose:
//     Builds the primary RSI streams, higher-timeframe RSI reference,
//     volume-weighted RSI, and synthetic RSI candle OHLC values used downstream.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Series
// ──────────────────────────────────────────────
float rsi1 = ta.rsi(in_rsiSource, in_rsi1Len)
float rsi2 = ta.rsi(in_rsiSource, in_rsi2Len)

// Internal compatibility aliases.
// RSI 1 replaces the previous RSI 5.
// RSI 2 replaces the previous RSI 14 and remains the main engine RSI.
float rsi5 = rsi1
float rsi14 = rsi2

// ──────────────────────────────────────────────
// 🟦 Subregion: Higher-Timeframe RSI Sampling
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Requests RSI 14 from the automatically selected higher timeframe.
//
// 🧠 Behavior:
//     • The higher timeframe automatically steps up from the chart timeframe.
//     • Raw HTF RSI uses request.security() with lookahead off.
//     • Live HTF Float uses SCL's HTF float helper to stabilize the live HTF stream.
//
string htfTimeframe = f_rsiGetNextTf()

f_secHtfRsi14(string _tf) =>
    request.security(
         symbol=syminfo.tickerid,
         timeframe=_tf,
         expression=ta.rsi(in_rsiSource, in_rsi14Len),
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_off)

float htfRsi14Raw = f_secHtfRsi14(htfTimeframe)

float htfRsi14Live =
     SCL_HTF.f_HTF_Float(
         _HTF=htfTimeframe,
         _source=htfRsi14Raw,
         _arrayHistory=2,
         _HTF_offset=0,
         _useLiveDataOnChartTF=true)

float htfRsi14 = in_htfRsiFeedMode == "Live HTF Float" ? htfRsi14Live : htfRsi14Raw

// ──────────────────────────────────────────────
// 🟦 Subregion: Volume-Weighted RSI Series
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Builds a volume-weighted average of RSI 14.
//
// 🧠 Behavior:
//     • Uses RSI 14 as the source.
//     • Converts volume into a relative participation weight.
//     • Higher-volume bars have more influence on the average.
//
float rsiVwaAvgVol = ta.sma(volume, in_rsiVwaLen)

float rsiVwaVolAdj =
     volume > 0 and rsiVwaAvgVol > 0.0
     ? volume / rsiVwaAvgVol
     : 1.0

float rsiVwaWeightedSum = math.sum(rsi14 * rsiVwaVolAdj, in_rsiVwaLen)
float rsiVwaWeightSum   = math.sum(rsiVwaVolAdj, in_rsiVwaLen)

float rsiVwa =
     not na(rsiVwaWeightSum) and rsiVwaWeightSum != 0.0
     ? rsiVwaWeightedSum / rsiVwaWeightSum
     : na

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Synthetic Candle Series
// ──────────────────────────────────────────────
float rsiSynthOpen  = nz(rsi14[1], rsi14)
float rsiSynthClose = rsi14
float rsiSynthHigh  = math.max(rsiSynthOpen, rsiSynthClose)
float rsiSynthLow   = math.min(rsiSynthOpen, rsiSynthClose)

// ==============================================================================================
// 🔴 END REGION: Core Series State
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Oscillator Pivot Divergence Lines
// ==============================================================================================
//
// 📌 Purpose:
//     Adds optional RSI-based regular and hidden divergence connector lines
//     inside the oscillator pane, with optional sibling lines mirrored onto
//     the main price chart.
//
// 🧠 Behavior:
//     • Uses SimpleCryptoLife's OscillatorPivots library to confirm RSI pivots.
//     • Compares same-side confirmed RSI pivots against price highs/lows.
//     • Draws bullish divergence between RSI pivot lows.
//     • Draws bearish divergence between RSI pivot highs.
//     • Supports regular divergence and hidden divergence.
//     • Oscillator-pane lines connect RSI pivot values.
//     • Chart-side sibling lines connect the matching price highs/lows from
//       those same confirmed RSI pivots.
//
// 🧩 Why this matters:
//     This gives the RSI oscillator pane its own lightweight divergence layer,
//     while also allowing the same divergence relationship to be viewed directly
//     against price structure on the main chart.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: SCL RSI Oscillator Pivot Engine
// ──────────────────────────────────────────────
[rsiOscConfirmPeak, rsiOscConfirmDip, rsiOscPeakBarsBack, rsiOscDipBarsBack, rsiOscPeakValue, rsiOscDipValue, rsiOscDebugPeakStart, rsiOscDebugDipStart] =
     oscPivots.f_osc_Pivots(
         in_rsiOscDivPivotSize,
         rsi14)

// ──────────────────────────────────────────────
// 🟦 Subregion: Confirmed RSI Pivot Records
// ──────────────────────────────────────────────
var int rsiOscPrevHighIdx = na, var int rsiOscLastHighIdx = na
var float rsiOscPrevHighPrice = na, var float rsiOscLastHighPrice = na
var float rsiOscPrevHighValue = na, var float rsiOscLastHighValue = na

var int rsiOscPrevLowIdx = na, var int rsiOscLastLowIdx = na
var float rsiOscPrevLowPrice = na, var float rsiOscLastLowPrice = na
var float rsiOscPrevLowValue = na, var float rsiOscLastLowValue = na

// ──────────────────────────────────────────────
// 🟦 Subregion: Stored Divergence Line Endpoints
// ──────────────────────────────────────────────
var int rsiOscRegBullX1 = na, var int rsiOscRegBullX2 = na
var float rsiOscRegBullY1 = na, var float rsiOscRegBullY2 = na
var float rsiOscRegBullChartY1 = na, var float rsiOscRegBullChartY2 = na

var int rsiOscRegBearX1 = na, var int rsiOscRegBearX2 = na
var float rsiOscRegBearY1 = na, var float rsiOscRegBearY2 = na
var float rsiOscRegBearChartY1 = na, var float rsiOscRegBearChartY2 = na

var int rsiOscHiddenBullX1 = na, var int rsiOscHiddenBullX2 = na
var float rsiOscHiddenBullY1 = na, var float rsiOscHiddenBullY2 = na
var float rsiOscHiddenBullChartY1 = na, var float rsiOscHiddenBullChartY2 = na

var int rsiOscHiddenBearX1 = na, var int rsiOscHiddenBearX2 = na
var float rsiOscHiddenBearY1 = na, var float rsiOscHiddenBearY2 = na
var float rsiOscHiddenBearChartY1 = na, var float rsiOscHiddenBearChartY2 = na

// ──────────────────────────────────────────────
// 🟦 Subregion: High-Side Divergence Detection
// ──────────────────────────────────────────────
if rsiOscConfirmPeak and not na(rsiOscPeakBarsBack)
    int _newHighIdx = bar_index - rsiOscPeakBarsBack
    float _newHighPrice = high[rsiOscPeakBarsBack]
    float _newHighRsi = rsiOscPeakValue

    rsiOscPrevHighIdx := rsiOscLastHighIdx
    rsiOscPrevHighPrice := rsiOscLastHighPrice
    rsiOscPrevHighValue := rsiOscLastHighValue

    rsiOscLastHighIdx := _newHighIdx
    rsiOscLastHighPrice := _newHighPrice
    rsiOscLastHighValue := _newHighRsi

    bool _regularBearDiv = not na(rsiOscPrevHighPrice) and not na(rsiOscPrevHighValue) and _newHighPrice > rsiOscPrevHighPrice and _newHighRsi < rsiOscPrevHighValue
    bool _hiddenBearDiv = not na(rsiOscPrevHighPrice) and not na(rsiOscPrevHighValue) and _newHighPrice < rsiOscPrevHighPrice and _newHighRsi > rsiOscPrevHighValue

    if _regularBearDiv
        rsiOscRegBearX1 := rsiOscPrevHighIdx
        rsiOscRegBearY1 := rsiOscPrevHighValue
        rsiOscRegBearChartY1 := rsiOscPrevHighPrice
        rsiOscRegBearX2 := rsiOscLastHighIdx
        rsiOscRegBearY2 := rsiOscLastHighValue
        rsiOscRegBearChartY2 := rsiOscLastHighPrice
    else if in_clearRsiOscDivWhenNewestPairFails
        rsiOscRegBearX1 := na, rsiOscRegBearY1 := na, rsiOscRegBearChartY1 := na, rsiOscRegBearX2 := na, rsiOscRegBearY2 := na, rsiOscRegBearChartY2 := na

    if _hiddenBearDiv
        rsiOscHiddenBearX1 := rsiOscPrevHighIdx
        rsiOscHiddenBearY1 := rsiOscPrevHighValue
        rsiOscHiddenBearChartY1 := rsiOscPrevHighPrice
        rsiOscHiddenBearX2 := rsiOscLastHighIdx
        rsiOscHiddenBearY2 := rsiOscLastHighValue
        rsiOscHiddenBearChartY2 := rsiOscLastHighPrice
    else if in_clearRsiOscDivWhenNewestPairFails
        rsiOscHiddenBearX1 := na, rsiOscHiddenBearY1 := na, rsiOscHiddenBearChartY1 := na, rsiOscHiddenBearX2 := na, rsiOscHiddenBearY2 := na, rsiOscHiddenBearChartY2 := na

// ──────────────────────────────────────────────
// 🟦 Subregion: Low-Side Divergence Detection
// ──────────────────────────────────────────────
if rsiOscConfirmDip and not na(rsiOscDipBarsBack)
    int _newLowIdx = bar_index - rsiOscDipBarsBack
    float _newLowPrice = low[rsiOscDipBarsBack]
    float _newLowRsi = rsiOscDipValue

    rsiOscPrevLowIdx := rsiOscLastLowIdx
    rsiOscPrevLowPrice := rsiOscLastLowPrice
    rsiOscPrevLowValue := rsiOscLastLowValue

    rsiOscLastLowIdx := _newLowIdx
    rsiOscLastLowPrice := _newLowPrice
    rsiOscLastLowValue := _newLowRsi

    bool _regularBullDiv = not na(rsiOscPrevLowPrice) and not na(rsiOscPrevLowValue) and _newLowPrice < rsiOscPrevLowPrice and _newLowRsi > rsiOscPrevLowValue
    bool _hiddenBullDiv = not na(rsiOscPrevLowPrice) and not na(rsiOscPrevLowValue) and _newLowPrice > rsiOscPrevLowPrice and _newLowRsi < rsiOscPrevLowValue

    if _regularBullDiv
        rsiOscRegBullX1 := rsiOscPrevLowIdx
        rsiOscRegBullY1 := rsiOscPrevLowValue
        rsiOscRegBullChartY1 := rsiOscPrevLowPrice
        rsiOscRegBullX2 := rsiOscLastLowIdx
        rsiOscRegBullY2 := rsiOscLastLowValue
        rsiOscRegBullChartY2 := rsiOscLastLowPrice
    else if in_clearRsiOscDivWhenNewestPairFails
        rsiOscRegBullX1 := na, rsiOscRegBullY1 := na, rsiOscRegBullChartY1 := na, rsiOscRegBullX2 := na, rsiOscRegBullY2 := na, rsiOscRegBullChartY2 := na

    if _hiddenBullDiv
        rsiOscHiddenBullX1 := rsiOscPrevLowIdx
        rsiOscHiddenBullY1 := rsiOscPrevLowValue
        rsiOscHiddenBullChartY1 := rsiOscPrevLowPrice
        rsiOscHiddenBullX2 := rsiOscLastLowIdx
        rsiOscHiddenBullY2 := rsiOscLastLowValue
        rsiOscHiddenBullChartY2 := rsiOscLastLowPrice
    else if in_clearRsiOscDivWhenNewestPairFails
        rsiOscHiddenBullX1 := na, rsiOscHiddenBullY1 := na, rsiOscHiddenBullChartY1 := na, rsiOscHiddenBullX2 := na, rsiOscHiddenBullY2 := na, rsiOscHiddenBullChartY2 := na

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Oscillator Divergence Line Render
// ──────────────────────────────────────────────
int rsiOscDivMinVisibleIdx = bar_index - in_rsiOscDivLastNBars

bool showRsiOscRegBullLine = in_showRsiOscDivLines and not na(rsiOscRegBullX2) and rsiOscRegBullX2 >= rsiOscDivMinVisibleIdx
bool showRsiOscRegBearLine = in_showRsiOscDivLines and not na(rsiOscRegBearX2) and rsiOscRegBearX2 >= rsiOscDivMinVisibleIdx
bool showRsiOscHiddenBullLine = in_showRsiOscHiddenDivLines and not na(rsiOscHiddenBullX2) and rsiOscHiddenBullX2 >= rsiOscDivMinVisibleIdx
bool showRsiOscHiddenBearLine = in_showRsiOscHiddenDivLines and not na(rsiOscHiddenBearX2) and rsiOscHiddenBearX2 >= rsiOscDivMinVisibleIdx

var line rsiOscRegBullLine = na, var line rsiOscRegBearLine = na
var line rsiOscHiddenBullLine = na, var line rsiOscHiddenBearLine = na

rsiOscRegBullLine := f_manageRsiOscDivLine(
     rsiOscRegBullLine,
     showRsiOscRegBullLine,
     rsiOscRegBullX1,
     rsiOscRegBullY1,
     rsiOscRegBullX2,
     rsiOscRegBullY2,
     in_rsiOscBullDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscRegBearLine := f_manageRsiOscDivLine(
     rsiOscRegBearLine,
     showRsiOscRegBearLine,
     rsiOscRegBearX1,
     rsiOscRegBearY1,
     rsiOscRegBearX2,
     rsiOscRegBearY2,
     in_rsiOscBearDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscHiddenBullLine := f_manageRsiOscDivLine(
     rsiOscHiddenBullLine,
     showRsiOscHiddenBullLine,
     rsiOscHiddenBullX1,
     rsiOscHiddenBullY1,
     rsiOscHiddenBullX2,
     rsiOscHiddenBullY2,
     in_rsiOscHiddenBullDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscHiddenBearLine := f_manageRsiOscDivLine(
     rsiOscHiddenBearLine,
     showRsiOscHiddenBearLine,
     rsiOscHiddenBearX1,
     rsiOscHiddenBearY1,
     rsiOscHiddenBearX2,
     rsiOscHiddenBearY2,
     in_rsiOscHiddenBearDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

// ──────────────────────────────────────────────
// 🟦 Subregion: Price Chart Divergence Line Render
// ──────────────────────────────────────────────
bool showRsiOscRegBullChartLine = in_showRsiOscChartDivLines and showRsiOscRegBullLine
bool showRsiOscRegBearChartLine = in_showRsiOscChartDivLines and showRsiOscRegBearLine
bool showRsiOscHiddenBullChartLine = in_showRsiOscChartDivLines and showRsiOscHiddenBullLine
bool showRsiOscHiddenBearChartLine = in_showRsiOscChartDivLines and showRsiOscHiddenBearLine

var line rsiOscRegBullChartLine = na, var line rsiOscRegBearChartLine = na
var line rsiOscHiddenBullChartLine = na, var line rsiOscHiddenBearChartLine = na

rsiOscRegBullChartLine := f_manageRsiOscDivChartLine(
     rsiOscRegBullChartLine,
     showRsiOscRegBullChartLine,
     rsiOscRegBullX1,
     rsiOscRegBullChartY1,
     rsiOscRegBullX2,
     rsiOscRegBullChartY2,
     in_rsiOscBullDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscRegBearChartLine := f_manageRsiOscDivChartLine(
     rsiOscRegBearChartLine,
     showRsiOscRegBearChartLine,
     rsiOscRegBearX1,
     rsiOscRegBearChartY1,
     rsiOscRegBearX2,
     rsiOscRegBearChartY2,
     in_rsiOscBearDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscHiddenBullChartLine := f_manageRsiOscDivChartLine(
     rsiOscHiddenBullChartLine,
     showRsiOscHiddenBullChartLine,
     rsiOscHiddenBullX1,
     rsiOscHiddenBullChartY1,
     rsiOscHiddenBullX2,
     rsiOscHiddenBullChartY2,
     in_rsiOscHiddenBullDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

rsiOscHiddenBearChartLine := f_manageRsiOscDivChartLine(
     rsiOscHiddenBearChartLine,
     showRsiOscHiddenBearChartLine,
     rsiOscHiddenBearX1,
     rsiOscHiddenBearChartY1,
     rsiOscHiddenBearX2,
     rsiOscHiddenBearChartY2,
     in_rsiOscHiddenBearDivColor,
     in_rsiOscDivLineWidth,
     in_rsiOscDivLineStyle)

// ==============================================================================================
// 🔴 END REGION: RSI Oscillator Pivot Divergence Lines
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Pressure Composite Engine
// ==============================================================================================
//
// 📌 Purpose:
//     Builds the rewritten RSI Pressure Composite used by the oscillator plot,
//     composite crossover layer, and price-confirmed regime trail.
//
// 🧠 Behavior:
//     • Uses RSI 14 as the base pressure source.
//     • Blends a focused set of RSI-derived components instead of the older,
//       larger component-array system.
//     • Normalizes each component to a 0–100 RSI-style scale.
//     • Produces `wt2_rsi`, the final smoothed RSI Pressure Composite.
//     • Defines the standard pressure-zone thresholds used downstream.
//
// 🧩 Why this matters:
//     This region only builds the composite value. Color decisions and price-trail
//     regime logic are handled in the next region so the script flows cleanly.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Pressure Source Alias
// ──────────────────────────────────────────────
float rsi_chart =
     rsi14

// ──────────────────────────────────────────────
// 🟦 Subregion: Hardcoded RSI Pressure Engine Settings
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines fixed internal settings used by the RSI Pressure Oscillator.
//
// 🧠 Notes:
//     • These values are intentionally not user-facing.
//     • Show/Hide, Last N Bars, and visual widths are exposed in Inputs.
//     • These internal values define the default pressure-engine personality.
//     • They can be exposed later if testing shows users need more control.
//

// Short-term RSI velocity lookback.
// Lower values make the velocity component react faster to RSI movement.
int in_rsiPressureMfLookback =
     3

// Final smoothing applied to the blended pressure score.
// Higher values smooth the oscillator; lower values make it more reactive.
int in_rsiPressureFinalSmoothing =
     6

// ──────────────────────────────────────────────
// 🟦 Subregion: Focused RSI Pressure Components
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the internal lookbacks and normalization scales used by each
//     pressure component.
//
// 🧠 Component Settings:
//     • Range Len:
//       Measures where RSI 14 sits inside its recent high/low range.
//
//     • Trend Fast / Slow:
//       Builds the RSI trend-spread component from fast EMA minus slow EMA.
//
//     • Norm Len:
//       Standardizes trend spread and velocity into a 0–100 RSI-style scale.
//
//     • Band Len / Band Mult:
//       Measures RSI position inside a Bollinger-style RSI envelope.
//
//     • Volume Len:
//       Builds the volume-weighted RSI pressure component.
//

int rsiPressureRangeLen =
     21

int rsiPressureTrendFastLen =
     8

int rsiPressureTrendSlowLen =
     21

int rsiPressureNormLen =
     34

int rsiPressureBandLen =
     20

float rsiPressureBandMult =
     2.0

int rsiPressureVolLen =
     20

// Z-score expansion factors used when converting trend spread and velocity
// into the 0–100 pressure scale.
float rsiPressureTrendZScale =
     18.0

float rsiPressureVelocityZScale =
     16.0

float rsiPressureLevel =
     f_clamp100(rsi_chart)

float rsiPressureRange =
     f_rangePosition(rsi_chart, rsiPressureRangeLen)

float rsiPressureTrendFast =
     ta.ema(rsi_chart, rsiPressureTrendFastLen)

float rsiPressureTrendSlow =
     ta.ema(rsi_chart, rsiPressureTrendSlowLen)

float rsiPressureTrendSpread =
     rsiPressureTrendFast - rsiPressureTrendSlow

float rsiPressureTrend =
     f_zScoreToRsiScale(rsiPressureTrendSpread, rsiPressureNormLen, rsiPressureTrendZScale)

float rsiPressureVelocityRaw =
     ta.roc(rsi_chart, in_rsiPressureMfLookback)

float rsiPressureVelocity =
     f_zScoreToRsiScale(rsiPressureVelocityRaw, rsiPressureNormLen, rsiPressureVelocityZScale)

float rsiPressureBand =
     f_percentBToRsiScale(rsi_chart, rsiPressureBandLen, rsiPressureBandMult)

float rsiPressureAvgVol =
     ta.sma(volume, rsiPressureVolLen)

float rsiPressureRelVol =
     volume > 0 and rsiPressureAvgVol > 0.0
     ? volume / rsiPressureAvgVol
     : 1.0

float rsiPressureVolWeightedSum =
     math.sum(rsi_chart * rsiPressureRelVol, rsiPressureVolLen)

float rsiPressureVolWeightSum =
     math.sum(rsiPressureRelVol, rsiPressureVolLen)

float rsiPressureVolume =
     not na(rsiPressureVolWeightSum) and rsiPressureVolWeightSum != 0.0
     ? f_clamp100(rsiPressureVolWeightedSum / rsiPressureVolWeightSum)
     : rsiPressureLevel

// ──────────────────────────────────────────────
// 🟦 Subregion: Composite Component Weights
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Controls how much influence each pressure component has in the final blend.
//
// 🧠 Weight Model:
//     • Level keeps the oscillator anchored to raw RSI 14.
//     • Range receives extra emphasis because RSI position inside its recent
//       high/low range is useful for pressure context.
//     • Trend receives the strongest weight because fast/slow RSI spread helps
//       define pressure direction.
//     • Velocity is intentionally lighter so short-term bursts do not dominate.
//     • Band adds envelope context.
//     • Volume adds participation context without overpowering RSI structure.
//

float rsiPressureLevelWeight =
     1.00

float rsiPressureRangeWeight =
     1.20

float rsiPressureTrendWeight =
     1.35

float rsiPressureVelocityWeight =
     0.45

float rsiPressureBandWeight =
     0.90

float rsiPressureVolumeWeight =
     0.60

float rsiPressureWeightTotal =
     rsiPressureLevelWeight +
     rsiPressureRangeWeight +
     rsiPressureTrendWeight +
     rsiPressureVelocityWeight +
     rsiPressureBandWeight +
     rsiPressureVolumeWeight

float wt1_rsi =
     (
         rsiPressureLevel * rsiPressureLevelWeight +
         rsiPressureRange * rsiPressureRangeWeight +
         rsiPressureTrend * rsiPressureTrendWeight +
         rsiPressureVelocity * rsiPressureVelocityWeight +
         rsiPressureBand * rsiPressureBandWeight +
         rsiPressureVolume * rsiPressureVolumeWeight
     ) / rsiPressureWeightTotal

float wt2_rsi =
     ta.sma(wt1_rsi, in_rsiPressureFinalSmoothing)

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Zone Thresholds
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the fixed pressure zones used by the color engine and
//     price-confirmation regime logic.
//
// 🧠 Notes:
//     • 55 / 45 define the bull/bear regime trigger zone.
//     • 70 / 30 define stronger pressure zones.
//     • 80 / 20 define extreme pressure zones.
//

int pressure_80 = 80
int pressure_70 = 70
// int pressure_60 = 60
int pressure_55 = 55
int pressure_45 = 45
// int pressure_40 = 40
int pressure_30 = 30
int pressure_20 = 20

// ==============================================================================================
// 🔴 END REGION: RSI Pressure Composite Engine
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: RSI Pressure Regime + Price Trail State
// ==============================================================================================
//
// 📌 Purpose:
//     Builds the shared pressure-regime, price-confirmation, color, and trail
//     state used by both the oscillator-side RSI Pressure Composite and the
//     force-overlay price-trail plot.
//
// 🧠 Behavior:
//     • Smooths `wt2_rsi` only for color/regime decisions.
//     • Builds a volatility-adjusted price trail from EMA(hlc3) and ATR.
//     • Uses RSI pressure zones to decide bull, bear, or neutral pressure state.
//     • Uses price location relative to the trail to confirm or reject that state.
//     • Produces the final oscillator colors:
//          `bg_color_wt2_rsi`
//          `bg_color_wt2_rsi1`
//          `bg_color_wt2_rsi_table`
//     • Produces the final price-trail plot state:
//          `rsiPressureTrailLine`
//          `rsiPressureTrailActivePlotColor`
//          `rsiPressureTrailNeutralPlotColor`
//
// 🧩 Why this matters:
//     The oscillator plot and price-chart trail now behave as one connected
//     system. The color read answers:
//
//     "Is price confirming the RSI pressure regime?"
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Composite Color Source
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Smooths the RSI Pressure Oscillator only for regime/color decisions.
//
// 🧠 Notes:
//     • This does not change the plotted `wt2_rsi` value.
//     • It only reduces color/regime flicker around pressure thresholds.
//
int rsiCompColorSmoothLen =
     3

float rsiCompColorSrc =
     ta.ema(wt2_rsi, rsiCompColorSmoothLen)

// Midpoint used to measure bullish/bearish pressure bias.
float rsiCompMidLine =
     50.0

// ──────────────────────────────────────────────
// 🟦 Subregion: Price-Trail Internal Settings
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the internal ATR/basis settings used by the price-chart pressure trail.
//
// 🧠 Notes:
//     • ATR length controls the trail's volatility adjustment.
//     • Basis length controls the smoother price anchor.
//     • Base multiplier sets the default ATR distance.
//     • Strength boost widens the trail as RSI pressure moves farther from 50.
//     • Tolerance percentage gives price a small ATR-based buffer before treating
//       the trail as lost or reclaimed.
//

int rsiCompTrailAtrLen =
     14

int rsiCompTrailBasisLen =
     21

float rsiCompTrailBaseMult =
     1.00

float rsiCompTrailStrengthBoost =
     0.75

float rsiCompTrailTolerancePct =
     0.05

// ──────────────────────────────────────────────
// 🟦 Subregion: Price-Trail Geometry
// ──────────────────────────────────────────────
float rsiCompTrailAtr =
     ta.atr(rsiCompTrailAtrLen)

float rsiCompTrailBasis =
     ta.ema(hlc3, rsiCompTrailBasisLen)

float rsiCompTrailBias =
     math.max(math.min((rsiCompColorSrc - rsiCompMidLine) / rsiCompMidLine, 1.0), -1.0)

float rsiCompTrailStrength =
     math.abs(rsiCompTrailBias)

float rsiCompTrailMult =
     rsiCompTrailBaseMult + (rsiCompTrailStrength * rsiCompTrailStrengthBoost)

float rsiCompBullTrail =
     rsiCompTrailBasis - (rsiCompTrailAtr * rsiCompTrailMult)

float rsiCompBearTrail =
     rsiCompTrailBasis + (rsiCompTrailAtr * rsiCompTrailMult)

float rsiCompTrailTolerance =
     rsiCompTrailAtr * rsiCompTrailTolerancePct

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Regime State
// ──────────────────────────────────────────────
bool rsiCompUpperPressure =
     rsiCompColorSrc >= pressure_55

bool rsiCompLowerPressure =
     rsiCompColorSrc <= pressure_45

bool rsiCompNeutralZone =
     rsiCompColorSrc > pressure_45 and
     rsiCompColorSrc < pressure_55

var bool rsiCompBullRegimeState =
     true

rsiCompBullRegimeState :=
     rsiCompUpperPressure ? true :
     rsiCompLowerPressure ? false :
     rsiCompBullRegimeState

float rsiCompActiveTrail =
     rsiCompBullRegimeState ? rsiCompBullTrail : rsiCompBearTrail

// ──────────────────────────────────────────────
// 🟦 Subregion: Price Confirmation State
// ──────────────────────────────────────────────
bool rsiCompPriceHoldingBullTrail =
     rsiCompBullRegimeState and
     close >= rsiCompActiveTrail - rsiCompTrailTolerance

bool rsiCompPriceLosingBullTrail =
     rsiCompBullRegimeState and
     close < rsiCompActiveTrail - rsiCompTrailTolerance

bool rsiCompPriceRespectingBearTrail =
     not rsiCompBullRegimeState and
     close <= rsiCompActiveTrail + rsiCompTrailTolerance

bool rsiCompPriceReclaimingBearTrail =
     not rsiCompBullRegimeState and
     close > rsiCompActiveTrail + rsiCompTrailTolerance

bool rsiCompPriceConfirmedBull =
     rsiCompUpperPressure and
     rsiCompPriceHoldingBullTrail

bool rsiCompPriceConfirmedBear =
     rsiCompLowerPressure and
     rsiCompPriceRespectingBearTrail

bool rsiCompPriceTransitionDown =
     rsiCompUpperPressure and
     rsiCompPriceLosingBullTrail

bool rsiCompPriceTransitionUp =
     rsiCompLowerPressure and
     rsiCompPriceReclaimingBearTrail

// ──────────────────────────────────────────────
// 🟦 Subregion: Composite Palette
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the fixed color ladder used by the price-confirmed pressure state.
//
// 🧠 Color Model:
//     • Hard Top / Upper Extreme / Rising represent confirmed bullish pressure.
//     • Hard Bottom / Lower Extreme / Falling represent confirmed bearish pressure.
//     • Neutral is used when pressure is inside the 45–55 middle zone.
//     • Transparent is used to hide the active color plot when no confirmed
//       pressure state is present.
//

color rsiCompColorHardTop =
     color.rgb(253, 109, 12)

color rsiCompColorUpperExtreme =
     color.rgb(255, 230, 0)

color rsiCompColorRising =
     #81effd

color rsiCompColorHardBottom =
     #ff0077

color rsiCompColorLowerExtreme =
     color.rgb(196, 57, 154)

color rsiCompColorFalling =
     #9b4157

color rsiCompColorNeutral =
     #adadad

color rsiCompColorTransparent =
     color.new(color.white, 100)

// ──────────────────────────────────────────────
// 🟦 Subregion: Final Price-Confirmed Color Mapping
// ──────────────────────────────────────────────
color bg_color_wt2_rsi =
     na(rsiCompColorSrc) ? rsiCompColorTransparent :

     rsiCompNeutralZone ? rsiCompColorTransparent :

     rsiCompPriceConfirmedBull and rsiCompColorSrc >= pressure_80 ? rsiCompColorHardTop :
     rsiCompPriceConfirmedBull and rsiCompColorSrc >= pressure_70 ? rsiCompColorUpperExtreme :
     rsiCompPriceConfirmedBull ? rsiCompColorRising :

     rsiCompPriceConfirmedBear and rsiCompColorSrc <= pressure_20 ? rsiCompColorHardBottom :
     rsiCompPriceConfirmedBear and rsiCompColorSrc <= pressure_30 ? rsiCompColorLowerExtreme :
     rsiCompPriceConfirmedBear ? rsiCompColorFalling :

     rsiCompPriceTransitionDown ? rsiCompColorFalling :
     rsiCompPriceTransitionUp ? rsiCompColorRising :

     rsiCompColorTransparent

color bg_color_wt2_rsi1 =
     na(rsiCompColorSrc) ? rsiCompColorTransparent :
     rsiCompNeutralZone or bg_color_wt2_rsi == rsiCompColorTransparent
     ? rsiCompColorNeutral
     : rsiCompColorTransparent

color bg_color_wt2_rsi_table =
     bg_color_wt2_rsi == rsiCompColorTransparent
     ? rsiCompColorNeutral
     : bg_color_wt2_rsi

// ──────────────────────────────────────────────
// 🟦 Subregion: Final Price-Trail Plot State
// ──────────────────────────────────────────────
float rsiPressureTrailLine =
     rsiCompActiveTrail

color rsiPressureTrailColor =
     bg_color_wt2_rsi_table

bool rsiPressureTrailNeutral =
     rsiCompNeutralZone or
     rsiPressureTrailColor == rsiCompColorNeutral

color rsiPressureTrailActivePlotColor =
     rsiPressureTrailNeutral
     ? color.new(rsiPressureTrailColor, 100)
     : rsiPressureTrailColor

color rsiPressureTrailNeutralPlotColor =
     rsiPressureTrailNeutral
     ? rsiPressureTrailColor
     : color.new(rsiPressureTrailColor, 100)

// ==============================================================================================
// 🔴 END REGION: RSI Pressure Regime + Price Trail State
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: HTF RSI Pressure Trail - Chart
// ==============================================================================================
//
// 📌 Purpose:
//     Builds a higher-timeframe sibling of the RSI Pressure Trail and projects it
//     onto the main price chart using force_overlay.
//
// 🧠 Behavior:
//     • Uses the same automatic higher-timeframe selector as the HTF RSI line.
//     • Recalculates the pressure composite and pressure-trail geometry on that HTF.
//     • Stabilizes the HTF trail with SCL_HTF.f_HTF_Float().
//     • Plots as a single-color context line so it does not compete with the
//       chart-timeframe active/neutral pressure-trail colors.
//
// 🧩 Why this matters:
//     The chart-timeframe Pressure Trail shows the active local pressure regime.
//     The HTF sibling gives a slower broader reference for whether price is
//     interacting with higher-timeframe pressure support/resistance.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: HTF Pressure Trail Core Function
// ──────────────────────────────────────────────
f_rsiPressureHtfTrailCore() =>
    float _rsiChart = ta.rsi(in_rsiSource, in_rsi14Len)

    float _pressureLevel = f_clamp100(_rsiChart)
    float _pressureRange = f_rangePosition(_rsiChart, rsiPressureRangeLen)
    float _pressureTrendFast = ta.ema(_rsiChart, rsiPressureTrendFastLen)
    float _pressureTrendSlow = ta.ema(_rsiChart, rsiPressureTrendSlowLen)
    float _pressureTrendSpread = _pressureTrendFast - _pressureTrendSlow
    float _pressureTrend = f_zScoreToRsiScale(_pressureTrendSpread, rsiPressureNormLen, rsiPressureTrendZScale)
    float _pressureVelocityRaw = ta.roc(_rsiChart, in_rsiPressureMfLookback)
    float _pressureVelocity = f_zScoreToRsiScale(_pressureVelocityRaw, rsiPressureNormLen, rsiPressureVelocityZScale)
    float _pressureBand = f_percentBToRsiScale(_rsiChart, rsiPressureBandLen, rsiPressureBandMult)
    float _pressureAvgVol = ta.sma(volume, rsiPressureVolLen)
    float _pressureRelVol = volume > 0 and _pressureAvgVol > 0.0 ? volume / _pressureAvgVol : 1.0
    float _pressureVolWeightedSum = math.sum(_rsiChart * _pressureRelVol, rsiPressureVolLen)
    float _pressureVolWeightSum = math.sum(_pressureRelVol, rsiPressureVolLen)
    float _pressureVolume = not na(_pressureVolWeightSum) and _pressureVolWeightSum != 0.0 ? f_clamp100(_pressureVolWeightedSum / _pressureVolWeightSum) : _pressureLevel

    float _wt1 = (
         _pressureLevel * rsiPressureLevelWeight +
         _pressureRange * rsiPressureRangeWeight +
         _pressureTrend * rsiPressureTrendWeight +
         _pressureVelocity * rsiPressureVelocityWeight +
         _pressureBand * rsiPressureBandWeight +
         _pressureVolume * rsiPressureVolumeWeight) / rsiPressureWeightTotal

    float _wt2 = ta.sma(_wt1, in_rsiPressureFinalSmoothing)
    float _colorSrc = ta.ema(_wt2, rsiCompColorSmoothLen)
    float _bias = math.max(math.min((_colorSrc - rsiCompMidLine) / rsiCompMidLine, 1.0), -1.0)
    float _strength = math.abs(_bias)
    float _atr = ta.atr(rsiCompTrailAtrLen)
    float _basis = ta.ema(hlc3, rsiCompTrailBasisLen)
    float _mult = rsiCompTrailBaseMult + (_strength * rsiCompTrailStrengthBoost)
    float _bullTrail = _basis - (_atr * _mult)
    float _bearTrail = _basis + (_atr * _mult)

    bool _upperPressure = _colorSrc >= pressure_55
    bool _lowerPressure = _colorSrc <= pressure_45

    var bool _bullRegimeState = true
    _bullRegimeState := _upperPressure ? true : _lowerPressure ? false : _bullRegimeState

    _bullRegimeState ? _bullTrail : _bearTrail

// ──────────────────────────────────────────────
// 🟦 Subregion: HTF Request + Stabilization
// ──────────────────────────────────────────────
string rsiPressureTrailHtf = htfTimeframe

float rsiPressureHtfTrailRequest = request.security(
     symbol=syminfo.tickerid,
     timeframe=rsiPressureTrailHtf,
     expression=f_rsiPressureHtfTrailCore(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float rsiPressureHtfTrailRaw = SCL_HTF.f_HTF_Float(
     _HTF=rsiPressureTrailHtf,
     _source=rsiPressureHtfTrailRequest,
     _arrayHistory=2,
     _HTF_offset=0,
     _useLiveDataOnChartTF=true)

// Hold the last valid HTF value so the context line does not collapse during gaps.
var float rsiPressureHtfTrailLine = na
rsiPressureHtfTrailLine := nz(rsiPressureHtfTrailRaw, nz(rsiPressureHtfTrailLine[1], rsiPressureTrailLine))

// ──────────────────────────────────────────────
// 🟦 Subregion: HTF Trail Plot Color
// ──────────────────────────────────────────────
color rsiPressureHtfTrailPlotColor = color.new(in_rsiPressureHtfTrailColor, 0)

// ==============================================================================================
// 🔴 END REGION: HTF RSI Pressure Trail - Chart
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Composite Crossovers
// ==============================================================================================
//
// 📌 Purpose:
//     Builds fast/slow crossover lines from the RSI Pressure Composite.
//
// 🧠 Behavior:
//     • Source is wt2_rsi, the final smoothed RSI Pressure Composite.
//     • Auto mode selects fast and slow lengths by chart timeframe.
//     • Manual mode uses the exposed manual fast and slow lengths.
//     • Fast and slow lines each support EMA or SMA.
//     • Crossover state persists between actual cross events.
//     • Line and fill colors follow the current composite crossover state.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Composite Auto Length Presets
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the internal fast/slow length presets used when Length Mode = Auto.
//
// 🧠 Notes:
//     • Lower chart timeframes use faster crossover pairs.
//     • Higher chart timeframes use slower, steadier crossover pairs.
//     • Manual lengths are used as the fallback if no timeframe bucket matches.
//

int rsiCompFastLenSeconds = 8       // Seconds charts up to 45S
int rsiCompSlowLenSeconds = 21      // Seconds charts up to 45S

int rsiCompFastLenMicroIntraday = 5 // Minute charts up to 3m
int rsiCompSlowLenMicroIntraday = 13 // Minute charts up to 3m

int rsiCompFastLenShortIntraday = 8 // Minute charts > 3m and up to 10m
int rsiCompSlowLenShortIntraday = 21 // Minute charts > 3m and up to 10m

int rsiCompFastLenMidIntraday = 13  // Minute charts > 10m and up to 30m
int rsiCompSlowLenMidIntraday = 34  // Minute charts > 10m and up to 30m

int rsiCompFastLenLongIntraday = 13 // Minute charts > 30m and up to 2h
int rsiCompSlowLenLongIntraday = 48 // Minute charts > 30m and up to 2h

int rsiCompFastLenHighIntraday = 21 // Minute charts > 2h and up to 8h
int rsiCompSlowLenHighIntraday = 48 // Minute charts > 2h and up to 8h

int rsiCompFastLenDaily = 13        // Daily charts up to 34D
int rsiCompSlowLenDaily = 34        // Daily charts up to 34D

int rsiCompFastLenWeekly = 8        // Weekly charts up to 21W
int rsiCompSlowLenWeekly = 21       // Weekly charts up to 21W

int rsiCompFastLenMonthly = 5       // Monthly charts up to 13M
int rsiCompSlowLenMonthly = 13      // Monthly charts up to 13M

// ──────────────────────────────────────────────
// 🟦 Subregion: Auto Length Resolver
// ──────────────────────────────────────────────
int rsiCompFastLenAuto =
     timeframe.isseconds and timeframe.multiplier <= 45 ? rsiCompFastLenSeconds :
     timeframe.isminutes and timeframe.multiplier <= 3 ? rsiCompFastLenMicroIntraday :
     timeframe.isminutes and timeframe.multiplier <= 10 ? rsiCompFastLenShortIntraday :
     timeframe.isminutes and timeframe.multiplier <= 30 ? rsiCompFastLenMidIntraday :
     timeframe.isminutes and timeframe.multiplier <= 120 ? rsiCompFastLenLongIntraday :
     timeframe.isminutes and timeframe.multiplier <= 480 ? rsiCompFastLenHighIntraday :
     timeframe.isdaily and timeframe.multiplier <= 34 ? rsiCompFastLenDaily :
     timeframe.isweekly and timeframe.multiplier <= 21 ? rsiCompFastLenWeekly :
     timeframe.ismonthly and timeframe.multiplier <= 13 ? rsiCompFastLenMonthly :
     in_rsiCompFastLenManual

int rsiCompSlowLenAuto =
     timeframe.isseconds and timeframe.multiplier <= 45 ? rsiCompSlowLenSeconds :
     timeframe.isminutes and timeframe.multiplier <= 3 ? rsiCompSlowLenMicroIntraday :
     timeframe.isminutes and timeframe.multiplier <= 10 ? rsiCompSlowLenShortIntraday :
     timeframe.isminutes and timeframe.multiplier <= 30 ? rsiCompSlowLenMidIntraday :
     timeframe.isminutes and timeframe.multiplier <= 120 ? rsiCompSlowLenLongIntraday :
     timeframe.isminutes and timeframe.multiplier <= 480 ? rsiCompSlowLenHighIntraday :
     timeframe.isdaily and timeframe.multiplier <= 34 ? rsiCompSlowLenDaily :
     timeframe.isweekly and timeframe.multiplier <= 21 ? rsiCompSlowLenWeekly :
     timeframe.ismonthly and timeframe.multiplier <= 13 ? rsiCompSlowLenMonthly :
     in_rsiCompSlowLenManual

// ──────────────────────────────────────────────
// 🟦 Subregion: Runtime Lengths
// ──────────────────────────────────────────────
int rsiCompFastLen =
     in_useRsiCompCrossAuto ? rsiCompFastLenAuto : in_rsiCompFastLenManual

int rsiCompSlowLen =
     in_useRsiCompCrossAuto ? rsiCompSlowLenAuto : in_rsiCompSlowLenManual

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Composite Crossover Series
// ──────────────────────────────────────────────
float rsiCompFastLine =
     f_rsiMa(wt2_rsi, rsiCompFastLen, in_rsiCompFastMaType)

float rsiCompSlowLine =
     f_rsiMa(wt2_rsi, rsiCompSlowLen, in_rsiCompSlowMaType)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Composite Crossover State
// ──────────────────────────────────────────────
bool rsiCompBullCross =
     ta.crossover(rsiCompFastLine, rsiCompSlowLine)

bool rsiCompBearCross =
     ta.crossunder(rsiCompFastLine, rsiCompSlowLine)

// Initializes the crossover state from the current fast/slow relationship
// once both lines are valid, instead of defaulting bearish on script load.
var bool rsiCompBullState = false
var bool rsiCompBullStateReady = false

if not rsiCompBullStateReady and not na(rsiCompFastLine) and not na(rsiCompSlowLine)
    rsiCompBullState := rsiCompFastLine >= rsiCompSlowLine
    rsiCompBullStateReady := true
else
    rsiCompBullState :=
         rsiCompBullCross ? true :
         rsiCompBearCross ? false :
         rsiCompBullState

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Composite Crossover Colors
// ──────────────────────────────────────────────
color rsiCompCrossLineColor =
     rsiCompBullState
     ? color.new(in_rsiCompCrossBullColor, in_rsiCompCrossLineTransp)
     : color.new(in_rsiCompCrossBearColor, in_rsiCompCrossLineTransp)

color rsiCompCrossFillColor =
     in_showRsiCompCrossFill
     ? rsiCompBullState
         ? color.new(in_rsiCompCrossBullColor, in_rsiCompCrossFillTransp)
         : color.new(in_rsiCompCrossBearColor, in_rsiCompCrossFillTransp)
     : na

// ==============================================================================================
// 🔴 END REGION: RSI Composite Crossovers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Adaptive RSI MA Crossovers
// ==============================================================================================
//
// 📌 Purpose:
//     Builds an adaptive fast/slow moving-average crossover pair from RSI 14.
//
// 🧠 Behavior:
//     • Source is RSI 14.
//     • Auto mode selects fast and slow lengths by chart timeframe.
//     • Manual mode uses the exposed manual fast and slow lengths.
//     • Fast and slow lines each support EMA or SMA.
//     • Crossover state persists between actual cross events.
//     • Line and fill colors follow the current crossover state.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Adaptive RSI MA Auto Length Presets
// ──────────────────────────────────────────────
//
// 📌 Purpose:
//     Defines the internal fast/slow length presets used when Length Mode = Auto.
//
// 🧠 Notes:
//     • Lower chart timeframes use faster moving-average pairs.
//     • Higher chart timeframes use slower, steadier moving-average pairs.
//     • Manual lengths are used as the fallback if no timeframe bucket matches.
//

int adaptiveRsiFastLenSeconds = 8        // Seconds charts up to 45S
int adaptiveRsiSlowLenSeconds = 21       // Seconds charts up to 45S

int adaptiveRsiFastLenMicroIntraday = 5  // Minute charts up to 3m
int adaptiveRsiSlowLenMicroIntraday = 13 // Minute charts up to 3m

int adaptiveRsiFastLenShortIntraday = 8  // Minute charts > 3m and up to 10m
int adaptiveRsiSlowLenShortIntraday = 21 // Minute charts > 3m and up to 10m

int adaptiveRsiFastLenMidIntraday = 13   // Minute charts > 10m and up to 30m
int adaptiveRsiSlowLenMidIntraday = 34   // Minute charts > 10m and up to 30m

int adaptiveRsiFastLenLongIntraday = 13  // Minute charts > 30m and up to 2h
int adaptiveRsiSlowLenLongIntraday = 48  // Minute charts > 30m and up to 2h

int adaptiveRsiFastLenHighIntraday = 21  // Minute charts > 2h and up to 8h
int adaptiveRsiSlowLenHighIntraday = 48  // Minute charts > 2h and up to 8h

int adaptiveRsiFastLenDaily = 13         // Daily charts up to 34D
int adaptiveRsiSlowLenDaily = 34         // Daily charts up to 34D

int adaptiveRsiFastLenWeekly = 8         // Weekly charts up to 21W
int adaptiveRsiSlowLenWeekly = 21        // Weekly charts up to 21W

int adaptiveRsiFastLenMonthly = 5        // Monthly charts up to 13M
int adaptiveRsiSlowLenMonthly = 13       // Monthly charts up to 13M

// ──────────────────────────────────────────────
// 🟦 Subregion: Auto Length Resolver
// ──────────────────────────────────────────────
int adaptiveRsiFastLenAuto =
     timeframe.isseconds and timeframe.multiplier <= 45 ? adaptiveRsiFastLenSeconds :
     timeframe.isminutes and timeframe.multiplier <= 3 ? adaptiveRsiFastLenMicroIntraday :
     timeframe.isminutes and timeframe.multiplier <= 10 ? adaptiveRsiFastLenShortIntraday :
     timeframe.isminutes and timeframe.multiplier <= 30 ? adaptiveRsiFastLenMidIntraday :
     timeframe.isminutes and timeframe.multiplier <= 120 ? adaptiveRsiFastLenLongIntraday :
     timeframe.isminutes and timeframe.multiplier <= 480 ? adaptiveRsiFastLenHighIntraday :
     timeframe.isdaily and timeframe.multiplier <= 34 ? adaptiveRsiFastLenDaily :
     timeframe.isweekly and timeframe.multiplier <= 21 ? adaptiveRsiFastLenWeekly :
     timeframe.ismonthly and timeframe.multiplier <= 13 ? adaptiveRsiFastLenMonthly :
     in_adaptiveRsiFastLenManual

int adaptiveRsiSlowLenAuto =
     timeframe.isseconds and timeframe.multiplier <= 45 ? adaptiveRsiSlowLenSeconds :
     timeframe.isminutes and timeframe.multiplier <= 3 ? adaptiveRsiSlowLenMicroIntraday :
     timeframe.isminutes and timeframe.multiplier <= 10 ? adaptiveRsiSlowLenShortIntraday :
     timeframe.isminutes and timeframe.multiplier <= 30 ? adaptiveRsiSlowLenMidIntraday :
     timeframe.isminutes and timeframe.multiplier <= 120 ? adaptiveRsiSlowLenLongIntraday :
     timeframe.isminutes and timeframe.multiplier <= 480 ? adaptiveRsiSlowLenHighIntraday :
     timeframe.isdaily and timeframe.multiplier <= 34 ? adaptiveRsiSlowLenDaily :
     timeframe.isweekly and timeframe.multiplier <= 21 ? adaptiveRsiSlowLenWeekly :
     timeframe.ismonthly and timeframe.multiplier <= 13 ? adaptiveRsiSlowLenMonthly :
     in_adaptiveRsiSlowLenManual

// ──────────────────────────────────────────────
// 🟦 Subregion: Runtime Lengths
// ──────────────────────────────────────────────
int adaptiveRsiFastLen = in_useAdaptiveRsiMaAuto ? adaptiveRsiFastLenAuto : in_adaptiveRsiFastLenManual
int adaptiveRsiSlowLen = in_useAdaptiveRsiMaAuto ? adaptiveRsiSlowLenAuto : in_adaptiveRsiSlowLenManual

// ──────────────────────────────────────────────
// 🟦 Subregion: Adaptive RSI MA Series
// ──────────────────────────────────────────────
float adaptiveRsiFastLine = f_rsiMa(rsi14, adaptiveRsiFastLen, in_adaptiveRsiFastMaType)
float adaptiveRsiSlowLine = f_rsiMa(rsi14, adaptiveRsiSlowLen, in_adaptiveRsiSlowMaType)

// ──────────────────────────────────────────────
// 🟦 Subregion: Adaptive RSI MA Crossover State
// ──────────────────────────────────────────────
bool adaptiveRsiBullCross = ta.crossover(adaptiveRsiFastLine, adaptiveRsiSlowLine)
bool adaptiveRsiBearCross = ta.crossunder(adaptiveRsiFastLine, adaptiveRsiSlowLine)

// Initializes the crossover state from the current fast/slow relationship
// once both lines are valid, instead of defaulting bearish on script load.
var bool adaptiveRsiBullState = false
var bool adaptiveRsiBullStateReady = false

if not adaptiveRsiBullStateReady and not na(adaptiveRsiFastLine) and not na(adaptiveRsiSlowLine)
    adaptiveRsiBullState := adaptiveRsiFastLine >= adaptiveRsiSlowLine
    adaptiveRsiBullStateReady := true
else
    adaptiveRsiBullState :=
         adaptiveRsiBullCross ? true :
         adaptiveRsiBearCross ? false :
         adaptiveRsiBullState

// ──────────────────────────────────────────────
// 🟦 Subregion: Crossover Colors
// ──────────────────────────────────────────────
color adaptiveRsiMaLineColor =
     adaptiveRsiBullState
     ? color.new(in_adaptiveRsiMaBullColor, in_adaptiveRsiMaLineTransp)
     : color.new(in_adaptiveRsiMaBearColor, in_adaptiveRsiMaLineTransp)

color adaptiveRsiMaFillColor =
     in_showAdaptiveRsiMa
     ? adaptiveRsiBullState
         ? color.new(in_adaptiveRsiMaBullColor, in_adaptiveRsiMaFillTransp)
         : color.new(in_adaptiveRsiMaBearColor, in_adaptiveRsiMaFillTransp)
     : na

// ==============================================================================================
// 🔴 END REGION: Adaptive RSI MA Crossovers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: SMA 20/50 RSI Crossovers
// ==============================================================================================
//
// 📌 Purpose:
//     Builds a standalone slower fast/slow crossover pair from RSI 14.
//
// 🧠 Behavior:
//     • Source is RSI 14.
//     • Default fast line is SMA 20.
//     • Default slow line is SMA 50.
//     • Fast and slow lines each support EMA or SMA.
//     • Crossover state initializes from the current fast/slow relationship.
//     • After initialization, crossover state persists between actual cross events.
//     • Line and fill colors follow the current crossover state.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: SMA 20/50 RSI Series
// ──────────────────────────────────────────────
float rsiSmaFastLine = f_rsiMa(rsi14, in_rsiSmaFastLen, in_rsiSmaFastMaType)
float rsiSmaSlowLine = f_rsiMa(rsi14, in_rsiSmaSlowLen, in_rsiSmaSlowMaType)

// ──────────────────────────────────────────────
// 🟦 Subregion: SMA 20/50 Crossover State
// ──────────────────────────────────────────────
bool rsiSmaBullCross = ta.crossover(rsiSmaFastLine, rsiSmaSlowLine)
bool rsiSmaBearCross = ta.crossunder(rsiSmaFastLine, rsiSmaSlowLine)

// Initializes the crossover state from the current fast/slow relationship
// once both lines are valid, instead of defaulting bearish on script load.
var bool rsiSmaBullState = false
var bool rsiSmaBullStateReady = false

if not rsiSmaBullStateReady and not na(rsiSmaFastLine) and not na(rsiSmaSlowLine)
    rsiSmaBullState := rsiSmaFastLine >= rsiSmaSlowLine
    rsiSmaBullStateReady := true
else
    rsiSmaBullState :=
         rsiSmaBullCross ? true :
         rsiSmaBearCross ? false :
         rsiSmaBullState

// ──────────────────────────────────────────────
// 🟦 Subregion: SMA 20/50 Crossover Colors
// ──────────────────────────────────────────────
color rsiSmaCrossLineColor =
     rsiSmaBullState
     ? color.new(in_rsiSmaCrossBullColor, in_rsiSmaCrossLineTransp)
     : color.new(in_rsiSmaCrossBearColor, in_rsiSmaCrossLineTransp)

color rsiSmaCrossFillColor =
     in_showRsiSmaCross
     ? rsiSmaBullState
         ? color.new(in_rsiSmaCrossBullColor, in_rsiSmaCrossFillTransp)
         : color.new(in_rsiSmaCrossBearColor, in_rsiSmaCrossFillTransp)
     : na

// ==============================================================================================
// 🔴 END REGION: SMA 20/50 RSI Crossovers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Pressure Envelope
// ==============================================================================================
//
// 📌 Purpose:
//     Builds a pressure-style envelope around RSI 14.
//
// 🧠 Behavior:
//     • Uses RSI 14 as the envelope center.
//     • Upper envelope = RSI 14 + padding, capped at 100.
//     • Lower envelope = RSI 14 - padding, capped at 0.
//     • Fill appears only when RSI 14 reaches the selected trigger zones.
//     • The envelope is independent from synthetic RSI candles.
//     • It can be used with RSI lines, synthetic candles, or by itself.
//
// ==============================================================================================

float rsiCandlePressureCenter =
     rsi14

float rsiCandlePressureUpper =
     math.min(100.0, rsiCandlePressureCenter + in_rsiCandlePressurePad)

float rsiCandlePressureLower =
     math.max(0.0, rsiCandlePressureCenter - in_rsiCandlePressurePad)

bool rsiCandlePressureActive =
     in_showRsiCandlePressure

bool rsiCandlePressureUpperActive =
     rsiCandlePressureActive and
     rsiCandlePressureCenter >= in_rsiCandlePressureUpperTrigger

bool rsiCandlePressureLowerActive =
     rsiCandlePressureActive and
     rsiCandlePressureCenter <= in_rsiCandlePressureLowerTrigger

color rsiCandlePressureFillColor =
     rsiCandlePressureUpperActive ? color.new(in_rsiCandlePressureUpperFill, in_rsiCandlePressureFillTransp) :
     rsiCandlePressureLowerActive ? color.new(in_rsiCandlePressureLowerFill, in_rsiCandlePressureFillTransp) :
     na

// ==============================================================================================
// 🔴 END REGION: RSI Pressure Envelope
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: RSI Color Engine
// ==============================================================================================
//
// 📌 Purpose:
//     Builds the RSI level colors used by oscillator plots, synthetic RSI candles,
//     and RSI-colored price candles.
//
// 🧠 Behavior:
//     • Neutral zone uses the RSI Neutral Color input.
//     • Above neutral = Bull Base → 60+ → 70+ → 80+ → 90+.
//     • Below neutral = Bear Base → 40- → 30- → 20- → 10-.
//     • RSI 14 and RSI 5 can each use their own transparency input.
//     • Candle overlays use the RSI 14 base color with separate body/wick/border
//       transparency controls.
// ==============================================================================================

color rsi2BaseColor = f_rsiTrendLevelColor(rsi2, in_rsiNeutralUpper, in_rsiNeutralLower, 0, in_rsiHardTopColor, in_rsiUpperExtremeColor, in_rsiUpperStrongColor, in_rsiUpperTrendColor, in_rsiUpperBaseColor, in_rsiNeutralColor, in_rsiLowerBaseColor, in_rsiLowerTrendColor, in_rsiLowerStrongColor, in_rsiLowerExtremeColor, in_rsiHardBottomColor)
color rsi2PlotColor = f_rsiTrendLevelColor(rsi2, in_rsiNeutralUpper, in_rsiNeutralLower, in_rsi2ColorTransp, in_rsiHardTopColor, in_rsiUpperExtremeColor, in_rsiUpperStrongColor, in_rsiUpperTrendColor, in_rsiUpperBaseColor, in_rsiNeutralColor, in_rsiLowerBaseColor, in_rsiLowerTrendColor, in_rsiLowerStrongColor, in_rsiLowerExtremeColor, in_rsiHardBottomColor)
color rsi1PlotColor = f_rsiTrendLevelColor(rsi1, in_rsiNeutralUpper, in_rsiNeutralLower, in_rsi1ColorTransp, in_rsiHardTopColor, in_rsiUpperExtremeColor, in_rsiUpperStrongColor, in_rsiUpperTrendColor, in_rsiUpperBaseColor, in_rsiNeutralColor, in_rsiLowerBaseColor, in_rsiLowerTrendColor, in_rsiLowerStrongColor, in_rsiLowerExtremeColor, in_rsiHardBottomColor)

// Internal compatibility aliases.
color rsi14BaseColor = rsi2BaseColor
color rsi14PlotColor = rsi2PlotColor
color rsi5PlotColor = rsi1PlotColor

color htfRsi14PlotColor = color.new(color.blue, 0)

bool rsiVwaRising =
     not na(rsiVwa) and
     not na(rsiVwa[1]) and
     rsiVwa >= rsiVwa[1]

bool rsiVwaFalling =
     not na(rsiVwa) and
     not na(rsiVwa[1]) and
     rsiVwa < rsiVwa[1]

color rsiVwaPlotColor =
     rsiVwaRising ? color.new(in_rsiVwaRisingColor, in_rsiVwaColorTransp) :
     rsiVwaFalling ? color.new(in_rsiVwaFallingColor, in_rsiVwaColorTransp) :
     color.new(color.gray, in_rsiVwaColorTransp)

color rsiSynthBodyColor   = color.new(rsi14BaseColor, in_rsiSynthBodyTransp)
color rsiSynthWickColor   = color.new(rsi14BaseColor, in_rsiSynthWickTransp)
color rsiSynthBorderColor = color.new(rsi14BaseColor, in_rsiSynthBorderTransp)

color pricePlotCandleBodyColor   = color.new(rsi14BaseColor, in_pricePlotCandleBodyTransp)
color pricePlotCandleWickColor   = color.new(rsi14BaseColor, in_pricePlotCandleWickTransp)
color pricePlotCandleBorderColor = color.new(rsi14BaseColor, in_pricePlotCandleBorderTransp)

// ==============================================================================================
// 🔴 END REGION: RSI Color Engine
// ==============================================================================================

// ================================================================================
// 🟢 REGION: Plot + Chart Rendering
// ================================================================================
//
// 📌 Purpose:
//     Centralizes the script's global-scope plot and plotcandle calls.
//
// 🧠 Behavior:
//     • Plots RSI 14 and RSI 5.
//     • Plots the higher-timeframe RSI reference.
//     • Plots the volume-weighted RSI reference.
//     • Plots RSI Pressure, crossover layers, and guide levels.
//     • Draws optional RSI synthetic candles in the oscillator pane.
//     • Draws optional RSI-colored price candles on the chart using force_overlay.
//     • Draws the RSI Pressure Trail on the chart using force_overlay.
//
// 📎 Notes:
//     • Last N Bars uses separate plot() calls because Pine requires show_last
//       to receive an input int directly, not a calculated helper value.
//
// ================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Oscillator Plots
// ──────────────────────────────────────────────
plot(
     in_showRsi2Plot ? rsi2 : na,
     title="RSI 2",
     color=rsi2PlotColor,
     linewidth=in_rsi2Width,
     style=plot.style_line,
     show_last=in_rsi2PlotLastNBars)

plot(
     in_showRsi1Plot ? rsi1 : na,
     title="RSI 1",
     color=rsi1PlotColor,
     linewidth=in_rsi1Width,
     style=plot.style_line,
     show_last=in_rsi1PlotLastNBars)

// ──────────────────────────────────────────────
