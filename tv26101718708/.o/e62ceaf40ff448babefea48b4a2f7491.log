     linewidth=1,
     show_last=in_rsiCandlePressureLastNBars)

fill(
     plotRsiCandlePressureUpper,
     plotRsiCandlePressureLower,
     color=rsiCandlePressureFillColor,
     title="RSI Pressure Envelope Fill")

// ──────────────────────────────────────────────
