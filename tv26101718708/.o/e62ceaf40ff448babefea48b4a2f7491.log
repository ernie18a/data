// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Pressure Helper Functions
// ──────────────────────────────────────────────
f_clamp100(float _x) =>
    math.max(math.min(_x, 100.0), 0.0)

f_zScoreToRsiScale(float _src, int _len, float _scale) =>
    float _mean =
         ta.sma(_src, _len)

    float _dev =
         ta.stdev(_src, _len)

    float _z =
         _dev != 0.0 ? (_src - _mean) / _dev : 0.0

    f_clamp100(50.0 + (_z * _scale))

f_rangePosition(float _src, int _len) =>
    float _hi =
         ta.highest(_src, _len)

    float _lo =
         ta.lowest(_src, _len)

    float _range =
         _hi - _lo

    _range != 0.0 ? f_clamp100(100.0 * (_src - _lo) / _range) : 50.0

f_percentBToRsiScale(float _src, int _len, float _mult) =>
    float _basis =
         ta.sma(_src, _len)

    float _dev =
         ta.stdev(_src, _len)

    float _upper =
         _basis + (_dev * _mult)

    float _lower =
         _basis - (_dev * _mult)

    float _range =
         _upper - _lower

    _range != 0.0 ? f_clamp100(100.0 * (_src - _lower) / _range) : 50.0

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Color Helper
// ──────────────────────────────────────────────
method t(color _c, int _tr) =>
    color.new(_c, _tr)

f_rsiTrendLevelColor(float _rsi, float _neutralUpper, float _neutralLower, int _tr, color _hardTopColor, color _upperExtremeColor, color _upperStrongColor, color _upperTrendColor, color _upperBaseColor, color _neutralColor, color _lowerBaseColor, color _lowerTrendColor, color _lowerStrongColor, color _lowerExtremeColor, color _hardBottomColor) =>
    if na(_rsi)
        color.new(color.gray, 85)
    else if _rsi >= _neutralLower and _rsi <= _neutralUpper
        _neutralColor.t(_tr)
    else if _rsi > _neutralUpper
        _rsi >= 90 ? _hardTopColor.t(_tr) :
         _rsi >= 80 ? _upperExtremeColor.t(_tr) :
         _rsi >= 70 ? _upperStrongColor.t(_tr) :
         _rsi >= 60 ? _upperTrendColor.t(_tr) :
         _upperBaseColor.t(_tr)
    else
        _rsi <= 10 ? _hardBottomColor.t(_tr) :
         _rsi <= 20 ? _lowerExtremeColor.t(_tr) :
         _rsi <= 30 ? _lowerStrongColor.t(_tr) :
         _rsi <= 40 ? _lowerTrendColor.t(_tr) :
         _lowerBaseColor.t(_tr)

// ──────────────────────────────────────────────
// 🟦 Subregion: Moving Average Selector Helper
// ──────────────────────────────────────────────
f_rsiMa(float _src, int _len, string _type) =>
    float _sma = ta.sma(_src, _len)
    float _ema = ta.ema(_src, _len)
    _type == "SMA" ? _sma : _ema

// ──────────────────────────────────────────────
// 🟦 Subregion: Higher-Timeframe Selector Helper
// ──────────────────────────────────────────────
f_rsiGetNextTf() =>
    string _nextTf = ""
    float _mult = timeframe.multiplier

    if timeframe.isseconds
        _nextTf :=
             timeframe.period == "1S"  ? "5S"  :
             timeframe.period == "5S"  ? "10S" :
             timeframe.period == "10S" ? "15S" :
             timeframe.period == "15S" ? "30S" :
             timeframe.period == "30S" ? "45S" :
             timeframe.period == "45S" ? "1"   :
             "1"

    else if timeframe.isminutes
        _nextTf :=
             _mult <= 1   ? "3"   :
             _mult <= 2   ? "4"   :
             _mult <= 3   ? "5"   :
             _mult <= 5   ? "10"  :
             _mult <= 10  ? "15"  :
             _mult <= 15  ? "30"  :
             _mult <= 30  ? "60"  :
             _mult <= 60  ? "120" :
             _mult <= 120 ? "240" :
             _mult <= 240 ? "480" :
             "D"

    else if timeframe.isdaily
        _nextTf := "1W"
    else if timeframe.isweekly
        _nextTf := "2W"
    else if timeframe.ismonthly
        _nextTf := "2M"
    else
        _nextTf := "1D"

    _nextTf

// ──────────────────────────────────────────────
// 🟦 Subregion: Box Object Helper
// ──────────────────────────────────────────────
f_syncBox(box _box, bool _show, int _left, int _right, float _top, float _bottom, color _fillColor, color _borderColor) =>
    box _out =
         _box

    if _show
        if na(_out)
            _out := box.new(
                 left=_left,
                 right=_right,
                 top=_top,
                 bottom=_bottom,
                 bgcolor=_fillColor,
                 border_color=_borderColor)
        else
            box.set_left(_out, _left)
            box.set_right(_out, _right)
            box.set_top(_out, _top)
            box.set_bottom(_out, _bottom)
            box.set_bgcolor(_out, _fillColor)
            box.set_border_color(_out, _borderColor)
    else
        if not na(_out)
            box.delete(_out)
            _out := na

    _out

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Oscillator Divergence Line Helpers
// ──────────────────────────────────────────────
f_rsiOscDivLineStyle(string _style) =>
    _style == "Solid" ? line.style_solid :
     _style == "Dashed" ? line.style_dashed :
     line.style_dotted

f_manageRsiOscDivLine(line _line, bool _show, int _x1, float _y1, int _x2, float _y2, color _color, int _width, string _style) =>
    line _out = _line
    bool _ok = _show and not na(_x1) and not na(_y1) and not na(_x2) and not na(_y2)
    _resolvedStyle = f_rsiOscDivLineStyle(_style)

    if _ok
        if na(_out)
            _out := line.new(x1=_x1, y1=_y1, x2=_x2, y2=_y2, xloc=xloc.bar_index, extend=extend.none, color=_color, width=_width, style=_resolvedStyle)
        else
            line.set_xy1(_out, _x1, _y1)
            line.set_xy2(_out, _x2, _y2)
            line.set_color(_out, _color)
            line.set_width(_out, _width)
            line.set_style(_out, _resolvedStyle)
    else if not na(_out)
        line.delete(_out)
        _out := na

    _out

f_manageRsiOscDivChartLine(line _line, bool _show, int _x1, float _y1, int _x2, float _y2, color _color, int _width, string _style) =>
    line _out = _line
    bool _ok = _show and not na(_x1) and not na(_y1) and not na(_x2) and not na(_y2)
    _resolvedStyle = f_rsiOscDivLineStyle(_style)

    if _ok
        if na(_out)
            _out := line.new(x1=_x1, y1=_y1, x2=_x2, y2=_y2, xloc=xloc.bar_index, extend=extend.none, color=_color, width=_width, style=_resolvedStyle, force_overlay=true)
        else
            line.set_xy1(_out, _x1, _y1)
            line.set_xy2(_out, _x2, _y2)
            line.set_color(_out, _color)
            line.set_width(_out, _width)
            line.set_style(_out, _resolvedStyle)
    else if not na(_out)
        line.delete(_out)
        _out := na

    _out

// ──────────────────────────────────────────────
// 🟦 Subregion: Label Helpers
// ──────────────────────────────────────────────
f_labelSize(string _size) =>
    _size == "Tiny" ? size.tiny :
     _size == "Small" ? size.small :
     _size == "Large" ? size.large :
     _size == "Huge" ? size.huge :
     size.normal

f_spacer(int _spaces) =>
    string _out = ""

    if _spaces > 0
        for i = 0 to _spaces - 1
            _out += " "

    _out

f_rsiWholeFmt(float _val) =>
    na(_val) ? "na" : str.tostring(math.round(_val), "#")

f_rsiDeltaText(float _delta) =>
    float _roundedDelta =
         math.round(_delta)

    string _deltaText =
         na(_delta) ? "na" : str.tostring(_roundedDelta, "#")

    _roundedDelta > 0 ? "+" + _deltaText : _deltaText

f_rsiValueLabelText(string _name, float _value, int _padSpaces) =>
    float _delta =
         _value - _value[1]

    string _pad =
         f_spacer(_padSpaces)

    _pad + _name + "\n" +
     _pad + f_rsiWholeFmt(_value) + "\n" +
     _pad + "(" + f_rsiDeltaText(_delta) + ")"

f_updateRsiValueLabel(label _label, bool _show, int _x, float _y, string _txt, color _txtColor, string _size) =>
    label _out =
         _label

    color _invisible =
         color.new(color.black, 100)

    if _show and not na(_y)
        if na(_out)
            _out := label.new(
                 x=_x,
                 y=_y,
                 text=_txt,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=_invisible,
                 textcolor=_txtColor,
                 size=f_labelSize(_size),
                 textalign=text.align_center)
        else
            label.set_xy(_out, _x, _y)
            label.set_text(_out, _txt)
            label.set_color(_out, _invisible)
            label.set_textcolor(_out, _txtColor)
            label.set_size(_out, f_labelSize(_size))
            label.set_textalign(_out, text.align_center)
    else
        if not na(_out)
            label.delete(_out)
            _out := na

    _out

f_updateRsiGuideLabel(label _label, bool _show, int _x, float _y, string _txt, color _txtColor, string _size) =>
    label _out =
         _label

    color _invisible =
         color.new(color.black, 100)

    if _show and not na(_y)
        if na(_out)
            _out := label.new(
                 x=_x,
                 y=_y,
                 text=_txt,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=_invisible,
                 textcolor=_txtColor,
                 size=f_labelSize(_size),
                 textalign=text.align_left)
        else
            label.set_xy(_out, _x, _y)
            label.set_text(_out, _txt)
            label.set_color(_out, _invisible)
            label.set_textcolor(_out, _txtColor)
            label.set_size(_out, f_labelSize(_size))
            label.set_textalign(_out, text.align_left)
    else
        if not na(_out)
            label.delete(_out)
            _out := na

    _out

