        array.set(tl_touches, 5, t2d)
        if en_chan
            [co2d, ck2d] = findChan(s2d, b2d, x12d, x22d, false)
            array.set(tl_chan_off, 5, co2d)
            array.set(tl_chan_ok, 5, ck2d)

// ── Kırılma tespiti + güncel seviyeler (her barda, tüm 6 slot) ──
bool up_tl_break = false
bool dn_tl_break = false
bool up_chan_break = false
bool dn_chan_break = false
bool at_chan_support = false
bool at_chan_resist  = false

float up_tl_now = na
float dn_tl_now = na
float up_chan_now = na
float dn_chan_now = na
float up_mid_now = na
float dn_mid_now = na

for i = 0 to 5
    if array.get(tl_valid, i)
        float sl_i  = array.get(tl_slope, i)
        float bs_i  = array.get(tl_base, i)
        int   x1_i  = array.get(tl_x1, i)
        float now_i = bs_i + sl_i * (bar_index - x1_i)
        bool is_up  = (i % 2) == 0
        bool is_brk = array.get(tl_broken, i)
        // Kırılma kontrolü (her zaman close bazlı)
        if not is_brk
            float cv = close
            float thr = atr_val * chan_break_atr
            bool violated = is_up ? (cv < now_i - thr) : (cv > now_i + thr)
            if violated
                int cnt = array.get(tl_brk_cnt, i) + 1
                array.set(tl_brk_cnt, i, cnt)
            else
                array.set(tl_brk_cnt, i, 0)
            int cnt2 = array.get(tl_brk_cnt, i)
            bool big_break = is_up ? (low < now_i - atr_val)       : (high > now_i + atr_val)
            bool far_break = is_up ? (low < now_i - atr_val * 1.5) : (high > now_i + atr_val * 1.5)
            if cnt2 >= 2 or big_break or far_break
                array.set(tl_broken, i, true)
                array.set(tl_brk_bar, i, bar_index)
                if is_up
                    up_tl_break := true
                else
                    dn_tl_break := true
        // Extension süresi doldu → geçersiz yap
        if is_brk and (bar_index - array.get(tl_brk_bar, i)) > chan_break_bars
            array.set(tl_valid, i, false)
        // Archive: extension süresi doldu → archive'i de temizle
        if array.get(arc_active, i) and (bar_index - array.get(arc_brk_bar, i)) > chan_break_bars
            array.set(arc_active, i, false)
        // Kanal kırılma
        if array.get(tl_chan_ok, i) and not is_brk
            float ch_now = now_i + array.get(tl_chan_off, i)
            if is_up and close > ch_now + atr_val * chan_break_atr
                array.set(tl_chan_ok, i, false)
                up_chan_break := true
            if not is_up and close < ch_now - atr_val * chan_break_atr
                array.set(tl_chan_ok, i, false)
                dn_chan_break := true
        // Kanal sinyal (fiyat kanal bandına yakın mı)
        if array.get(tl_chan_ok, i) and not is_brk
            float ch_now2 = now_i + array.get(tl_chan_off, i)
            if is_up
                if math.abs(low - now_i) < atr_val * 0.5
                    at_chan_support := true
                if math.abs(high - ch_now2) < atr_val * 0.5
                    at_chan_resist := true
            else
                if math.abs(high - now_i) < atr_val * 0.5
                    at_chan_resist := true
                if math.abs(low - ch_now2) < atr_val * 0.5
                    at_chan_support := true
        // Ana katman convenience (idx 0=up, 1=dn)
        if i == 0 and not is_brk
            up_tl_now := now_i
            if array.get(tl_chan_ok, i)
                up_chan_now := now_i + array.get(tl_chan_off, i)
                up_mid_now := now_i + array.get(tl_chan_off, i) / 2
        if i == 1 and not is_brk
            dn_tl_now := now_i
            if array.get(tl_chan_ok, i)
                dn_chan_now := now_i + array.get(tl_chan_off, i)
                dn_mid_now := now_i + array.get(tl_chan_off, i) / 2

[macd_line, sig_line, hist_val] = ta.macd(close, macd_fast, macd_slow, macd_sig)
bool _m_cup = ta.crossover(macd_line, sig_line)
bool _m_cdn = ta.crossunder(macd_line, sig_line)

float rsi = ta.rsi(close, rsi_len)
float rsi_pvl = ta.pivotlow(rsi, div_pv_len, div_pv_len)
float rsi_pvh = ta.pivothigh(rsi, div_pv_len, div_pv_len)
var float prev_rsi_pl=na
var float prev_price_pl=na
var float prev_rsi_ph=na
var float prev_price_ph=na
bool pu_detected = false
bool nu_detected = false
if en_div and not na(rsi_pvl)
    float cp = low[div_pv_len]
    if not na(prev_rsi_pl) and not na(prev_price_pl) and cp < prev_price_pl and rsi_pvl > prev_rsi_pl
        pu_detected := true
    prev_rsi_pl := rsi_pvl
    prev_price_pl := cp
if en_div and not na(rsi_pvh)
    float cp = high[div_pv_len]
    if not na(prev_rsi_ph) and not na(prev_price_ph) and cp > prev_price_ph and rsi_pvh < prev_rsi_ph
        nu_detected := true
    prev_rsi_ph := rsi_pvh
    prev_price_ph := cp

// ── Ardışık Divergence Sayacı (#41) ──
var int aktif_pd = 0
var int aktif_nd = 0
var int max_pd = 0
var int max_nd = 0
var int total_pd = 0
var int total_nd = 0
var int pd_qty = 0
var int nd_qty = 0

if pu_detected
    aktif_pd += 1
    max_pd := math.max(max_pd, aktif_pd)
    // ND serisi bitti
    if aktif_nd > 0
        total_nd += aktif_nd
        nd_qty += 1
        aktif_nd := 0
if nu_detected
    aktif_nd += 1
    max_nd := math.max(max_nd, aktif_nd)
    // PD serisi bitti
    if aktif_pd > 0
        total_pd += aktif_pd
        pd_qty += 1
        aktif_pd := 0

bool _rsi_cross50 = ta.cross(rsi, 50.0)
if _rsi_cross50
    if aktif_pd > 0
        total_pd += aktif_pd
        pd_qty += 1
        aktif_pd := 0
    if aktif_nd > 0
        total_nd += aktif_nd
        nd_qty += 1
        aktif_nd := 0

float avg_pd = pd_qty > 0 ? float(total_pd) / float(pd_qty) : 0.0
float avg_nd = nd_qty > 0 ? float(total_nd) / float(nd_qty) : 0.0

float div_bonus_l = 0.0
float div_bonus_s = 0.0
if aktif_pd > 0 and avg_pd > 0
    float ratio = float(aktif_pd) / avg_pd
    div_bonus_l := ratio >= 1.5 ? 10.0 : ratio >= 1.0 ? 7.0 : ratio >= 0.7 ? 3.0 : 0.0
if aktif_nd > 0 and avg_nd > 0
    float ratio = float(aktif_nd) / avg_nd
    div_bonus_s := ratio >= 1.5 ? 10.0 : ratio >= 1.0 ? 7.0 : ratio >= 0.7 ? 3.0 : 0.0

float bb_mid = ta.sma(close, band_len)
float bb_dev = ta.stdev(close, band_len) * bb_mult
float dc_hi = ta.highest(high, band_len)
float dc_lo = ta.lowest(low, band_len)
float band_upper = band_type == "Bollinger" ? bb_mid + bb_dev : dc_hi
float band_lower = band_type == "Bollinger" ? bb_mid - bb_dev : dc_lo
float band_mid   = band_type == "Bollinger" ? bb_mid : (dc_hi + dc_lo) / 2

float bb_width = bb_dev * 2
bool  is_squeeze = not na(atr_val) and atr_val > 0 ? (bb_width / atr_val) < sq_thresh : false
bool  squeeze_breakout_up   = is_squeeze[1] and not is_squeeze and close > bb_mid
bool  squeeze_breakout_down = is_squeeze[1] and not is_squeeze and close < bb_mid

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 10: S/R PİVOT
// ══════════════════════════════════════════════════════════════════
float sr_ph = ta.pivothigh(high, sr_pv_len, sr_pv_len)
float sr_pl = ta.pivotlow(low, sr_pv_len, sr_pv_len)
var float[] sup_lvls = array.new<float>()
var float[] res_lvls = array.new<float>()
var float[] sup_vols = array.new<float>()
var float[] res_vols = array.new<float>()
var int[]   sup_touches = array.new<int>()
var int[]   res_touches = array.new<int>()
var int[]   sup_last_tch = array.new<int>()
var int[]   res_last_tch = array.new<int>()
var int[]   sup_viols = array.new<int>()
var int[]   res_viols = array.new<int>()
float merge_d = atr_val * sr_merge
float fut_vol_raw = request.security(vol_sym != "" ? vol_sym : syminfo.tickerid, timeframe.period, volume)
float real_vol = vol_sym != "" ? fut_vol_raw : volume
float vol_sma = ta.sma(real_vol, 20)
float cur_vwap = ta.vwap(close)
float tch_zone = atr_val * 0.5
int   tch_gap = 3

if en_sr and not na(sr_pl)
    bool is_new = true
    if array.size(sup_lvls) > 0
        for k = 0 to array.size(sup_lvls) - 1
            if math.abs(array.get(sup_lvls, k) - sr_pl) < merge_d
                is_new := false
                break
    if is_new
        array.unshift(sup_lvls, sr_pl)
        array.unshift(sup_vols, nz(volume[sr_pv_len], 0))
        array.unshift(sup_touches, 1)
        array.unshift(sup_last_tch, bar_index)
        array.unshift(sup_viols, 0)
        if array.size(sup_lvls) > sr_max
            array.pop(sup_lvls)
            array.pop(sup_vols)
            array.pop(sup_touches)
            array.pop(sup_last_tch)
            array.pop(sup_viols)
if en_sr and not na(sr_ph)
    bool is_new = true
    if array.size(res_lvls) > 0
        for k = 0 to array.size(res_lvls) - 1
            if math.abs(array.get(res_lvls, k) - sr_ph) < merge_d
                is_new := false
                break
    if is_new
        array.unshift(res_lvls, sr_ph)
        array.unshift(res_vols, nz(volume[sr_pv_len], 0))
        array.unshift(res_touches, 1)
        array.unshift(res_last_tch, bar_index)
        array.unshift(res_viols, 0)
        if array.size(res_lvls) > sr_max
            array.pop(res_lvls)
            array.pop(res_vols)
            array.pop(res_touches)
            array.pop(res_last_tch)
            array.pop(res_viols)

if array.size(sup_lvls) > 0
    for k = 0 to array.size(sup_lvls) - 1
        float sp = array.get(sup_lvls, k)
        if math.abs(low - sp) < tch_zone or math.abs(close - sp) < tch_zone
            if (bar_index - array.get(sup_last_tch, k)) >= tch_gap
                array.set(sup_touches, k, array.get(sup_touches, k) + 1)
                array.set(sup_last_tch, k, bar_index)
        if close < sp - atr_val * 0.5
            array.set(sup_viols, k, array.get(sup_viols, k) + 1)
if array.size(res_lvls) > 0
    for k = 0 to array.size(res_lvls) - 1
        float rp = array.get(res_lvls, k)
        if math.abs(high - rp) < tch_zone or math.abs(close - rp) < tch_zone
            if (bar_index - array.get(res_last_tch, k)) >= tch_gap
                array.set(res_touches, k, array.get(res_touches, k) + 1)
                array.set(res_last_tch, k, bar_index)
        if close > rp + atr_val * 0.5
            array.set(res_viols, k, array.get(res_viols, k) + 1)

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 11: HTF VERİ
// ══════════════════════════════════════════════════════════════════
float htf_ema50  = request.security(syminfo.tickerid, htf_use, ta.ema(close, 50))
float htf_ema200 = request.security(syminfo.tickerid, htf_use, ta.ema(close, 200))
float htf_rsi    = request.security(syminfo.tickerid, htf_use, ta.rsi(close, 14))
float htf_pvh    = request.security(syminfo.tickerid, htf_use, ta.pivothigh(high, 10, 10))
float htf_pvl    = request.security(syminfo.tickerid, htf_use, ta.pivotlow(low, 10, 10))
float htf_sA = request.security(syminfo.tickerid, htf_use, ((ta.highest(high,9)+ta.lowest(low,9))/2+(ta.highest(high,26)+ta.lowest(low,26))/2)/2)
float htf_sB = request.security(syminfo.tickerid, htf_use, (ta.highest(high,52)+ta.lowest(low,52))/2)
var float htf_res = na
var float htf_sup = na
if not na(htf_pvh)
    htf_res := htf_pvh
if not na(htf_pvl)
    htf_sup := htf_pvl
bool htf_uptrend = not na(htf_ema50) and not na(htf_ema200) and htf_ema50 > htf_ema200
bool htf_downtrend = not na(htf_ema50) and not na(htf_ema200) and htf_ema50 < htf_ema200
bool htf_above_cloud = close > math.max(nz(htf_sA), nz(htf_sB))
bool htf_below_cloud = close < math.min(nz(htf_sA), nz(htf_sB))
// v8.43: HTF block — en yakın direnç/destek (pivot + EMA50 + EMA200)
float htf_nr = na
if htf_blk_pivot and not na(htf_res) and htf_res > close
    htf_nr := htf_res
if htf_blk_ema50 and not na(htf_ema50) and htf_ema50 > close
    if na(htf_nr) or htf_ema50 < htf_nr
        htf_nr := htf_ema50
if htf_blk_ema200 and not na(htf_ema200) and htf_ema200 > close
    if na(htf_nr) or htf_ema200 < htf_nr
        htf_nr := htf_ema200
float htf_ns = na
if htf_blk_pivot and not na(htf_sup) and htf_sup < close
    htf_ns := htf_sup
if htf_blk_ema50 and not na(htf_ema50) and htf_ema50 < close
    if na(htf_ns) or htf_ema50 > htf_ns
        htf_ns := htf_ema50
if htf_blk_ema200 and not na(htf_ema200) and htf_ema200 < close
    if na(htf_ns) or htf_ema200 > htf_ns
        htf_ns := htf_ema200
float htf_res_dist = not na(htf_nr) ? (htf_nr - close) / close * 100 : na
float htf_sup_dist = not na(htf_ns) ? (close - htf_ns) / close * 100 : na
float htf_vol     = request.security(syminfo.tickerid, htf_use, volume)
float htf_vol_sma = request.security(syminfo.tickerid, htf_use, ta.sma(volume, 20))
bool htf_vol_strong = not na(htf_vol) and not na(htf_vol_sma) and htf_vol > htf_vol_sma * 1.2
bool htf_vol_weak   = not na(htf_vol) and not na(htf_vol_sma) and htf_vol < htf_vol_sma * 0.8

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 12: TREND + S/R SEVİYE TOPLAMA
// ══════════════════════════════════════════════════════════════════
bool uptrend = ma9 > ma11
bool downtrend = ma9 < ma11
string ich_t = above_cloud ? "Above ↑" : below_cloud ? "Below ↓" : "In Cloud"

var float[] res_prices = array.new<float>()
var float[] res_scores = array.new<float>()
var string[] res_names = array.new<string>()
var float[] sup_prices = array.new<float>()
var float[] sup_scores = array.new<float>()
var string[] sup_names = array.new<string>()
var float[] res_hi = array.new<float>()
var float[] sup_lo = array.new<float>()
var int[] cm_r_del = array.new<int>()
var int[] cm_s_del = array.new<int>()

addLevel(float price, float score, string name) =>
    if not na(price) and price > 0 and not na(atr_val)
        bool in_range = math.abs(price - close) < atr_val * 10
        if in_range
            if price > close
                array.push(res_prices, price)
                array.push(res_scores, score)
                array.push(res_names,  name)
            else if price < close
                array.push(sup_prices, price)
                array.push(sup_scores, score)
                array.push(sup_names,  name)
    true

// ── S/R Seviye Toplama (her barda — trail findSR için gerekli) ──
array.clear(res_prices)
array.clear(res_scores)
array.clear(res_names)
array.clear(sup_prices)
array.clear(sup_scores)
array.clear(sup_names)
addLevel(htf_res, 10.0, "HTF")
addLevel(htf_sup, 10.0, "HTF")
addLevel(htf_ema50, 7.0, "HTF50")
addLevel(htf_ema200, 10.0, "HTF200")
addLevel(bv_trade, 3.0, "BestTrd")
addLevel(bv_long,  3.0, "BestLng")
addLevel(bv_short, 3.0, "BestSht")
addLevel(bv_sr,    2.0, "BestSR")
addLevel(fib_618, 4.0, "Fib618")
addLevel(fib_500, 3.0, "Fib500")
addLevel(fib_786, 3.0, "Fib786")
addLevel(fib_382, 2.0, "Fib382")
addLevel(nz(fib_lo), 2.0, "Fib0")
addLevel(nz(fib_hi), 2.0, "Fib100")
if fib_ext
    addLevel(fib_ext127, 2.0, "Ext1.27")
    addLevel(fib_ext161, 2.0, "Ext1.61")
addLevel(cloud_top, 4.0, "Cloud")
addLevel(cloud_bot, 4.0, "Cloud")
addLevel(ma11, 4.0, "EMA200")
addLevel(ma9, 3.0, "EMA50")
addLevel(ma12, 3.0, "KAMA")
if en_band
    addLevel(band_upper, 2.0, "Band")
    addLevel(band_lower, 2.0, "Band")
addLevel(cur_vwap, 3.0, "VWAP")
if array.size(res_lvls) > 0
    for k = 0 to array.size(res_lvls) - 1
        float pvol = array.size(res_vols) > k ? array.get(res_vols, k) : 0
        float vb = pvol > vol_sma * 1.5 ? 2.0 : pvol < vol_sma * 0.5 ? -1.0 : 0.0
        int tch = array.size(res_touches) > k ? array.get(res_touches, k) : 1
        int ihl = array.size(res_viols) > k ? array.get(res_viols, k) : 0
        float psc = float(tch) - float(ihl) + vb
        if tch >= 2 and psc > 0
            addLevel(array.get(res_lvls, k), psc, "Pivot")
if array.size(sup_lvls) > 0
    for k = 0 to array.size(sup_lvls) - 1
        float pvol = array.size(sup_vols) > k ? array.get(sup_vols, k) : 0
        float vb = pvol > vol_sma * 1.5 ? 2.0 : pvol < vol_sma * 0.5 ? -1.0 : 0.0
        int tch = array.size(sup_touches) > k ? array.get(sup_touches, k) : 1
        int ihl = array.size(sup_viols) > k ? array.get(sup_viols, k) : 0
        float psc = float(tch) - float(ihl) + vb
        if tch >= 2 and psc > 0
            addLevel(array.get(sup_lvls, k), psc, "Pivot")
for idx = 0 to 5
    if en_tl and array.get(tl_valid, idx) and not array.get(tl_broken, idx)
        int layer = idx < 2 ? 0 : idx < 4 ? 1 : 2
        bool skip_layer = (layer == 1 and not en_tl_mid) or (layer == 2 and not en_tl_short)
        if not skip_layer
            float sl_i = array.get(tl_slope, idx)
            float bs_i = array.get(tl_base, idx)
            int  x1_i  = array.get(tl_x1, idx)
            float nw_i = bs_i + sl_i * (bar_index - x1_i)
            bool is_up  = (idx % 2) == 0
            float tl_base_sc = idx < 2 ? 4.0 : idx < 4 ? 3.0 : 2.0
            int tl_tch = array.get(tl_touches, idx)
            float tl_sc = tl_base_sc + float(tl_tch) * 1.5
            addLevel(nw_i, tl_sc, "TrendL")
            if en_chan and array.get(tl_chan_ok, idx)
                float ch_nw = nw_i + array.get(tl_chan_off, idx)
                addLevel(ch_nw, tl_sc - 1, "Channel")
                float md_nw = nw_i + array.get(tl_chan_off, idx) / 2
                addLevel(md_nw, 1.5, "ChanMid")

if barstate.islast
    // ── S/R Merge: 0.5×ATR içindeki seviyeleri birleştir ──
    // Direnç: gruptaki en düşük fiyat (ana) + en yüksek fiyat (kutu üstü)
    // Destek: gruptaki en yüksek fiyat (ana) + en düşük fiyat (kutu altı)
    float merge_thr = atr_val * 0.5
    // Direnç için hi dizisi (kutu üst sınırı)
    array.clear(res_hi)
    if array.size(res_prices) > 0
        for rh = 0 to array.size(res_prices) - 1
            array.push(res_hi, array.get(res_prices, rh))
    if array.size(res_prices) > 1
        int rsz = array.size(res_prices)
        var bool[] r_merged = array.new<bool>(rsz, false)
        array.clear(r_merged)
        for rm = 0 to rsz - 1
            array.push(r_merged, false)
        for i = 0 to rsz - 2
            if not array.get(r_merged, i)
                for j = i + 1 to rsz - 1
                    if not array.get(r_merged, j)
                        if math.abs(array.get(res_prices, i) - array.get(res_prices, j)) < merge_thr
                            float pj = array.get(res_prices, j)
                            float pi = array.get(res_prices, i)
                            // i → en düşük (ana fiyat), res_hi → en yüksek
                            if pj < pi
                                array.set(res_hi, i, math.max(array.get(res_hi, i), pi))
                                array.set(res_prices, i, pj)
                            else
                                if pj > array.get(res_hi, i)
                                    array.set(res_hi, i, pj)
                            array.set(res_scores, i, array.get(res_scores, i) + array.get(res_scores, j))
                            string combined = array.get(res_names, i) + "+" + array.get(res_names, j)
                            if str.length(combined) > 20
                                combined := str.substring(combined, 0, 18) + ".."
                            array.set(res_names, i, combined)
                            array.set(r_merged, j, true)
        if rsz > 1
            for k = rsz - 1 to 0
                if array.get(r_merged, k)
                    array.remove(res_prices, k)
                    array.remove(res_scores, k)
                    array.remove(res_names, k)
                    array.remove(res_hi, k)
    // Destek için lo dizisi (kutu alt sınırı)
    array.clear(sup_lo)
    if array.size(sup_prices) > 0
        for sl2 = 0 to array.size(sup_prices) - 1
            array.push(sup_lo, array.get(sup_prices, sl2))
    if array.size(sup_prices) > 1
        int ssz = array.size(sup_prices)
        var bool[] s_merged = array.new<bool>(ssz, false)
        array.clear(s_merged)
        for sm = 0 to ssz - 1
            array.push(s_merged, false)
        for i = 0 to ssz - 2
            if not array.get(s_merged, i)
                for j = i + 1 to ssz - 1
                    if not array.get(s_merged, j)
                        if math.abs(array.get(sup_prices, i) - array.get(sup_prices, j)) < merge_thr
                            float pj = array.get(sup_prices, j)
                            float pi = array.get(sup_prices, i)
                            // i → en yüksek (ana fiyat), sup_lo → en düşük
                            if pj > pi
                                array.set(sup_lo, i, math.min(array.get(sup_lo, i), pi))
                                array.set(sup_prices, i, pj)
                            else
                                if pj < array.get(sup_lo, i)
                                    array.set(sup_lo, i, pj)
                            array.set(sup_scores, i, array.get(sup_scores, i) + array.get(sup_scores, j))
                            string combined = array.get(sup_names, i) + "+" + array.get(sup_names, j)
                            if str.length(combined) > 20
                                combined := str.substring(combined, 0, 18) + ".."
                            array.set(sup_names, i, combined)
                            array.set(s_merged, j, true)
        if ssz > 1
            for k = ssz - 1 to 0
                if array.get(s_merged, k)
                    array.remove(sup_prices, k)
                    array.remove(sup_scores, k)
                    array.remove(sup_names, k)
                    array.remove(sup_lo, k)
    // ── S/R Cross-Merge: Destek ↔ Direnç yakınsa birleştir ──
    // Güçlü taraf kalır, zayıf taraf silinir, skor toplanır
    if array.size(sup_prices) > 0 and array.size(res_prices) > 0
        array.clear(cm_r_del)
        array.clear(cm_s_del)
        for si = 0 to array.size(sup_prices) - 1
            bool s_skip = false
            if array.size(cm_s_del) > 0
                for su = 0 to array.size(cm_s_del) - 1
                    if array.get(cm_s_del, su) == si
                        s_skip := true
                        break
            if not s_skip
                for ri = 0 to array.size(res_prices) - 1
                    bool r_skip = false
                    if array.size(cm_r_del) > 0
                        for ru = 0 to array.size(cm_r_del) - 1
                            if array.get(cm_r_del, ru) == ri
                                r_skip := true
                                break
                    if not r_skip and math.abs(array.get(sup_prices, si) - array.get(res_prices, ri)) < merge_thr
                        float ss_v = array.get(sup_scores, si)
                        float rs_v = array.get(res_scores, ri)
                        float total_sc = ss_v + rs_v
                        string cname = array.get(sup_names, si) + "×" + array.get(res_names, ri)
                        if str.length(cname) > 20
                            cname := str.substring(cname, 0, 18) + ".."
                        if ss_v >= rs_v
                            // Destek güçlü → destek kalır, direnç silinir
                            array.set(sup_scores, si, total_sc)
                            array.set(sup_names, si, cname)
                            array.push(cm_r_del, ri)
                        else
                            // Direnç güçlü → direnç kalır, destek silinir
                            array.set(res_scores, ri, total_sc)
                            array.set(res_names, ri, cname)
                            array.push(cm_s_del, si)
                        break
        // Silme (büyükten küçüğe)
        if array.size(cm_r_del) > 0
            array.sort(cm_r_del, order.descending)
            for d = 0 to array.size(cm_r_del) - 1
                int idx = array.get(cm_r_del, d)
                if idx < array.size(res_prices)
                    array.remove(res_prices, idx)
                    array.remove(res_scores, idx)
                    array.remove(res_names, idx)
                    array.remove(res_hi, idx)
        if array.size(cm_s_del) > 0
            array.sort(cm_s_del, order.descending)
            for d = 0 to array.size(cm_s_del) - 1
                int idx = array.get(cm_s_del, d)
                if idx < array.size(sup_prices)
                    array.remove(sup_prices, idx)
                    array.remove(sup_scores, idx)
                    array.remove(sup_names, idx)
                    array.remove(sup_lo, idx)

var float[] top_res_p = array.new<float>(3, na)
var float[] top_res_s = array.new<float>(3, 0)
var string[] top_res_n = array.new<string>(3, "")
var float[] top_res_hi = array.new<float>(3, na)
var float[] top_sup_p = array.new<float>(3, na)
var float[] top_sup_s = array.new<float>(3, 0)
var string[] top_sup_n = array.new<string>(3, "")
var float[] top_sup_lo = array.new<float>(3, na)

if barstate.islast
    for idx = 0 to 2
        array.set(top_res_p, idx, na)
        array.set(top_res_s, idx, 0)
        array.set(top_res_n, idx, "")
        array.set(top_res_hi, idx, na)
        array.set(top_sup_p, idx, na)
        array.set(top_sup_s, idx, 0)
        array.set(top_sup_n, idx, "")
        array.set(top_sup_lo, idx, na)
    var int[] r_used = array.new<int>()
    array.clear(r_used)
    float max_dist_abs = atr_val * sr_max_dist
    if array.size(res_prices) > 0
        for pick = 0 to math.min(2, array.size(res_prices) - 1)
            float bv2 = -1
            int bi = -1
            for i = 0 to array.size(res_prices) - 1
                bool skip = false
                if array.size(r_used) > 0
                    for u = 0 to array.size(r_used) - 1
                        if array.get(r_used, u) == i
                            skip := true
                            break
                float pp = array.get(res_prices, i)
                if not skip and not na(pp) and (pp - close) > max_dist_abs
                    skip := true
                if not skip and array.get(res_scores, i) > bv2
                    bv2 := array.get(res_scores, i)
                    bi := i
            if bi >= 0
                array.set(top_res_p, pick, array.get(res_prices, bi))
                array.set(top_res_s, pick, array.get(res_scores, bi))
                array.set(top_res_n, pick, array.get(res_names, bi))
                array.set(top_res_hi, pick, array.size(res_hi) > bi ? array.get(res_hi, bi) : array.get(res_prices, bi))
                array.push(r_used, bi)
    var int[] s_used = array.new<int>()
    array.clear(s_used)
    if array.size(sup_prices) > 0
        for pick = 0 to math.min(2, array.size(sup_prices) - 1)
            float bv2 = -1
            int bi = -1
            for i = 0 to array.size(sup_prices) - 1
                bool skip = false
                if array.size(s_used) > 0
                    for u = 0 to array.size(s_used) - 1
                        if array.get(s_used, u) == i
                            skip := true
                            break
                float pp = array.get(sup_prices, i)
                if not skip and not na(pp) and (close - pp) > max_dist_abs
                    skip := true
                if not skip and array.get(sup_scores, i) > bv2
                    bv2 := array.get(sup_scores, i)
                    bi := i
            if bi >= 0
                array.set(top_sup_p, pick, array.get(sup_prices, bi))
                array.set(top_sup_s, pick, array.get(sup_scores, bi))
                array.set(top_sup_n, pick, array.get(sup_names, bi))
                array.set(top_sup_lo, pick, array.size(sup_lo) > bi ? array.get(sup_lo, bi) : array.get(sup_prices, bi))
                array.push(s_used, bi)

float long_tp1 = not na(array.get(top_res_p,0)) ? array.get(top_res_p,0) - atr_val*tp_buf_mult : na
float long_tp2 = not na(array.get(top_res_p,1)) ? array.get(top_res_p,1) - atr_val*tp_buf_mult : na
float long_tp3 = not na(array.get(top_res_p,2)) ? array.get(top_res_p,2) - atr_val*tp_buf_mult : na
float long_sl1b = not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val*sl_close_mult : na
float long_sl1i = not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val*sl_inst_mult  : na
float long_sl2b = not na(array.get(top_sup_lo,1)) ? array.get(top_sup_lo,1) - atr_val*sl_close_mult : na
float long_sl2i = not na(array.get(top_sup_lo,1)) ? array.get(top_sup_lo,1) - atr_val*sl_inst_mult  : na
float long_sl3b = not na(array.get(top_sup_lo,2)) ? array.get(top_sup_lo,2) - atr_val*sl_close_mult : na
float long_sl3i = not na(array.get(top_sup_lo,2)) ? array.get(top_sup_lo,2) - atr_val*sl_inst_mult  : na

float short_tp1 = not na(array.get(top_sup_p,0)) ? array.get(top_sup_p,0) + atr_val*tp_buf_mult : na
float short_tp2 = not na(array.get(top_sup_p,1)) ? array.get(top_sup_p,1) + atr_val*tp_buf_mult : na
float short_tp3 = not na(array.get(top_sup_p,2)) ? array.get(top_sup_p,2) + atr_val*tp_buf_mult : na
float short_sl1b = not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val*sl_close_mult : na
float short_sl1i = not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val*sl_inst_mult  : na
float short_sl2b = not na(array.get(top_res_hi,1)) ? array.get(top_res_hi,1) + atr_val*sl_close_mult : na
float short_sl2i = not na(array.get(top_res_hi,1)) ? array.get(top_res_hi,1) + atr_val*sl_inst_mult  : na
float short_sl3b = not na(array.get(top_res_hi,2)) ? array.get(top_res_hi,2) + atr_val*sl_close_mult : na
float short_sl3i = not na(array.get(top_res_hi,2)) ? array.get(top_res_hi,2) + atr_val*sl_inst_mult  : na

bool long_rr_r2 = false
bool short_rr_r2 = false
float long_rr_tp = long_tp1
float short_rr_tp = short_tp1
if not na(long_tp1) and (long_tp1 - close) < atr_val * 0.5 and not na(long_tp2)
    long_rr_tp := long_tp2
    long_rr_r2 := true
if not na(short_tp1) and (close - short_tp1) < atr_val * 0.5 and not na(short_tp2)
    short_rr_tp := short_tp2
    short_rr_r2 := true
float long_rr  = not na(long_rr_tp) and not na(long_sl1i) and (close-long_sl1i) > 0 ? (long_rr_tp-close)/(close-long_sl1i) : na
float short_rr = not na(short_rr_tp) and not na(short_sl1i) and (short_sl1i-close) > 0 ? (close-short_rr_tp)/(short_sl1i-close) : na

// v8.50: below_support / above_resistance taşındı (score cezası için)
float nearest_sup = array.size(sup_lvls) > 0 ? array.get(sup_lvls, 0) : na
float nearest_res = array.size(res_lvls) > 0 ? array.get(res_lvls, 0) : na
bool below_support    = not na(nearest_sup) and close < nearest_sup - atr_val * 0.1
bool above_resistance = not na(nearest_res) and close > nearest_res + atr_val * 0.1

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 13: DUAL SCORE (Long + Short ayrı)
// ══════════════════════════════════════════════════════════════════
float la=0
float lb2=0
float lc=0
float ld=0
float le=0
if close > bv_long
    la += 8
if uptrend
    la += 7
if ma12 > ma12[1]
    la += 5
if macd_line > sig_line
    la += 5
if en_ich and above_cloud
    la += 5
la := math.min(30, la)
if na(htf_res_dist) or htf_res_dist > htf_warn
    lb2 += 10
if en_fib and not na(fib_618) and close > fib_382
    lb2 += 8
if en_ich and above_cloud
    lb2 += 7
if array.size(sup_lvls) > 0 and close - array.get(sup_lvls, 0) < atr_val * 2
    lb2 += 5
if en_tl and not na(up_tl_now) and close > up_tl_now
    lb2 += 8
if at_chan_support
    lb2 += 7
if en_tl and dn_tl_break
    lb2 += 10
if en_tl and dn_tl_break and pu_detected
    lb2 += 5
if at_chan_resist
    lb2 -= 5
if squeeze_breakout_up
    lb2 += 10
if below_support
    lb2 := lb2 - 15
lb2 := math.min(40, math.max(0, lb2))
if rsi < rsi_ob
    lc += 7
if pu_detected
    lc += 8
lc := math.min(20, lc)
if htf_uptrend
    ld += 10
if not na(htf_rsi) and htf_rsi < 70
    ld += 5
if htf_above_cloud
    ld += 5
if htf_vol_strong
    ld += 3
if htf_vol_weak
    ld -= 3
ld := math.min(20, ld)
if not na(long_rr)
    le := long_rr <= 3.0 ? math.min(10, math.max(-5, (long_rr - 1.0) * 5)) : math.min(30, 10 + (long_rr - 3.0) * 4)
float long_score = math.max(0, math.min(100, la*mult_trend + lb2*mult_sr + lc + ld + le))

float sa=0
float sb2=0
float sc=0
float sd=0
float se=0
if close < bv_short
    sa += 8
if downtrend
    sa += 7
if ma12 < ma12[1]
    sa += 5
if macd_line < sig_line
    sa += 5
if en_ich and below_cloud
    sa += 5
sa := math.min(30, sa)
if na(htf_sup_dist) or htf_sup_dist > htf_warn
    sb2 += 10
if en_fib and not na(fib_382) and close < fib_618
    sb2 += 8
if en_ich and below_cloud
    sb2 += 7
if array.size(res_lvls) > 0 and array.get(res_lvls, 0) - close < atr_val * 2
    sb2 += 5
if en_tl and not na(dn_tl_now) and close < dn_tl_now
    sb2 += 8
if at_chan_resist
    sb2 += 7
if en_tl and up_tl_break
    sb2 += 10
if en_tl and up_tl_break and nu_detected
    sb2 += 5
if at_chan_support
    sb2 -= 5
if squeeze_breakout_down
    sb2 += 10
if above_resistance
    sb2 := sb2 - 15
sb2 := math.min(40, math.max(0, sb2))
if rsi > rsi_os
    sc += 7
if nu_detected
    sc += 8
sc := math.min(20, sc)
if htf_downtrend
    sd += 10
if not na(htf_rsi) and htf_rsi > 30
    sd += 5
if htf_below_cloud
    sd += 5
if htf_vol_strong
    sd += 3
if htf_vol_weak
    sd -= 3
sd := math.min(20, sd)
if not na(short_rr)
    se := short_rr <= 3.0 ? math.min(10, math.max(-5, (short_rr - 1.0) * 5)) : math.min(30, 10 + (short_rr - 3.0) * 4)
float short_score = math.max(0, math.min(100, sa*mult_trend + sb2*mult_sr + sc + sd + se))

// v10.01: Proximity Gate — threshold içindeki tüm güçlü S/R PUANLARINI topla, skordan düş
// gateOnlyStrong=true ise sadece Fib/Pivot/HTF; false ise tüm S/R
isStrongSR(string nm) =>
    str.contains(nm, "Fib") or str.contains(nm, "Pivot") or str.contains(nm, "HTF") or str.contains(nm, "Sup") or str.contains(nm, "Res")

// Long için: threshold içindeki tüm güçlü direnç puanlarını topla + en yakın mesafe + sayı
gateCalcR() =>
    float total = 0.0
    float nearest = 999.0
    int count = 0
    if array.size(res_prices) > 0 and not na(atr_val) and atr_val > 0
        for i = 0 to array.size(res_prices) - 1
            float p = array.get(res_prices, i)
            string nm = i < array.size(res_names) ? array.get(res_names, i) : ""
            float sct = i < array.size(res_scores) ? array.get(res_scores, i) : 0.0
            bool ok = gateOnlyStrong ? isStrongSR(nm) : true
            if ok and p > close
                float dd = (p - close) / atr_val
                if dd < gateThr
                    total := total + sct
                    count := count + 1
                if dd < nearest
                    nearest := dd
    [total, nearest, count]

// Short için: threshold içindeki tüm güçlü destek puanlarını topla + en yakın mesafe + sayı
gateCalcS() =>
    float total = 0.0
    float nearest = 999.0
    int count = 0
    if array.size(sup_prices) > 0 and not na(atr_val) and atr_val > 0
        for i = 0 to array.size(sup_prices) - 1
            float p = array.get(sup_prices, i)
            string nm = i < array.size(sup_names) ? array.get(sup_names, i) : ""
            float sct = i < array.size(sup_scores) ? array.get(sup_scores, i) : 0.0
            bool ok = gateOnlyStrong ? isStrongSR(nm) : true
            if ok and p < close
                float dd = (close - p) / atr_val
                if dd < gateThr
                    total := total + sct
                    count := count + 1
                if dd < nearest
                    nearest := dd
    [total, nearest, count]

float gate_pen_r = 0.0
float gate_dist_r = 999.0
int gate_cnt_r = 0
float gate_pen_s = 0.0
float gate_dist_s = 999.0
int gate_cnt_s = 0
if gateMode != "Off"
    [gpr, gdr, gcr] = gateCalcR()
    [gps, gds, gcs] = gateCalcS()
    gate_pen_r := gpr
    gate_dist_r := gdr
    gate_cnt_r := gcr
    gate_pen_s := gps
    gate_dist_s := gds
    gate_cnt_s := gcs
bool gate_trig_l = gateMode != "Off" and gate_cnt_r > 0
bool gate_trig_s = gateMode != "Off" and gate_cnt_s > 0

// Orijinal skoru sakla (mini panel ok için)
float long_score_raw  = long_score
float short_score_raw = short_score

if gate_trig_l
    if gateMode == "Soft Block"
        long_score := math.max(0, long_score - gate_pen_r)
    else if gateMode == "Hard Block"
        long_score := 0
if gate_trig_s
    if gateMode == "Soft Block"
        short_score := math.max(0, short_score - gate_pen_s)
    else if gateMode == "Hard Block"
        short_score := 0

var float locked_long_score  = 0.0
var float locked_short_score = 0.0
if barstate.isconfirmed
    locked_long_score  := long_score
    locked_short_score := short_score

bool htf_block_long  = en_htf and not na(htf_res_dist) and htf_res_dist <= htf_warn
bool htf_block_short = en_htf and not na(htf_sup_dist) and htf_sup_dist <= htf_warn

bool sup_bounce = not na(nearest_sup) and low <= nearest_sup + atr_val * 0.2 and close > nearest_sup and not below_support
bool res_bounce = not na(nearest_res) and high >= nearest_res - atr_val * 0.2 and close < nearest_res and not above_resistance
float bounce_bonus_l = sup_bounce ? 15.0 : 0.0
float bounce_bonus_s = res_bounce ? 15.0 : 0.0
float body_size = math.abs(close - open)
float lower_wick = math.min(close, open) - low
float upper_wick = high - math.max(close, open)
bool bull_rejection = lower_wick > body_size * 2 and close >= open and sup_bounce
bool bear_rejection = upper_wick > body_size * 2 and close <= open and res_bounce
bool bull_engulf = close > open and close[1] < open[1] and close > open[1] and open <= close[1] and sup_bounce
bool bear_engulf = close < open and close[1] > open[1] and close < open[1] and open >= close[1] and res_bounce
if bull_rejection or bull_engulf
    bounce_bonus_l := bounce_bonus_l + 5.0
if bear_rejection or bear_engulf
    bounce_bonus_s := bounce_bonus_s + 5.0
if sup_bounce and not na(long_rr) and long_rr >= 2.0
    bounce_bonus_l := bounce_bonus_l + 10.0
if res_bounce and not na(short_rr) and short_rr >= 2.0
    bounce_bonus_s := bounce_bonus_s + 10.0
bounce_bonus_l := bounce_bonus_l + div_bonus_l
bounce_bonus_s := bounce_bonus_s + div_bonus_s

float score_diff = locked_long_score - locked_short_score
bool score_clear_l = score_diff >= 10
bool score_clear_s = score_diff <= -10

bool strong_buy  = (locked_long_score + bounce_bonus_l) >= sig_strong and (adx_str_limit == 0 or adx_val >= adx_str_limit) and not htf_block_long and not below_support and score_clear_l
bool normal_buy  = (locked_long_score + bounce_bonus_l) >= sig_normal and not strong_buy and not adx_ranging and not htf_block_long and not below_support and score_clear_l
bool strong_sell = (locked_short_score + bounce_bonus_s) >= sig_strong and (adx_str_limit == 0 or adx_val >= adx_str_limit) and not htf_block_short and not above_resistance and score_clear_s
bool normal_sell = (locked_short_score + bounce_bonus_s) >= sig_normal and not strong_sell and not adx_ranging and not htf_block_short and not above_resistance and score_clear_s

// v8.41: S1/R1 yakınlık koşulu kaldırıldı — R:R zaten mesafeyi kontrol ediyor
bool _recent_pd = ta.barssince(pu_detected) < 10
bool _recent_nd = ta.barssince(nu_detected) < 10
bool _bb_low  = close <= band_lower + atr_val * 0.2
bool _bb_high = close >= band_upper - atr_val * 0.2
bool _rsi_os  = rsi < 30 and adx_val < 25
bool _rsi_ob  = rsi > 70 and adx_val < 25
bool _rng_ok_l = _recent_pd or sup_bounce or _bb_low or at_chan_support or _rsi_os or (adx_val < 30 and rsi > 30 and rsi < 50)
bool _rng_ok_s = _recent_nd or res_bounce or _bb_high or at_chan_resist or _rsi_ob or (adx_val < 30 and rsi > 50 and rsi < 70)
bool range_buy  = not na(long_rr) and long_rr >= min_rr_range and _rng_ok_l
bool range_sell = not na(short_rr) and short_rr >= min_rr_range and _rng_ok_s

float long_limit = na
float short_limit = na
bool show_ll = false
bool show_sl2 = false
float lim_s1 = array.size(top_sup_p) > 0 ? array.get(top_sup_p, 0) : na
float lim_r1 = array.size(top_res_p) > 0 ? array.get(top_res_p, 0) : na
if not na(long_tp1) and not na(long_sl1i) and not na(long_rr) and long_rr < min_rr_range
    float rng = long_tp1 - long_sl1i
    if rng > 0
        float ideal = long_sl1i + rng / (min_rr_range + 1)
        float near_sup = not na(lim_s1) ? lim_s1 + atr_val * entry_buf : ideal
        float entry_price = math.min(ideal, near_sup)
        if entry_price < close and (na(lim_s1) or entry_price > lim_s1)
            long_limit := entry_price
            show_ll := true
if not na(short_tp1) and not na(short_sl1i) and not na(short_rr) and short_rr < min_rr_range
    float rng = short_sl1i - short_tp1
    if rng > 0
        float ideal = short_sl1i - rng / (min_rr_range + 1)
        float near_res = not na(lim_r1) ? lim_r1 - atr_val * entry_buf : ideal
        float entry_price = math.max(ideal, near_res)
        if entry_price > close and (na(lim_r1) or entry_price < lim_r1)
            short_limit := entry_price
            show_sl2 := true

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 13B: BACKTEST ENGINE — S/R Trail + Strong Signal Only
// ══════════════════════════════════════════════════════════════════
var int    bt_dir      = 0
var float  bt_entry    = 0.0
var int    bt_cnt      = 0
var int    bt_entry_bar = 0
var int    bt_wins     = 0
var int    bt_losses   = 0
var float  bt_total_pl = 0.0
var int    bt_total_trades = 0
var float  bt_max_dd   = 0.0
var float  bt_equity   = 0.0
var float  bt_peak_eq  = 0.0
var float  bt_init_sli = na
var float  bt_init_slb = na
var float  bt_risk     = na
var float  bt_trail_i  = na
var float  bt_trail_b  = na
var float  bt_tr2      = na
var int[]    bt_hist_ebar = array.new<int>()
var int[]    bt_hist_xbar = array.new<int>()
var float[]  bt_hist_epx  = array.new<float>()
var float[]  bt_hist_xpx  = array.new<float>()
var int[]    bt_hist_dir  = array.new<int>()

bool any_buy  = strong_buy or normal_buy or range_buy
bool any_sell = strong_sell or normal_sell or range_sell
bool bt_buy  = (bt_en_str and strong_buy) or (bt_en_nrm and normal_buy) or (bt_en_rng and range_buy)
bool bt_sell = (bt_en_str and strong_sell) or (bt_en_nrm and normal_sell) or (bt_en_rng and range_sell)
bool bt_is_single = bt_mode == "Single"

float bt_sl1i = na
float bt_sl1b = na
float bt_sl2i = na
float bt_sl2b = na
float bt_sl3i = na
float bt_sl3b = na
if bt_dir == 1
    bt_sl1i := not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val * sl_inst_mult : na
    bt_sl1b := not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val * sl_close_mult : na
    bt_sl2i := not na(array.get(top_sup_lo,1)) ? array.get(top_sup_lo,1) - atr_val * sl_inst_mult : na
    bt_sl2b := not na(array.get(top_sup_lo,1)) ? array.get(top_sup_lo,1) - atr_val * sl_close_mult : na
    bt_sl3i := not na(array.get(top_sup_lo,2)) ? array.get(top_sup_lo,2) - atr_val * sl_inst_mult : na
    bt_sl3b := not na(array.get(top_sup_lo,2)) ? array.get(top_sup_lo,2) - atr_val * sl_close_mult : na
else if bt_dir == -1
    bt_sl1i := not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val * sl_inst_mult : na
    bt_sl1b := not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val * sl_close_mult : na
    bt_sl2i := not na(array.get(top_res_hi,1)) ? array.get(top_res_hi,1) + atr_val * sl_inst_mult : na
    bt_sl2b := not na(array.get(top_res_hi,1)) ? array.get(top_res_hi,1) + atr_val * sl_close_mult : na
    bt_sl3i := not na(array.get(top_res_hi,2)) ? array.get(top_res_hi,2) + atr_val * sl_inst_mult : na
    bt_sl3b := not na(array.get(top_res_hi,2)) ? array.get(top_res_hi,2) + atr_val * sl_close_mult : na

float min_low2 = math.min(low, nz(low[1], low))
float max_hi2  = math.max(high, nz(high[1], high))
if bt_dir == 1 and not na(bt_risk) and in_bt
    float profit = close - bt_entry
    if profit < bt_risk
        bt_trail_i := math.max(nz(bt_trail_i, bt_init_sli), bt_init_sli)
        bt_trail_b := math.max(nz(bt_trail_b, bt_init_slb), bt_init_slb)
    else
        bool got = false
        if not na(bt_sl1i) and min_low2 - bt_sl1i >= bt_risk
            bt_trail_i := math.max(nz(bt_trail_i, bt_init_sli), bt_sl1i)
            bt_trail_b := math.max(nz(bt_trail_b, bt_init_slb), nz(bt_sl1b, bt_sl1i))
            got := true
        if not got and not na(bt_sl2i) and min_low2 - bt_sl2i >= bt_risk
            bt_trail_i := math.max(nz(bt_trail_i, bt_init_sli), bt_sl2i)
            bt_trail_b := math.max(nz(bt_trail_b, bt_init_slb), nz(bt_sl2b, bt_sl2i))
            got := true
        if not got and not na(bt_sl3i) and min_low2 - bt_sl3i >= bt_risk
            bt_trail_i := math.max(nz(bt_trail_i, bt_init_sli), bt_sl3i)
            bt_trail_b := math.max(nz(bt_trail_b, bt_init_slb), nz(bt_sl3b, bt_sl3i))
else if bt_dir == -1 and not na(bt_risk) and in_bt
    float profit = bt_entry - close
    if profit < bt_risk
        bt_trail_i := math.min(nz(bt_trail_i, bt_init_sli), bt_init_sli)
        bt_trail_b := math.min(nz(bt_trail_b, bt_init_slb), bt_init_slb)
    else
        bool got = false
        if not na(bt_sl1i) and bt_sl1i - max_hi2 >= bt_risk
            bt_trail_i := math.min(nz(bt_trail_i, bt_init_sli), bt_sl1i)
            bt_trail_b := math.min(nz(bt_trail_b, bt_init_slb), nz(bt_sl1b, bt_sl1i))
            got := true
        if not got and not na(bt_sl2i) and bt_sl2i - max_hi2 >= bt_risk
            bt_trail_i := math.min(nz(bt_trail_i, bt_init_sli), bt_sl2i)
            bt_trail_b := math.min(nz(bt_trail_b, bt_init_slb), nz(bt_sl2b, bt_sl2i))
            got := true
        if not got and not na(bt_sl3i) and bt_sl3i - max_hi2 >= bt_risk
            bt_trail_i := math.min(nz(bt_trail_i, bt_init_sli), bt_sl3i)
            bt_trail_b := math.min(nz(bt_trail_b, bt_init_slb), nz(bt_sl3b, bt_sl3i))

// v8.02: tr2 ATR takip trail — fiyatı sabit ATR mesafesiyle takip eder
if bt_dir == 1 and in_bt
    float tr2_raw = high - atr_val * tr2_mult
    bt_tr2 := math.max(nz(bt_tr2, tr2_raw), tr2_raw)
    float tr2_i = bt_tr2 - atr_val * sl_inst_mult
    float tr2_b = bt_tr2 - atr_val * sl_close_mult
    bt_trail_i := math.max(nz(bt_trail_i), tr2_i)
    bt_trail_b := math.max(nz(bt_trail_b), tr2_b)
else if bt_dir == -1 and in_bt
    float tr2_raw = low + atr_val * tr2_mult
    bt_tr2 := math.min(nz(bt_tr2, tr2_raw), tr2_raw)
    float tr2_i = bt_tr2 + atr_val * sl_inst_mult
    float tr2_b = bt_tr2 + atr_val * sl_close_mult
    bt_trail_i := math.min(nz(bt_trail_i), tr2_i)
    bt_trail_b := math.min(nz(bt_trail_b), tr2_b)

bool bt_close_now = false
float bt_close_px = na
bool bt_held = bt_dir != 0 and in_bt and (bar_index - bt_entry_bar >= min_hold)
if bt_held
    if bt_dir == 1 and not na(bt_trail_i) and low <= bt_trail_i
        bt_close_now := true
        bt_close_px := bt_trail_i
    if bt_dir == -1 and not na(bt_trail_i) and high >= bt_trail_i
        bt_close_now := true
        bt_close_px := bt_trail_i
    if bt_dir == 1 and strong_sell and not bt_close_now
        bt_close_now := true
        bt_close_px := close
    if bt_dir == -1 and strong_buy and not bt_close_now
        bt_close_now := true
        bt_close_px := close

if bt_close_now and bt_dir != 0 and in_bt
    float pl = bt_dir == 1 ? bt_close_px - bt_entry : bt_entry - bt_close_px
    pl := pl - in_spread
    bt_total_pl := bt_total_pl + pl
    bt_equity := bt_equity + pl
    if bt_equity > bt_peak_eq
        bt_peak_eq := bt_equity
    float dd = bt_peak_eq - bt_equity
    if dd > bt_max_dd
        bt_max_dd := dd
    bt_total_trades := bt_total_trades + 1
    if pl > 0
        bt_wins := bt_wins + 1
    else
        bt_losses := bt_losses + 1
    array.push(bt_hist_ebar, bt_entry_bar)
    array.push(bt_hist_xbar, bar_index)
    array.push(bt_hist_epx, bt_entry)
    array.push(bt_hist_xpx, bt_close_px)
    array.push(bt_hist_dir, bt_dir)
    bt_dir := 0
    bt_entry := 0.0
    bt_cnt := 0
    bt_trail_i := na
    bt_trail_b := na
    bt_tr2 := na
    bt_init_sli := na
    bt_init_slb := na
    bt_risk := na

if in_bt and not bt_close_now
    if bt_buy and (bt_dir != 1 or not bt_is_single)
        if bt_dir == -1
            float pl = bt_entry - close - in_spread
            bt_total_pl := bt_total_pl + pl
            bt_equity := bt_equity + pl
            bt_total_trades := bt_total_trades + 1
            if pl > 0
                bt_wins := bt_wins + 1
            else
                bt_losses := bt_losses + 1
            array.push(bt_hist_ebar, bt_entry_bar)
            array.push(bt_hist_xbar, bar_index)
            array.push(bt_hist_epx, bt_entry)
            array.push(bt_hist_xpx, close)
            array.push(bt_hist_dir, -1)
        if bt_dir <= 0
            bt_dir := 1
            bt_entry := close
            bt_cnt := 1
            bt_entry_bar := bar_index
            bt_init_sli := not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val * sl_inst_mult : close - atr_val * 2
            bt_init_slb := not na(array.get(top_sup_lo,0)) ? array.get(top_sup_lo,0) - atr_val * sl_close_mult : close - atr_val * 1.5
            bt_risk := math.abs(close - bt_init_sli)
            bt_trail_i := bt_init_sli
            bt_trail_b := bt_init_slb
            bt_tr2 := high - atr_val * tr2_mult
        else if bt_dir == 1 and not bt_is_single
            bt_entry := (bt_entry * bt_cnt + close) / (bt_cnt + 1)
            bt_cnt := bt_cnt + 1
    if bt_sell and (bt_dir != -1 or not bt_is_single)
        if bt_dir == 1
            float pl = close - bt_entry - in_spread
            bt_total_pl := bt_total_pl + pl
            bt_equity := bt_equity + pl
            bt_total_trades := bt_total_trades + 1
            if pl > 0
                bt_wins := bt_wins + 1
            else
                bt_losses := bt_losses + 1
            array.push(bt_hist_ebar, bt_entry_bar)
            array.push(bt_hist_xbar, bar_index)
            array.push(bt_hist_epx, bt_entry)
            array.push(bt_hist_xpx, close)
            array.push(bt_hist_dir, 1)
        if bt_dir >= 0
            bt_dir := -1
            bt_entry := close
            bt_cnt := 1
            bt_entry_bar := bar_index
            bt_init_sli := not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val * sl_inst_mult : close + atr_val * 2
            bt_init_slb := not na(array.get(top_res_hi,0)) ? array.get(top_res_hi,0) + atr_val * sl_close_mult : close + atr_val * 1.5
            bt_risk := math.abs(bt_init_sli - close)
            bt_trail_i := bt_init_sli
            bt_trail_b := bt_init_slb
            bt_tr2 := low + atr_val * tr2_mult
        else if bt_dir == -1 and not bt_is_single
            bt_entry := (bt_entry * bt_cnt + close) / (bt_cnt + 1)
            bt_cnt := bt_cnt + 1


// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 14: SİNYAL TRAİLİNG STOP (BT için — Long + Short bağımsız)
// ══════════════════════════════════════════════════════════════════
var int[] _sr_used = array.new<int>()
findSR(bool is_long, float entry, float[] lvls, float[] scores_arr, int rank) =>
    float result = na
    int found = 0
    array.clear(_sr_used)
    for pass = 1 to rank
        float best_sc = -1.0
        int best_idx = -1
        if array.size(lvls) > 0
            for k = 0 to array.size(lvls) - 1
                bool skip = false
                if array.size(_sr_used) > 0
                    for u = 0 to array.size(_sr_used) - 1
                        if array.get(_sr_used, u) == k
                            skip := true
                            break
                if not skip
                    float lv = array.get(lvls, k)
                    float sr_sc = array.size(scores_arr) > k ? array.get(scores_arr, k) : 1.0
                    bool right_side = is_long ? lv < entry : lv > entry
                    if right_side and sr_sc > best_sc
                        best_sc := sr_sc
                        best_idx := k
            if best_idx >= 0
                found += 1
                array.push(_sr_used, best_idx)
                if found == pass
                    float ref = array.get(lvls, best_idx)
                    // Blok merge: 0.5×ATR içindeki komşuların en altını (Long) / en üstünü (Short) al
                    if array.size(lvls) > 1
                        for j = 0 to array.size(lvls) - 1
                            if j != best_idx
                                float lv2 = array.get(lvls, j)
                                if math.abs(lv2 - ref) < atr_val * 0.5
                                    if is_long and lv2 < ref
                                        ref := lv2
                                    if not is_long and lv2 > ref
                                        ref := lv2
                    result := ref
    result

var float trail_long   = na
var float trail_short  = na
var float trail_long_i = na
var float trail_short_i = na
var float trail_long_bc = na
var float trail_short_bc = na
var float trail_risk_l = na
var float trail_risk_s = na
var float sig_tr2_l = na    // v8.02: signal trail ATR takip (Long)
var float sig_tr2_s = na    // v8.02: signal trail ATR takip (Short)
bool stop_hit = false
bool stop_hit_l = false
bool stop_hit_s = false
bool trail_warn = false
bool trail_bc_hit_l = false
bool trail_bc_hit_s = false

// v8.00: Pozisyon öncelik kuralı — kullanıcı pozisyondaysa sinyal trail resetlenir
if in_position
    trail_long   := na
    trail_long_i := na
    trail_long_bc := na
    trail_risk_l := na
    sig_tr2_l := na
    trail_short  := na
    trail_short_i := na
    trail_short_bc := na
    trail_risk_s := na
    sig_tr2_s := na

if not in_position and (strong_buy or normal_buy) and na(trail_long)
    float ref = findSR(true, close, sup_prices, sup_scores, 1)
    if na(ref)
        ref := close - 2 * atr_val
    trail_long   := ref
    trail_long_i := ref - atr_val * sl_inst_mult
    trail_long_bc := ref - atr_val * sl_close_mult
    trail_risk_l := close - trail_long_i
    sig_tr2_l := high - atr_val * tr2_mult
if not in_position and (strong_sell or normal_sell) and na(trail_short)
    float ref = findSR(false, close, res_prices, res_scores, 1)
    if na(ref)
        ref := close + 2 * atr_val
    trail_short   := ref
    trail_short_i := ref + atr_val * sl_inst_mult
    trail_short_bc := ref + atr_val * sl_close_mult
    trail_risk_s  := trail_short_i - close
    sig_tr2_s := low + atr_val * tr2_mult

if not in_position and not na(trail_long) and not na(trail_risk_l)
    float l_profit = close - (trail_long_i + trail_risk_l)
    if l_profit > trail_risk_l
        for rk = 1 to 3
            float nr = findSR(true, close, sup_prices, sup_scores, rk)
            if not na(nr)
                float ni = nr - atr_val * sl_inst_mult
                if nr > trail_long and (close - ni > trail_risk_l)
                    trail_long := nr
                    break
    trail_long_i := math.max(nz(trail_long_i), trail_long - atr_val * sl_inst_mult)
    trail_long_bc := math.max(nz(trail_long_bc), trail_long - atr_val * sl_close_mult)
    // v8.02: tr2 merge
    float str2_raw = high - atr_val * tr2_mult
    sig_tr2_l := math.max(nz(sig_tr2_l, str2_raw), str2_raw)
    trail_long_i := math.max(trail_long_i, sig_tr2_l - atr_val * sl_inst_mult)
    trail_long_bc := math.max(trail_long_bc, sig_tr2_l - atr_val * sl_close_mult)
    // BC hit (bar kapanışında)
    if barstate.isconfirmed and close < trail_long_bc
        trail_bc_hit_l := true
    // Instant hit (wick)
    if low < trail_long_i
        stop_hit := true
        stop_hit_l := true
        trail_long := na
        trail_long_i := na
        trail_long_bc := na
        trail_risk_l := na
        sig_tr2_l := na
    // Yaklaşma uyarısı
    if not na(trail_long) and (close - trail_long_bc) / close * 100 < 0.5
        trail_warn := true

if not in_position and not na(trail_short) and not na(trail_risk_s)
    float s_profit = (trail_short_i - trail_risk_s) - close
    if s_profit > trail_risk_s
        for rk = 1 to 3
            float nr = findSR(false, close, res_prices, res_scores, rk)
            if not na(nr)
                float ni = nr + atr_val * sl_inst_mult
                if nr < trail_short and (ni - close > trail_risk_s)
                    trail_short := nr
                    break
    trail_short_i := math.min(nz(trail_short_i), trail_short + atr_val * sl_inst_mult)
    trail_short_bc := math.min(nz(trail_short_bc), trail_short + atr_val * sl_close_mult)
    // v8.02: tr2 merge
    float str2_raws = low + atr_val * tr2_mult
    sig_tr2_s := math.min(nz(sig_tr2_s, str2_raws), str2_raws)
    trail_short_i := math.min(trail_short_i, sig_tr2_s + atr_val * sl_inst_mult)
    trail_short_bc := math.min(trail_short_bc, sig_tr2_s + atr_val * sl_close_mult)
    if barstate.isconfirmed and close > trail_short_bc
        trail_bc_hit_s := true
    if high > trail_short_i
        stop_hit := true
        stop_hit_s := true
        trail_short := na
        trail_short_i := na
        trail_short_bc := na
        trail_risk_s := na
        sig_tr2_s := na
    if not na(trail_short) and (trail_short_bc - close) / close * 100 < 0.5
        trail_warn := true

if stop_hit_l and bt_dir == 1 and in_bt and (bar_index - bt_entry_bar >= min_hold)
    float pl = close - bt_entry - in_spread
    bt_total_pl := bt_total_pl + pl
    bt_equity := bt_equity + pl
    if bt_equity > bt_peak_eq
        bt_peak_eq := bt_equity
    float dd = bt_peak_eq - bt_equity
    if dd > bt_max_dd
        bt_max_dd := dd
    bt_total_trades += 1
    if pl > 0
        bt_wins += 1
    else
        bt_losses += 1
    array.push(bt_hist_ebar, bt_entry_bar)
    array.push(bt_hist_xbar, bar_index)
    array.push(bt_hist_epx, bt_entry)
    array.push(bt_hist_xpx, close)
    array.push(bt_hist_dir, 1)
    bt_dir := 0
    bt_entry := 0.0
    bt_cnt := 0
    bt_trail_i := na
    bt_trail_b := na
    bt_tr2 := na
    bt_init_sli := na
    bt_init_slb := na
    bt_risk := na
if stop_hit_s and bt_dir == -1 and in_bt and (bar_index - bt_entry_bar >= min_hold)
    float pl = bt_entry - close - in_spread
    bt_total_pl := bt_total_pl + pl
    bt_equity := bt_equity + pl
    if bt_equity > bt_peak_eq
        bt_peak_eq := bt_equity
    float dd = bt_peak_eq - bt_equity
    if dd > bt_max_dd
        bt_max_dd := dd
    bt_total_trades += 1
    if pl > 0
        bt_wins += 1
    else
        bt_losses += 1
    array.push(bt_hist_ebar, bt_entry_bar)
    array.push(bt_hist_xbar, bar_index)
    array.push(bt_hist_epx, bt_entry)
    array.push(bt_hist_xpx, close)
    array.push(bt_hist_dir, -1)
    bt_dir := 0
    bt_entry := 0.0
    bt_cnt := 0
    bt_trail_i := na
    bt_trail_b := na
    bt_tr2 := na
    bt_init_sli := na
    bt_init_slb := na
    bt_risk := na

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 14B: POZİSYON TRAİLİNG STOP — Sevit Mantığı
// ══════════════════════════════════════════════════════════════════
var float pos_trail     = na   // referans seviye (support/resistance)
var float pos_trail_bar = na   // bar close trail
var float pos_trail_inst = na  // instant trail
var float pos_risk_cost = na
var float pos_tr2 = na
var float _last_pe2 = 0.0
var int   pos_start_time = 0
var bool  _was_in_pos = false    // v8.02: pozisyon geçiş tespiti

// v8.10: Pozisyon trail sadece giriş barından itibaren çalışır
if time >= pos_entry_time
    // Init: pozisyon açılınca, entry değişince, veya yeni pozisyon geçişi
    bool pos_new_entry = (in_position and not _was_in_pos) or (in_position and pos_entry != _last_pe2)
    if pos_new_entry or not in_position
        pos_trail      := na
        pos_trail_bar  := na
        pos_trail_inst := na
        pos_risk_cost  := na
        pos_tr2        := na
        _last_pe2 := pos_entry
        pos_start_time := 0
    _was_in_pos := in_position

if time >= pos_entry_time and in_position and pos_entry > 0 and not na(atr_val)
    bool ilp = pos_dir == "LONG"
    // Init: henüz trail yoksa
    if na(pos_trail)
        pos_start_time := time
        if pos_sl > 0
            // int_stop mevcut: pos_sl'den trail ters hesapla
            if ilp
                pos_trail_inst := pos_sl
                pos_trail      := pos_sl + atr_val * sl_inst_mult
                pos_trail_bar  := pos_trail - atr_val * sl_close_mult
                pos_risk_cost  := pos_entry - pos_sl
            else
                pos_trail_inst := pos_sl
                pos_trail      := pos_sl - atr_val * sl_inst_mult
                pos_trail_bar  := pos_trail + atr_val * sl_close_mult
                pos_risk_cost  := pos_sl - pos_entry
        else
            // int_stop yok: en güçlü destek/direnç bul
            float ref = na
            if ilp
                ref := findSR(true, pos_entry, sup_prices, sup_scores, 1)
                if na(ref)
                    ref := pos_entry - 2 * atr_val
                pos_trail      := ref
                pos_trail_inst := ref - atr_val * sl_inst_mult
                pos_trail_bar  := ref - atr_val * sl_close_mult
                pos_risk_cost  := pos_entry - pos_trail_inst
            else
                ref := findSR(false, pos_entry, res_prices, res_scores, 1)
                if na(ref)
                    ref := pos_entry + 2 * atr_val
                pos_trail      := ref
                pos_trail_inst := ref + atr_val * sl_inst_mult
                pos_trail_bar  := ref + atr_val * sl_close_mult
                pos_risk_cost  := pos_trail_inst - pos_entry

    // Güncelleme: profit > risk_cost ise trail yukarı/aşağı kayabilir
    if not na(pos_risk_cost) and not na(pos_trail)
        float profit = ilp ? close - pos_entry : pos_entry - close
        if profit > pos_risk_cost
            for rk = 1 to 3
                float nr = na
                if ilp
                    nr := findSR(true, close, sup_prices, sup_scores, rk)
                else
                    nr := findSR(false, close, res_prices, res_scores, rk)
                if not na(nr)
                    float ni = ilp ? nr - atr_val * sl_inst_mult : nr + atr_val * sl_inst_mult
                    bool better = ilp ? nr > pos_trail : nr < pos_trail
                    float dist = ilp ? close - ni : ni - close
                    if better and dist > pos_risk_cost
                        pos_trail := nr
                        break

        // v8.04: Rejection tespiti — direnci/desteği kıramadıysa trail sıkılaştır
        // Long: high R1'e yaklaştı ama close altında kaldı → en yüksek uygun desteğe atla
        if ilp
            float near_res = not na(array.get(top_res_p, 0)) ? array.get(top_res_p, 0) : na
            if not na(near_res) and high >= near_res - atr_val * 0.3 and close < near_res
                float best_rej = na
                for rj = 0 to 2
                    float sv = array.get(top_sup_lo, rj)
                    if not na(sv) and sv < close and sv > pos_trail
                        if na(best_rej) or sv > best_rej
                            best_rej := sv
                if not na(best_rej)
                    pos_trail := best_rej
        // Short: low S1'e yaklaştı ama close üstünde kaldı → en düşük uygun dirence atla
        else
            float near_sup = not na(array.get(top_sup_p, 0)) ? array.get(top_sup_p, 0) : na
            if not na(near_sup) and low <= near_sup + atr_val * 0.3 and close > near_sup
                float best_rej = na
                for rj = 0 to 2
                    float rv = array.get(top_res_hi, rj)
                    if not na(rv) and rv > close and rv < pos_trail
                        if na(best_rej) or rv < best_rej
                            best_rej := rv
                if not na(best_rej)
                    pos_trail := best_rej

        // Trail seviyeleri güncelle (never-backward dahil)
        float new_inst = ilp ? pos_trail - atr_val * sl_inst_mult : pos_trail + atr_val * sl_inst_mult
        float new_bar  = ilp ? pos_trail - atr_val * sl_close_mult : pos_trail + atr_val * sl_close_mult
        if ilp
            pos_trail_inst := math.max(nz(pos_trail_inst, new_inst), new_inst)
            pos_trail_bar  := math.max(nz(pos_trail_bar, new_bar), new_bar)
        else
            pos_trail_inst := math.min(nz(pos_trail_inst, new_inst), new_inst)
            pos_trail_bar  := math.min(nz(pos_trail_bar, new_bar), new_bar)

    // v8.02: tr2 ATR takip trail — pozisyon için
    if ilp
        float ptr2_raw = high - atr_val * tr2_mult
        pos_tr2 := math.max(nz(pos_tr2, ptr2_raw), ptr2_raw)
        float ptr2_i = pos_tr2 - atr_val * sl_inst_mult
        float ptr2_b = pos_tr2 - atr_val * sl_close_mult
        pos_trail_inst := math.max(nz(pos_trail_inst), ptr2_i)
        pos_trail_bar  := math.max(nz(pos_trail_bar), ptr2_b)
    else
        float ptr2_raw = low + atr_val * tr2_mult
        pos_tr2 := math.min(nz(pos_tr2, ptr2_raw), ptr2_raw)
        float ptr2_i = pos_tr2 + atr_val * sl_inst_mult
        float ptr2_b = pos_tr2 + atr_val * sl_close_mult
        pos_trail_inst := math.min(nz(pos_trail_inst), ptr2_i)
        pos_trail_bar  := math.min(nz(pos_trail_bar), ptr2_b)
else
    if time >= pos_entry_time and not in_position
        pos_trail      := na
        pos_trail_bar  := na
        pos_trail_inst := na
        pos_tr2        := na

bool pos_trail_bar_hit = false
bool pos_trail_inst_hit = false
bool pos_trail_approaching = false
if in_position and not na(pos_trail_bar)
    if pos_dir == "LONG"
        pos_trail_bar_hit  := barstate.isconfirmed and close <= pos_trail_bar
        pos_trail_inst_hit := low <= pos_trail_inst
        pos_trail_approaching := not barstate.isconfirmed and close <= pos_trail_bar
    else
        pos_trail_bar_hit  := barstate.isconfirmed and close >= pos_trail_bar
        pos_trail_inst_hit := high >= pos_trail_inst
        pos_trail_approaching := not barstate.isconfirmed and close >= pos_trail_bar

float pos_pnl = in_position and pos_entry > 0 ? (pos_dir == "LONG" ? close - pos_entry : pos_entry - close) : na
float pos_pnl_pct = not na(pos_pnl) and pos_entry > 0 ? pos_pnl / pos_entry * 100 : na
float pos_tp_dist = in_position and pos_tp > 0 ? (pos_dir == "LONG" ? pos_tp - close : close - pos_tp) / close * 100 : na
float pos_sl_dist = in_position and pos_sl > 0 ? (pos_dir == "LONG" ? close - pos_sl : pos_sl - close) / close * 100 : na

// v8.02: SugTP pozisyon entry'sinin ötesinde olmalı
float sug_new_tp = na
if pos_dir == "LONG"
    if not na(long_tp1) and long_tp1 > pos_entry
        sug_new_tp := long_tp1
    else if not na(long_tp2) and long_tp2 > pos_entry
        sug_new_tp := long_tp2
    else if not na(long_tp3) and long_tp3 > pos_entry
        sug_new_tp := long_tp3
else
    if not na(short_tp1) and short_tp1 < pos_entry
        sug_new_tp := short_tp1
    else if not na(short_tp2) and short_tp2 < pos_entry
        sug_new_tp := short_tp2
    else if not na(short_tp3) and short_tp3 < pos_entry
        sug_new_tp := short_tp3
float sug_new_sl_bar = pos_dir == "LONG" ? long_sl1b : short_sl1b
float sug_new_sl_inst = pos_dir == "LONG" ? long_sl1i : short_sl1i
// v8.02: SugTP kaynağını doğru eşle
string sug_tp_src = ""
if pos_dir == "LONG"
    if not na(sug_new_tp) and not na(long_tp1) and sug_new_tp == long_tp1
        sug_tp_src := array.get(top_res_n, 0)
    else if not na(sug_new_tp) and not na(long_tp2) and sug_new_tp == long_tp2
        sug_tp_src := array.get(top_res_n, 1)
    else if not na(sug_new_tp) and not na(long_tp3) and sug_new_tp == long_tp3
        sug_tp_src := array.get(top_res_n, 2)
else
    if not na(sug_new_tp) and not na(short_tp1) and sug_new_tp == short_tp1
        sug_tp_src := array.get(top_sup_n, 0)
    else if not na(sug_new_tp) and not na(short_tp2) and sug_new_tp == short_tp2
        sug_tp_src := array.get(top_sup_n, 1)
    else if not na(sug_new_tp) and not na(short_tp3) and sug_new_tp == short_tp3
        sug_tp_src := array.get(top_sup_n, 2)
string sug_sl_src = pos_dir == "LONG" ? array.get(top_sup_n, 0) : array.get(top_res_n, 0)

bool should_exit = in_position and (
     stop_hit or pos_trail_inst_hit or
     (pos_dir == "LONG" and locked_short_score >= sig_normal) or
     (pos_dir == "SHORT" and locked_long_score >= sig_normal) or
     (pos_dir == "LONG" and below_cloud and downtrend) or
     (pos_dir == "SHORT" and above_cloud and uptrend))

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 15: PLOTS
// ══════════════════════════════════════════════════════════════════
plot(en_ma ? bv_trade : na, "Best Trade MA", color=col_bt, linewidth=3, display=display.all)
plot(en_ma ? bv_long : na, "Best Long MA", color=col_bl, linewidth=2, style=plot.style_stepline, display=display.pane)
plot(en_ma ? bv_short : na, "Best Short MA", color=col_bs, linewidth=2, style=plot.style_stepline, display=display.pane)
plot(en_ma ? bv_sr : na, "Best S/R MA", color=col_br, linewidth=1, style=plot.style_circles, display=display.pane)
p_t = plot(en_ich ? tenkan : na, "Ichimoku Tenkan", color=color.new(color.blue,40), display=display.pane)
p_k = plot(en_ich ? kijun : na, "Ichimoku Kijun", color=color.new(color.red,40), display=display.pane)
p_a = plot(en_ich ? senkouA : na, "Cloud SpanA", color=color.new(color.green,60), offset=ich_kijun, display=display.pane)
p_b = plot(en_ich ? senkouB : na, "Cloud SpanB", color=color.new(color.red,60), offset=ich_kijun, display=display.pane)
fill(p_a, p_b, color=en_ich ? (senkouA > senkouB ? color.new(color.green,90) : color.new(color.red,90)) : na)
plot(en_band ? band_upper : na, "Band Upper", color=color.new(color.gray,50), display=display.pane)
plot(en_band ? band_mid : na, "Band Mid", color=color.new(color.gray,70), style=plot.style_cross, display=display.pane)
plot(en_band ? band_lower : na, "Band Lower", color=color.new(color.gray,50), display=display.pane)
plot(en_htf ? htf_ema50 : na, "HTF EMA50", color=color.new(color.orange,40), linewidth=2, style=plot.style_cross, display=display.all)
plot(en_htf ? htf_ema200 : na, "HTF EMA200", color=color.new(color.purple,40), linewidth=2, style=plot.style_cross, display=display.all)
bool tl_active = (in_position and pos_dir == "LONG") or bt_dir == 1
bool ts_active = (in_position and pos_dir == "SHORT") or bt_dir == -1
// v8.23: Pozisyondayken pos_trail değerlerini stepline'da göster
float _plt_l_bc = in_position and pos_dir == "LONG" ? pos_trail_bar : trail_long_bc
float _plt_l_i  = in_position and pos_dir == "LONG" ? pos_trail_inst : trail_long_i
float _plt_s_bc = in_position and pos_dir == "SHORT" ? pos_trail_bar : trail_short_bc
float _plt_s_i  = in_position and pos_dir == "SHORT" ? pos_trail_inst : trail_short_i
bool _t_active = tl_active or ts_active
float _trail_bc = not na(_plt_l_bc) ? _plt_l_bc : _plt_s_bc
float _trail_i  = not na(_plt_l_i) ? _plt_l_i : _plt_s_i
plot(show_trail_ln and not na(_trail_bc) ? _trail_bc : na, "Trail BC", color=_t_active ? color.new(color.white, 20) : color.new(color.gray, 60), linewidth=1, style=plot.style_stepline, display=display.all)
plot(show_trail_ln and not na(_trail_i) ? _trail_i : na, "Trail Inst", color=_t_active ? color.new(color.white, 0) : color.new(color.gray, 50), linewidth=2, style=plot.style_stepline, display=display.all)
plot(show_sug_line and show_ll ? long_limit : na, "Buy Limit Entry", color=color.new(color.aqua,20), linewidth=2, style=plot.style_stepline, display=display.pane)
plot(show_sug_line and show_sl2 ? short_limit : na, "Sell Limit Entry", color=color.new(color.fuchsia,20), linewidth=2, style=plot.style_stepline, display=display.pane)
// ── Gizli plotlar: eXeTRADE-SubPanel için input.source() ile okunacak ──
float position_dir = in_position ? (pos_dir == "LONG" ? 1.0 : -1.0) : 0.0
plot(long_score,    "xLongScore",  display=display.none)
plot(short_score,   "xShortScore", display=display.none)
plot(pos_entry,     "xEntryPrice", display=display.none)
plot(position_dir,  "xPosDir",     display=display.none)
plot(atr_val,       "xATR",        display=display.none)
float _open_pl = bt_dir == 1 ? close - bt_entry : bt_dir == -1 ? bt_entry - close : 0.0
float _eq = in_position ? (time >= pos_entry_time ? nz(pos_pnl) : 0.0) : bt_equity + _open_pl
plot(_eq, "xEquity", display=display.none)
// Trend göstergesi kaldırıldı (barcolor/bgcolor yok)
// Giriş tipi tespiti (görsel için)
bool bt_first_long  = bt_buy and bt_dir == 1 and bt_cnt == 1 and (bt_dir != bt_dir[1] or bt_cnt != bt_cnt[1])
bool bt_add_long    = bt_buy and bt_dir == 1 and bt_cnt > 1 and not bt_is_single
bool bt_first_short = bt_sell and bt_dir == -1 and bt_cnt == 1 and (bt_dir != bt_dir[1] or bt_cnt != bt_cnt[1])
bool bt_add_short   = bt_sell and bt_dir == -1 and bt_cnt > 1 and not bt_is_single

// ── Sinyal etiketi 3 bar tut ──
var label sig_lbl_l = na
var label sig_lbl_s = na
var int   sig_bar_l = 0
var int   sig_bar_s = 0
var float sig_px_l  = na
var float sig_px_s  = na
bool any_long_sig  = strong_buy or normal_buy or range_buy
bool any_short_sig = strong_sell or normal_sell or range_sell
if any_long_sig and show_signals
    if not na(sig_lbl_l)
        label.delete(sig_lbl_l)
    string stype_l = strong_buy ? "S.BUY" : normal_buy ? "BUY" : "R.BUY"
    float ssc_l = math.round(locked_long_score + bounce_bonus_l)
    // v10.01: Gate uyarı — threshold içindeki toplam direnç puanı
    string gate_warn_l = gate_trig_l and gateMode != "Off" ? "\n⚠ " + str.tostring(gate_cnt_r) + "R <" + str.tostring(gateThr, "#.#") + "ATR = -" + str.tostring(math.round(gate_pen_r)) + "pt" : ""
    color lblcol_l = gate_trig_l and gateMode == "Hard Block" ? color.new(color.red, 20) : gate_trig_l and gateMode == "Soft Block" ? color.new(color.yellow, 20) : gate_trig_l and gateMode == "Warning" ? color.new(color.orange, 20) : color.new(color.lime, 20)
    sig_lbl_l := label.new(bar_index, low - atr_val * 3, stype_l + " " + str.tostring(ssc_l) + "pt @" + str.tostring(close, format.mintick) + gate_warn_l, color=lblcol_l, textcolor=color.white, size=size.tiny, style=label.style_label_up)
    sig_bar_l := bar_index
    sig_px_l  := close
if any_short_sig and show_signals
    if not na(sig_lbl_s)
        label.delete(sig_lbl_s)
    string stype_s = strong_sell ? "S.SELL" : normal_sell ? "SELL" : "R.SELL"
    float ssc_s = math.round(locked_short_score + bounce_bonus_s)
    // v10.01: Gate uyarı — threshold içindeki toplam destek puanı
    string gate_warn_s = gate_trig_s and gateMode != "Off" ? "\n⚠ " + str.tostring(gate_cnt_s) + "S <" + str.tostring(gateThr, "#.#") + "ATR = -" + str.tostring(math.round(gate_pen_s)) + "pt" : ""
    color lblcol_s = gate_trig_s and gateMode == "Hard Block" ? color.new(color.maroon, 20) : gate_trig_s and gateMode == "Soft Block" ? color.new(color.yellow, 20) : gate_trig_s and gateMode == "Warning" ? color.new(color.orange, 20) : color.new(color.red, 20)
    sig_lbl_s := label.new(bar_index, high + atr_val * 3, stype_s + " " + str.tostring(ssc_s) + "pt @" + str.tostring(close, format.mintick) + gate_warn_s, color=lblcol_s, textcolor=color.white, size=size.tiny, style=label.style_label_down)
    sig_bar_s := bar_index
    sig_px_s  := close
// 3 bar sonra sil
if not na(sig_lbl_l) and bar_index - sig_bar_l > 3
    label.delete(sig_lbl_l)
    sig_lbl_l := na
if not na(sig_lbl_s) and bar_index - sig_bar_s > 3
    label.delete(sig_lbl_s)
    sig_lbl_s := na

plotshape(show_signals and strong_buy and bt_first_long, "Strong Buy ▲", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(show_signals and normal_buy and bt_first_long, "Buy △", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(show_signals and range_buy and bt_first_long, "Range Buy ◆", shape.diamond, location.belowbar, color.new(color.aqua,20), size=size.tiny)
plotshape(show_signals and strong_sell and bt_first_short, "Strong Sell ▼", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(show_signals and normal_sell and bt_first_short, "Sell ▽", shape.triangledown, location.abovebar, color.maroon, size=size.tiny)
plotshape(show_signals and range_sell and bt_first_short, "Range Sell ◆", shape.diamond, location.abovebar, color.new(color.fuchsia,20), size=size.tiny)
plotshape(show_signals and stop_hit, "Stop Hit ✕", shape.xcross, location.belowbar, color.orange, size=size.small)
if show_signals and pu_detected and en_div
    label.new(bar_index-div_pv_len, low[div_pv_len], "PD↑ " + str.tostring(aktif_pd) + ".", color=color.new(color.green,20), textcolor=color.white, size=size.small, style=label.style_label_up)
if show_signals and nu_detected and en_div
    label.new(bar_index-div_pv_len, high[div_pv_len], "ND↓ " + str.tostring(aktif_nd) + ".", color=color.new(color.red,20), textcolor=color.white, size=size.small, style=label.style_label_down)
var label lbl_ma_t = na
var label lbl_ma_l = na
var label lbl_ma_s = na
if barstate.islast and en_ma
    if na(lbl_ma_t)
        lbl_ma_t := label.new(bar_index+3, bv_trade, "Trade:"+bn_trade, color=col_bt, textcolor=color.black, size=lbl_size, style=label.style_label_left)
        lbl_ma_l := label.new(bar_index+3, bv_long, "Long:"+bn_long, color=col_bl, textcolor=color.black, size=lbl_size, style=label.style_label_left)
        lbl_ma_s := label.new(bar_index+3, bv_short, "Short:"+bn_short, color=col_bs, textcolor=color.black, size=lbl_size, style=label.style_label_left)
    else
        label.set_xy(lbl_ma_t, bar_index+3, bv_trade)
        label.set_text(lbl_ma_t, "Trade:"+bn_trade)
        label.set_xy(lbl_ma_l, bar_index+3, bv_long)
        label.set_text(lbl_ma_l, "Long:"+bn_long)
        label.set_xy(lbl_ma_s, bar_index+3, bv_short)
        label.set_text(lbl_ma_s, "Short:"+bn_short)

// ── Limit Order Etiketleri (▽/△ + Entry/TP1/SL1) ──
var label[] lim_lbls = array.new<label>()
if barstate.islast
    for ll in lim_lbls
        label.delete(ll)
    array.clear(lim_lbls)
    if show_ll and not na(long_limit)
        array.push(lim_lbls, label.new(bar_index+3, long_limit, "△ LongEntry:" + str.tostring(long_limit, format.mintick) + " ~" + str.tostring(math.round(long_score + bounce_bonus_l)) + "pt", color=color.new(color.aqua,60), textcolor=color.aqua, size=tbl_text, style=label.style_label_left))
        if not na(long_tp1)
            array.push(lim_lbls, label.new(bar_index+3, long_tp1, "L.TP1:" + str.tostring(long_tp1, format.mintick), color=color.new(color.lime,80), textcolor=color.lime, size=tbl_text, style=label.style_label_left))
        if not na(long_sl1i)
            array.push(lim_lbls, label.new(bar_index+3, long_sl1i, "L.SL1:" + str.tostring(long_sl1i, format.mintick), color=color.new(color.red,80), textcolor=color.red, size=tbl_text, style=label.style_label_left))
    if show_sl2 and not na(short_limit)
        array.push(lim_lbls, label.new(bar_index+3, short_limit, "▽ ShortEntry:" + str.tostring(short_limit, format.mintick) + " ~" + str.tostring(math.round(short_score + bounce_bonus_s)) + "pt", color=color.new(color.fuchsia,60), textcolor=color.fuchsia, size=tbl_text, style=label.style_label_left))
        if not na(short_tp1)
            array.push(lim_lbls, label.new(bar_index+3, short_tp1, "S.TP1:" + str.tostring(short_tp1, format.mintick), color=color.new(color.lime,80), textcolor=color.lime, size=tbl_text, style=label.style_label_left))
        if not na(short_sl1i)
            array.push(lim_lbls, label.new(bar_index+3, short_sl1i, "S.SL1:" + str.tostring(short_sl1i, format.mintick), color=color.new(color.red,80), textcolor=color.red, size=tbl_text, style=label.style_label_left))

// ── Pozisyon çizgileri (line.new — sağa 5 bar) ──
var line[] pos_lines = array.new<line>()
var label[] pos_lbls = array.new<label>()

if barstate.islast
    for pl in pos_lines
        line.delete(pl)
    for plb in pos_lbls
        label.delete(plb)
    array.clear(pos_lines)
    array.clear(pos_lbls)
    if show_pos_line and in_position and pos_entry > 0
        int pl_left = bar_index
        int pl_right = bar_index + 5
        array.push(pos_lines, line.new(pl_left, pos_entry, pl_right, pos_entry, color=color.yellow, style=line.style_solid, width=1))
        string pnl_txt = not na(pos_pnl) ? (pos_pnl >= 0 ? "+" : "") + str.tostring(pos_pnl, format.mintick) + " (" + str.tostring(pos_pnl_pct, "#.##") + "%)" : ""
        color pnl_c = not na(pos_pnl) ? (pos_pnl >= 0 ? color.lime : color.red) : color.gray
        array.push(pos_lbls, label.new(pl_right, pos_entry, "Entry:" + str.tostring(pos_entry, format.mintick) + " P/L:" + pnl_txt, color=color.new(color.yellow, 80), textcolor=pnl_c, size=tbl_text, style=label.style_label_left))
        if pos_tp > 0
            array.push(pos_lines, line.new(pl_left, pos_tp, pl_right, pos_tp, color=color.lime, style=line.style_solid, width=2))
            string tp_pct = not na(pos_tp_dist) ? " (" + str.tostring(pos_tp_dist, "#.#") + "%)" : ""
            array.push(pos_lbls, label.new(pl_right, pos_tp, "TP:" + str.tostring(pos_tp, format.mintick) + tp_pct, color=color.new(color.lime, 80), textcolor=color.lime, size=tbl_text, style=label.style_label_left))
        if pos_sl > 0
            array.push(pos_lines, line.new(pl_left, pos_sl, pl_right, pos_sl, color=color.red, style=line.style_solid, width=2))
            string sl_pct = not na(pos_sl_dist) ? " (" + str.tostring(pos_sl_dist, "#.#") + "%)" : ""
            array.push(pos_lbls, label.new(pl_right, pos_sl, "SL:" + str.tostring(pos_sl, format.mintick) + sl_pct, color=color.new(color.red, 80), textcolor=color.red, size=tbl_text, style=label.style_label_left))
        // Pozisyon trail çizgileri
        if not na(pos_trail_bar)
            float tb_dist = math.abs(pos_trail_bar - close) / close * 100
            string tb_mark = pos_trail_bar_hit ? " HIT!" : pos_trail_approaching ? " ⚠exit on close" : ""
            color tb_c = pos_trail_bar_hit ? color.red : pos_trail_approaching ? color.orange : color.new(color.orange, 30)
            array.push(pos_lines, line.new(pl_left, pos_trail_bar, pl_right, pos_trail_bar, color=tb_c, style=line.style_solid, width=1))
            array.push(pos_lbls, label.new(pl_right, pos_trail_bar, "TrailBC:" + str.tostring(pos_trail_bar, format.mintick) + " (" + str.tostring(tb_dist, "#.#") + "%)" + tb_mark, color=color.new(color.orange, 80), textcolor=tb_c, size=tbl_text, style=label.style_label_left))
        if not na(pos_trail_inst)
            float ti_dist = math.abs(pos_trail_inst - close) / close * 100
            string ti_mark = pos_trail_inst_hit ? " HIT!" : ""
            color ti_c = pos_trail_inst_hit ? color.red : color.new(color.orange, 60)
            array.push(pos_lines, line.new(pl_left, pos_trail_inst, pl_right, pos_trail_inst, color=ti_c, style=line.style_dashed, width=1))
            array.push(pos_lbls, label.new(pl_right, pos_trail_inst, "TrailIN:" + str.tostring(pos_trail_inst, format.mintick) + " (" + str.tostring(ti_dist, "#.#") + "%)" + ti_mark, color=color.new(color.orange, 80), textcolor=ti_c, size=tbl_text, style=label.style_label_left))
        // ── Önerilen TP/SL etiketleri (#42) ──
        if show_sug_line
            bool ilp2 = pos_dir == "LONG"
            // Suggested TP
            if not na(sug_new_tp)
                float tp_d = math.abs(sug_new_tp - close) / close * 100
                bool tp_hit = ilp2 ? high >= sug_new_tp : low <= sug_new_tp
                string tp_mark = tp_hit ? " ⚠️HIT" : tp_d < 0.5 ? " 📍NEAR" : ""
                color tp_c = tp_hit ? color.yellow : tp_d < 0.5 ? color.aqua : color.new(color.aqua, 40)
                array.push(pos_lines, line.new(pl_left, sug_new_tp, pl_right, sug_new_tp, color=tp_c, style=line.style_dashed, width=1))
                array.push(pos_lbls, label.new(pl_right, sug_new_tp, "SugTP:" + str.tostring(sug_new_tp, format.mintick) + " (" + sug_tp_src + ")" + tp_mark, color=color.new(color.aqua, 80), textcolor=tp_c, size=tbl_text, style=label.style_label_left))
            // Suggested SL Bar Close
            if not na(sug_new_sl_bar)
                float slb_d = math.abs(sug_new_sl_bar - close) / close * 100
                bool slb_hit = ilp2 ? close <= sug_new_sl_bar : close >= sug_new_sl_bar
                string slb_mark = slb_hit ? " ⚠️HIT" : slb_d < 1.0 ? " 📍NEAR" : ""
                color slb_c = slb_hit ? color.yellow : slb_d < 1.0 ? color.fuchsia : color.new(color.fuchsia, 40)
                array.push(pos_lines, line.new(pl_left, sug_new_sl_bar, pl_right, sug_new_sl_bar, color=slb_c, style=line.style_dashed, width=1))
                array.push(pos_lbls, label.new(pl_right, sug_new_sl_bar, "SugSL.BC:" + str.tostring(sug_new_sl_bar, format.mintick) + slb_mark, color=color.new(color.fuchsia, 80), textcolor=slb_c, size=tbl_text, style=label.style_label_left))
            // Suggested SL Instant
            if not na(sug_new_sl_inst)
                float sli_d = math.abs(sug_new_sl_inst - close) / close * 100
                bool sli_hit = ilp2 ? low <= sug_new_sl_inst : high >= sug_new_sl_inst
                string sli_mark = sli_hit ? " ⚠️HIT" : sli_d < 1.0 ? " 📍NEAR" : ""
                color sli_c = sli_hit ? color.yellow : sli_d < 1.0 ? color.fuchsia : color.new(color.fuchsia, 40)
                array.push(pos_lines, line.new(pl_left, sug_new_sl_inst, pl_right, sug_new_sl_inst, color=sli_c, style=line.style_dotted, width=1))
                array.push(pos_lbls, label.new(pl_right, sug_new_sl_inst, "SugSL.IN:" + str.tostring(sug_new_sl_inst, format.mintick) + sli_mark, color=color.new(color.fuchsia, 80), textcolor=sli_c, size=tbl_text, style=label.style_label_left))

// ── S/R Kutu + Çizgi — Pivot/HTF → kutu, diğerleri → dashed çizgi ──
var box[]   sr_boxes = array.new<box>()
var label[] sr_box_lbls = array.new<label>()
var line[]  sr_lines = array.new<line>()
var label[] sr_line_lbls = array.new<label>()

if barstate.islast
    for bx in sr_boxes
        box.delete(bx)
    for bl in sr_box_lbls
        label.delete(bl)
    for sln in sr_lines
        line.delete(sln)
    for sll in sr_line_lbls
        label.delete(sll)
    array.clear(sr_boxes)
    array.clear(sr_box_lbls)
    array.clear(sr_lines)
    array.clear(sr_line_lbls)
    int box_left = bar_index - 80
    int box_right = bar_index + 15
    // Direnç seviyeleri: Pivot/HTF → kutu, diğer → çizgi
    if array.size(top_res_p) > 0
        for i = 0 to 2
            float rp = array.get(top_res_p, i)
            float rsc = array.get(top_res_s, i)
            string rnm = array.get(top_res_n, i)
            float rhi = array.get(top_res_hi, i)
            if not na(rp) and rp > 0
                string stxt = str.tostring(math.round(rsc)) + "pt"
                bool has_sr = rsc >= 6
                if has_sr
                    float bt = not na(rhi) and rhi > rp ? rhi : rp
                    float bb = rp
                    if math.abs(bt - bb) < atr_val * 0.05
                        bt := rp + atr_val * 0.05
                        bb := rp - atr_val * 0.05
                    int bw = rsc >= 10 ? 2 : 1
                    color bc = rsc >= 10 ? color.new(color.red, 75) : rsc >= 6 ? color.new(color.red, 82) : color.new(color.red, 88)
                    array.push(sr_boxes, box.new(box_left, bt, box_right, bb, border_color=color.new(color.red, 60), bgcolor=bc, border_width=bw))
                    array.push(sr_box_lbls, label.new(box_right, (bt+bb)/2, "R" + str.tostring(i+1) + ":" + str.tostring(rp, format.mintick) + " " + rnm + " (" + stxt + ")", color=color.new(color.red, 80), textcolor=color.white, size=tbl_text, style=label.style_label_left))
                else if show_non_sr
                    int lw = rsc >= 10 ? 2 : 1
                    array.push(sr_lines, line.new(box_left, rp, box_right, rp, color=color.new(color.red, 50), style=line.style_dashed, width=lw))
                    array.push(sr_line_lbls, label.new(box_right, rp, "R" + str.tostring(i+1) + ":" + str.tostring(rp, format.mintick) + " " + rnm + " (" + stxt + ")", color=color.new(color.red, 75), textcolor=color.white, size=tbl_text, style=label.style_label_left))
    // Destek seviyeleri: Pivot/HTF → kutu, diğer → çizgi
    if array.size(top_sup_p) > 0
        for i = 0 to 2
            float sp2 = array.get(top_sup_p, i)
            float ssc = array.get(top_sup_s, i)
            string snm = array.get(top_sup_n, i)
            float slo = array.get(top_sup_lo, i)
            if not na(sp2) and sp2 > 0
                string stxt = str.tostring(math.round(ssc)) + "pt"
                bool has_sr = ssc >= 6
                if has_sr
                    float bt = sp2
                    float bb = not na(slo) and slo < sp2 ? slo : sp2
                    if math.abs(bt - bb) < atr_val * 0.05
                        bt := sp2 + atr_val * 0.05
                        bb := sp2 - atr_val * 0.05
                    int bw = ssc >= 10 ? 2 : 1
                    color bc = ssc >= 10 ? color.new(color.green, 75) : ssc >= 6 ? color.new(color.green, 82) : color.new(color.green, 88)
                    array.push(sr_boxes, box.new(box_left, bt, box_right, bb, border_color=color.new(color.green, 60), bgcolor=bc, border_width=bw))
                    array.push(sr_box_lbls, label.new(box_right, (bt+bb)/2, "S" + str.tostring(i+1) + ":" + str.tostring(sp2, format.mintick) + " " + snm + " (" + stxt + ")", color=color.new(color.green, 80), textcolor=color.white, size=tbl_text, style=label.style_label_left))
                else if show_non_sr
                    int lw = ssc >= 10 ? 2 : 1
                    array.push(sr_lines, line.new(box_left, sp2, box_right, sp2, color=color.new(color.green, 50), style=line.style_dashed, width=lw))
                    array.push(sr_line_lbls, label.new(box_right, sp2, "S" + str.tostring(i+1) + ":" + str.tostring(sp2, format.mintick) + " " + snm + " (" + stxt + ")", color=color.new(color.green, 75), textcolor=color.white, size=tbl_text, style=label.style_label_left))

// ── Trend Çizgisi + Kanal çizimi (3 katman döngüsü) ──
var line[] tl_lines = array.new<line>()
var line[] ch_lines = array.new<line>()
var label[] tl_lbls2 = array.new<label>()

if barstate.islast and en_tl
    for tln in tl_lines
        line.delete(tln)
    for cln in ch_lines
        line.delete(cln)
    for tlb in tl_lbls2
        label.delete(tlb)
    array.clear(tl_lines)
    array.clear(ch_lines)
    array.clear(tl_lbls2)
    int ext_right = bar_index + 20
    // v11.00 Archive çizim — kırılan TL'lerin 15 bar boyunca kesikli görünmesi
    for ai = 0 to 5
        if array.get(arc_active, ai)
            bool ai_is_up = (ai % 2) == 0
            int   a_x1 = array.get(arc_x1, ai)
            float a_sl = array.get(arc_slope, ai)
            float a_bs = array.get(arc_base, ai)
            int   a_x1d = math.max(a_x1, bar_index - 500)
            float a_y1 = a_bs + a_sl * (a_x1d - a_x1)
            float a_y2 = a_bs + a_sl * (ext_right - a_x1)
            color a_col = ai_is_up ? col_uptl : col_dntl
            array.push(tl_lines, line.new(a_x1d, a_y1, ext_right, a_y2, color=color.new(a_col, 70), style=line.style_dotted, width=1))
    for idx = 0 to 5
        if array.get(tl_valid, idx)
            bool is_up = (idx % 2) == 0
            int layer = idx < 2 ? 0 : idx < 4 ? 1 : 2
            bool skip = (layer == 1 and not en_tl_mid) or (layer == 2 and not en_tl_short)
            if not skip
                float sl_d = array.get(tl_slope, idx)
                float bs_d = array.get(tl_base, idx)
                int   x1_raw = array.get(tl_x1, idx)
                int   x1_d = math.max(x1_raw, bar_index - 500)
                bool  brk_d = array.get(tl_broken, idx)
                float y1_d = bs_d + sl_d * (x1_d - x1_raw)
                float y2_d = bs_d + sl_d * (ext_right - x1_d)
                int   tch_i = array.get(tl_touches, idx)
                int   lw = tch_i >= 5 ? 3 : tch_i >= 3 ? 2 : 1
                color base_col = is_up ? col_uptl : col_dntl
                color draw_col = brk_d ? color.new(base_col, 70) : base_col
                string draw_sty = brk_d ? line.style_dotted : line.style_solid
                array.push(tl_lines, line.new(x1_d, y1_d, ext_right, y2_d, color=draw_col, style=draw_sty, width=lw))
                // Label sadece ana katman için
                if layer == 0
                    string ltxt = is_up ? (brk_d ? "▼ Broken" : "▲ Up") : (brk_d ? "▲ Broken" : "▼ Dn")
                    ltxt := ltxt + " (" + str.tostring(tch_i) + "t)"
                    array.push(tl_lbls2, label.new(ext_right, y2_d, ltxt, color=color.new(base_col,60), textcolor=color.white, size=tbl_text, style=label.style_label_left))
                // Kanal çizimi
                if array.get(tl_chan_ok, idx) and not brk_d
                    float coff = array.get(tl_chan_off, idx)
                    float cy1 = y1_d + coff
                    float cy2 = y2_d + coff
                    array.push(ch_lines, line.new(x1_d, cy1, ext_right, cy2, color=draw_col, style=line.style_solid, width=lw))
                    float my1 = y1_d + coff / 2
                    float my2 = y2_d + coff / 2
                    array.push(ch_lines, line.new(x1_d, my1, ext_right, my2, color=color.new(base_col,60), style=line.style_dashed, width=1))

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 16: SAĞ ÜST — Score + Göstergeler
// ══════════════════════════════════════════════════════════════════
drawScoreTbl(table t) =>
    // Mini section (always shown)
    string ls = locked_long_score >= sig_strong ? "★★★" : locked_long_score >= sig_normal ? "★★" : ""
    string ss2 = locked_short_score >= sig_strong ? "★★★" : locked_short_score >= sig_normal ? "★★" : ""
    // v10.00: Gate ok — raw vs gated skor farkı
    string gate_arrow_l = gate_trig_l and gateMode == "Soft Block" and long_score_raw > locked_long_score + 0.5 ? "→" + str.tostring(math.round(long_score_raw)) + "⚠" : ""
    string gate_arrow_s = gate_trig_s and gateMode == "Soft Block" and short_score_raw > locked_short_score + 0.5 ? "→" + str.tostring(math.round(short_score_raw)) + "⚠" : ""
    table.cell(t,0,0,"SCORE",text_size=tbl_title,text_color=color.yellow,text_halign=text.align_left)
    table.cell(t,1,0,"L:"+str.tostring(math.round(locked_long_score))+ls+gate_arrow_l,text_size=tbl_title,text_color=locked_long_score>=sig_normal?color.lime:gate_trig_l?color.yellow:color.gray)
    table.cell(t,2,0,"S:"+str.tostring(math.round(locked_short_score))+ss2+gate_arrow_s,text_size=tbl_title,text_color=locked_short_score>=sig_normal?color.red:gate_trig_s?color.yellow:color.gray)
    string tbc2 = not na(pos_trail_bar) ? str.tostring(pos_trail_bar, format.mintick) : "—"
    string tin2 = not na(pos_trail_inst) ? str.tostring(pos_trail_inst, format.mintick) : "—"
    table.cell(t,0,1,"TRAIL",text_size=tbl_text,text_color=color.orange,text_halign=text.align_left)
    table.cell(t,1,1,"BC:"+tbc2,text_size=tbl_text,text_color=color.white)
    table.cell(t,2,1,"IN:"+tin2,text_size=tbl_text,text_color=color.white)
    string plv = not na(pos_pnl) ? str.tostring(pos_pnl, format.mintick) : "—"
    string plp = not na(pos_pnl_pct) ? str.tostring(pos_pnl_pct, "#.##") + "%" : "—"
    color plc = not na(pos_pnl) ? (pos_pnl >= 0 ? color.lime : color.red) : color.gray
    table.cell(t,0,2,"P/L",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,2,plv,text_size=tbl_text,text_color=plc)
    table.cell(t,2,2,plp,text_size=tbl_text,text_color=plc)
    string tpv = in_position and pos_tp > 0 ? str.tostring(pos_tp, format.mintick) : not na(sug_new_tp) ? str.tostring(sug_new_tp, format.mintick) : "—"
    string slv = in_position and pos_sl > 0 ? str.tostring(pos_sl, format.mintick) : not na(pos_trail_inst) ? str.tostring(pos_trail_inst, format.mintick) : "—"
    table.cell(t,0,3,"TP/SL",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,3,"TP:"+tpv,text_size=tbl_text,text_color=color.aqua)
    table.cell(t,2,3,"SL:"+slv,text_size=tbl_text,text_color=color.red)
    table.cell(t,0,4,"ATR",text_size=tbl_text,text_color=color.yellow,text_halign=text.align_left)
    table.cell(t,1,4,str.tostring(atr_val, format.mintick),text_size=tbl_text,text_color=color.white)
    table.cell(t,2,4,pos_dir != "None" ? pos_dir : "Δ"+str.tostring(math.round(score_diff)),text_size=tbl_text,text_color=pos_dir=="LONG"?color.lime:pos_dir=="SHORT"?color.red:math.abs(score_diff)<10?color.orange:score_diff>0?color.lime:color.red)
    true
var table tbl_score = table.new(position.top_right, 3, 20, border_width=1, border_color=color.gray, bgcolor=color.new(color.black,30), frame_color=color.gray)
if barstate.islast and (tr_view == "Score" or tr_view == "Mini") and not _no_tbl
    drawScoreTbl(tbl_score)

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 17: SOL ALT — S/R Seviyeleri (yön-nötr)
// ══════════════════════════════════════════════════════════════════
var table tbl_sr = table.new(position.bottom_left, 3, 30, border_width=1, border_color=color.gray, bgcolor=color.new(color.black,30), frame_color=color.gray)

// ── ENTRY CHECK ──
drawEntryTbl(table t) =>
    bool il = entry_dir == "LONG"
    float ds = il ? long_score : short_score
    float dr = il ? long_rr : short_rr
    table.cell(t,0,0,"★ ENTRY CHECK ★",text_size=tbl_title,text_color=color.yellow,text_halign=text.align_left)
    table.cell(t,1,0,il?"LONG ↑":"SHORT ↓",text_size=tbl_title,text_color=il?color.lime:color.red)
    table.cell(t,0,1,"Signal Score",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,1,str.tostring(math.round(ds))+"/100",text_size=tbl_title,text_color=ds>=sig_strong?color.lime:ds>=sig_normal?color.green:color.red)
    bool tf_ok = (il and uptrend) or (not il and downtrend)
    table.cell(t,0,2,"1. Trend",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,2,tf_ok?"✅ Aligned":"❌ AGAINST!",text_size=tbl_text,text_color=tf_ok?color.lime:color.red)
    bool htf_ok = (il and htf_uptrend) or (not il and htf_downtrend)
    table.cell(t,0,3,"2. HTF ("+htf_use+")",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,3,htf_ok?"✅ Aligned":"❌ AGAINST!",text_size=tbl_text,text_color=htf_ok?color.lime:color.red)
    bool cl_ok = (il and above_cloud) or (not il and below_cloud)
    table.cell(t,0,4,"3. Cloud",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,4,cl_ok?"✅ "+ich_t:"⚠️ "+ich_t,text_size=tbl_text,text_color=cl_ok?color.lime:color.orange)
    bool mc_ok = (il and macd_line>sig_line) or (not il and macd_line<sig_line)
    table.cell(t,0,5,"4. MACD",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,5,mc_ok?"✅ Aligned":"⚠️ Against",text_size=tbl_text,text_color=mc_ok?color.lime:color.orange)
    bool rs_ok = il ? rsi < rsi_ob : rsi > rsi_os
    table.cell(t,0,6,"5. RSI ("+str.tostring(rsi,"#.#")+")",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,6,rs_ok?"✅ OK":"❌ Extreme!",text_size=tbl_text,text_color=rs_ok?color.lime:color.red)
    string rrt = not na(dr) ? str.tostring(dr,"#.#")+":1" : "N/A"
    bool rr_ok2 = not na(dr) and dr >= min_rr_range
    table.cell(t,0,7,"6. R:R (TP1/SL1i)",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,7,rr_ok2?"✅ "+rrt:"❌ "+rrt,text_size=tbl_text,text_color=rr_ok2?color.lime:color.red)
    bool px_ok = il ? (na(htf_res_dist) or htf_res_dist>1.0) : (na(htf_sup_dist) or htf_sup_dist>1.0)
    table.cell(t,0,8,"7. HTF S/R Dist",text_size=tbl_text,text_color=color.white,text_halign=text.align_left)
    table.cell(t,1,8,px_ok?"✅ Clear":"❌ Near!",text_size=tbl_text,text_color=px_ok?color.lime:color.red)
    table.cell(t,0,9,"─ TARGETS ─",text_size=tbl_text,text_color=color.yellow,text_halign=text.align_left)
    table.cell(t,1,9,"",text_size=tbl_text,text_color=color.yellow)
    float dt1 = il?long_tp1:short_tp1
    float dt2 = il?long_tp2:short_tp2
    float dt3 = il?long_tp3:short_tp3
    string dn1 = il?array.get(top_res_n,0):array.get(top_sup_n,0)
    string dn2 = il?array.get(top_res_n,1):array.get(top_sup_n,1)
    string dn3 = il?array.get(top_res_n,2):array.get(top_sup_n,2)
    float ds1 = il?array.get(top_res_s,0):array.get(top_sup_s,0)
    float ds2v = il?array.get(top_res_s,1):array.get(top_sup_s,1)
    float ds3 = il?array.get(top_res_s,2):array.get(top_sup_s,2)
    for i = 0 to 2
        float tv = i==0?dt1:i==1?dt2:dt3
        string tn = i==0?dn1:i==1?dn2:dn3
        float tsv = i==0?ds1:i==1?ds2v:ds3
        string st = str.tostring(math.round(tsv)) + "pt"
        table.cell(t,0,10+i,"TP"+str.tostring(i+1),text_size=tbl_text,text_color=color.lime,text_halign=text.align_left)
        table.cell(t,1,10+i,not na(tv)?str.tostring(tv,format.mintick)+" ("+tn+" "+st+")":"—",text_size=tbl_text,text_color=color.lime)
    float db1 = il?long_sl1b:short_sl1b
    float di1 = il?long_sl1i:short_sl1i
    float db2 = il?long_sl2b:short_sl2b
    float di2 = il?long_sl2i:short_sl2i
    float db3 = il?long_sl3b:short_sl3b
    float di3 = il?long_sl3i:short_sl3i
    string sn1 = il?array.get(top_sup_n,0):array.get(top_res_n,0)
    string sn2 = il?array.get(top_sup_n,1):array.get(top_res_n,1)
    string sn3 = il?array.get(top_sup_n,2):array.get(top_res_n,2)
    float sv1 = il?array.get(top_sup_s,0):array.get(top_res_s,0)
    float sv2 = il?array.get(top_sup_s,1):array.get(top_res_s,1)
    float sv3 = il?array.get(top_sup_s,2):array.get(top_res_s,2)
    for i = 0 to 2
        float sbv = i==0?db1:i==1?db2:db3
        float siv = i==0?di1:i==1?di2:di3
        string sn = i==0?sn1:i==1?sn2:sn3
        float ssv = i==0?sv1:i==1?sv2:sv3
        string st = str.tostring(math.round(ssv)) + "pt"
        table.cell(t,0,13+i,"SL"+str.tostring(i+1)+" "+sn+" "+st,text_size=tbl_text,text_color=color.red,text_halign=text.align_left)
        table.cell(t,1,13+i,not na(sbv)?"BC:"+str.tostring(sbv,format.mintick)+" IN:"+str.tostring(siv,format.mintick):"—",text_size=tbl_text,text_color=color.red)
    float dlim = il?long_limit:short_limit
    bool dshow = il?show_ll:show_sl2
    table.cell(t,0,16,il?"Buy Limit":"Sell Limit",text_size=tbl_text,text_color=color.aqua,text_halign=text.align_left)
    table.cell(t,1,16,dshow and not na(dlim)?str.tostring(dlim,format.mintick)+" (R:R≥"+str.tostring(min_rr_range,"#.#")+")":"Not needed",text_size=tbl_text,text_color=color.aqua)

if barstate.islast and entry_check and bl_view == "Entry Check" and not _no_tbl
    drawEntryTbl(tbl_sr)

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 18B: POZİSYON YÖNETİM PANELİ (in_position=true)
// ══════════════════════════════════════════════════════════════════
drawPosTbl(table t) =>
    bool ilp = pos_dir == "LONG"
    color dir_col = ilp ? color.lime : color.red
    table.cell(t, 0, 0, "★ " + matched_name + " ★", text_size=tbl_title, text_color=color.fuchsia, text_halign=text.align_left)
    table.cell(t, 1, 0, ilp ? "LONG ↑" : "SHORT ↓", text_size=tbl_title, text_color=dir_col)
    color pnl_col = not na(pos_pnl) ? (pos_pnl >= 0 ? color.lime : color.red) : color.gray
    table.cell(t, 0, 1, "P/L", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 1, not na(pos_pnl) ? str.tostring(pos_pnl, format.mintick) + " (" + str.tostring(pos_pnl_pct, "#.##") + "%)" : "—", text_size=tbl_title, text_color=pnl_col)
    table.cell(t, 0, 2, "Entry", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    string entry_time_txt = pos_start_time > 0 ? str.format("{0,date,MM/dd HH:mm}", pos_start_time) : ""
    table.cell(t, 1, 2, str.tostring(pos_entry, format.mintick) + " " + entry_time_txt, text_size=tbl_text, text_color=color.yellow)
    string tp_status = "Not set"
    color tp_col = color.gray
    if pos_tp > 0
        tp_status := str.tostring(pos_tp, format.mintick) + " (" + str.tostring(pos_tp_dist, "#.#") + "%)"
        tp_col := not na(pos_tp_dist) and pos_tp_dist < 1 ? color.yellow : color.lime
    table.cell(t, 0, 3, "My TP (dist%)", text_size=tbl_text, text_color=color.lime, text_halign=text.align_left)
    table.cell(t, 1, 3, tp_status, text_size=tbl_text, text_color=tp_col)
    string sl_status = "Not set"
    color sl_col = color.gray
    if pos_sl > 0
        sl_status := str.tostring(pos_sl, format.mintick) + " (" + str.tostring(pos_sl_dist, "#.#") + "%)"
        sl_col := not na(pos_sl_dist) and pos_sl_dist < 1 ? color.orange : color.red
    table.cell(t, 0, 4, "My SL (dist%)", text_size=tbl_text, text_color=color.red, text_halign=text.align_left)
    table.cell(t, 1, 4, sl_status, text_size=tbl_text, text_color=sl_col)
    table.cell(t, 0, 5, "─ TRAILING ─", text_size=tbl_text, text_color=color.orange, text_halign=text.align_left)
    table.cell(t, 1, 5, "", text_size=tbl_text, text_color=color.orange)
    string tb_txt = not na(pos_trail_bar) ? str.tostring(pos_trail_bar, format.mintick) : "—"
    string tb_st = pos_trail_bar_hit ? " HIT!" : pos_trail_approaching ? " ⚠exit on close" : ""
    color tb_col = pos_trail_bar_hit ? color.red : pos_trail_approaching ? color.orange : color.white
    table.cell(t, 0, 6, "Trail BC", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 6, tb_txt + tb_st, text_size=tbl_text, text_color=tb_col)
    string ti_txt = not na(pos_trail_inst) ? str.tostring(pos_trail_inst, format.mintick) : "—"
    string ti_st = pos_trail_inst_hit ? " HIT!" : ""
    table.cell(t, 0, 7, "Trail Inst", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 7, ti_txt + ti_st, text_size=tbl_text, text_color=pos_trail_inst_hit ? color.red : color.white)
    table.cell(t, 0, 8, "─ SUGGESTED ─", text_size=tbl_text, text_color=color.yellow, text_halign=text.align_left)
    table.cell(t, 1, 8, "", text_size=tbl_text, text_color=color.yellow)
    string stp_txt = not na(sug_new_tp) ? str.tostring(sug_new_tp, format.mintick) + " (" + sug_tp_src + ")" : "—"
    bool tp_better = not na(sug_new_tp) and pos_tp > 0 and (ilp ? sug_new_tp > pos_tp : sug_new_tp < pos_tp)
    table.cell(t, 0, 9, "New TP", text_size=tbl_text, text_color=color.lime, text_halign=text.align_left)
    table.cell(t, 1, 9, stp_txt + (tp_better ? " Better" : ""), text_size=tbl_text, text_color=tp_better ? color.lime : color.gray)
    string ssl_b = not na(sug_new_sl_bar) ? str.tostring(sug_new_sl_bar, format.mintick) : "—"
    string ssl_i = not na(sug_new_sl_inst) ? str.tostring(sug_new_sl_inst, format.mintick) : "—"
    table.cell(t, 0, 10, "New SL", text_size=tbl_text, text_color=color.red, text_halign=text.align_left)
    table.cell(t, 1, 10, "BC:" + ssl_b + " IN:" + ssl_i + " (" + sug_sl_src + ")", text_size=tbl_text, text_color=color.red)
    float pos_score = ilp ? long_score : short_score
    float opp_score = ilp ? short_score : long_score
    float pos_score_lk = ilp ? locked_long_score : locked_short_score
    float opp_score_lk = ilp ? locked_short_score : locked_long_score
    table.cell(t, 0, 11, "Your Score", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 11, str.tostring(math.round(pos_score)) + " (lk:" + str.tostring(math.round(pos_score_lk)) + ")", text_size=tbl_text, text_color=pos_score >= sig_normal ? color.lime : color.gray)
    table.cell(t, 0, 12, "Opposite", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 12, str.tostring(math.round(opp_score)) + " (lk:" + str.tostring(math.round(opp_score_lk)) + ")", text_size=tbl_text, text_color=opp_score >= sig_normal ? color.red : color.gray)
    table.cell(t, 0, 13, "─ ACTION ─", text_size=tbl_text, text_color=color.yellow, text_halign=text.align_left)
    table.cell(t, 1, 13, "", text_size=tbl_text, text_color=color.yellow)
    string reason1 = ""
    string reason2 = ""
    string action = "HOLD"
    color act_col = color.gray
    // Trail verdict'leri
    if pos_trail_inst_hit
        action  := "EXIT NOW — Instant Stop HIT"
        act_col := color.red
        reason1 := "Wick broke instant trail — close immediately"
    else if should_exit
        action  := "EXIT — Signal Reversed (confirmed)"
        act_col := color.red
        reason1 := ilp ? "Short lk:" + str.tostring(math.round(opp_score_lk)) + " >= " + str.tostring(sig_normal) : "Long lk:" + str.tostring(math.round(opp_score_lk)) + " >= " + str.tostring(sig_normal)
        reason2 := "Based on last confirmed bar score"
    else if pos_trail_bar_hit
        action  := "EXIT AFTER CLOSE — Trail BC Hit"
        act_col := color.red
        reason1 := "Bar closed past trail @ " + str.tostring(pos_trail_bar, format.mintick)
        reason2 := "Close position"
    else if pos_trail_approaching
        action  := "⚠ TRAIL BC — Exit on bar close"
        act_col := color.orange
        reason1 := "Close below trail @ " + str.tostring(pos_trail_bar, format.mintick)
        reason2 := "Bar not confirmed yet — wait for close"
    else if (ilp and nu_detected) or (not ilp and pu_detected)
        action  := "LIGHTEN — Divergence!"
        act_col := color.orange
        reason1 := ilp ? "ND: reversal risk" : "PD: reversal risk"
        reason2 := "Trail tightened ×0.33. Partial close suggested"
    else if adx_falling and not na(pos_pnl) and pos_pnl > 0
        action  := "LIGHTEN — ADX Falling"
        act_col := color.yellow
        reason1 := "ADX dropping: trend weakening"
        reason2 := "Trail tightened ×0.67. Consider partial close"
    else if not na(pos_pnl) and pos_pnl > 0 and not na(pos_tp_dist) and pos_tp_dist < 0.5
        action  := "LOCK PROFIT — Near TP"
        act_col := color.lime
        reason1 := "Only " + str.tostring(pos_tp_dist, "#.#") + "% to TP"
    else if not na(pos_pnl) and pos_pnl > 0 and pos_pnl_pct > 2
        action  := "IN PROFIT — Trail & Hold"
        act_col := color.lime
        reason1 := "P/L: +" + str.tostring(pos_pnl_pct, "#.#") + "%"
    else if not na(pos_pnl) and pos_pnl > 0
        action  := "SMALL PROFIT — Hold"
        act_col := color.green
        reason1 := "P/L: +" + str.tostring(pos_pnl_pct, "#.#") + "%"
    else if not na(pos_pnl) and pos_pnl < 0 and not na(pos_sl_dist) and pos_sl_dist < 1
        action  := "DANGER — Near SL!"
        act_col := color.orange
        reason1 := "Only " + str.tostring(pos_sl_dist, "#.#") + "% to SL"
    else if not na(pos_pnl) and pos_pnl < 0
        action  := "IN LOSS — Watch SL"
        act_col := color.orange
        reason1 := "P/L: " + str.tostring(pos_pnl_pct, "#.#") + "%"
    else
        action := "NEUTRAL — Monitoring"
        act_col := color.gray
        reason1 := "No clear action needed"
    table.cell(t, 0, 14, "Verdict", text_size=tbl_title, text_color=color.yellow, text_halign=text.align_left)
    table.cell(t, 1, 14, action, text_size=tbl_title, text_color=act_col)
    table.cell(t, 0, 15, "Reason", text_size=tbl_text, text_color=color.gray, text_halign=text.align_left)
    table.cell(t, 1, 15, reason1, text_size=tbl_text, text_color=act_col)
    table.cell(t, 0, 16, "", text_size=tbl_text, text_color=color.gray, text_halign=text.align_left)
    table.cell(t, 1, 16, reason2, text_size=tbl_text, text_color=color.gray)
    float prop_rr_reward = not na(sug_new_tp) and pos_entry > 0 ? math.abs(sug_new_tp - pos_entry) : na
    float prop_rr_risk = not na(sug_new_sl_inst) and pos_entry > 0 ? math.abs(pos_entry - sug_new_sl_inst) : na
    float prop_rr = not na(prop_rr_reward) and not na(prop_rr_risk) and prop_rr_risk > 0 ? prop_rr_reward / prop_rr_risk : na
    table.cell(t, 0, 17, "Proposed R:R", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
    table.cell(t, 1, 17, not na(prop_rr) ? str.tostring(prop_rr, "#.#") + ":1" : "N/A", text_size=tbl_text, text_color=not na(prop_rr) and prop_rr >= 2 ? color.lime : not na(prop_rr) and prop_rr >= 1 ? color.yellow : color.red)

if barstate.islast and in_position and pos_entry > 0 and show_pos_tbl and not _no_tbl
    drawPosTbl(tbl_sr)

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 18C: BACKTEST SONUÇ TABLOSU + TRADE ÇİZGİLERİ
// ══════════════════════════════════════════════════════════════════
var table tbl_bt = table.new(position.bottom_right, 2, 8, border_width=1, border_color=color.gray, bgcolor=color.new(color.black,30), frame_color=color.gray)
var line[] bt_lines = array.new<line>()
var label[] bt_lbls = array.new<label>()

if barstate.islast and show_bt_tbl and not _no_tbl
    if in_position
        table.cell(tbl_bt, 0, 0, "BACKTEST", text_size=tbl_title, text_color=color.gray, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 0, "Hidden", text_size=tbl_text, text_color=color.gray)
        table.cell(tbl_bt, 0, 1, "In Pos — BT off", text_size=tbl_text, text_color=color.yellow, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 1, bt_mode == "Multi" ? "⚠ Multi trail!" : "", text_size=tbl_text, text_color=color.orange)
    else
        float win_rate = bt_total_trades > 0 ? float(bt_wins) / float(bt_total_trades) * 100 : 0
        float avg_pl = bt_total_trades > 0 ? bt_total_pl / float(bt_total_trades) : 0
        table.cell(tbl_bt, 0, 0, "BACKTEST", text_size=tbl_title, text_color=color.yellow, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 0, bt_mode + " | " + bt_period, text_size=tbl_text, text_color=color.gray)
        table.cell(tbl_bt, 0, 1, "Trades", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 1, str.tostring(bt_total_trades), text_size=tbl_text, text_color=color.white)
        table.cell(tbl_bt, 0, 2, "Win/Loss", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 2, str.tostring(bt_wins) + " / " + str.tostring(bt_losses), text_size=tbl_text, text_color=bt_wins > bt_losses ? color.lime : color.red)
        table.cell(tbl_bt, 0, 3, "Win Rate", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 3, str.tostring(win_rate, "#.#") + "%", text_size=tbl_text, text_color=win_rate >= 50 ? color.lime : color.red)
        table.cell(tbl_bt, 0, 4, "Total P/L", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 4, str.tostring(bt_total_pl, format.mintick), text_size=tbl_title, text_color=bt_total_pl >= 0 ? color.lime : color.red)
        table.cell(tbl_bt, 0, 5, "Avg P/L", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 5, str.tostring(avg_pl, format.mintick), text_size=tbl_text, text_color=avg_pl >= 0 ? color.lime : color.red)
        table.cell(tbl_bt, 0, 6, "Max DD", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        table.cell(tbl_bt, 1, 6, str.tostring(bt_max_dd, format.mintick), text_size=tbl_text, text_color=color.red)
        table.cell(tbl_bt, 0, 7, "Open", text_size=tbl_text, text_color=color.white, text_halign=text.align_left)
        string op_txt = bt_dir == 1 ? "LONG @ " + str.tostring(bt_entry, format.mintick) : bt_dir == -1 ? "SHORT @ " + str.tostring(bt_entry, format.mintick) : "Flat"
        table.cell(tbl_bt, 1, 7, op_txt, text_size=tbl_text, text_color=bt_dir == 1 ? color.lime : bt_dir == -1 ? color.red : color.gray)

// Trade geçmişi çizgileri (giriş→çıkış bağlantısı)
if barstate.islast and show_bt_lines
    for tl in bt_lines
        line.delete(tl)
    for tlb in bt_lbls
        label.delete(tlb)
    array.clear(bt_lines)
    array.clear(bt_lbls)
    int hsz = array.size(bt_hist_ebar)
    if hsz > 0
        int max_show = math.min(hsz, 50)
        for i = hsz - max_show to hsz - 1
            int eb = array.get(bt_hist_ebar, i)
            int xb = array.get(bt_hist_xbar, i)
            float ep = array.get(bt_hist_epx, i)
            float xp = array.get(bt_hist_xpx, i)
            int dr = array.get(bt_hist_dir, i)
            float pl = dr == 1 ? xp - ep : ep - xp
            color bt_lc = pl > 0 ? color.new(color.lime, 40) : color.new(color.red, 40)
            array.push(bt_lines, line.new(eb, ep, xb, xp, color=bt_lc, style=line.style_dashed, width=bt_line_width))
            string pl_txt = (pl > 0 ? "+" : "") + str.tostring(pl, format.mintick)
            array.push(bt_lbls, label.new(xb, xp, pl_txt, color=color.new(color.black, 100), textcolor=pl > 0 ? color.lime : color.red, size=tbl_text, style=label.style_label_left))

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 19-20: ALARMLAR
// ══════════════════════════════════════════════════════════════════
bool pos_tp_hit = in_position and pos_tp>0 and ((pos_dir=="LONG" and high>=pos_tp) or (pos_dir=="SHORT" and low<=pos_tp))
bool pos_sl_hit = false
if in_position and pos_sl > 0
    bool wick_hit = (pos_dir=="LONG" and low<=pos_sl) or (pos_dir=="SHORT" and high>=pos_sl)
    bool close_hit = (pos_dir=="LONG" and close<=pos_sl) or (pos_dir=="SHORT" and close>=pos_sl)
    if sl_trigger == "Wick Touch"
        pos_sl_hit := wick_hit
    else if sl_trigger == "Bar Close"
        pos_sl_hit := close_hit
    else
        pos_sl_hit := wick_hit or close_hit
bool rr_target_hit = (show_ll and not na(long_limit) and low<=long_limit) or (show_sl2 and not na(short_limit) and high>=short_limit)
float sug_tp1 = entry_dir=="LONG"?long_tp1:short_tp1
float sug_sl1 = entry_dir=="LONG"?long_sl1i:short_sl1i
bool near_tp1 = in_position and not na(sug_tp1) and math.abs(close-sug_tp1)/close*100<0.5
bool near_sl1 = in_position and not na(sug_sl1) and math.abs(close-sug_sl1)/close*100<0.5
bool sig_reversal = in_position and ((pos_dir=="LONG" and short_score>=sig_normal) or (pos_dir=="SHORT" and long_score>=sig_normal))

// ══════════════════════════════════════════════════════════════════
// BÖLÜM 20: ALARM KONSOLİDE — tüm eventler tek alert() ile gönderilir
// TradingView'de tek "eXT — MASTER" alarmı kurulur, script event mask'lerine göre mesaj gönderir
// ══════════════════════════════════════════════════════════════════
string _amsg = ""
if al_strong and strong_buy
    _amsg := _amsg + "STRONG BUY | "
if al_normal and normal_buy
    _amsg := _amsg + "BUY | "
if al_strong and strong_sell
    _amsg := _amsg + "STRONG SELL | "
if al_normal and normal_sell
    _amsg := _amsg + "SELL | "
if range_buy
    _amsg := _amsg + "RANGE BUY | "
if range_sell
    _amsg := _amsg + "RANGE SELL | "
if al_stop and stop_hit
    _amsg := _amsg + "STOP HIT | "
if al_div and pu_detected
    _amsg := _amsg + "PD | "
if al_div and nu_detected
    _amsg := _amsg + "ND | "
if al_tp_hit and pos_tp_hit
    _amsg := _amsg + "TP HIT | "
if al_sl_hit and pos_sl_hit
    _amsg := _amsg + "SL HIT | "
if al_trail and pos_trail_bar_hit
    _amsg := _amsg + "Pos Trail BC | "
if al_trail and pos_trail_inst_hit
    _amsg := _amsg + "Pos Trail Inst | "
if al_trail_w and trail_warn
    _amsg := _amsg + "Trail Warn | "
if al_trail and (trail_bc_hit_l or trail_bc_hit_s)
    _amsg := _amsg + "Signal Trail BC | "
if al_reversal and sig_reversal
    _amsg := _amsg + "Reversal | "
if al_rr_target and rr_target_hit
    _amsg := _amsg + "R:R Target | "
if al_tl_break and en_tl and up_tl_break
    _amsg := _amsg + "Uptrend Broken | "
if al_tl_break and en_tl and dn_tl_break
    _amsg := _amsg + "Downtrend Broken | "
if al_chan_brk and en_chan and up_chan_break
    _amsg := _amsg + "Channel Break Up | "
if al_chan_brk and en_chan and dn_chan_break
    _amsg := _amsg + "Channel Break Dn | "
if al_chan_brk and squeeze_breakout_up
    _amsg := _amsg + "Squeeze Break Up | "
if al_chan_brk and squeeze_breakout_down
    _amsg := _amsg + "Squeeze Break Dn | "
if al_pos_exit and should_exit
    _amsg := _amsg + "EXIT NOW | "

bool _any_event = str.length(_amsg) > 0
if _any_event
    alert(syminfo.ticker + " | " + str.tostring(close) + " | " + _amsg, alert.freq_once_per_bar)

// Master alertcondition — TV'de tek alarm kurulur, yukarıdaki alert() çalışır
alertcondition(_any_event, "eXT — MASTER", "eXeTRADE Event: {{ticker}} | Price:{{close}}")
