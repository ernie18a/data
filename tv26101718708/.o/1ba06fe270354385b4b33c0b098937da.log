// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 1-4: HESAPLAMALAR (MA, Backtest, Best MA)
// ══════════════════════════════════════════════════════════════════
float atr_val = ta.atr(14)
float ch_high = ta.change(high)
float ch_low  = ta.change(low)
float ema50_slope = (ta.ema(close, 50) - ta.ema(close, 50)[10]) / (atr_val * 10) * 100
float trend_str = math.abs(ema50_slope)

[diplus, diminus, adx_val] = ta.dmi(14, 14)
bool adx_trending = adx_val >= 25
bool adx_ranging  = adx_val < 20
bool adx_falling  = adx_val < adx_val[3] and adx_val[3] > 25
string adx_regime = adx_val >= 40 ? "STRONG" : adx_val >= 25 ? "TREND" : adx_val >= 20 ? "WEAK" : "RANGE"

float mult_trend = adx_val >= 30 ? 1.5 : adx_val >= 20 ? 1.0 : 0.5
float mult_sr    = adx_val >= 30 ? 0.7 : adx_val >= 20 ? 1.0 : 1.5

var float kama10 = na
float sum10 = 0.0
for i = 1 to 10
    sum10 := sum10 + math.abs(close - close[i])
float er10 = sum10 != 0 ? math.abs(close - close[10]) / sum10 : 0
float sc10 = math.pow(er10 * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
kama10 := nz(kama10, ta.sma(close, 10)) + sc10 * (close - nz(kama10, ta.sma(close, 10)))

var float kama21 = na
float sum21 = 0.0
for i = 1 to 21
    sum21 := sum21 + math.abs(close - close[i])
float er21 = sum21 != 0 ? math.abs(close - close[21]) / sum21 : 0
float sc21 = math.pow(er21 * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
kama21 := nz(kama21, ta.sma(close, 21)) + sc21 * (close - nz(kama21, ta.sma(close, 21)))

float ma0=ta.sma(close,8)
float ma1=ta.sma(close,13)
float ma2=ta.sma(close,20)
float ma3=ta.sma(close,50)
float ma4=ta.sma(close,100)
float ma5=ta.sma(close,200)
float ma6=ta.ema(close,8)
float ma7=ta.ema(close,13)
float ma8=ta.ema(close,20)
float ma9=ta.ema(close,50)
float ma10=ta.ema(close,100)
float ma11=ta.ema(close,200)
float ma12=kama10
bool  ma12_rising = ma12 > nz(ma12[1])
float ma13=kama21

var string[] ma_names = array.from("SMA8","SMA13","SMA20","SMA50","SMA100","SMA200","EMA8","EMA13","EMA20","EMA50","EMA100","EMA200","KAMA10","KAMA21")
var float[] ma_v = array.new<float>(14, na)
array.set(ma_v,0,ma0)
array.set(ma_v,1,ma1)
array.set(ma_v,2,ma2)
array.set(ma_v,3,ma3)
array.set(ma_v,4,ma4)
array.set(ma_v,5,ma5)
array.set(ma_v,6,ma6)
array.set(ma_v,7,ma7)
array.set(ma_v,8,ma8)
array.set(ma_v,9,ma9)
array.set(ma_v,10,ma10)
array.set(ma_v,11,ma11)
array.set(ma_v,12,ma12)
array.set(ma_v,13,ma13)
var float[] ma_p = array.new<float>(14, na)

int bt_months = switch bt_period
    "1 Mo" => 1
    "3 Mo" => 3
    "6 Mo" => 6
    "1 Yr" => 12
    => 120
int bt_start = timenow - bt_months * 30 * 86400000
int _bars_per_day = timeframe.isminutes ? math.round(1440.0 / timeframe.multiplier) : timeframe.isdaily ? 1 : timeframe.isweekly ? 1 : 1
int _bt_bar_est = bt_months * _bars_per_day * 22
bool in_bt_time = time >= bt_start
bool in_bt_bars = (last_bar_index - bar_index) <= _bt_bar_est
bool in_bt = in_bt_time or in_bt_bars
bool new_day = timeframe.change("D")
float daily_swap_mult = dayofweek == dayofweek.wednesday ? 3.0 : 1.0

var float[] bt_lp = array.new<float>(14, 0.0)
var float[] bt_sp = array.new<float>(14, 0.0)
var float[] bt_bpx = array.new<float>(14, 0.0)
var float[] bt_spx = array.new<float>(14, 0.0)
var int[] bt_wc = array.new<int>(14, 0)
var int[] sr_st = array.new<int>(14, 0)
var int[] sr_sb = array.new<int>(14, 0)
var int[] sr_rt = array.new<int>(14, 0)
var int[] sr_rb = array.new<int>(14, 0)

if in_bt and new_day
    for i = 0 to 13
        if array.get(bt_bpx, i) > 0
            array.set(bt_lp, i, array.get(bt_lp, i) - in_swap_l * daily_swap_mult)
        if array.get(bt_spx, i) > 0
            array.set(bt_sp, i, array.get(bt_sp, i) - in_swap_s * daily_swap_mult)
if in_bt
    for i = 0 to 13
        float mv = array.get(ma_v, i)
        float mvp = array.get(ma_p, i)
        if not na(mv) and not na(mvp)
            bool cup = close > mv and close[1] <= mvp
            bool cdn = close < mv and close[1] >= mvp
            if cup
                if array.get(bt_spx, i) > 0
                    float p = array.get(bt_spx, i) - close - in_spread
                    array.set(bt_sp, i, array.get(bt_sp, i) + p)
                    if p > 0
                        array.set(bt_wc, i, array.get(bt_wc, i) + 1)
                    array.set(bt_spx, i, 0.0)
                array.set(bt_bpx, i, close)
            if cdn
                if array.get(bt_bpx, i) > 0
                    float p = close - array.get(bt_bpx, i) - in_spread
                    array.set(bt_lp, i, array.get(bt_lp, i) + p)
                    if p > 0
                        array.set(bt_wc, i, array.get(bt_wc, i) + 1)
                    array.set(bt_bpx, i, 0.0)
                array.set(bt_spx, i, close)
            float tol = mv * 0.001
            if close[1] > mv and low <= mv + tol
                array.set(sr_st, i, array.get(sr_st, i) + 1)
                if close < mv
                    array.set(sr_sb, i, array.get(sr_sb, i) + 1)
            if close[1] < mv and high >= mv - tol
                array.set(sr_rt, i, array.get(sr_rt, i) + 1)
                if close > mv
                    array.set(sr_rb, i, array.get(sr_rb, i) + 1)
for i = 0 to 13
    array.set(ma_p, i, array.get(ma_v, i))

var int b_trade=9
var int b_long=9
var int b_short=9
var int b_sr=3
bool do_recalc = timeframe.change("W") or entry_check
if do_recalc and in_bt
    float mx_t=-1e18
    float mx_l=-1e18
    float mx_s=-1e18
    float mx_sr=-1e18
    for i = 0 to 13
        float lpi = array.get(bt_lp, i)
        float spi = array.get(bt_sp, i)
        float op = 0.0
        if array.get(bt_bpx, i) > 0
            op := close - array.get(bt_bpx, i)
        if array.get(bt_spx, i) > 0
            op := array.get(bt_spx, i) - close
        if lpi + spi + op > mx_t
            mx_t := lpi + spi + op
            b_trade := i
        if lpi > mx_l
            mx_l := lpi
            b_long := i
        if spi > mx_s
            mx_s := spi
            b_short := i
        int sti = array.get(sr_st, i)
        int sbi = array.get(sr_sb, i)
        int rti = array.get(sr_rt, i)
        int rbi = array.get(sr_rb, i)
        float spw = sti > 0 ? (sti - sbi) * 100.0 / sti : 0.0
        float rpw = rti > 0 ? (rti - rbi) * 100.0 / rti : 0.0
        if spw + rpw > mx_sr
            mx_sr := spw + rpw
            b_sr := i

float bv_trade=array.get(ma_v,b_trade)
float bv_long=array.get(ma_v,b_long)
float bv_short=array.get(ma_v,b_short)
float bv_sr=array.get(ma_v,b_sr)
string bn_trade=array.get(ma_names,b_trade)
string bn_long=array.get(ma_names,b_long)
string bn_short=array.get(ma_names,b_short)
string bn_sr=array.get(ma_names,b_sr)

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 5-9: ICHIMOKU, FIB, MACD, RSI, BAND
// ══════════════════════════════════════════════════════════════════
float tenkan = (ta.highest(high, ich_tenkan) + ta.lowest(low, ich_tenkan)) / 2
float kijun  = (ta.highest(high, ich_kijun)  + ta.lowest(low, ich_kijun))  / 2
float senkouA = (tenkan + kijun) / 2
float senkouB = (ta.highest(high, ich_senkou) + ta.lowest(low, ich_senkou)) / 2
float cloud_top = math.max(senkouA[ich_kijun], senkouB[ich_kijun])
float cloud_bot = math.min(senkouA[ich_kijun], senkouB[ich_kijun])
bool above_cloud = close > cloud_top
bool below_cloud = close < cloud_bot
bool _tk_cup = ta.crossover(tenkan, kijun)
bool _tk_cdn = ta.crossunder(tenkan, kijun)

// ── Fibonacci (ZigZag Swing bazlı) ──
float fib_ph = ta.pivothigh(high, fib_pv_len, fib_pv_len)
float fib_pl = ta.pivotlow(low, fib_pv_len, fib_pv_len)
var float fib_hi = na
var float fib_lo = na
var int fib_hi_x = 0
var int fib_lo_x = 0
if not na(fib_ph)
    fib_hi := fib_ph
    fib_hi_x := bar_index - fib_pv_len
if not na(fib_pl)
    fib_lo := fib_pl
    fib_lo_x := bar_index - fib_pv_len
float fib_range = nz(fib_hi) - nz(fib_lo)
float fib_236 = nz(fib_lo) + fib_range * 0.236
float fib_382 = nz(fib_lo) + fib_range * 0.382
float fib_500 = nz(fib_lo) + fib_range * 0.500
float fib_618 = nz(fib_lo) + fib_range * 0.618
float fib_786 = nz(fib_lo) + fib_range * 0.786
float fib_ext127 = nz(fib_hi) + fib_range * 0.272
float fib_ext161 = nz(fib_hi) + fib_range * 0.618

// ══════════════════════════════════════════════════════════════════
//  BÖLÜM 5B: TREND ÇİZGİSİ + PARALEL KANAL — 3 Katman (Modül D)
// ══════════════════════════════════════════════════════════════════

// ── Pivot hesaplama (3 katman) ──
float pvl_0 = ta.pivotlow(low, tl_prd, tl_prd)
float pvh_0 = ta.pivothigh(high, tl_prd, tl_prd)
float pvl_1 = en_tl_mid ? ta.pivotlow(low, tl_prd_mid, tl_prd_mid) : float(na)
float pvh_1 = en_tl_mid ? ta.pivothigh(high, tl_prd_mid, tl_prd_mid) : float(na)
float pvl_2 = en_tl_short ? ta.pivotlow(low, tl_prd_short, tl_prd_short) : float(na)
float pvh_2 = en_tl_short ? ta.pivothigh(high, tl_prd_short, tl_prd_short) : float(na)

var float[] pv_lo = array.new<float>(24, float(na))
var int[]   px_lo = array.new<int>(24, 0)
var float[] pv_hi = array.new<float>(24, float(na))
var int[]   px_hi = array.new<int>(24, 0)

pvInsert(float[] av, int[] ax, int base, float val, int pos) =>
    for sh = 6 to 0
        array.set(av, base+sh+1, array.get(av, base+sh))
        array.set(ax, base+sh+1, array.get(ax, base+sh))
    array.set(av, base, val)
    array.set(ax, base, pos)

if not na(pvl_0)
    pvInsert(pv_lo, px_lo, 0, pvl_0, bar_index - tl_prd)
if not na(pvh_0)
    pvInsert(pv_hi, px_hi, 0, pvh_0, bar_index - tl_prd)
if en_tl_mid and not na(pvl_1)
    pvInsert(pv_lo, px_lo, 8, pvl_1, bar_index - tl_prd_mid)
if en_tl_mid and not na(pvh_1)
    pvInsert(pv_hi, px_hi, 8, pvh_1, bar_index - tl_prd_mid)
if en_tl_short and not na(pvl_2)
    pvInsert(pv_lo, px_lo, 16, pvl_2, bar_index - tl_prd_short)
if en_tl_short and not na(pvh_2)
    pvInsert(pv_hi, px_hi, 16, pvh_2, bar_index - tl_prd_short)

// ── Sonuç dizileri: 6 slot [Ana_Up, Ana_Dn, Ara_Up, Ara_Dn, Kısa_Up, Kısa_Dn] ──
var float[] tl_slope   = array.new<float>(6, 0.0)
var float[] tl_base    = array.new<float>(6, 0.0)
var int[]   tl_x1      = array.new<int>(6, 0)
var int[]   tl_x2      = array.new<int>(6, 0)
var bool[]  tl_valid    = array.new<bool>(6, false)
var bool[]  tl_broken   = array.new<bool>(6, false)
var int[]   tl_brk_bar  = array.new<int>(6, 0)
var int[]   tl_brk_cnt  = array.new<int>(6, 0)
var float[] tl_chan_off  = array.new<float>(6, 0.0)
var bool[]  tl_chan_ok   = array.new<bool>(6, false)
var int[]   tl_touches  = array.new<int>(6, 0)
// v11.00 Archive — kırılan TL 15 bar kesikli kalır, yeni aday slotu doldurur
var float[] arc_slope   = array.new<float>(6, 0.0)
var float[] arc_base    = array.new<float>(6, 0.0)
var int[]   arc_x1      = array.new<int>(6, 0)
var int[]   arc_brk_bar = array.new<int>(6, 0)
var bool[]  arc_active  = array.new<bool>(6, false)

// ── Uptrend tespit: Touch Zone + Temas Sayısı + Skor ──
findUpTL(float[] av, int[] ax, int base) =>
    float rs = 0.0
    float rb = 0.0
    int rx1 = 0
    int rx2 = 0
    bool rf = false
    int rt = 0
    float best_score = -9999.0
    float tz = atr_val * 0.5
    for p1 = base to base + 5
        float v1 = array.get(av, p1)
        int   x1 = array.get(ax, p1)
        if not na(v1) and x1 > 0
            for p2 = p1 + 1 to base + 7
                float v2 = array.get(av, p2)
                int   x2 = array.get(ax, p2)
                if not na(v2) and x2 > 0 and v1 > v2 and x1 > x2
                    float sl = (v1 - v2) / float(x1 - x2)
                    int viol = 0
                    int touches = 0
                    int last_tch = -999
                    bool ok = true
                    int d = bar_index - x2
                    if d > 0 and d < 800
                        for b = 1 to d
                            if ok
                                int lb = bar_index - x2 - b
                                if lb >= 0 and lb < 4999
                                    float line_v = v2 + sl * float(b)
                                    float lo_v = low[lb]
                                    // Touch zone kontrolü
                                    if math.abs(lo_v - line_v) < tz
                                        if (b - last_tch) >= chan_zone_gap
                                            touches += 1
                                            last_tch := b
                                    // İhlal: close, çizginin altında mı? (tolerans yok — Sevit kuralı v11.02)
                                    float cv = tl_val == "Close" ? close[lb] : lo_v
                                    if cv < line_v
                                        viol += 1
                                        if viol > tl_max_viol
                                            ok := false
                    if ok
                        // Güncel fiyat kontrolü: close çizginin altındaysa → reddet
                        float cur_line = v2 + sl * float(bar_index - x2)
                        if close < cur_line - tz
                            ok := false
                    if ok
                        float score = float(touches) * 10.0 - float(viol) * 3.0 + float(d) / 100.0
                        if score > best_score
                            best_score := score
                            rs := sl
                            rb := v2
                            rx1 := x2
                            rx2 := x1
                            rf := true
                            rt := touches
    [rs, rb, rx1, rx2, rf, rt]

// ── Downtrend tespit: Touch Zone + Temas Sayısı + Skor ──
findDnTL(float[] av, int[] ax, int base) =>
    float rs = 0.0
    float rb = 0.0
    int rx1 = 0
    int rx2 = 0
    bool rf = false
    int rt = 0
    float best_score = -9999.0
    float tz = atr_val * 0.5
    for p1 = base to base + 5
        float v1 = array.get(av, p1)
        int   x1 = array.get(ax, p1)
        if not na(v1) and x1 > 0
            for p2 = p1 + 1 to base + 7
                float v2 = array.get(av, p2)
                int   x2 = array.get(ax, p2)
                if not na(v2) and x2 > 0 and v1 < v2 and x1 > x2
                    float sl = (v1 - v2) / float(x1 - x2)
                    int viol = 0
                    int touches = 0
                    int last_tch = -999
                    bool ok = true
                    int d = bar_index - x2
                    if d > 0 and d < 800
                        for b = 1 to d
                            if ok
                                int lb = bar_index - x2 - b
                                if lb >= 0 and lb < 4999
                                    float line_v = v2 + sl * float(b)
                                    float hi_v = high[lb]
                                    if math.abs(hi_v - line_v) < tz
                                        if (b - last_tch) >= chan_zone_gap
                                            touches += 1
                                            last_tch := b
                                    float cv = tl_val == "Close" ? close[lb] : hi_v
                                    if cv > line_v
                                        viol += 1
                                        if viol > tl_max_viol
                                            ok := false
                    if ok
                        float cur_line = v2 + sl * float(bar_index - x2)
                        if close > cur_line + tz
                            ok := false
                    if ok
                        float score = float(touches) * 10.0 - float(viol) * 3.0 + float(d) / 100.0
                        if score > best_score
                            best_score := score
                            rs := sl
                            rb := v2
                            rx1 := x2
                            rx2 := x1
                            rf := true
                            rt := touches
    [rs, rb, rx1, rx2, rf, rt]

// ── Kanal tespit fonksiyonu (bar_index'e kadar arama + temas bölgesi gruplamalı) ──
findChan(float sl, float bs, int x1, int x2, bool is_up) =>
    float max_ext = 0.0
    int d = bar_index - x1
    if d > 0 and d < 1000
        for b = 0 to d
            int lb = bar_index - x1 - b
            if lb >= 0 and lb < 4999
                float lat = bs + sl * float(b)
                if is_up
                    float dh = high[lb] - lat
                    if dh > max_ext
                        max_ext := dh
                else
                    float dl = lat - low[lb]
                    if dl > max_ext
                        max_ext := dl
    int tch = 0
    int last_zone = -999
    if max_ext > 0 and d > 0 and d < 1000
        for b2 = 0 to d
            int lb2 = bar_index - x1 - b2
            if lb2 >= 0 and lb2 < 4999
                float cat = bs + sl * float(b2) + (is_up ? max_ext : -max_ext)
                float pat = is_up ? high[lb2] : low[lb2]
                float dt = math.abs(pat - cat)
                if dt < atr_val * chan_touch_atr
                    if (b2 - last_zone) >= chan_zone_gap
                        tch += 1
                        last_zone := b2
    bool ok = tch >= 2
    float off = is_up ? max_ext : -max_ext
    [off, ok]

// ── Her katman için tespit çalıştır ──
bool rc0 = en_tl and (not na(pvl_0) or not na(pvh_0))
if rc0
    [s0u, b0u, x10u, x20u, f0u, t0u] = findUpTL(pv_lo, px_lo, 0)
    bool can0u = not array.get(tl_broken, 0) or (bar_index - array.get(tl_brk_bar, 0)) >= 3
    if f0u and can0u
        if array.get(tl_valid, 0) and array.get(tl_broken, 0)
            array.set(arc_slope, 0, array.get(tl_slope, 0))
            array.set(arc_base, 0, array.get(tl_base, 0))
            array.set(arc_x1, 0, array.get(tl_x1, 0))
            array.set(arc_brk_bar, 0, array.get(tl_brk_bar, 0))
            array.set(arc_active, 0, true)
        array.set(tl_slope, 0, s0u)
        array.set(tl_base, 0, b0u)
        array.set(tl_x1, 0, x10u)
        array.set(tl_x2, 0, x20u)
        array.set(tl_valid, 0, true)
        array.set(tl_broken, 0, false)
        array.set(tl_brk_cnt, 0, 0)
        array.set(tl_touches, 0, t0u)
        if en_chan
            [co0u, ck0u] = findChan(s0u, b0u, x10u, x20u, true)
            array.set(tl_chan_off, 0, co0u)
            array.set(tl_chan_ok, 0, ck0u)
    [s0d, b0d, x10d, x20d, f0d, t0d] = findDnTL(pv_hi, px_hi, 0)
    bool can0d = not array.get(tl_broken, 1) or (bar_index - array.get(tl_brk_bar, 1)) >= 3
    if f0d and can0d
        if array.get(tl_valid, 1) and array.get(tl_broken, 1)
            array.set(arc_slope, 1, array.get(tl_slope, 1))
            array.set(arc_base, 1, array.get(tl_base, 1))
            array.set(arc_x1, 1, array.get(tl_x1, 1))
            array.set(arc_brk_bar, 1, array.get(tl_brk_bar, 1))
            array.set(arc_active, 1, true)
        array.set(tl_slope, 1, s0d)
        array.set(tl_base, 1, b0d)
        array.set(tl_x1, 1, x10d)
        array.set(tl_x2, 1, x20d)
        array.set(tl_valid, 1, true)
        array.set(tl_broken, 1, false)
        array.set(tl_brk_cnt, 1, 0)
        array.set(tl_touches, 1, t0d)
        if en_chan
            [co0d, ck0d] = findChan(s0d, b0d, x10d, x20d, false)
            array.set(tl_chan_off, 1, co0d)
            array.set(tl_chan_ok, 1, ck0d)

bool rc1 = en_tl and en_tl_mid and (not na(pvl_1) or not na(pvh_1))
if rc1
    [s1u, b1u, x11u, x21u, f1u, t1u] = findUpTL(pv_lo, px_lo, 8)
    bool can1u = not array.get(tl_broken, 2) or (bar_index - array.get(tl_brk_bar, 2)) >= 3
    if f1u and can1u
        if array.get(tl_valid, 2) and array.get(tl_broken, 2)
            array.set(arc_slope, 2, array.get(tl_slope, 2))
            array.set(arc_base, 2, array.get(tl_base, 2))
            array.set(arc_x1, 2, array.get(tl_x1, 2))
            array.set(arc_brk_bar, 2, array.get(tl_brk_bar, 2))
            array.set(arc_active, 2, true)
        array.set(tl_slope, 2, s1u)
        array.set(tl_base, 2, b1u)
        array.set(tl_x1, 2, x11u)
        array.set(tl_x2, 2, x21u)
        array.set(tl_valid, 2, true)
        array.set(tl_broken, 2, false)
        array.set(tl_brk_cnt, 2, 0)
        array.set(tl_touches, 2, t1u)
        if en_chan
            [co1u, ck1u] = findChan(s1u, b1u, x11u, x21u, true)
            array.set(tl_chan_off, 2, co1u)
            array.set(tl_chan_ok, 2, ck1u)
    [s1d, b1d, x11d, x21d, f1d, t1d] = findDnTL(pv_hi, px_hi, 8)
    bool can1d = not array.get(tl_broken, 3) or (bar_index - array.get(tl_brk_bar, 3)) >= 3
    if f1d and can1d
        if array.get(tl_valid, 3) and array.get(tl_broken, 3)
            array.set(arc_slope, 3, array.get(tl_slope, 3))
            array.set(arc_base, 3, array.get(tl_base, 3))
            array.set(arc_x1, 3, array.get(tl_x1, 3))
            array.set(arc_brk_bar, 3, array.get(tl_brk_bar, 3))
            array.set(arc_active, 3, true)
        array.set(tl_slope, 3, s1d)
        array.set(tl_base, 3, b1d)
        array.set(tl_x1, 3, x11d)
        array.set(tl_x2, 3, x21d)
        array.set(tl_valid, 3, true)
        array.set(tl_broken, 3, false)
        array.set(tl_brk_cnt, 3, 0)
        array.set(tl_touches, 3, t1d)
        if en_chan
            [co1d, ck1d] = findChan(s1d, b1d, x11d, x21d, false)
            array.set(tl_chan_off, 3, co1d)
            array.set(tl_chan_ok, 3, ck1d)

bool rc2 = en_tl and en_tl_short and (not na(pvl_2) or not na(pvh_2))
if rc2
    [s2u, b2u, x12u, x22u, f2u, t2u] = findUpTL(pv_lo, px_lo, 16)
    bool can2u = not array.get(tl_broken, 4) or (bar_index - array.get(tl_brk_bar, 4)) >= 3
    if f2u and can2u
        if array.get(tl_valid, 4) and array.get(tl_broken, 4)
            array.set(arc_slope, 4, array.get(tl_slope, 4))
            array.set(arc_base, 4, array.get(tl_base, 4))
            array.set(arc_x1, 4, array.get(tl_x1, 4))
            array.set(arc_brk_bar, 4, array.get(tl_brk_bar, 4))
            array.set(arc_active, 4, true)
        array.set(tl_slope, 4, s2u)
        array.set(tl_base, 4, b2u)
        array.set(tl_x1, 4, x12u)
        array.set(tl_x2, 4, x22u)
        array.set(tl_valid, 4, true)
        array.set(tl_broken, 4, false)
        array.set(tl_brk_cnt, 4, 0)
        array.set(tl_touches, 4, t2u)
        if en_chan
            [co2u, ck2u] = findChan(s2u, b2u, x12u, x22u, true)
            array.set(tl_chan_off, 4, co2u)
            array.set(tl_chan_ok, 4, ck2u)
    [s2d, b2d, x12d, x22d, f2d, t2d] = findDnTL(pv_hi, px_hi, 16)
    bool can2d = not array.get(tl_broken, 5) or (bar_index - array.get(tl_brk_bar, 5)) >= 3
    if f2d and can2d
        if array.get(tl_valid, 5) and array.get(tl_broken, 5)
            array.set(arc_slope, 5, array.get(tl_slope, 5))
            array.set(arc_base, 5, array.get(tl_base, 5))
            array.set(arc_x1, 5, array.get(tl_x1, 5))
            array.set(arc_brk_bar, 5, array.get(tl_brk_bar, 5))
            array.set(arc_active, 5, true)
        array.set(tl_slope, 5, s2d)
        array.set(tl_base, 5, b2d)
        array.set(tl_x1, 5, x12d)
        array.set(tl_x2, 5, x22d)
        array.set(tl_valid, 5, true)
        array.set(tl_broken, 5, false)
