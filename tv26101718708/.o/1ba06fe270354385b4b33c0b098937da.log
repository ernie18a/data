    matched := 5

// v8.10: in_position = Dir != "None" (InPos checkbox kaldırıldı)
string pos_dir   = matched==1?s1_dir : matched==2?s2_dir : matched==3?s3_dir : matched==4?s4_dir : matched==5?s5_dir : def_dir
bool in_position = pos_dir != "None"
int pos_etm_raw  = matched==1?s1_etm : matched==2?s2_etm : matched==3?s3_etm : matched==4?s4_etm : matched==5?s5_etm : def_etm
int _sentinel    = timestamp("01 Apr 2026")
int _6mo         = 15768000000
int pos_entry_time = (pos_etm_raw == _sentinel or timenow - pos_etm_raw > _6mo) ? timenow : pos_etm_raw
float pos_entry  = matched==1?s1_ent : matched==2?s2_ent : matched==3?s3_ent : matched==4?s4_ent : matched==5?s5_ent : def_ent
