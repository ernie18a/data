int start()
  {
  bool fm=false;
 
  fm=ObjectDelete("UP_LEVEL");
  if(fm==0 || fm==-1){GeneralError();}
  
  fm=ObjectDelete("DOWN_LEVEL");
  if(fm==0 || fm==-1){GeneralError();}
  

   return(0);
  }
