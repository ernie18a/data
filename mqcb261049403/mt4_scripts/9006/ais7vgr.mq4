//< 3. Main Program 5 >=======================================================================================//<  20>
                                                                                                              //<  21>
int    init                           ()                                                                      //<  22>
{                                                                                                             //<  23>
                                                                                                              //<  24>
int             ali.ObjectsCounter     = ObjectsTotal () - 1                                                ; //<  25>
                                                                                                              //<  26>
for  ( int  i = ali.ObjectsCounter     ; i >= 0 ; i -- )                                                      //<  27>
     {                                                                                                        //<  28>
       if ( StringFind ( ObjectName    ( i )    , acs.VGPrefix ) >= 0 )   ObjectDelete ( ObjectName ( i ) ) ; //<  29>
     } // for                                                                                                 //<  20>
                                                                                                              //<  31>
}                                                                                                             //<  32>
//</3. Main Program 5 >=======================================================================================//<  33>